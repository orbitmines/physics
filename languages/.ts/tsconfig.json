{
  "compilerOptions": {
    "target": "esnext",
    "lib": [
      "esnext"
    ],
    /* NEITHER `dom` NOR `node`: nothing here touches a document or a file. The research
       repository needs both - it renders to a canvas and reads the prover's output off
       disk - and this package is what is left when that is not in it, which is a theory
       that runs the same in a browser, on a server and in a worker. */
    "types": [],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "allowImportingTsExtensions": true,
    "strict": true,
    "strictNullChecks": false,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "suppressImplicitAnyIndexErrors": false,
    "noEmit": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true
  },
  "include": [
    "src",
    "index.ts"
  ]
}