{
  "name": "@orbitmines/physics",
  "version": "0.0.1-E2027.0D.1",
  "private": false,
  "repository": "https://github.com/orbitmines/physics",
  "description": "The discrete theory G - the rules, and the smallest thing that runs them",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "main": "./index.ts",
  "exports": {
    ".": "./index.ts",
    "./notation": "./notation.ts",
    "./theorems": "./theorems.ts"
  },
  "files": [
    "index.ts",
    "notation.ts",
    "theorems.ts",
    "src",
    "visuals",
    "data"
  ],
  "devDependencies": {
    "@types/node": "^25.6.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "theorems": "tsx tools/THEOREMS.ts",
    "visuals": "tsx src/visuals/RENDER.ts gravity",
    "typecheck:visuals": "tsc --noEmit -p tsconfig.visuals.json",
    "typecheck:notation": "tsc --noEmit -p tsconfig.notation.json",
    "measure": "tsx tools/MEASURE.ts",
    "catalogue": "tsx tools/CATALOGUE.ts",
    "record": "tsx tools/RECORD.ts",
    "film": "tsx tools/FILM.ts",
    "record:gpu": "$HOME/.deno/bin/deno run --unstable-webgpu --allow-all tools/RECORD.ts"
  }
}
