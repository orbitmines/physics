(* GENERATED by `npx ray gen` from implementation/gen/languages/Wolfram.ray - do not edit *)
(* wolframscript -file languages/physics.wl-definition.wls languages/physics.wl *)
(* the Paclet Repository's definition notebook for this paclet, made from Wolfram's own template - no front end needed *)
Needs["DefinitionNotebookClient`"];
dir = If[Length[$ScriptCommandLine] > 1, AbsoluteFileName[$ScriptCommandLine[[2]]], FileNameJoin[{Directory[], "physics.wl"}]];
text[s_] := Cell[s, "Text"]; item[s_] := Cell[s, "Item"];
template = Get[DefinitionNotebookClient`DefinitionTemplateLocation["Paclet"]];
default[slot_] := First@Cases[template, TemplateSlot[slot, ___, DefaultValue -> v_, ___] :> v, Infinity, 1];
(* the runtime raises $RecursionLimit and $IterationLimit when it loads (deep call chains): disclosed, as the repository asks *)
(* a slot filled as the template fills it: its own cell, its text replaced and no longer marked as default content *)
fill[slot_, old_String, new_String] := default[slot] /. Cell[old, style_, opts___] :> Cell[new, style, Sequence @@ ({opts} /. (CellTags -> tags_List) :> (CellTags -> DeleteCases[tags, "DefaultContent"]))];
disclosures = default["Disclosures"] /. CheckboxBox[False, {False, k : "WLSystemConfiguration" | "WLSystemSymbols"}] :> CheckboxBox[k, {False, k}];
slots = <|
  "PacletDirectory" -> dir,
  "Name" -> fill["Name", "MyPublisherID/MyPaclet", "OrbitMines/Physics"],
  "Description" -> fill["Description", "One-line description of the paclet", "OrbitMines: Physics Project"],
  "CompatibilityWolframLanguageVersionRequired" -> Replace[default["CompatibilityWolframLanguageVersionRequired"], Cell[_String, style_, opts___] :> Cell["13.0+", style, Sequence @@ ({opts} /. (CellTags -> tags_List) :> (CellTags -> DeleteCases[tags, "DefaultContent"]))], {1}],
  "LongDescription" -> {text["The discrete theory G and the continuous medium derived from its rules - the same library, generated from one set of .ray definitions, in Wolfram Language and twelve other languages."]},
  "Details" -> {Cell["Every class and theory is generated from implementation/physics.ray by npx ray gen; nothing in the paclet is written by hand.", "Notes"]},
  "PrimaryContext" -> {text["OrbitMines`Physics`"]},
  "Contributed By" -> {text["OrbitMines"]},
  "SourceControlURL" -> {text["https://github.com/orbitmines/physics"]},
  "Keywords" -> {item["physics"], item["gravity"], item["simulation"], item["discrete theory"]},
  "Disclosures" -> disclosures
|>;
(* THE PAGE: what the paclet does, shown with the visuals the project renders (visuals/<id>/snapshot.png, beside the paclet in the repository) *)
visuals = FileNameJoin[{DirectoryName[dir, 2], "visuals"}];
snapshot[id_, w_] := Module[{f = FileNameJoin[{visuals, id, "snapshot.png"}]}, If[FileExistsQ[f], ImageResize[Import[f], w], Missing[]]];
picture[id_, w_] := With[{i = snapshot[id, w]}, If[MissingQ[i], Nothing, Cell[BoxData[ToBoxes[i]], "Output"]]];
hero = default["HeroImage"] /. Cell[BoxData[_], rest___] :> With[{i = snapshot["galaxy.rar", 640]}, If[MissingQ[i], Cell[BoxData[""], rest], Cell[BoxData[ToBoxes[i]], rest]]];
code[s_String] := Cell[s, "Input"];
examples = {Cell[CellGroupData[{
    Cell["Basic Examples", "Subsection"],
    Cell["Load the paclet:", "Text"],
    code["Needs[\"OrbitMines`Physics`\"]"],
    Cell["The theory G, its continuous model on the CPU - a box of cells, the vacuum settled, one body in it - ticked:", "Text"],
    code["medium = G[\"medium\", 31., 96., 3., 8., 1.];\nmedium[\"local_rays\" -> True];\nmedium[\"add\", Hole[<|\"x\" -> 15., \"y\" -> 15., \"mx\" -> 0.3, \"ways\" -> 1.|>]];\nmedium[\"seed\"];\nDo[medium[\"tick\"], 5]"],
    Cell["The theory's discrete rules are rules - each a RuleDelayed on what it acts on, applied as any other:", "Text"],
    code["G[\"Rules\"]"],
    code["G[\"Rules\"][\"/1\"]"],
    Cell["What a simulation of a billion sources would take of a 16 GiB device:", "Text"],
    code["plan = Plan[<|\"sources\" -> 1.*^9, \"side\" -> 241.|>];\nplan[\"budget\"][\"compact\" -> True];\nplan[\"report\", 16. 2^30, 2.^31]"]
  }, Open]],
  Cell[CellGroupData[Join[{
    Cell["Visuals", "Subsection"],
    Cell["What the project renders from the same definitions (rendered on the GPU by its TypeScript package; the films are in the repository's visuals/):", "Text"]},
    Flatten[{Cell["A galaxy's rotation against its visible mass:", "Text"], picture["galaxy.rar", 520],
      Cell["A body's pull, from the medium itself:", "Text"], picture["gravity.pull", 520],
      Cell["A galaxy in the medium, every star its own body:", "Text"], picture["galaxy.medium", 520],
      Cell["The inner solar system in the medium:", "Text"], picture["solar.inner", 520]}]], Open]]};
chosen = {"Scientific and Medical Data & Computation", "Symbolic & Numeric Computation", "Visualization & Graphics"};
categories = default["Categories"] /. CheckboxBox[False, {False, k_String}] /; MemberQ[chosen, k] :> CheckboxBox[k, {False, k}];
slots = Join[slots, <|
  "HeroImage" -> hero,
  "ExampleNotebook" -> examples,
  "Categories" -> categories,
  "Links" -> {item["https://github.com/orbitmines/physics"], item["https://orbitmines.com/physics"]},
  "Details" -> {Cell["Everything in the paclet is generated from the project's .ray definitions (implementation/physics.ray) by npx ray gen: the theory G and its discrete rules, the continuous medium derived from them, the prover's theorems, and the plan of a simulation of sources. The same library exists, from the same definitions, in TypeScript, Python, Julia, Lean, Rust, C++ and seven other languages.", "Notes"]}
|>];
nb = DefinitionNotebookClient`GenerateDefinitionNotebook["Paclet", slots];
Export[FileNameJoin[{dir, "ResourceDefinition.nb"}], nb, "NB"];
Print["wrote ", FileNameJoin[{dir, "ResourceDefinition.nb"}]];
