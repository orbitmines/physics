DefineClass[FieldRecording, "FieldRecording", Recording, Function[{klass},
  field[klass, "p"];
  field[klass, "W", dfn[Null]];
  field[klass, "gone", dfn[filled[mul[self["p"]["side"], self["p"]["side"]], 0.]]];
  field[klass, "lx", dfn[filled[mul[self["p"]["side"], self["p"]["side"]], 0.]]];
  field[klass, "ly", dfn[filled[mul[self["p"]["side"], self["p"]["side"]], 0.]]];
  field[klass, "beat", dfn[filled[mul[self["p"]["side"], self["p"]["side"]], 0.]]];
  field[klass, "beat2", dfn[filled[mul[self["p"]["side"], self["p"]["side"]], 0.]]];
  field[klass, "per_tag", dfn[mMap[rng[If[truthy[gt[self["p"]["tags"], 2.]], sub[self["p"]["tags"], 2.], 1.]], lfn[2, { env1["z"] = arg[args2, 0] };
    Throw[filled[mul[self["p"]["side"], self["p"]["side"]], 0.], ret]]]]];
  field[klass, "spanned", dfn[0.]];
  getter[klass, "lay", mfn[1,
    env0["p"] = self["p"];
    env0["w"] = env0["p"]["theory"]["medium", env0["p"]["side"], env0["p"]["A"], env0["p"]["K"], env0["p"]["DEG"], env0["p"]["tags"], env0["p"]["D"]];
    env0["placed"] = env0["p"]["place", env0["p"]];
    Do[loopScope[1, env1["b"] = iter1;
      env1["h"] = Hole[{ "x" -> add[env0["p"]["centre"], mul[env1["b"]["x"], env0["p"]["K"]]], "y" -> add[env0["p"]["centre"], mul[env1["b"]["y"], env0["p"]["K"]]], "mx" -> env1["b"]["mx"], "ways" -> env1["b"]["ways"] }];
      env1["h"]["tag" -> env1["b"]["tag"]];
      env1["h"]["moves" -> False];
      env0["w"]["add", env1["h"]]], {iter1, items[env0["placed"]]}];
    If[truthy[eq[env0["p"]["RANGE"], "instant"]],
      env0["w"]["settle"],
      Do[loopScope[1, env1["i"] = iter1;
        env0["w"]["tick"]], {iter1, 0., num[env0["p"]["BURN"]] - 1.}]];
    If[truthy[mSome[env0["placed"], lfn[3, { env2["b"] = arg[args3, 0] };
      Throw[eq[env2["b"]["launch"], "orbit"], ret]]]],
      env0["w"]["tick"]];
    Do[loopScope[1, env1["k"] = iter1;
      elem[env0["w"]["holes"], env1["k"]]["moves" -> elem[env0["placed"], env1["k"]]["moves"]]], {iter1, 0., num[len[env0["placed"]]] - 1.}];
    env0["reads"] = mMap[rng[len[env0["placed"]]], lfn[3, { env2["k"] = arg[args3, 0] };
      Throw[If[truthy[eq[elem[env0["placed"], env2["k"]]["launch"], "orbit"]], Setup["pulls_between", env0["w"], elem[env0["w"]["holes"], env2["k"]], Setup["rest_of", env0["w"]["holes"], env2["k"]], elem[env0["placed"], env2["k"]]["ecc"], env0["p"]["K"], 64.], list[]], ret]]];
    Do[loopScope[1, env1["k"] = iter1;
      env1["h"] = elem[env0["w"]["holes"], env1["k"]];
      env1["b"] = elem[env0["placed"], env1["k"]];
      env1["v"] = If[truthy[eq[env1["b"]["launch"], "orbit"]], Setup["orbit", env1["h"], Setup["rest_of", env0["w"]["holes"], env1["k"]], elem[env0["reads"], env1["k"]], env1["b"]["ecc"], env1["b"]["px"], env1["b"]["py"], env0["p"]["K"], 0.], list[env1["b"]["px"], env1["b"]["py"]]];
      env1["h"]["px" -> elem[env1["v"], 0.]];
      env1["h"]["py" -> elem[env1["v"], 1.]];
      env1["h"]["momentum" -> Vector[{ "components" -> list[elem[env1["v"], 0.], elem[env1["v"], 1.]] }]]], {iter1, 0., num[len[env0["placed"]]] - 1.}];
    env0["w"]["seed"];
    Do[loopScope[1, env1["k"] = iter1;
      env1["b"] = elem[env0["placed"], env1["k"]];
      If[truthy[eq[env1["b"]["launch"], "orbit"]],
        env1["h"] = elem[env0["w"]["holes"], env1["k"]];
        env1["rest"] = Setup["rest_of", env0["w"]["holes"], env1["k"]];
        env1["moving"] = Setup["pulls_between", env0["w"], env1["h"], env1["rest"], env1["b"]["ecc"], env0["p"]["K"], 64.];
        env1["at"] = sub[len[elem[env0["reads"], env1["k"]]], 1.];
        env1["vrel"] = div[mul[div[Fmt["hypot", env1["h"]["px"], env1["h"]["py"]], env1["h"]["mass"]], (add[env1["h"]["mass"], elem[env1["rest"], 0.]])], elem[env1["rest"], 0.]];
        env1["kappa"] = Setup["slower", elem[elem[elem[env0["reads"], env1["k"]], env1["at"]], 1.], elem[elem[env1["moving"], env1["at"]], 1.], env1["vrel"]];
        env1["v"] = Setup["orbit", env1["h"], env1["rest"], elem[env0["reads"], env1["k"]], env1["b"]["ecc"], env1["b"]["px"], env1["b"]["py"], env0["p"]["K"], env1["kappa"]];
        env1["h"]["px" -> elem[env1["v"], 0.]];
        env1["h"]["py" -> elem[env1["v"], 1.]];
        env1["h"]["momentum" -> Vector[{ "components" -> list[elem[env1["v"], 0.], elem[env1["v"], 1.]] }]]]], {iter1, 0., num[len[env0["placed"]]] - 1.}];
    self["W" -> env0["w"]]]];
  getter[klass, "start", mfn[1,
    Throw[self["lay"], ret]]];
  getter[klass, "begin_frame", mfn[1,
    env0["cells"] = mul[self["p"]["side"], self["p"]["side"]];
    Do[loopScope[1, env1["c"] = iter1;
      setAt[self["gone"], env1["c"], 0.];
      setAt[self["lx"], env1["c"], 0.];
      setAt[self["ly"], env1["c"], 0.];
      setAt[self["beat"], env1["c"], 0.];
      setAt[self["beat2"], env1["c"], 0.]], {iter1, 0., num[env0["cells"]] - 1.}];
    Do[loopScope[1, env1["e"] = iter1;
      Do[loopScope[2, env2["c"] = iter2;
        setAt[env1["e"], env2["c"], 0.]], {iter2, 0., num[env0["cells"]] - 1.}]], {iter1, items[self["per_tag"]]}];
    self["spanned" -> 0.]]];
  method[klass, "take", mfn[1, { env0["w"] = arg[args1, 0] };
    env0["p"] = self["p"];
    env0["cells"] = mul[env0["p"]["side"], env0["p"]["side"]];
    Do[loopScope[1, env1["c"] = iter1;
      setAt[self["gone"], env1["c"], add[elem[self["gone"], env1["c"]], env0["w"]["crossed", env1["c"]]]];
      setAt[self["lx"], env1["c"], add[elem[self["lx"], env1["c"]], env0["w"]["pull_x", env1["c"]]]];
      setAt[self["ly"], env1["c"], add[elem[self["ly"], env1["c"]], env0["w"]["pull_y", env1["c"]]]];
      setAt[self["beat"], env1["c"], add[elem[self["beat"], env1["c"]], env0["w"]["arrived", 1., env1["c"]]]];
      Do[loopScope[2, env2["k"] = iter2;
        env2["v"] = env0["w"]["arrived", add[env2["k"], 2.], env1["c"]];
        setAt[self["beat2"], env1["c"], add[elem[self["beat2"], env1["c"]], env2["v"]]];
        setAt[elem[self["per_tag"], env2["k"]], env1["c"], add[elem[elem[self["per_tag"], env2["k"]], env1["c"]], env2["v"]]]], {iter2, 0., num[If[truthy[gt[env0["p"]["tags"], 2.]], sub[env0["p"]["tags"], 2.], 1.]] - 1.}]], {iter1, 0., num[env0["cells"]] - 1.}];
    self["spanned" -> add[self["spanned"], 1.]]]];
  method[klass, "positions", mfn[1, { env0["w"] = arg[args1, 0] };
    Throw[mMap[env0["w"]["holes"], lfn[3, { env2["h"] = arg[args3, 0] };
      Throw[Body[{ "x" -> div[(sub[env2["h"]["x"], self["p"]["centre"]]), self["p"]["K"]], "y" -> div[(sub[env2["h"]["y"], self["p"]["centre"]]), self["p"]["K"]], "mx" -> env2["h"]["mx"], "ways" -> env2["h"]["ways"] }], ret]]], ret]]];
  method[klass, "finish", mfn[1, { env0["into"] = arg[args1, 0], env0["w"] = arg[args1, 1] };
    env0["p"] = self["p"];
    env0["level"] = 0.;
    env0["seen"] = 0.;
    env0["R"] = env0["p"]["reach"];
    env0["step"] = div[env0["p"]["K"], env0["p"]["PIX"]];
    env0["one"] = env0["into"][str["one"]];
    env0["two"] = env0["into"][str["two"]];
    env0["gone"] = env0["into"][str["gone"]];
    env0["bys"] = mMap[rng[len[self["per_tag"]]], lfn[3, { env2["k"] = arg[args3, 0] };
      Throw[env0["into"][str["by" <> str[env2["k"]] <> ""]], ret]]];
    env0["marks"] = env0["into"][str["marks"]];
    env0["span"] = If[truthy[lt[self["spanned"], 1.]], 1., self["spanned"]];
    Do[loopScope[1, env1["yi"] = iter1;
      env1["y"] = sub[env1["yi"], env0["R"]];
      Do[loopScope[2, env2["xi"] = iter2;
        env2["x"] = sub[env2["xi"], env0["R"]];
        env2["c"] = env0["w"]["at", mRound[(add[env0["p"]["centre"], mul[env2["x"], env0["step"]]])], mRound[(add[env0["p"]["centre"], mul[env1["y"], env0["step"]]])]];
        env2["i"] = env0["p"]["box", env2["x"], env1["y"]];
        If[truthy[lt[env2["c"], 0.]],
          setAt[env0["one"], env2["i"], 0.];
          setAt[env0["two"], env2["i"], 0.];
          setAt[env0["gone"], env2["i"], 0.];
          Do[loopScope[3, env3["k"] = iter3;
            If[truthy[andV[andV[(!eq[elem[env0["bys"], env3["k"]], Null]), eq[mod[(add[env2["x"], env0["R"]]), env0["p"]["PIX"]], 0.]], eq[mod[(add[env1["y"], env0["R"]]), env0["p"]["PIX"]], 0.]]],
              setAt[elem[env0["bys"], env3["k"]], env0["p"]["coarse", env2["x"], env1["y"]], 0.]]], {iter3, 0., num[len[env0["bys"]]] - 1.}],
          env2["blocked"] = gt[elem[env0["w"]["blocks"], env2["c"]], 0.];
          setAt[env0["one"], env2["i"], If[truthy[env2["blocked"]], neg[1.], div[elem[self["beat"], env2["c"]], env0["span"]]]];
          setAt[env0["two"], env2["i"], If[truthy[env2["blocked"]], neg[1.], div[elem[self["beat2"], env2["c"]], env0["span"]]]];
          Do[loopScope[3, env3["k"] = iter3;
            If[truthy[andV[andV[(!eq[elem[env0["bys"], env3["k"]], Null]), eq[mod[(add[env2["x"], env0["R"]]), env0["p"]["PIX"]], 0.]], eq[mod[(add[env1["y"], env0["R"]]), env0["p"]["PIX"]], 0.]]],
              setAt[elem[env0["bys"], env3["k"]], env0["p"]["coarse", env2["x"], env1["y"]], div[elem[elem[self["per_tag"], env3["k"]], env2["c"]], env0["span"]]]]], {iter3, 0., num[len[env0["bys"]]] - 1.}];
          setAt[env0["gone"], env2["i"], elem[self["gone"], env2["c"]]];
          If[!truthy[env2["blocked"]],
            env0["level"] = add[env0["level"], elem[self["gone"], env2["c"]]];
            env0["seen"] = add[env0["seen"], 1.]]]], {iter2, 0., num[add[mul[2., env0["R"]], 1.]] - 1.}]], {iter1, 0., num[add[mul[2., env0["R"]], 1.]] - 1.}];
    setAt[env0["marks"], mul[6., env0["p"]["bodies"]], If[truthy[gt[env0["seen"], 0.]], div[env0["level"], env0["seen"]], 0.]];
    Do[loopScope[1, env1["k"] = iter1;
      If[truthy[lt[env1["k"], env0["p"]["bodies"]]],
        env1["b"] = elem[env0["w"]["holes"], env1["k"]];
        setAt[env0["marks"], mul[env1["k"], 6.], div[(sub[env1["b"]["x"], env0["p"]["centre"]]), env0["p"]["K"]]];
        setAt[env0["marks"], add[mul[env1["k"], 6.], 1.], div[(sub[env1["b"]["y"], env0["p"]["centre"]]), env0["p"]["K"]]];
        setAt[env0["marks"], add[mul[env1["k"], 6.], 2.], env1["b"]["px_now"]];
        setAt[env0["marks"], add[mul[env1["k"], 6.], 3.], env1["b"]["py_now"]];
        setAt[env0["marks"], add[mul[env1["k"], 6.], 4.], env0["w"]["t"]];
        setAt[env0["marks"], add[mul[env1["k"], 6.], 5.], env1["b"]["mass"]]]], {iter1, 0., num[len[env0["w"]["holes"]]] - 1.}]]];
  method[klass, "frame", mfn[1, { env0["into"] = arg[args1, 0] };
    env0["p"] = self["p"];
    self["begin_frame"];
    Do[loopScope[1, env1["i"] = iter1;
      env1["w"] = self["W"];
      If[truthy[andV[(!eq[env0["p"]["spent"], Null]), env0["p"]["spent", self["positions", env1["w"]]]]],
        self["lay"],
        env1["w"]["tick"];
        mTake[self, env1["w"]]]], {iter1, 0., num[env0["p"]["TICKS"]] - 1.}];
    Throw[self["finish", env0["into"], self["W"]], ret]]]]];

DefineClass[FieldPainter, "FieldPainter", Painter, Function[{klass},
