cls["Fmt", "Node", Function[{klass},
  statik[klass, "log10", mfn[1, { env0["x"] = arg[args1, 0] };
    Throw[div[mLn[env0["x"]], mLn[10.]], ret]]];
  statik[klass, "finite", mfn[1, { env0["x"] = arg[args1, 0] };
    Throw[andV[eq[env0["x"], env0["x"]], lt[mAbs[env0["x"]], power[10., 300.]]], ret]]];
  statik[klass, "fixed", mfn[1, { env0["x"] = arg[args1, 0], env0["d"] = arg[args1, 1] };
    If[truthy[(!eq[env0["x"], env0["x"]])],
      Throw["NaN", ret]];
    env0["scale"] = power[10., env0["d"]];
    env0["r"] = mRound[(mul[mAbs[env0["x"]], env0["scale"]])];
    env0["whole"] = mFloor[(div[env0["r"], env0["scale"]])];
    env0["frac"] = sub[env0["r"], mul[env0["whole"], env0["scale"]]];
    env0["sign"] = If[truthy[andV[lt[env0["x"], 0.], gt[env0["r"], 0.]]], "-", ""];
    If[truthy[eq[env0["d"], 0.]],
      Throw["" <> str[env0["sign"]] <> "" <> str[env0["whole"]] <> "", ret]];
    env0["digits"] = "" <> str[env0["frac"]] <> "";
    While[truthy[lt[len[env0["digits"]], env0["d"]]],
      env0["digits"] = "0" <> str[env0["digits"]] <> ""];
    Throw["" <> str[env0["sign"]] <> "" <> str[env0["whole"]] <> "." <> str[env0["digits"]] <> "", ret]]];
  statik[klass, "exponential", mfn[1, { env0["x"] = arg[args1, 0], env0["d"] = arg[args1, 1] };
    If[truthy[(!eq[env0["x"], env0["x"]])],
      Throw["NaN", ret]];
    env0["zeros"] = call["0", "repeat", { env0["d"] }];
    If[truthy[eq[env0["x"], 0.]],
      Throw[If[truthy[gt[env0["d"], 0.]], "0." <> str[env0["zeros"]] <> "e+0", "0e+0"], ret]];
    env0["e"] = mFloor[call[K["Fmt"], "log10", { mAbs[env0["x"]] }]];
    env0["m"] = div[mAbs[env0["x"]], power[10., env0["e"]]];
    If[truthy[ge[mRound[(mul[env0["m"], power[10., env0["d"]]])], power[10., (add[env0["d"], 1.])]]],
      env0["m"] = div[env0["m"], 10.];
      env0["e"] = add[env0["e"], 1.]];
    If[truthy[lt[env0["m"], 1.]],
      env0["m"] = mul[env0["m"], 10.];
      env0["e"] = sub[env0["e"], 1.]];
    env0["sign"] = If[truthy[lt[env0["x"], 0.]], "-", ""];
    env0["mant"] = call[K["Fmt"], "fixed", { env0["m"], env0["d"] }];
    Throw[If[truthy[ge[env0["e"], 0.]], "" <> str[env0["sign"]] <> "" <> str[env0["mant"]] <> "e+" <> str[env0["e"]] <> "", "" <> str[env0["sign"]] <> "" <> str[env0["mant"]] <> "e-" <> str[mAbs[env0["e"]]] <> ""], ret]]];
  statik[klass, "min", mfn[1, { env0["p"] = arg[args1, 0], env0["q"] = arg[args1, 1] };
    Throw[If[truthy[lt[env0["p"], env0["q"]]], env0["p"], env0["q"]], ret]]];
  statik[klass, "max", mfn[1, { env0["p"] = arg[args1, 0], env0["q"] = arg[args1, 1] };
    Throw[If[truthy[gt[env0["p"], env0["q"]]], env0["p"], env0["q"]], ret]]];
  statik[klass, "hypot", mfn[1, { env0["x"] = arg[args1, 0], env0["y"] = arg[args1, 1] };
    Throw[mSqrt[(add[mul[env0["x"], env0["x"]], mul[env0["y"], env0["y"]]])], ret]]];
  statik[klass, "median", mfn[1, { env0["xs_"] = arg[args1, 0] };
    If[truthy[mEmpty[env0["xs_"]]],
      Throw[Indeterminate, ret]];
    env0["s"] = call[K["Expr"], "sorted", { env0["xs_"] }];
    Throw[elem[env0["s"], mFloor[(div[len[env0["s"]], 2.])]], ret]]]]];

