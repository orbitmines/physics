    Throw[mul[mul[(add[mul[0.5, elem[env0["S"][str["L[3.6]"]], env0["g"]]], mul[1.33, elem[env0["S"][str["MHI"]], env0["g"]]]]), power[10., 9.]], Sparc["MSUN"]], ret]]];
  statik[klass, "rar", mfn[1,
    If[truthy[(!eq[Sparc["CACHE"][str["rar"]], Null])],
      Throw[Sparc["CACHE"][str["rar"]], ret]];
    Sparc["CACHE"][str["rar"] -> Sparc["rar_at", Sparc["YD"]]];
    Throw[Sparc["CACHE"][str["rar"]], ret]]];
  statik[klass, "rar_at", mfn[1, { env0["YD"] = arg[args1, 0] };
    env0["t"] = Sparc["curves"];
    env0["C"] = env0["t"]["columns"];
    env0["out"] = list[];
    Do[loopScope[1, env1["i"] = iter1;
      env1["g"] = elem[env0["C"][str["galaxy"]], env1["i"]];
      env1["R"] = mul[elem[env0["C"][str["R"]], env1["i"]], Sparc["KPC"]];
      env1["v"] = mul[elem[env0["C"][str["Vobs"]], env1["i"]], Sparc["KMS"]];
      If[truthy[andV[andV[andV[Sparc["usable", env1["g"]], gt[env1["R"], 0.]], gt[env1["v"], 0.]], le[elem[env0["C"][str["e_Vobs"]], env1["i"]], mul[0.1, elem[env0["C"][str["Vobs"]], env1["i"]]]]]],
        env1["gas"] = mul[elem[env0["C"][str["Vgas"]], env1["i"]], Sparc["KMS"]];
        env1["disk"] = mul[elem[env0["C"][str["Vdisk"]], env1["i"]], Sparc["KMS"]];
        env1["bul"] = mul[elem[env0["C"][str["Vbul"]], env1["i"]], Sparc["KMS"]];
        env1["YB"] = If[truthy[gt[Sparc["YD"], 0.]], div[mul[env0["YD"], Sparc["YB"]], Sparc["YD"]], env0["YD"]];
        env1["gbar"] = div[(add[add[mul[env1["gas"], mAbs[env1["gas"]]], mul[mul[env0["YD"], env1["disk"]], mAbs[env1["disk"]]]], mul[mul[env1["YB"], env1["bul"]], mAbs[env1["bul"]]]]), env1["R"]];
        If[truthy[gt[env1["gbar"], 0.]],
          mPush[env0["out"], RarPoint[{ "gbar" -> env1["gbar"], "gobs" -> div[mul[env1["v"], env1["v"]], env1["R"]], "galaxy" -> env1["g"], "R" -> env1["R"] }]]]]], {iter1, 0., num[env0["t"]["rows"]] - 1.}];
    Throw[env0["out"], ret]]];
  statik[klass, "flat", mfn[1,
    If[truthy[(!eq[Sparc["CACHE"][str["flat"]], Null])],
      Throw[Sparc["CACHE"][str["flat"]], ret]];
    env0["best"] = Node[{}];
    Do[loopScope[1, env1["p"] = iter1;
      env1["had"] = elem[env0["best"], env1["p"]["galaxy"]];
      If[truthy[orV[eq[env1["had"], Null], gt[env1["p"]["R"], env1["had"]["R"]]]],
        setAt[env0["best"], env1["p"]["galaxy"], env1["p"]]]], {iter1, items[Sparc["rar"]]}];
    env0["out"] = list[];
    env0["names"] = Sparc["names"];
    Do[loopScope[1, env1["g"] = iter1;
      env1["p"] = elem[env0["best"], env1["g"]];
      If[truthy[(!eq[env1["p"], Null])],
        env1["q"] = RarPoint[{ "gbar" -> env1["p"]["gbar"], "gobs" -> env1["p"]["gobs"], "galaxy" -> env1["p"]["galaxy"], "R" -> env1["p"]["R"] }];
        env1["q"]["name" -> elem[env0["names"], env1["g"]]];
        mPush[env0["out"], env1["q"]]]], {iter1, 0., num[len[env0["names"]]] - 1.}];
    Sparc["CACHE"][str["flat"] -> env0["out"]];
    Throw[env0["out"], ret]]];
  statik[klass, "btfr", mfn[1,
    If[truthy[(!eq[Sparc["CACHE"][str["btfr"]], Null])],
      Throw[Sparc["CACHE"][str["btfr"]], ret]];
    env0["t"] = Measured["of", "sparc-btfr"];
    If[truthy[eq[env0["t"], Null]],
      fail["sparc-btfr is not on disk - run `npx ray data` and try again"]];
    env0["c"] = env0["t"]["columns"];
    env0["names"] = env0["t"]["header"][str["names"]];
    env0["out"] = list[];
    Do[loopScope[1, env1["i"] = iter1;
      If[truthy[gt[elem[env0["c"][str["Vf"]], env1["i"]], 0.]],
        mPush[env0["out"], Btfr[{ "name" -> elem[env0["names"], env1["i"]], "galaxy" -> elem[env0["c"][str["galaxy"]], env1["i"]], "vf" -> elem[env0["c"][str["Vf"]], env1["i"]], "err" -> elem[env0["c"][str["e_Vf"]], env1["i"]], "mass" -> mul[power[10., elem[env0["c"][str["log(Mb)"]], env1["i"]]], Sparc["MSUN"]], "err_mass" -> elem[env0["c"][str["e_log(Mb)"]], env1["i"]] }]]]], {iter1, 0., num[env0["t"]["rows"]] - 1.}];
    Sparc["CACHE"][str["btfr"] -> env0["out"]];
    Throw[env0["out"], ret]]];
  statik[klass, "discs", mfn[1,
    If[truthy[(!eq[Sparc["CACHE"][str["discs"]], Null])],
      Throw[Sparc["CACHE"][str["discs"]], ret]];
    env0["d"] = Measured["of", "genzel-discs"];
    If[truthy[eq[env0["d"], Null]],
      fail["genzel-discs is not on disk - run `npx ray data` and try again"]];
    env0["c"] = env0["d"]["columns"];
    env0["names"] = env0["d"]["header"][str["names"]];
    env0["out"] = mMap[rng[len[env0["names"]]], lfn[3, { env2["i"] = arg[args3, 0] };
      Throw[HighZ[{ "name" -> elem[env0["names"], env2["i"]], "redshift" -> elem[env0["c"][str["z"]], env2["i"]], "Mb" -> elem[env0["c"][str["Mb"]], env2["i"]], "Re" -> elem[env0["c"][str["Re"]], env2["i"]], "fraction" -> elem[env0["c"][str["fDM"]], env2["i"]], "err" -> elem[env0["c"][str["e_fDM"]], env2["i"]], "limit" -> gt[elem[env0["c"][str["limit"]], env2["i"]], 0.5] }], ret]]];
    Sparc["CACHE"][str["discs"] -> env0["out"]];
    Throw[env0["out"], ret]]];
  statik[klass, "disc_arrival", mfn[1, { env0["d"] = arg[args1, 0] };
    Throw[div[mul[mul[mul[Sparc["G_NEWTON"], env0["d"]["Mb"]], power[10., 11.]], Sparc["MSUN"]], power[(mul[env0["d"]["Re"], Sparc["KPC"]]), 2.]], ret]]];
  statik[klass, "disc_felt", mfn[1, { env0["d"] = arg[args1, 0] };
    Throw[If[truthy[lt[env0["d"]["fraction"], 1.]], div[Sparc["disc_arrival", env0["d"]], (sub[1., env0["d"]["fraction"]])], Indeterminate], ret]]]]];

DefineClass[Law, "Law", Node, Function[{klass},
  staticField[klass, "CACHE", dfn[Node[{}]]];
  statik[klass, "law", mfn[1,
    If[truthy[eq[Law["CACHE"][str["law"]], Null]],
      Law["CACHE"][str["law"] -> Measured["of", "law"]]];
    If[truthy[eq[Law["CACHE"][str["law"]], Null]],
      fail["law is not on disk - run `npx ray measure` and try again"]];
    Throw[Law["CACHE"][str["law"]], ret]]];
  statik[klass, "a0", mfn[1,
    Throw[Law["law"]["header"][str["a0"]], ret]]];
  statik[klass, "carries", mfn[1,
    Throw[orElse[Law["law"]["header"][str["carries"]], 0.], ret]]];
  statik[klass, "theory", mfn[1,
    Throw[orElse[Law["law"]["header"][str["theory"]], "G"], ret]]];
  statik[klass, "boost", mfn[1, { env0["gN"] = arg[args1, 0], env0["scale"] = arg[args1, 1] };
    env0["A0"] = Law["a0"];
    env0["xs_"] = Law["law"]["columns"][str["gN"]];
    env0["ys_"] = Law["law"]["columns"][str["g"]];
    env0["want"] = mul[(div[env0["gN"], env0["scale"]]), env0["A0"]];
    env0["lo"] = 0.;
    env0["hi"] = sub[Law["law"]["rows"], 1.];
    If[truthy[le[env0["want"], elem[env0["xs_"], 0.]]],
      Throw[mul[(div[elem[env0["ys_"], 0.], env0["A0"]]), env0["scale"]], ret]];
    If[truthy[ge[env0["want"], elem[env0["xs_"], env0["hi"]]]],
      Throw[mul[(div[elem[env0["ys_"], env0["hi"]], env0["A0"]]), env0["scale"]], ret]];
    While[truthy[gt[sub[env0["hi"], env0["lo"]], 1.]],
      env0["mid"] = mFloor[(div[(add[env0["lo"], env0["hi"]]), 2.])];
      If[truthy[le[elem[env0["xs_"], env0["mid"]], env0["want"]]],
        env0["lo"] = env0["mid"],
        env0["hi"] = env0["mid"]]];
    env0["t"] = div[(sub[mLn[env0["want"]], mLn[elem[env0["xs_"], env0["lo"]]]]), (sub[mLn[elem[env0["xs_"], env0["hi"]]], mLn[elem[env0["xs_"], env0["lo"]]]])];
    Throw[mul[(div[mExp[(add[mLn[elem[env0["ys_"], env0["lo"]]], mul[env0["t"], (sub[mLn[elem[env0["ys_"], env0["hi"]]], mLn[elem[env0["ys_"], env0["lo"]]]])]])], env0["A0"]]), env0["scale"]], ret]]]]];

DefineClass[Galaxies, "Galaxies", Node, Function[{klass},
  staticField[klass, "A0_DATA", dfn[div[1.2, power[10., 10.]]]];
  staticField[klass, "YLIGHT", dfn[0.3]];
  staticField[klass, "YHEAVY", dfn[0.8]];
  staticField[klass, "BACK", dfn["#08090d"]];
  staticField[klass, "FAINT", dfn["#5a5f6e"]];
  staticField[klass, "GRID", dfn["rgba(120,127,148,0.13)"]];
  staticField[klass, "SEEN", dfn["#eef0f5"]];
  staticField[klass, "MODEL", dfn["#4aa8eb"]];
  staticField[klass, "RUN", dfn["#f2e05a"]];
  staticField[klass, "NEWT", dfn["#eb964a"]];
  staticField[klass, "DISCC", dfn["#c98bd4"]];
  staticField[klass, "BTFRC", dfn["#cd5c5c"]];
  staticField[klass, "POINTS", dfn["rgba(255,255,255,0.70)"]];
  staticField[klass, "POINTS_LABEL", dfn["#ffffff"]];
  staticField[klass, "GALAXY", dfn["#5fd18a"]];
  staticField[klass, "GALAXY_LABEL", dfn["#8ce0a8"]];
  staticField[klass, "XMIN", dfn[neg[4.]]];
  staticField[klass, "XMAX", dfn[3.]];
  staticField[klass, "YMIN", dfn[neg[3.]]];
  staticField[klass, "YMAX", dfn[3.]];
  staticField[klass, "SEVERAL", dfn[list[86., 168., 235.]]];
  staticField[klass, "FREEDOMS", dfn[list["mass", "face", "moving", "spread"]]];
  staticField[klass, "TINTS", dfn[list[list[232., 193., 90.], list[90., 212., 193.], list[240., 122., 178.], list[169., 139., 224.]]]];
  staticField[klass, "NAMES_NOW", dfn[list["mass", "face", "moving", "spread"]]];
  staticField[klass, "LEVELS", dfn[list[neg[4.], neg[2.], 0., 1., 2., 3.]]];
  staticField[klass, "WIDTHS", dfn[list[0., 2.]]];
  staticField[klass, "DISK_ID", dfn["law.disk"]];
  staticField[klass, "DISKC", dfn["#8be9fd"]];
  staticField[klass, "MEDIUM_ID", dfn["law.medium"]];
  staticField[klass, "H0", dfn[70.]];
  staticField[klass, "SETTLE", dfn[24.]];
  staticField[klass, "CURVE_ROWS", dfn[3.]];
  staticField[klass, "CURVE_COLS", dfn[4.]];
  staticField[klass, "SIMULATED", dfn["npx ray measure galaxy.simulated"]];
  staticField[klass, "FITTED", dfn["#9fd3f5"]];
  staticField[klass, "ARMS", dfn[Node[{}]]];
  statik[klass, "freedoms_of", mfn[1, { env0["data"] = arg[args1, 0] };
    Throw[orElse[env0["data"]["header"][str["freedoms"]], Galaxies["FREEDOMS"]], ret]]];
  statik[klass, "bit", mfn[1, { env0["mask"] = arg[args1, 0], env0["at"] = arg[args1, 1] };
    Throw[eq[(mod[mFloor[(div[env0["mask"], power[2., env0["at"]]])], 2.]), 1.], ret]]];
  statik[klass, "tint_of", mfn[1, { env0["mask"] = arg[args1, 0] };
    If[truthy[eq[env0["mask"], 0.]],
      Throw[Galaxies["SEVERAL"], ret]];
    env0["r"] = 0.;
    env0["g"] = 0.;
    env0["bl"] = 0.;
    env0["n"] = 0.;
    Do[loopScope[1, env1["i"] = iter1;
      If[truthy[Galaxies["bit", env0["mask"], env1["i"]]],
        env0["r"] = add[env0["r"], elem[elem[Galaxies["TINTS"], env1["i"]], 0.]];
        env0["g"] = add[env0["g"], elem[elem[Galaxies["TINTS"], env1["i"]], 1.]];
        env0["bl"] = add[env0["bl"], elem[elem[Galaxies["TINTS"], env1["i"]], 2.]];
        env0["n"] = add[env0["n"], 1.]]], {iter1, 0., num[len[Galaxies["FREEDOMS"]]] - 1.}];
    Throw[If[truthy[gt[env0["n"], 0.]], list[div[env0["r"], env0["n"]], div[env0["g"], env0["n"]], div[env0["bl"], env0["n"]]], Galaxies["SEVERAL"]], ret]]];
  statik[klass, "name_of", mfn[1, { env0["mask"] = arg[args1, 0] };
    If[truthy[eq[env0["mask"], 0.]],
      Throw["the source as it starts", ret]];
    env0["parts"] = list[];
    Do[loopScope[1, env1["i"] = iter1;
      If[truthy[Galaxies["bit", env0["mask"], env1["i"]]],
        mPush[env0["parts"], elem[Galaxies["NAMES_NOW"], env1["i"]]]]], {iter1, 0., num[len[Galaxies["NAMES_NOW"]]] - 1.}];
    env0["joined"] = mJoin[env0["parts"], " + "];
    Throw["needs " <> str[env0["joined"]] <> "", ret]]];
  statik[klass, "rgb", mfn[1, { env0["c"] = arg[args1, 0] };
    env0["r"] = mRound[elem[env0["c"], 0.]];
    env0["g"] = mRound[elem[env0["c"], 1.]];
    env0["bl"] = mRound[elem[env0["c"], 2.]];
    Throw["rgb(" <> str[env0["r"]] <> "," <> str[env0["g"]] <> "," <> str[env0["bl"]] <> ")", ret]]];
  statik[klass, "discs_at", mfn[1, { env0["lx"] = arg[args1, 0] };
    env0["best"] = Indeterminate;
    env0["far"] = 0.;
    Do[loopScope[1, env1["d"] = iter1;
      env1["x"] = Fmt["log10", div[Sparc["disc_arrival", env1["d"]], Galaxies["A0_DATA"]]];
      env1["y"] = Fmt["log10", div[Sparc["disc_felt", env1["d"]], Galaxies["A0_DATA"]]];
      If[truthy[andV[Fmt["finite", env1["y"]], (orV[not[Fmt["finite", env0["best"]]], lt[mAbs[(sub[env1["x"], env0["lx"]])], env0["far"]]])]],
        env0["best"] = env1["y"];
        env0["far"] = mAbs[(sub[env1["x"], env0["lx"]])]]], {iter1, items[Sparc["discs"]]}];
    Throw[env0["best"], ret]]];
  statik[klass, "mass_text", mfn[1, { env0["level"] = arg[args1, 0] };
    If[truthy[eq[env0["level"], 0.]],
      Throw["×1 mass", ret]];
    If[truthy[eq[env0["level"], 1.]],
      Throw["×10 mass", ret]];
    Throw["×10^" <> str[Fmt["fixed", env0["level"], 0.]] <> " mass", ret]]];
  statik[klass, "law_at", mfn[1, { env0["lx"] = arg[args1, 0] };
    env0["a0"] = Law["a0"];
    Throw[Fmt["log10", div[Law["boost", mul[power[10., env0["lx"]], env0["a0"]], env0["a0"]], env0["a0"]]], ret]]];
  statik[klass, "carries", mfn[1,
    Throw[Law["carries"], ret]]];
  statik[klass, "band_at", mfn[1, { env0["lx"] = arg[args1, 0] };
    Throw[list[Galaxies["law_at", env0["lx"]], Galaxies["law_at", sub[env0["lx"], Galaxies["carries"]]]], ret]]];
  statik[klass, "offsets", mfn[1, { env0["YD"] = arg[args1, 0] };
    env0["t"] = Sparc["curves"];
    env0["C"] = env0["t"]["columns"];
    env0["out"] = list[];
    env0["YB"] = If[truthy[gt[Sparc["YD"], 0.]], div[mul[env0["YD"], Sparc["YB"]], Sparc["YD"]], env0["YD"]];
    Do[loopScope[1, env1["i"] = iter1;
      env1["g"] = elem[env0["C"][str["galaxy"]], env1["i"]];
      env1["R"] = mul[elem[env0["C"][str["R"]], env1["i"]], Sparc["KPC"]];
      env1["v"] = mul[elem[env0["C"][str["Vobs"]], env1["i"]], Sparc["KMS"]];
      If[truthy[andV[andV[andV[Sparc["usable", env1["g"]], gt[env1["R"], 0.]], gt[env1["v"], 0.]], le[elem[env0["C"][str["e_Vobs"]], env1["i"]], mul[0.1, elem[env0["C"][str["Vobs"]], env1["i"]]]]]],
        env1["gas"] = mul[elem[env0["C"][str["Vgas"]], env1["i"]], Sparc["KMS"]];
        env1["disk"] = mul[elem[env0["C"][str["Vdisk"]], env1["i"]], Sparc["KMS"]];
        env1["bul"] = mul[elem[env0["C"][str["Vbul"]], env1["i"]], Sparc["KMS"]];
        env1["gbar"] = div[(add[add[mul[env1["gas"], mAbs[env1["gas"]]], mul[mul[env0["YD"], env1["disk"]], mAbs[env1["disk"]]]], mul[mul[env0["YB"], env1["bul"]], mAbs[env1["bul"]]]]), env1["R"]];
        If[truthy[gt[env1["gbar"], 0.]],
          mPush[env0["out"], sub[Fmt["log10", div[div[mul[env1["v"], env1["v"]], env1["R"]], Galaxies["A0_DATA"]]], Galaxies["law_at", Fmt["log10", div[env1["gbar"], Galaxies["A0_DATA"]]]]]]]]], {iter1, 0., num[env0["t"]["rows"]] - 1.}];
    Throw[env0["out"], ret]]];
  statik[klass, "middle", mfn[1, { env0["xs"] = arg[args1, 0] };
    If[truthy[mEmpty[env0["xs"]]],
      Throw[Indeterminate, ret]];
    env0["sorted"] = Expr["sorted", env0["xs"]];
    Throw[elem[env0["sorted"], mFloor[(div[len[env0["sorted"]], 2.])]], ret]]];
  statik[klass, "asks", mfn[1,
    env0["lo"] = 0.05;
    env0["hi"] = 2.;
    Do[loopScope[1, env1["i"] = iter1;
      env1["mid"] = div[(add[env0["lo"], env0["hi"]]), 2.];
      If[truthy[gt[Galaxies["middle", Galaxies["offsets", env1["mid"]]], 0.]],
        env0["lo"] = env1["mid"],
        env0["hi"] = env1["mid"]]], {iter1, 0., num[30.] - 1.}];
    Throw[div[(add[env0["lo"], env0["hi"]]), 2.], ret]]];
  statik[klass, "medium_at", mfn[1, { env0["lx"] = arg[args1, 0] };
    env0["m"] = Measured["of", Galaxies["MEDIUM_ID"]];
    If[truthy[eq[env0["m"], Null]],
      Throw[Indeterminate, ret]];
    env0["xs_"] = env0["m"]["columns"][str["gN"]];
    env0["ys_"] = env0["m"]["columns"][str["g"]];
    env0["a0"] = Law["a0"];
    env0["want"] = mul[power[10., env0["lx"]], env0["a0"]];
    env0["n"] = env0["m"]["rows"];
    If[truthy[orV[orV[lt[env0["n"], 2.], lt[env0["want"], elem[env0["xs_"], 0.]]], gt[env0["want"], elem[env0["xs_"], sub[env0["n"], 1.]]]]],
      Throw[Indeterminate, ret]];
    env0["lo"] = 0.;
    env0["hi"] = sub[env0["n"], 1.];
    While[truthy[gt[sub[env0["hi"], env0["lo"]], 1.]],
      env0["mid"] = mFloor[(div[(add[env0["lo"], env0["hi"]]), 2.])];
      If[truthy[le[elem[env0["xs_"], env0["mid"]], env0["want"]]],
        env0["lo"] = env0["mid"],
        env0["hi"] = env0["mid"]]];
    env0["span"] = sub[elem[env0["xs_"], env0["hi"]], elem[env0["xs_"], env0["lo"]]];
    env0["f"] = If[truthy[gt[env0["span"], 0.]], div[(sub[env0["want"], elem[env0["xs_"], env0["lo"]]]), env0["span"]], 0.];
    env0["got"] = add[mul[elem[env0["ys_"], env0["lo"]], (sub[1., env0["f"]])], mul[elem[env0["ys_"], env0["hi"]], env0["f"]]];
    Throw[If[truthy[gt[env0["got"], 0.]], Fmt["log10", div[env0["got"], env0["a0"]]], Indeterminate], ret]]];
  statik[klass, "along", mfn[1, { env0["s"] = arg[args1, 0], env0["at"] = arg[args1, 1], env0["t"] = arg[args1, 2], env0["text"] = arg[args1, 3], env0["colour"] = arg[args1, 4], env0["lift"] = arg[args1, 5], env0["leans"] = arg[args1, 6] };
    env0["p0"] = env0["leans"][sub[env0["t"], 0.01]];
    env0["p1"] = env0["leans"][add[env0["t"], 0.01]];
    env0["c"] = env0["at"][env0["t"]];
    env0["angle"] = mAtan2[(sub[elem[env0["p1"], 1.], elem[env0["p0"], 1.]]), sub[elem[env0["p1"], 0.], elem[env0["p0"], 0.]]];
    env0["s"]["save"];
    env0["s"]["translate", elem[env0["c"], 0.], elem[env0["c"], 1.]];
    env0["s"]["rotate", env0["angle"]];
    env0["s"]["font", "11px ui-monospace, monospace"];
    env0["s"]["text_align", "center"];
    env0["s"]["text_baseline", "alphabetic"];
    env0["w"] = env0["s"]["measure", env0["text"]];
    env0["s"]["fill_style", Galaxies["BACK"]];
    env0["s"]["fill_rect", sub[sub[0., div[env0["w"], 2.]], 4.], sub[env0["lift"], 9.], add[env0["w"], 8.], 12.];
    env0["s"]["fill_style", env0["colour"]];
    env0["s"]["fill_text", env0["text"], 0., env0["lift"]];
