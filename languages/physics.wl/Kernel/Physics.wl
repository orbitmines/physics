DefineClass[RaySolve, "Solve", Node, Function[{klass},
  statik[klass, "settles", mfn[1, { env0["R"] = arg[args1, 0] };
    env0["a"] = mul[env0["R"]["sigma"], env0["R"]["F"]];
    env0["b"] = env0["R"]["nu"];
    env0["c"] = neg[env0["R"]["nu"]];
    If[truthy[eq[env0["a"], 0.]],
      Throw[1., ret]];
    Throw[div[(add[neg[env0["b"]], mSqrt[(sub[mul[env0["b"], env0["b"]], mul[mul[4., env0["a"]], env0["c"]]])]]), (mul[2., env0["a"]])], ret]]];
  statik[klass, "root", mfn[1, { env0["s"] = arg[args1, 0], env0["name"] = arg[args1, 1], env0["f"] = arg[args1, 2] };
    env0["had"] = elem[env0["s"], env0["name"]];
    env0["at"] = lfn[2, { env1["x"] = arg[args2, 0] };
      setAt[env0["s"], env0["name"], env1["x"]];
      Throw[env0["f"][env0["s"]], ret]];
    env0["lo"] = 0.;
    env0["hi"] = 1.;
    env0["flo"] = env0["at"][env0["lo"]];
    env0["fhi"] = env0["at"][env0["hi"]];
    If[truthy[gt[mul[env0["flo"], env0["fhi"]], 0.]],
      setAt[env0["s"], env0["name"], env0["had"]];
      Throw[If[truthy[lt[mAbs[env0["flo"]], mAbs[env0["fhi"]]]], env0["lo"], env0["hi"]], ret]];
    env0["i"] = 0.;
    While[truthy[lt[env0["i"], 60.]],
      env0["mid"] = div[(add[env0["lo"], env0["hi"]]), 2.];
      env0["fm"] = env0["at"][env0["mid"]];
      If[truthy[le[mul[env0["fm"], env0["flo"]], 0.]],
        env0["hi"] = env0["mid"],
        env0["lo"] = env0["mid"];
        env0["flo"] = env0["fm"]];
      env0["i"] = add[env0["i"], 1.]];
    setAt[env0["s"], env0["name"], env0["had"]];
    Throw[div[(add[env0["lo"], env0["hi"]]), 2.], ret]]];
  statik[klass, "sweep", mfn[1, { env0["R"] = arg[args1, 0], env0["geometry"] = arg[args1, 1], env0["radius"] = arg[args1, 2], env0["size"] = arg[args1, 3], env0["passes"] = arg[args1, 4], env0["tol"] = arg[args1, 5] };
    If[truthy[eq[env0["size"], Null]],
      env0["size"] = 41.];
    If[truthy[eq[env0["passes"], Null]],
      env0["passes"] = 400.];
    If[truthy[eq[env0["tol"], Null]],
      env0["tol"] = 0.000000000001];
    env0["L"] = env0["size"];
    env0["D"] = env0["geometry"]["D"];
    env0["rho"] = RaySolve["settles", env0["R"]];
    env0["c"] = div[sub[env0["L"], 1.], 2.];
    env0["cells"] = power[env0["L"], env0["D"]];
    env0["stride"] = mMap[rng[env0["D"]], lfn[3, { env2["i"] = arg[args3, 0] };
      Throw[power[env0["L"], env2["i"]], ret]]];
    env0["step"] = mMap[env0["geometry"]["offsets"], lfn[3, { env2["v"] = arg[args3, 0] };
      Throw[mMap[env2["v"]["components"], lfn[5, { env4["x"] = arg[args5, 0] };
        Throw[mRound[env4["x"]], ret]]], ret]]];
    env0["M"] = len[env0["step"]];
    env0["shift"] = mMap[env0["step"], lfn[3, { env2["v"] = arg[args3, 0] };
      Throw[mSum[mMap[rng[env0["D"]], lfn[5, { env4["i"] = arg[args5, 0] };
        Throw[mul[elem[env2["v"], env4["i"]], elem[env0["stride"], env4["i"]]], ret]]]], ret]]];
    env0["opp"] = mMap[env0["step"], lfn[3, { env2["v"] = arg[args3, 0] };
      Throw[orElse[mIndexOf[env0["step"], mMap[env2["v"], lfn[5, { env4["x"] = arg[args5, 0] };
        Throw[sub[0., env4["x"]], ret]]]], neg[1.]], ret]]];
    env0["coord"] = lfn[2, { env1["k"] = arg[args2, 0] };
      Throw[mMap[rng[env0["D"]], lfn[4, { env3["i"] = arg[args4, 0] };
        Throw[mod[mFloor[(div[env1["k"], elem[env0["stride"], env3["i"]]])], env0["L"]], ret]]], ret]];
    env0["is_matter"] = mMap[rng[env0["cells"]], lfn[3, { env2["k"] = arg[args3, 0] };
      env2["p"] = env0["coord"][env2["k"]];
      Throw[le[mSqrt[(mSum[mMap[rng[env0["D"]], lfn[5, { env4["i"] = arg[args5, 0] };
        Throw[power[(sub[elem[env2["p"], env4["i"]], env0["c"]]), 2.], ret]]]])], env0["radius"]], ret]]];
    env0["n"] = filled[mul[env0["cells"], env0["M"]], div[env0["rho"], env0["M"]]];
    env0["next"] = filled[mul[env0["cells"], env0["M"]], 0.];
    env0["s"] = filled[env0["cells"], 1.];
    env0["settled"] = False;
    env0["done"] = 0.;
    While[truthy[andV[lt[env0["done"], env0["passes"]], not[env0["settled"]]]],
      Do[loopScope[1, env1["i"] = iter1;
        setAt[env0["next"], env1["i"], 0.]], {iter1, 0., num[mul[env0["cells"], env0["M"]]] - 1.}];
      env0["moved"] = 0.;
      Do[loopScope[1, env1["k"] = iter1;
        env1["tot"] = mSum[mMap[rng[env0["M"]], lfn[4, { env3["d"] = arg[args4, 0] };
          Throw[elem[env0["n"], add[mul[env1["k"], env0["M"]], env3["d"]]], ret]]]];
        env1["made"] = If[truthy[elem[env0["is_matter"], env1["k"]]], 0., mul[env0["R"]["nu"], (If[truthy[gt[sub[1., env1["tot"]], 0.]], sub[1., env1["tot"]], 0.])]];
        env1["sp"] = div[1., elem[env0["s"], env1["k"]]];
        Do[loopScope[2, env2["d"] = iter2;
          env2["here"] = elem[env0["n"], add[mul[env1["k"], env0["M"]], env2["d"]]];
          env2["facing"] = elem[env0["n"], add[mul[env1["k"], env0["M"]], (If[truthy[lt[elem[env0["opp"], env2["d"]], 0.]], env2["d"], elem[env0["opp"], env2["d"]]])]];
          env2["killed"] = mul[mul[mul[mul[env0["R"]["sigma"], (sub[1., env0["R"]["g"]])], env2["here"]], env2["facing"]], env0["R"]["F"]];
          env2["left"] = sub[sub[add[env2["here"], div[env1["made"], env0["M"]]], env2["killed"]], (If[truthy[elem[env0["is_matter"], env1["k"]]], env2["here"], 0.])];
          env2["left"] = If[truthy[lt[env2["left"], 0.]], 0., env2["left"]];
          env2["p"] = env0["coord"][env1["k"]];
          env2["inside"] = mEvery[rng[env0["D"]], lfn[5, { env4["i"] = arg[args5, 0] };
            Throw[andV[ge[add[elem[env2["p"], env4["i"]], elem[elem[env0["step"], env2["d"]], env4["i"]]], 0.], lt[add[elem[env2["p"], env4["i"]], elem[elem[env0["step"], env2["d"]], env4["i"]]], env0["L"]]], ret]]];
          If[truthy[env2["inside"]],
            setAt[env0["next"], add[mul[(add[env1["k"], elem[env0["shift"], env2["d"]]]), env0["M"]], env2["d"]], add[elem[env0["next"], add[mul[(add[env1["k"], elem[env0["shift"], env2["d"]]]), env0["M"]], env2["d"]]], mul[env2["left"], env1["sp"]]]];
            setAt[env0["next"], add[mul[env1["k"], env0["M"]], env2["d"]], add[elem[env0["next"], add[mul[env1["k"], env0["M"]], env2["d"]]], mul[env2["left"], (sub[1., env1["sp"]])]]]]], {iter2, 0., num[env0["M"]] - 1.}]], {iter1, 0., num[env0["cells"]] - 1.}];
      Do[loopScope[1, env1["i"] = iter1;
        env1["delta"] = mAbs[(sub[elem[env0["next"], env1["i"]], elem[env0["n"], env1["i"]]])];
        If[truthy[gt[env1["delta"], env0["moved"]]],
          env0["moved"] = env1["delta"]];
        setAt[env0["n"], env1["i"], elem[env0["next"], env1["i"]]]], {iter1, 0., num[mul[env0["cells"], env0["M"]]] - 1.}];
      env0["settled"] = lt[env0["moved"], env0["tol"]];
      env0["done"] = add[env0["done"], 1.]];
    env0["dens"] = mMap[rng[env0["cells"]], lfn[3, { env2["k"] = arg[args3, 0] };
      Throw[mSum[mMap[rng[env0["M"]], lfn[5, { env4["d"] = arg[args5, 0] };
        Throw[elem[env0["n"], add[mul[env2["k"], env0["M"]], env4["d"]]], ret]]]], ret]]];
    env0["imbalance"] = mMap[rng[env0["cells"]], lfn[3, { env2["k"] = arg[args3, 0] };
      env2["p"] = env0["coord"][env2["k"]];
      env2["f"] = mMap[rng[env0["D"]], lfn[5, { env4["i"] = arg[args5, 0] };
        Throw[mSum[mMap[rng[env0["M"]], lfn[7, { env6["d"] = arg[args7, 0] };
          Throw[mul[elem[env0["n"], add[mul[env2["k"], env0["M"]], env6["d"]]], elem[elem[env0["step"], env6["d"]], env4["i"]]], ret]]]], ret]]];
      env2["r"] = mMap[rng[env0["D"]], lfn[5, { env4["i"] = arg[args5, 0] };
        Throw[sub[env0["c"], elem[env2["p"], env4["i"]]], ret]]];
      env2["norm"] = mSqrt[(mSum[mMap[env2["r"], lfn[5, { env4["x"] = arg[args5, 0] };
        Throw[mul[env4["x"], env4["x"]], ret]]]])];
      Throw[div[(mSum[mMap[rng[env0["D"]], lfn[5, { env4["i"] = arg[args5, 0] };
        Throw[mul[elem[env2["f"], env4["i"]], elem[env2["r"], env4["i"]]], ret]]]]), (If[truthy[gt[env2["norm"], 0.]], env2["norm"], 1.])], ret]]];
    Throw[RayGrid[{ "L" -> env0["L"], "n" -> env0["dens"], "s" -> env0["s"], "rho" -> env0["rho"], "passes" -> env0["done"], "settled" -> env0["settled"], "imbalance" -> env0["imbalance"] }], ret]]]]];

