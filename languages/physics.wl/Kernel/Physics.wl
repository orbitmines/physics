      env1["leaf"] = call[K["Step"], "of", { call[K["Fact"], "stands", { "how " <> str[get[env1["t"], "symbol"]] <> " answers a change in the density", env1["signed"] }], "differentiating a term", list[call[K["Fact"], "key_of", { "is", get[env1["t"], "symbol"] }]], "" <> str[env1["nm"]] <> " contributes " <> str[get[env1["t"], "symbol"]] <> ", which is its rate times what its gates let through times the density to the power its quantifier gives. How that answers a small change in the density is the DERIVATIVE - the product rule, on what the rule already said the term was. A term that shrinks as the density rises pushes a shortfall back, so the sign is turned about what the term itself carries", list["" <> str[get[env1["t"], "symbol"]] <> " = " <> str[call[K["Expr"], "show", { env1["body"] }]] <> "", "d/d\\rho = " <> str[call[K["Expr"], "show", { env1["slope"] }]] <> "", "the term is " <> str[env1["how"]] <> ", so it restores by " <> str[call[K["Expr"], "show", { env1["signed"] }]] <> ""] }];
