    Throw[elem[self["rho"], env0["c"]], ret]]];
  getter[klass, "mean", mfn[1,
    env0["total"] = 0.;
    Do[loopScope[1, env1["c"] = iter1;
      env0["total"] = add[env0["total"], elem[self["rho"], env1["c"]]]], {iter1, 0., num[self["cells"]] - 1.}];
    Throw[div[env0["total"], self["cells"]], ret]]]]];

