    env0["x"] = 0.;
    env0["y"] = 0.;
    Do[loopScope[1, env1["i"] = iter1;
      If[truthy[andV[(!eq[env1["i"], env0["k"]]), (orV[not[env0["held"]], not[get[elem[env0["holes"], env1["i"]], "moves"]]])]],
        env0["m"] = add[env0["m"], get[elem[env0["holes"], env1["i"]], "mass"]];
        env0["x"] = add[env0["x"], mul[get[elem[env0["holes"], env1["i"]], "x"], get[elem[env0["holes"], env1["i"]], "mass"]]];
        env0["y"] = add[env0["y"], mul[get[elem[env0["holes"], env1["i"]], "y"], get[elem[env0["holes"], env1["i"]], "mass"]]]]], {iter1, 0., num[len[env0["holes"]]] - 1.}];
    Throw[If[truthy[gt[env0["m"], 0.]], list[env0["m"], div[env0["x"], env0["m"]], div[env0["y"], env0["m"]]], list[0., 0., 0.]], ret]]];
  statik[klass, "work", mfn[1, { env0["pulls"] = arg[args1, 0] };
    env0["got"] = 0.;
    Do[loopScope[1, env1["i"] = iter1;
      env1["dr"] = sub[elem[elem[env0["pulls"], add[env1["i"], 1.]], 0.], elem[elem[env0["pulls"], env1["i"]], 0.]];
      env0["got"] = add[env0["got"], mul[div[(add[elem[elem[env0["pulls"], env1["i"]], 1.], elem[elem[env0["pulls"], add[env1["i"], 1.]], 1.]]), 2.], env1["dr"]]]], {iter1, 0., num[sub[len[env0["pulls"]], 1.]] - 1.}];
    Throw[env0["got"], ret]]];
  statik[klass, "where_between", mfn[1, { env0["h"] = arg[args1, 0], env0["rest"] = arg[args1, 1], env0["e"] = arg[args1, 2], env0["K"] = arg[args1, 3], env0["steps"] = arg[args1, 4] };
