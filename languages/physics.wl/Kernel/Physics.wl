        env1["less"] = sub[1., mul[env0["kappa"], call[K["Fmt"], "hypot", { env0["vx"], env0["vy"] }]]];
        env1["g"] = mul[mul[call[K["Setup"], "pull_at_r", { env0["pulls"], env1["r"] }], env0["both"]], (If[truthy[gt[env1["less"], 0.]], env1["less"], 0.])];
        If[truthy[gt[env1["r"], 0.]],
