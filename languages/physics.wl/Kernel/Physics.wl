DefineClass[RayPanel, "Panel", Node, Function[{klass},
  staticField[klass, "BACK", dfn["#08090d"]];
  staticField[klass, "SEEN", dfn["#eef0f5"]];
  staticField[klass, "ONE", dfn["#4aa8eb"]];
  staticField[klass, "TWO", dfn["#8bd48b"]];
  staticField[klass, "PAIR", dfn["#eef0f5"]];
  statik[klass, "lg", mfn[1, { env0["v"] = arg[args1, 0], env0["floor"] = arg[args1, 1] };
    Throw[If[truthy[le[env0["v"], 0.]], 0., div[mLn[(add[1., div[env0["v"], env0["floor"]]])], mLn[(add[1., div[1., env0["floor"]]])]]], ret]]];
  statik[klass, "hex", mfn[1, { env0["c"] = arg[args1, 0], env0["at"] = arg[args1, 1] };
    env0["hi"] = RayPanel["digit", elem[mChars[env0["c"]], env0["at"]]];
    env0["lo"] = RayPanel["digit", elem[mChars[env0["c"]], add[env0["at"], 1.]]];
    Throw[add[mul[env0["hi"], 16.], env0["lo"]], ret]]];
  statik[klass, "digit", mfn[1, { env0["c"] = arg[args1, 0] };
    Throw[If[truthy[ge[env0["c"], 97.]], sub[env0["c"], 87.], (If[truthy[ge[env0["c"], 65.]], sub[env0["c"], 55.], sub[env0["c"], 48.]])], ret]]];
  statik[klass, "mix", mfn[1, { env0["a"] = arg[args1, 0], env0["b"] = arg[args1, 1], env0["f"] = arg[args1, 2] };
    env0["r"] = mRound[(add[mul[RayPanel["hex", env0["a"], 1.], (sub[1., env0["f"]])], mul[RayPanel["hex", env0["b"], 1.], env0["f"]]])];
    env0["g"] = mRound[(add[mul[RayPanel["hex", env0["a"], 3.], (sub[1., env0["f"]])], mul[RayPanel["hex", env0["b"], 3.], env0["f"]]])];
    env0["bl"] = mRound[(add[mul[RayPanel["hex", env0["a"], 5.], (sub[1., env0["f"]])], mul[RayPanel["hex", env0["b"], 5.], env0["f"]]])];
    Throw["rgb(" <> str[env0["r"]] <> "," <> str[env0["g"]] <> "," <> str[env0["bl"]] <> ")", ret]]];
  statik[klass, "blend", mfn[1, { env0["p"] = arg[args1, 0], env0["bys"] = arg[args1, 1], env0["i"] = arg[args1, 2] };
    env0["r"] = 0.;
    env0["g"] = 0.;
    env0["b"] = 0.;
    env0["total"] = 0.;
    Do[loopScope[1, env1["k"] = iter1;
      env1["w"] = If[truthy[eq[elem[env0["bys"], env1["k"]], Null]], 0., Fmt["max", 0., elem[elem[env0["bys"], env1["k"]], env0["i"]]]];
      env1["c"] = orElse[elem[env0["p"]["colours"], env1["k"]], RayPanel["TWO"]];
      env0["r"] = add[env0["r"], mul[env1["w"], RayPanel["hex", env1["c"], 1.]]];
      env0["g"] = add[env0["g"], mul[env1["w"], RayPanel["hex", env1["c"], 3.]]];
      env0["b"] = add[env0["b"], mul[env1["w"], RayPanel["hex", env1["c"], 5.]]];
      env0["total"] = add[env0["total"], env1["w"]]], {iter1, 0., num[len[env0["bys"]]] - 1.}];
    If[truthy[not[(gt[env0["total"], 0.])]],
      Throw[RayPanel["TWO"], ret]];
    Throw["#" <> str[RayPanel["hex2", mRound[(div[env0["r"], env0["total"]])]]] <> "" <> str[RayPanel["hex2", mRound[(div[env0["g"], env0["total"]])]]] <> "" <> str[RayPanel["hex2", mRound[(div[env0["b"], env0["total"]])]]] <> "", ret]]];
  statik[klass, "hex2", mfn[1, { env0["v"] = arg[args1, 0] };
    env0["digits"] = "0123456789abcdef";
    env0["n"] = If[truthy[lt[env0["v"], 0.]], 0., (If[truthy[gt[env0["v"], 255.]], 255., env0["v"]])];
    env0["hi"] = mFloor[(div[env0["n"], 16.])];
    env0["lo"] = sub[env0["n"], mul[env0["hi"], 16.]];
    Throw["" <> str[fromCodepoints[list[elem[mChars[env0["digits"]], env0["hi"]]]]] <> "" <> str[fromCodepoints[list[elem[mChars[env0["digits"]], env0["lo"]]]]] <> "", ret]]];
  statik[klass, "paint", mfn[1, { env0["p"] = arg[args1, 0], env0["s"] = arg[args1, 1], env0["ch"] = arg[args1, 2], env0["t"] = arg[args1, 3], env0["accumulated"] = arg[args1, 4], env0["count"] = arg[args1, 5], env0["trail"] = arg[args1, 6] };
    env0["width"] = env0["s"]["width"];
    env0["H"] = env0["s"]["height"];
    env0["s"]["clear_rect", 0., 0., env0["width"], env0["H"]];
    env0["s"]["fill_style", RayPanel["BACK"]];
    env0["s"]["fill_rect", 0., 0., env0["width"], env0["H"]];
    env0["TOP"] = 14.;
    env0["BOT"] = 14.;
    env0["GAP2"] = 10.;
    env0["cw"] = div[(sub[env0["width"], env0["GAP2"]]), 2.];
    env0["side"] = Fmt["min", env0["cw"], sub[sub[env0["H"], env0["TOP"]], env0["BOT"]]];
    env0["view"] = env0["p"]["view", env0["t"]];
    env0["pz"] = div[env0["side"], (add[mul[mul[2., env0["view"]], env0["p"]["PIX"]], 1.])];
