    Throw["fn powi(b: f32, n: i32) -> f32 {\n  var r: f32 = 1.0;\n  let m: i32 = abs(n);\n  for (var i: i32 = 0; i < m; i = i + 1) { r = r * b; }\n  if (n < 0) { return 1.0 / r; }\n  return r;\n}\nfn choose(n: f32, k: f32) -> f32 {\n  var r: f32 = 1.0;\n  var i: f32 = 0.0;\n  for (var c: i32 = 0; c < 64; c = c + 1) { if (i < k) { r = r * (n - i) / (i + 1.0); i = i + 1.0; } }\n  return r;\n}\nfn finite(v: f32) -> bool { return abs(v) < 1e30 && v == v; }", ret]]];
  statik[klass, "points", mfn[1,
    env0["points"] = list[];
    env0["i"] = 1.;
    While[truthy[le[env0["i"], 120.]],
      mPush[env0["points"], div[env0["i"], 120.]];
      env0["i"] = add[env0["i"], 1.]];
    env0["ex"] = 0.;
    While[truthy[le[env0["ex"], 24.]],
      env0["k"] = 1.;
      While[truthy[lt[env0["k"], 8.]],
        mPush[env0["points"], mul[(power[10., (sub[env0["ex"], 12.])]), (add[1., div[env0["k"], 2.]])]];
        env0["k"] = add[env0["k"], 1.]];
      env0["ex"] = add[env0["ex"], 1.]];
    Throw[call[K["Expr"], "sorted", { env0["points"] }], ret]]];
  statik[klass, "solver", mfn[1, { env0["name"] = arg[args1, 0], env0["f"] = arg[args1, 1] };
    env0["pts"] = get[K["Shaded"], "points"];
    env0["lits"] = mJoin[mMap[env0["pts"], lfn[3, { env2["v"] = arg[args3, 0] };
      Throw[call[K["Shaded"], "literal", { env2["v"] }], ret]]], ", "];
    Throw["const PTS_" <> str[env0["name"]] <> ": array<f32, " <> str[len[env0["pts"]]] <> "> = array<f32, " <> str[len[env0["pts"]]] <> ">(" <> str[env0["lits"]] <> ");\nfn " <> str[env0["name"]] <> "() -> f32 {\n  var lo: f32 = 0.0;\n  var hi: f32 = 0.0;\n  var found: bool = false;\n  var px: f32 = PTS_" <> str[env0["name"]] <> "[0];\n  var pf: f32 = " <> str[env0["f"]] <> "(px);\n  for (var j: i32 = 1; j < " <> str[len[env0["pts"]]] <> "; j = j + 1) {\n    let cx: f32 = PTS_" <> str[env0["name"]] <> "[j];\n    let cf: f32 = " <> str[env0["f"]] <> "(cx);\n    if (!found && finite(pf) && finite(cf) && pf * cf <= 0.0) { lo = px; hi = cx; found = true; }\n    px = cx;\n    pf = cf;\n  }\n  if (!found) { return 1e30; }\n  var flo: f32 = " <> str[env0["f"]] <> "(lo);\n  for (var n: i32 = 0; n < 60; n = n + 1) {\n    let mid: f32 = (lo + hi) / 2.0;\n    let fm: f32 = " <> str[env0["f"]] <> "(mid);\n    if (!finite(fm)) { break; }\n    if (flo * fm <= 0.0) { hi = mid; } else { lo = mid; flo = fm; }\n  }\n  return (lo + hi) / 2.0;\n}", ret]]]]];

cls["Sweep", "Node", Function[{klass},
  field[klass, "model", Null];
  field[klass, "how", Null];
  field[klass, "arrival", dfn[call[get[self, "model"], "fact", { "what arrives with the mass " <> str[get[self, "how"]] <> "" }]]];
  field[klass, "felt", dfn[call[get[self, "model"], "fact", { "F_{g}" }]]];
  field[klass, "rho_at", dfn[call[get[self, "model"], "fact", { "\\rho at R" }]]];
  field[klass, "scale", dfn[call[get[self, "model"], "fact", { "a_{0} along the path" }]]];
  field[klass, "a0", dfn[get[get[self, "model"], "a0_lattice"]]];
  field[klass, "base", dfn[call[K["Sweep"], "base_env", { get[self, "model"] }]]];
  field[klass, "order", dfn[list["mass", "face", "moving", "radiating"]]];
  field[klass, "axes", dfn[get[K["Sweep"], "axes_of"]]];
  field[klass, "R0", dfn[neg[1.]]];
  field[klass, "R1", dfn[8.]];
  field[klass, "RS", dfn[170.]];
  field[klass, "XS", dfn[700.]];
  field[klass, "X0", dfn[neg[5.]]];
  field[klass, "X1", dfn[4.]];
  field[klass, "YS", dfn[520.]];
  field[klass, "Y0", dfn[neg[4.]]];
  field[klass, "Y1", dfn[4.]];
  field[klass, "rad", dfn[mMap[rng[get[self, "RS"]], lfn[2, { env1["i"] = arg[args2, 0] };
    Throw[power[10., (add[get[self, "R0"], div[mul[(sub[get[self, "R1"], get[self, "R0"]]), env1["i"]], (sub[get[self, "RS"], 1.])]])], ret]]]]];
  field[klass, "env", dfn[mMap[get[self, "rad"], lfn[2, { env1["R"] = arg[args2, 0] };
    env1["e"] = call[K["Model"], "copy", { get[self, "base"] }];
    set[env1["e"], str["R"], env1["R"]];
    set[env1["e"], str["r"], env1["R"]];
    set[env1["e"], str["\\bar{r}"], env1["R"]];
    Do[loopScope[2, env2["n"] = iter2;
      env2["g"] = call[get[self, "model"], "fact", { env2["n"] }];
      If[truthy[(!eq[env2["g"], Null])],
        setAt[env1["e"], env2["n"], call[get[self, "model"], "at", { get[env2["g"], "to"], env1["e"] }]]]], {iter2, items[list["n_{f}", "\\sigma_{tr}", "L"]]}];
    Throw[env1["e"], ret]]]]];
  statik[klass, "base_env", mfn[1, { env0["model"] = arg[args1, 0] };
    env0["base"] = make["Node", {}];
    set[env0["base"], str["D"], get[get[get[env0["model"], "theory"], "lattice"], "D"]];
    set[env0["base"], str["DEG"], get[get[get[env0["model"], "theory"], "lattice"], "DEG"]];
    set[env0["base"], str["\\bar{c}"], 1.];
    set[env0["base"], str["m'"], 1.];
    set[env0["base"], str["A'"], 1.];
    set[env0["base"], str["\\bar{R}'"], 1.];
    set[env0["base"], str["m_{\\Sigma}"], 1.];
    set[env0["base"], str["m_{\\Sigma}'"], 1.];
    set[env0["base"], str["\\mathcal{D}"], 1.];
    set[env0["base"], str["\\mathcal{D}'"], 1.];
    set[env0["base"], str["\\beta'"], 0.];
    set[env0["base"], str["\\beta\\cdot\\hat{d}"], 0.];
    set[env0["base"], str["\\beta'\\cdot\\hat{d}"], 0.];
    Do[loopScope[1, env1["rate"] = iter1;
      env1["g"] = call[env0["model"], "fact", { env1["rate"] }];
      If[truthy[(!eq[env1["g"], Null])],
        setAt[env0["base"], env1["rate"], call[env0["model"], "at", { get[env1["g"], "to"], env0["base"] }]]]], {iter1, items[list["\\nu", "\\sigma", "F"]]}];
    env0["rho"] = call[env0["model"], "fact", { "\\rho_{\\infty}" }];
    If[truthy[(!eq[env0["rho"], Null])],
      set[env0["base"], str["\\rho"], call[env0["model"], "at", { get[env0["rho"], "to"], env0["base"] }]]];
    env0["om"] = call[env0["model"], "fact", { "\\omega" }];
    If[truthy[(!eq[env0["om"], Null])],
      set[env0["base"], str["\\omega"], call[env0["model"], "at", { get[env0["om"], "to"], env0["base"] }]]];
    set[env0["base"], str["\\bar{m}_{x}"], 1.];
    set[env0["base"], str["A"], 1.];
    set[env0["base"], str["\\bar{R}"], 0.];
    set[env0["base"], str["\\beta"], 0.];
    Throw[env0["base"], ret]]];
  statik[klass, "axes_of", mfn[1,
    env0["axes"] = make["Node", {}];
    set[env0["axes"], str["mass"], make["Axis", { kw["lo", 2.], kw["hi", 9.], kw["n", 46.] }]];
    set[env0["axes"], str["face"], make["Axis", { kw["lo", 1.], kw["hi", 6.], kw["n", 28.] }]];
    env0["moving"] = make["Axis", { kw["lo", 0.], kw["hi", 0.9], kw["n", 5.] }];
    set[env0["moving"], "linear", True];
    set[env0["axes"], str["moving"], env0["moving"]];
    set[env0["axes"], str["radiating"], make["Axis", { kw["lo", neg[2.]], kw["hi", 2.], kw["n", 5.] }]];
    Throw[env0["axes"], ret]]];
  getter[klass, "dx", mfn[1,
    Throw[div[(sub[get[self, "X1"], get[self, "X0"]]), (sub[get[self, "XS"], 1.])], ret]]];
  getter[klass, "dy", mfn[1,
    Throw[div[(sub[get[self, "Y1"], get[self, "Y0"]]), (sub[get[self, "YS"], 1.])], ret]]];
  method[klass, "point", mfn[1, { env0["k"] = arg[args1, 0], env0["m"] = arg[args1, 1], env0["A"] = arg[args1, 2], env0["beta"] = arg[args1, 3], env0["S0"] = arg[args1, 4] };
    env0["e"] = call[K["Model"], "copy", { elem[get[self, "env"], env0["k"]] }];
    set[env0["e"], str["m"], env0["m"]];
    set[env0["e"], str["A"], env0["A"]];
    set[env0["e"], str["\\bar{R}"], div[env0["m"], env0["A"]]];
    set[env0["e"], str["\\beta"], env0["beta"]];
    set[env0["e"], str["m_{\\Sigma}"], env0["S0"]];
    set[env0["e"], str["m_{\\Sigma}'"], env0["S0"]];
    Throw[env0["e"], ret]]];
  method[klass, "crossed", mfn[1, { env0["m"] = arg[args1, 0], env0["A"] = arg[args1, 1] };
    env0["out"] = filled[get[self, "RS"], 0.];
    env0["total"] = 0.;
    env0["last"] = 0.;
    Do[loopScope[1, env1["k"] = iter1;
      env1["e"] = call[self, "point", { env1["k"], env0["m"], env0["A"], 0., 1. }];
      env1["r"] = call[get[self, "model"], "at", { get[get[self, "rho_at"], "to"], env1["e"] }];
      env1["here"] = If[truthy[andV[andV[call[K["Fmt"], "finite", { env1["r"] }], gt[env1["r"], 0.]], le[env1["r"], 1.]]], env1["r"], get[get[self, "base"], str["\\rho"]]];
      If[truthy[gt[env1["k"], 0.]],
        env0["total"] = add[env0["total"], mul[mul[0.5, (add[env1["here"], env0["last"]])], (sub[elem[get[self, "rad"], env1["k"]], elem[get[self, "rad"], sub[env1["k"], 1.]]])]]];
      env0["last"] = env1["here"];
      setAt[env0["out"], env1["k"], If[truthy[eq[env1["k"], 0.]], env1["here"], div[env0["total"], elem[get[self, "rad"], env1["k"]]]]]], {iter1, 0., num[get[self, "RS"]] - 1.}];
    Throw[env0["out"], ret]]];
  method[klass, "landing", mfn[1, { env0["k"] = arg[args1, 0], env0["m"] = arg[args1, 1], env0["A"] = arg[args1, 2], env0["beta"] = arg[args1, 3], env0["S0"] = arg[args1, 4], env0["avg_k"] = arg[args1, 5] };
    env0["e"] = call[self, "point", { env0["k"], env0["m"], env0["A"], env0["beta"], env0["S0"] }];
    env0["gN"] = call[get[self, "model"], "at", { get[get[self, "arrival"], "to"], env0["e"] }];
    set[env0["e"], str["g_{N}"], env0["gN"]];
    set[env0["e"], str["\\langle\\rho\\rangle"], env0["avg_k"]];
    set[env0["e"], str["a_{0}"], call[get[self, "model"], "at", { get[get[self, "scale"], "to"], env0["e"] }]];
    env0["g"] = call[get[self, "model"], "at", { get[get[self, "felt"], "to"], env0["e"] }];
    Throw[list[If[truthy[gt[env0["gN"], 0.]], call[K["Fmt"], "log10", { div[env0["gN"], get[self, "a0"]] }], Indeterminate], If[truthy[gt[env0["g"], 0.]], call[K["Fmt"], "log10", { div[env0["g"], get[self, "a0"]] }], Indeterminate]], ret]]];
  method[klass, "steps", mfn[1, { env0["vary"] = arg[args1, 0], env0["k"] = arg[args1, 1] };
    Throw[If[truthy[mContains[env0["vary"], env0["k"]]], get[elem[get[self, "axes"], env0["k"]], "n"], 1.], ret]]];
  method[klass, "pick", mfn[1, { env0["vary"] = arg[args1, 0], env0["k"] = arg[args1, 1], env0["i"] = arg[args1, 2] };
    Throw[If[truthy[mContains[env0["vary"], env0["k"]]], call[elem[get[self, "axes"], env0["k"]], "value", { env0["i"] }], get[elem[get[self, "axes"], env0["k"]], "mid"]], ret]]];
  method[klass, "rasterise", mfn[1, { env0["xs_"] = arg[args1, 0], env0["ys_"] = arg[args1, 1], env0["tracks"] = arg[args1, 2] };
    env0["grid"] = filled[mul[get[self, "XS"], get[self, "YS"]], 0.];
    env0["dx"] = get[self, "dx"];
    env0["dy"] = get[self, "dy"];
    env0["RS"] = get[self, "RS"];
    Do[loopScope[1, env1["tr"] = iter1;
      env1["at0"] = mul[env1["tr"], env0["RS"]];
      Do[loopScope[2, env2["k"] = iter2;
        env2["xa"] = elem[env0["xs_"], add[env1["at0"], env2["k"]]];
        env2["xb"] = elem[env0["xs_"], add[add[env1["at0"], env2["k"]], 1.]];
        env2["ya"] = elem[env0["ys_"], add[env1["at0"], env2["k"]]];
        env2["yb"] = elem[env0["ys_"], add[add[env1["at0"], env2["k"]], 1.]];
        If[truthy[andV[andV[andV[call[K["Fmt"], "finite", { env2["xa"] }], call[K["Fmt"], "finite", { env2["xb"] }]], call[K["Fmt"], "finite", { env2["ya"] }]], call[K["Fmt"], "finite", { env2["yb"] }]]],
          env2["st"] = call[K["Fmt"], "max", { 1., sub[0., mFloor[(sub[0., call[K["Fmt"], "max", { div[mAbs[(sub[env2["xb"], env2["xa"]])], env0["dx"]], div[mAbs[(sub[env2["yb"], env2["ya"]])], env0["dy"]] }]])]] }];
          Do[loopScope[3, env3["t"] = iter3;
            env3["f"] = div[(add[env3["t"], 0.5]), env2["st"]];
            env3["gx"] = mRound[(div[(sub[add[env2["xa"], mul[env3["f"], (sub[env2["xb"], env2["xa"]])]], get[self, "X0"]]), env0["dx"]])];
            env3["gy"] = mRound[(div[(sub[add[env2["ya"], mul[env3["f"], (sub[env2["yb"], env2["ya"]])]], get[self, "Y0"]]), env0["dy"]])];
            If[truthy[not[(orV[orV[orV[lt[env3["gx"], 0.], lt[env3["gy"], 0.]], ge[env3["gx"], get[self, "XS"]]], ge[env3["gy"], get[self, "YS"]]])]],
              setAt[env0["grid"], add[mul[env3["gy"], get[self, "XS"]], env3["gx"]], add[elem[env0["grid"], add[mul[env3["gy"], get[self, "XS"]], env3["gx"]]], div[1., env2["st"]]]]]], {iter3, 0., num[env2["st"]] - 1.}]]], {iter2, 0., num[sub[env0["RS"], 1.]] - 1.}]], {iter1, 0., num[env0["tracks"]] - 1.}];
    Throw[env0["grid"], ret]]];
  method[klass, "tracks", mfn[1, { env0["vary"] = arg[args1, 0] };
    env0["nM"] = call[self, "steps", { env0["vary"], "mass" }];
    env0["nA"] = call[self, "steps", { env0["vary"], "face" }];
    env0["nB"] = call[self, "steps", { env0["vary"], "moving" }];
    env0["nS"] = call[self, "steps", { env0["vary"], "radiating" }];
    env0["xs_"] = list[];
    env0["ys_"] = list[];
    Do[loopScope[1, env1["mi"] = iter1;
      env1["m"] = call[self, "pick", { env0["vary"], "mass", env1["mi"] }];
      Do[loopScope[2, env2["ai"] = iter2;
        env2["A"] = call[self, "pick", { env0["vary"], "face", env2["ai"] }];
        env2["avg"] = call[self, "crossed", { env1["m"], env2["A"] }];
        Do[loopScope[3, env3["bi"] = iter3;
          env3["beta"] = call[self, "pick", { env0["vary"], "moving", env3["bi"] }];
          Do[loopScope[4, env4["si"] = iter4;
            env4["S0"] = call[self, "pick", { env0["vary"], "radiating", env4["si"] }];
            Do[loopScope[5, env5["k"] = iter5;
              env5["got"] = call[self, "landing", { env5["k"], env1["m"], env2["A"], env3["beta"], env4["S0"], elem[env2["avg"], env5["k"]] }];
              mPush[env0["xs_"], elem[env5["got"], 0.]];
              mPush[env0["ys_"], elem[env5["got"], 1.]]], {iter5, 0., num[get[self, "RS"]] - 1.}]], {iter4, 0., num[env0["nS"]] - 1.}]], {iter3, 0., num[env0["nB"]] - 1.}]], {iter2, 0., num[env0["nA"]] - 1.}]], {iter1, 0., num[env0["nM"]] - 1.}];
    env0["out"] = make["Node", {}];
    set[env0["out"], str["xs"], env0["xs_"]];
    set[env0["out"], str["ys"], env0["ys_"]];
    set[env0["out"], str["tracks"], mul[mul[mul[env0["nM"], env0["nA"]], env0["nB"]], env0["nS"]]];
    Throw[env0["out"], ret]]];
  method[klass, "needs", mfn[1, { env0["grid"] = arg[args1, 0], env0["without"] = arg[args1, 1] };
    env0["need"] = filled[mul[get[self, "XS"], get[self, "YS"]], 0.];
    Do[loopScope[1, env1["k"] = iter1;
      env1["g"] = elem[env0["without"], env1["k"]];
      Do[loopScope[2, env2["i"] = iter2;
        If[truthy[andV[gt[elem[env0["grid"], env2["i"]], 0.], not[(gt[elem[env1["g"], env2["i"]], 0.])]]],
          setAt[env0["need"], env2["i"], add[elem[env0["need"], env2["i"]], power[2., env1["k"]]]]]], {iter2, 0., num[len[env0["need"]]] - 1.}]], {iter1, 0., num[len[env0["without"]]] - 1.}];
    Throw[env0["need"], ret]]];
  method[klass, "save", mfn[1, { env0["id"] = arg[args1, 0], env0["grid"] = arg[args1, 1], env0["need"] = arg[args1, 2] };
    env0["x"] = list[];
    env0["y"] = list[];
    env0["p"] = list[];
    env0["by"] = list[];
    Do[loopScope[1, env1["gy"] = iter1;
      Do[loopScope[2, env2["gx"] = iter2;
        mPush[env0["x"], add[get[self, "X0"], mul[env2["gx"], get[self, "dx"]]]];
        mPush[env0["y"], add[get[self, "Y0"], mul[env1["gy"], get[self, "dy"]]]];
        mPush[env0["p"], elem[env0["grid"], add[mul[env1["gy"], get[self, "XS"]], env2["gx"]]]];
        mPush[env0["by"], elem[env0["need"], add[mul[env1["gy"], get[self, "XS"]], env2["gx"]]]]], {iter2, 0., num[get[self, "XS"]] - 1.}]], {iter1, 0., num[get[self, "YS"]] - 1.}];
    env0["most"] = 0.;
    Do[loopScope[1, env1["v"] = iter1;
      If[truthy[gt[env1["v"], env0["most"]]],
        env0["most"] = env1["v"]]], {iter1, items[env0["p"]]}];
    env0["columns"] = make["Node", {}];
    set[env0["columns"], str["x"], env0["x"]];
    set[env0["columns"], str["y"], env0["y"]];
    set[env0["columns"], str["p"], env0["p"]];
    set[env0["columns"], str["by"], env0["by"]];
    env0["extra"] = make["Node", {}];
    set[env0["extra"], str["a0"], get[self, "a0"]];
    set[env0["extra"], str["arrangement"], get[self, "how"]];
    set[env0["extra"], str["most"], env0["most"]];
    env0["arrives"] = make["Node", {}];
    set[env0["arrives"], str["from"], get[self, "X0"]];
    set[env0["arrives"], str["to"], get[self, "X1"]];
    set[env0["arrives"], str["n"], get[self, "XS"]];
    env0["felt_axis"] = make["Node", {}];
    set[env0["felt_axis"], str["from"], get[self, "Y0"]];
    set[env0["felt_axis"], str["to"], get[self, "Y1"]];
    set[env0["felt_axis"], str["n"], get[self, "YS"]];
    env0["grid_meta"] = make["Node", {}];
    set[env0["grid_meta"], str["arrives"], env0["arrives"]];
    set[env0["grid_meta"], str["felt"], env0["felt_axis"]];
    set[env0["extra"], str["grid"], env0["grid_meta"]];
    set[env0["extra"], str["freedoms"], get[self, "order"]];
    set[env0["extra"], str["stages"], list["nought is: reachable several ways; otherwise one bit per freedom, in the order of `freedoms`, for each one that is NECESSARY there"]];
    set[env0["extra"], str["about"], "how much of the possible lands at each pair of what arrives and what is felt, and `by` is which freedom that cell NEEDS - found by taking each one away in turn, so it does not depend on any order they might be added in"];
    Throw[call[K["Measure"], "save", { env0["id"], list["x", "y", "p", "by"], env0["columns"], env0["extra"] }], ret]]];
  getter[klass, "probe", mfn[1,
    env0["e"] = call[self, "point", { 0., 1., 1., 0., 1. }];
    set[env0["e"], str["g_{N}"], 1.];
    set[env0["e"], str["a_{0}"], 1.];
    Throw[env0["e"], ret]]];
  getter[klass, "names", mfn[1,
    env0["out"] = list[];
    env0["e0"] = get[self, "probe"];
    Do[loopScope[1, env1["x"] = iter1;
      Do[loopScope[2, env2["n"] = iter2;
        If[truthy[not[mContains[env0["out"], env2["n"]]]],
          mPush[env0["out"], env2["n"]]]], {iter2, items[call[K["Model"], "unbound", { env1["x"] }]]}]], {iter1, items[list[call[get[self, "model"], "prepared", { get[get[get[self, "rho_at"], "to"], "base"], env0["e0"] }], call[get[self, "model"], "prepared", { get[get[self, "arrival"], "to"], env0["e0"] }], call[get[self, "model"], "prepared", { get[get[self, "felt"], "to"], env0["e0"] }], call[get[self, "model"], "prepared", { get[get[self, "scale"], "to"], env0["e0"] }]]]}];
    Do[loopScope[1, env1["n"] = iter1;
      If[truthy[not[mContains[env0["out"], env1["n"]]]],
