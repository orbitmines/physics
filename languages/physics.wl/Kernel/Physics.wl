          env1["span"] = sub[elem[elem[env0["pulls"], add[env1["i"], 1.]], 0.], elem[elem[env0["pulls"], env1["i"]], 0.]];
          env1["f"] = If[truthy[gt[env1["span"], 0.]], div[(sub[env0["r"], elem[elem[env0["pulls"], env1["i"]], 0.]]), env1["span"]], 0.];
          env0["got"] = add[mul[elem[elem[env0["pulls"], env1["i"]], 1.], (sub[1., env1["f"]])], mul[elem[elem[env0["pulls"], add[env1["i"], 1.]], 1.], env1["f"]]];
          env0["found"] = True]]], {iter1, 0., num[sub[env0["n"], 1.]] - 1.}];
    Throw[env0["got"], ret]]];
  statik[klass, "nearest", mfn[1, { env0["pulls"] = arg[args1, 0], env0["v"] = arg[args1, 1], env0["far"] = arg[args1, 2], env0["near"] = arg[args1, 3], env0["both"] = arg[args1, 4], env0["kappa"] = arg[args1, 5], env0["ticks"] = arg[args1, 6] };
    env0["x"] = env0["far"];
    env0["y"] = 0.;
    env0["vx"] = 0.;
    env0["vy"] = env0["v"];
    env0["best"] = env0["far"];
    env0["done"] = False;
    Do[loopScope[1, env1["i"] = iter1;
      If[!truthy[env0["done"]],
        env1["r"] = call[K["Fmt"], "hypot", { env0["x"], env0["y"] }];
        env0["best"] = call[K["Fmt"], "min", { env0["best"], env1["r"] }];
