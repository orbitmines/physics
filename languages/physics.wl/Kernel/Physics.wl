    env0["out"] = list[];
    Do[loopScope[1, env1["g"] = iter1;
      Do[loopScope[2, env2["v"] = iter2;
        mPush[env0["out"], env2["v"]]], {iter2, items[list[div[self["GM", env1["g"]], Formed["N"]], self["soft", env1["g"]], self["scale_a0"], Formed["DT"]]]}]], {iter1, 0., num[self["discs_n"]] - 1.}];
