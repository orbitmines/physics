      env1["ring_r"] = lfn[3, { env2["b"] = arg[args3, 0] };
        Throw[mul[(add[env2["b"], 0.5]), env1["width"]], ret]];
      env1["omega2"] = mMap[rng[Formed["RINGS"]], lfn[4, { env3["b"] = arg[args4, 0] };
        Throw[If[truthy[gt[elem[env1["many"], env3["b"]], 0.]], div[Fmt["max", div[elem[env1["pull"], env3["b"]], elem[env1["many"], env3["b"]]], 0.], env1["ring_r"][env3["b"]]], 0.], ret]]];
      env1["nu"] = mMap[rng[Formed["RINGS"]], lfn[4, { env3["b"] = arg[args4, 0] };
        Throw[If[truthy[gt[elem[env1["many"], env3["b"]], 0.]], div[elem[env1["lift"], env3["b"]], elem[env1["many"], env3["b"]]], 1.], ret]]];
      env1["kappa2"] = mMap[rng[Formed["RINGS"]], lfn[4, { env3["b"] = arg[args4, 0] };
        env3["lo"] = Fmt["max", sub[env3["b"], 1.], 0.];
        env3["hi"] = Fmt["min", add[env3["b"], 1.], sub[Formed["RINGS"], 1.]];
        env3["slope"] = div[(sub[elem[env1["omega2"], env3["hi"]], elem[env1["omega2"], env3["lo"]]]), (sub[env1["ring_r"][env3["hi"]], env1["ring_r"][env3["lo"]]])];
        Throw[Fmt["max", add[mul[env1["ring_r"][env3["b"]], env3["slope"]], mul[4., elem[env1["omega2"], env3["b"]]]], mul[0.25, elem[env1["omega2"], env3["b"]]]], ret]]];
      env1["sigma_gm"] = div[self["GM", env1["g"]], (mul[mul[mul[mul[2., 3.141592653589793], env1["rd"]], env1["rd"]], Formed["inside", Formed["TRUNC"]]])];
      Do[loopScope[2, env2["k"] = iter2;
        env2["i"] = add[mul[env1["g"], Formed["N"]], env2["k"]];
        env2["x"] = elem[env0["state"], mul[4., env2["i"]]];
        env2["y"] = elem[env0["state"], add[mul[4., env2["i"]], 1.]];
        env2["r"] = Fmt["hypot", env2["x"], env2["y"]];
        env2["b"] = Fmt["min", mFloor[(div[env2["r"], env1["width"]])], sub[Formed["RINGS"], 1.]];
