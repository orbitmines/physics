DefineClass[Setup, "Setup", Node, Function[{klass},
  field[klass, "id"];
  field[klass, "what"];
  field[klass, "width"];
  field[klass, "height"];
  field[klass, "theory"];
  field[klass, "DEG", dfn[self["theory"]["lattice"]["DEG"]]];
  field[klass, "D", dfn[self["theory"]["lattice"]["D"]]];
  field[klass, "VIEW", dfn[20.]];
  field[klass, "MARGIN", dfn[8.]];
  field[klass, "A", dfn[96.]];
  field[klass, "K", dfn[3.]];
  field[klass, "PIX", dfn[3.]];
  field[klass, "GAP", dfn[20.]];
  field[klass, "bodies", dfn[2.]];
  field[klass, "TICKS", dfn[2.]];
  field[klass, "RUN", dfn[150.]];
  field[klass, "BURN", dfn[0.]];
  field[klass, "RANGE", dfn["instant"]];
  field[klass, "tags", dfn[2.]];
  field[klass, "stamp", dfn[""]];
  field[klass, "colours", dfn[list[]]];
  field[klass, "probe", dfn[Null]];
  field[klass, "leans", dfn[list[]]];
  field[klass, "trial", dfn[Null]];
  field[klass, "orbits", dfn[list[]]];
  field[klass, "orbits", dfn[list[]]];
  field[klass, "found", dfn[list[]]];
  field[klass, "place"];
  field[klass, "spent", dfn[Null]];
  field[klass, "view"];
  field[klass, "ring", dfn[Null]];
  getter[klass, "side", mfn[1,
    Throw[add[mul[mul[2., (add[self["VIEW"], self["MARGIN"]])], self["K"]], 1.], ret]]];
  getter[klass, "centre", mfn[1,
    Throw[div[(sub[self["side"], 1.]), 2.], ret]]];
  getter[klass, "reach", mfn[1,
    Throw[mul[self["VIEW"], self["PIX"]], ret]]];
  getter[klass, "box_side", mfn[1,
    Throw[add[mul[2., self["reach"]], 1.], ret]]];
  method[klass, "box", mfn[1, { env0["x"] = arg[args1, 0], env0["y"] = arg[args1, 1] };
    Throw[add[mul[(add[env0["y"], self["reach"]]), self["box_side"]], (add[env0["x"], self["reach"]])], ret]]];
  getter[klass, "coarse_side", mfn[1,
    Throw[add[mul[2., self["VIEW"]], 1.], ret]]];
  method[klass, "coarse", mfn[1, { env0["x"] = arg[args1, 0], env0["y"] = arg[args1, 1] };
    env0["cx"] = add[mRound[(div[env0["x"], self["PIX"]])], self["VIEW"]];
    env0["cy"] = add[mRound[(div[env0["y"], self["PIX"]])], self["VIEW"]];
    If[truthy[lt[env0["cx"], 0.]],
      env0["cx"] = 0.];
    If[truthy[lt[env0["cy"], 0.]],
      env0["cy"] = 0.];
    If[truthy[gt[env0["cx"], sub[self["coarse_side"], 1.]]],
      env0["cx"] = sub[self["coarse_side"], 1.]];
    If[truthy[gt[env0["cy"], sub[self["coarse_side"], 1.]]],
      env0["cy"] = sub[self["coarse_side"], 1.]];
    Throw[add[mul[env0["cy"], self["coarse_side"]], env0["cx"]], ret]]];
  statik[klass, "middle", mfn[1, { env0["holes"] = arg[args1, 0] };
    env0["m"] = 0.;
    env0["x"] = 0.;
    env0["y"] = 0.;
    Do[loopScope[1, env1["h"] = iter1;
      env0["m"] = add[env0["m"], env1["h"]["mass"]];
      env0["x"] = add[env0["x"], mul[env1["h"]["x"], env1["h"]["mass"]]];
      env0["y"] = add[env0["y"], mul[env1["h"]["y"], env1["h"]["mass"]]]], {iter1, items[env0["holes"]]}];
    Throw[If[truthy[gt[env0["m"], 0.]], list[div[env0["x"], env0["m"]], div[env0["y"], env0["m"]]], list[0., 0.]], ret]]];
  statik[klass, "rest_of", mfn[1, { env0["holes"] = arg[args1, 0], env0["k"] = arg[args1, 1] };
    env0["held"] = False;
    Do[loopScope[1, env1["i"] = iter1;
      If[truthy[andV[(!eq[env1["i"], env0["k"]]), not[elem[env0["holes"], env1["i"]]["moves"]]]],
        env0["held"] = True]], {iter1, 0., num[len[env0["holes"]]] - 1.}];
    env0["m"] = 0.;
    env0["x"] = 0.;
    env0["y"] = 0.;
    Do[loopScope[1, env1["i"] = iter1;
      If[truthy[andV[(!eq[env1["i"], env0["k"]]), (orV[not[env0["held"]], not[elem[env0["holes"], env1["i"]]["moves"]]])]],
        env0["m"] = add[env0["m"], elem[env0["holes"], env1["i"]]["mass"]];
        env0["x"] = add[env0["x"], mul[elem[env0["holes"], env1["i"]]["x"], elem[env0["holes"], env1["i"]]["mass"]]];
        env0["y"] = add[env0["y"], mul[elem[env0["holes"], env1["i"]]["y"], elem[env0["holes"], env1["i"]]["mass"]]]]], {iter1, 0., num[len[env0["holes"]]] - 1.}];
    Throw[If[truthy[gt[env0["m"], 0.]], list[env0["m"], div[env0["x"], env0["m"]], div[env0["y"], env0["m"]]], list[0., 0., 0.]], ret]]];
  statik[klass, "work", mfn[1, { env0["pulls"] = arg[args1, 0] };
    env0["got"] = 0.;
    Do[loopScope[1, env1["i"] = iter1;
      env1["dr"] = sub[elem[elem[env0["pulls"], add[env1["i"], 1.]], 0.], elem[elem[env0["pulls"], env1["i"]], 0.]];
      env0["got"] = add[env0["got"], mul[div[(add[elem[elem[env0["pulls"], env1["i"]], 1.], elem[elem[env0["pulls"], add[env1["i"], 1.]], 1.]]), 2.], env1["dr"]]]], {iter1, 0., num[sub[len[env0["pulls"]], 1.]] - 1.}];
    Throw[env0["got"], ret]]];
  statik[klass, "where_between", mfn[1, { env0["h"] = arg[args1, 0], env0["rest"] = arg[args1, 1], env0["e"] = arg[args1, 2], env0["K"] = arg[args1, 3], env0["steps"] = arg[args1, 4] };
    env0["dx"] = sub[elem[env0["rest"], 1.], env0["h"]["x"]];
    env0["dy"] = sub[elem[env0["rest"], 2.], env0["h"]["y"]];
    env0["far"] = div[Fmt["hypot", env0["dx"], env0["dy"]], env0["K"]];
    If[truthy[le[env0["far"], 0.]],
      Throw[list[], ret]];
    env0["near"] = div[mul[env0["far"], (sub[1., env0["e"]])], (add[1., env0["e"]])];
    env0["ux"] = sub[0., div[env0["dx"], (mul[env0["far"], env0["K"]])]];
    env0["uy"] = sub[0., div[env0["dy"], (mul[env0["far"], env0["K"]])]];
    Throw[mMap[rng[add[env0["steps"], 1.]], lfn[3, { env2["i"] = arg[args3, 0] };
      env2["d"] = add[env0["near"], div[mul[(sub[env0["far"], env0["near"]]), env2["i"]], env0["steps"]]];
      Throw[list[env2["d"], add[elem[env0["rest"], 1.], mul[mul[env0["ux"], env2["d"]], env0["K"]]], add[elem[env0["rest"], 2.], mul[mul[env0["uy"], env2["d"]], env0["K"]]]], ret]]], ret]]];
  statik[klass, "pulls_between", mfn[1, { env0["w"] = arg[args1, 0], env0["h"] = arg[args1, 1], env0["rest"] = arg[args1, 2], env0["e"] = arg[args1, 3], env0["K"] = arg[args1, 4], env0["steps"] = arg[args1, 5] };
    env0["zown"] = env0["w"]["plane_of", env0["h"]];
    Throw[mMap[Setup["where_between", env0["h"], env0["rest"], env0["e"], env0["K"], env0["steps"]], lfn[3, { env2["at"] = arg[args3, 0] };
      Throw[list[elem[env2["at"], 0.], env0["w"]["pull_toward", elem[env2["at"], 1.], elem[env2["at"], 2.], elem[env0["rest"], 1.], elem[env0["rest"], 2.], env0["zown"]]], ret]]], ret]]];
  statik[klass, "pull_at_r", mfn[1, { env0["pulls"] = arg[args1, 0], env0["r"] = arg[args1, 1] };
    env0["n"] = len[env0["pulls"]];
    If[truthy[eq[env0["n"], 0.]],
      Throw[0., ret]];
    If[truthy[le[env0["r"], elem[elem[env0["pulls"], 0.], 0.]]],
      Throw[elem[elem[env0["pulls"], 0.], 1.], ret]];
    If[truthy[ge[env0["r"], elem[elem[env0["pulls"], sub[env0["n"], 1.]], 0.]]],
      Throw[elem[elem[env0["pulls"], sub[env0["n"], 1.]], 1.], ret]];
    env0["got"] = elem[elem[env0["pulls"], sub[env0["n"], 1.]], 1.];
    env0["found"] = False;
    Do[loopScope[1, env1["i"] = iter1;
      If[!truthy[env0["found"]],
        If[truthy[andV[le[elem[elem[env0["pulls"], env1["i"]], 0.], env0["r"]], le[env0["r"], elem[elem[env0["pulls"], add[env1["i"], 1.]], 0.]]]],
          env1["span"] = sub[elem[elem[env0["pulls"], add[env1["i"], 1.]], 0.], elem[elem[env0["pulls"], env1["i"]], 0.]];
          env1["f"] = If[truthy[gt[env1["span"], 0.]], div[(sub[env0["r"], elem[elem[env0["pulls"], env1["i"]], 0.]]), env1["span"]], 0.];
          env0["got"] = add[mul[elem[elem[env0["pulls"], env1["i"]], 1.], (sub[1., env1["f"]])], mul[elem[elem[env0["pulls"], add[env1["i"], 1.]], 1.], env1["f"]]];
          env0["found"] = True]]], {iter1, 0., num[sub[env0["n"], 1.]] - 1.}];
    Throw[env0["got"], ret]]];
  statik[klass, "nearest", mfn[1, { env0["pulls"] = arg[args1, 0], env0["v"] = arg[args1, 1], env0["far"] = arg[args1, 2], env0["near"] = arg[args1, 3], env0["both"] = arg[args1, 4], env0["kappa"] = arg[args1, 5], env0["ticks"] = arg[args1, 6] };
    env0["x"] = env0["far"];
    env0["y"] = 0.;
    env0["vx"] = 0.;
    env0["vy"] = env0["v"];
    env0["best"] = env0["far"];
    env0["done"] = False;
    Do[loopScope[1, env1["i"] = iter1;
      If[!truthy[env0["done"]],
        env1["r"] = Fmt["hypot", env0["x"], env0["y"]];
        env0["best"] = Fmt["min", env0["best"], env1["r"]];
        If[truthy[andV[lt[env0["best"], env0["far"]], gt[env1["r"], mul[env0["best"], 1.02]]]],
          env0["done"] = True];
        If[truthy[lt[env1["r"], div[env0["near"], 2.]]],
          env0["done"] = True];
        If[truthy[gt[env1["r"], mul[env0["far"], 1.05]]],
          env0["done"] = True];
        env1["less"] = sub[1., mul[env0["kappa"], Fmt["hypot", env0["vx"], env0["vy"]]]];
        env1["g"] = mul[mul[Setup["pull_at_r", env0["pulls"], env1["r"]], env0["both"]], (If[truthy[gt[env1["less"], 0.]], env1["less"], 0.])];
        If[truthy[gt[env1["r"], 0.]],
          env0["vx"] = sub[env0["vx"], div[mul[env1["g"], env0["x"]], env1["r"]]];
          env0["vy"] = sub[env0["vy"], div[mul[env1["g"], env0["y"]], env1["r"]]]];
        env0["x"] = add[env0["x"], env0["vx"]];
        env0["y"] = add[env0["y"], env0["vy"]]]], {iter1, 0., num[env0["ticks"]] - 1.}];
    Throw[env0["best"], ret]]];
  statik[klass, "thrown", mfn[1, { env0["pulls"] = arg[args1, 0], env0["far"] = arg[args1, 1], env0["near"] = arg[args1, 2], env0["both"] = arg[args1, 3], env0["kappa"] = arg[args1, 4], env0["guess"] = arg[args1, 5] };
    If[truthy[not[(andV[andV[gt[env0["guess"], 0.], gt[env0["far"], 0.]], gt[env0["near"], 0.]])]],
      Throw[env0["guess"], ret]];
    env0["lo"] = 0.;
    env0["hi"] = mul[env0["guess"], 2.];
    Do[loopScope[1, env1["i"] = iter1;
      env1["mid"] = div[(add[env0["lo"], env0["hi"]]), 2.];
      env1["turn"] = mRound[(div[mul[mul[8., 3.141592653589793], env0["far"]], (If[truthy[gt[env1["mid"], 0.]], env1["mid"], 1.])])];
      env1["ticks"] = If[truthy[gt[env1["turn"], 400000.]], 400000., (If[truthy[lt[env1["turn"], 16.]], 16., env1["turn"]])];
      If[truthy[lt[Setup["nearest", env0["pulls"], env1["mid"], env0["far"], env0["near"], env0["both"], env0["kappa"], env1["ticks"]], env0["near"]]],
        env0["lo"] = env1["mid"],
        env0["hi"] = env1["mid"]]], {iter1, 0., num[40.] - 1.}];
    Throw[div[(add[env0["lo"], env0["hi"]]), 2.], ret]]];
  statik[klass, "slower", mfn[1, { env0["rest_far"] = arg[args1, 0], env0["moving_far"] = arg[args1, 1], env0["v"] = arg[args1, 2] };
    If[truthy[not[(andV[gt[env0["rest_far"], 0.], gt[env0["v"], 0.]])]],
      Throw[0., ret]];
    Throw[div[(sub[env0["rest_far"], env0["moving_far"]]), (mul[env0["rest_far"], env0["v"]])], ret]]];
  statik[klass, "orbit", mfn[1, { env0["h"] = arg[args1, 0], env0["rest"] = arg[args1, 1], env0["pulls"] = arg[args1, 2], env0["e"] = arg[args1, 3], env0["px"] = arg[args1, 4], env0["py"] = arg[args1, 5], env0["K"] = arg[args1, 6], env0["kappa"] = arg[args1, 7] };
    env0["dx"] = sub[elem[env0["rest"], 1.], env0["h"]["x"]];
    env0["dy"] = sub[elem[env0["rest"], 2.], env0["h"]["y"]];
    env0["far"] = div[Fmt["hypot", env0["dx"], env0["dy"]], env0["K"]];
    If[truthy[orV[orV[le[env0["far"], 0.], lt[len[env0["pulls"]], 2.]], le[elem[env0["rest"], 0.], 0.]]],
      Throw[list[env0["px"], env0["py"]], ret]];
    env0["near"] = div[mul[env0["far"], (sub[1., env0["e"]])], (add[1., env0["e"]])];
    env0["both"] = div[(add[env0["h"]["mass"], elem[env0["rest"], 0.]]), elem[env0["rest"], 0.]];
    env0["w"] = mul[Setup["work", env0["pulls"]], env0["both"]];
    env0["ratio"] = mul[(div[env0["far"], env0["near"]]), (div[env0["far"], env0["near"]])];
    env0["circle"] = mul[mul[elem[elem[env0["pulls"], sub[len[env0["pulls"]], 1.]], 1.], env0["both"]], env0["far"]];
    env0["between"] = If[truthy[gt[env0["ratio"], 1.000001]], (If[truthy[gt[env0["w"], 0.]], mSqrt[(div[mul[2., env0["w"]], (sub[env0["ratio"], 1.])])], 0.]), (If[truthy[gt[env0["circle"], 0.]], mSqrt[env0["circle"]], 0.])];
    env0["run"] = Setup["thrown", env0["pulls"], env0["far"], env0["near"], env0["both"], env0["kappa"], env0["between"]];
    env0["speed"] = div[mul[env0["run"], elem[env0["rest"], 0.]], (add[env0["h"]["mass"], elem[env0["rest"], 0.]])];
    env0["tx"] = sub[0., div[env0["dy"], (mul[env0["far"], env0["K"]])]];
    env0["ty"] = div[env0["dx"], (mul[env0["far"], env0["K"]])];
    env0["way"] = If[truthy[lt[add[mul[env0["tx"], env0["px"]], mul[env0["ty"], env0["py"]]], 0.]], sub[0., 1.], 1.];
    Throw[list[mul[mul[mul[env0["way"], env0["tx"]], env0["speed"]], env0["h"]["mass"]], mul[mul[mul[env0["way"], env0["ty"]], env0["speed"]], env0["h"]["mass"]]], ret]]]]];

DefineClass[Body, "Body", Node, Function[{klass},
