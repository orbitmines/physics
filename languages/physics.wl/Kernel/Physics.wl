          env1["points"] = filt[env1["ts"], lfn[4, { env3["t"] = arg[args4, 0] };
            Throw[andV[andV[andV[not[get[env3["t"], "settles"]], not[get[env3["t"], "transport"]]], (!eq[get[env3["t"], "degree"], 2.])], not[get[env3["t"], "outside"]]], ret]]];
          If[truthy[not[mEmpty[env1["meetings"]]]],
