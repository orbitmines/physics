        env2["sp"] = If[truthy[gt[env2["o2"], 0.]], div[mul[env2["sr"], mSqrt[env2["k2"]]], (mul[2., mSqrt[env2["o2"]]])], 0.];
        env2["vc2"] = mul[mul[env2["o2"], env2["r"]], env2["r"]];
        env2["vphi"] = mSqrt[Fmt["max", add[env2["vc2"], mul[mul[env2["sr"], env2["sr"]], (sub[sub[1., (If[truthy[gt[env2["o2"], 0.]], div[env2["k2"], (mul[4., env2["o2"]])], 1.])], div[mul[2., env2["r"]], env1["rd"]]])]], 0.]];
        env2["mag"] = mSqrt[(mul[neg[2.], mLn[Fmt["max", env0["rng"]["next"], 0.000001]]])];
        env2["th"] = mul[6.283185307179586, env0["rng"]["next"]];
        env2["vr"] = mul[mul[env2["sr"], env2["mag"]], mCos[env2["th"]]];
        env2["vt"] = add[env2["vphi"], mul[mul[env2["sp"], env2["mag"]], mSin[env2["th"]]]];
        env2["ux"] = If[truthy[gt[env2["r"], 0.]], div[env2["x"], env2["r"]], 1.];
        env2["uy"] = If[truthy[gt[env2["r"], 0.]], div[env2["y"], env2["r"]], 0.];
        setAt[env0["out"], add[mul[4., env2["i"]], 2.], sub[mul[env2["vr"], env2["ux"]], mul[env2["vt"], env2["uy"]]]];
        setAt[env0["out"], add[mul[4., env2["i"]], 3.], add[mul[env2["vr"], env2["uy"]], mul[env2["vt"], env2["ux"]]]]], {iter2, 0., num[Formed["N"]] - 1.}];
      Do[loopScope[2, env2["slot"] = iter2;
        env2["mean"] = 0.;
        Do[loopScope[3, env3["k"] = iter3;
          env2["mean"] = add[env2["mean"], elem[env0["out"], add[mul[4., (add[mul[env1["g"], Formed["N"]], env3["k"]])], env2["slot"]]]]], {iter3, 0., num[Formed["N"]] - 1.}];
        env2["mean"] = div[env2["mean"], Formed["N"]];
        Do[loopScope[3, env3["k"] = iter3;
          setAt[env0["out"], add[mul[4., (add[mul[env1["g"], Formed["N"]], env3["k"]])], env2["slot"]], sub[elem[env0["out"], add[mul[4., (add[mul[env1["g"], Formed["N"]], env3["k"]])], env2["slot"]]], env2["mean"]]]], {iter3, 0., num[Formed["N"]] - 1.}]], {iter2, 0., num[4.] - 1.}]], {iter1, 0., num[self["discs_n"]] - 1.}];
    Throw[env0["out"], ret]]];
  field[klass, "middles", dfn[list[]]];
  method[klass, "binned", mfn[1, { env0["state"] = arg[args1, 0] };
    env0["G"] = Formed["GRID"];
    env0["out"] = filled[mul[mul[self["discs_n"], env0["G"]], env0["G"]], 0.];
    env0["here"] = list[];
    Do[loopScope[1, env1["g"] = iter1;
      env1["half"] = mul[Formed["SPAN"], self["scale", env1["g"]]];
      env1["mid"] = list[0., 0., 0., 0.];
      Do[loopScope[2, env2["k"] = iter2;
        Do[loopScope[3, env3["slot"] = iter3;
          setAt[env1["mid"], env3["slot"], add[elem[env1["mid"], env3["slot"]], div[elem[env0["state"], add[mul[4., (add[mul[env1["g"], Formed["N"]], env2["k"]])], env3["slot"]]], Formed["N"]]]]], {iter3, 0., num[4.] - 1.}]], {iter2, 0., num[Formed["N"]] - 1.}];
      mPush[env0["here"], env1["mid"]];
      Do[loopScope[2, env2["k"] = iter2;
        env2["i"] = add[mul[env1["g"], Formed["N"]], env2["k"]];
        env2["cx"] = mFloor[(mul[div[(add[sub[elem[env0["state"], mul[4., env2["i"]]], elem[env1["mid"], 0.]], env1["half"]]), (mul[2., env1["half"]])], env0["G"]])];
        env2["cy"] = mFloor[(mul[div[(add[sub[elem[env0["state"], add[mul[4., env2["i"]], 1.]], elem[env1["mid"], 1.]], env1["half"]]), (mul[2., env1["half"]])], env0["G"]])];
        If[truthy[andV[andV[andV[ge[env2["cx"], 0.], ge[env2["cy"], 0.]], lt[env2["cx"], env0["G"]]], lt[env2["cy"], env0["G"]]]],
          env2["at"] = add[add[mul[mul[env1["g"], env0["G"]], env0["G"]], mul[env2["cy"], env0["G"]]], env2["cx"]];
          setAt[env0["out"], env2["at"], add[elem[env0["out"], env2["at"]], 1.]]]], {iter2, 0., num[Formed["N"]] - 1.}]], {iter1, 0., num[self["discs_n"]] - 1.}];
    mPush[self["middles"], env0["here"]];
    Throw[env0["out"], ret]]];
  method[klass, "save", mfn[1, { env0["frames"] = arg[args1, 0] };
    env0["G"] = Formed["GRID"];
    env0["density"] = list[];
    Do[loopScope[1, env1["g"] = iter1;
      Do[loopScope[2, env2["f"] = iter2;
        Do[loopScope[3, env3["c"] = iter3;
          mPush[env0["density"], elem[env2["f"], add[mul[mul[env1["g"], env0["G"]], env0["G"]], env3["c"]]]]], {iter3, 0., num[mul[env0["G"], env0["G"]]] - 1.}]], {iter2, items[env0["frames"]]}]], {iter1, 0., num[self["discs_n"]] - 1.}];
    env0["cols"] = Node[{}];
    env0["cols"][str["density"] -> env0["density"]];
    env0["extra"] = Node[{}];
    env0["extra"][str["names"] -> Formed["WHAT"]];
    env0["extra"][str["mass"] -> mMap[Formed["DISCS"], lfn[3, { env2["d"] = arg[args3, 0] };
      Throw[power[10., elem[env2["d"], 0.]], ret]]]];
    env0["extra"][str["scale"] -> mMap[Formed["DISCS"], lfn[3, { env2["d"] = arg[args3, 0] };
      Throw[elem[env2["d"], 1.], ret]]]];
    env0["extra"][str["span"] -> mMap[Formed["DISCS"], lfn[3, { env2["d"] = arg[args3, 0] };
      Throw[mul[Formed["SPAN"], elem[env2["d"], 1.]], ret]]]];
    env0["extra"][str["stars"] -> Formed["N"]];
    env0["extra"][str["Q"] -> Formed["Q"]];
    env0["extra"][str["frames"] -> len[env0["frames"]]];
    env0["extra"][str["grid"] -> env0["G"]];
    env0["extra"][str["gyr"] -> div[mul[mul[Formed["STEPS"], Formed["DT"]], Simulation["MYR"]], 1000.]];
    env0["extra"][str["middles"] -> self["middles"]];
    env0["extra"][str["deg"] -> self["deg"]];
    env0["extra"][str["a0"] -> mul[self["a0"], Simulation["UNIT_G"]]];
    env0["extra"][str["about"] -> "discs of stars that pull each other through the law, from smooth to whatever forms: star counts on grid x grid cells, span kpc either side of the middle, frame after frame, galaxy after galaxy"];
    Throw[Measure["save", "galaxy.formed", list["density"], env0["cols"], env0["extra"]], ret]]];
  statik[klass, "kernel", mfn[1,
    Throw[mJoin[list["// GENERATED from Formed.ray: stars that pull each other through the law", "@group(0) @binding(0) var<storage, read> P: array<u32>;", "@group(0) @binding(1) var<storage, read> L: array<f32>;", "@group(0) @binding(2) var<storage, read> C: array<f32>;", "@group(0) @binding(3) var<storage, read_write> X: array<f32>;", "@group(0) @binding(4) var<storage, read_write> A: array<f32>;", "var<workgroup> tile: array<vec2<f32>, " <> str[Formed["TILE"]] <> ">;", Simulation["law_wgsl"], "@compute @workgroup_size(" <> str[Formed["TILE"]] <> ") fn ACCEL(@builtin(global_invocation_id) gid: vec3<u32>, @builtin(local_invocation_id) lid: vec3<u32>) {", "  let i: u32 = P[7] + gid.x;", "  let per: u32 = P[1];", "  let g: u32 = i / per;", "  let base: u32 = g * per;", "  let me: vec2<f32> = vec2<f32>(X[4u * i], X[4u * i + 1u]);", "  let e2: f32 = C[4u * g + 1u] * C[4u * g + 1u];", "  var s: vec2<f32> = vec2<f32>(0.0, 0.0);", "  for (var t: u32 = 0u; t < per; t = t + " <> str[Formed["TILE"]] <> "u) {", "    let j: u32 = base + t + lid.x;", "    tile[lid.x] = vec2<f32>(X[4u * j], X[4u * j + 1u]);", "    workgroupBarrier();", "    for (var k: u32 = 0u; k < " <> str[Formed["TILE"]] <> "u; k = k + 1u) {", "      let d: vec2<f32> = tile[k] - me;", "      let inv: f32 = inverseSqrt(dot(d, d) + e2);", "      s = s + d * (inv * inv * inv);", "    }", "    workgroupBarrier();", "  }", "  let gN: vec2<f32> = C[4u * g] * s;", "  let mag: f32 = length(gN);", "  var a: vec2<f32> = vec2<f32>(0.0, 0.0);", "  var f: f32 = 0.0;", "  if (mag > 0.0) {", "    f = mag;", "    if (C[4u * g + 2u] > 0.0) { f = felt(mag, C[4u * g + 2u]); }", "    a = gN / mag * f;", "  }", "  A[4u * i] = a.x;", "  A[4u * i + 1u] = a.y;", "  A[4u * i + 2u] = mag;", "  A[4u * i + 3u] = f;", "}", "" <> str[Simulation["ENTRY"]] <> " KICKDRIFT" <> str[Simulation["ID"]] <> "", Simulation["THREAD"], "  if (i >= P[0]) { return; }", "  let dt: f32 = C[4u * (i / P[1]) + 3u];", "  X[4u * i + 2u] = X[4u * i + 2u] + 0.5 * A[4u * i] * dt;", "  X[4u * i + 3u] = X[4u * i + 3u] + 0.5 * A[4u * i + 1u] * dt;", "  X[4u * i] = X[4u * i] + X[4u * i + 2u] * dt;", "  X[4u * i + 1u] = X[4u * i + 1u] + X[4u * i + 3u] * dt;", "}", "" <> str[Simulation["ENTRY"]] <> " KICK" <> str[Simulation["ID"]] <> "", Simulation["THREAD"], "  if (i >= P[0]) { return; }", "  let dt: f32 = C[4u * (i / P[1]) + 3u];", "  X[4u * i + 2u] = X[4u * i + 2u] + 0.5 * A[4u * i] * dt;", "  X[4u * i + 3u] = X[4u * i + 3u] + 0.5 * A[4u * i + 1u] * dt;", "}"], "\n"], ret]]]]];

DefineClass[Model, "Model", Node, Function[{klass},
  field[klass, "theory"];
  staticField[klass, "NAMES", dfn[list["\\langle\\rho\\rangle", "D", "DEG", "l.DEG", "\\nu", "\\sigma", "F", "\\bar{c}", "m'", "A'", "\\bar{R}'", "m_{\\Sigma}", "m_{\\Sigma}'", "\\mathcal{D}", "\\mathcal{D}'", "\\beta'", "\\beta\\cdot\\hat{d}", "\\beta'\\cdot\\hat{d}", "\\rho", "\\omega", "R", "r", "\\bar{r}", "\\bar{m}_{x}", "A", "\\bar{R}", "\\beta", "n_{f}", "\\sigma_{tr}", "L", "m", "\\delta", "g_{N}", "a_{0}", "\\Phi"]]];
  staticField[klass, "RD", dfn[30.]];
  field[klass, "store", dfn[Prover[{ "theory" -> self["theory"] }]["closure"]]];
  field[klass, "cache", dfn[Node[{}]]];
  method[klass, "fact", mfn[1, { env0["of_"] = arg[args1, 0] };
    env0["found"] = Null;
    Do[loopScope[1, env1["f"] = iter1;
      If[truthy[andV[eq[env0["found"], Null], eq[env1["f"]["of"], env0["of_"]]]],
        env0["found"] = env1["f"]]], {iter1, items[self["store"]["all", "is"]]}];
    Throw[env0["found"], ret]]];
  statik[klass, "copy", mfn[1, { env0["env"] = arg[args1, 0] };
    env0["out"] = Node[{}];
    Do[loopScope[1, env1["k"] = iter1;
      If[truthy[(!eq[elem[env0["env"], env1["k"]], Null])],
        setAt[env0["out"], env1["k"], elem[env0["env"], env1["k"]]]]], {iter1, items[Model["NAMES"]]}];
    Throw[env0["out"], ret]]];
  statik[klass, "lattice", mfn[1, { env0["e"] = arg[args1, 0] };
    env0["k"] = env0["e"]["kind"];
    If[truthy[orV[eq[env0["k"], "add"], eq[env0["k"], "mul"]]],
      env0["out"] = Expr[{ "kind" -> env0["k"] }];
      env0["out"]["of" -> mMap[env0["e"]["of"], lfn[3, { env2["x"] = arg[args3, 0] };
        Throw[Model["lattice", env2["x"]], ret]]]];
      Throw[env0["out"], ret]];
    If[truthy[eq[env0["k"], "pow"]],
      Throw[Expr["to_power", Model["lattice", env0["e"]["base"]], Model["lattice", env0["e"]["power"]]], ret]];
    If[truthy[orV[orV[orV[orV[eq[env0["k"], "grad"], eq[env0["k"], "log"]], eq[env0["k"], "exp"]], eq[env0["k"], "root"]], eq[env0["k"], "limit"]]],
      env0["out"] = Expr[{ "kind" -> env0["k"] }];
      env0["out"]["base" -> Model["lattice", env0["e"]["base"]]];
      env0["out"]["bound" -> env0["e"]["bound"]];
      Throw[env0["out"], ret]];
    If[truthy[eq[env0["k"], "choose"]],
      Throw[Expr["choose", Model["lattice", env0["e"]["first_"]], Model["lattice", env0["e"]["second_"]]], ret]];
    If[truthy[eq[env0["k"], "gammaInc"]],
      Throw[Expr["gamma_inc", Model["lattice", env0["e"]["first_"]], Model["lattice", env0["e"]["second_"]]], ret]];
    If[truthy[eq[env0["k"], "call"]],
      env0["inner"] = Model["lattice", env0["e"]["base"]];
      Throw[If[truthy[eq[env0["e"]["label"], "l.choose"]], env0["inner"], Expr["call", env0["e"]["label"], env0["inner"]]], ret]];
    Throw[env0["e"], ret]]];
  statik[klass, "unbound", mfn[1, { env0["e"] = arg[args1, 0] };
    env0["out"] = list[];
    Model["walk_names", env0["e"], env0["out"]];
    Throw[env0["out"], ret]]];
  statik[klass, "walk_names", mfn[1, { env0["e"] = arg[args1, 0], env0["out"] = arg[args1, 1] };
    env0["k"] = env0["e"]["kind"];
    If[truthy[orV[eq[env0["k"], "sym"], eq[env0["k"], "field"]]],
      If[truthy[not[mContains[env0["out"], env0["e"]["label"]]]],
        mPush[env0["out"], env0["e"]["label"]]],
      If[truthy[orV[eq[env0["k"], "add"], eq[env0["k"], "mul"]]],
        Do[loopScope[1, env1["x"] = iter1;
          Model["walk_names", env1["x"], env0["out"]]], {iter1, items[env0["e"]["of"]]}],
        If[truthy[eq[env0["k"], "pow"]],
          Model["walk_names", env0["e"]["base"], env0["out"]];
          Throw[Model["walk_names", env0["e"]["power"], env0["out"]], ret],
          If[truthy[orV[orV[orV[orV[eq[env0["k"], "grad"], eq[env0["k"], "log"]], eq[env0["k"], "exp"]], eq[env0["k"], "root"]], eq[env0["k"], "limit"]]],
            Throw[Model["walk_names", env0["e"]["base"], env0["out"]], ret],
            If[truthy[orV[eq[env0["k"], "choose"], eq[env0["k"], "gammaInc"]]],
              Model["walk_names", env0["e"]["first_"], env0["out"]];
              Throw[Model["walk_names", env0["e"]["second_"], env0["out"]], ret],
              If[truthy[eq[env0["k"], "call"]],
                env0["called"] = "" <> str[env0["e"]["label"]] <> "\\paren{...}";
                If[truthy[not[mContains[env0["out"], env0["called"]]]],
                  mPush[env0["out"], env0["called"]]];
                Throw[Model["walk_names", env0["e"]["base"], env0["out"]], ret]]]]]]]]];
  method[klass, "resolved", mfn[1, { env0["e"] = arg[args1, 0], env0["env"] = arg[args1, 1], env0["seen"] = arg[args1, 2] };
    If[truthy[gt[len[env0["seen"]], 8.]],
      Throw[env0["e"], ret]];
    env0["missing"] = filt[Model["unbound", env0["e"]], lfn[3, { env2["n"] = arg[args3, 0] };
      Throw[andV[andV[eq[elem[env0["env"], env2["n"]], Null], not[mContains[env0["seen"], env2["n"]]]], not[mEndsWith[env2["n"], "\\paren{...}"]]], ret]]];
    env0["out"] = env0["e"];
    env0["grew"] = False;
    Do[loopScope[1, env1["n"] = iter1;
      env1["f"] = self["fact", env1["n"]];
      If[truthy[(!eq[env1["f"], Null])],
        env0["out"] = Expr["replace", env0["out"], env1["n"], self["resolved", env1["f"]["to"], env0["env"], mConcat[env0["seen"], list[env1["n"]]]]];
        env0["grew"] = True]], {iter1, items[env0["missing"]]}];
    Throw[If[truthy[env0["grew"]], env0["out"], env0["e"]], ret]]];
  field[klass, "ready", dfn[Node[{}]]];
  method[klass, "prepared", mfn[1, { env0["e"] = arg[args1, 0], env0["env"] = arg[args1, 1] };
    env0["bound"] = mJoin[filt[Model["NAMES"], lfn[3, { env2["k"] = arg[args3, 0] };
      Throw[(!eq[elem[env0["env"], env2["k"]], Null]), ret]]], ","];
    env0["shown"] = Expr["show", env0["e"]];
    env0["key"] = "" <> str[env0["shown"]] <> "|" <> str[env0["bound"]] <> "";
    env0["hit"] = elem[self["ready"], env0["key"]];
    If[truthy[(!eq[env0["hit"], Null])],
      Throw[env0["hit"], ret]];
    env0["out"] = Model["lattice", self["resolved", env0["e"], env0["env"], list[]]];
    setAt[self["ready"], env0["key"], env0["out"]];
    Throw[env0["out"], ret]]];
  method[klass, "at", mfn[1, { env0["e"] = arg[args1, 0], env0["env"] = arg[args1, 1] };
    Throw[Expr["numeric", self["prepared", env0["e"], env0["env"]], env0["env"]], ret]]];
  method[klass, "value_of", mfn[1, { env0["name"] = arg[args1, 0], env0["env"] = arg[args1, 1] };
    env0["f"] = self["fact", env0["name"]];
    Throw[If[truthy[eq[env0["f"], Null]], Indeterminate, self["at", env0["f"]["to"], env0["env"]]], ret]]];
  method[klass, "settled", mfn[1, { env0["DEG"] = arg[args1, 0] };
    If[truthy[eq[env0["DEG"], Null]],
      env0["DEG"] = Null];
    env0["deg"] = orElse[env0["DEG"], self["theory"]["lattice"]["DEG"]];
    env0["base"] = Node[{}];
    env0["base"][str["D"] -> self["theory"]["lattice"]["D"]];
    env0["base"][str["DEG"] -> env0["deg"]];
    env0["base"][str["l.DEG"] -> env0["deg"]];
    env0["base"][str["\\nu"] -> 1.];
    env0["base"][str["\\sigma"] -> 1.];
    env0["base"][str["F"] -> 0.5];
    env0["base"][str["\\bar{c}"] -> 1.];
    env0["base"][str["m'"] -> 1.];
    env0["base"][str["A'"] -> 1.];
    env0["base"][str["\\bar{R}'"] -> 1.];
    env0["base"][str["m_{\\Sigma}"] -> 1.];
    env0["base"][str["m_{\\Sigma}'"] -> 1.];
    env0["base"][str["\\mathcal{D}"] -> 1.];
    env0["base"][str["\\mathcal{D}'"] -> 1.];
    env0["base"][str["\\beta'"] -> 0.];
    env0["base"][str["\\beta\\cdot\\hat{d}"] -> 0.];
    env0["base"][str["\\beta'\\cdot\\hat{d}"] -> 0.];
    env0["rho"] = self["fact", "\\rho_{\\infty}"];
    If[truthy[(!eq[env0["rho"], Null])],
      env0["base"][str["\\rho"] -> self["at", env0["rho"]["to"], env0["base"]]]];
    env0["om"] = self["fact", "\\omega"];
    If[truthy[(!eq[env0["om"], Null])],
      env0["base"][str["\\omega"] -> self["at", env0["om"]["to"], env0["base"]]]];
    env0["far"] = Model["copy", env0["base"]];
    env0["far"][str["R"] -> power[10., 12.]];
    env0["far"][str["r"] -> power[10., 12.]];
    env0["far"][str["\\bar{r}"] -> power[10., 12.]];
    env0["far"][str["\\bar{m}_{x}"] -> 1.];
    env0["far"][str["A"] -> 1.];
    env0["far"][str["\\bar{R}"] -> 0.];
    env0["far"][str["\\beta"] -> 0.];
    Do[loopScope[1, env1["n"] = iter1;
      env1["f"] = self["fact", env1["n"]];
      If[truthy[(!eq[env1["f"], Null])],
        setAt[env0["far"], env1["n"], self["at", env1["f"]["to"], env0["far"]]]]], {iter1, items[list["n_{f}", "\\sigma_{tr}", "L"]]}];
    Throw[env0["far"], ret]]];
  getter[klass, "a0_lattice", mfn[1,
    If[truthy[(!eq[self["cache"][str["a0"]], Null])],
      Throw[self["cache"][str["a0"]], ret]];
    env0["a0"] = self["fact", "a_{0}"];
    self["cache"][str["a0"] -> If[truthy[eq[env0["a0"], Null]], Indeterminate, self["at", env0["a0"]["to"], self["settled", self["theory"]["lattice"]["DEG"]]]]];
    Throw[self["cache"][str["a0"]], ret]]];
  method[klass, "boost", mfn[1, { env0["gN"] = arg[args1, 0], env0["a0"] = arg[args1, 1] };
    env0["F"] = self["fact", "F_{g}"];
    If[truthy[eq[env0["F"], Null]],
      Throw[Indeterminate, ret]];
    env0["env"] = Node[{}];
    env0["env"][str["D"] -> self["theory"]["lattice"]["D"]];
    env0["env"][str["DEG"] -> self["theory"]["lattice"]["DEG"]];
    env0["env"][str["g_{N}"] -> env0["gN"]];
    env0["env"][str["a_{0}"] -> env0["a0"]];
    env0["got"] = self["at", env0["F"]["to"], env0["env"]];
    If[truthy[andV[andV[andV[not[Fmt["finite", env0["got"]]], Fmt["finite", env0["gN"]]], gt[env0["gN"], 0.]], Fmt["finite", env0["a0"]]]],
      env0["left"] = Model["unbound", Expr["simplify", Expr["evaluate", env0["F"]["to"], env0["env"]]]];
      env0["leans"] = If[truthy[mEmpty[env0["left"]]], "something", mJoin[env0["left"], ", "]];
      fail["the law came to " <> str[env0["got"]] <> " at g_N = " <> str[env0["gN"]] <> ": " <> str[env0["F"]["of"]] <> " leans on " <> str[env0["leans"]] <> " and this seam binds none of it. Its derived form has changed - bind the new name here or fix the rule."]];
    Throw[env0["got"], ret]]];
  method[klass, "delivered_by", mfn[1, { env0["sep"] = arg[args1, 0], env0["m"] = arg[args1, 1], env0["A"] = arg[args1, 2] };
    env0["key"] = "" <> str[Fmt["exponential", env0["sep"], 2.]] <> "|" <> str[env0["m"]] <> "|" <> str[env0["A"]] <> "";
    env0["hit"] = elem[self["cache"], env0["key"]];
    If[truthy[(!eq[env0["hit"], Null])],
      Throw[env0["hit"], ret]];
    env0["e"] = Node[{}];
    env0["e"][str["D"] -> self["theory"]["lattice"]["D"]];
    env0["e"][str["DEG"] -> self["theory"]["lattice"]["DEG"]];
    env0["e"][str["\\bar{c}"] -> 1.];
    env0["e"][str["\\bar{m}_{x}"] -> 1.];
    env0["e"][str["\\beta"] -> 0.];
    env0["e"][str["m'"] -> 1.];
    env0["e"][str["A'"] -> 1.];
    env0["e"][str["m_{\\Sigma}"] -> 1.];
    env0["e"][str["m_{\\Sigma}'"] -> 1.];
    env0["e"][str["\\beta'"] -> 0.];
    env0["e"][str["\\beta\\cdot\\hat{d}"] -> 0.];
    env0["e"][str["\\beta'\\cdot\\hat{d}"] -> 0.];
    env0["e"][str["R"] -> env0["sep"]];
    env0["e"][str["r"] -> env0["sep"]];
    env0["e"][str["\\bar{r}"] -> env0["sep"]];
    env0["e"][str["A"] -> env0["A"]];
    env0["e"][str["m"] -> env0["m"]];
    env0["e"][str["\\bar{R}"] -> div[env0["m"], env0["A"]]];
    Do[loopScope[1, env1["rate"] = iter1;
      env1["g"] = self["fact", env1["rate"]];
      If[truthy[(!eq[env1["g"], Null])],
        setAt[env0["e"], env1["rate"], self["at", env1["g"]["to"], env0["e"]]]]], {iter1, items[list["\\nu", "\\sigma", "F"]]}];
    env0["rho"] = self["fact", "\\rho_{\\infty}"];
    If[truthy[(!eq[env0["rho"], Null])],
      env0["e"][str["\\rho"] -> self["at", env0["rho"]["to"], env0["e"]]]];
    env0["step"] = lfn[2, { env1["name"] = arg[args2, 0], env1["into"] = arg[args2, 1] };
      env1["g"] = self["fact", env1["name"]];
      If[truthy[(!eq[env1["g"], Null])],
        setAt[env0["e"], env1["into"], self["at", env1["g"]["to"], env0["e"]]]]];
    env0["step"]["n_{f}", "n_{f}"];
    env0["step"]["\\sigma_{tr}", "\\sigma_{tr}"];
    env0["step"]["L", "L"];
    env0["step"]["what a body puts into the medium", "\\delta"];
    env0["step"]["\\rho at R", "\\rho"];
    env0["step"]["n_{f}", "n_{f}"];
    env0["step"]["\\sigma_{tr}", "\\sigma_{tr}"];
    env0["step"]["L", "L"];
    env0["step"]["g_{N}", "g_{N}"];
    env0["step"]["a_{0}", "a_{0}"];
    env0["out"] = list[env0["e"][str["g_{N}"]], env0["e"][str["a_{0}"]]];
    setAt[self["cache"], env0["key"], env0["out"]];
    Throw[env0["out"], ret]]];
  statik[klass, "surface", mfn[1, { env0["r"] = arg[args1, 0], env0["M"] = arg[args1, 1], env0["rd"] = arg[args1, 2] };
    Throw[div[mul[env0["M"], mExp[(sub[0., div[env0["r"], env0["rd"]]])]], (mul[mul[mul[2., 3.141592653589793], env0["rd"]], env0["rd"]])], ret]]];
  method[klass, "as_point_parts", mfn[1, { env0["R"] = arg[args1, 0], env0["M"] = arg[args1, 1], env0["rd"] = arg[args1, 2] };
    env0["one_"] = self["delivered_by", env0["R"], env0["M"], mul[mul[3.141592653589793, env0["rd"]], env0["rd"]]];
    Throw[list[elem[env0["one_"], 0.], self["boost", elem[env0["one_"], 0.], elem[env0["one_"], 1.]]], ret]]];
  method[klass, "as_stars_parts", mfn[1, { env0["R"] = arg[args1, 0], env0["M"] = arg[args1, 1], env0["rd"] = arg[args1, 2] };
    env0["rings"] = 16.;
    env0["spokes"] = 24.;
    env0["rmax"] = mul[8., env0["rd"]];
    env0["gN"] = 0.;
    Do[loopScope[1, env1["i"] = iter1;
      env1["r"] = div[mul[env0["rmax"], (add[env1["i"], 0.5])], env0["rings"]];
      env1["dr"] = div[env0["rmax"], env0["rings"]];
      env1["dm"] = mul[mul[mul[mul[2., 3.141592653589793], env1["r"]], env1["dr"]], Model["surface", env1["r"], env0["M"], env0["rd"]]];
      If[truthy[gt[env1["dm"], 0.]],
        Do[loopScope[2, env2["k"] = iter2;
          env2["th"] = div[mul[mul[2., 3.141592653589793], (add[env2["k"], 0.5])], env0["spokes"]];
          env2["dx"] = sub[env0["R"], mul[env1["r"], mCos[env2["th"]]]];
          env2["dy"] = sub[0., mul[env1["r"], mSin[env2["th"]]]];
          env2["sep"] = Fmt["hypot", env2["dx"], env2["dy"]];
          If[truthy[ge[env2["sep"], 1.]],
            env2["one_"] = self["delivered_by", env2["sep"], 1., 1.];
            If[truthy[Fmt["finite", elem[env2["one_"], 0.]]],
              env0["gN"] = add[env0["gN"], mul[mul[(div[env1["dm"], env0["spokes"]]), elem[env2["one_"], 0.]], (div[env2["dx"], env2["sep"]])]]]]], {iter2, 0., num[env0["spokes"]] - 1.}]]], {iter1, 0., num[env0["rings"]] - 1.}];
    env0["a0"] = elem[self["delivered_by", env0["R"], env0["M"], mul[mul[3.141592653589793, env0["rd"]], env0["rd"]]], 1.];
    Throw[list[env0["gN"], self["boost", env0["gN"], env0["a0"]]], ret]]];
  statik[klass, "speed", mfn[1, { env0["g"] = arg[args1, 0], env0["R"] = arg[args1, 1] };
    Throw[If[truthy[gt[env0["g"], 0.]], mSqrt[(mul[env0["R"], env0["g"]])], Indeterminate], ret]]]]];

DefineClass[RayAxis, "Axis", Node, Function[{klass},
  field[klass, "lo"];
  field[klass, "hi"];
  field[klass, "n"];
  field[klass, "linear", dfn[False]];
  method[klass, "value", mfn[1, { env0["i"] = arg[args1, 0] };
    env0["t"] = If[truthy[gt[self["n"], 1.]], div[env0["i"], (sub[self["n"], 1.])], 0.5];
    env0["v"] = add[self["lo"], mul[(sub[self["hi"], self["lo"]]), env0["t"]]];
    Throw[If[truthy[self["linear"]], env0["v"], power[10., env0["v"]]], ret]]];
  getter[klass, "mid", mfn[1,
    env0["v"] = add[self["lo"], mul[(sub[self["hi"], self["lo"]]), 0.5]];
    Throw[If[truthy[self["linear"]], env0["v"], power[10., env0["v"]]], ret]]];
  getter[klass, "values", mfn[1,
    Throw[mMap[rng[self["n"]], lfn[3, { env2["i"] = arg[args3, 0] };
      Throw[self["value", env2["i"]], ret]]], ret]]]]];

DefineClass[Shaded, "Shaded", Node, Function[{klass},
  statik[klass, "literal", mfn[1, { env0["n"] = arg[args1, 0] };
    If[truthy[(!eq[env0["n"], env0["n"]])],
      Throw["1e30", ret]];
    If[truthy[gt[mAbs[env0["n"]], power[10., 300.]]],
      Throw[If[truthy[lt[env0["n"], 0.]], "(-1e30)", "1e30"], ret]];
    If[truthy[andV[eq[env0["n"], mFloor[env0["n"]]], lt[mAbs[env0["n"]], 1000000000.]]],
      Throw["(" <> str[env0["n"]] <> ".0)", ret]];
    Throw["(" <> str[env0["n"]] <> ")", ret]]];
  statik[klass, "wgsl", mfn[1, { env0["e"] = arg[args1, 0], env0["names"] = arg[args1, 1], env0["bound"] = arg[args1, 2] };
    env0["k"] = env0["e"]["kind"];
    If[truthy[eq[env0["k"], "num"]],
      Throw[Shaded["literal", env0["e"]["value"]], ret]];
    If[truthy[orV[eq[env0["k"], "sym"], eq[env0["k"], "field"]]],
      If[truthy[andV[(!eq[env0["bound"], Null]), eq[env0["e"]["label"], env0["bound"]]]],
        Throw["x", ret]];
      env0["i"] = mIndexOf[env0["names"], env0["e"]["label"]];
      If[truthy[eq[env0["i"], Null]],
        fail["the law stands on " <> str[env0["e"]["label"]] <> ", which the sweep does not bind"]];
      Throw["e[" <> str[env0["i"]] <> "]", ret]];
    If[truthy[eq[env0["k"], "add"]],
      env0["parts"] = mMap[env0["e"]["of"], lfn[3, { env2["x"] = arg[args3, 0] };
        Throw[Shaded["wgsl", env2["x"], env0["names"], env0["bound"]], ret]]];
      env0["summed"] = mJoin[env0["parts"], " + "];
      Throw["(" <> str[env0["summed"]] <> ")", ret]];
    If[truthy[eq[env0["k"], "mul"]],
      env0["parts"] = mMap[env0["e"]["of"], lfn[3, { env2["x"] = arg[args3, 0] };
        Throw[Shaded["wgsl", env2["x"], env0["names"], env0["bound"]], ret]]];
      env0["multiplied"] = mJoin[env0["parts"], " * "];
      Throw["(" <> str[env0["multiplied"]] <> ")", ret]];
    If[truthy[eq[env0["k"], "pow"]],
      env0["base"] = Shaded["wgsl", env0["e"]["base"], env0["names"], env0["bound"]];
      If[truthy[eq[env0["e"]["power"]["kind"], "num"]],
        env0["n"] = env0["e"]["power"]["value"];
        If[truthy[eq[env0["n"], 0.5]],
          Throw["sqrt(" <> str[env0["base"]] <> ")", ret]];
        If[truthy[andV[eq[env0["n"], mFloor[env0["n"]]], le[mAbs[env0["n"]], 64.]]],
          Throw["powi(" <> str[env0["base"]] <> ", " <> str[mRound[env0["n"]]] <> ")", ret]];
        Throw["pow(" <> str[env0["base"]] <> ", " <> str[Shaded["literal", env0["n"]]] <> ")", ret]];
      Throw["pow(" <> str[env0["base"]] <> ", " <> str[Shaded["wgsl", env0["e"]["power"], env0["names"], env0["bound"]]] <> ")", ret]];
    If[truthy[eq[env0["k"], "log"]],
      Throw["log(" <> str[Shaded["wgsl", env0["e"]["base"], env0["names"], env0["bound"]]] <> ")", ret]];
    If[truthy[eq[env0["k"], "exp"]],
      Throw["exp(" <> str[Shaded["wgsl", env0["e"]["base"], env0["names"], env0["bound"]]] <> ")", ret]];
    If[truthy[eq[env0["k"], "choose"]],
      Throw["choose(" <> str[Shaded["wgsl", env0["e"]["first_"], env0["names"], env0["bound"]]] <> ", " <> str[Shaded["wgsl", env0["e"]["second_"], env0["names"], env0["bound"]]] <> ")", ret]];
    Throw[fail["a " <> str[env0["k"]] <> " cannot be written as shader code - only a root at the top of a law is solved there"], ret]]];
  statik[klass, "helpers", mfn[1,
    Throw["fn powi(b: f32, n: i32) -> f32 {\n  var r: f32 = 1.0;\n  let m: i32 = abs(n);\n  for (var i: i32 = 0; i < m; i = i + 1) { r = r * b; }\n  if (n < 0) { return 1.0 / r; }\n  return r;\n}\nfn choose(n: f32, k: f32) -> f32 {\n  var r: f32 = 1.0;\n  var i: f32 = 0.0;\n  for (var c: i32 = 0; c < 64; c = c + 1) { if (i < k) { r = r * (n - i) / (i + 1.0); i = i + 1.0; } }\n  return r;\n}\nfn finite(v: f32) -> bool { return abs(v) < 1e30 && v == v; }", ret]]];
  statik[klass, "points", mfn[1,
    env0["points"] = list[];
    env0["i"] = 1.;
    While[truthy[le[env0["i"], 120.]],
      mPush[env0["points"], div[env0["i"], 120.]];
      env0["i"] = add[env0["i"], 1.]];
    env0["ex"] = 0.;
    While[truthy[le[env0["ex"], 24.]],
      env0["k"] = 1.;
      While[truthy[lt[env0["k"], 8.]],
        mPush[env0["points"], mul[(power[10., (sub[env0["ex"], 12.])]), (add[1., div[env0["k"], 2.]])]];
        env0["k"] = add[env0["k"], 1.]];
      env0["ex"] = add[env0["ex"], 1.]];
    Throw[Expr["sorted", env0["points"]], ret]]];
  statik[klass, "solver", mfn[1, { env0["name"] = arg[args1, 0], env0["f"] = arg[args1, 1] };
    env0["pts"] = Shaded["points"];
    env0["lits"] = mJoin[mMap[env0["pts"], lfn[3, { env2["v"] = arg[args3, 0] };
      Throw[Shaded["literal", env2["v"]], ret]]], ", "];
    Throw["const PTS_" <> str[env0["name"]] <> ": array<f32, " <> str[len[env0["pts"]]] <> "> = array<f32, " <> str[len[env0["pts"]]] <> ">(" <> str[env0["lits"]] <> ");\nfn " <> str[env0["name"]] <> "() -> f32 {\n  var lo: f32 = 0.0;\n  var hi: f32 = 0.0;\n  var found: bool = false;\n  var px: f32 = PTS_" <> str[env0["name"]] <> "[0];\n  var pf: f32 = " <> str[env0["f"]] <> "(px);\n  for (var j: i32 = 1; j < " <> str[len[env0["pts"]]] <> "; j = j + 1) {\n    let cx: f32 = PTS_" <> str[env0["name"]] <> "[j];\n    let cf: f32 = " <> str[env0["f"]] <> "(cx);\n    if (!found && finite(pf) && finite(cf) && pf * cf <= 0.0) { lo = px; hi = cx; found = true; }\n    px = cx;\n    pf = cf;\n  }\n  if (!found) { return 1e30; }\n  var flo: f32 = " <> str[env0["f"]] <> "(lo);\n  for (var n: i32 = 0; n < 60; n = n + 1) {\n    let mid: f32 = (lo + hi) / 2.0;\n    let fm: f32 = " <> str[env0["f"]] <> "(mid);\n    if (!finite(fm)) { break; }\n    if (flo * fm <= 0.0) { hi = mid; } else { lo = mid; flo = fm; }\n  }\n  return (lo + hi) / 2.0;\n}", ret]]]]];

DefineClass[Sweep, "Sweep", Node, Function[{klass},
  field[klass, "model"];
  field[klass, "how"];
  field[klass, "arrival", dfn[self["model"]["fact", "what arrives with the mass " <> str[self["how"]] <> ""]]];
  field[klass, "felt", dfn[self["model"]["fact", "F_{g}"]]];
  field[klass, "rho_at", dfn[self["model"]["fact", "\\rho at R"]]];
  field[klass, "scale", dfn[self["model"]["fact", "a_{0} along the path"]]];
  field[klass, "a0", dfn[self["model"]["a0_lattice"]]];
  field[klass, "base", dfn[Sweep["base_env", self["model"]]]];
  field[klass, "order", dfn[list["mass", "face", "moving", "radiating"]]];
  field[klass, "axes", dfn[Sweep["axes_of"]]];
  field[klass, "R0", dfn[neg[1.]]];
  field[klass, "R1", dfn[8.]];
  field[klass, "RS", dfn[170.]];
  field[klass, "XS", dfn[700.]];
  field[klass, "X0", dfn[neg[5.]]];
  field[klass, "X1", dfn[4.]];
  field[klass, "YS", dfn[520.]];
  field[klass, "Y0", dfn[neg[4.]]];
  field[klass, "Y1", dfn[4.]];
  field[klass, "rad", dfn[mMap[rng[self["RS"]], lfn[2, { env1["i"] = arg[args2, 0] };
    Throw[power[10., (add[self["R0"], div[mul[(sub[self["R1"], self["R0"]]), env1["i"]], (sub[self["RS"], 1.])]])], ret]]]]];
  field[klass, "env", dfn[mMap[self["rad"], lfn[2, { env1["R"] = arg[args2, 0] };
    env1["e"] = Model["copy", self["base"]];
    env1["e"][str["R"] -> env1["R"]];
    env1["e"][str["r"] -> env1["R"]];
    env1["e"][str["\\bar{r}"] -> env1["R"]];
    Do[loopScope[2, env2["n"] = iter2;
      env2["g"] = self["model"]["fact", env2["n"]];
      If[truthy[(!eq[env2["g"], Null])],
        setAt[env1["e"], env2["n"], self["model"]["at", env2["g"]["to"], env1["e"]]]]], {iter2, items[list["n_{f}", "\\sigma_{tr}", "L"]]}];
    Throw[env1["e"], ret]]]]];
  statik[klass, "base_env", mfn[1, { env0["model"] = arg[args1, 0] };
    env0["base"] = Node[{}];
    env0["base"][str["D"] -> env0["model"]["theory"]["lattice"]["D"]];
    env0["base"][str["DEG"] -> env0["model"]["theory"]["lattice"]["DEG"]];
    env0["base"][str["\\bar{c}"] -> 1.];
    env0["base"][str["m'"] -> 1.];
    env0["base"][str["A'"] -> 1.];
    env0["base"][str["\\bar{R}'"] -> 1.];
    env0["base"][str["m_{\\Sigma}"] -> 1.];
    env0["base"][str["m_{\\Sigma}'"] -> 1.];
    env0["base"][str["\\mathcal{D}"] -> 1.];
    env0["base"][str["\\mathcal{D}'"] -> 1.];
    env0["base"][str["\\beta'"] -> 0.];
    env0["base"][str["\\beta\\cdot\\hat{d}"] -> 0.];
    env0["base"][str["\\beta'\\cdot\\hat{d}"] -> 0.];
    Do[loopScope[1, env1["rate"] = iter1;
      env1["g"] = env0["model"]["fact", env1["rate"]];
      If[truthy[(!eq[env1["g"], Null])],
        setAt[env0["base"], env1["rate"], env0["model"]["at", env1["g"]["to"], env0["base"]]]]], {iter1, items[list["\\nu", "\\sigma", "F"]]}];
    env0["rho"] = env0["model"]["fact", "\\rho_{\\infty}"];
    If[truthy[(!eq[env0["rho"], Null])],
      env0["base"][str["\\rho"] -> env0["model"]["at", env0["rho"]["to"], env0["base"]]]];
    env0["om"] = env0["model"]["fact", "\\omega"];
    If[truthy[(!eq[env0["om"], Null])],
      env0["base"][str["\\omega"] -> env0["model"]["at", env0["om"]["to"], env0["base"]]]];
    env0["base"][str["\\bar{m}_{x}"] -> 1.];
    env0["base"][str["A"] -> 1.];
    env0["base"][str["\\bar{R}"] -> 0.];
    env0["base"][str["\\beta"] -> 0.];
    Throw[env0["base"], ret]]];
  statik[klass, "axes_of", mfn[1,
    env0["axes"] = Node[{}];
    env0["axes"][str["mass"] -> RayAxis[{ "lo" -> 2., "hi" -> 9., "n" -> 46. }]];
    env0["axes"][str["face"] -> RayAxis[{ "lo" -> 1., "hi" -> 6., "n" -> 28. }]];
    env0["moving"] = RayAxis[{ "lo" -> 0., "hi" -> 0.9, "n" -> 5. }];
    env0["moving"]["linear" -> True];
    env0["axes"][str["moving"] -> env0["moving"]];
    env0["axes"][str["radiating"] -> RayAxis[{ "lo" -> neg[2.], "hi" -> 2., "n" -> 5. }]];
    Throw[env0["axes"], ret]]];
  getter[klass, "dx", mfn[1,
    Throw[div[(sub[self["X1"], self["X0"]]), (sub[self["XS"], 1.])], ret]]];
  getter[klass, "dy", mfn[1,
    Throw[div[(sub[self["Y1"], self["Y0"]]), (sub[self["YS"], 1.])], ret]]];
  method[klass, "point", mfn[1, { env0["k"] = arg[args1, 0], env0["m"] = arg[args1, 1], env0["A"] = arg[args1, 2], env0["beta"] = arg[args1, 3], env0["S0"] = arg[args1, 4] };
    env0["e"] = Model["copy", elem[self["env"], env0["k"]]];
    env0["e"][str["m"] -> env0["m"]];
    env0["e"][str["A"] -> env0["A"]];
    env0["e"][str["\\bar{R}"] -> div[env0["m"], env0["A"]]];
    env0["e"][str["\\beta"] -> env0["beta"]];
    env0["e"][str["m_{\\Sigma}"] -> env0["S0"]];
    env0["e"][str["m_{\\Sigma}'"] -> env0["S0"]];
    Throw[env0["e"], ret]]];
  method[klass, "crossed", mfn[1, { env0["m"] = arg[args1, 0], env0["A"] = arg[args1, 1] };
    env0["out"] = filled[self["RS"], 0.];
    env0["total"] = 0.;
    env0["last"] = 0.;
    Do[loopScope[1, env1["k"] = iter1;
      env1["e"] = self["point", env1["k"], env0["m"], env0["A"], 0., 1.];
      env1["r"] = self["model"]["at", self["rho_at"]["to"], env1["e"]];
      env1["here"] = If[truthy[andV[andV[Fmt["finite", env1["r"]], gt[env1["r"], 0.]], le[env1["r"], 1.]]], env1["r"], self["base"][str["\\rho"]]];
      If[truthy[gt[env1["k"], 0.]],
        env0["total"] = add[env0["total"], mul[mul[0.5, (add[env1["here"], env0["last"]])], (sub[elem[self["rad"], env1["k"]], elem[self["rad"], sub[env1["k"], 1.]]])]]];
      env0["last"] = env1["here"];
      setAt[env0["out"], env1["k"], If[truthy[eq[env1["k"], 0.]], env1["here"], div[env0["total"], elem[self["rad"], env1["k"]]]]]], {iter1, 0., num[self["RS"]] - 1.}];
    Throw[env0["out"], ret]]];
  method[klass, "landing", mfn[1, { env0["k"] = arg[args1, 0], env0["m"] = arg[args1, 1], env0["A"] = arg[args1, 2], env0["beta"] = arg[args1, 3], env0["S0"] = arg[args1, 4], env0["avg_k"] = arg[args1, 5] };
    env0["e"] = self["point", env0["k"], env0["m"], env0["A"], env0["beta"], env0["S0"]];
    env0["gN"] = self["model"]["at", self["arrival"]["to"], env0["e"]];
    env0["e"][str["g_{N}"] -> env0["gN"]];
    env0["e"][str["\\langle\\rho\\rangle"] -> env0["avg_k"]];
    env0["e"][str["a_{0}"] -> self["model"]["at", self["scale"]["to"], env0["e"]]];
    env0["g"] = self["model"]["at", self["felt"]["to"], env0["e"]];
