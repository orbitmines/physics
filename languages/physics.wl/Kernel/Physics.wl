    If[truthy[gt[env0["cx"], sub[get[self, "coarse_side"], 1.]]],
      env0["cx"] = sub[get[self, "coarse_side"], 1.]];
    If[truthy[gt[env0["cy"], sub[get[self, "coarse_side"], 1.]]],
      env0["cy"] = sub[get[self, "coarse_side"], 1.]];
    Throw[add[mul[env0["cy"], get[self, "coarse_side"]], env0["cx"]], ret]]];
  statik[klass, "middle", mfn[1, { env0["holes"] = arg[args1, 0] };
