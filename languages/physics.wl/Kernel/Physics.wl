    env0["uy"] = sub[0., div[env0["dy"], (mul[env0["far"], env0["K"]])]];
    Throw[mMap[rng[add[env0["steps"], 1.]], lfn[3, { env2["i"] = arg[args3, 0] };
      env2["d"] = add[env0["near"], div[mul[(sub[env0["far"], env0["near"]]), env2["i"]], env0["steps"]]];
      Throw[list[env2["d"], add[elem[env0["rest"], 1.], mul[mul[env0["ux"], env2["d"]], env0["K"]]], add[elem[env0["rest"], 2.], mul[mul[env0["uy"], env2["d"]], env0["K"]]]], ret]]], ret]]];
  statik[klass, "pulls_between", mfn[1, { env0["w"] = arg[args1, 0], env0["h"] = arg[args1, 1], env0["rest"] = arg[args1, 2], env0["e"] = arg[args1, 3], env0["K"] = arg[args1, 4], env0["steps"] = arg[args1, 5] };
    env0["zown"] = call[env0["w"], "plane_of", { env0["h"] }];
