      env0["sw"] = call[K["Step"], "of", { call[K["Fact"], "stands", { "what swings a heading", get[env0["turning"], "drifts"] }], "the kernel", list[], "the line's direction term is the kernel's first moment - which way a turn leans on average", list[] }];
      env0["inner"] = call[K["Step"], "of", { call[K["Fact"], "stands", { "what swings a heading", get[env0["turning"], "drifts"] }], If[truthy[mEmpty[env0["via"]]], "the turn", env0["via"]], list[], "the same choice, read as a first moment rather than as a cosine: where the cosine says how much of a heading survives, this says which way what is left of it leans - and it leans toward where the folds are, since those are the ways the choice offers besides straight on", list["the choice is 1 way straight on against n_{f} folded", "<d^> = " <> str[call[K["Expr"], "show", { call[K["Expr"], "simplify", { get[env0["turning"], "drifts"] }] }]] <> ""] }];
