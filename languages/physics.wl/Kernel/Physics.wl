      env2["net"] = If[truthy[eq[env2["eps"], Null]], env2["net"], Expr["add", list[env2["net"], env2["eps"]["to"]]]];
      env2["rec"] = Expr["simplify", Expr["mul", list[env2["net"], Inferences["rbar"]]]];
      Throw[list[Inferences["step", "recession", env2["rec"], "space is made between them, and there is more of it the further apart they are", list[env2["line"]["key"]], "the space line says every neutral point makes space at the net of what the splitting makes and the meetings take. Between two bodies there are as many such points as there is distance, so the room between them grows at that rate times that distance - nothing is pushing them and they are carried apart anyway, faster the further apart they already are", list["\\partial_{t}s = " <> str[Expr["show", env2["net"]]] <> ", every term of the space line", "points between two bodies R apart: R of them", "recession = " <> str[Expr["show", env2["rec"]]] <> ""]]], ret]] }], ret]]];
  statik[klass, "shortfall", mfn[1,
    Throw[Inference[{ "name" -> "and a body makes less of it, so they are carried apart more slowly", "because" -> "every point between them is making less by however much of the body's shortfall has reached it, so the reduction is that shortfall summed along the line", "fire" -> lfn[3, { env2["s"] = arg[args3, 0] };
      env2["rec"] = env2["s"]["fact", "is", "recession"];
      env2["per"] = orElse[env2["s"]["fact", "is", "\\delta screened"], env2["s"]["fact", "is", "\\delta per site"]];
      env2["puts"] = env2["s"]["fact", "is", "what a body puts into the medium"];
      If[truthy[orV[orV[orV[eq[env2["rec"], Null], eq[env2["per"], Null]], eq[env2["puts"], Null]], env2["s"]["has", "is", "the deficit in recession"]]],
        Throw[list[], ret]];
      env2["profile"] = Expr["replace", env2["per"]["to"], "\\delta", env2["puts"]["to"]];
      env2["far"] = Expr["leading", env2["profile"], "r"];
      env2["F"] = orElse[Expr["integrate", env2["profile"], "r"], Expr["integrate", env2["far"], "r"]];
      If[truthy[eq[env2["F"], Null]],
        Throw[list[], ret]];
      env2["totalled"] = Expr["simplify", Expr["neg", Expr["replace", env2["F"], "r", Inferences["rbar"]]]];
      Throw[list[Inferences["step", "the deficit in recession", env2["totalled"], "and a body makes less of it, so they are carried apart more slowly", list[env2["rec"]["key"], env2["per"]["key"], env2["puts"]["key"]], "the room between two bodies grows at the making rate times how many points there are, and a body has reduced that rate at every one of them. Summed along the line - integrated by the algebra over whatever profile the transport gave, not over a power assumed in advance - that is the deficit in how fast they are carried apart, and it is what an attraction IS in a model whose gravity is an expansion that did not happen", list["recession = " <> str[Expr["show", env2["rec"]["to"]]] <> "", "the shortfall at each point is the body's own, carried: " <> str[Expr["show", env2["profile"]]] <> "", "far out that comes to " <> str[Expr["show", env2["far"]]] <> "", "\\int of that dr = " <> str[Expr["show", env2["F"]]] <> "", "the deficit in recession = " <> str[Expr["show", env2["totalled"]]] <> ""]]], ret]] }], ret]]];
  statik[klass, "waiting", mfn[1,
    Throw[Inference[{ "name" -> "how fast a carrier goes, which is the share of its step that was straight", "because" -> "`turns` draws one way straight on against the ways each direction was folded, so what carries a ray outward is the share of the draw that did not turn it", "fire" -> lfn[3, { env2["s"] = arg[args3, 0] };
      env2["nf"] = env2["s"]["fact", "is", "n_{f}"];
      env2["c"] = env2["s"]["fact", "is", "\\bar{c}"];
      If[truthy[orV[orV[eq[env2["nf"], Null], eq[env2["c"], Null]], env2["s"]["has", "is", "v"]]],
        Throw[list[], ret]];
      env2["gate"] = env2["s"]["fact", "is", "what share of a step advances"];
      env2["parts"] = list[env2["c"]["to"]];
      If[truthy[(!eq[env2["gate"], Null])],
        mPush[env2["parts"], env2["gate"]["to"]]];
      mPush[env2["parts"], Expr["pown", Expr["add", list[Expr["num", 1.], Expr["field", "n_{f}"]]], neg[1.]]];
      env2["got"] = Expr["simplify", Expr["mul", env2["parts"]]];
      Throw[list[Inferences["step", "v", env2["got"], "how fast a carrier goes, which is the share of its step that was straight", list[env2["nf"]["key"], env2["c"]["key"]], "MOVEMENT does not simply move a ray one cell: it draws where the ray goes, one way straight on against the ways each direction was folded. A place that has swallowed n_{f} folds sends it straight with 1/(1 + n_{f}) and turns it otherwise, so what advances it OUTWARD is that share. It is statistical and it is local, and it applies wherever the vacuum has met itself - which is everywhere, unlike the waiting, which happens only where there is no cell at all and so only at the frontier", list["turns: 1 way straight on against folds[d] ways out along d", "so a ray keeps its heading with 1/(1 + n_{f})", "v = \\bar{c}/(1 + n_{f}) = " <> str[Expr["show", env2["got"]]] <> "", "n_{f} small: v -> one cell a tick, and the carrier streams", "n_{f} large: v -> \\bar{c}/n_{f}, and it does not"]]], ret]] }], ret]]];
  statik[klass, "transporting", mfn[1,
    Throw[Inference[{ "name" -> "what crosses a shell is the room times what is at each site times how fast it goes", "because" -> "a flux is how much crosses per tick - the sites there are, times what is at each, times how fast it moves through - and conserved, that fixes the density", "fire" -> lfn[3, { env2["s"] = arg[args3, 0] };
      env2["shell"] = env2["s"]["fact", "grows", "shell"];
      env2["v"] = env2["s"]["fact", "is", "v"];
      env2["nf"] = env2["s"]["fact", "is", "n_{f}"];
      If[truthy[orV[orV[orV[eq[env2["shell"], Null], eq[env2["v"], Null]], eq[env2["nf"], Null]], env2["s"]["has", "is", "n"]]],
        Throw[list[], ret]];
      env2["got"] = Expr["simplify", Expr["mul", list[Expr["sym", "\\Phi"], Expr["pown", env2["shell"]["to"], neg[1.]], Expr["pown", env2["v"]["to"], neg[1.]]]]];
      Throw[list[Inferences["step", "n", env2["got"], "what crosses a shell is the room times what is at each site times how fast it goes", list[env2["shell"]["key"], env2["v"]["key"], env2["nf"]["key"]], "count what crosses a shell in a tick - the sites on it, what is at each, and the share of a step that went outward - and MOVEMENT neither makes nor destroys, so that count is carried. Solved for what is AT a site it is the flux over the room over the speed, and the speed is the share of the draw that did not turn. THE FOLD RECORD IS WHAT MAKES THIS MORE THAN A DILUTION: it grows with how far a ray has come, so 1 + n_{f} rises outward and the density falls more slowly than the room alone would have it. Close in that is nothing and this is an inverse square; far out it is not", list["\\Phi = shell·n·v", "v = " <> str[Expr["show", env2["v"]["to"]]] <> "", "n = \\Phi/(shell·v) = " <> str[Expr["show", env2["got"]]] <> "", "n_{f} = " <> str[Expr["show", env2["nf"]["to"]]] <> ", which grows with how far a ray has come"]]], ret]] }], ret]]]]];

DefineClass[Aggregate, "Aggregate", Node, Function[{klass},
  field[klass, "theory"];
  staticField[klass, "CACHE", dfn[Node[{}]]];
  staticField[klass, "ROUNDS", dfn[4.]];
  staticField[klass, "FOLDS_NAMES", dfn[list["\\rho", "n_{f}"]]];
  field[klass, "D", dfn[2.]];
  field[klass, "DEG", dfn[8.]];
  statik[klass, "of", mfn[1, { env0["theory"] = arg[args1, 0], env0["DEG"] = arg[args1, 1], env0["D"] = arg[args1, 2] };
    If[truthy[eq[env0["DEG"], Null]],
      env0["DEG"] = Null];
    If[truthy[eq[env0["D"], Null]],
      env0["D"] = Null];
    env0["deg"] = orElse[env0["DEG"], env0["theory"]["lattice"]["DEG"]];
    env0["dim"] = orElse[env0["D"], env0["theory"]["lattice"]["D"]];
    env0["key"] = "" <> str[env0["theory"]["name"]] <> "/" <> str[env0["dim"]] <> "/" <> str[env0["deg"]] <> "";
    If[truthy[eq[elem[Aggregate["CACHE"], env0["key"]], Null]],
      setAt[Aggregate["CACHE"], env0["key"], Aggregate[{ "theory" -> env0["theory"], "DEG" -> env0["deg"], "D" -> env0["dim"] }]]];
    Throw[elem[Aggregate["CACHE"], env0["key"]], ret]]];
  field[klass, "prover", dfn[Prover[{ "theory" -> self["theory"] }]]];
  field[klass, "store", dfn[self["prover"]["closure"]]];
  field[klass, "chain", dfn[self["prover"]["chain", self["store"]]]];
  field[klass, "NEAR", dfn[0.5]];
  getter[klass, "env", mfn[1,
    env0["e"] = Node[{}];
    Do[loopScope[1, env1["f"] = iter1;
      env1["v"] = Expr["simplify", env1["f"]["to"]];
      If[truthy[eq[env1["v"]["kind"], "num"]],
        setAt[env0["e"], env1["f"]["of"], env1["v"]["value"]]]], {iter1, items[self["store"]["all", "is"]]}];
    env0["e"][str["D"] -> self["D"]];
    env0["e"][str["DEG"] -> self["DEG"]];
    env0["e"][str["l.DEG"] -> self["DEG"]];
    env0["e"][str["\\bar{c}"] -> 1.];
    Throw[env0["e"], ret]]];
  statik[klass, "numeric_of", mfn[1, { env0["e"] = arg[args1, 0], env0["at"] = arg[args1, 1] };
    Throw[Expr["numeric", Expr["evaluate", env0["e"], env0["at"]], env0["at"]], ret]]];
  method[klass, "fact_at", mfn[1, { env0["name"] = arg[args1, 0], env0["at"] = arg[args1, 1] };
    env0["f"] = self["store"]["fact", "is", env0["name"]];
    If[truthy[eq[env0["f"], Null]],
      Throw[Indeterminate, ret]];
    Throw[Aggregate["numeric_of", env0["f"]["to"], env0["at"]], ret]]];
  method[klass, "step", mfn[1, { env0["role"] = arg[args1, 0] };
    Throw[self["chain"]["get", env0["role"]], ret]]];
  method[klass, "says", mfn[1, { env0["role"] = arg[args1, 0] };
    env0["st"] = self["step", env0["role"]];
    Throw[If[truthy[eq[env0["st"], Null]], "-", "" <> str[env0["st"]["fact"]["of"]] <> " = " <> str[Expr["show", env0["st"]["fact"]["to"]]] <> ""], ret]]];
  getter[klass, "rho_inf", mfn[1,
    Throw[self["fact_at", "\\rho_{\\infty}", self["env"]], ret]]];
  getter[klass, "settled_env", mfn[1,
    env0["e"] = self["env"];
    env0["e"][str["\\rho"] -> self["rho_inf"]];
    env0["e"][str["\\rho_{\\infty}"] -> self["rho_inf"]];
    Throw[env0["e"], ret]]];
  getter[klass, "nf_inf", mfn[1,
    env0["st"] = self["step", "settled"];
    If[truthy[eq[env0["st"], Null]],
      Throw[Indeterminate, ret]];
    Throw[Aggregate["numeric_of", env0["st"]["fact"]["to"], self["settled_env"]], ret]]];
  field[klass, "base", dfn[self["settled_env"]]];
  getter[klass, "fold_weight", mfn[1,
    Throw[Aggregate["numeric_of", self["prover"]["fold_weight"], self["env"]], ret]]];
  method[klass, "shell_at", mfn[1, { env0["R"] = arg[args1, 0] };
    env0["e"] = self["base"];
    env0["e"][str["\\bar{R}"] -> If[truthy[lt[env0["R"], self["NEAR"]]], self["NEAR"], env0["R"]]];
    env0["got"] = self["fact_at", "l.shell\\paren{\\bar{R}}", env0["e"]];
    env0["e"][str["\\bar{R}"] -> Null];
    Throw[env0["got"], ret]]];
  method[klass, "ball_at", mfn[1, { env0["R"] = arg[args1, 0] };
    env0["e"] = self["base"];
    env0["e"][str["\\bar{R}"] -> If[truthy[lt[env0["R"], self["NEAR"]]], self["NEAR"], env0["R"]]];
    env0["got"] = self["fact_at", "l.ball\\paren{\\bar{R}}.count", env0["e"]];
    env0["e"][str["\\bar{R}"] -> Null];
    Throw[env0["got"], ret]]];
  method[klass, "skin_at", mfn[1, { env0["face"] = arg[args1, 0] };
    env0["at_one"] = sub[1., self["reach_at", self["NEAR"]]];
    env0["got"] = sub[1., self["reach_at", If[truthy[lt[env0["face"], self["NEAR"]]], self["NEAR"], env0["face"]]]];
    Throw[If[truthy[gt[env0["at_one"], 0.]], div[env0["got"], env0["at_one"]], 1.], ret]]];
  method[klass, "held_over_sent", mfn[1, { env0["face"] = arg[args1, 0], env0["beta"] = arg[args1, 1] };
    env0["lets"] = mul[self["skin_at", env0["face"]], (sub[1., env0["beta"]])];
    Throw[If[truthy[gt[env0["lets"], 0.]], div[self["ball_at", env0["face"]], (mul[self["ball_at", self["NEAR"]], env0["lets"]])], Indeterminate], ret]]];
  field[klass, "FACES", dfn[list[1., 1.5, 2., 3., 4., 6., 8., 12., 16., 24., 32.]]];
  field[klass, "BETAS", dfn[list[0., 0.225, 0.45, 0.675, 0.9]]];
  getter[klass, "carries", mfn[1,
    env0["most"] = 0.;
    Do[loopScope[1, env1["face"] = iter1;
      Do[loopScope[2, env2["beta"] = iter2;
        env2["q"] = Fmt["log10", self["held_over_sent", env1["face"], env2["beta"]]];
        If[truthy[andV[Fmt["finite", env2["q"]], gt[env2["q"], env0["most"]]]],
          env0["most"] = env2["q"]]], {iter2, items[self["BETAS"]]}]], {iter1, items[self["FACES"]]}];
    Throw[env0["most"], ret]]];
  method[klass, "reach_at", mfn[1, { env0["R"] = arg[args1, 0] };
    env0["e"] = self["base"];
    env0["e"][str["\\bar{R}"] -> If[truthy[lt[env0["R"], 0.]], 0., env0["R"]]];
    env0["got"] = self["fact_at", "l.reach\\paren{\\bar{R}}", env0["e"]];
    env0["e"][str["\\bar{R}"] -> Null];
    Throw[env0["got"], ret]]];
  field[klass, "STEP", dfn[0.01]];
  field[klass, "FAR", dfn[400.]];
  field[klass, "shells", dfn[mMap[rng[add[mRound[(div[self["FAR"], self["STEP"]])], 1.]], lfn[2, { env1["i"] = arg[args2, 0] };
    Throw[self["shell_at", mul[env1["i"], self["STEP"]]], ret]]]]];
  field[klass, "reaches", dfn[mMap[rng[add[mRound[(div[self["FAR"], self["STEP"]])], 1.]], lfn[2, { env1["i"] = arg[args2, 0] };
    Throw[self["reach_at", mul[env1["i"], self["STEP"]]], ret]]]]];
  method[klass, "tabled", mfn[1, { env0["table"] = arg[args1, 0], env0["R"] = arg[args1, 1] };
    env0["u"] = div[env0["R"], self["STEP"]];
    env0["i"] = mFloor[env0["u"]];
    If[truthy[ge[env0["i"], sub[len[env0["table"]], 1.]]],
      Throw[elem[env0["table"], sub[len[env0["table"]], 1.]], ret]];
    If[truthy[lt[env0["i"], 0.]],
      Throw[elem[env0["table"], 0.], ret]];
    env0["f"] = sub[env0["u"], env0["i"]];
    Throw[add[mul[elem[env0["table"], env0["i"]], (sub[1., env0["f"]])], mul[elem[env0["table"], add[env0["i"], 1.]], env0["f"]]], ret]]];
  method[klass, "shell", mfn[1, { env0["R"] = arg[args1, 0] };
    Throw[If[truthy[gt[env0["R"], self["FAR"]]], self["shell_at", env0["R"]], self["tabled", self["shells"], env0["R"]]], ret]]];
  method[klass, "reach", mfn[1, { env0["R"] = arg[args1, 0] };
    Throw[If[truthy[gt[env0["R"], self["FAR"]]], self["reach_at", env0["R"]], self["tabled", self["reaches"], env0["R"]]], ret]]];
  method[klass, "record_at", mfn[1, { env0["masses"] = arg[args1, 0], env0["xs"] = arg[args1, 1], env0["ys"] = arg[args1, 2], env0["x"] = arg[args1, 3], env0["y"] = arg[args1, 4], env0["skip"] = arg[args1, 5] };
    Throw[self["record_of", env0["masses"], mMap[rng[len[env0["masses"]]], lfn[3, { env2["i"] = arg[args3, 0] };
      Throw[Fmt["hypot", sub[elem[env0["xs"], env2["i"]], env0["x"]], sub[elem[env0["ys"], env2["i"]], env0["y"]]], ret]]], env0["skip"]], ret]]];
  method[klass, "record_of", mfn[1, { env0["masses"] = arg[args1, 0], env0["Rs"] = arg[args1, 1], env0["skip"] = arg[args1, 2] };
    env0["st"] = self["step", "record"];
    If[truthy[eq[env0["st"], Null]],
      Throw[Indeterminate, ret]];
    Throw[self["value", env0["st"]["fact"]["to"], self["base"], env0["masses"], env0["Rs"], env0["skip"]], ret]]];
  method[klass, "value", mfn[1, { env0["e"] = arg[args1, 0], env0["at"] = arg[args1, 1], env0["masses"] = arg[args1, 2], env0["Rs"] = arg[args1, 3], env0["skip"] = arg[args1, 4] };
    env0["k"] = env0["e"]["kind"];
    If[truthy[andV[eq[env0["k"], "call"], mStartsWith[env0["e"]["label"], "\\sum"]]],
      env0["total"] = 0.;
      env0["names"] = self["per_body"];
      env0["kinds"] = self["per_body_kinds"];
      Do[loopScope[1, env1["i"] = iter1;
        If[!truthy[eq[env1["i"], env0["skip"]]],
          env1["R"] = elem[env0["Rs"], env1["i"]];
          Do[loopScope[2, env2["j"] = iter2;
            setAt[env0["at"], elem[env0["names"], env2["j"]], self["per_body_value", elem[env0["kinds"], env2["j"]], elem[env0["masses"], env1["i"]], env1["R"]]]], {iter2, 0., num[len[env0["names"]]] - 1.}];
          env0["total"] = add[env0["total"], self["value", env0["e"]["base"], env0["at"], env0["masses"], env0["Rs"], env0["skip"]]];
          Do[loopScope[2, env2["nm"] = iter2;
            setAt[env0["at"], env2["nm"], Null]], {iter2, items[env0["names"]]}]]], {iter1, 0., num[len[env0["masses"]]] - 1.}];
      Throw[env0["total"], ret]];
    If[truthy[eq[env0["k"], "num"]],
      Throw[env0["e"]["value"], ret]];
    If[truthy[orV[eq[env0["k"], "sym"], eq[env0["k"], "field"]]],
      env0["v"] = elem[env0["at"], env0["e"]["label"]];
      Throw[If[truthy[eq[env0["v"], Null]], Indeterminate, env0["v"]], ret]];
    If[truthy[eq[env0["k"], "add"]],
      env0["total"] = 0.;
      Do[loopScope[1, env1["p"] = iter1;
        env0["total"] = add[env0["total"], self["value", env1["p"], env0["at"], env0["masses"], env0["Rs"], env0["skip"]]]], {iter1, items[env0["e"]["of"]]}];
      Throw[env0["total"], ret]];
    If[truthy[eq[env0["k"], "mul"]],
      env0["prod"] = 1.;
      Do[loopScope[1, env1["p"] = iter1;
        env0["prod"] = mul[env0["prod"], self["value", env1["p"], env0["at"], env0["masses"], env0["Rs"], env0["skip"]]]], {iter1, items[env0["e"]["of"]]}];
      Throw[env0["prod"], ret]];
    If[truthy[eq[env0["k"], "pow"]],
      Throw[power[self["value", env0["e"]["base"], env0["at"], env0["masses"], env0["Rs"], env0["skip"]], self["value", env0["e"]["power"], env0["at"], env0["masses"], env0["Rs"], env0["skip"]]], ret]];
    If[truthy[eq[env0["k"], "log"]],
      Throw[mLn[self["value", env0["e"]["base"], env0["at"], env0["masses"], env0["Rs"], env0["skip"]]], ret]];
    If[truthy[eq[env0["k"], "exp"]],
      Throw[mExp[self["value", env0["e"]["base"], env0["at"], env0["masses"], env0["Rs"], env0["skip"]]], ret]];
    Throw[Aggregate["numeric_of", env0["e"], env0["at"]], ret]]];
  method[klass, "lean_at", mfn[1, { env0["masses"] = arg[args1, 0], env0["xs"] = arg[args1, 1], env0["ys"] = arg[args1, 2], env0["x"] = arg[args1, 3], env0["y"] = arg[args1, 4], env0["skip"] = arg[args1, 5] };
    env0["h"] = 0.25;
    env0["gx"] = div[(sub[self["record_at", env0["masses"], env0["xs"], env0["ys"], add[env0["x"], env0["h"]], env0["y"], env0["skip"]], self["record_at", env0["masses"], env0["xs"], env0["ys"], sub[env0["x"], env0["h"]], env0["y"], env0["skip"]]]), (mul[2., env0["h"]])];
    env0["gy"] = div[(sub[self["record_at", env0["masses"], env0["xs"], env0["ys"], env0["x"], add[env0["y"], env0["h"]], env0["skip"]], self["record_at", env0["masses"], env0["xs"], env0["ys"], env0["x"], sub[env0["y"], env0["h"]], env0["skip"]]]), (mul[2., env0["h"]])];
    Throw[list[env0["gx"], env0["gy"]], ret]]];
  method[klass, "read_at", mfn[1, { env0["hx"] = arg[args1, 0], env0["hy"] = arg[args1, 1], env0["x"] = arg[args1, 2], env0["y"] = arg[args1, 3] };
    env0["last"] = sub[len[env0["hx"]], 1.];
    env0["R"] = Fmt["hypot", sub[elem[env0["hx"], env0["last"]], env0["x"]], sub[elem[env0["hy"], env0["last"]], env0["y"]]];
    env0["px"] = elem[env0["hx"], env0["last"]];
    env0["py"] = elem[env0["hy"], env0["last"]];
    Do[loopScope[1, env1["r"] = iter1;
      env1["back"] = mRound[env0["R"]];
      If[truthy[gt[env1["back"], env0["last"]]],
        env1["back"] = env0["last"]];
      env1["at"] = sub[env0["last"], env1["back"]];
      env1["vx"] = If[truthy[gt[env1["at"], 0.]], sub[elem[env0["hx"], env1["at"]], elem[env0["hx"], sub[env1["at"], 1.]]], 0.];
      env1["vy"] = If[truthy[gt[env1["at"], 0.]], sub[elem[env0["hy"], env1["at"]], elem[env0["hy"], sub[env1["at"], 1.]]], 0.];
      env0["px"] = add[elem[env0["hx"], env1["at"]], mul[env1["vx"], env1["back"]]];
      env0["py"] = add[elem[env0["hy"], env1["at"]], mul[env1["vy"], env1["back"]]];
