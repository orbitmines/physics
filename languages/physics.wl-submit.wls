(* GENERATED by `npx ray gen` from implementation/gen/languages/Wolfram.ray - do not edit *)
(* wolframscript -file languages/physics.wl-submit.wls languages/physics.wl/ResourceDefinition.nb ["a note for the reviewers"] *)
(* Submits the paclet to the Wolfram Language Paclet Repository, as Wolfram's submit-paclet action does - and with a note for
   the reviewers where there is one (a test release says it is one), which that action cannot send *)
PacletInstall["Wolfram/PacletCICD"];
Needs["Wolfram`PacletCICD`"];
Needs["ResourceSystemClient`"];
nb = AbsoluteFileName[$ScriptCommandLine[[2]]];
note = If[Length[$ScriptCommandLine] > 2, $ScriptCommandLine[[3]], ""];
(* what the definition notebook's own submit dialog sets: the notes the submission carries to the reviewers *)
If[StringLength[note] > 0, ResourceSystemClient`Private`$localSubmissionNotes = note; Print["with a note for the reviewers: ", note]];
result = Symbol["Wolfram`PacletCICD`SubmitPaclet"][File[nb], Symbol["Wolfram`PacletCICD`Private`PublisherToken"] -> Environment["RESOURCE_PUBLISHER_TOKEN"]];
Print[result];
If[FailureQ[result], Exit[1]];
