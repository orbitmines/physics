  have p3 := w.pos_3
  have r3 := fun (y : ℝ) => Real.rpow_neg (le_of_lt w.pos_3) y
  have q3 := fun (y : ℝ) => (Real.rpow_pos_of_pos w.pos_3 y).ne'
  have p4 := w.pos_4
  have r4 := fun (y : ℝ) => Real.rpow_neg (le_of_lt w.pos_4) y
  have q4 := fun (y : ℝ) => (Real.rpow_pos_of_pos w.pos_4 y).ne'
  subst_vars
  try simp only [neg_one_mul, r0, r1, r2, r3, r4] at *
  check_algebra



end OrbitMines.Physics.Proofs.G.«gravity.expansion»
