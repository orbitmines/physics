    let w_1 ← IO.mkRef (← ωget self "W")
    if ωtruthy (← ωandV (!ωisNull (← ωget (← p_0.get) "spent")) (do pure (← call! (← p_0.get) "spent" ((← call! self "positions" ((← w_1.get))))))) then
      (← ωget self "lay") |> ωsink
      pure ()
    else
      (← ωget (← w_1.get) "tick") |> ωsink
      (← dot! self rtake ((← w_1.get))) |> ωsink
      pure ()
    pure ()
  Value.null |> ωsink
  if true then return (← call! self "finish" ((← into_0.get), (← ωget self "W")))
  return ωnull
end FieldRecording



end OrbitMines.Physics
