def main (args : List String) : IO UInt32 := do
  let only := args.head?
  let mut passed := 0
  let mut failed := 0
  let mut skipped := 0
  for (name, body) in (← testsRef.get) do
    if let some o := only then
      if (strFind name o).isNone then continue
    let t0 ← IO.monoNanosNow
    let got ← try body catch e => pure ("error: " ++ toString e)
    let t1 ← IO.monoNanosNow
    let secs := fixed2 ((t1 - t0).toFloat / 1e9)
    if got == "pass" then
      passed := passed + 1
      IO.println ("ok   " ++ name ++ " (" ++ secs ++ " s)")
    else if got == "skip" then
      skipped := skipped + 1
      IO.println ("skip " ++ name ++ " (" ++ secs ++ " s)")
    else
      failed := failed + 1
      IO.println ("FAIL " ++ name ++ " (" ++ secs ++ " s) - " ++ got)
    (← IO.getStdout).flush
  IO.println (toString passed ++ " passed, " ++ toString failed ++ " failed, " ++ toString skipped ++ " skipped")
  return (if failed > 0 then 1 else 0)
