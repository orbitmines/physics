/*
 * METAL: the kernels in the Metal Shading Language. Kernels only: no runtime template is written
 * here, since no Metal device was available to test one against.
 */
Metal: Backend = class {
  name = "Metal"
  kernel = MSL
  head = ""
  declarations = "struct Par {{ u32 cells; u32 A; u32 N; u32 K; f32 DEG; u32 holes; u32 tick; u32 tags; u32 z; u32 entries; u32 pad1; u32 pad2; }};"
  supports (language: Language): boolean => false
  runtime_for (language: Language): String => None
  kernels (theory: Theory): String => Kernels.build(this, theory)
}
