  | field (d : Option Default)
  | method (m : Member)
  | staticField (k : Nat)
  | staticMethod (m : Member)
  | none
instance : Inhabited Res := ⟨.none⟩
initialize objCache : IO.Ref (HashMap (Nat × String) Res) ← IO.mkRef {}
initialize clsCache : IO.Ref (HashMap (Nat × String) Res) ← IO.mkRef {}
initialize chainCache : IO.Ref (HashMap Nat (Array Nat)) ← IO.mkRef {}
initialize namesCache : IO.Ref (HashMap Nat (Array String)) ← IO.mkRef {}
initialize kCache : IO.Ref (HashMap String Value) ← IO.mkRef {}
def clearCaches : IO Unit := do
  objCache.set {}; clsCache.set {}; chainCache.set {}; namesCache.set {}; kCache.set {}

def throwMsg {α : Type} (says : String) : IO α := throw (IO.userError says)

/-- a class by its name, made empty when it is first named (a child may be written before its parent) -/
def clsId (name : String) : IO Nat := do
  match (← classIndexRef.get)[name]? with
  | some i => return i
  | none =>
    let cs ← classesRef.get
    let i := cs.size
    classesRef.set (cs.push { name := name })
    classIndexRef.modify (·.insert name i)
    return i

@[inline] def clsData (i : Nat) : IO ClsData := do
  return (← classesRef.get)[i]!

def modifyCls (i : Nat) (f : ClsData → ClsData) : IO Unit := do
  classesRef.modify fun cs => cs.modify i f
  clearCaches

-- --- the tables, filled when the package loads ---------------------------------------------------------
def defineClass (name parent : String) : IO Unit := do
  let i ← clsId name
  let p ← clsId (if parent == "" then "Node" else parent)
  modifyCls i fun d => { d with parent := some p, defined := true }
def field (c n : String) (d : Default) : IO Unit := do
  modifyCls (← clsId c) fun k => { k with fields := k.fields.insert n (some d), order := k.order.push n }
def fieldNone (c n : String) : IO Unit := do
  modifyCls (← clsId c) fun k => { k with fields := k.fields.insert n none, order := k.order.push n }
def method (c n : String) (m : Member) : IO Unit := do
  modifyCls (← clsId c) fun k => { k with methods := k.methods.insert n m }
def getter (c n : String) (m : Member) : IO Unit := do
  modifyCls (← clsId c) fun k => { k with getters := k.getters.insert n m }
def statik (c n : String) (m : Member) : IO Unit := do
  modifyCls (← clsId c) fun k => { k with statics := k.statics.insert n m }
def staticField (c n : String) (d : Default) : IO Unit := do
  modifyCls (← clsId c) fun k => { k with staticDefaults := k.staticDefaults.insert n d, staticOrder := if k.staticDefaults.contains n then k.staticOrder else k.staticOrder.push n }
def declared (n : String) : Member := fun _ _ => throwMsg s!"{n} is declared but not defined by anyone"

def chain (i : Nat) : IO (Array Nat) := do
  if let some c := (← chainCache.get)[i]? then return c
