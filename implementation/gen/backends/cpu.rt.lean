  | .bool b => b
  | .num x => !(x == 0 || x.isNaN)
  | .str s => !s.isEmpty
  | _ => true

def num : Value → Float
  | .num x => x
  | .null => 0
  | .bool b => if b then 1 else 0
  | _ => 0.0 / 0.0

@[inline] def arith : Value → Bool
