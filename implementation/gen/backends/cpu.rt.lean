instance : Nonempty Obj := ⟨{ id := 0, cls := 0, slots := Classical.choice inferInstance }⟩
instance : Nonempty Fn := ⟨fun _ => pure .null⟩

@[inline] def Value.ofList (r : IO.Ref (Array Value)) : Value := .list (toHandle r)
@[inline] def Value.ofObj (o : Obj) : Value := .obj (toHandle o)
@[inline] def mkFn (f : Fn) : Value := .fn (toHandle f)
