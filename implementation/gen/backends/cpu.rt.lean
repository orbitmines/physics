-- numbers as the bootstrap (JavaScript) writes them: the shortest text that reads back as the same number
def exactDecimal (x : Float) : String × Int :=
  let bits := x.toBits.toNat
  let e := (bits >>> 52) % 2048
  let f := bits % (2 ^ 52)
  let (m, ex) : Nat × Int := if e == 0 then (f, -1074) else (f + 2 ^ 52, (e : Int) - 1075)
  if ex ≥ 0 then (toString (m * 2 ^ ex.toNat), 0)
  else (toString (m * 5 ^ (-ex).toNat), ex)

def roundDigits (s : String) (p : Nat) : Nat × Nat :=
  let cs := s.toList
  let head := (String.ofList (cs.take p)).toNat!
  let next := cs.getD p '0'
  let up := if next ≥ '5' then head + 1 else head
  (up, cs.length - p)

def jsNumber (x : Float) : String := Id.run do
  if x.toBits == nullBits then return "null"
  if x.isNaN then return "NaN"
  if x.isInf then return if x > 0 then "Infinity" else "-Infinity"
  if x == 0 then return "0"
  let neg := x < 0
  let a := if neg then -x else x
  let sign := if neg then "-" else ""
  if a == a.floor && a < 9007199254740992 then
    return sign ++ toString a.toUInt64.toNat
  let (s, e10) := exactDecimal a
  let mut best : Nat × Int := (0, 0)
  for p in [1:18] do
    let p' := min p s.length
    let (d, dropped) := roundDigits s p'
    let exp : Int := e10 + dropped
    let back := if exp < 0 then Float.ofScientific d true (-exp).toNat else Float.ofScientific (d * 10 ^ exp.toNat) false 0
    best := (d, exp)
    if back == a then break
  let (d0, exp0) := best
  let mut d := d0
  let mut exp := exp0
  while d % 10 == 0 && d > 0 do
    d := d / 10
    exp := exp + 1
  let ds := toString d
  let k : Int := ds.length
  let n : Int := k + exp
  if k ≤ n && n ≤ 21 then
    return sign ++ ds ++ String.ofList (List.replicate (n - k).toNat '0')
  if 0 < n && n ≤ 21 then
    return sign ++ String.ofList (ds.toList.take n.toNat) ++ "." ++ String.ofList (ds.toList.drop n.toNat)
  if -6 < n && n ≤ 0 then
    return sign ++ "0." ++ String.ofList (List.replicate (-n).toNat '0') ++ ds
  let e := n - 1
  let es := if e ≥ 0 then "+" ++ toString e else toString e
  let mant := if ds.length == 1 then ds else String.ofList (ds.toList.take 1) ++ "." ++ String.ofList (ds.toList.drop 1)
  return sign ++ mant ++ "e" ++ es

/-- a text read as a number, as JavaScript's Number() reads it (NaN when it is not one) -/
def parseNumber (s0 : String) : Float := Id.run do
  let s := String.ofList (s0.toList.dropWhile Char.isWhitespace |>.reverse |>.dropWhile Char.isWhitespace |>.reverse)
  if s.isEmpty then return 0
  let nan : Float := 0.0 / 0.0
  let cs := s.toList
  let (neg, cs) := match cs with
    | '-' :: r => (true, r)
    | '+' :: r => (false, r)
    | r => (false, r)
  if String.ofList cs == "Infinity" then return if neg then -(1.0 / 0.0) else 1.0 / 0.0
  let mut m : Nat := 0
  let mut scale : Int := 0
  let mut seenDigit := false
  let mut seenDot := false
  let mut rest := cs
  while true do
    match rest with
    | c :: r =>
      if c.isDigit then
        m := m * 10 + (c.toNat - '0'.toNat)
        if seenDot then scale := scale - 1
        seenDigit := true
        rest := r
      else if c == '.' && !seenDot then
        seenDot := true
        rest := r
      else break
    | [] => break
  if !seenDigit then return nan
  match rest with
  | [] => pure ()
  | c :: r =>
    if c == 'e' || c == 'E' then
      let (eneg, r) := match r with
        | '-' :: q => (true, q)
        | '+' :: q => (false, q)
        | q => (false, q)
      if r.isEmpty || !r.all Char.isDigit then return nan
      let ev : Int := (String.ofList r).toNat!
      scale := scale + (if eneg then -ev else ev)
    else return nan
  let v := if scale < 0 then Float.ofScientific m true (-scale).toNat else Float.ofScientific m false scale.toNat
  return if neg then -v else v

/-- a natural number as a float, by the machine (`Nat.toFloat` goes through the exact model, slowly) -/
@[inline] def natF (n : Nat) : Float := n.toUInt64.toFloat
def toIndex (x : Float) : Int :=
  if x.isNaN then 0 else if x < 0 then -((-x).floor.toUInt64.toNat : Int) else (x.floor.toUInt64.toNat : Int)
def rangeN (x : Float) : Nat := if x.isNaN || x ≤ 0 then 0 else x.ceil.toUInt64.toNat

