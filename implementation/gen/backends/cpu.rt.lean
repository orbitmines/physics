instance : OfNat Value n := ⟨.num (natF n)⟩

unsafe def toHandleImpl {α : Type} (a : α) : Handle := unsafeCast a
@[implemented_by toHandleImpl] opaque toHandle {α : Type} (a : α) : Handle
unsafe def ofHandleImpl {α : Type} [Nonempty α] (h : Handle) : α := unsafeCast h
@[implemented_by ofHandleImpl] opaque ofHandle {α : Type} [Nonempty α] (h : Handle) : α
unsafe def sameImpl (a b : Handle) : Bool := ptrAddrUnsafe a == ptrAddrUnsafe b
