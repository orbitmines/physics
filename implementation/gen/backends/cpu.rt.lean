-- numbers as the bootstrap (JavaScript) writes them: the shortest text that reads back as the same number
def digitsOf (n : Nat) : String := toString n

def natPow10 (k : Nat) : Nat := 10 ^ k

/-- the exact decimal digits of a finite positive float and the power of ten of its last digit -/
def exactDecimal (x : Float) : String × Int :=
  let bits := x.toBits.toNat
  let e := (bits >>> 52) % 2048
  let f := bits % (2 ^ 52)
  let (m, ex) : Nat × Int := if e == 0 then (f, -1074) else (f + 2 ^ 52, (e : Int) - 1075)
  if ex ≥ 0 then (digitsOf (m * 2 ^ ex.toNat), 0)
  else (digitsOf (m * 5 ^ (-ex).toNat), ex)

/-- a digit string rounded to `p` digits (half up); the result may carry into one more digit -/
def roundDigits (s : String) (p : Nat) : Nat × Nat :=
  let cs := s.toList
  let head := (String.ofList (cs.take p)).toNat!
  let next := cs.getD p '0'
  let up := if next ≥ '5' then head + 1 else head
  (up, cs.length - p)

def jsNumber (x : Float) : String := Id.run do
  if x.isNaN then return "NaN"
  if x.isInf then return if x > 0 then "Infinity" else "-Infinity"
  if x == 0 then return "0"
  let neg := x < 0
  let a := if neg then -x else x
  let sign := if neg then "-" else ""
  if a == a.floor && a < 9007199254740992 then
    return sign ++ toString a.toUInt64.toNat
  let (s, e10) := exactDecimal a
  -- the shortest rounding of the exact digits that reads back as the same float
  let mut best : Nat × Int := (0, 0)
  for p in [1:18] do
    let p' := min p s.length
    let (d, dropped) := roundDigits s p'
    let exp : Int := e10 + dropped
    let back := if exp < 0 then Float.ofScientific d true (-exp).toNat else Float.ofScientific (d * 10 ^ exp.toNat) false 0
    best := (d, exp)
    if back == a then break
  let (d0, exp0) := best
  -- strip trailing zeros
  let mut d := d0
  let mut exp := exp0
  while d % 10 == 0 && d > 0 do
    d := d / 10
    exp := exp + 1
  let ds := digitsOf d
  let k : Int := ds.length
  let n : Int := k + exp
  if k ≤ n && n ≤ 21 then
    return sign ++ ds ++ String.ofList (List.replicate (n - k).toNat '0')
  if 0 < n && n ≤ 21 then
    return sign ++ String.ofList (ds.toList.take n.toNat) ++ "." ++ String.ofList (ds.toList.drop n.toNat)
  if -6 < n && n ≤ 0 then
    return sign ++ "0." ++ String.ofList (List.replicate (-n).toNat '0') ++ ds
  let e := n - 1
  let es := if e ≥ 0 then "+" ++ toString e else toString e
  let mant := if ds.length == 1 then ds else String.ofList (ds.toList.take 1) ++ "." ++ String.ofList (ds.toList.drop 1)
  return sign ++ mant ++ "e" ++ es

/-- a text read as a number, as JavaScript's Number() reads it (NaN when it is not one) -/
def parseNumber (s0 : String) : Float := Id.run do
  let s := String.ofList (s0.toList.dropWhile Char.isWhitespace |>.reverse |>.dropWhile Char.isWhitespace |>.reverse)
  if s.isEmpty then return 0
  let nan : Float := 0.0 / 0.0
  let cs := s.toList
  let (neg, cs) := match cs with
    | '-' :: r => (true, r)
    | '+' :: r => (false, r)
    | r => (false, r)
  if String.ofList cs == "Infinity" then return if neg then -(1.0 / 0.0) else 1.0 / 0.0
  let mut m : Nat := 0
  let mut scale : Int := 0
  let mut seenDigit := false
  let mut seenDot := false
  let mut rest := cs
  while true do
    match rest with
    | c :: r =>
      if c.isDigit then
        m := m * 10 + (c.toNat - '0'.toNat)
        if seenDot then scale := scale - 1
        seenDigit := true
        rest := r
      else if c == '.' && !seenDot then
        seenDot := true
        rest := r
      else break
    | [] => break
  if !seenDigit then return nan
  match rest with
  | [] => pure ()
  | c :: r =>
    if c == 'e' || c == 'E' then
      let (eneg, r) := match r with
        | '-' :: q => (true, q)
        | '+' :: q => (false, q)
        | q => (false, q)
      if r.isEmpty || !r.all Char.isDigit then return nan
      let ev : Int := (String.ofList r).toNat!
      scale := scale + (if eneg then -ev else ev)
    else return nan
  let v := if scale < 0 then Float.ofScientific m true (-scale).toNat else Float.ofScientific m false scale.toNat
  return if neg then -v else v

-- --- members by name -------------------------------------------------------------------------------------
partial def strv : Value → IO String
  | .null => return "null"
  | .num x => return jsNumber x
  | .bool b => return if b then "true" else "false"
  | .str s => return s
  | .list h => do
    let xs ← (listRef h).get
    let mut out := ""
    let mut first := true
    for x in xs do
      if !first then out := out ++ ","
      first := false
      out := out ++ (← match x with | .null => pure "" | v => strv v)
    return out
  | .obj h => do
    let o := objOf h
    match ← findMethod o.cls "toString" with
    | some m => strv (← m (.obj h) #[])
    | none => return (← clsData o.cls).name
  | .fn _ => return "[program]"
  | .cls i => return (← clsData i).name
  | .many xs => do return s!"Many({xs.size})"
  | .kw n v => do return s!"{n}: {← strv v}"

def K (name : String) : IO Value := do
  if let some v := (← kCache.get)[name]? then return v
  let n := (name.splitOn ".").getLast!
  let v ← match (← theoriesRef.get)[n]? with
    | some t => pure t
    | none =>
      match (← classIndexRef.get)[n]? with
      | some i => pure (Value.cls i)
      | none => throwMsg s!"no class {name} in this package"
  kCache.modify (·.insert name v)
  return v

def glob (name : String) : IO Value := do
  if let some v := (← globalValuesRef.get)[name]? then return v
  match (← globalsRef.get)[name]? with
  | some mkv =>
    let v ← mkv
    globalValuesRef.modify (·.insert name v)
    return v
  | none => throwMsg s!"no definition {name} in this package"
def defGlobal (name : String) (v : IO Value) : IO Unit := globalsRef.modify (·.insert name v)

def newObj (c : Nat) : IO Obj := do
  let id ← objCounter.modifyGet fun n => (n, n + 1)
  return { id := id, cls := c, slots := ← IO.mkRef {} }

/-- the fields of a class and its parents, root first: what positional arguments fill -/
def fieldNames (c : Nat) : IO (Array String) := do
  if let some ns := (← namesCache.get)[c]? then return ns
  let mut names : Array String := #[]
  for k in (← chain c).reverse do names := names ++ (← clsData k).order
  namesCache.modify (·.insert c names)
  return names

/-- `Class(x: 1, ...)`: an object of the class, its named fields set, the rest in the order its fields are written -/
def mkC (c : Nat) (a : Array Value) : IO Value := do
  let o ← newObj c
  let mut slots : HashMap String Value := {}
  let mut positional := 0
  for x in a do
    match x with
    | .kw n v => slots := slots.insert n v
    | v =>
      let names ← fieldNames c
      if positional < names.size then
        slots := slots.insert names[positional]! v
        positional := positional + 1
  o.slots.set slots
  return Value.ofObj o
def mk (kind : String) (a : Array Value) : IO Value := do
  match ← K kind with
  | .cls c => mkC c a
  | _ => throwMsg s!"{kind} is not a class"
def mkV (kind : Value) (a : Array Value) : IO Value := do
  match kind with
  | .cls c => mkC c a
  | .str s => mk s a
  | _ => throwMsg "make: not a class"

def collapse (items : Array Value) : IO Value := do
  if items.isEmpty then return .many items
  let f := items[0]!
  let sameAs : Value → Value → Bool
    | .null, .null => true
    | .num a, .num b => a == b
    | .bool a, .bool b => a == b
    | .str a, .str b => a == b
    | .obj a, .obj b => (objOf a).id == (objOf b).id
    | .list a, .list b => same a b
    | .fn a, .fn b => same a b
    | .cls a, .cls b => a == b
    | _, _ => false
  if items.all (sameAs · f) then return f
  return .many items

mutual
partial def gm (t : Value) (n : String) : IO Value := do
  match t with
  | .obj h =>
    let o := objOf h
    if let some v := (← o.slots.get)[n]? then return v
    match ← resolveObj o.cls n with
    | .getter g => g t #[]
    | .field f =>
      let v ← match f with
        | some mkd => mkd t
        | none => pure .null
      o.slots.modify (·.insert n v)
      return v
    | .method m => return mkFn (fun a => m t a)
    | .staticField k => gm (.cls k) n
    | _ => return .null
  | .cls c =>
    match ← resolveCls c n with
    | .staticField k =>
      if let some v := (← staticSlotsRef.get)[(k, n)]? then return v
      let d := (← clsData k).staticDefaults[n]!
      let v ← d .null
      staticSlotsRef.modify (·.insert (k, n) v)
      return v
    | .staticMethod s => s .null #[]
    | _ => return .null
  | .many xs => collapse (← xs.mapM fun x => match x with | .null => pure .null | v => gm v n)
  | .null => throwMsg s!"no member {n} on None"
  | .list h => if n == "length" then return .num (natF (← (listRef h).get).size) else throwMsg s!"no member {n} on a list"
  | .str s => if n == "length" then return .num (natF s.length) else throwMsg s!"no member {n} on a text"
  | _ => throwMsg s!"no member {n} on {← strv t}"

partial def cm (t : Value) (n : String) (a : Array Value) : IO Value := do
  match t with
  | .obj h =>
    let o := objOf h
    let own := (← o.slots.get).contains n
    if !own then
      if let .method m ← resolveObj o.cls n then return (← m t a)
    match ← gm t n with
    | .fn fh => fnOf fh a
    | .null => throwMsg s!"no method {n} on {(← clsData o.cls).name}"
    | v => return v
  | .cls c =>
    match ← resolveCls c n with
    | .staticMethod s => s .null a
    | _ =>
      match ← findStatic c n with
      | some s => s .null a
      | none =>
        match ← gm t n with
        | .fn fh => fnOf fh a
        | _ => throwMsg s!"no static {n} on {(← clsData c).name}"
  | .many xs => collapse (← xs.mapM fun x => cm x n a)
  | .null => throwMsg s!"no method {n} on None"
  | _ => throwMsg s!"no method {n} on {← strv t}"
end

@[inline] def gmo (t : Value) (n : String) : IO Value := match t with | .null => pure .null | _ => gm t n
@[inline] def cmo (t : Value) (n : String) (a : Array Value) : IO Value := match t with | .null => pure .null | _ => cm t n a

partial def sm (t : Value) (n : String) (v : Value) : IO Unit := do
  match t with
  | .obj h => (objOf h).slots.modify (·.insert n v)
  | .cls c =>
    match ← findStaticField c n with
    | some k => staticSlotsRef.modify (·.insert (k, n) v)
    | none =>
      staticSlotsRef.modify (·.insert (c, n) v)
      clearCaches
  | .many xs => for x in xs do sm x n v
  | _ => throwMsg s!"no member {n} to set on {← strv t}"

def inv (f : Value) (a : Array Value) : IO Value := do
  match f with
  | .fn h => fnOf h a
  | _ => throwMsg s!"not a program: {← strv f}"

def choose (t : Value) (name : String) : IO Value := gm t ("choose " ++ name)

/-- whether an object has a member of this name, of its own or its class's -/
def has (t : Value) (n : String) : IO Bool := do
  match t with
  | .obj h =>
    let o := objOf h
    if (← o.slots.get).contains n then return true
    match ← resolveObj o.cls n with
    | .getter _ | .field _ | .method _ => return true
    | _ => return false
  | .cls c => return (← findStatic c n).isSome || (← findStaticField c n).isSome
  | _ => return false

/-- a theory: its class made once, its rules and theorems read off the class in the order they are written -/
def defineTheory (name : String) : IO Unit := do
  let c ← clsId name
  let o ← mkC c #[]
  theoriesRef.modify (·.insert name o)
  kCache.set {}
  let mut rules := #[]
  let mut theorems := #[]
  for k in (← chain c).reverse do
    for n in (← clsData k).staticOrder do
      if n.startsWith "rule " then rules := rules.push (← gm (.cls c) n)
      else if n.startsWith "theorem " then theorems := theorems.push (← gm (.cls c) n)
  sm o "rules" (← listOf rules)
  sm o "theorems" (← listOf theorems)

def setStaticCls (outer inner : String) : IO Unit := do
  let o ← clsId outer
  let i ← clsId inner
  staticSlotsRef.modify (·.insert (o, inner) (.cls i))
  clearCaches

/-- a share of a term: its source, and the program that reads it at the symbols -/
def atv (source : String) (f : Value → IO Value) : IO Value := do
  let o ← mk "Node" #[]
  sm o "source" (.str source)
  sm o "at" (mkFn fun a => f (arg a 0))
  return o

def instanceOf (x : Value) (c : String) : IO Value := do
  match c with
  | "Array" => return vb (match x with | .list _ => true | _ => false)
  | "N" | "Natural" | "Z" | "Integer" | "Real" | "Decimal" | "Number" => return vb (match x with | .num _ => true | _ => false)
  | "String" => return vb (match x with | .str _ => true | _ => false)
  | "boolean" => return vb (match x with | .bool _ => true | _ => false)
  | _ =>
    match x, ← K c with
    | .obj h, .cls k => return vb (← isA (objOf h).cls k)
    | _, _ => return vFalse
def isList (x : Value) : Value := vb (match x with | .list _ => true | _ => false)

-- --- lists and text ----------------------------------------------------------------------------------------
def charsOf (s : String) : Array Value := s.toList.toArray.map fun c => .str (String.singleton c)

def itemsv (xs : Value) : IO (Array Value) := do
  match xs with
  | .many m => return m
  | .list h => (listRef h).get
  | .str s => return charsOf s
  | .null => return #[]
  | _ => throwMsg s!"not a list: {← strv xs}"

mutual
partial def eqB (a b : Value) : IO Bool := do
  match a, b with
  | .null, .null => return true
  | .null, _ => return false
  | _, .null => return false
  | .many xs, _ => do
    for x in xs do if !(← eqB x b) then return false
    return true
  | .num x, .num y => return x == y
  | .bool x, .bool y => return x == y
  | .str x, .str y => return x == y
  | .list x, .list y =>
    if same x y then return true
    let xs ← (listRef x).get
    let ys ← (listRef y).get
    if xs.size != ys.size then return false
    for i in [0:xs.size] do if !(← eqB xs[i]! ys[i]!) then return false
    return true
  | .obj x, _ =>
    let o := objOf x
    if let .obj y := b then if (objOf y).id == o.id then return true
    match ← findMethod o.cls "equals" with
    | some m => return truthy (← m a #[b])
    | none => return false
  | .fn x, .fn y => return same x y
  | .cls x, .cls y => return x == y
  | _, _ => return false
end

def eqV (a b : Value) : IO Value := do return vb (← eqB a b)
def neV (a b : Value) : IO Value := do return vb !(← eqB a b)
def notV (a : Value) : IO Value := return vb !(truthy a)
@[inline] def andV (a : Value) (b : IO Value) : IO Value := do
  if truthy a then return vb (truthy (← b)) else return vFalse
@[inline] def orV (a : Value) (b : IO Value) : IO Value := do
  if truthy a then return vTrue else return vb (truthy (← b))
@[inline] def orElse (a : Value) (b : IO Value) : IO Value := match a with | .null => b | v => pure v

def cmpStr (a b : String) : Ordering := compare a b
def ltV (a b : Value) : IO Value := do
  if arith a then return vb (num a < num b)
  match a, b with
  | .str x, .str y => return vb (x < y)
  | _, _ => cm a "lt" #[b]
def leV (a b : Value) : IO Value := do
  if arith a then return vb (num a ≤ num b)
  match a, b with
  | .str x, .str y => return vb (x ≤ y)
  | _, _ => cm a "le" #[b]
def gtV (a b : Value) : IO Value := do
  if arith a then return vb (num a > num b)
  match a, b with
  | .str x, .str y => return vb (x > y)
  | _, _ => cm a "gt" #[b]
def geV (a b : Value) : IO Value := do
  if arith a then return vb (num a ≥ num b)
  match a, b with
  | .str x, .str y => return vb (x ≥ y)
  | _, _ => cm a "ge" #[b]
def addV (a b : Value) : IO Value := do
  match a, b with
  | .num x, .num y => return .num (x + y)
  | .str x, _ => return .str (x ++ (← strv b))
  | _, .str y => if arith a then return .str ((← strv a) ++ y) else cm a "plus" #[b]
  | _, _ => if arith a then return .num (num a + num b) else cm a "plus" #[b]
def subV (a b : Value) : IO Value := do
  match a, b with
  | .num x, .num y => return .num (x - y)
  | _, _ => if arith a then return .num (num a - num b) else cm a "minus" #[b]
def mulV (a b : Value) : IO Value := do
  match a, b with
  | .num x, .num y => return .num (x * y)
  | _, _ => if arith a then return .num (num a * num b) else cm a "times" #[b]
def divV (a b : Value) : IO Value := do
  if !arith a then return (← cm a "over" #[b])
  let x := num a
  let y := num b
  return .num (if y == 0 && x == 0 then 0 else x / y)
@[extern "fmod"] opaque fmod : Float → Float → Float
def modV (a b : Value) : IO Value := do
  if arith a then return .num (fmod (num a) (num b)) else cm a "mod" #[b]
def negV (a : Value) : IO Value := do
  if arith a then return .num (-(num a)) else gm a "negated"
def powV (a b : Value) : IO Value := do
  if arith a then return .num (Float.pow (num a) (num b)) else cm a "pow" #[b]

def lenOf (xs : Value) : IO Value := do
  match xs with
  | .list h => return .num (natF (← (listRef h).get).size)
  | .str s => return .num (natF s.length)
  | .many m => return .num (natF m.size)
  | _ => gm xs "length"

def toIndex (k : Value) : Int :=
  let x := num k
  if x.isNaN then 0 else if x < 0 then -((-x).floor.toUInt64.toNat : Int) else (x.floor.toUInt64.toNat : Int)

partial def elemv (t k : Value) : IO Value := do
  match t with
  | .null => return .null
  | .list h =>
    let xs ← (listRef h).get
    let i := toIndex k
    let j := if i < 0 then i + xs.size else i
    return if j ≥ 0 && j < xs.size then xs[j.toNat]! else .null
  | .str s =>
    let cs := s.toList
    let i := toIndex k
    let j := if i < 0 then i + cs.length else i
    return if j ≥ 0 && j < cs.length then .str (String.singleton cs[j.toNat]!) else .null
  | .many m => collapse (← m.mapM (elemv · k))
  | .obj _ | .cls _ => gm t (← match k with | .str s => pure s | _ => strv k)
  | _ => return .null

def setAt (t k v : Value) : IO Unit := do
  match t with
  | .list h =>
    let i := (toIndex k).toNat
    (listRef h).modify fun xs => Id.run do
      let mut ys := xs
      while ys.size ≤ i do ys := ys.push .null
      return ys.set! i v
  | _ => sm t (← match k with | .str s => pure s | _ => strv k) v

def push (xs x : Value) : IO Value := do
  match xs with
  | .list h => (listRef h).modify (·.push x); return xs
  | _ => throwMsg "push: not a list"

def filt (xs f : Value) : IO Value := do
  match xs with
  | .many m => return .many (← m.filterM fun x => do return truthy (← inv f #[x]))
  | _ => listOf (← (← itemsv xs).filterM fun x => do return truthy (← inv f #[x]))

def rangeN (n : Value) : Nat :=
  let x := num n
  if x.isNaN || x ≤ 0 then 0 else x.ceil.toUInt64.toNat
def rng (n : Value) : IO Value := listOf ((Array.range (rangeN n)).map fun i => .num (natF i))
def filled (n v : Value) : IO Value := listOf (Array.replicate (rangeN n) v)

def strFind (s sub : String) : Option Nat := Id.run do
  let a := s.toList.toArray
  let b := sub.toList.toArray
  if b.size == 0 then return some 0
  if b.size > a.size then return none
  for i in [0:a.size - b.size + 1] do
    let mut ok := true
    for j in [0:b.size] do
      if a[i + j]! != b[j]! then
        ok := false
        break
    if ok then return some i
  return none

def contains (xs x : Value) : IO Value := do
  match xs with
  | .str s => return vb (strFind s (← strv x)).isSome
  | _ =>
    for y in ← itemsv xs do if ← eqB y x then return vTrue
    return vFalse
def indexOf (xs x : Value) : IO Value := do
  match xs with
  | .str s => return match strFind s (← strv x) with | some i => .num (natF i) | none => .null
  | _ =>
    let l ← itemsv xs
    for i in [0:l.size] do if ← eqB l[i]! x then return .num (natF i)
    return .null
def firstOf (xs : Value) : IO Value := do
  match xs with
  | .str s => return match s.toList with | c :: _ => .str (String.singleton c) | [] => .null
  | _ => return (← itemsv xs)[0]?.getD .null
def lastOf (xs : Value) : IO Value := do
  match xs with
  | .str s => return match s.toList.getLast? with | some c => .str (String.singleton c) | none => .null
  | _ => return (← itemsv xs).back?.getD .null
def joinOf (xs sep : Value) : IO Value := do
  let s ← strv sep
  let mut out := ""
  let mut first := true
  for x in ← itemsv xs do
    if !first then out := out ++ s
    first := false
    out := out ++ (← strv x)
  return .str out

def quoteText (s : String) : String := Id.run do
  let mut out := "\""
  for c in s.toList do
    if c == '"' then out := out ++ "\\\""
    else if c == '\\' then out := out ++ "\\\\"
    else if c == '\n' then out := out ++ "\\n"
    else if c == '\r' then out := out ++ "\\r"
    else if c == '\t' then out := out ++ "\\t"
    else if c.toNat < 0x20 then
      let h := Nat.toDigits 16 c.toNat
      out := out ++ "\\u" ++ String.ofList (List.replicate (4 - h.length) '0' ++ h)
    else out := out.push c
  return out.push '"'
def quoted (x : Value) : IO Value := do return .str (quoteText (← strv x))

def most (xs key : Value) : IO Value := do
  let l ← itemsv xs
  let mut best : Option (Value × Nat × Float) := none
  for i in [0:l.size] do
    let k := num (← inv key #[l[i]!])
    match best with
    | none => best := some (l[i]!, i, k)
    | some (_, _, bk) => if k > bk then best := some (l[i]!, i, k)
  match best with
  | none => return .null
  | some (b, i, _) => listOf #[b, .num (natF i)]
def sortedBy (xs key : Value) : IO Value := do
  let l ← itemsv xs
  let mut keyed : Array (Float × Nat × Value) := #[]
  for i in [0:l.size] do keyed := keyed.push (num (← inv key #[l[i]!]), i, l[i]!)
  let sorted := keyed.qsort fun (p : Float × Nat × Value) (q : Float × Nat × Value) => if p.1 != q.1 then p.1 < q.1 else p.2.1 < q.2.1
  listOf (sorted.map (·.2.2))
def summed (xs : Value) : IO Value := do
  let mut s : Float := 0
  for x in ← itemsv xs do s := s + num x
  return .num s
def failV (says : Value) : IO Value := do throwMsg (← strv says)
/-- `fail` as a value, for a call the emitter could not tell from any other -/
def fail : Value := mkFn fun a => failV (arg a 0)
def fromCodepoints (xs : Value) : IO Value := do
  return .str (String.ofList ((← itemsv xs).toList.map fun c => Char.ofNat (num c).toUInt64.toNat))
def blank (c : Value) : Value := let d := num c; vb (d == 32 || d == 9 || d == 10 || d == 13)
def number (s : Value) : IO Value := do return .num (parseNumber (← strv s))
def manyv (xs : Value) : IO Value := do return .many (← itemsv xs)

/-- a member Ray knows on a list, a text or a number - and any object's own member of that name otherwise -/
@[inline] def core : Value → Bool
  | .obj _ | .cls _ | .fn _ => false
  | _ => true

def trimText (s : String) : String :=
  String.ofList (s.toList.dropWhile Char.isWhitespace |>.reverse |>.dropWhile Char.isWhitespace |>.reverse)
def splitText (s sep : String) : Array Value :=
  if sep.isEmpty then charsOf s else (s.splitOn sep).toArray.map .str

def m_push (xs : Value) (a : Array Value) : IO Value := if core xs then push xs (arg a 0) else cm xs "push" a
def m_chars (xs : Value) : IO Value := match xs with
  | .str s => listOf (s.toList.toArray.map fun c => .num (natF c.toNat))
  | _ => gm xs "chars"
def m_pop (xs : Value) : IO Value := do
  match xs with
  | .list h =>
    let l ← (listRef h).get
    match l.back? with
    | some x => (listRef h).modify (·.pop); return x
    | none => return .null
  | _ => gm xs "pop"
def m_map (xs : Value) (a : Array Value) : IO Value := do
  if !core xs then return (← cm xs "map" a)
  let f := arg a 0
  listOf (← (← itemsv xs).mapM fun x => inv f #[x])
def m_for (xs : Value) (a : Array Value) : IO Value := do
  if !core xs then return (← cm xs "for" a)
  let f := arg a 0
  for x in ← itemsv xs do discard <| inv f #[x]
  return .null
def m_some (xs : Value) (a : Array Value) : IO Value := do
  if !core xs then return (← cm xs "some" a)
  let f := arg a 0
  for x in ← itemsv xs do if truthy (← inv f #[x]) then return vTrue
  return vFalse
def m_every (xs : Value) (a : Array Value) : IO Value := do
  if !core xs then return (← cm xs "every" a)
  let f := arg a 0
  for x in ← itemsv xs do if !truthy (← inv f #[x]) then return vFalse
  return vTrue
def m_reduce (xs : Value) (a : Array Value) : IO Value := do
  if !core xs then return (← cm xs "reduce" a)
  let z := arg a 0
  let f := arg a 1
  let mut acc := z
  for x in ← itemsv xs do acc ← inv f #[acc, x]
  return acc
def m_filter (xs : Value) (a : Array Value) : IO Value := match xs with
  | .obj _ | .cls _ => cm xs "filter" a
  | _ => filt xs (arg a 0)
def m_starts_with (xs : Value) (a : Array Value) : IO Value := do
  match xs with
  | .str s => return vb (s.startsWith (← strv (arg a 0)))
  | _ => cm xs "starts_with" a
def m_ends_with (xs : Value) (a : Array Value) : IO Value := do
  match xs with
  | .str s => return vb (s.endsWith (← strv (arg a 0)))
  | _ => cm xs "ends_with" a
def m_replace (xs : Value) (a : Array Value) : IO Value := do
  match xs with
  | .str s => return .str (s.replace (← strv (arg a 0)) (← strv (arg a 1)))
  | _ => cm xs "replace" a
def m_split (xs : Value) (a : Array Value) : IO Value := do
  match xs with
  | .str s => listOf (splitText s (← strv (arg a 0)))
  | _ => cm xs "split" a
def m_trim (xs : Value) : IO Value := match xs with | .str s => pure (.str (trimText s)) | _ => gm xs "trim"
def m_upper (xs : Value) : IO Value := match xs with | .str s => pure (.str s.toUpper) | _ => gm xs "upper"
def m_lower (xs : Value) : IO Value := match xs with | .str s => pure (.str s.toLower) | _ => gm xs "lower"
def m_lines (xs : Value) : IO Value := match xs with | .str s => listOf (splitText s "\n") | _ => gm xs "lines"
def m_contains (xs : Value) (a : Array Value) : IO Value := if core xs then contains xs (arg a 0) else cm xs "contains" a
def m_index_of (xs : Value) (a : Array Value) : IO Value := if core xs then indexOf xs (arg a 0) else cm xs "index_of" a
def m_join (xs : Value) (a : Array Value) : IO Value := if core xs then joinOf xs (arg a 0) else cm xs "join" a
def m_first (xs : Value) : IO Value := if core xs then firstOf xs else gm xs "first"
def m_last (xs : Value) : IO Value := if core xs then lastOf xs else gm xs "last"
def m_empty (xs : Value) : IO Value := do
  if core xs then return vb (num (← lenOf xs) == 0) else gm xs "empty"
def m_take (xs : Value) (a : Array Value) : IO Value := do
  if !core xs then return (← cm xs "take" a)
  let n := arg a 0
  let k := (toIndex n).toNat
  match xs with
  | .str s => return .str (String.ofList (s.toList.take k))
  | _ => listOf ((← itemsv xs).extract 0 k)
def m_drop (xs : Value) (a : Array Value) : IO Value := do
  if !core xs then return (← cm xs "drop" a)
  let n := arg a 0
  let k := (toIndex n).toNat
  match xs with
  | .str s => return .str (String.ofList (s.toList.drop k))
  | _ => let l ← itemsv xs; listOf (l.extract k l.size)
def m_rest (xs : Value) : IO Value := if core xs then m_drop xs #[.num 1] else gm xs "rest"
def m_concat (xs : Value) (a : Array Value) : IO Value := do
  if !core xs then return (← cm xs "concat" a)
  let ys := arg a 0
  match xs with
  | .str s => return .str (s ++ (← strv ys))
  | _ => listOf ((← itemsv xs) ++ (← itemsv ys))
def m_reverse (xs : Value) : IO Value := do
  if !core xs then return (← gm xs "reverse")
  match xs with
  | .str s => return .str (String.ofList s.toList.reverse)
  | _ => listOf (← itemsv xs).reverse
def m_sum (xs : Value) : IO Value := if core xs then summed xs else gm xs "sum"
def m_most (xs : Value) (a : Array Value) : IO Value := if core xs then most xs (arg a 0) else cm xs "most" a
def m_sorted_by (xs : Value) (a : Array Value) : IO Value := if core xs then sortedBy xs (arg a 0) else cm xs "sorted_by" a
def m_each (xs : Value) : IO Value := do if core xs then return .many (← itemsv xs) else gm xs "each"
def m_quoted (xs : Value) : IO Value := quoted xs
def numOp (x : Value) (name : String) (f : Float → Float) : IO Value :=
  if arith x then pure (.num (f (num x))) else gm x name
def m_sqrt (x : Value) : IO Value := numOp x "sqrt" Float.sqrt
def m_floor (x : Value) : IO Value := numOp x "floor" Float.floor
def m_abs (x : Value) : IO Value := numOp x "abs" Float.abs
def m_magnitude (x : Value) : IO Value := numOp x "magnitude" Float.abs
def m_cos (x : Value) : IO Value := numOp x "cos" Float.cos
def m_sin (x : Value) : IO Value := numOp x "sin" Float.sin
def m_round (x : Value) : IO Value := numOp x "round" fun v => Float.floor (v + 0.5)
def m_ln (x : Value) : IO Value := numOp x "ln" Float.log
def m_exp (x : Value) : IO Value := numOp x "exp" Float.exp
def m_atan2 (x : Value) (a : Array Value) : IO Value := if arith x then pure (.num (Float.atan2 (num x) (num (arg a 0)))) else cm x "atan2" a
def m_pow (x : Value) (a : Array Value) : IO Value := if arith x then pure (.num (Float.pow (num x) (num (arg a 0)))) else cm x "pow" a

-- --- for the user: a number, a text, a list, as Lean values ---------------------------------------------------
def Value.toFloat (v : Value) : Float := Rt.num v
def Value.toList (v : Value) : IO (Array Value) := itemsv v
def Value.toText (v : Value) : IO String := strv v
instance : Coe Float Value := ⟨.num⟩
instance : Coe String Value := ⟨.str⟩
instance : Coe Bool Value := ⟨.bool⟩
def kw (n : String) (v : Value) : Value := .kw n v

@[inline] def smV (t : Value) (n : String) (v : Value) : IO Value := do sm t n v; return .null
@[inline] def tern (c : Value) (a b : IO Value) : IO Value := if truthy c then a else b
/-- a number with two decimals, for timings -/
def fixed2 (x : Float) : String :=
  let c := (x * 100).round.toUInt64.toNat
  let r := c % 100
  toString (c / 100) ++ "." ++ (if r < 10 then "0" else "") ++ toString r

end Rt
