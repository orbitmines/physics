  parent : Option Nat := none
  defined : Bool := false
  fields : HashMap String (Option Default) := {}
  order : Array String := #[]
  methods : HashMap String Member := {}
  getters : HashMap String Member := {}
  statics : HashMap String Member := {}
  staticDefaults : HashMap String Default := {}
  staticOrder : Array String := #[]

instance : Inhabited ClsData := ⟨{ name := "" }⟩

initialize classesRef : IO.Ref (Array ClsData) ← IO.mkRef #[{ name := "Node", defined := true }]
initialize classIndexRef : IO.Ref (HashMap String Nat) ← IO.mkRef (({} : HashMap String Nat).insert "Node" 0)
initialize staticSlotsRef : IO.Ref (HashMap (Nat × String) Value) ← IO.mkRef {}
initialize theoriesRef : IO.Ref (HashMap String Value) ← IO.mkRef {}
initialize globalsRef : IO.Ref (HashMap String (IO Value)) ← IO.mkRef {}
initialize globalValuesRef : IO.Ref (HashMap String Value) ← IO.mkRef {}
initialize objCounter : IO.Ref Nat ← IO.mkRef 1
/-- what a member name is on an object of a class, read once: the nearest class up the chain declaring it decides -/
inductive Res where
