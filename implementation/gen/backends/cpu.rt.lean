  let mut k := some i
  let mut guard := 0
  while guard < 1000 do
    match k with
    | none => break
    | some j =>
      out := out.push j
      k := (← clsData j).parent
      guard := guard + 1
  chainCache.modify (·.insert i out)
  return out

def isA (i c : Nat) : IO Bool := do return (← chain i).contains c

def findStatic (c : Nat) (n : String) : IO (Option Member) := do
  for k in (← chain c) do
    if let some m := (← clsData k).statics[n]? then return some m
  return none
def findStaticField (c : Nat) (n : String) : IO (Option Nat) := do
  let slots ← staticSlotsRef.get
  for k in (← chain c) do
    if (← clsData k).staticDefaults.contains n || slots.contains (k, n) then return some k
  return none

/-- the nearest class up the chain with a member of this name decides what it is - as a prototype chain does;
a name no class declares is read as a static field, if one is -/
def resolveObj (c : Nat) (n : String) : IO Res := do
  if let some r := (← objCache.get)[(c, n)]? then return r
  let mut found := Res.none
  let mut done := false
  for k in (← chain c) do
    let d ← clsData k
    if let some g := d.getters[n]? then
      found := .getter g; done := true; break
    if let some f := d.fields[n]? then
      found := .field f; done := true; break
    if let some m := d.methods[n]? then
      found := .method m; done := true; break
  if !done then
    if let some k ← findStaticField c n then found := .staticField k
  objCache.modify (·.insert (c, n) found)
  return found
/-- a member of a class itself: a static field, or a static method -/
def resolveCls (c : Nat) (n : String) : IO Res := do
  if let some r := (← clsCache.get)[(c, n)]? then return r
  let found ← match ← findStaticField c n with
    | some k => pure (Res.staticField k)
    | none => do
      match ← findStatic c n with
      | some m => pure (Res.staticMethod m)
      | none => pure Res.none
  clsCache.modify (·.insert (c, n) found)
  return found
def findMethod (c : Nat) (n : String) : IO (Option Member) := do
  match ← resolveObj c n with
  | .method m => return some m
  | _ => return none

