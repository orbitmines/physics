/-- a program: every lambda and method takes its arguments as one array -/
abbrev Fn := Array Value → IO Value
/-- a member of a class: the object it is read on, and the arguments -/
abbrev Member := Value → Array Value → IO Value
/-- a field's default, made on first read, off the object -/
