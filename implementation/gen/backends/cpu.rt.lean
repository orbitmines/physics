  boolean) and the operators of Ray are in Lean.

  Lean has no dynamic members, so a Ray object is an `Obj`: its class (a table of fields, methods and statics,
  with a parent, kept in one registry and reached by its number) and its own slots. A member is reached by name -
  `gm x "cells"`, `cm x "add" #[...]`, `sm x "tag" v` - as every other language reaches it. A value is one of:
  null, a number (every number a Float, as in the bootstrap), a boolean, a text, a list (shared and mutable), a
  program, an object, a class, a Many or a named argument. Everything runs in `IO`: a list, an object and a local
  are cells.
-/
namespace Rt
open Std

set_option linter.unusedVariables false

/-- what a list, an object or a program is held by inside a `Value`: a pointer, so that `Value` stays an ordinary
inductive type while the things it points at are mutable (or take a `Value`) -/
opaque HandlePointed : NonemptyType.{0}
def Handle : Type := HandlePointed.type
instance : Nonempty Handle := HandlePointed.property

inductive Value where
  | null
  | num (x : Float)
  | bool (b : Bool)
  | str (s : String)
  | list (h : Handle)
  | obj (h : Handle)
  | fn (h : Handle)
  | cls (id : Nat)
  | many (xs : Array Value)
  | kw (name : String) (v : Value)

instance : Inhabited Value := ⟨.null⟩
/-- the two booleans, made once: a comparison returns one of them rather than a new value -/
def vTrue : Value := .bool true
def vFalse : Value := .bool false
@[inline] def vb (b : Bool) : Value := if b then vTrue else vFalse
instance : OfScientific Value := ⟨fun m s e => .num (OfScientific.ofScientific m s e)⟩
/-- a natural number as a float, by the machine (`Nat.toFloat` goes through the exact model, slowly) -/
