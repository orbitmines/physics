instance [FromValue β] : FromValue (Unit → IO β) := ⟨fun f _ => do return fromValue (← f.invoke #[])⟩
instance [ToValue α] [FromValue β] : FromValue (α → IO β) := ⟨fun f a => do return fromValue (← f.invoke #[toValue a])⟩
instance [ToValue α] [ToValue β] [FromValue γ] : FromValue (α → β → IO γ) := ⟨fun f a b => do return fromValue (← f.invoke #[toValue a, toValue b])⟩
instance [ToValue α] [ToValue β] [ToValue γ] [FromValue δ] : FromValue (α → β → γ → IO δ) := ⟨fun f a b c => do return fromValue (← f.invoke #[toValue a, toValue b, toValue c])⟩
instance : Nullable (α → IO β) := ⟨fun _ => throwMsg "None is not a program", fun _ => false⟩
instance : Nullable (α → β → IO γ) := ⟨fun _ _ => throwMsg "None is not a program", fun _ => false⟩
instance : Nullable (α → β → γ → IO δ) := ⟨fun _ _ _ => throwMsg "None is not a program", fun _ => false⟩
instance : Nullable (IO β) := ⟨throwMsg "None is not a program", fun _ => false⟩

/-- a typed value where a `Value` is asked for, and back: Lean puts these in itself -/
instance [ToValue α] : CoeOut α Value := ⟨toValue⟩
instance [FromValue α] : CoeTail Value α := ⟨fromValue⟩
instance : OfScientific Value := ⟨fun m s e => .num (OfScientific.ofScientific m s e)⟩

-- --- truth, text ---------------------------------------------------------------------------------------------
class Truthy (α : Type) where
  truthy : α → Bool
export Truthy (truthy)
instance : Truthy Bool := ⟨id⟩
instance : Truthy Float := ⟨fun x => !(x == 0 || x.isNaN || x.toBits == nullBits)⟩
instance : Truthy String := ⟨fun s => !s.isEmpty && s != nullStr⟩
instance : Truthy Value := ⟨fromValue⟩
instance : Truthy (RList α) := ⟨fun l => !isNull l⟩
instance : Truthy RMap := ⟨fun m => !isNull m⟩
instance : Truthy (Cls n) := ⟨fun _ => true⟩
instance : Truthy (Many α) := ⟨fun _ => true⟩
instance : Truthy (α → IO β) := ⟨fun _ => true⟩
instance : Truthy (α → β → IO γ) := ⟨fun _ => true⟩

/-- the objects of a class hierarchy: what every hierarchy's type has, however it is named -/
class IsObj (α : Type) where
  obj : α → Obj
  ofObj : Obj → α

instance (priority := low) [IsObj α] : Truthy α := ⟨fun x => (IsObj.obj x).id != 0⟩

mutual
partial def Value.text : Value → IO String
  | .null => return "null"
  | .num x => return jsNumber x
  | .bool b => return if b then "true" else "false"
  | .str s => return s
  | .list h => do
    let xs ← (Value.dl h).get
    let mut out := ""
    let mut first := true
    for x in xs do
      if !first then out := out ++ ","
      first := false
      out := out ++ (← match x with | .null => pure "" | v => v.text)
    return out
  | .obj o => do
    if o.id == 0 then return "null"
    match ← ωdynOf o.cls "toString" with
    | some f => (← f o #[]).text
    | none => return "[object " ++ o.cls.name ++ "]"
  | .fn _ => return "[program]"
  | .map _ => return "[object Object]"
  | .cls n => return n
  | .many xs => do return s!"Many({xs.size})"
end

class ToStr (α : Type) where
  toStr : α → IO String
export ToStr (toStr)
instance : ToStr String := ⟨fun s => pure (if s == nullStr then "null" else s)⟩
instance : ToStr Float := ⟨fun x => pure (jsNumber x)⟩
instance : ToStr Bool := ⟨fun b => pure (if b then "true" else "false")⟩
instance : ToStr Value := ⟨Value.text⟩
instance (priority := low) [ToValue α] : ToStr α := ⟨fun x => (toValue x).text⟩

-- --- None, Many ------------------------------------------------------------------------------------------------
@[inline] def orElse [Nullable α] (a : α) (b : IO α) : IO α := if isNull a then b else pure a
@[inline] def tern (c : Bool) (a b : IO α) : IO α := if c then a else b
@[inline] def wr (r : IO.Ref α) (v : α) : IO Unit := r.set v
@[inline] def sink (_ : α) : IO Unit := pure ()
def ωmany [ToValue α] (xs : RList α) : IO (Many α) := do return ⟨← xs.get⟩

/-- equal things collapse: a superposition of one and the same thing is that thing, once -/
def Many.collapse (xs : Array α) : Many α :=
  match xs[0]? with
  | none => ⟨xs⟩
  | some f => if xs.all (same · f) then ⟨#[f]⟩ else ⟨xs⟩

-- --- members by name ------------------------------------------------------------------------------------------
class Get (α : Type) (n : String) (β : outParam Type) where
  get : α → IO β
class Set' (α : Type) (n : String) (β : outParam Type) where
  set : α → β → IO Unit
class Call0 (α : Type) (n : String) (β : outParam Type) where
  call : α → IO β
class Call1 (α : Type) (n : String) (A : outParam Type) (β : outParam Type) where
  call : α → A → IO β
class Call2 (α : Type) (n : String) (A B : outParam Type) (β : outParam Type) where
  call : α → A → B → IO β
class Call3 (α : Type) (n : String) (A B C : outParam Type) (β : outParam Type) where
  call : α → A → B → C → IO β
class Call4 (α : Type) (n : String) (A B C D : outParam Type) (β : outParam Type) where
  call : α → A → B → C → D → IO β
class Call5 (α : Type) (n : String) (A B C D E : outParam Type) (β : outParam Type) where
  call : α → A → B → C → D → E → IO β
class Call6 (α : Type) (n : String) (A B C D E F : outParam Type) (β : outParam Type) where
  call : α → A → B → C → D → E → F → IO β
class Call7 (α : Type) (n : String) (A B C D E F G : outParam Type) (β : outParam Type) where
  call : α → A → B → C → D → E → F → G → IO β
class Call8 (α : Type) (n : String) (A B C D E F G H : outParam Type) (β : outParam Type) where
  call : α → A → B → C → D → E → F → G → H → IO β

/- what a member is, the object's type decides - not the place it is put: the result is then made what the place asks (a
`Value` read where a number is asked is read as one) -/
@[inline, elab_without_expected_type] def get (x : α) (n : String) [i : Get α n β] : IO β := i.get x
/-- `setter x "tag"`: the program that sets the member; applied to the value after, so the value is made what the member is -/
@[inline, elab_without_expected_type] def setter (x : α) (n : String) [i : Set' α n β] : β → IO Unit := i.set x
@[inline, elab_without_expected_type] def getOpt [Nullable α] [Nullable β] (x : α) (n : String) [i : Get α n β] : IO β :=
  if isNull x then pure null else i.get x

-- a `Value` has every member, looked up by name when it runs
partial def Value.dynGet (v : Value) (n : String) : IO Value := do
  match v with
  | .obj o =>
    if o.id == 0 then throwMsg s!"no member {n} on None"
    match ← ωdynOf o.cls n with
    | some f => f o #[]
    | none => throwMsg s!"no member {n} on {o.cls.name}"
  | .cls c =>
    match (← theoriesRef.get)[c]? with
    | some t => (← t).dynGet n
    | none =>
      match ← ωdynStaticOf (← ωclassNamed c) n with
      | some f => f #[]
      | none => return .null
  | .many xs => return .many (← xs.mapM fun x => match x with | .null => pure Value.null | x => x.dynGet n)
  | .map h => (ofHandle h : RMap).get n
  | .list h => if n == "length" then return .num (natF (← (Value.dl h).get).size) else throwMsg s!"no member {n} on a list"
  | .str s => if n == "length" then return .num (natF s.length) else throwMsg s!"no member {n} on a text"
  | .null => throwMsg s!"no member {n} on None"
  | _ => throwMsg s!"no member {n} on {← v.text}"
partial def Value.dynCall (v : Value) (n : String) (a : Array Value) : IO Value := do
  match v with
  | .obj o =>
    if o.id == 0 then throwMsg s!"no method {n} on None"
    match ← ωdynOf o.cls n with
    | some f => f o a
    | none => throwMsg s!"no method {n} on {o.cls.name}"
  | .cls c =>
    match (← theoriesRef.get)[c]? with
    | some t => (← t).dynCall n a
    | none =>
      match ← ωdynStaticOf (← ωclassNamed c) n with
      | some f => f a
      | none => throwMsg s!"no static {n} on {c}"
  | .many xs => return .many (← xs.mapM fun x => x.dynCall n a)
  | .map h => ((ofHandle h : RMap).get n) >>= fun f => f.invoke a
  | .null => throwMsg s!"no method {n} on None"
  | _ => throwMsg s!"no method {n} on {← v.text}"
partial def Value.dynSet (v : Value) (n : String) (x : Value) : IO Unit := do
  match v with
  | .obj o =>
    match ← ωdynSetOf o.cls n with
    | some f => f o x
    | none => throwMsg s!"no member {n} to set on {o.cls.name}"
  | .map h => (ofHandle h : RMap).set n x
  | .many xs => for y in xs do y.dynSet n x
  | _ => throwMsg s!"no member {n} to set on {← v.text}"

instance : Get Value n Value := ⟨fun v => v.dynGet n⟩
instance : Set' Value n Value := ⟨fun v x => v.dynSet n x⟩
instance : Call0 Value n Value := ⟨fun v => v.dynCall n #[]⟩
instance : Call1 Value n Value Value := ⟨fun v a => v.dynCall n #[a]⟩
instance : Call2 Value n Value Value Value := ⟨fun v a b => v.dynCall n #[a, b]⟩
instance : Call3 Value n Value Value Value Value := ⟨fun v a b c => v.dynCall n #[a, b, c]⟩
instance : Call4 Value n Value Value Value Value Value := ⟨fun v a b c d => v.dynCall n #[a, b, c, d]⟩
instance : Call5 Value n Value Value Value Value Value Value := ⟨fun v a b c d e => v.dynCall n #[a, b, c, d, e]⟩
instance : Call6 Value n Value Value Value Value Value Value Value := ⟨fun v a b c d e f => v.dynCall n #[a, b, c, d, e, f]⟩
instance : Get RMap n Value := ⟨fun m => m.get n⟩
instance : Set' RMap n Value := ⟨fun m v => m.set n v⟩

-- a superposition: every member of every element, alike ones collapsed
instance [Get α n β] : Get (Many α) n (Many β) := ⟨fun m => do return Many.collapse (← m.items.mapM (Get.get n))⟩
instance [Call0 α n β] : Call0 (Many α) n (Many β) := ⟨fun m => do return Many.collapse (← m.items.mapM (Call0.call n))⟩
instance [Call1 α n A β] : Call1 (Many α) n A (Many β) := ⟨fun m a => do return Many.collapse (← m.items.mapM (Call1.call n · a))⟩
instance [Set' α n β] : Set' (Many α) n β := ⟨fun m v => do for x in m.items do Set'.set n x v⟩

@[inline, elab_without_expected_type] def caller0 (x : α) (n : String) [i : Call0 α n β] : IO β := i.call x
@[inline, elab_without_expected_type] def caller1 {A : Type} (x : α) (n : String) [i : Call1 α n A β] : A → IO β := i.call x
@[inline, elab_without_expected_type] def caller2 {A B : Type} (x : α) (n : String) [i : Call2 α n A B β] : A → B → IO β := i.call x
@[inline, elab_without_expected_type] def caller3 {A B C : Type} (x : α) (n : String) [i : Call3 α n A B C β] : A → B → C → IO β := i.call x
@[inline, elab_without_expected_type] def caller4 {A B C D : Type} (x : α) (n : String) [i : Call4 α n A B C D β] : A → B → C → D → IO β := i.call x
@[inline, elab_without_expected_type] def caller5 {A B C D E : Type} (x : α) (n : String) [i : Call5 α n A B C D E β] : A → B → C → D → E → IO β := i.call x
@[inline, elab_without_expected_type] def caller6 {A B C D E F : Type} (x : α) (n : String) [i : Call6 α n A B C D E F β] : A → B → C → D → E → F → IO β := i.call x
@[inline, elab_without_expected_type] def caller7 {A B C D E F G : Type} (x : α) (n : String) [i : Call7 α n A B C D E F G β] : A → B → C → D → E → F → G → IO β := i.call x
@[inline, elab_without_expected_type] def caller8 {A B C D E F G H : Type} (x : α) (n : String) [i : Call8 α n A B C D E F G H β] : A → B → C → D → E → F → G → H → IO β := i.call x

/-- `call! x "name" (a, b)`: a member called with its arguments, however many - the member found first, so that each
argument is made what the member asks -/
syntax "call! " term:max str "(" term,* ")" : term
macro_rules
  | `(call! $x $n ()) => `(caller0 $x $n)
  | `(call! $x $n ($a)) => `((caller1 $x $n) $a)
  | `(call! $x $n ($a, $b)) => `((caller2 $x $n) $a $b)
  | `(call! $x $n ($a, $b, $c)) => `((caller3 $x $n) $a $b $c)
  | `(call! $x $n ($a, $b, $c, $d)) => `((caller4 $x $n) $a $b $c $d)
  | `(call! $x $n ($a, $b, $c, $d, $e)) => `((caller5 $x $n) $a $b $c $d $e)
  | `(call! $x $n ($a, $b, $c, $d, $e, $f)) => `((caller6 $x $n) $a $b $c $d $e $f)
  | `(call! $x $n ($a, $b, $c, $d, $e, $f, $g)) => `((caller7 $x $n) $a $b $c $d $e $f $g)
  | `(call! $x $n ($a, $b, $c, $d, $e, $f, $g, $h)) => `((caller8 $x $n) $a $b $c $d $e $f $g $h)
/-- `callOpt! x "name" (a)`: the same, unless `x` is None -/
syntax "callOpt! " term:max str "(" term,* ")" : term
macro_rules
  | `(callOpt! $x $n ($as,*)) => `(if isNull $x then pure null else call! $x $n ($as,*))

-- programs called: a typed function, or a `Value`
class Invoke0 (F : Type) (β : outParam Type) where
  inv : F → IO β
class Invoke1 (F : Type) (A : outParam Type) (β : outParam Type) where
  inv : F → A → IO β
class Invoke2 (F : Type) (A B : outParam Type) (β : outParam Type) where
  inv : F → A → B → IO β
class Invoke3 (F : Type) (A B C : outParam Type) (β : outParam Type) where
  inv : F → A → B → C → IO β
instance : Invoke0 (Unit → IO β) β := ⟨fun f => f ()⟩
instance : Invoke0 (IO β) β := ⟨id⟩
instance : Invoke1 (α → IO β) α β := ⟨id⟩
instance : Invoke2 (α → β → IO γ) α β γ := ⟨id⟩
instance : Invoke3 (α → β → γ → IO δ) α β γ δ := ⟨id⟩
instance : Invoke0 Value Value := ⟨fun f => f.invoke #[]⟩
instance : Invoke1 Value Value Value := ⟨fun f a => f.invoke #[a]⟩
instance : Invoke2 Value Value Value Value := ⟨fun f a b => f.invoke #[a, b]⟩
instance : Invoke3 Value Value Value Value Value := ⟨fun f a b c => f.invoke #[a, b, c]⟩
@[inline, elab_without_expected_type] def invoker0 (f : F) [i : Invoke0 F β] : IO β := i.inv f
@[inline, elab_without_expected_type] def invoker1 {F A : Type} (f : F) [i : Invoke1 F A β] : A → IO β := i.inv f
@[inline, elab_without_expected_type] def invoker2 {F A B : Type} (f : F) [i : Invoke2 F A B β] : A → B → IO β := i.inv f
@[inline, elab_without_expected_type] def invoker3 {F A B C : Type} (f : F) [i : Invoke3 F A B C β] : A → B → C → IO β := i.inv f
syntax "app! " term:max "(" term,* ")" : term
macro_rules
  | `(app! $f ()) => `(invoker0 $f)
  | `(app! $f ($a)) => `((invoker1 $f) $a)
  | `(app! $f ($a, $b)) => `((invoker2 $f) $a $b)
  | `(app! $f ($a, $b, $c)) => `((invoker3 $f) $a $b $c)

-- lambdas: a typed function where one is asked for, a `Value` where Ray has a `Program`
class Lam0 (F : Type) (β : outParam Type) where
  lam : (Unit → IO β) → F
class Lam1 (F : Type) (A : outParam Type) (β : outParam Type) where
  lam : (A → IO β) → F
class Lam2 (F : Type) (A B : outParam Type) (β : outParam Type) where
  lam : (A → B → IO β) → F
class Lam3 (F : Type) (A B C : outParam Type) (β : outParam Type) where
  lam : (A → B → C → IO β) → F
class Lam4 (F : Type) (A B C D : outParam Type) (β : outParam Type) where
  lam : (A → B → C → D → IO β) → F
class Lam5 (F : Type) (A B C D E : outParam Type) (β : outParam Type) where
  lam : (A → B → C → D → E → IO β) → F
@[default_instance] instance : Lam0 (Unit → IO β) β := ⟨id⟩
instance : Lam0 (IO β) β := ⟨fun f => f ()⟩
@[default_instance] instance : Lam1 (α → IO β) α β := ⟨id⟩
@[default_instance] instance : Lam2 (α → β → IO γ) α β γ := ⟨id⟩
@[default_instance] instance : Lam3 (α → β → γ → IO δ) α β γ δ := ⟨id⟩
@[default_instance] instance : Lam4 (α → β → γ → δ → IO ε) α β γ δ ε := ⟨id⟩
@[default_instance] instance : Lam5 (α → β → γ → δ → ε → IO ζ) α β γ δ ε ζ := ⟨id⟩
instance : Lam0 Value Value := ⟨fun f => mkDFn fun _ => f ()⟩
instance : Lam1 Value Value Value := ⟨fun f => mkDFn fun a => f (a.getD 0 .null)⟩
instance : Lam2 Value Value Value Value := ⟨fun f => mkDFn fun a => f (a.getD 0 .null) (a.getD 1 .null)⟩
instance : Lam3 Value Value Value Value Value := ⟨fun f => mkDFn fun a => f (a.getD 0 .null) (a.getD 1 .null) (a.getD 2 .null)⟩
instance : Lam4 Value Value Value Value Value Value := ⟨fun f => mkDFn fun a => f (a.getD 0 .null) (a.getD 1 .null) (a.getD 2 .null) (a.getD 3 .null)⟩
instance : Lam5 Value Value Value Value Value Value Value := ⟨fun f => mkDFn fun a => f (a.getD 0 .null) (a.getD 1 .null) (a.getD 2 .null) (a.getD 3 .null) (a.getD 4 .null)⟩

/-- a parameter as Ray writes one: its name, and its type where Ray says it -/
declare_syntax_cat rayParam
syntax "(" ident " : " term (" := " term)? ")" : rayParam
syntax ident : rayParam

def rayParamName : Lean.TSyntax `rayParam → Lean.MacroM Lean.Ident
  | `(rayParam| ($x : $_t $[:= $_d]?)) => pure x
  | `(rayParam| $x:ident) => pure x
  | _ => Lean.Macro.throwUnsupported

/-- `fn! [x y] do ...`: a Ray lambda - its parameters cells of their own, so a lambda inside may write them -/
syntax "fn! " "[" rayParam* "]" term : term
macro_rules
  | `(fn! [$ps*] $body) => do
    let names ← ps.mapM rayParamName
    let mut b : Lean.TSyntax `term := body
    for x in names.reverse do
      b ← `(do let $x:ident ← IO.mkRef $x:ident; ($b))
    -- the lambda is read last (`by exact`): by then the place it is put has said what it is - a typed program, or a `Value`
    match names.size with
    | 0 => `(Lam0.lam (by exact fun (_ : Unit) => $b))
    | 1 => `(Lam1.lam (by exact fun $(names[0]!) => $b))
    | 2 => `(Lam2.lam (by exact fun $(names[0]!) $(names[1]!) => $b))
    | 3 => `(Lam3.lam (by exact fun $(names[0]!) $(names[1]!) $(names[2]!) => $b))
    | 4 => `(Lam4.lam (by exact fun $(names[0]!) $(names[1]!) $(names[2]!) $(names[3]!) => $b))
    | 5 => `(Lam5.lam (by exact fun $(names[0]!) $(names[1]!) $(names[2]!) $(names[3]!) $(names[4]!) => $b))
    | _ => Lean.Macro.throwError "a lambda of more than five parameters"

-- --- operators ----------------------------------------------------------------------------------------------------
class Add2 (α β : Type) (γ : outParam Type) where
  add : α → β → IO γ
class Sub2 (α β : Type) (γ : outParam Type) where
  sub : α → β → IO γ
class Mul2 (α β : Type) (γ : outParam Type) where
  mul : α → β → IO γ
class Div2 (α β : Type) (γ : outParam Type) where
  div : α → β → IO γ
class Mod2 (α β : Type) (γ : outParam Type) where
  mod : α → β → IO γ
class Pow2 (α β : Type) (γ : outParam Type) where
  pow : α → β → IO γ
class Neg1 (α : Type) (γ : outParam Type) where
  neg : α → IO γ
class Cmp2 (α β : Type) where
  lt : α → β → IO Bool
  le : α → β → IO Bool
  gt : α → β → IO Bool
  ge : α → β → IO Bool
class Eq2 (α β : Type) where
  eq : α → β → IO Bool
@[inline, elab_without_expected_type] def add [Add2 α β γ] (a : α) (b : β) : IO γ := Add2.add a b
@[inline, elab_without_expected_type] def sub [Sub2 α β γ] (a : α) (b : β) : IO γ := Sub2.sub a b
@[inline, elab_without_expected_type] def mul [Mul2 α β γ] (a : α) (b : β) : IO γ := Mul2.mul a b
@[inline, elab_without_expected_type] def div [Div2 α β γ] (a : α) (b : β) : IO γ := Div2.div a b
@[inline, elab_without_expected_type] def modv [Mod2 α β γ] (a : α) (b : β) : IO γ := Mod2.mod a b
@[inline, elab_without_expected_type] def pow [Pow2 α β γ] (a : α) (b : β) : IO γ := Pow2.pow a b
@[inline, elab_without_expected_type] def neg [Neg1 α γ] (a : α) : IO γ := Neg1.neg a
@[inline] def lt [Cmp2 α β] (a : α) (b : β) : IO Bool := Cmp2.lt a b
@[inline] def le [Cmp2 α β] (a : α) (b : β) : IO Bool := Cmp2.le a b
@[inline] def gt [Cmp2 α β] (a : α) (b : β) : IO Bool := Cmp2.gt a b
@[inline] def ge [Cmp2 α β] (a : α) (b : β) : IO Bool := Cmp2.ge a b
@[inline] def eqv [Eq2 α β] (a : α) (b : β) : IO Bool := Eq2.eq a b
@[inline] def nev [Eq2 α β] (a : α) (b : β) : IO Bool := do return !(← Eq2.eq a b)
@[inline] def andV [Truthy α] [Truthy β] (a : α) (b : IO β) : IO Bool := do if truthy a then return truthy (← b) else return false
@[inline] def orV [Truthy α] [Truthy β] (a : α) (b : IO β) : IO Bool := do if truthy a then return true else return truthy (← b)
@[inline] def notV [Truthy α] (a : α) : Bool := !truthy a

@[extern "fmod"] opaque fmod : Float → Float → Float

instance : Add2 Float Float Float := ⟨fun a b => pure (a + b)⟩
instance : Sub2 Float Float Float := ⟨fun a b => pure (a - b)⟩
instance : Mul2 Float Float Float := ⟨fun a b => pure (a * b)⟩
instance : Div2 Float Float Float := ⟨fun a b => pure (if b == 0 && a == 0 then 0 else a / b)⟩
instance : Mod2 Float Float Float := ⟨fun a b => pure (fmod a b)⟩
instance : Pow2 Float Float Float := ⟨fun a b => pure (Float.pow a b)⟩
instance : Neg1 Float Float := ⟨fun a => pure (-a)⟩
instance : Cmp2 Float Float := ⟨fun a b => pure (a < b), fun a b => pure (a ≤ b), fun a b => pure (a > b), fun a b => pure (a ≥ b)⟩
instance : Eq2 Float Float := ⟨fun a b => pure (a == b || (isNull a && isNull b))⟩
instance : Eq2 Bool Bool := ⟨fun a b => pure (a == b)⟩
instance : Eq2 String String := ⟨fun a b => pure (a == b)⟩
instance : Cmp2 String String := ⟨fun a b => pure (a < b), fun a b => pure (a ≤ b), fun a b => pure (a > b), fun a b => pure (a ≥ b)⟩
instance [ToStr β] : Add2 String β String := ⟨fun a b => do return (← toStr a) ++ (← toStr b)⟩
instance : Add2 Float String String := ⟨fun a b => do return jsNumber a ++ (← toStr b)⟩
instance : Eq2 (Cls n) (Cls m) := ⟨fun _ _ => pure (n == m)⟩
instance : Eq2 RMap RMap := ⟨fun a b => pure (same a.ref b.ref)⟩

mutual
partial def Value.eq (a b : Value) : IO Bool := do
  match a, b with
  | .null, .null => return true
  | .null, _ => return false
  | _, .null => return false
  | .many xs, _ => do
    for x in xs do if !(← x.eq b) then return false
    return true
  | .num x, .num y => return x == y
  | .bool x, .bool y => return x == y
  | .str x, .str y => return x == y
  | .list x, .list y =>
    let dx := Value.dl x
    let dy := Value.dl y
    if same dx.raw dy.raw then return true
    let xs ← dx.get
    let ys ← dy.get
    if xs.size != ys.size then return false
    for i in [0:xs.size] do if !(← xs[i]!.eq ys[i]!) then return false
    return true
  | .obj x, _ =>
    if let .obj y := b then if x.id == y.id then return true
    match ← ωdynOf x.cls "equals" with
    | some f => return fromValue (← f x #[b])
    | none => return false
  | .fn x, .fn y => return same x y
  | .map x, .map y => return same x y
  | .cls x, .cls y => return x == y
  | _, _ => return false
end
partial def Value.cmp (a b : Value) (op : String) : IO Bool := do
  match a, b with
  | .str x, .str y => return match op with | "lt" => x < y | "le" => x ≤ y | "gt" => x > y | _ => x ≥ y
  | .obj _, _ => return fromValue (← a.dynCall op #[b])
  | _, _ =>
    let x := a.toNum
    let y := b.toNum
    return match op with | "lt" => x < y | "le" => x ≤ y | "gt" => x > y | _ => x ≥ y
partial def Value.arith (a b : Value) (op : String) : IO Value := do
  match a, b, op with
  | .str x, _, "plus" => return .str (x ++ (← b.text))
  | _, .str y, "plus" => match a with
    | .obj _ => a.dynCall op #[b]
    | _ => return .str ((← a.text) ++ y)
  | .obj _, _, _ => a.dynCall op #[b]
  | _, _, _ =>
    let x := a.toNum
    let y := b.toNum
    return .num (match op with
      | "plus" => x + y | "minus" => x - y | "times" => x * y
      | "over" => if y == 0 && x == 0 then 0 else x / y
      | "mod" => fmod x y | _ => Float.pow x y)

instance : Eq2 Value Value := ⟨Value.eq⟩
instance : Cmp2 Value Value := ⟨(Value.cmp · · "lt"), (Value.cmp · · "le"), (Value.cmp · · "gt"), (Value.cmp · · "ge")⟩
instance : Add2 Value Value Value := ⟨(Value.arith · · "plus")⟩
instance : Sub2 Value Value Value := ⟨(Value.arith · · "minus")⟩
instance : Mul2 Value Value Value := ⟨(Value.arith · · "times")⟩
instance : Div2 Value Value Value := ⟨(Value.arith · · "over")⟩
instance : Mod2 Value Value Value := ⟨(Value.arith · · "mod")⟩
instance : Pow2 Value Value Value := ⟨(Value.arith · · "pow")⟩
instance : Neg1 Value Value := ⟨fun a => match a with | .obj _ => a.dynGet "negated" | a => pure (.num (-a.toNum))⟩
-- a typed value against a `Value`: as values
instance (priority := low) [ToValue α] : Eq2 α Value := ⟨fun a b => (toValue a).eq b⟩
instance (priority := low) [ToValue α] : Eq2 Value α := ⟨fun a b => a.eq (toValue b)⟩
instance (priority := low) [ToValue α] : Cmp2 α Value := ⟨fun a b => (toValue a).cmp b "lt", fun a b => (toValue a).cmp b "le", fun a b => (toValue a).cmp b "gt", fun a b => (toValue a).cmp b "ge"⟩
instance (priority := low) [ToValue α] : Cmp2 Value α := ⟨fun a b => a.cmp (toValue b) "lt", fun a b => a.cmp (toValue b) "le", fun a b => a.cmp (toValue b) "gt", fun a b => a.cmp (toValue b) "ge"⟩
instance (priority := low) [ToValue α] : Add2 α Value Value := ⟨fun a b => (toValue a).arith b "plus"⟩
instance (priority := low) [ToValue α] : Add2 Value α Value := ⟨fun a b => a.arith (toValue b) "plus"⟩
instance (priority := low) [ToValue α] : Sub2 α Value Value := ⟨fun a b => (toValue a).arith b "minus"⟩
instance (priority := low) [ToValue α] : Sub2 Value α Value := ⟨fun a b => a.arith (toValue b) "minus"⟩
instance (priority := low) [ToValue α] : Mul2 α Value Value := ⟨fun a b => (toValue a).arith b "times"⟩
instance (priority := low) [ToValue α] : Mul2 Value α Value := ⟨fun a b => a.arith (toValue b) "times"⟩
instance (priority := low) [ToValue α] : Div2 α Value Value := ⟨fun a b => (toValue a).arith b "over"⟩
instance (priority := low) [ToValue α] : Div2 Value α Value := ⟨fun a b => a.arith (toValue b) "over"⟩
instance (priority := low) [ToValue α] : Mod2 Value α Value := ⟨fun a b => a.arith (toValue b) "mod"⟩
instance (priority := low) [ToValue α] : Mod2 α Value Value := ⟨fun a b => (toValue a).arith b "mod"⟩
instance (priority := low) [ToValue α] : Pow2 Value α Value := ⟨fun a b => a.arith (toValue b) "pow"⟩
instance (priority := low) [ToValue α] : Pow2 α Value Value := ⟨fun a b => (toValue a).arith b "pow"⟩
-- lists: equal when every element is
instance [Eq2 α α] : Eq2 (RList α) (RList α) := ⟨fun a b => do
  if same a.ref b.ref then return true
  let xs ← a.get
  let ys ← b.get
  if xs.size != ys.size then return false
  for x in xs, y in ys do if !(← Eq2.eq x y) then return false
  return true⟩
-- objects: an operator is the object's own member (`plus`, `times`, `equals`, `lt`, ...), else the same object
instance (priority := low) [Call1 α "plus" β γ] : Add2 α β γ := ⟨Call1.call "plus"⟩
instance (priority := low) [Call1 α "minus" β γ] : Sub2 α β γ := ⟨Call1.call "minus"⟩
instance (priority := low) [Call1 α "times" β γ] : Mul2 α β γ := ⟨Call1.call "times"⟩
instance (priority := low) [Call1 α "over" β γ] : Div2 α β γ := ⟨Call1.call "over"⟩
instance (priority := low) [Get α "negated" γ] : Neg1 α γ := ⟨Get.get "negated"⟩
instance (priority := low) [IsObj α] [IsObj β] : Eq2 α β := ⟨fun a b => do
  let x := IsObj.obj a
  let y := IsObj.obj b
  if x.id == y.id then return true
  match ← ωdynOf x.cls "equals" with
  | some f => return fromValue (← f x #[.obj y])
  | none => return false⟩
instance (priority := low) [IsObj α] : Cmp2 α α := ⟨
  fun a b => do return fromValue (← (Value.obj (IsObj.obj a)).dynCall "lt" #[.obj (IsObj.obj b)]),
  fun a b => do return fromValue (← (Value.obj (IsObj.obj a)).dynCall "le" #[.obj (IsObj.obj b)]),
  fun a b => do return fromValue (← (Value.obj (IsObj.obj a)).dynCall "gt" #[.obj (IsObj.obj b)]),
  fun a b => do return fromValue (← (Value.obj (IsObj.obj a)).dynCall "ge" #[.obj (IsObj.obj b)])⟩

/-- `x ==.instance_of Kind` -/
def instOf (x : Value) (c : String) : IO Bool := do
  match c with
  | "Array" => return match x with | .list _ => true | _ => false
  | "N" | "Natural" | "Z" | "Integer" | "Real" | "Decimal" | "Number" => return match x with | .num _ => true | _ => false
  | "String" => return match x with | .str _ => true | _ => false
  | "boolean" => return match x with | .bool _ => true | _ => false
  | _ =>
    match x with
    | .obj o =>
      let mut k := some o.cls
      while true do
        match k with
        | some c' => if c'.name == c then return true else k := c'.parent
        | none => break
      return false
    | _ => return false

-- --- elements -------------------------------------------------------------------------------------------------
class Elem (α κ : Type) (β : outParam Type) where
  elem : α → κ → IO β
class SetAt (α κ : Type) (β : outParam Type) where
  setAt : α → κ → β → IO Unit
@[inline, elab_without_expected_type] def elem [Elem α κ β] (x : α) (k : κ) : IO β := Elem.elem x k
/-- `atSetter x k`: the program that sets an element; applied to the value after, so the value is made what the element is -/
@[inline, elab_without_expected_type] def atSetter [SetAt α κ β] (x : α) (k : κ) : β → IO Unit := SetAt.setAt x k
instance [Nullable α] : Elem (RList α) Float α := ⟨fun l k => do
  let xs ← l.get
  let i := toIndex k
  let j := if i < 0 then i + xs.size else i
  return if 0 ≤ j then xs[j.toNat]?.getD null else null⟩
instance [Nullable α] : SetAt (RList α) Float α := ⟨fun l k v => do
  let i := (toIndex k).toNat
  l.ref.modify fun xs => Id.run do
    let mut ys := xs
    while ys.size ≤ i do ys := ys.push null
    return ys.set! i v⟩
instance : Elem String Float String := ⟨fun s k => do
  let cs := s.toList
  let i := toIndex k
  let j := if i < 0 then i + cs.length else i
  return if 0 ≤ j && j < cs.length then String.singleton cs[j.toNat]! else nullStr⟩
instance : Elem RMap String Value := ⟨RMap.get⟩
instance : SetAt RMap String Value := ⟨RMap.set⟩
instance [ToStr κ] : Elem RMap κ Value := ⟨fun m k => do m.get (← toStr k)⟩
instance [ToStr κ] : SetAt RMap κ Value := ⟨fun m k v => do m.set (← toStr k) v⟩
partial def Value.elem (t k : Value) : IO Value := do
  match t with
  | .null => return .null
  | .list h =>
    let xs ← (Value.dl h).get
    let i := toIndex k.toNum
    let j := if i < 0 then i + xs.size else i
    return if 0 ≤ j && j < xs.size then xs[j.toNat]! else .null
  | .str s =>
    let cs := s.toList
    let i := toIndex k.toNum
    let j := if i < 0 then i + cs.length else i
    return if 0 ≤ j && j < cs.length then .str (String.singleton cs[j.toNat]!) else .null
  | .many m => return .many (← m.mapM (·.elem k))
  | .map h => (ofHandle h : RMap).get (← k.text)
  | .obj _ | .cls _ => t.dynGet (← k.text)
  | _ => return .null
partial def Value.setAt (t k v : Value) : IO Unit := do
  match t with
  | .list h =>
    let d := Value.dl h
    let i := (toIndex k.toNum).toNat
    let n := (← d.get).size
    for _ in [n:i] do d.push .null
    if i < (← d.get).size then d.set i v else d.push v
  | .map h => (ofHandle h : RMap).set (← k.text) v
  | _ => t.dynSet (← k.text) v
instance [ToValue κ] : Elem Value κ Value := ⟨fun t k => t.elem (toValue k)⟩
instance [ToValue κ] : SetAt Value κ Value := ⟨fun t k v => t.setAt (toValue k) v⟩
instance [Nullable α] : Elem (RList α) Value α := ⟨fun l k => Elem.elem l k.toNum⟩
instance [Nullable α] : SetAt (RList α) Value α := ⟨fun l k v => SetAt.setAt l k.toNum v⟩
instance (priority := low) [IsObj α] : Elem α String Value := ⟨fun x k => (Value.obj (IsObj.obj x)).dynGet k⟩
instance (priority := low) [IsObj α] : SetAt α String Value := ⟨fun x k v => (Value.obj (IsObj.obj x)).dynSet k v⟩
instance [Elem α κ β] : Elem (Many α) κ (Many β) := ⟨fun m k => do return Many.collapse (← m.items.mapM (Elem.elem · k))⟩

-- --- loops -----------------------------------------------------------------------------------------------------
/-- what `xs.for` walks: the elements as they stand when the loop begins -/
class Items (α : Type) (β : outParam Type) where
  items : α → IO (Array β)
instance : Items (RList α) α := ⟨RList.get⟩
instance : Items (Many α) α := ⟨fun m => pure m.items⟩
instance : Items String String := ⟨fun s => pure (s.toList.toArray.map String.singleton)⟩
instance : Items Value Value := ⟨fun v => match v with
  | .list h => (Value.dl h).get
  | .many xs => pure xs
  | .str s => pure (s.toList.toArray.map fun c => .str (String.singleton c))
  | .null => pure #[]
  | _ => throwMsg "not a list"⟩
@[inline] def items [Items α β] (x : α) : IO (Array β) := Items.items x

-- --- the members Ray knows on a list, a text and a number (`xs.map(f)`: `rmap xs f`) -----------------------------
def rrange (n : Float) : IO (RList Float) := lst ((Array.range (rangeN n)).map natF)
def rfilled (n : Float) (v : α) : IO (RList α) := lst (Array.replicate (rangeN n) v)

namespace RList
def rlength (l : RList α) : IO Float := do return natF (← l.get).size
def rpush (l : RList α) (x : α) : IO (RList α) := do l.ref.modify (·.push x); return l
def rpop [Nullable α] (l : RList α) : IO α := do
  let xs ← l.get
  match xs.back? with
  | some x => l.ref.modify (·.pop); return x
  | none => return null
def rmap (l : RList α) (f : α → IO β) : IO (RList β) := do lst (← (← l.get).mapM f)
def rfilter [Truthy β] (l : RList α) (f : α → IO β) : IO (RList α) := do lst (← (← l.get).filterM fun x => do return truthy (← f x))
def rfor (l : RList α) (f : α → IO β) : IO Unit := do for x in ← l.get do discard <| f x
def rsome [Truthy β] (l : RList α) (f : α → IO β) : IO Bool := do
  for x in ← l.get do if truthy (← f x) then return true
  return false
def revery [Truthy β] (l : RList α) (f : α → IO β) : IO Bool := do
  for x in ← l.get do if !truthy (← f x) then return false
  return true
def rreduce (l : RList α) (z : β) (f : β → α → IO β) : IO β := do
  let mut acc := z
  for x in ← l.get do acc ← f acc x
  return acc
def rfirst [Nullable α] (l : RList α) : IO α := do return (← l.get)[0]?.getD null
def rlast [Nullable α] (l : RList α) : IO α := do return (← l.get).back?.getD null
def rempty (l : RList α) : IO Bool := do return (← l.get).isEmpty
def rtake (l : RList α) (n : Float) : IO (RList α) := do lst ((← l.get).extract 0 (toIndex n).toNat)
def rdrop (l : RList α) (n : Float) : IO (RList α) := do let xs ← l.get; lst (xs.extract (toIndex n).toNat xs.size)
def rrest (l : RList α) : IO (RList α) := l.rdrop 1
def rconcat (l : RList α) (m : RList α) : IO (RList α) := do lst ((← l.get) ++ (← m.get))
def rreverse (l : RList α) : IO (RList α) := do lst (← l.get).reverse
def rsum [ToValue α] (l : RList α) : IO Float := do
  let mut s : Float := 0
  for x in ← l.get do s := s + (toValue x).toNum
  return s
def rcontains [Eq2 α β] (l : RList α) (x : β) : IO Bool := do
  for y in ← l.get do if ← Eq2.eq y x then return true
  return false
def rindex_of [Eq2 α β] (l : RList α) (x : β) : IO Float := do
  let mut i := 0
  for y in ← l.get do
    if ← Eq2.eq y x then return natF i
    i := i + 1
  return nullF
def rjoin [ToStr α] (l : RList α) (sep : String) : IO String := do
  let mut out := ""
  let mut first := true
  for x in ← l.get do
    if !first then out := out ++ sep
    first := false
    out := out ++ (← toStr x)
  return out
def rmost [ToValue α] (l : RList α) (key : α → IO Float) : IO (RList Value) := do
  let mut best : Option (α × Nat × Float) := none
  let mut i := 0
  for x in ← l.get do
    let k ← key x
    match best with
    | none => best := some (x, i, k)
    | some (_, _, bk) => if k > bk then best := some (x, i, k)
    i := i + 1
  match best with
  | none => return null
  | some (b, j, _) => lst #[toValue b, .num (natF j)]
def rsorted_by (l : RList α) (key : α → IO Float) : IO (RList α) := do
  let mut keyed : Array (Float × Nat × α) := #[]
  let mut i := 0
  for x in ← l.get do
    keyed := keyed.push ((← key x), i, x)
    i := i + 1
  let sorted := keyed.qsort fun (p : Float × Nat × α) (q : Float × Nat × α) => if p.1 != q.1 then p.1 < q.1 else p.2.1 < q.2.1
  lst (sorted.map (·.2.2))
def reach (l : RList α) : IO (Many α) := do return ⟨← l.get⟩
def rquoted [ToStr α] (l : RList α) : IO String := do return (← l.rjoin ",")
end RList

namespace Many
def rlength (m : Many α) : IO Float := pure (natF m.items.size)
def rmap (m : Many α) (f : α → IO β) : IO (RList β) := do lst (← m.items.mapM f)
def rfilter [Truthy β] (m : Many α) (f : α → IO β) : IO (Many α) := do return ⟨← m.items.filterM fun x => do return truthy (← f x)⟩
def rsome [Truthy β] (m : Many α) (f : α → IO β) : IO Bool := do
  for x in m.items do if truthy (← f x) then return true
  return false
def revery [Truthy β] (m : Many α) (f : α → IO β) : IO Bool := do
  for x in m.items do if !truthy (← f x) then return false
  return true
def rfor (m : Many α) (f : α → IO β) : IO Unit := do for x in m.items do discard <| f x
def rfirst [Nullable α] (m : Many α) : IO α := pure (m.items[0]?.getD null)
def rempty (m : Many α) : IO Bool := pure m.items.isEmpty
end Many

def quoteText (s : String) : String := Id.run do
  let mut out := "\""
  for c in s.toList do
    if c == '"' then out := out ++ "\\\""
    else if c == '\\' then out := out ++ "\\\\"
    else if c == '\n' then out := out ++ "\\n"
    else if c == '\r' then out := out ++ "\\r"
    else if c == '\t' then out := out ++ "\\t"
    else if c.toNat < 0x20 then
      let h := Nat.toDigits 16 c.toNat
      out := out ++ "\\u" ++ String.ofList (List.replicate (4 - h.length) '0' ++ h)
    else out := out.push c
  return out.push '"'

def strFind (s sub : String) : Option Nat := Id.run do
  let a := s.toList.toArray
  let b := sub.toList.toArray
  if b.size == 0 then return some 0
  if b.size > a.size then return none
  for i in [0:a.size - b.size + 1] do
    let mut ok := true
    for j in [0:b.size] do
      if a[i + j]! != b[j]! then
        ok := false
        break
    if ok then return some i
  return none
def trimText (s : String) : String :=
  String.ofList (s.toList.dropWhile Char.isWhitespace |>.reverse |>.dropWhile Char.isWhitespace |>.reverse)
def splitText (s sep : String) : Array String :=
  if sep.isEmpty then s.toList.toArray.map String.singleton else (s.splitOn sep).toArray

-- what Ray knows on a text by name (String.ray)
def snakeText (s : String) : String := s.replace "-" "_" |>.replace "." "_"
instance : Get String "length" Float := ⟨fun s => pure (natF s.length)⟩
instance : Get String "empty" Bool := ⟨fun s => pure s.isEmpty⟩
instance : Get String "upper" String := ⟨fun s => pure s.toUpper⟩
instance : Get String "lower" String := ⟨fun s => pure s.toLower⟩
instance : Get String "trim" String := ⟨fun s => pure (trimText s)⟩
instance : Get String "quoted" String := ⟨fun s => pure (quoteText s)⟩
instance : Get String "snake" String := ⟨fun s => pure (snakeText s)⟩
instance : Get String "kebab" String := ⟨fun s => pure ((s.replace "_" "-").replace "." "-")⟩
instance : Get String "capitalised" String := ⟨fun s => pure s.capitalize⟩
instance : Get String "camel" String := ⟨fun s => pure (String.join ((splitText (snakeText s) "_").toList.filter (!·.isEmpty) |>.map String.capitalize))⟩


end OrbitMines.Physics

namespace String
open OrbitMines.Physics
def rlength (s : String) : IO Float := pure (natF s.length)
def rsplit (s : String) (sep : String) : IO (RList String) := lst (splitText s sep)
def rlines (s : String) : IO (RList String) := lst (splitText s "\n")
def rtrim (s : String) : IO String := pure (trimText s)
def rupper (s : String) : IO String := pure s.toUpper
def rlower (s : String) : IO String := pure s.toLower
def rquoted (s : String) : IO String := pure (quoteText (if s == nullStr then "null" else s))
def rstarts_with (s p : String) : IO Bool := pure (s.startsWith p)
def rends_with (s p : String) : IO Bool := pure (s.endsWith p)
def rreplace (s a b : String) : IO String := pure (s.replace a b)
def rcontains (s x : String) : IO Bool := pure (strFind s x).isSome
def rindex_of (s x : String) : IO Float := pure (match strFind s x with | some i => natF i | none => nullF)
def rfirst (s : String) : IO String := pure (match s.toList with | c :: _ => String.singleton c | [] => nullStr)
def rlast (s : String) : IO String := pure (match s.toList.getLast? with | some c => String.singleton c | none => nullStr)
def rempty (s : String) : IO Bool := pure s.isEmpty
def rtake (s : String) (n : Float) : IO String := pure (String.ofList (s.toList.take (toIndex n).toNat))
def rdrop (s : String) (n : Float) : IO String := pure (String.ofList (s.toList.drop (toIndex n).toNat))
def rrest (s : String) : IO String := s.rdrop 1
def rconcat (s : String) (t : String) : IO String := pure (s ++ t)
def rreverse (s : String) : IO String := pure (String.ofList s.toList.reverse)
def rchars (s : String) : IO (RList Float) := lst (s.toList.toArray.map fun c => natF c.toNat)
end String

namespace Float
open OrbitMines.Physics
def rsqrt (x : Float) : IO Float := pure x.sqrt
def rfloor (x : Float) : IO Float := pure x.floor
def rabs (x : Float) : IO Float := pure x.abs
def rmagnitude (x : Float) : IO Float := pure x.abs
def rnegated (x : Float) : IO Float := pure (-x)
def rcos (x : Float) : IO Float := pure x.cos
def rsin (x : Float) : IO Float := pure x.sin
def rround (x : Float) : IO Float := pure (Float.floor (x + 0.5))
def rln (x : Float) : IO Float := pure x.log
def rexp (x : Float) : IO Float := pure x.exp
def ratan2 (x y : Float) : IO Float := pure (Float.atan2 x y)
def rpow (x y : Float) : IO Float := pure (Float.pow x y)
def rblank (c : Float) : IO Bool := pure (c == 32 || c == 9 || c == 10 || c == 13)
end Float

namespace OrbitMines.Physics
-- the same members on a `Value`, looked up when it runs
namespace Value
def num1 (v : Value) (n : String) (f : Float → Float) : IO Value :=
  match v with
  | .obj _ => v.dynGet n
  | v => pure (.num (f v.toNum))
def rsqrt (v : Value) := v.num1 "sqrt" Float.sqrt
def rfloor (v : Value) := v.num1 "floor" Float.floor
def rabs (v : Value) := v.num1 "abs" Float.abs
def rmagnitude (v : Value) := v.num1 "magnitude" Float.abs
def rnegated (v : Value) := v.num1 "negated" (- ·)
def rcos (v : Value) := v.num1 "cos" Float.cos
def rsin (v : Value) := v.num1 "sin" Float.sin
def rround (v : Value) := v.num1 "round" fun x => Float.floor (x + 0.5)
def rln (v : Value) := v.num1 "ln" Float.log
def rexp (v : Value) := v.num1 "exp" Float.exp
def ratan2 (v : Value) (y : Value) : IO Value := match v with | .obj _ => v.dynCall "atan2" #[y] | v => pure (.num (Float.atan2 v.toNum y.toNum))
def rpow (v : Value) (y : Value) : IO Value := match v with | .obj _ => v.dynCall "pow" #[y] | v => pure (.num (Float.pow v.toNum y.toNum))
def rlength (v : Value) : IO Value := match v with
  | .list h => do return .num (natF (← (Value.dl h).get).size)
  | .str s => pure (.num (natF s.length))
  | .many m => pure (.num (natF m.size))
  | v => v.dynGet "length"
def rmap (v : Value) (f : Value → IO Value) : IO Value := match v with
  | .obj _ | .cls _ => v.dynCall "map" #[toValue f]
  | v => do return toValue (← lst (← (← items v).mapM f))
def rfilter (v : Value) (f : Value → IO Value) : IO Value := match v with
  | .obj _ | .cls _ => v.dynCall "filter" #[toValue f]
  | .many xs => do return .many (← xs.filterM fun x => do return truthy (← f x))
  | v => do return toValue (← lst (← (← items v).filterM fun x => do return truthy (← f x)))
def rfor (v : Value) (f : Value → IO Value) : IO Unit := match v with
  | .obj _ | .cls _ => discard <| v.dynCall "for" #[toValue f]
  | v => do for x in ← items v do discard <| f x
def rsome (v : Value) (f : Value → IO Value) : IO Bool := match v with
  | .obj _ | .cls _ => do return truthy (← v.dynCall "some" #[toValue f])
  | v => do
    for x in ← items v do if truthy (← f x) then return true
    return false
def revery (v : Value) (f : Value → IO Value) : IO Bool := match v with
  | .obj _ | .cls _ => do return truthy (← v.dynCall "every" #[toValue f])
  | v => do
    for x in ← items v do if !truthy (← f x) then return false
    return true
def rreduce (v : Value) (z : Value) (f : Value → Value → IO Value) : IO Value := match v with
  | .obj _ | .cls _ => v.dynCall "reduce" #[z, toValue f]
  | v => do
    let mut acc := z
    for x in ← items v do acc ← f acc x
    return acc
def rpush (v : Value) (x : Value) : IO Value := match v with
  | .list h => do (Value.dl h).push x; return v
  | v => v.dynCall "push" #[x]
def rpop (v : Value) : IO Value := match v with
  | .list h => do
    let d := Value.dl h
    let xs ← d.get
    match xs.back? with
    | none => return .null
    | some x =>
      let l : RList Value := fromValue v
      if d.kind == "V" then l.ref.modify (·.pop)
      return x
  | v => v.dynGet "pop"
def rfirst (v : Value) : IO Value := match v with
  | .obj _ | .cls _ => v.dynGet "first"
  | .str s => pure (toValue (match s.toList with | c :: _ => String.singleton c | [] => nullStr))
  | v => do return (← items v)[0]?.getD .null
def rlast (v : Value) : IO Value := match v with
  | .obj _ | .cls _ => v.dynGet "last"
  | .str s => pure (toValue (match s.toList.getLast? with | some c => String.singleton c | none => nullStr))
  | v => do return (← items v).back?.getD .null
def rempty (v : Value) : IO Bool := match v with
  | .obj _ | .cls _ => do return truthy (← v.dynGet "empty")
  | v => do return (← v.rlength).toNum == 0
def rcontains (v : Value) (x : Value) : IO Bool := match v with
  | .str s => do return (strFind s (← x.text)).isSome
  | .obj _ | .cls _ => do return truthy (← v.dynCall "contains" #[x])
  | v => do
    for y in ← items v do if ← y.eq x then return true
    return false
def rindex_of (v : Value) (x : Value) : IO Value := match v with
  | .str s => do return match strFind s (← x.text) with | some i => .num (natF i) | none => .null
  | .obj _ | .cls _ => v.dynCall "index_of" #[x]
  | v => do
    let l ← items v
    for i in [0:l.size] do if ← l[i]!.eq x then return .num (natF i)
    return .null
def rjoin (v : Value) (sep : Value) : IO Value := match v with
  | .obj _ | .cls _ => v.dynCall "join" #[sep]
  | v => do
    let s ← sep.text
    let mut out := ""
    let mut first := true
    for x in ← items v do
      if !first then out := out ++ s
      first := false
      out := out ++ (← x.text)
    return .str out
def rsplit (v : Value) (sep : Value) : IO Value := match v with
  | .str s => do return toValue (← lst ((splitText s (← sep.text)).map Value.str))
  | v => v.dynCall "split" #[sep]
def rtrim (v : Value) : IO Value := match v with | .str s => pure (.str (trimText s)) | v => v.dynGet "trim"
def rlines (v : Value) : IO Value := match v with | .str s => do return toValue (← lst ((splitText s "\n").map Value.str)) | v => v.dynGet "lines"
def rupper (v : Value) : IO Value := match v with | .str s => pure (.str s.toUpper) | v => v.dynGet "upper"
def rlower (v : Value) : IO Value := match v with | .str s => pure (.str s.toLower) | v => v.dynGet "lower"
def rquoted (v : Value) : IO Value := do return .str (quoteText (← v.text))
def rstarts_with (v : Value) (x : Value) : IO Value := match v with
  | .str s => do return .bool (s.startsWith (← x.text))
  | v => v.dynCall "starts_with" #[x]
def rends_with (v : Value) (x : Value) : IO Value := match v with
  | .str s => do return .bool (s.endsWith (← x.text))
  | v => v.dynCall "ends_with" #[x]
def rreplace (v : Value) (a b : Value) : IO Value := match v with
  | .str s => do return .str (s.replace (← a.text) (← b.text))
  | v => v.dynCall "replace" #[a, b]
def rtake (v : Value) (n : Value) : IO Value := match v with
  | .str s => pure (.str (String.ofList (s.toList.take (toIndex n.toNum).toNat)))
  | .obj _ | .cls _ => v.dynCall "take" #[n]
  | v => do return toValue (← lst ((← items v).extract 0 (toIndex n.toNum).toNat))
def rdrop (v : Value) (n : Value) : IO Value := match v with
  | .str s => pure (.str (String.ofList (s.toList.drop (toIndex n.toNum).toNat)))
  | .obj _ | .cls _ => v.dynCall "drop" #[n]
  | v => do let xs ← items v; return toValue (← lst (xs.extract (toIndex n.toNum).toNat xs.size))
def rrest (v : Value) : IO Value := match v with
  | .obj _ | .cls _ => v.dynGet "rest"
  | v => v.rdrop (.num 1)
def rconcat (v : Value) (w : Value) : IO Value := match v with
  | .str s => do return .str (s ++ (← w.text))
  | .obj _ | .cls _ => v.dynCall "concat" #[w]
  | v => do return toValue (← lst ((← items v) ++ (← items w)))
def rreverse (v : Value) : IO Value := match v with
  | .str s => pure (.str (String.ofList s.toList.reverse))
  | .obj _ | .cls _ => v.dynGet "reverse"
  | v => do return toValue (← lst (← items v).reverse)
def rsum (v : Value) : IO Value := match v with
  | .obj _ | .cls _ => v.dynGet "sum"
  | v => do
    let mut s : Float := 0
    for x in ← items v do s := s + x.toNum
    return .num s
def reach (v : Value) : IO Value := match v with
  | .obj _ | .cls _ => v.dynGet "each"
  | v => do return .many (← items v)
def rmost (v : Value) (key : Value → IO Value) : IO Value := match v with
  | .obj _ | .cls _ => v.dynCall "most" #[toValue key]
  | v => do return toValue (← (← lst (← items v)).rmost fun x => do return (← key x).toNum)
def rsorted_by (v : Value) (key : Value → IO Value) : IO Value := match v with
  | .obj _ | .cls _ => v.dynCall "sorted_by" #[toValue key]
  | v => do return toValue (← (← lst (← items v)).rsorted_by fun x => do return (← key x).toNum)
def rchars (v : Value) : IO Value := match v with
  | .str s => do return toValue (← s.rchars)
  | v => v.dynGet "chars"
def rblank (v : Value) : IO Bool := do return (← v.toNum.rblank)
end Value

/-- `dot! xs rmap (f)`: a member Ray knows on lists, texts and numbers, with its arguments -/
syntax "dot! " term:max ident "(" term,* ")" : term
macro_rules
  | `(dot! $x $m ($as,*)) => `(($x).$m:ident $as*)

-- --- globals ------------------------------------------------------------------------------------------------------
/-- a value made once, when it is first read -/
def ωonce [Nonempty α] (r : IO.Ref (Option Handle)) (make : IO α) : IO α := do
  match ← r.get with
  | some h => match (ofHandle h : Option α) with
    | some v => return v
    | none => make
  | none =>
    let v ← make
    r.set (some (toHandle (some v)))
    return v


-- --- the classes, as the emitted modules declare them --------------------------------------------------------------
/-- a class written as a value: its tag, or a theory's one object -/
class ClassRef (n : String) (β : outParam Type) where
  get : IO β
syntax "cls% " ident : term
macro_rules
  | `(cls% $x) => do
    let n := match x.getId with | .str _ s => s | _ => "?"
    `(ClassRef.get $(Lean.Syntax.mkStrLit n))

@[inline] def ωreadSlot [Nullable α] (o : Obj) (idx : Nat) (name : String) : IO α := do
  if h : idx < o.slots.size then
    let r : IO.Ref (Option α) := ofHandle o.slots[idx]
    match ← r.get with
    | some v => return v
    | none =>
      match ← ωentry o idx name with
      | .field d =>
        let v ← (ofHandle d : Obj → IO α) o
        r.set (some v)
        return v
      | .getter g => (ofHandle g : Obj → IO α) o
      | _ => return null
  else ωnoMember o name
@[inline] def ωwriteSlot (o : Obj) (idx : Nat) (name : String) (v : α) : IO Unit := do
  if h : idx < o.slots.size then
    let r : IO.Ref (Option α) := ofHandle o.slots[idx]
    r.set (some v)
  else throwMsg s!"no member {name} to set on None"
@[inline] def ωmethodOf (o : Obj) (idx : Nat) (name : String) : IO Handle := do
  match ← ωentry o idx name with
  | .method m => return m
  | .getter g => return g
  | _ => ωnoMember o name
def ωstaticHandle (c : ClassInfo) (name : String) : IO Handle := do
  match ← ωstaticOf c name with
  | some h => return h
  | none => throwMsg s!"no static {name} on {c.name}"
/-- the statics a class declares, in the order it writes them (a theory's rules are read off them) -/
initialize staticOrderRef : IO.Ref (Std.HashMap String (Array String)) ← IO.mkRef {}
def ωdeclareStatic (c : ClassInfo) (name : String) : IO Unit :=
  staticOrderRef.modify fun m => m.insert c.name ((m[c.name]?.getD #[]).push name)

/-- the names Ray knows on lists, texts and numbers: a class's own member of one of these is also `r<name>`, so that
`xs.map(f)` reaches it whatever `xs` is -/
def ωrecognised : List String := ["push", "chars", "pop", "length", "map", "filter", "for", "some", "every", "reduce",
  "starts_with", "ends_with", "replace", "split", "trim", "upper", "lower", "lines", "quoted", "contains", "index_of",
  "join", "first", "last", "empty", "take", "drop", "rest", "concat", "reverse", "sum", "most", "sorted_by", "each",
  "sqrt", "floor", "abs", "negated", "magnitude", "cos", "sin", "round", "ln", "exp", "atan2", "pow", "blank"]

section macros
open Lean
set_option hygiene false

private def ωid (s : String) : Ident := mkIdent (Name.mkSimple s)
private def ωstr (s : String) : StrLit := Syntax.mkStrLit s

structure RayParamInfo where
  name : Ident
  ty : Term
  dflt : Option Term

/-- a type as Ray writes it where it has no rule of its own: a pair `[A, B]` is a list of the first -/
def ωtype (t : Term) : MacroM Term := do
  match t with
  | `([$a, $_,*]) => `(RList $a)
  | _ => pure t

def rayParamInfo : TSyntax `rayParam → MacroM RayParamInfo
  | `(rayParam| ($x : $t)) => do return ⟨x, ← ωtype t, none⟩
  | `(rayParam| ($x : $t := $d)) => do return ⟨x, ← ωtype t, some d⟩
  | `(rayParam| $x:ident) => do return ⟨x, ← `(Value), none⟩
  | _ => Macro.throwUnsupported

/-- `(a : A) → (b : optParam B d) → IO T`: a member's type, its defaults kept -/
def ωpi (ps : Array RayParamInfo) (ret : Term) : MacroM Term := do
  let mut t ← `(IO $ret)
  for p in ps.reverse do
    t ← match p.dflt with
      | some d => `(($(p.name) : optParam $(p.ty) $d) → $t)
      | none => `(($(p.name) : $(p.ty)) → $t)
  return t
/-- `A → B → IO T`: a program of these, as it is held -/
def ωarrow (ps : Array RayParamInfo) (ret : Term) : MacroM Term := do
  let mut t ← `(IO $ret)
  for p in ps.reverse do t ← `($(p.ty) → $t)
  return t
/-- `fun (a : A) (b : B) => body` -/
def ωlam (ps : Array RayParamInfo) (body : Term) : MacroM Term := do
  let mut b := body
  for p in ps.reverse do b ← `(fun ($(p.name) : $(p.ty)) => $b)
  return b
/-- a body with its parameters made cells of their own, so a lambda inside may write them -/
def ωcells (ps : Array RayParamInfo) (body : Term) (ret : Term) : MacroM Term := do
  let mut b := body
  for p in ps.reverse do b ← `(((do let $(p.name):ident ← IO.mkRef $(p.name):ident; $b:term) : IO $ret))
  return b
def ωnames (ps : Array RayParamInfo) : Array Term := ps.map fun p => ⟨p.name.raw⟩

/-- `Call<k>` instances for every number of arguments a call may give, the rest defaulted -/
def ωcallInstances (self : Term) (nm : StrLit) (call : Array Term → MacroM Term) (ps : Array RayParamInfo) (ret : Term) : MacroM (Array Command) := do
  let required := (ps.filter (·.dflt.isNone)).size
  let mut out := #[]
  for k in [required:ps.size + 1] do
    if k > 8 then continue
    let given := ps.extract 0 k
    let cls := ωid s!"Call{k}"
    let tys := given.map (·.ty)
    let body ← ωlam given (← call (ωnames given))
    out := out.push (← `(instance : $cls $self $nm $tys* $ret := ⟨fun ωσ => $body⟩))
  return out

/-- the dynamic caller of a member: its arguments read off values, its result made one -/
def ωdynArgs (ps : Array RayParamInfo) : MacroM (Array Term) := do
  let mut args : Array Term := #[]
  for i in [0:ps.size] do
    args := args.push (← `((fromValue (a.getD $(Syntax.mkNumLit (toString i)) Value.null))))
  return args

end macros

-- what the declarations below expand to, as plain functions (a macro only applies them)
def ωdyn0 [IsObj σ] [ToValue τ] (c : ClassInfo) (n : String) (f : σ → IO τ) : IO Unit :=
  ωregisterDyn c n fun o _ => do return toValue (← f (IsObj.ofObj o))
def ωdynSet [IsObj σ] [FromValue τ] (c : ClassInfo) (n : String) (f : σ → τ → IO Unit) : IO Unit :=
  ωregisterDynSet c n fun o v => f (IsObj.ofObj o) (fromValue v)
@[inline] def ωa [FromValue α] (a : Array Value) (i : Nat) : α := fromValue (a.getD i .null)
def ωdyn1 [IsObj σ] [FromValue α] [ToValue τ] (c : ClassInfo) (n : String) (f : σ → α → IO τ) : IO Unit :=
  ωregisterDyn c n fun o a => do return toValue (← f (IsObj.ofObj o) (ωa a 0))
def ωdyn2 [IsObj σ] [FromValue α] [FromValue β] [ToValue τ] (c : ClassInfo) (n : String) (f : σ → α → β → IO τ) : IO Unit :=
  ωregisterDyn c n fun o a => do return toValue (← f (IsObj.ofObj o) (ωa a 0) (ωa a 1))
def ωdyn3 [IsObj σ] [FromValue α] [FromValue β] [FromValue γ] [ToValue τ] (c : ClassInfo) (n : String) (f : σ → α → β → γ → IO τ) : IO Unit :=
  ωregisterDyn c n fun o a => do return toValue (← f (IsObj.ofObj o) (ωa a 0) (ωa a 1) (ωa a 2))
def ωdyn4 [IsObj σ] [FromValue α] [FromValue β] [FromValue γ] [FromValue δ] [ToValue τ] (c : ClassInfo) (n : String) (f : σ → α → β → γ → δ → IO τ) : IO Unit :=
  ωregisterDyn c n fun o a => do return toValue (← f (IsObj.ofObj o) (ωa a 0) (ωa a 1) (ωa a 2) (ωa a 3))
def ωdyn5 [IsObj σ] [FromValue α] [FromValue β] [FromValue γ] [FromValue δ] [FromValue ε] [ToValue τ] (c : ClassInfo) (n : String) (f : σ → α → β → γ → δ → ε → IO τ) : IO Unit :=
  ωregisterDyn c n fun o a => do return toValue (← f (IsObj.ofObj o) (ωa a 0) (ωa a 1) (ωa a 2) (ωa a 3) (ωa a 4))
def ωdyn6 [IsObj σ] [FromValue α] [FromValue β] [FromValue γ] [FromValue δ] [FromValue ε] [FromValue ζ] [ToValue τ] (c : ClassInfo) (n : String) (f : σ → α → β → γ → δ → ε → ζ → IO τ) : IO Unit :=
  ωregisterDyn c n fun o a => do return toValue (← f (IsObj.ofObj o) (ωa a 0) (ωa a 1) (ωa a 2) (ωa a 3) (ωa a 4) (ωa a 5))
def ωdynS0 [ToValue τ] (c : ClassInfo) (n : String) (f : IO τ) : IO Unit :=
  ωregisterDynStatic c n fun _ => do return toValue (← f)
def ωdynS1 [FromValue α] [ToValue τ] (c : ClassInfo) (n : String) (f : α → IO τ) : IO Unit :=
  ωregisterDynStatic c n fun a => do return toValue (← f (ωa a 0))
def ωdynS2 [FromValue α] [FromValue β] [ToValue τ] (c : ClassInfo) (n : String) (f : α → β → IO τ) : IO Unit :=
  ωregisterDynStatic c n fun a => do return toValue (← f (ωa a 0) (ωa a 1))
def ωdynS3 [FromValue α] [FromValue β] [FromValue γ] [ToValue τ] (c : ClassInfo) (n : String) (f : α → β → γ → IO τ) : IO Unit :=
  ωregisterDynStatic c n fun a => do return toValue (← f (ωa a 0) (ωa a 1) (ωa a 2))
def ωdynS4 [FromValue α] [FromValue β] [FromValue γ] [FromValue δ] [ToValue τ] (c : ClassInfo) (n : String) (f : α → β → γ → δ → IO τ) : IO Unit :=
  ωregisterDynStatic c n fun a => do return toValue (← f (ωa a 0) (ωa a 1) (ωa a 2) (ωa a 3))
def ωdynS5 [FromValue α] [FromValue β] [FromValue γ] [FromValue δ] [FromValue ε] [ToValue τ] (c : ClassInfo) (n : String) (f : α → β → γ → δ → ε → IO τ) : IO Unit :=
  ωregisterDynStatic c n fun a => do return toValue (← f (ωa a 0) (ωa a 1) (ωa a 2) (ωa a 3) (ωa a 4))
def ωdynS6 [FromValue α] [FromValue β] [FromValue γ] [FromValue δ] [FromValue ε] [FromValue ζ] [ToValue τ] (c : ClassInfo) (n : String) (f : α → β → γ → δ → ε → ζ → IO τ) : IO Unit :=
  ωregisterDynStatic c n fun a => do return toValue (← f (ωa a 0) (ωa a 1) (ωa a 2) (ωa a 3) (ωa a 4) (ωa a 5))
/-- a static's program, found once on the class (or its parent) and kept -/
def ωstaticCached (cache : IO.Ref (Option Handle)) (c : ClassInfo) (n : String) : IO Handle := do
  match ← cache.get with
  | some h => return h
  | none =>
    let h ← ωstaticHandle c n
    cache.set (some h)
    return h
/-- a static field's value, made once -/
def ωsfieldGet [Nonempty τ] (cell : IO.Ref (Option τ)) (c : ClassInfo) (key : String) : IO τ := do
  match ← cell.get with
  | some v => return v
  | none =>
    let v ← (ofHandle (← ωstaticHandle c key) : IO τ)
    cell.set (some v)
    return v
@[inline] def ωcellSet (cell : IO.Ref (Option τ)) (v : τ) : IO Unit := cell.set (some v)
def lstOf [FromValue α] (xs : Array Value) : IO (RList α) := lst (xs.map fromValue)
/-- what a theory is given besides its rules when its object is made: its equation, as data -/
initialize theoryFillRef : IO.Ref (Std.HashMap String (Obj → IO Unit)) ← IO.mkRef {}
def ωtheoryFill (n : String) (f : Obj → IO Unit) : IO Unit := theoryFillRef.modify (·.insert n f)
/-- a map of these parts, as a value (a term of an equation) -/
def ωnode (kv : Array (String × Value)) : IO Value := do
  let m ← RMap.new
  for (k, v) in kv do m.set k v
  return toValue m
/-- a share of a term: its source, and the program that reads it at the symbols -/
def ωshare (source : String) (f : Value → IO Value) : IO Value :=
  ωnode #[("source", .str source), ("at", mkDFn fun a => f (a.getD 0 .null))]
/-- a theory's one object: its rules and theorems, the statics its class writes in order -/
def ωmakeTheory [IsObj σ] (c : ClassInfo) (fill : σ → Array Value → Array Value → IO Unit) : IO σ := do
  let t : σ := IsObj.ofObj (← ωnewObj c)
  let names := (← staticOrderRef.get)[c.name]?.getD #[]
  let mut rules := #[]
  let mut theorems := #[]
  for n in names do
    let read : IO Value := do
      match ← ωdynStaticOf c n with
      | some f => f #[]
      | none => return .null
    if n.startsWith "rule " then rules := rules.push (← read)
    else if n.startsWith "theorem " then theorems := theorems.push (← read)
  fill t rules theorems
  if let some f := (← theoryFillRef.get)[c.name]? then f (IsObj.obj t)
  return t

section classes
open Lean
/- the names a class declares (`ωcls`, `ωSelf`, `ωname`) and `self` are the class's own, not the macro's -/
set_option hygiene false

private def ωid' (s : String) : Ident := mkIdent (Name.mkSimple s)
private def ωcmds (cs : Array Command) : MacroM Syntax := return mkNullNode (cs.map (·.raw))

/-- `ray_class Hole < Source`: the class - its hierarchy's own Lean type, or its parent's -/
syntax "ray_class " ident " < " ident : command
macro_rules
  | `(ray_class $c < $p) => do
    let n := c.getId.toString
    let nameLit := Syntax.mkStrLit n
    let parentLit := Syntax.mkStrLit p.getId.toString
    let mut cmds : Array Command := #[]
    if p.getId.toString == "Node" then
      cmds := cmds.push (← `(structure $c:ident where
          ωo : Obj))
      cmds := cmds.push (← `(instance : IsObj $c := ⟨fun x => x.ωo, fun o => ⟨o⟩⟩))
      cmds := cmds.push (← `(instance : Nullable $c := ⟨⟨nullObj⟩, fun x => x.ωo.id == 0⟩))
      cmds := cmds.push (← `(instance : Inhabited $c := ⟨⟨nullObj⟩⟩))
      cmds := cmds.push (← `(instance : ToValue $c := ⟨fun x => if x.ωo.id == 0 then Value.null else Value.obj x.ωo⟩))
      cmds := cmds.push (← `(instance : FromValue $c := ⟨fun v => match v with | .obj o => ⟨o⟩ | _ => ⟨nullObj⟩⟩))
      cmds := cmds.push (← `(instance : Kind $c := ⟨$nameLit⟩))
    else
      cmds := cmds.push (← `(abbrev $c:ident := $p))
    cmds := cmds.push (← `(namespace $c:ident
        abbrev ωSelf := $c
        @[reducible] def ωname : String := $nameLit
        initialize ωcls : ClassInfo ← ωdefineClass $nameLit $parentLit
        def ωnew : IO $c := ωnewObj ωcls >>= fun o => pure (IsObj.ofObj o)
        instance : ClassRef $nameLit (Cls $nameLit) := ⟨pure ⟨⟩⟩
        initialize dynNewRef.modify (·.insert $nameLit (ωnewObj ωcls))
        end $c:ident))
    ωcmds cmds

/-- a class this package does not carry, named where one is written: a `Value`, and an error if one is made -/
syntax "ray_missing " ident : command
macro_rules
  | `(ray_missing $c) => do
    let nameLit := Syntax.mkStrLit c.getId.toString
    let says := Syntax.mkStrLit s!"no class {c.getId} in this package"
    `(abbrev $c:ident := Value
      namespace $c:ident
      @[reducible] def ωname : String := $nameLit
      def ωnew : IO Value := throwMsg $says
      instance : ClassRef $nameLit (Cls $nameLit) := ⟨pure ⟨⟩⟩
      end $c:ident)

/-- a field: a slot, read into on first read (the class's own default, else its parent's) -/
syntax "ray_field " str " : " term : command
macro_rules
  | `(ray_field $nm : $t) => do
    let t ← ωtype t
    let s := nm.getString
    let f := ωid' s
    let setter := ωid' ("ωset_" ++ s)
    let idx := ωid' ("ωm_" ++ s)
    let mut cmds : Array Command := #[
      ← `(initialize $idx : Nat ← ωmemberIndex ωcls $nm),
      ← `(def $f (self : ωSelf) : IO $t := ωreadSlot self.ωo $idx $nm),
      ← `(def $setter (self : ωSelf) (v : $t) : IO Unit := ωwriteSlot self.ωo $idx $nm v),
      ← `(instance : Get ωSelf $nm $t := ⟨$f⟩),
      ← `(instance : Call0 ωSelf $nm $t := ⟨$f⟩),
      ← `(instance : Set' ωSelf $nm $t := ⟨$setter⟩),
      ← `(initialize ωdyn0 ωcls $nm $f),
      ← `(initialize ωdynSet ωcls $nm $setter)]
    if ωrecognised.contains s then cmds := cmds.push (← `(def $(ωid' ("r" ++ s)) (self : ωSelf) : IO $t := $f self))
    ωcmds cmds

/-- a getter: a program of no arguments, the class's own or its parent's -/
syntax "ray_getter " str " : " term : command
macro_rules
  | `(ray_getter $nm : $t) => do
    let t ← ωtype t
    let s := nm.getString
    let f := ωid' s
    let idx := ωid' ("ωm_" ++ s)
    let mut cmds : Array Command := #[
      ← `(initialize $idx : Nat ← ωmemberIndex ωcls $nm),
      ← `(def $f (self : ωSelf) : IO $t := ωreadSlot self.ωo $idx $nm),
      ← `(instance : Get ωSelf $nm $t := ⟨$f⟩),
      ← `(instance : Call0 ωSelf $nm $t := ⟨$f⟩),
      ← `(initialize ωdyn0 ωcls $nm $f)]
    if ωrecognised.contains s then cmds := cmds.push (← `(def $(ωid' ("r" ++ s)) (self : ωSelf) : IO $t := $f self))
    ωcmds cmds

/-- a method: a program of its parameters, the class's own or its parent's, found on the object's own class -/
syntax "ray_method " str rayParam* " : " term : command
macro_rules
  | `(ray_method $nm $ps* : $t) => do
    let t ← ωtype t
    let s := nm.getString
    let f := ωid' s
    let idx := ωid' ("ωm_" ++ s)
    let infos ← ps.mapM rayParamInfo
    let names := ωnames infos
    let pi ← ωpi infos t
    let held ← ωarrow infos t
    let body ← ωlam infos (← `(ωmethodOf self.ωo $idx $nm >>= fun ωh => (ofHandle ωh : Obj → $held) self.ωo $names*))
    let asValue ← ωlam infos (← `($f ωs $names*))
    let mut cmds : Array Command := #[
      ← `(initialize $idx : Nat ← ωmemberIndex ωcls $nm),
      ← `(def $f : (self : ωSelf) → $pi := fun self => $body),
      ← `(instance : Get ωSelf $nm $held := ⟨fun ωs => pure $asValue⟩)]
    if infos.size ≤ 6 then
      cmds := cmds.push (← `(initialize $(ωid' s!"ωdyn{infos.size}"):ident ωcls $nm (@$f)))
    cmds := cmds ++ (← ωcallInstances (← `(ωSelf)) nm (fun xs => `($f ωσ $xs*)) infos t)
    if ωrecognised.contains s then cmds := cmds.push (← `(def $(ωid' ("r" ++ s)) : (self : ωSelf) → $pi := $f))
    ωcmds cmds

/-- a static method: the class's own, or its parent's -/
syntax "ray_static " str rayParam* " : " term : command
macro_rules
  | `(ray_static $nm $ps* : $t) => do
    let t ← ωtype t
    let s := nm.getString
    let f := ωid' ("ωstatic_" ++ s)
    let cache := ωid' ("ωsh_" ++ s)
    let infos ← ps.mapM rayParamInfo
    let names := ωnames infos
    let pi ← ωpi infos t
    let held ← ωarrow infos t
    let body ← ωlam infos (← `(ωstaticCached $cache ωcls $nm >>= fun ωh => (ofHandle ωh : $held) $names*))
    let cls ← `(Cls ωname)
    let mut cmds : Array Command := #[
      ← `(initialize $cache : IO.Ref (Option Handle) ← IO.mkRef none),
      ← `(def $f : $pi := $body)]
    if infos.size ≤ 6 then
      cmds := cmds.push (← `(initialize $(ωid' s!"ωdynS{infos.size}"):ident ωcls $nm (@$f)))
    cmds := cmds ++ (← ωcallInstances cls nm (fun xs => `($f $xs*)) infos t)
    if (infos.filter (·.dflt.isNone)).isEmpty then
      cmds := cmds.push (← `(instance : Get $cls $nm $t := ⟨fun _ => $f⟩))
      cmds := cmds.push (← `(instance : Get ωSelf $nm $t := ⟨fun _ => $f⟩))
    else
      let asValue ← ωlam infos (← `($f $names*))
      cmds := cmds.push (← `(instance : Get $cls $nm $held := ⟨fun _ => pure $asValue⟩))
    if ωrecognised.contains s then cmds := cmds.push (← `(def $(ωid' ("r" ++ s)) : (_c : $cls) → $pi := fun _ => $f))
    ωcmds cmds

/-- a static field: made once, on first read (the class's own default, else its parent's) -/
syntax "ray_sfield " str " : " term : command
macro_rules
  | `(ray_sfield $nm : $t) => do
    let t ← ωtype t
    let s := nm.getString
    let f := ωid' ("ωstatic_" ++ s)
    let setter := ωid' ("ωsset_" ++ s)
    let cell := ωid' ("ωsf_" ++ s)
    let key := Syntax.mkStrLit ("=" ++ s)
    let cls ← `(Cls ωname)
    ωcmds #[
      ← `(initialize $cell : IO.Ref (Option $t) ← IO.mkRef none),
      ← `(initialize ωdeclareStatic ωcls $nm),
      ← `(def $f : IO $t := ωsfieldGet $cell ωcls $key),
      ← `(def $setter (v : $t) : IO Unit := ωcellSet $cell v),
      ← `(instance : Get $cls $nm $t := ⟨fun _ => $f⟩),
      ← `(instance : Call0 $cls $nm $t := ⟨fun _ => $f⟩),
      ← `(instance : Set' $cls $nm $t := ⟨fun _ v => $setter v⟩),
      ← `(instance : Get ωSelf $nm $t := ⟨fun _ => $f⟩),
      ← `(instance : Set' ωSelf $nm $t := ⟨fun _ v => $setter v⟩),
      ← `(initialize ωdynS0 ωcls $nm $f)]

-- --- what the class modules give: the programs of the members, as the classes fill their tables ---------------------------
/-- a field's default -/
syntax "ray_impl_field " str " : " term " := " term : command
macro_rules
  | `(ray_impl_field $nm : $t := $body) =>
    `(initialize ωregister ωcls $nm (Entry.field (toHandle (fun (ωx : Obj) => let self : ωSelf := IsObj.ofObj ωx; ($body : IO $t)))))
/-- a field's default written without a type (`name = "G"`) -/
syntax "ray_default " str " := " term : command
macro_rules
  | `(ray_default $nm := $body) =>
    `(initialize ωregister ωcls $nm (Entry.field (toHandle (fun (ωx : Obj) => let self : ωSelf := IsObj.ofObj ωx; ($body : IO _)))))
syntax "ray_impl_getter " str " : " term " := " term : command
macro_rules
  | `(ray_impl_getter $nm : $t := $body) =>
    `(initialize ωregister ωcls $nm (Entry.getter (toHandle (fun (ωx : Obj) => let self : ωSelf := IsObj.ofObj ωx; ($body : IO $t)))))
syntax "ray_impl_method " str rayParam* " : " term " := " term : command
macro_rules
  | `(ray_impl_method $nm $ps* : $t := $body) => do
    let infos ← ps.mapM rayParamInfo
    let inner ← ωcells infos (← `(($body : IO $t))) t
    let b ← ωlam infos (← `(let self : ωSelf := IsObj.ofObj ωx; $inner))
    `(initialize ωregister ωcls $nm (Entry.method (toHandle (fun (ωx : Obj) => $b))))
syntax "ray_impl_static " str rayParam* " : " term " := " term : command
macro_rules
  | `(ray_impl_static $nm $ps* : $t := $body) => do
    let infos ← ps.mapM rayParamInfo
    let b ← ωlam infos (← ωcells infos (← `(($body : IO $t))) t)
    `(initialize ωregisterStatic ωcls $nm (toHandle $b))
syntax "ray_impl_sfield " str " : " term " := " term : command
macro_rules
  | `(ray_impl_sfield $nm : $t := $body) =>
    `(initialize ωregisterStatic ωcls $(Syntax.mkStrLit ("=" ++ nm.getString)) (toHandle (($body : IO $t))))

/-- `new! Hole (x := 9, y := 15)`: an object of the class, the named fields set -/
declare_syntax_cat rayArg
syntax ident " := " term : rayArg
syntax "new! " ident "(" rayArg,* ")" : term
macro_rules
  | `(new! $c ($as,*)) => do
    let n := match c.getId with | .str _ s => s | _ => "?"
    let mk := mkIdent (Name.mkStr (Name.mkSimple n) "ωnew")
    let mut acc ← `(pure ωx)
    for a in as.getElems.reverse do
      match a with
      | `(rayArg| $x:ident := $v) =>
        let key := Syntax.mkStrLit (match x.getId with | .str _ s => s | _ => "?")
        acc ← `((ωsetter ωx $key) $v *> $acc)
      | _ => Macro.throwError "a class made with an argument not named"
    `($mk >>= fun ωx => $acc)

/-- a top-level definition, made on first read -/
syntax "ray_global " ident " := " term : command
macro_rules
  | `(ray_global $x := $body) => do
    let cell := ωid' ("ωgcell_" ++ x.getId.toString)
    let f := ωid' ("ωglobal_" ++ x.getId.toString)
    `(initialize $cell : IO.Ref (Option Handle) ← IO.mkRef none
      def $f := ωonce $cell $body)

/-- a theory: its class made once, its rules read off the class in the order they are written -/
syntax "ray_theory " ident : command
macro_rules
  | `(ray_theory $c) => do
    let nameLit := Syntax.mkStrLit c.getId.toString
    `(namespace $c:ident
      initialize ωtheory : IO.Ref (Option Handle) ← IO.mkRef none
      def ωobj : IO $c := ωonce ωtheory (ωmakeTheory ωcls (fun t rs ts => (lstOf rs >>= ωsetter t "rules") *> (lstOf ts >>= ωsetter t "theorems")))
      instance (priority := high) : ClassRef $nameLit $c := ⟨ωobj⟩
      initialize theoriesRef.modify (·.insert $nameLit (ωobj >>= fun t => pure (toValue t)))
      end $c:ident)
end classes

-- a class that is not carried, or a static no class declares: asked by name when it runs
instance (priority := low) : Get (Cls n) m Value := ⟨fun _ => (Value.cls n).dynGet m⟩
instance (priority := low) : Call0 (Cls n) m Value := ⟨fun _ => (Value.cls n).dynCall m #[]⟩
instance (priority := low) : Call1 (Cls n) m Value Value := ⟨fun _ a => (Value.cls n).dynCall m #[a]⟩
instance (priority := low) : Call2 (Cls n) m Value Value Value := ⟨fun _ a b => (Value.cls n).dynCall m #[a, b]⟩
instance (priority := low) : Call3 (Cls n) m Value Value Value Value := ⟨fun _ a b c => (Value.cls n).dynCall m #[a, b, c]⟩
instance (priority := low) : Call4 (Cls n) m Value Value Value Value Value := ⟨fun _ a b c d => (Value.cls n).dynCall m #[a, b, c, d]⟩
namespace Cls
def rsplit [Call2 (Cls n) "split" α β γ] (c : Cls n) (a : α) (b : β) : IO γ := Call2.call "split" c a b
end Cls

/-- a text of the failure -/
def failV [ToStr α] (x : α) : IO β := do throwMsg (← toStr x)
/-- `fail` as a value, for a call the emitter could not tell from any other -/
def fail : Value := mkDFn fun a => failV (a.getD 0 .null)
def fromCodepoints (xs : RList Float) : IO String := do
  return String.ofList ((← xs.get).toList.map fun c => Char.ofNat c.toUInt64.toNat)
def ωhas (v : Value) (n : String) : IO Bool := do
  match v with
  | .obj o => return (← ωdynOf o.cls n).isSome
  | _ => return false
/-- a number with two decimals, for timings -/
def fixed2 (x : Float) : String :=
  let c := (x * 100).round.toUInt64.toNat
  let r := c % 100
  toString (c / 100) ++ "." ++ (if r < 10 then "0" else "") ++ toString r

-- --- the names the emitted modules use: a class's own member of the same name (a class may have a member `add` or
-- `get`) is never taken for one of these -----------------------------------------------------------------------------
@[inline] def ωtruthy [Truthy α] (x : α) : Bool := truthy x
@[inline] def ωnull [Nullable α] : α := null
@[inline] def ωisNull [Nullable α] (x : α) : Bool := isNull x
@[inline] def ωwr (r : IO.Ref α) (v : α) : IO Unit := r.set v
@[inline] def ωsink (_ : α) : IO Unit := pure ()
@[inline, elab_without_expected_type] def ωget (x : α) (n : String) [i : Get α n β] : IO β := i.get x
@[inline, elab_without_expected_type] def ωgetOpt [Nullable α] [Nullable β] (x : α) (n : String) [i : Get α n β] : IO β :=
  if isNull x then pure null else i.get x
@[inline, elab_without_expected_type] def ωsetter (x : α) (n : String) [i : Set' α n β] : β → IO Unit := i.set x
@[inline, elab_without_expected_type] def ωatSetter [SetAt α κ β] (x : α) (k : κ) : β → IO Unit := SetAt.setAt x k
@[inline, elab_without_expected_type] def ωelem [Elem α κ β] (x : α) (k : κ) : IO β := Elem.elem x k
@[inline] def ωandV [Truthy α] [Truthy β] (a : α) (b : IO β) : IO Bool := andV a b
@[inline] def ωorV [Truthy α] [Truthy β] (a : α) (b : IO β) : IO Bool := orV a b
@[inline] def ωnotV [Truthy α] (a : α) : Bool := notV a
@[inline, elab_without_expected_type] def ωneg [Neg1 α γ] (a : α) : IO γ := Neg1.neg a
@[inline, elab_without_expected_type] def ωadd [Add2 α β γ] (a : α) (b : β) : IO γ := Add2.add a b
@[inline, elab_without_expected_type] def ωsub [Sub2 α β γ] (a : α) (b : β) : IO γ := Sub2.sub a b
@[inline, elab_without_expected_type] def ωmul [Mul2 α β γ] (a : α) (b : β) : IO γ := Mul2.mul a b
@[inline, elab_without_expected_type] def ωdiv [Div2 α β γ] (a : α) (b : β) : IO γ := Div2.div a b
@[inline, elab_without_expected_type] def ωmodv [Mod2 α β γ] (a : α) (b : β) : IO γ := Mod2.mod a b
@[inline, elab_without_expected_type] def ωpow [Pow2 α β γ] (a : α) (b : β) : IO γ := Pow2.pow a b
@[inline] def ωlt [Cmp2 α β] (a : α) (b : β) : IO Bool := Cmp2.lt a b
@[inline] def ωle [Cmp2 α β] (a : α) (b : β) : IO Bool := Cmp2.le a b
@[inline] def ωgt [Cmp2 α β] (a : α) (b : β) : IO Bool := Cmp2.gt a b
@[inline] def ωge [Cmp2 α β] (a : α) (b : β) : IO Bool := Cmp2.ge a b
@[inline] def ωeqv [Eq2 α β] (a : α) (b : β) : IO Bool := Eq2.eq a b
@[inline] def ωnev [Eq2 α β] (a : α) (b : β) : IO Bool := do return !(← Eq2.eq a b)
@[inline] def ωorElse [Nullable α] (a : α) (b : IO α) : IO α := orElse a b
@[inline] def ωtern (c : Bool) (a b : IO α) : IO α := tern c a b
@[inline] def ωinstOf (x : Value) (c : String) : IO Bool := instOf x c
@[inline] def ωtoValue [ToValue α] (x : α) : Value := toValue x
@[inline] def ωlst (xs : Array α) : IO (RList α) := lst xs
@[inline, elab_without_expected_type] def ωitems [Items α β] (x : α) : IO (Array β) := Items.items x
@[inline] def ωrrange (n : Float) : IO (RList Float) := rrange n
@[inline] def ωrfilled (n : Float) (v : α) : IO (RList α) := rfilled n v
@[inline] def ωnatF (n : Nat) : Float := natF n
@[inline] def ωrangeN (x : Float) : Nat := rangeN x
@[inline] def ωfailV [ToStr α] (x : α) : IO β := failV x
@[inline] def ωparseNumber (s : String) : Float := parseNumber s
@[inline] def ωtoStr [ToStr α] (x : α) : IO String := toStr x
@[inline] def ωfromCodepoints (xs : RList Float) : IO String := fromCodepoints xs

end OrbitMines.Physics
