  | _ => false

@[inline] def arg (a : Array Value) (i : Nat) : Value := a.getD i .null
@[inline] def sink (_ : Value) : IO Unit := pure ()
@[inline] def wr (r : IO.Ref Value) (v : Value) : IO Value := do r.set v; return .null
