/*
 * VULKAN: the kernels in GLSL 450 with descriptor-set bindings. In Python they run through wgpu's
 * Vulkan backend (naga compiles the GLSL), with the same runtime as WebGPU.
 */
Vulkan: Backend = class {
  name = "Vulkan"
  kernel = GLSL
  head = "#version 450"
  declarations = "layout(std140, set = 0, binding = 0) uniform ParBlock {{ uint cells; uint A; uint N; uint K; float DEG; uint holes; uint tick; uint pad; }} P;\nlayout(std430, set = 0, binding = 1) buffer StBlock {{ float st[]; }};\nlayout(std430, set = 0, binding = 2) buffer CelBlock {{ float cel[]; }};\nlayout(std430, set = 0, binding = 3) readonly buffer DirBlock {{ vec4 dir[]; }};"
  supports (language: Language): boolean => language.name == "Python"
  runtime_for (language: Language): String => {
    return @./implementation/gen/backends/gpu.runtime.py if language.name == "Python"
    None
  }
  kernels (theory: Theory): String => Kernels.build(this, theory)
}
