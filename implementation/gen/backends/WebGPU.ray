/*
 * WEBGPU: the continuous model on the GPU through WebGPU, in WGSL. The kernels are Kernels.ray in
 * WGSL's pieces; each host language adds a runtime template (device, buffers, the pass order read
 * off the text's manifest, readback).
 */
WebGPU: Backend = class {
  name = "WebGPU"
  kernel = WGSL
  head = ""
  declarations = "struct Par {{ cells: u32, A: u32, N: u32, K: u32, DEG: f32, holes: u32, tick: u32, tags: u32, z: u32, entries: u32, outs: u32, bod: u32, beam: u32, whom: u32, track: u32, rungs: u32, span: u32, part: u32, first: u32, fill: u32 }}\n@group(0) @binding(0) var<uniform> P: Par;\n@group(0) @binding(1) var<storage, read_write> st: array<f32>;\n@group(0) @binding(2) var<storage, read_write> cel: array<f32>;\n@group(0) @binding(3) var<storage, read> dir: array<vec4<f32>>;\n@group(0) @binding(4) var<storage, read_write> ho: array<f32>;\n@group(0) @binding(5) var<storage, read_write> hn: array<f32>;\n@group(0) @binding(6) var<storage, read_write> link: array<atomic<i32>>;\n@group(0) @binding(7) var<storage, read_write> sb0: array<u32>;\n@group(0) @binding(8) var<storage, read_write> sb1: array<u32>;\n@group(0) @binding(9) var<storage, read_write> sb2: array<u32>;\n@group(0) @binding(10) var<storage, read_write> sb3: array<u32>;\n@group(0) @binding(11) var<storage, read_write> sb4: array<u32>;\n@group(0) @binding(12) var<storage, read_write> sb5: array<u32>;\n@group(0) @binding(13) var<storage, read_write> sb6: array<u32>;\n@group(0) @binding(14) var<storage, read_write> sb7: array<u32>;"
  supports (language: Language): boolean => language.name == "TypeScript" | language.name == "Python"
  runtime_for (language: Language): String => {
    return @./implementation/gen/backends/webgpu.runtime.ts if language.name == "TypeScript"
    return @./implementation/gen/backends/gpu.runtime.py if language.name == "Python"
    None
  }
  kernels (theory: Theory): String => Kernels.build(this, theory)
}
