/*
 * THE KERNELS - one tick of the continuous model (Field.ray) as compute kernels, written once in the
 * pieces of a shader language (gen/languages/Shader.ray) and the declarations of a backend. What a
 * kernel computes is exactly what the Field computes, in the tick's own structure - one thing a tick:
 * every pass reads the world the tick opened with (`was`); what the tick makes stands where it was made
 * (`dN`); what it takes is gone before anything moves (`taken`, `absorbed`); only what opened the tick
 * and was not taken is carried, by the transport rule's own draw. One thread per cell, or per (way,
 * cell); every write is to the thread's own place, so there are no atomics and the same text runs on
 * every API. No kernel knows what a body does: the source rules run on the host (Bodies, Field.ray)
 * between GATHER and APPLY, where the manifest's tick has a `|`.
 *
 * Buffers: `st` holds planes of cells*A floats - n, was, dN, the fold record, taken, absorbed, emitted,
 * then per tag above the vacuum's its own population and what its bodies put down, and one scratch
 * plane; `cel` the ledgers per cell - rho, folds, space, gone, keep, blocks, cross, then what arrived per
 * tag (the vacuum's own first); `dir` the headings (cos, sin, this tick's step), the bodies' cells, and
 * the entries the source rules made; `P` the sizes, `tags`, `z` (which tag a `NAME@z` pass is over) and
 * how many entries there are.
 */

Kernels := class {
  static SLOT_RHO = 0
  static SLOT_FOLDS = 1
  static SLOT_SPACE = 2
  static SLOT_GONE = 3
  static SLOT_KEEP = 4
  static SLOT_BLOCKS = 5
  static SLOT_CROSS = 6
  /* the fixed slots; after them (7 + z) what arrived of tag z (0 the vacuum's own) */
  static SLOTS = 7
  static MAXH = 64
  static IND = "  "
  /* the passes of one tick, in the theory's own rule order: what each rule's terms need, then the rule's pass; a rule about a source is the host's (`|`) */
  static tick_of (theory: Theory, terms: Array): String[] => {
    passes := ["SNAP", "CLEAR", "SWEEP", "TOTAL"]
    Array.range(theory.rules.length).for(k => {
      rule := theory.rules[k]
      if rule.over == "Boundary" { passes.push("GATHER"); passes.push("|"); passes.push("APPLY") }
      elsif rule.over == "Source" { }
      else {
        ts := terms.filter(t => t.rule != None & t.rule.id == rule.id)
        if ts.some(t => !t.settles & !t.transport & t.degree == 2) { passes.push("MEET{k}"); passes.push("TAKE") }
        if ts.some(t => !t.settles & !t.transport & t.degree != 2 & !t.outside) { passes.push("CREATE{k}") }
        if ts.some(t => t.transport) { passes.push("LOCATE"); passes.push("CARRY"); passes.push("FUNNEL"); passes.push("TAGCARRY@z"); passes.push("TAGFUNNEL@z") }
      }
    })
    /* the tick's output, all at once: what arrived and everything made; then the world as it stands, for a readback */
    ["SETTLE", "SNAP", "SWEEP", "ARRIVED"].for(nm => { passes.push(nm) })
    passes
  }

  /* the whole text for a backend: its head, the language's preamble, its declarations, the helpers, the kernels */
  static build (b: Backend, theory: Theory): String => {
    d := b.kernel
    eq := theory.equation
    acting := eq.terms.filter(t => !t.settles & !t.transport)
    point := acting.filter(t => t.degree != 2 & !t.outside)
    meets := acting.filter(t => t.degree == 2)
    carrying := eq.terms.filter(t => t.transport).first
    turned := carrying == None ? "kept" : carrying.turned
    tick := Kernels.tick_of(theory, eq.terms).join(" ")
    helpers := Kernels.helpers(d)
    terms := Array.range(meets.length).map(k => Kernels.meet_fns(d, k, meets[k])).concat(Array.range(point.length).map(k => Kernels.point_fns(d, k, point[k]))).join("\n\n")
    /* one CREATE and one MEET per rule that has such terms, so each fires once, in its rule's turn */
    per_rule := []
    Array.range(theory.rules.length).for(k => {
      rule := theory.rules[k]
      mine := Array.range(meets.length).filter(i => meets[i].rule != None & meets[i].rule.id == rule.id)
      per_rule.push(Kernels.kernel(d, "MEET{k}", "cells", Kernels.meet(d, mine))) if !mine.empty
      pts := Array.range(point.length).filter(i => point[i].rule != None & point[i].rule.id == rule.id)
      per_rule.push(Kernels.kernel(d, "CREATE{k}", "cells", Kernels.create(d, point, pts))) if !pts.empty
    })
    kernels := [
      Kernels.kernel(d, "SNAP", "cells*A", Kernels.snap(d)),
      Kernels.kernel(d, "CLEAR", "cells", Kernels.clear(d)),
      Kernels.kernel(d, "SWEEP", "cells", Kernels.sweep(d)),
      Kernels.kernel(d, "GATHER", "holes*A", Kernels.gather(d)),
      Kernels.kernel(d, "APPLY", "one", Kernels.apply(d)),
      per_rule.join("\n\n"),
      Kernels.kernel(d, "TAKE", "cells*A", Kernels.take(d)),
      Kernels.kernel(d, "TOTAL", "cells", Kernels.total(d)),
      Kernels.kernel(d, "LOCATE", "cells", Kernels.locate(d)),
      Kernels.kernel(d, "CARRY", "cells*A", Kernels.carry(d, turned)),
      Kernels.kernel(d, "FUNNEL", "cells*A", Kernels.funnel(d)),
      Kernels.kernel(d, "TAGCARRY", "cells*A", Kernels.tagcarry(d, turned)),
      Kernels.kernel(d, "TAGFUNNEL", "cells*A", Kernels.tagfunnel(d)),
      Kernels.kernel(d, "SETTLE", "cells*A", Kernels.settle(d)),
      Kernels.kernel(d, "ARRIVED", "cells", Kernels.arrived(d))
    ].join("\n\n")
    preamble := d.preamble
    /* the medium - the derived equation on a box (Medium.ray) - as kernels of its own beside the rules' own, where the shader language has the closed laws' code (Shaded.wgsl): its helpers with the common text, before any kernel, since a runtime compiles every kernel with what stands before the first */
    medium_helpers := d.name == "WGSL" ? "\n\n{Kernels.medium_helpers(d, theory)}" : ""
    medium_kernels := d.name == "WGSL" ? "\n\n{Kernels.medium_kernels(d, theory)}" : ""
    "//! tick {tick}\n{b.head}\n{preamble}\n\n{b.declarations}\n\n{helpers}\n\n{terms}{medium_helpers}\n\n{kernels}{medium_kernels}\n"
  }

  /*
   * THE MEDIUM'S KERNELS (Medium.ray, on the device): the continuous model integrated heading by heading, tick by
   * tick, term by term, as the CPU medium does it - the same terms turned into functions here. The pass order is the
   * manifest `//! medium`; a runtime binds `st` as planes of cells*A (the planes - 0 the vacuum's rays, 1.. a body's -
   * then a scratch plane, the population as the tick opened, each plane as it opened, the record per way, the record
   * as it opened, and two planes of what each end grew and destroyed; `P.tags` is the planes plus one), `cel` as the
   * ledgers (density and record as the tick opened, the draw's mean turn, the record, blocks, the pair's destroyed
   * space, then what each plane holds, then the world's growth) and after them four numbers per body (its lean and how
   * far the growth carried it), `dir` as the headings, the bodies (x, y, mass, plane), the constants (nf_inf, rho_inf,
   * DEG, NEAR, -, -, D, -, omega, where the bodies' numbers begin) and the entries a body's shining makes
   */
  static MEDIUM_EXTRAS = 20
  static MEDIUM_CN (law: Aggregate): N => ((Kernels.MEDIUM_EXTRAS + 3) / 4).floor
  /* the steps that take a point on with its ray (Medium.trading) */
  static medium_trades (theory: Theory): Array => theory.equation.terms.filter(t => t.doing.trades)
  static medium_terms (theory: Theory, degree: N): Array => theory.equation.terms.filter(t => !t.settles & !t.transport & !t.outside & !t.doing.trades & t.degree == degree)
  /* one term as functions of the local's (rho, nf): its share, and what one firing does to rays, folds, space and growth */
  /* what a source announces, as a function of the body's own beta: the same terms the CPU's `per_way` reads (Medium.per_way) */
  static medium_source_fns (d: Language, name: String, t: *): String => {
    b_ := d.arg("b_", "f32")
    sym := "let rho: f32 = 0.0;\nlet nf: f32 = 0.0;\nlet F: f32 = select(1.0, xc(5u), xc(5u) > 0.0);\nlet omega: f32 = xc(8u);\nlet beta: f32 = b_;\nlet DEG: f32 = P.DEG;"
    share := t.doing.share.as(d)
    rays := t.doing.rays.as(d)
    [
      d.func("{name}_share", "{b_}", "f32", "{sym}\nreturn clamp({share}, 0.0, 1.0);"),
      d.func("{name}_rays", "{b_}", "f32", "{sym}\nreturn {rays};")
    ].join("\n\n")
  }

  static medium_fns (d: Language, name: String, t: *): String => {
    rho_ := d.arg("rho", "f32")
    nf_ := d.arg("nf", "f32")
    params := "{rho_}, {nf_}"
    sym := "let F: f32 = select(1.0, xc(5u), xc(5u) > 0.0);\nlet omega: f32 = xc(8u);\nlet beta: f32 = 0.0;\nlet DEG: f32 = P.DEG;"
    share := t.doing.share.as(d)
    rays := t.doing.rays.as(d)
    folds := t.doing.folds.as(d)
    space := t.doing.space.as(d)
    grew := t.doing.grew.as(d)
    sets := t.doing.sets ? "true" : "false"
    flag := name.upper
    [
      d.func("{name}_share", params, "f32", "{sym}\nreturn clamp({share}, 0.0, 1.0);"),
      d.func("{name}_rays", params, "f32", "{sym}\nreturn {rays};"),
      d.func("{name}_folds", params, "f32", "{sym}\nreturn {folds};"),
      d.func("{name}_space", params, "f32", "{sym}\nreturn {space};"),
      d.func("{name}_grew", params, "f32", "{sym}\nreturn {grew};"),
      "const {flag}_SETS: bool = {sets};"
    ].join("\n\n")
  }
  static medium_helpers (d: Language, theory: Theory): String => {
    law := Aggregate.of(theory)
    CN := Kernels.MEDIUM_CN(law)
    maxh := Kernels.MAXH
    near := Shaded.literal(law.NEAR)
    meets := Kernels.medium_terms(theory, 2)
    points := Kernels.medium_terms(theory, 0)
    singles := Kernels.medium_terms(theory, 1)
    fm := Array.range(meets.length).map(k => Kernels.medium_fns(d, "mmeet{k}", meets[k]))
    fp := Array.range(points.length).map(k => Kernels.medium_fns(d, "mpoint{k}", points[k]))
    fs := Array.range(singles.length).map(k => Kernels.medium_fns(d, "msingle{k}", singles[k]))
    sources := theory.equation.terms.filter(t => t.outside)
    fo := Array.range(sources.length).map(k => Kernels.medium_source_fns(d, "msource{k}", sources[k]))
    way_code := Array.range(sources.length).map(k => "got = got * msource{k}_share(b_) * msource{k}_rays(b_);").join("\n")
    per_way := "fn mper_way(mass: f32, b_: f32) -> f32 {{\n  var got: f32 = mass / P.DEG;\n{way_code}\n  return got;\n}}"
    fns := fm.concat(fp).concat(fs).concat(fo).concat([per_way]).join("\n\n")
    [
      "//! medium MKEEP MCARRY MOPEN MMEET MUNFOLD MMAKE MMOVE MSTEP MBLOCK",
      Shaded.helpers,
      "const MAXH: u32 = {maxh}u;",
      "const CN: u32 = {CN}u;",
      "fn xc(k: u32) -> f32 {{ return dir[P.A + 2u * MAXH + k / 4u][k % 4u]; }}",
      fns,
      "fn mcell(x: i32, y: i32) -> i32 {{ if (x < 0 || y < 0 || x >= i32(P.N) || y >= i32(P.N)) {{ return -1; }} return y * i32(P.N) + x; }}",
      /* the planes of st: the record, and what still stands of it. What a body has sent is not of a cell at all - it is one number a c-bar out from that body (Medium.beam) */
      "fn mplanes() -> u32 {{ return P.tags - 1u; }}",
      "fn at_plane(p: u32, c: u32) -> u32 {{ return p * P.cells + c; }}",
      "fn FOLD() -> u32 {{ return 0u; }}",
      "fn STAND() -> u32 {{ return 1u; }}",
      /* what a body has sent, at a distance from it in c-bar, read between the rungs it is kept on (Medium.sent_at) */
      "fn RUNGS() -> u32 {{ return P.rungs; }}",
      /* a body's own numbers, on the device: where it is, its mass and its plane; what it carries, and whether it moves */
      "fn BODS() -> u32 {{ return P.bod; }}",
      "fn bodat(h: u32) -> vec4<f32> {{ let b: u32 = BODS() + 12u * h; return vec4<f32>(cel[b], cel[b + 1u], cel[b + 2u], cel[b + 3u]); }}",
      "fn bodgo(h: u32) -> vec4<f32> {{ let b: u32 = BODS() + 12u * h; return vec4<f32>(cel[b + 4u], cel[b + 5u], cel[b + 6u], cel[b + 7u]); }}",
      /* how big it is, in c-bar - its rays leave its face and not its middle - and what that size lets out of it (Medium.face_of, Medium.skin_of) */
      "fn bodface(h: u32) -> f32 {{ return cel[BODS() + 12u * h + 8u]; }}",
      "fn bodskin(h: u32) -> f32 {{ return cel[BODS() + 12u * h + 9u]; }}",
      /* AND THE SAME READ WHERE THE FIELD IS: the mismatch is measured against a_0 over the acceleration THERE, which
       * is the lean the medium left at that place last tick - weak field, large factor; strong field, none (Medium.recur_at) */
      "fn mrecur(px: f32, py: f32, gn: f32) -> f32 {{\n  if (xc(19u) < 1.5 || gn <= 0.0) {{ return 1.0; }}\n  let a0: f32 = xc(17u);\n  if (a0 <= 0.0) {{ return 1.0; }}\n  let gx: f32 = mtapc(2u, px, py, 0.0);\n  let gy: f32 = mtapc(3u, px, py, 0.0);\n  let was: f32 = sqrt(gx * gx + gy * gy);\n  /* g = sqrt(g_N(g + a_0)): the same line as g = g_N(1 + a_0/g), written as the mean it is, and the form that settles */\n  return sqrt(gn * (was + a0)) / gn;\n}}",
      /* WHAT A BODY'S OWN GOING DOES TO WHAT IT SENDS: the phase between its pulses and the vacuum's only piles up
       * while the rate of flipping keeps changing, which is what it is accelerating at - and what it accelerates at
       * is what the others' fields leave under it, so the two close on each other (Medium.drifting) */
      "fn mdrift(h: u32) -> f32 {{\n  if (xc(19u) < 0.5 || xc(19u) > 1.5) {{ return 1.0; }}\n  let gx: f32 = cel[P.outs + 4u * h];\n  let gy: f32 = cel[P.outs + 4u * h + 1u];\n  let g: f32 = sqrt(gx * gx + gy * gy);\n  let a0: f32 = xc(17u);\n  if (g <= 0.0 || a0 <= 0.0) {{ return 1.0; }}\n  return 1.0 + a0 / g;\n}}",
      "fn facing_out(z: u32) -> f32 {{ let h: i32 = whom(z); if (h < 0) {{ return {near}; }} return max({near}, bodface(u32(h))); }}",
      /* where each body stood on each of the last ticks, kept on the device: a reading a tick would cost more than the tick */
      "const TRACKED: u32 = 4096u;",
      "fn TRACK(t: u32, h: u32) -> u32 {{ return P.track + (t % TRACKED) * MAXH * 4u + h * 4u; }}",
      /* whose rays a plane holds, looked up rather than searched for: a step reads this for every plane at every cell */
      "fn whom(z: u32) -> i32 {{ return i32(cel[P.whom + z]); }}",
      /* what a body has sent is kept twice over, and a tick reads the one it wrote: the beat's own two halves */
      "fn BEAMAT(z: u32, r: u32) -> u32 {{ return P.beam + z * RUNGS() + r; }}",
      "fn BEAMWAS(z: u32, r: u32) -> u32 {{ return P.beam + P.span + z * RUNGS() + r; }}",
      "fn msent(z: u32, r: f32) -> f32 {{\n  let n: u32 = RUNGS();\n  let i: f32 = floor(r);\n  if (i < 0.0) {{ return 0.0; }}\n  let k: u32 = u32(i);\n  if (k + 1u >= n) {{ return 0.0; }}\n  let f: f32 = r - i;\n  let over: f32 = xc(6u) - 1.0;\n  let face: f32 = facing_out(z);\n  let here: f32 = pow(max(face, r), over);\n  let was: f32 = cel[BEAMAT(z, k)] * pow(max(face, i), over);\n  let next: f32 = cel[BEAMAT(z, k + 1u)] * pow(max(face, i + 1.0), over);\n  if (here <= 0.0) {{ return 0.0; }}\n  return (was * (1.0 - f) + next * f) / here;\n}}",
      "fn mact(x: f32) -> f32 {{ return clamp(x, 0.0, 1.0); }}",
      /* a plane read by area at a true position in cells, with what stands across the box's edge (Medium.tap) */
      "fn mtap(p: u32, px: f32, py: f32, outside: f32) -> f32 {{\n  let x0: i32 = i32(floor(px));\n  let y0: i32 = i32(floor(py));\n  let fx: f32 = px - floor(px);\n  let fy: f32 = py - floor(py);\n  let base: u32 = p * P.cells;\n  var got: f32 = 0.0;\n  let c00: i32 = mcell(x0, y0);\n  let c10: i32 = mcell(x0 + 1, y0);\n  let c01: i32 = mcell(x0, y0 + 1);\n  let c11: i32 = mcell(x0 + 1, y0 + 1);\n  got = got + (1.0 - fx) * (1.0 - fy) * select(outside, st[base + u32(max(c00, 0))], c00 >= 0);\n  got = got + fx * (1.0 - fy) * select(outside, st[base + u32(max(c10, 0))], c10 >= 0);\n  got = got + (1.0 - fx) * fy * select(outside, st[base + u32(max(c01, 0))], c01 >= 0);\n  got = got + fx * fy * select(outside, st[base + u32(max(c11, 0))], c11 >= 0);\n  return got;\n}}",
      /* a ledger of cel read by area */
      "fn mtapc(slot: u32, px: f32, py: f32, outside: f32) -> f32 {{\n  let x0: i32 = i32(floor(px));\n  let y0: i32 = i32(floor(py));\n  let fx: f32 = px - floor(px);\n  let fy: f32 = py - floor(py);\n  let base: u32 = slot * P.cells;\n  var got: f32 = 0.0;\n  let c00: i32 = mcell(x0, y0);\n  let c10: i32 = mcell(x0 + 1, y0);\n  let c01: i32 = mcell(x0, y0 + 1);\n  let c11: i32 = mcell(x0 + 1, y0 + 1);\n  got = got + (1.0 - fx) * (1.0 - fy) * select(outside, cel[base + u32(max(c00, 0))], c00 >= 0);\n  got = got + fx * (1.0 - fy) * select(outside, cel[base + u32(max(c10, 0))], c10 >= 0);\n  got = got + (1.0 - fx) * fy * select(outside, cel[base + u32(max(c01, 0))], c01 >= 0);\n  got = got + fx * fy * select(outside, cel[base + u32(max(c11, 0))], c11 >= 0);\n  return got;\n}}",
      /* the way out from the body whose rays are on plane z, at a place, and how far the place stands from it (Medium.out_from) */
      "fn mout(z: u32, px: f32, py: f32) -> vec3<f32> {{\n  let h: i32 = whom(z);\n  if (h < 0) {{ return vec3<f32>(0.0, 0.0, 0.0); }}\n  let o: vec4<f32> = bodat(u32(h));\n  let dx: f32 = px - o.x;\n  let dy: f32 = py - o.y;\n  let d: f32 = sqrt(dx * dx + dy * dy);\n  let face: f32 = max({near}, bodface(u32(h)));\n  if (d <= 0.0) {{ return vec3<f32>(0.0, 0.0, face); }}\n  return vec3<f32>(dx / d, dy / d, max(face, d / f32(P.K)));\n}}",
      /* how much two bundles of rays face each other: what their ways have in common, one met head on by the other (Medium.facing_share) */
      "fn mfacing(ax: f32, ay: f32, bx: f32, by: f32) -> f32 {{\n  let wide: f32 = 6.283185307179586 / P.DEG;\n  let ux: f32 = -bx;\n  let uy: f32 = -by;\n  let angle: f32 = abs(atan2(ax * uy - ay * ux, ax * ux + ay * uy));\n  return max(0.0, 1.0 - angle / wide);\n}}",
      "fn munder(h: u32, k: u32) -> i32 {{\n  let o: vec4<f32> = bodat(h);\n  let half: i32 = i32((P.K - 1u) / 2u);\n  let x: i32 = i32(floor(o.x + 0.5)) - half + i32(k % P.K);\n  let y: i32 = i32(floor(o.y + 0.5)) - half + i32(k / P.K);\n  return mcell(x, y);\n}}"
    ].join("\n\n")
  }

  static medium_kernels (d: Language, theory: Theory): String => {
    near := Shaded.literal(Aggregate.of(theory).NEAR)
    meets := Kernels.medium_terms(theory, 2)
    points := Kernels.medium_terms(theory, 0)
    singles := Kernels.medium_terms(theory, 1)
    meet_code := Array.range(meets.length).map(k => "{{\n  let w: f32 = mmeet{k}_share(rho, nf) * mact(mine) * mact(theirs) * over;\n  fold = fold + w * mmeet{k}_folds(rho, nf) / 2.0;\n  grew = grew + w * mmeet{k}_space(rho, nf) / 2.0;\n  gone = gone + w * abs(mmeet{k}_folds(rho, nf)) / 2.0;\n}}").join("\n")
    unfold_code := Array.range(points.length).map(k => "{{\n  let back: f32 = mpoint{k}_folds(rho, nf);\n  if (back != 0.0) {{ h = h + mpoint{k}_share(rho, nf) * back; }}\n}}").join("\n")
    point_code := Array.range(points.length).map(k => "grown = grown + mpoint{k}_share(rho, nf) * mpoint{k}_space(rho, nf);").join("\n")
    single_code := Array.range(singles.length).map(k => "grown = grown + msingle{k}_share(rho, nf) * rho * msingle{k}_space(rho, nf);").join("\n")
    rate_code := Array.range(meets.length).map(k => "rate = rate + mmeet{k}_share(rho, nf) * mmeet{k}_folds(rho, nf) / 2.0;").join("\n")
    [
      /* MOVE, as the tick before it left it: a body turned by the lean it read, and carried there (Medium.move) */
      Kernels.kernel(d, "MSTEP", "one", "if (i >= 1u) {{ return; }}\nlet out: u32 = P.outs;\nfor (var h: u32 = 0u; h < P.holes; h = h + 1u) {{\n  let g: vec4<f32> = bodgo(h);\n  let o: vec4<f32> = bodat(h);\n  let b: u32 = BODS() + 12u * h;\n  if (g.z >= 0.5) {{\n    var px: f32 = g.x + cel[out + 4u * h] * o.z;\n    var py: f32 = g.y + cel[out + 4u * h + 1u] * o.z;\n    let m: f32 = sqrt(px * px + py * py);\n    if (m > o.z) {{ px = px * o.z / m; py = py * o.z / m; }}\n    cel[b + 4u] = px;\n    cel[b + 5u] = py;\n    cel[b] = o.x + px / o.z * f32(P.K);\n    cel[b + 1u] = o.y + py / o.z * f32(P.K);\n  }}\n  /* and where that leaves it is kept, this tick's own place on the track */\n  let tr: u32 = TRACK(P.tick, h);\n  cel[tr] = cel[b];\n  cel[tr + 1u] = cel[b + 1u];\n  cel[tr + 2u] = cel[b + 4u];\n  cel[tr + 3u] = cel[b + 5u];\n}}"),
      /* where the bodies stand, a cell at a time: what a cell is blocked by, and whose rays are its own (Medium.block) */
      Kernels.kernel(d, "MBLOCK", "cells", "let c: u32 = i;\nif (i >= P.cells) {{ return; }}\nlet x: i32 = i32(c % P.N);\nlet y: i32 = i32(c / P.N);\nlet half: i32 = i32((P.K - 1u) / 2u);\nvar b: f32 = 0.0;\nvar pl: f32 = 0.0;\nfor (var h: u32 = 0u; h < P.holes; h = h + 1u) {{\n  let o: vec4<f32> = bodat(h);\n  if (abs(x - i32(floor(o.x + 0.5))) <= half && abs(y - i32(floor(o.y + 0.5))) <= half) {{ b = f32(h + 1u); pl = o.w; }}\n}}\ncel[5u * P.cells + c] = b;\ncel[(8u + mplanes()) * P.cells + c] = pl;"),
      /* what was sent, kept as it stands while it is carried on */
      Kernels.kernel(d, "MKEEP", "rungs", "let n: u32 = RUNGS();\nif (i >= mplanes() * n) {{ return; }}\nlet z: u32 = i / n;\nlet r: u32 = i % n;\ncel[BEAMWAS(z, r)] = cel[BEAMAT(z, r)];"),
      /* STREAM and SHINE: what was sent goes a c-bar on, thinned over the shell it crosses, and a body announces on the first rung out (Medium.stream, Medium.shine) */
      Kernels.kernel(d, "MCARRY", "rungs", "let n: u32 = RUNGS();\nif (i >= mplanes() * n) {{ return; }}\nlet z: u32 = i / n;\nlet r: u32 = i % n;\nvar v: f32 = 0.0;\nif (z == 0u) {{ v = 0.0; }} else if (r == 0u) {{\n  for (var h: u32 = 0u; h < P.holes; h = h + 1u) {{\n    let o: vec4<f32> = bodat(h);\n    if (u32(o.w) != z) {{ continue; }}\n    let g: vec4<f32> = bodgo(h);\n    let beta: f32 = min(1.0, sqrt(g.x * g.x + g.y * g.y) / o.z);\n    v = v + mper_way(o.z, beta) * bodskin(h) * mdrift(h);\n  }}\n}} else {{\n  let D: f32 = xc(6u);\n  let face: f32 = facing_out(z);\n  let here: f32 = max(face, f32(r));\n  let back: f32 = max(face, f32(r) - 1.0);\n  v = cel[BEAMWAS(z, r - 1u)] * pow(back / here, D - 1.0);\n}}\ncel[BEAMAT(z, r)] = min(1.0, v);"),
      /* THE BOX AS THE TICK OPENED: every step reads these (Medium.open) */
      Kernels.kernel(d, "MOPEN", "cells", "let c: u32 = i;\nif (i >= P.cells) {{ return; }}\nlet x: f32 = f32(c % P.N);\nlet y: f32 = f32(c / P.N);\nvar got: f32 = 0.0;\nfor (var z: u32 = 1u; z < mplanes(); z = z + 1u) {{\n  let way: vec3<f32> = mout(z, x, y);\n  if (way.z <= 0.0) {{ continue; }}\n  got = got + msent(z, way.z);\n}}\ncel[c] = min(1.0, mact(got) + xc(4u) * xc(1u));\ncel[1u * P.cells + c] = st[at_plane(FOLD(), c)] + xc(4u) * xc(0u);\ncel[6u * P.cells + c] = 0.0;\ncel[(7u + mplanes()) * P.cells + c] = 0.0;"),
      /* MEET: one body's rays against another's, as much as their ways overlap (Medium.meet) */
      Kernels.kernel(d, "MMEET", "cells", "let c: u32 = i;\nif (i >= P.cells) {{ return; }}\nlet x: f32 = f32(c % P.N);\nlet y: f32 = f32(c / P.N);\nlet rho: f32 = cel[c];\nlet nf: f32 = cel[1u * P.cells + c];\nvar fold: f32 = 0.0;\nvar grew: f32 = 0.0;\nvar gone: f32 = 0.0;\nfor (var z: u32 = 1u; z < mplanes(); z = z + 1u) {{\n  let way: vec3<f32> = mout(z, x, y);\n  if (way.z <= 0.0) {{ continue; }}\n  let mine: f32 = msent(z, way.z);\n  if (mine <= 0.0) {{ continue; }}\n  for (var yy: u32 = 1u; yy < mplanes(); yy = yy + 1u) {{\n    if (yy == z) {{ continue; }}\n    let their: vec3<f32> = mout(yy, x, y);\n    if (their.z <= 0.0) {{ continue; }}\n    let theirs: f32 = msent(yy, their.z);\n    if (theirs <= 0.0) {{ continue; }}\n    /* the two only meet where their ways have something in common, which is a turn of the lattice's own at most: the rest of the box is skipped before any of it is worked out */\n    if (-(way.x * their.x + way.y * their.y) <= cos(6.283185307179586 / P.DEG)) {{ continue; }}\n    let over: f32 = mfacing(way.x, way.y, their.x, their.y);\n    if (over <= 0.0) {{ continue; }}\n{meet_code}\n  }}\n  /* and against the vacuum's own rays, which stand on every way there is (Medium.meet) */\n  if (xc(4u) > 0.5) {{\n    let theirs: f32 = xc(1u);\n    let over: f32 = 1.0 / P.DEG;\n{meet_code}\n  }}\n}}\nst[at_plane(FOLD(), c)] = max(0.0, st[at_plane(FOLD(), c)] + fold);\ncel[6u * P.cells + c] = gone;\ncel[(7u + mplanes()) * P.cells + c] = grew;"),
      /* UNFOLD: in a dark half creation hands back the folds a point holds (Medium.unfold) */
      Kernels.kernel(d, "MUNFOLD", "cells", "let c: u32 = i;\nif (i >= P.cells) {{ return; }}\nlet rho: f32 = cel[c];\nlet nf: f32 = cel[1u * P.cells + c];\nvar h: f32 = 0.0;\nif (P.tick % 2u == 1u) {{\n{unfold_code}\n}}\nst[at_plane(FOLD(), c)] = max(0.0, st[at_plane(FOLD(), c)] + h);\nst[at_plane(STAND(), c)] = max(0.0, nf + h);"),
      /* what is to be carried, kept as it stands (Medium.stream) */
      /* STREAM: one c-bar on, the way out from the body it came from, thinned over the shell it crosses (Medium.stream) */
      /* MAKE: what the point terms grow, per local (Medium.make) */
      Kernels.kernel(d, "MMAKE", "cells", "let c: u32 = i;\nif (i >= P.cells) {{ return; }}\nlet rho: f32 = cel[c];\nlet nf: f32 = cel[1u * P.cells + c];\nvar grown: f32 = cel[(7u + mplanes()) * P.cells + c];\n{point_code}\n{single_code}\ncel[(7u + mplanes()) * P.cells + c] = grown;"),
      /* SOURCE: what a body announces stands where it truly is (Medium.shine) */
      /* a way holds at most one ray out of the beat's phase (Medium.shine) */
      /* where a point at each cell is going, for what a panel draws (Medium.lean) */
      Kernels.kernel(d, "MLEAN", "cells", "let c: u32 = i;\nif (i >= P.cells) {{ return; }}\nlet x: f32 = f32(c % P.N);\nlet y: f32 = f32(c / P.N);\nlet zown: u32 = u32(cel[(8u + mplanes()) * P.cells + c]);\nlet rho: f32 = cel[c];\nlet nf: f32 = cel[1u * P.cells + c];\nvar rate: f32 = 0.0;\n{rate_code}\nlet stood: f32 = st[at_plane(STAND(), c)];\nvar gx: f32 = 0.0;\nvar gy: f32 = 0.0;\nfor (var z: u32 = 1u; z < mplanes(); z = z + 1u) {{\n  if (z == zown) {{ continue; }}\n  let way: vec3<f32> = mout(z, x, y);\n  if (way.z <= 0.0) {{ continue; }}\n  let share: f32 = rate * mact(msent(z, way.z)) / (1.0 + stood);\n  gx = gx - share * way.x;\n  gy = gy - share * way.y;\n}}\nlet f: f32 = mrecur(x, y, sqrt(gx * gx + gy * gy));\ncel[2u * P.cells + c] = gx * f;\ncel[3u * P.cells + c] = gy * f;\ncel[4u * P.cells + c] = st[at_plane(FOLD(), c)];"),
      /* MOVE: where each body's point is going, read where it truly stands (Medium.pull_at) */
      Kernels.kernel(d, "MMOVE", "one", "if (i >= 1u) {{ return; }}\nlet out: u32 = P.outs;\nlet half: f32 = f32(P.K - 1u) / 2.0;\nfor (var h: u32 = 0u; h < P.holes; h = h + 1u) {{\n  let o: vec4<f32> = bodat(h);\n  let zown: u32 = u32(o.w);\n  var gx: f32 = 0.0;\n  var gy: f32 = 0.0;\n  for (var k: u32 = 0u; k < P.K * P.K; k = k + 1u) {{\n    let px: f32 = o.x - half + f32(k % P.K);\n    let py: f32 = o.y - half + f32(k / P.K);\n    let rho: f32 = mtapc(0u, px, py, 0.0);\n    let nf: f32 = mtapc(1u, px, py, 0.0);\n    var rate: f32 = 0.0;\n{rate_code}\n    let stood: f32 = mtap(STAND(), px, py, 0.0);\n    for (var z: u32 = 1u; z < mplanes(); z = z + 1u) {{\n      if (z == zown) {{ continue; }}\n      let way: vec3<f32> = mout(z, px, py);\n      if (way.z <= 0.0) {{ continue; }}\n      let tx: f32 = -way.x;\n      let ty: f32 = -way.y;\n      let share: f32 = rate * mact(msent(z, way.z)) / (1.0 + stood);\n      gx = gx + share * tx;\n      gy = gy + share * ty;\n    }}\n  }}\n  let n: f32 = f32(P.K * P.K);\n  let f: f32 = mrecur(o.x, o.y, sqrt(gx * gx + gy * gy) / n);\n  cel[out + 4u * h] = gx / n * f;\n  cel[out + 4u * h + 1u] = gy / n * f;\n}}"),
      /* the same where the host asks, with the named plane left out (Medium.pull_at) */
      Kernels.kernel(d, "MPROBE", "entries", "if (i >= P.entries) {{ return; }}\nlet ask: vec4<f32> = dir[P.A + 2u * MAXH + CN + i];\nlet zown: u32 = u32(ask.z);\nlet half: f32 = f32(P.K - 1u) / 2.0;\nvar gx: f32 = 0.0;\nvar gy: f32 = 0.0;\nfor (var k: u32 = 0u; k < P.K * P.K; k = k + 1u) {{\n  let px: f32 = ask.x - half + f32(k % P.K);\n  let py: f32 = ask.y - half + f32(k / P.K);\n  let rho: f32 = mtapc(0u, px, py, 0.0);\n  let nf: f32 = mtapc(1u, px, py, 0.0);\n  var rate: f32 = 0.0;\n{rate_code}\n  let stood: f32 = mtap(STAND(), px, py, 0.0);\n  for (var z: u32 = 1u; z < mplanes(); z = z + 1u) {{\n    if (z == zown) {{ continue; }}\n    let way: vec3<f32> = mout(z, px, py);\n    if (way.z <= 0.0) {{ continue; }}\n    let share: f32 = rate * mact(msent(z, way.z)) / (1.0 + stood);\n    gx = gx - share * way.x;\n    gy = gy - share * way.y;\n  }}\n}}\nlet n: f32 = f32(P.K * P.K);\nlet f: f32 = mrecur(ask.x, ask.y, sqrt(gx * gx + gy * gy) / n);\nlet out: u32 = P.outs + 4u * MAXH;\ncel[out + 2u * i] = gx / n * f;\ncel[out + 2u * i + 1u] = gy / n * f;"),
      /* what a panel reads: what each body has sent, at each cell */
      Kernels.kernel(d, "MSWEEP", "cells", "let c: u32 = i;\nif (i >= P.cells) {{ return; }}\nlet x: f32 = f32(c % P.N);\nlet y: f32 = f32(c / P.N);\ncel[7u * P.cells + c] = 0.0;\nfor (var z: u32 = 1u; z < mplanes(); z = z + 1u) {{\n  let way: vec3<f32> = mout(z, x, y);\n  cel[(7u + z) * P.cells + c] = select(0.0, msent(z, way.z), way.z > 0.0);\n}}")
    ].join("\n\n")
  }


  static kernel (d: Language, nm: String, over: String, body: String): String => {
    entry := d.entry(nm, body)
    "//! kernel {nm} over {over}\n{entry}"
  }

  /* a ledger of a cell */
  static slot (k: N, c: String): String => "cel[{k}u * P.cells + {c}]"
  static guard (bound: String): String => "if (i >= {bound}) {{ return; }}"

  /* the helpers: indices into the planes, the steps, the headings, what moves, and whose rays meet */
  static helpers (d: Language): String => {
    cp := d.ctx_params
    ca := d.ctx_args
    a_ := d.arg("a", "u32")
    b_ := d.arg("b", "u32")
    c_ := d.arg("c", "u32")
    z_ := d.arg("z", "u32")
    ac := "{cp}{a_}, {c_}"
    ca_ := "{cp}{c_}, {a_}"
    zac := "{cp}{z_}, {a_}, {c_}"
    index := [
      d.func("nA", ac, "u32", "return a * P.cells + c;"),
      d.func("wA", ac, "u32", "return P.cells * P.A + a * P.cells + c;"),
      d.func("dA", ac, "u32", "return 2u * P.cells * P.A + a * P.cells + c;"),
      d.func("fA", ac, "u32", "return 3u * P.cells * P.A + a * P.cells + c;"),
      d.func("tA", ac, "u32", "return 4u * P.cells * P.A + a * P.cells + c;"),
      d.func("aA", ac, "u32", "return 5u * P.cells * P.A + a * P.cells + c;"),
      d.func("eA", ac, "u32", "return 6u * P.cells * P.A + a * P.cells + c;"),
      d.func("kA", ac, "u32", "return 7u * P.cells * P.A + a * P.cells + c;"),
      d.func("gA", ac, "u32", "return 8u * P.cells * P.A + a * P.cells + c;"),
      d.func("bA", zac, "u32", "return (9u + 2u * z) * P.cells * P.A + a * P.cells + c;"),
      d.func("beA", zac, "u32", "return (10u + 2u * z) * P.cells * P.A + a * P.cells + c;"),
      /* how much of cell c its neighbour across a has swallowed (Field.swallow), and the scratch plane after it */
      d.func("swA", ac, "u32", "return (9u + 2u * (P.tags - 1u)) * P.cells * P.A + a * P.cells + c;"),
      d.func("sA", ac, "u32", "return (10u + 2u * (P.tags - 1u)) * P.cells * P.A + a * P.cells + c;")
    ]
    /* one step, on the grid: a step lands by area on the four cells around its true position - `tap(c, a, sign, k)` is the k-th of them, or -1, and `tapw` its weight; past the window's edge a tap is left out */
    k_ := d.arg("k", "u32")
    sign_ := d.arg("sign", "f32")
    px := d.fix("px", "f32", "f32_of_u(c % P.N) + sign * dir[a].z")
    py := d.fix("py", "f32", "f32_of_u(c / P.N) + sign * dir[a].w")
    x0 := d.fix("x0", "i32", "i32_of_f(floor(px))")
    y0 := d.fix("y0", "i32", "i32_of_f(floor(py))")
    tx := d.fix("tx", "i32", "x0 + i32_of_u(k % 2u)")
    ty := d.fix("ty", "i32", "y0 + i32_of_u(k / 2u)")
    edge := "if (tx < 0 || ty < 0 || tx >= i32_of_u(P.N) || ty >= i32_of_u(P.N)) {{ return -1; }}\nreturn ty * i32_of_u(P.N) + tx;"
    tap := d.func("tap", "{cp}{c_}, {a_}, {sign_}, {k_}", "i32", "{px}\n{py}\n{x0}\n{y0}\n{tx}\n{ty}\n{edge}")
    fx := d.fix("fx", "f32", "px - floor(px)")
    fy := d.fix("fy", "f32", "py - floor(py)")
    wx := d.fix("wx", "f32", "select(1.0 - fx, fx, (k % 2u) == 1u)")
    wy := d.fix("wy", "f32", "select(1.0 - fy, fy, (k / 2u) == 1u)")
    tapw := d.func("tapw", "{cp}{c_}, {a_}, {sign_}, {k_}", "f32", "{px}\n{py}\n{fx}\n{fy}\n{wx}\n{wy}\nreturn wx * wy;")
    opp := d.func("opp", "{cp}{a_}", "u32", "return (a + P.A / 2u) % P.A;")
    /* how far the way across a from c leads into space c has swallowed: its fold there as a share of one point (Field.owns) */
    owns := d.func("owns", "{cp}{c_}, {a_}", "f32", "return clampf(st[gA({ca}a, c)] * (P.DEG / f32_of_u(P.A)), 0.0, 1.0);")
    /* the cell one whole step across a from c, hops rounded away from nought (Field.hop_from), or -1 past the window */
    hx := d.fix("hx", "i32", "i32_of_f(select(-floor(0.5 - dir[a].z), floor(dir[a].z + 0.5), dir[a].z >= 0.0))")
    hy := d.fix("hy", "i32", "i32_of_f(select(-floor(0.5 - dir[a].w), floor(dir[a].w + 0.5), dir[a].w >= 0.0))")
    hxx := d.fix("tx", "i32", "i32_of_u(c % P.N) + hx")
    hyy := d.fix("ty", "i32", "i32_of_u(c / P.N) + hy")
    hopc := d.func("hopc", "{cp}{c_}, {a_}", "i32", "{hx}\n{hy}\n{hxx}\n{hyy}\nif (tx < 0 || ty < 0 || tx >= i32_of_u(P.N) || ty >= i32_of_u(P.N)) {{ return -1; }}\nreturn ty * i32_of_u(P.N) + tx;")
    /* what stands at (a, c) as the rules so far have left it: what opened the tick, less what was taken - by meetings, and by sources */
    m0 := d.mut("m", "f32", "0.0")
    view := d.func("view", ac, "f32", "{m0}\nm = st[wA({ca}a, c)] + st[tA({ca}a, c)] + st[aA({ca}a, c)];\nreturn maxf(0.0, m);")
    moving := d.func("moving", ac, "f32", "return view({ca}a, c);")
    /* one tag's share of that */
    had0 := d.mut("had", "f32", "0.0")
    whole0 := d.mut("whole", "f32", "0.0")
    f0 := d.mut("f", "f32", "0.0")
    of_tag := "{had0}\n{whole0}\nhad = st[bA({ca}z, a, c)];\nwhole = st[wA({ca}a, c)];\nif (had <= 0.0 || whole <= 0.0) {{ return 0.0; }}\n{f0}\nf = (whole + st[tA({ca}a, c)] + st[aA({ca}a, c)]) / whole;\nif (f < 0.0) {{ f = 0.0; }}\nreturn had * f;"
    moving_of := d.func("moving_of", zac, "f32", of_tag)
    /* how much of a meeting between the rays at i and j is the first body against another */
    i_ := d.arg("i", "u32")
    j_ := d.arg("j", "u32")
    wi := d.fix("wi", "f32", "st[P.cells * P.A + i]")
    wj := d.fix("wj", "f32", "st[P.cells * P.A + j]")
    alli0 := d.mut("alli", "f32", "0.0")
    allj0 := d.mut("allj", "f32", "0.0")
    each_z := d.loop("z", "P.tags - 1u", "alli = alli + st[(9u + 2u * z) * P.cells * P.A + i];\nallj = allj + st[(9u + 2u * z) * P.cells * P.A + j];")
    f1i := d.fix("f1i", "f32", "st[9u * P.cells * P.A + i] / wi")
    f1j := d.fix("f1j", "f32", "st[9u * P.cells * P.A + j] / wj")
    crossing_body := "if (P.tags < 3u) {{ return 0.0; }}\n{wi}\n{wj}\nif (wi <= 0.0 || wj <= 0.0) {{ return 0.0; }}\n{f1i}\n{f1j}\n{alli0}\n{allj0}\n{each_z}\nalli = alli / wi;\nallj = allj / wj;\nreturn f1i * (allj - f1j) + (alli - f1i) * f1j;"
    crossing := d.func("crossing", "{cp}{i_}, {j_}", "f32", crossing_body)
    /* how much of what stood at i as the tick opened a source put there: the bodies' share of the way (Field.bodily) */
    bw := d.fix("w", "f32", "st[P.cells * P.A + i]")
    bsum0 := d.mut("b", "f32", "0.0")
    bsum := d.loop("z", "P.tags - 1u", "b = b + st[(9u + 2u * z) * P.cells * P.A + i];")
    bodily := d.func("bodily", "{cp}{i_}", "f32", "{bw}\nif (w <= 0.0) {{ return 0.0; }}\n{bsum0}\n{bsum}\nreturn clampf(b / w, 0.0, 1.0);")
    index.concat([tap, tapw, opp, owns, hopc, view, moving, moving_of, crossing, bodily]).join("\n\n")
  }

  /* the symbols a term is read against, at a cell whose density and folds are given */
  static symbols (d: Language): String => [d.fix("F", "f32", "1.0"), d.fix("omega", "f32", "1.0"), d.fix("beta", "f32", "0.0"), d.fix("DEG", "f32", "P.DEG")].join("\n")

  /* one meeting term as four functions of (rho, nf): its gate, and what it does to rays, space, folds */
  static meet_fns (d: Language, k: N, t: *): String => {
    cp := d.ctx_params
    rho_ := d.arg("rho", "f32")
    nf_ := d.arg("nf", "f32")
    params := "{cp}{rho_}, {nf_}"
    sym := Kernels.symbols(d)
    gate := t.doing.share.as(d)
    rays := t.doing.rays.as(d)
    space := t.doing.space.as(d)
    folds := t.doing.folds.as(d)
    [
      d.func("meet{k}_gate", params, "f32", "{sym}\nreturn clampf({gate}, 0.0, 1.0);"),
      d.func("meet{k}_rays", params, "f32", "{sym}\nreturn {rays};"),
      d.func("meet{k}_space", params, "f32", "{sym}\nreturn {space};"),
      d.func("meet{k}_folds", params, "f32", "{sym}\nreturn {folds};")
    ].join("\n\n")
  }

  /* a point term's gate as a function of (rho, nf), for reading it at a way */
  static point_fns (d: Language, k: N, t: *): String => {
    cp := d.ctx_params
    rho_ := d.arg("rho", "f32")
    nf_ := d.arg("nf", "f32")
    sym := Kernels.symbols(d)
    gate := t.doing.share.as(d)
    d.func("point{k}_gate", "{cp}{rho_}, {nf_}", "f32", "{sym}\nreturn clampf({gate}, 0.0, 1.0);")
  }

  static snap (d: Language): String => {
    guard := Kernels.guard("P.cells * P.A")
    wipe := d.loop("z", "P.tags - 1u", "st[(10u + 2u * z) * P.cells * P.A + i] = 0.0;")
    "{guard}\nst[P.cells * P.A + i] = st[i];\nst[8u * P.cells * P.A + i] = st[3u * P.cells * P.A + i];\nst[2u * P.cells * P.A + i] = 0.0;\nst[4u * P.cells * P.A + i] = 0.0;\nst[5u * P.cells * P.A + i] = 0.0;\nst[6u * P.cells * P.A + i] = 0.0;\nst[7u * P.cells * P.A + i] = 0.0;\n{wipe}"
  }

  static sweep (d: Language): String => {
    ca := d.ctx_args
    c_ := d.fix("c", "u32", "i")
    guard := Kernels.guard("P.cells")
    s0 := d.mut("s", "f32", "0.0")
    sum := d.loop("a", "P.A", "s = s + clampf(st[wA({ca}a, c)], 0.0, 1.0);")
    rho := Kernels.slot(Kernels.SLOT_RHO, "c")
    "{c_}\n{guard}\n{s0}\n{sum}\n{rho} = s / f32_of_u(P.A);"
  }

  /* what stands on every heading at each body's cell, laid out per body for the host: the source rules run there */
  static gather (d: Language): String => {
    ca := d.ctx_args
    lines := [
      Kernels.guard("P.holes * P.A"),
      d.fix("h", "u32", "i / P.A"),
      d.fix("a", "u32", "i % P.A"),
      d.fix("cx", "i32", "i32_of_f(dir[P.A + h].x)"),
      d.fix("cy", "i32", "i32_of_f(dir[P.A + h].y)"),
      "st[sA({ca}0u, i)] = 0.0;",
      "st[sA({ca}0u, P.holes * P.A + i)] = 0.0;",
      "if (cx < 0 || cy < 0 || cx >= i32_of_u(P.N) || cy >= i32_of_u(P.N)) {{ return; }}",
      d.fix("c", "u32", "u32_of_i(cy) * P.N + u32_of_i(cx)"),
      "st[sA({ca}0u, i)] = view({ca}a, c);",
      /* and the folds there as the tick opened, after what stands: what a body's step leans on */
      "st[sA({ca}0u, P.holes * P.A + i)] = st[gA({ca}a, c)];",
      /* and the folds at the point across each heading, one block of A per (body, heading): the space around a body, as its rules ask it */
      d.fix("nx", "i32", "cx + i32_of_f(select(-floor(0.5 - dir[a].z), floor(dir[a].z + 0.5), dir[a].z >= 0.0))"),
      d.fix("ny", "i32", "cy + i32_of_f(select(-floor(0.5 - dir[a].w), floor(dir[a].w + 0.5), dir[a].w >= 0.0))"),
      d.fix("inside", "u32", "select(0u, 1u, nx >= 0 && ny >= 0 && nx < i32_of_u(P.N) && ny < i32_of_u(P.N))"),
      d.fix("nc", "u32", "select(0u, u32_of_i(ny) * P.N + u32_of_i(nx), inside == 1u)"),
      d.loop("b", "P.A", "st[sA({ca}0u, 2u * P.holes * P.A + i * P.A + b)] = select(0.0, st[gA({ca}b, nc)], inside == 1u);"),
      /* and how much of that neighbour its own neighbours have swallowed, per heading: where a landing there is a landing in (Field.drift_at) */
      d.loop("b", "P.A", "st[sA({ca}0u, (2u + P.A) * P.holes * P.A + i * P.A + b)] = select(0.0, st[swA({ca}b, nc)], inside == 1u);"),
      /* and how much of the body's own cell each of its neighbours has swallowed: where the cell it stands on is going (Field.sinks_at) */
      "st[sA({ca}0u, (2u + 2u * P.A) * P.holes * P.A + i)] = st[swA({ca}a, c)];"
    ]
    lines.join("\n")
  }

  /* what the source rules did, applied - by ONE thread, in order: two entries may land on the same (heading, cell) - a source's light on another's cell it is absorbing at - and threads adding to one place lose updates. An entry is (index into a plane, amount, tag, kind): kind 0 takes (absorbs) rays on a heading at a cell, kind 1 lights them there */
  static apply (d: Language): String => {
    maxh := Kernels.MAXH
    /* the ways, the bodies twice over and the closure's own constants stand before what the rules ask to be applied - the same place the medium keeps them (Kernels.medium_helpers), so both worlds read one layout */
    cn := ((Kernels.MEDIUM_EXTRAS + 3) / 4).floor
    each := [
      d.fix("k", "u32", "u32_of_i(i32_of_f(dir[P.A + 2u * {maxh}u + {cn}u + e].x))"),
      d.fix("amount", "f32", "dir[P.A + 2u * {maxh}u + {cn}u + e].y"),
      d.fix("tag", "i32", "i32_of_f(dir[P.A + 2u * {maxh}u + {cn}u + e].z)"),
      d.fix("kind", "f32", "dir[P.A + 2u * {maxh}u + {cn}u + e].w"),
      "st[2u * P.cells * P.A + k] = st[2u * P.cells * P.A + k] + amount;",
      "if (kind < 0.5) {{",
      "  st[5u * P.cells * P.A + k] = st[5u * P.cells * P.A + k] + amount;",
      "}} else {{",
      "  st[6u * P.cells * P.A + k] = st[6u * P.cells * P.A + k] + amount;",
      "  if (tag > 0 && tag < i32_of_u(P.tags)) {{ st[(10u + 2u * u32_of_i(tag - 1)) * P.cells * P.A + k] = st[(10u + 2u * u32_of_i(tag - 1)) * P.cells * P.A + k] + amount; }}",
      "}}"
    ].join("\n")
    guard := Kernels.guard("1u")
    loop := d.loop("e", "P.entries", each)
    "{guard}\n{loop}"
  }

  /* the point terms: on the cell, against rho^degree; rays over every way, space to the ledger, folds to every way */
  /* the point terms: on the cell, against rho^degree; rays over every way - SET where the term sets, so a way gains what it lacked -, space to the ledger, folds to every way. What is made stands where it is made */
  static create (d: Language, point: Array, which: N[]): String => {
    ca := d.ctx_args
    ind := Kernels.IND
    lines := which.map(k => {
      t := point[k]
      share := t.doing.share.as(d)
      rays := t.doing.rays.as(d)
      space := t.doing.space.as(d)
      folds := t.doing.folds.as(d)
      power := t.degree == 0 ? "1.0" : (t.degree == 1 ? "rho" : "rho * rho")
      fires := d.fix("fires{k}", "f32", "clampf({share}, 0.0, 1.0) * {power}")
      /* a term that sets a way is read AT the way: its share with rho the way's own activity - one factor, the way's room (Field.create) */
      made := t.doing.sets ? "clampf(point{k}_gate({ca}clampf(st[wA({ca}a, c)], 0.0, 1.0), nf), 0.0, 1.0) * {power}" : "fires{k}"
      spread := d.loop("a", "P.A", "st[dA({ca}a, c)] = st[dA({ca}a, c)] + {made} * ({rays}) / DEG;").indent(ind)
      df := d.fix("df{k}", "f32", "fires{k} * ({folds}) / DEG")
      bend := d.loop("a", "P.A", "st[fA({ca}a, c)] = maxf(0.0, st[fA({ca}a, c)] + df{k});").indent(ind)
      "{fires}\nif (fires{k} > 0.0) {{\n{spread}\n  dSpace = dSpace + fires{k} * ({space});\n  {df}\n{bend}\n}}"
    }).join("\n")
    blocks := Kernels.slot(Kernels.SLOT_BLOCKS, "c")
    space := Kernels.slot(Kernels.SLOT_SPACE, "c")
    [
      d.fix("c", "u32", "i"),
      Kernels.guard("P.cells"),
      d.fix("rho", "f32", Kernels.slot(Kernels.SLOT_RHO, "c")),
      d.fix("nf", "f32", Kernels.slot(Kernels.SLOT_FOLDS, "c")),
      Kernels.symbols(d),
      d.mut("dSpace", "f32", "0.0"),
      lines,
      "{space} = {space} + dSpace;"
    ].join("\n")
  }

  /* the folds of a cell: the sum over its ways; and what a heading keeps of itself there */
  static total (d: Language): String => {
    ca := d.ctx_args
    c_ := d.fix("c", "u32", "i")
    guard := Kernels.guard("P.cells")
    nf0 := d.mut("nf", "f32", "0.0")
    sum := d.loop("b", "P.A", "nf = nf + maxf(0.0, st[gA({ca}b, c)]);")
    folds := Kernels.slot(Kernels.SLOT_FOLDS, "c")
    keep := Kernels.slot(Kernels.SLOT_KEEP, "c")
    /* a heading stands for DEG/A edges: a point's folds are DEG times the headings' mean */
    "{c_}\n{guard}\n{nf0}\n{sum}\nnf = nf * (P.DEG / f32_of_u(P.A));\n{folds} = nf;\n{keep} = 1.0 / (1.0 + nf);"
  }

  /*
   * WHERE EACH POINT IS, after the tick's meetings and before anything moves (Field.locate): how much of a cell is
   * inside hubs is what its neighbours' standing folds on the ways back add up to (one point at most); which way
   * it is inside them follows this tick's folding where there is any - a point's hub is whichever folded it last -
   * and the standing record where there is none. The total is kept (slot 7 + tags) for the funnel
   */
  static locate (d: Language): String => {
    ca := d.ctx_args
    c_ := d.fix("c", "u32", "i")
    guard := Kernels.guard("P.cells")
    h_ := d.fix("h", "i32", "hopc({ca}c, b)")
    j_ := d.fix("j", "u32", "opp({ca}b) * P.cells + u32_of_i(h)")
    s_ := d.fix("s", "f32", "select(0.0, clampf(st[8u * P.cells * P.A + j] * (P.DEG / f32_of_u(P.A)), 0.0, 1.0), h >= 0)")
    r_ := d.fix("r", "f32", "select(0.0, maxf(0.0, (st[3u * P.cells * P.A + j] - st[8u * P.cells * P.A + j]) * (P.DEG / f32_of_u(P.A))), h >= 0)")
    tot0 := d.mut("total", "f32", "0.0")
    now0 := d.mut("now", "f32", "0.0")
    count := d.loop("b", "P.A", "{h_}\n{j_}\n{s_}\n{r_}\ntotal = total + s;\nnow = now + r;")
    /* how much of the point is inside hubs this tick is what this tick's folding made it, one point at most (Field.locate) */
    inside := d.fix("inside", "f32", "clampf(now, 0.0, 1.0)")
    put := d.loop("b", "P.A", "{h_}\n{j_}\n{s_}\n{r_}\nst[swA({ca}b, c)] = select(0.0, inside * r / now, now > 0.0);")
    kept := "cel[(7u + P.tags) * P.cells + c] = inside;"
    "{c_}\n{guard}\n{tot0}\n{now0}\n{count}\n{inside}\n{put}\n{kept}"
  }

  /* the meeting terms: the ray at a cell on a heading against the ray facing it - the opposite heading one step on, or its mirror beyond the window's edge; each end takes its own half of what one match does */
  static meet (d: Language, which: N[]): String => {
    ca := d.ctx_args
    ind := Kernels.IND
    blocks_to := Kernels.slot(Kernels.SLOT_BLOCKS, "u32_of_i(to)")
    per := which.map(k => {
      w := d.fix("w", "f32", "clampf(st[wA({ca}a, c)], 0.0, 1.0) * facing * meet{k}_gate({ca}rho, nf)")
      ds := d.fix("ds", "f32", "w * meet{k}_space({ca}rho, nf) / 2.0")
      /* which end swallows: the point whose ray a source lit keeps the space - a property of the ray, not of whose source; two of a kind fold evenly (Field.meet); a point folds once */
      mine := d.fix("mine", "f32", "0.5 + 0.5 * (bodily({ca}a * P.cells + c) - there_b)")
      inner := "{w}\nif (w > 0.0) {{\n  st[kA({ca}a, c)] = st[kA({ca}a, c)] + w * meet{k}_rays({ca}rho, nf) / 2.0;\n  {ds}\n  dSpace = dSpace + ds * (P.DEG / f32_of_u(P.A));\n  {mine}\n  st[fA({ca}a, c)] = maxf(0.0, st[fA({ca}a, c)] + w * meet{k}_folds({ca}rho, nf) * mine);\n  gone = gone + maxf(0.0, w * meet{k}_folds({ca}rho, nf) / 2.0) * (P.DEG / f32_of_u(P.A));\n  cross = cross + maxf(0.0, w * meet{k}_folds({ca}rho, nf) / 2.0) * (P.DEG / f32_of_u(P.A)) * mixed / maxf(facing, 0.000000000001);\n}}".indent(ind)
      o := d.fix("o", "u32", "opp({ca}a)")
      facing0 := d.mut("facing", "f32", "0.0")
      mixed0 := d.mut("mixed", "f32", "0.0")
      inside0 := d.mut("inside", "f32", "0.0")
      to := d.fix("to", "i32", "tap({ca}c, a, 1.0, q)")
      tw := d.fix("tw", "f32", "tapw({ca}c, a, 1.0, q)")
      j := d.fix("j", "u32", "o * P.cells + u32_of_i(to)")
      aj := d.fix("aj", "f32", "clampf(st[P.cells * P.A + j], 0.0, 1.0)")
      blocks_to := Kernels.slot(Kernels.SLOT_BLOCKS, "u32_of_i(to)")
      there0 := d.mut("there_b", "f32", "0.0")
      /* a source is transparent: its cells are met on like any other */
      taps := d.loop("q", "4u", "{to}\n{tw}\nif (to >= 0) {{\n  inside = inside + tw;\n  {j}\n  {aj}\n  facing = facing + tw * aj;\n  mixed = mixed + tw * aj * crossing({ca}a * P.cells + c, j);\n  there_b = there_b + tw * bodily({ca}j);\n}}")
      jm := d.fix("jm", "u32", "o * P.cells + c")
      am := d.fix("am", "f32", "clampf(st[P.cells * P.A + jm], 0.0, 1.0)")
      mirror := "if (inside < 1.0) {{\n  {jm}\n  {am}\n  facing = facing + (1.0 - inside) * am;\n  mixed = mixed + (1.0 - inside) * am * crossing({ca}a * P.cells + c, jm);\n  there_b = there_b + (1.0 - inside) * bodily({ca}jm);\n}}"
      d.loop("a", "P.A", "{o}\n{facing0}\n{mixed0}\n{inside0}\n{there0}\n{taps}\n{mirror}\n{inner}")
    }).join("\n")
    blocks := Kernels.slot(Kernels.SLOT_BLOCKS, "c")
    space := Kernels.slot(Kernels.SLOT_SPACE, "c")
    gone_s := Kernels.slot(Kernels.SLOT_GONE, "c")
    cross_s := Kernels.slot(Kernels.SLOT_CROSS, "c")
    [
      d.fix("c", "u32", "i"),
      Kernels.guard("P.cells"),
      d.fix("rho", "f32", Kernels.slot(Kernels.SLOT_RHO, "c")),
      d.fix("nf", "f32", Kernels.slot(Kernels.SLOT_FOLDS, "c")),
      d.mut("dSpace", "f32", "0.0"),
      d.mut("gone", "f32", "0.0"),
      d.mut("cross", "f32", "0.0"),
      per,
      "{space} = {space} + dSpace;",
      "{gone_s} = {gone_s} + gone;",
      "{cross_s} = {cross_s} + cross;"
    ].join("\n")
  }

  /* what this tick destroys starts at nought, once per tick before any rule */
  static clear (d: Language): String => {
    gone := Kernels.slot(Kernels.SLOT_GONE, "i")
    cross := Kernels.slot(Kernels.SLOT_CROSS, "i")
    guard := Kernels.guard("P.cells")
    "{guard}\n{gone} = 0.0;\n{cross} = 0.0;"
  }

  /* what one rule's meetings took, taken - after the pass, so every meeting of the rule read the world as the rule found it */
  static take (d: Language): String => {
    guard := Kernels.guard("P.cells * P.A")
    "{guard}\nst[4u * P.cells * P.A + i] = st[4u * P.cells * P.A + i] + st[7u * P.cells * P.A + i];\nst[7u * P.cells * P.A + i] = 0.0;"
  }

  /* the transport rule's own draw, gathered: from one step back along the heading what was kept straight on, and from one step back across each way what was turned along it - the heading kept */
  static gathering (d: Language, pop: String, turned: String): String => {
    ca := d.ctx_args
    keep_src := Kernels.slot(Kernels.SLOT_KEEP, "u32_of_i(src)")
    src := d.fix("src", "i32", "tap({ca}c, a, -1.0, q)")
    sw := d.fix("sw", "f32", "tapw({ca}c, a, -1.0, q)")
    from_src := pop.replace("SRC", "u32_of_i(src)").replace("HEAD", "a")
    /* straight on from one step back, for the share of that way that leads to the point across and not through it */
    straight := d.loop("q", "4u", "{src}\nif (src >= 0) {{\n  {sw}\n  got = got + sw * {from_src} * {keep_src} * (1.0 - owns({ca}u32_of_i(src), a));\n}}")
    /* and from two steps back, THROUGH the point that cell swallowed on this heading: straight on, and what was turned onto this way there */
    keep_src2 := Kernels.slot(Kernels.SLOT_KEEP, "u32_of_i(src2)")
    src2 := d.fix("src2", "i32", "tap({ca}c, a, -2.0, q)")
    sw2 := d.fix("sw2", "f32", "tapw({ca}c, a, -2.0, q)")
    from_src2 := pop.replace("SRC", "u32_of_i(src2)").replace("HEAD", "a")
    if turned == "way" {
      fa := d.fix("fa", "f32", "st[gA({ca}a, u32_of_i(src2))]")
      from_b := pop.replace("SRC", "u32_of_i(src2)").replace("HEAD", "b")
      every := d.loop("b", "P.A", "got = got + sw2 * {from_b} * fa * {keep_src2} * (P.DEG / f32_of_u(P.A));")
      through := d.loop("q", "4u", "{src2}\nif (src2 >= 0) {{\n  {sw2}\n  got = got + sw2 * {from_src2} * {keep_src2} * owns({ca}u32_of_i(src2), a);\n  {fa}\n  if (fa > 0.0) {{\n{every.indent(Kernels.IND)}\n  }}\n}}")
      return "{straight}\n{through}"
    }
    through := d.loop("q", "4u", "{src2}\nif (src2 >= 0) {{\n  {sw2}\n  got = got + sw2 * {from_src2} * {keep_src2} * owns({ca}u32_of_i(src2), a);\n}}")
    sd := d.fix("sd", "i32", "tap({ca}c, w, -2.0, q)")
    dw := d.fix("dw", "f32", "tapw({ca}c, w, -2.0, q)")
    fd := d.fix("fd", "f32", "st[gA({ca}w, u32_of_i(sd))]")
    keep_sd := Kernels.slot(Kernels.SLOT_KEEP, "u32_of_i(sd)")
    from_sd := pop.replace("SRC", "u32_of_i(sd)").replace("HEAD", "a")
    across := d.loop("q", "4u", "{sd}\nif (sd >= 0) {{\n  {fd}\n  if (fd > 0.0) {{\n    {dw}\n    got = got + dw * {from_sd} * fd * {keep_sd} * (P.DEG / f32_of_u(P.A));\n  }}\n}}")
    turned_ := d.loop("w", "P.A", across)
    "{straight}\n{through}\n{turned_}"
  }
  static carry (d: Language, turned: String): String => {
    ca := d.ctx_args
    guard := Kernels.guard("P.cells * P.A")
    a_ := d.fix("a", "u32", "i / P.cells")
    c_ := d.fix("c", "u32", "i % P.cells")
    got0 := d.mut("got", "f32", "0.0")
    gather := Kernels.gathering(d, "moving({ca}HEAD, SRC)", turned)
    "{guard}\n{a_}\n{c_}\n{got0}\n{gather}\nst[sA({ca}a, c)] = got;"
  }
  static tagcarry (d: Language, turned: String): String => {
    ca := d.ctx_args
    guard := Kernels.guard("P.cells * P.A")
    a_ := d.fix("a", "u32", "i / P.cells")
    c_ := d.fix("c", "u32", "i % P.cells")
    got0 := d.mut("got", "f32", "0.0")
    gather := Kernels.gathering(d, "moving_of({ca}P.z, HEAD, SRC)", turned)
    "{guard}\n{a_}\n{c_}\n{got0}\n{gather}\nst[sA({ca}a, c)] = got;"
  }
  /* and back into its own plane - after the pass, since the pass reads the plane it is replacing */
  /* what landed on a swallowed cell landed in the hub that swallowed it, keeping its heading - not back to the one it came through (Field.funnelled): from the scratch, where a carry left what landed, to where it stands */
  static funnelling (d: Language, into: String): String => {
    ca := d.ctx_args
    guard := Kernels.guard("P.cells * P.A")
    a_ := d.fix("a", "u32", "i / P.cells")
    c_ := d.fix("c", "u32", "i % P.cells")
    stays0 := d.mut("stays", "f32", "1.0")
    got0 := d.mut("got", "f32", "0.0")
    h_ := d.fix("h", "i32", "hopc({ca}c, b)")
    q_ := d.fix("q", "i32", "hopc({ca}c, opp({ca}b))")
    /* a cell inside several hubs splits one ray among them: its shares, less the one it came through, scaled to one where they add past one (Field.funnelled) */
    own := d.fix("own", "f32", "select(0.0, st[swA({ca}opp({ca}a), c)], hopc({ca}c, opp({ca}a)) >= 0)")
    mine_t := d.fix("mine_t", "f32", "cel[(7u + P.tags) * P.cells + c] - own")
    mine_s := d.fix("mine_s", "f32", "select(1.0, 1.0 / mine_t, mine_t > 1.0)")
    q_own := d.fix("q_own", "f32", "select(0.0, st[swA({ca}opp({ca}a), u32_of_i(q))], hopc({ca}u32_of_i(q), opp({ca}a)) >= 0)")
    q_t := d.fix("q_t", "f32", "cel[(7u + P.tags) * P.cells + u32_of_i(q)] - q_own")
    q_s := d.fix("q_s", "f32", "select(1.0, 1.0 / q_t, q_t > 1.0)")
    each := d.loop("b", "P.A", "if (b != opp({ca}a)) {{\n  {h_}\n  if (h >= 0) {{ stays = stays - st[swA({ca}b, c)] * mine_s; }}\n  {q_}\n  if (q >= 0) {{\n    {q_own}\n    {q_t}\n    {q_s}\n    got = got + st[sA({ca}a, u32_of_i(q))] * st[swA({ca}b, u32_of_i(q))] * q_s;\n  }}\n}}")
    "{guard}\n{a_}\n{c_}\n{stays0}\n{got0}\n{own}\n{mine_t}\n{mine_s}\n{each}\n{into} = got + st[sA({ca}a, c)] * maxf(0.0, stays);"
  }
  static funnel (d: Language): String => Kernels.funnelling(d, "st[nA({d.ctx_args}a, c)]")
  static tagfunnel (d: Language): String => Kernels.funnelling(d, "st[bA({d.ctx_args}P.z, a, c)]")

  /* what the tick made stands where it was made, beside what arrived: rays are counted, a way holds many */
  static settle (d: Language): String => {
    guard := Kernels.guard("P.cells * P.A")
    tags := d.loop("z", "P.tags - 1u", "st[(9u + 2u * z) * P.cells * P.A + i] = st[(9u + 2u * z) * P.cells * P.A + i] + st[(10u + 2u * z) * P.cells * P.A + i];")
    "{guard}\nst[i] = st[i] + st[2u * P.cells * P.A + i];\n{tags}"
  }

  /* what stands at a cell that came from each tag: the vacuum's own is what is not any body's */
  static arrived (d: Language): String => {
    ca := d.ctx_args
    c_ := d.fix("c", "u32", "i")
    guard := Kernels.guard("P.cells")
    total0 := d.mut("total", "f32", "0.0")
    others0 := d.mut("others", "f32", "0.0")
    got0 := d.mut("got", "f32", "0.0")
    whole := d.loop("a", "P.A", "total = total + st[nA({ca}a, c)];")
    per := d.loop("a", "P.A", "got = got + st[bA({ca}z, a, c)];")
    tags := d.loop("z", "P.tags - 1u", "got = 0.0;\n{per}\nothers = others + got;\ncel[(8u + z) * P.cells + c] = got * (P.DEG / f32_of_u(P.A));")
    "{c_}\n{guard}\n{total0}\n{others0}\n{got0}\n{whole}\n{tags}\ncel[7u * P.cells + c] = maxf(0.0, total - others) * (P.DEG / f32_of_u(P.A));"
  }
}
