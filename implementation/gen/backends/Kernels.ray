/*
 * THE KERNELS - one tick of the continuous model (Field.ray) as compute kernels, written once in the
 * pieces of a shader language (gen/languages/Shader.ray) and the declarations of a backend. What a
 * kernel computes is exactly what the Field computes, in the tick's own structure - one thing a tick:
 * every pass reads the world the tick opened with (`was`); what the tick makes stands where it was made
 * (`dN`); what it takes is gone before anything moves (`taken`, `absorbed`); only what opened the tick
 * and was not taken is carried, by the transport rule's own draw. One thread per cell, or per (way,
 * cell); every write is to the thread's own place, so there are no atomics and the same text runs on
 * every API. No kernel knows what a body does: the source rules run on the host (Bodies, Field.ray)
 * between GATHER and APPLY, where the manifest's tick has a `|`.
 *
 * Buffers: `st` holds planes of cells*A floats - n, was, dN, the fold record, taken, absorbed, emitted,
 * then per tag above the vacuum's its own population and what its bodies put down, and one scratch
 * plane; `cel` the ledgers per cell - rho, folds, space, gone, keep, blocks, cross, then what arrived per
 * tag (the vacuum's own first); `dir` the headings (cos, sin, this tick's step), the bodies' cells, and
 * the entries the source rules made; `P` the sizes, `tags`, `z` (which tag a `NAME@z` pass is over) and
 * how many entries there are.
 */

Kernels := class {
  static SLOT_RHO = 0
  static SLOT_FOLDS = 1
  static SLOT_SPACE = 2
  static SLOT_GONE = 3
  static SLOT_KEEP = 4
  static SLOT_BLOCKS = 5
  static SLOT_CROSS = 6
  /* the fixed slots; after them (7 + z) what arrived of tag z (0 the vacuum's own) */
  static SLOTS = 7
  static MAXH = 64
  static IND = "  "
  /* the passes of one tick, in the theory's own rule order: what each rule's terms need, then the rule's pass; a rule about a source is the host's (`|`) */
  static tick_of (theory: Theory, terms: Array): String[] => {
    passes := ["SNAP", "CLEAR", "SWEEP", "TOTAL"]
    Array.range(theory.rules.length).for(k => {
      rule := theory.rules[k]
      if rule.over == "Boundary" { passes.push("GATHER"); passes.push("|"); passes.push("APPLY") }
      elsif rule.over == "Source" { }
      else {
        ts := terms.filter(t => t.rule != None & t.rule.id == rule.id)
        if ts.some(t => !t.settles & !t.transport & t.degree == 2) { passes.push("MEET{k}"); passes.push("TAKE") }
        if ts.some(t => !t.settles & !t.transport & t.degree != 2 & !t.outside) { passes.push("CREATE{k}") }
        if ts.some(t => t.transport) { passes.push("LOCATE"); passes.push("CARRY"); passes.push("FUNNEL"); passes.push("TAGCARRY@z"); passes.push("TAGFUNNEL@z") }
      }
    })
    /* the tick's output, all at once: what arrived and everything made; then the world as it stands, for a readback */
    ["SETTLE", "SNAP", "SWEEP", "ARRIVED"].for(nm => { passes.push(nm) })
    passes
  }

  /* the whole text for a backend: its head, the language's preamble, its declarations, the helpers, the kernels */
  static build (b: Backend, theory: Theory): String => {
    d := b.kernel
    eq := theory.equation
    acting := eq.terms.filter(t => !t.settles & !t.transport)
    point := acting.filter(t => t.degree != 2 & !t.outside)
    meets := acting.filter(t => t.degree == 2)
    carrying := eq.terms.filter(t => t.transport).first
    turned := carrying == None ? "kept" : carrying.turned
    tick := Kernels.tick_of(theory, eq.terms).join(" ")
    helpers := Kernels.helpers(d)
    terms := Array.range(meets.length).map(k => Kernels.meet_fns(d, k, meets[k])).concat(Array.range(point.length).map(k => Kernels.point_fns(d, k, point[k]))).join("\n\n")
    /* one CREATE and one MEET per rule that has such terms, so each fires once, in its rule's turn */
    per_rule := []
    Array.range(theory.rules.length).for(k => {
      rule := theory.rules[k]
      mine := Array.range(meets.length).filter(i => meets[i].rule != None & meets[i].rule.id == rule.id)
      per_rule.push(Kernels.kernel(d, "MEET{k}", "cells", Kernels.meet(d, mine))) if !mine.empty
      pts := Array.range(point.length).filter(i => point[i].rule != None & point[i].rule.id == rule.id)
      per_rule.push(Kernels.kernel(d, "CREATE{k}", "cells", Kernels.create(d, point, pts))) if !pts.empty
    })
    kernels := [
      Kernels.kernel(d, "SNAP", "cells*A", Kernels.snap(d)),
      Kernels.kernel(d, "CLEAR", "cells", Kernels.clear(d)),
      Kernels.kernel(d, "SWEEP", "cells", Kernels.sweep(d)),
      Kernels.kernel(d, "GATHER", "holes*A", Kernels.gather(d)),
      Kernels.kernel(d, "APPLY", "one", Kernels.apply(d)),
      per_rule.join("\n\n"),
      Kernels.kernel(d, "TAKE", "cells*A", Kernels.take(d)),
      Kernels.kernel(d, "TOTAL", "cells", Kernels.total(d)),
      Kernels.kernel(d, "LOCATE", "cells", Kernels.locate(d)),
      Kernels.kernel(d, "CARRY", "cells*A", Kernels.carry(d, turned)),
      Kernels.kernel(d, "FUNNEL", "cells*A", Kernels.funnel(d)),
      Kernels.kernel(d, "TAGCARRY", "cells*A", Kernels.tagcarry(d, turned)),
      Kernels.kernel(d, "TAGFUNNEL", "cells*A", Kernels.tagfunnel(d)),
      Kernels.kernel(d, "SETTLE", "cells*A", Kernels.settle(d)),
      Kernels.kernel(d, "ARRIVED", "cells", Kernels.arrived(d))
    ].join("\n\n")
    preamble := d.preamble
    /* the medium - the derived equation on a box (Medium.ray) - as kernels of its own beside the rules' own, where the shader language has the closed laws' code (Shaded.wgsl): its helpers with the common text, before any kernel, since a runtime compiles every kernel with what stands before the first */
    medium_helpers := d.name == "WGSL" ? "\n\n{Kernels.medium_helpers(d, theory)}" : ""
    medium_kernels := d.name == "WGSL" ? "\n\n{Kernels.medium_kernels(d, theory)}" : ""
    "//! tick {tick}\n{b.head}\n{preamble}\n\n{b.declarations}\n\n{helpers}\n\n{terms}{medium_helpers}\n\n{kernels}{medium_kernels}\n"
  }

  /*
   * THE MEDIUM'S KERNELS (Medium.ray, on the device): the continuous model integrated heading by heading, tick by
   * tick, term by term, as the CPU medium does it - the same terms turned into functions here. The pass order is the
   * manifest `//! medium`; a runtime binds `st` as planes of cells*A (the planes - 0 the vacuum's rays, 1.. a body's -
   * then a scratch plane, the population as the tick opened, each plane as it opened, the record per way, the record
   * as it opened, and two planes of what each end grew and destroyed; `P.tags` is the planes plus one), `cel` as the
   * ledgers (density and record as the tick opened, the draw's mean turn, the record, blocks, the pair's destroyed
   * space, then what each plane holds, then the world's growth) and after them four numbers per body (its lean and how
   * far the growth carried it), `dir` as the headings, the bodies (x, y, mass, plane), the constants (nf_inf, rho_inf,
   * DEG, NEAR, -, -, D, -, omega, where the bodies' numbers begin) and the entries a body's shining makes
   */
  static MEDIUM_EXTRAS = 24
  /*
   * THE MEDIUM'S OWN BODIES: as many as the medium carries (MAXM), every one apart where the medium says so; the track
   * of where each stood is kept for the first TRACKB of them, which is what an orbit is read off
   */
  /* a galaxy's stars, each apart: held where they are the medium's cost does not grow with them, so the room is for a million */
  static MAXM = 1048576
  static TRACKB = 64
  /* the planes one thread of a body's pull works through where every body is apart (MPULLH) */
  static PCHUNK = 64
  static MEDIUM_CN (law: Aggregate): N => ((Kernels.MEDIUM_EXTRAS + 3) / 4).floor
  /* the steps that take a point on with its ray (Medium.trading) */
  static medium_trades (theory: Theory): Array => theory.equation.terms.filter(t => t.doing.trades)
  static medium_terms (theory: Theory, degree: N): Array => theory.equation.terms.filter(t => !t.settles & !t.transport & !t.outside & !t.doing.trades & t.degree == degree)
  /* one term as functions of the local's (rho, nf): its share, and what one firing does to rays, folds, space and growth */
  /* what a source announces, as a function of the body's own beta: the same terms the CPU's `per_way` reads (Medium.per_way) */
  static medium_source_fns (d: Language, name: String, t: *): String => {
    b_ := d.arg("b_", "f32")
    sym := "let rho: f32 = 0.0;\nlet nf: f32 = 0.0;\nlet F: f32 = select(1.0, xc(5u), xc(5u) > 0.0);\nlet omega: f32 = xc(8u);\nlet beta: f32 = b_;\nlet DEG: f32 = P.DEG;"
    share := t.doing.share.as(d)
    rays := t.doing.rays.as(d)
    [
      d.func("{name}_share", "{b_}", "f32", "{sym}\nreturn clamp({share}, 0.0, 1.0);"),
      d.func("{name}_rays", "{b_}", "f32", "{sym}\nreturn {rays};")
    ].join("\n\n")
  }

  static medium_fns (d: Language, name: String, t: *): String => {
    rho_ := d.arg("rho", "f32")
    nf_ := d.arg("nf", "f32")
    params := "{rho_}, {nf_}"
    sym := "let F: f32 = select(1.0, xc(5u), xc(5u) > 0.0);\nlet omega: f32 = xc(8u);\nlet beta: f32 = 0.0;\nlet DEG: f32 = P.DEG;"
    share := t.doing.share.as(d)
    rays := t.doing.rays.as(d)
    folds := t.doing.folds.as(d)
    space := t.doing.space.as(d)
    grew := t.doing.grew.as(d)
    sets := t.doing.sets ? "true" : "false"
    flag := name.upper
    [
      d.func("{name}_share", params, "f32", "{sym}\nreturn clamp({share}, 0.0, 1.0);"),
      d.func("{name}_rays", params, "f32", "{sym}\nreturn {rays};"),
      d.func("{name}_folds", params, "f32", "{sym}\nreturn {folds};"),
      d.func("{name}_space", params, "f32", "{sym}\nreturn {space};"),
      d.func("{name}_grew", params, "f32", "{sym}\nreturn {grew};"),
      "const {flag}_SETS: bool = {sets};"
    ].join("\n\n")
  }
  static medium_helpers (d: Language, theory: Theory): String => {
    law := Aggregate.of(theory)
    CN := Kernels.MEDIUM_CN(law)
    maxh := Kernels.MAXH
    maxm := Kernels.MAXM
    trackb := Kernels.TRACKB
    pchunk := Kernels.PCHUNK
    gather := Medium.GATHER
    near := Shaded.literal(law.NEAR)
    near_cells := Medium.NEAR_CELLS
    meets := Kernels.medium_terms(theory, 2)
    points := Kernels.medium_terms(theory, 0)
    singles := Kernels.medium_terms(theory, 1)
    fm := Array.range(meets.length).map(k => Kernels.medium_fns(d, "mmeet{k}", meets[k]))
    fp := Array.range(points.length).map(k => Kernels.medium_fns(d, "mpoint{k}", points[k]))
    fs := Array.range(singles.length).map(k => Kernels.medium_fns(d, "msingle{k}", singles[k]))
    sources := theory.equation.terms.filter(t => t.outside)
    fo := Array.range(sources.length).map(k => Kernels.medium_source_fns(d, "msource{k}", sources[k]))
    way_code := Array.range(sources.length).map(k => "got = got * msource{k}_share(b_) * msource{k}_rays(b_);").join("\n")
    per_way := "fn mper_way(mass: f32, b_: f32) -> f32 {{\n  var got: f32 = mass / P.DEG;\n{way_code}\n  return got;\n}}"
    /* THE SCALE A CARRIER CROSSED (Medium.scale_at): the chain's `a_{0} along the path`, every name but the density crossed bound to the settled vacuum, written as shader code */
    closed := Model(theory: theory)
    sf := closed.fact("a_{{0}} along the path")
    senv := closed.settled(law.DEG)
    /* the settled record is the one name in it that moves with the lattice: it is left standing and read off the run's own settled vacuum (`xc(0u)`), so the kernel is the chain's on every DEG and not on the theory's own alone */
    free := Model.copy(senv)
    free["n_{{f}}"] = None
    scale_code := sf == None ? "1.0" : Shaded.wgsl(Expr.simplify(Expr.evaluate(closed.prepared(sf.to, senv), free)), ["\\langle\\rho\\rangle", "n_{{f}}"], None)
    scale_fn := "fn mscale(avg: f32) -> f32 {{\n  var e: array<f32, 2>;\n  e[0] = avg;\n  e[1] = xc(0u);\n  return {scale_code};\n}}"
    /* and the vacuum's own share averaged along the straight way in from the nearest body (Medium.crossed_at) */
    crossed_fn := "fn mcrossed(px: f32, py: f32) -> f32 {{\n  var best: i32 = -1;\n  var far: f32 = 0.0;\n  for (var h: u32 = 0u; h < P.holes; h = h + 1u) {{\n    let o: vec4<f32> = bodat(h);\n    let d: f32 = (o.x - px) * (o.x - px) + (o.y - py) * (o.y - py);\n    if (best < 0 || d < far) {{ best = i32(h); far = d; }}\n  }}\n  if (best < 0) {{ return xc(1u); }}\n  let o: vec4<f32> = bodat(u32(best));\n  var got: f32 = 0.0;\n  for (var i: u32 = 0u; i < 16u; i = i + 1u) {{\n    let f: f32 = (f32(i) + 0.5) / 16.0;\n    got = got + mtap(VAC(), o.x + (px - o.x) * f, o.y + (py - o.y) * f, xc(1u));\n  }}\n  return got / 16.0;\n}}"
    /* what the rays line nets at a point, off the same terms every other reading is made of (Medium.nets): what a point makes, what a single carries, and a meeting of two - the balance MSETTLE finds the root of */
    nets_code := Array.range(points.length).map(k => "got = got + mpoint{k}_share(rho, nf) * mpoint{k}_rays(rho, nf);").concat(Array.range(singles.length).map(k => "got = got + msingle{k}_share(rho, nf) * rho * msingle{k}_rays(rho, nf);")).concat(Array.range(meets.length).map(k => "got = got + mmeet{k}_share(rho, nf) * rho * rho * mmeet{k}_rays(rho, nf);")).join("\n")
    nets := "fn mnets(rho: f32, nf: f32) -> f32 {{\n  var got: f32 = 0.0;\n{nets_code}\n  return got;\n}}"
    fns := fm.concat(fp).concat(fs).concat(fo).concat([per_way, nets, scale_fn]).join("\n\n")
    [
      "//! medium MKEEP MCARRY MHWANT MHSTREAM MHJOIN MHSHINE MHFIELD MOPEN MMEET MUNFOLD MMAKE MSETTLE MMOVE MPULLH MMOVEH MSTEP MSTEPH MHCLEAR MHLINK MHSRC MBLOCK",
      Shaded.helpers,
      "const MAXH: u32 = {maxh}u;",
      "const MAXM: u32 = {maxm}u;",
      "const TRACKB: u32 = {trackb}u;",
      /* the planes one thread of a body's pull works through (MPULLH), and how many such runs cover them all */
      "const MPCHUNK: u32 = {pchunk}u;",
      "fn mchunks() -> u32 {{ return select((mplanes() + MPCHUNK - 1u) / MPCHUNK, 1u, mlocal()); }}",
      /* every body apart (Medium.apart): each keeps its own beam, and a point meets what arrives gathered by the way it comes from, GATHER bins round it (Medium.meet_gathered) */
      "const MGATHER: u32 = {gather}u;",
      "fn mapart() -> bool {{ return xc(22u) > 0.5; }}",
      "fn mbin(dx: f32, dy: f32) -> u32 {{\n  let ang: f32 = atan2(dy, dx);\n  let turned: f32 = select(ang, ang + 6.283185307179586, ang < 0.0);\n  return u32(floor(turned / 6.283185307179586 * f32(MGATHER) + 0.5)) % MGATHER;\n}}",
      /* how much of a place's area the cells round it that are in the box hold (Medium.inside_at) */
      "fn minside(x: f32, y: f32) -> f32 {{\n  let x0: f32 = floor(x);\n  let y0: f32 = floor(y);\n  var got: f32 = 0.0;\n  for (var j: i32 = 0; j < 2; j = j + 1) {{\n    for (var i: i32 = 0; i < 2; i = i + 1) {{\n      if (mcell(i32(x0) + i, i32(y0) + j) >= 0) {{ got = got + max(0.0, 1.0 - abs(x - x0 - f32(i))) * max(0.0, 1.0 - abs(y - y0 - f32(j))); }}\n    }}\n  }}\n  return got;\n}}",
      /*
       * EVERY BODY'S RAYS HELD WHERE THEY ARE (Medium.local_rays): each way of a point keeps a few bodies' bundles apart
       * (slots), each as moments - what crosses the shell, and that times where it left, how fast its body went and its
       * face - with whose it is; `ho` is the box as the tick opened, `hn` as it leaves it, and after the slots each cell
       * keeps what goes no way out (a body's own middle). Lines of Medium.ray's held section, one for one
       */
      /* held where they are, the last of the constants is how many bundles a way keeps apart; nought, not held (the extras are the Field's too: their count is not to move) */
      "fn mlocal() -> bool {{ return xc(23u) > 0.5; }}",
      "fn mslots() -> u32 {{ return u32(xc(23u)); }}",
      "const MLIST: u32 = 8u;",
      "const MGROUPS: u32 = 64u;",
      "fn mzone() -> f32 {{ return f32(2u * P.K + 2u); }}",
      "fn medge() -> f32 {{ return mzone() + 0.5005; }}",
      "fn mwindow() -> u32 {{ let s: f32 = 1.4142135623730951 / (mzone() - f32(P.K)); return u32(floor(f32(MGATHER) * atan2(s, sqrt(1.0 - s * s)) / 6.283185307179586)) + 2u; }}",
      "fn mslot(c: u32, b: u32, s: u32) -> u32 {{ return ((c * MGATHER + b) * mslots() + s) * 8u; }}",
      "fn mmid(c: u32) -> u32 {{ return P.cells * MGATHER * mslots() * 8u + c; }}",
      "fn mway(b: u32) -> vec2<f32> {{ let a: f32 = 6.283185307179586 * f32(b) / f32(MGATHER); return vec2<f32>(cos(a), sin(a)); }}",
      /* whether each way of a cell holds anything, one number a way after the middles - written by whichever thread has that way, and read so a reader passes over empty ways */
      "fn mocc(c: u32, b: u32) -> u32 {{ return P.cells * MGATHER * mslots() * 8u + P.cells + c * MGATHER + b; }}",
      /* the bodies standing on each cell gathered into one source, as moments (Kernels MHSRC, Medium.cell_sources): after the ways' occupancy */
      "fn msrc(c: u32) -> u32 {{ return P.cells * MGATHER * mslots() * 8u + P.cells + P.cells * MGATHER + c * 8u; }}",
      "fn msource(c: u32) -> array<f32, 8> {{\n  var m: array<f32, 8>;\n  for (var j: u32 = 0u; j < 8u; j = j + 1u) {{ m[j] = hn[msrc(c) + j]; }}\n  return m;\n}}",
      /* and as the tick opened: gathered at the end of the one before, once its bodies had moved */
      "fn msourcewas(c: u32) -> array<f32, 8> {{\n  var m: array<f32, 8>;\n  for (var j: u32 = 0u; j < 8u; j = j + 1u) {{ m[j] = ho[msrc(c) + j]; }}\n  return m;\n}}",
      "fn mhas(c: u32, b: u32) -> bool {{ return hn[mocc(c, b)] > 0.5; }}",
      /* and the same as four words of 24 bits a cell (a float holds 24 whole), so a point can tell at a glance which ways any cell near it holds (MHSTREAM); written only by the thread that has the whole cell */
      "fn mbits(c: u32, w: u32) -> u32 {{ return P.cells * MGATHER * mslots() * 8u + P.cells + P.cells * MGATHER + P.cells * 8u + P.cells * 2u + c * 4u + w; }}",
      /* and which ways anything can come on at a cell this tick, as four words of 24 bits (MHWANT, for MHSTREAM) */
      "fn mwant(c: u32, w: u32) -> u32 {{ return P.cells * MGATHER * mslots() * 8u + P.cells + P.cells * MGATHER + P.cells * 8u + P.cells * 2u + P.cells * 4u + c * 4u + w; }}",
      "fn mmark(c: u32, b: u32, on: bool) {{\n  hn[mocc(c, b)] = select(0.0, 1.0, on);\n  let k: u32 = mbits(c, b / 24u);\n  var v: u32 = u32(hn[k]);\n  let bit: u32 = 1u << (b % 24u);\n  if (on) {{ v = v | bit; }} else {{ v = v & ~bit; }}\n  hn[k] = f32(v);\n}}",
      "fn mheld(k: u32) -> array<f32, 8> {{\n  var m: array<f32, 8>;\n  for (var j: u32 = 0u; j < 8u; j = j + 1u) {{ m[j] = hn[k + j]; }}\n  return m;\n}}",
      "fn mwas(k: u32) -> array<f32, 8> {{\n  var m: array<f32, 8>;\n  for (var j: u32 = 0u; j < 8u; j = j + 1u) {{ m[j] = ho[k + j]; }}\n  return m;\n}}",
      "fn mput(k: u32, m: array<f32, 8>) {{\n  for (var j: u32 = 0u; j < 8u; j = j + 1u) {{ hn[k + j] = m[j]; }}\n}}",
      /* where a bundle's body stands now, and what the bundle has put at (x, y) with the way out from there (Medium.now_from, Medium.reads) */
      "fn mnow(m: array<f32, 8>, x: f32, y: f32) -> vec2<f32> {{\n  let sx: f32 = m[1] / m[0];\n  let sy: f32 = m[2] / m[0];\n  let age: f32 = sqrt((x - sx) * (x - sx) + (y - sy) * (y - sy)) / f32(P.K);\n  return vec2<f32>(sx + m[3] / m[0] * age, sy + m[4] / m[0] * age);\n}}",
      "fn mreads(m: array<f32, 8>, x: f32, y: f32) -> vec3<f32> {{\n  if (!(m[0] > 0.0)) {{ return vec3<f32>(0.0, 0.0, 0.0); }}\n  let s: vec2<f32> = mnow(m, x, y);\n  let dx: f32 = x - s.x;\n  let dy: f32 = y - s.y;\n  let d: f32 = sqrt(dx * dx + dy * dy);\n  let r: f32 = max(m[5] / m[0], d / f32(P.K));\n  let got: f32 = min(1.0, m[0] / pow(r, xc(6u) - 1.0) * select(1.0, mspread_of(m, d), r > m[5] / m[0]));\n  if (d <= 0.0) {{ return vec3<f32>(got, 0.0, 0.0); }}\n  return vec3<f32>(got, dx / d, dy / d);\n}}",
      /* two bundles gathered into one, and how far apart they are as seen from (x, y) (Medium.gathered, Medium.apart_seen) */
      /* how far apart what two bundles gathered stand, together (Medium.spread_with); a held bundle's eighth number */
      "fn mspread_with(a: array<f32, 8>, b: array<f32, 8>, x: f32, y: f32) -> f32 {{\n  if (!(a[0] > 0.0 && b[0] > 0.0)) {{ return a[7] + b[7]; }}\n  let q: f32 = a[0] + b[0];\n  let ex: f32 = x - (a[1] + b[1]) / q;\n  let ey: f32 = y - (a[2] + b[2]) / q;\n  let e: f32 = sqrt(ex * ex + ey * ey);\n  var along: f32 = 0.0;\n  if (e > 0.0) {{ along = ((a[1] / a[0] - b[1] / b[0]) * ex + (a[2] / a[0] - b[2] / b[0]) * ey) / e; }}\n  return a[7] + b[7] + a[0] * b[0] / q * along * along;\n}}",
      /* what a gathering sends d cells off, against what it would from its middle alone (Medium.spread_of) */
      "fn mspread_of(m: array<f32, 8>, d: f32) -> f32 {{\n  let n: f32 = xc(6u) - 1.0;\n  if (!(d > 0.0 && m[0] > 0.0)) {{ return 1.0; }}\n  return 1.0 + n * (n + 1.0) / 2.0 * m[7] / (m[0] * d * d);\n}}",
      "fn mjoin(a: array<f32, 8>, b: array<f32, 8>, x: f32, y: f32) -> array<f32, 8> {{\n  var m: array<f32, 8>;\n  for (var j: u32 = 0u; j < 6u; j = j + 1u) {{ m[j] = a[j] + b[j]; }}\n  m[6] = select(-1.0, a[6], a[6] == b[6]);\n  m[7] = mspread_with(a, b, x, y);\n  return m;\n}}",
      "fn mseen(a: array<f32, 8>, b: array<f32, 8>, x: f32, y: f32) -> f32 {{\n  let ax: f32 = a[1] / a[0];\n  let ay: f32 = a[2] / a[0];\n  let bx: f32 = b[1] / b[0];\n  let by: f32 = b[2] / b[0];\n  let near: f32 = min(sqrt((x - ax) * (x - ax) + (y - ay) * (y - ay)), sqrt((x - bx) * (x - bx) + (y - by) * (y - by)));\n  return sqrt((ax - bx) * (ax - bx) + (ay - by) * (ay - by)) / max(near, 1.0);\n}}",
      /* what one way of a point holds laid into its slots, the nearest pair gathered while there are too many (Medium.lay) */
      /* whether a bundle is its body's own to lay at (x, y): its body stands within the edge (Medium.fresh) */
      "fn mfresh(m: array<f32, 8>, x: f32, y: f32) -> bool {{\n  let s: vec2<f32> = mnow(m, x, y);\n  return sqrt((x - s.x) * (x - s.x) + (y - s.y) * (y - s.y)) <= medge();\n}}",
      "fn mfill(c: u32, b: u32, l0: array<array<f32, 8>, MLIST>, n0: u32) -> u32 {{\n  var l: array<array<f32, 8>, MLIST> = l0;\n  var n: u32 = n0;\n  let x: f32 = f32(c % P.N);\n  let y: f32 = f32(c / P.N);\n  loop {{\n    if (n <= mslots()) {{ break; }}\n    /* two the shine lays anew, or two the stream brought, never one of each (Medium.lay); any pair only where no two are of one kind */\n    var best: f32 = 0.0;\n    var bi: i32 = -1;\n    var bj: i32 = -1;\n    for (var tries: u32 = 0u; tries < 2u; tries = tries + 1u) {{\n      if (bi >= 0) {{ break; }}\n      for (var i: u32 = 0u; i < n; i = i + 1u) {{\n        for (var j: u32 = i + 1u; j < n; j = j + 1u) {{\n          if (tries == 0u && mfresh(l[i], x, y) != mfresh(l[j], x, y)) {{ continue; }}\n          let seen: f32 = mseen(l[i], l[j], x, y);\n          if (bi < 0 || seen < best) {{ best = seen; bi = i32(i); bj = i32(j); }}\n        }}\n      }}\n    }}\n    l[bi] = mjoin(l[bi], l[bj], x, y);\n    l[bj] = l[n - 1u];\n    n = n - 1u;\n  }}\n  for (var j: u32 = 0u; j < mslots(); j = j + 1u) {{\n    if (j < n) {{ mput(mslot(c, b, j), l[j]); }} else {{ hn[mslot(c, b, j)] = 0.0; }}\n  }}\n  return n;\n}}",
      /* and the way marked as holding something or not - by the one thread that has the whole cell */
      "fn mlay(c: u32, b: u32, l: array<array<f32, 8>, MLIST>, n: u32) {{ mmark(c, b, mfill(c, b, l, n) > 0u); }}",
      "fn mhaswas(c: u32, b: u32) -> bool {{ return ho[mocc(c, b)] > 0.5; }}",
      /* a body's own bundle taken off every way of a point (Medium.drop_whose) */
      "fn mdrop(c: u32, who: f32, b0: u32) {{\n  /* a body's own bundle at a point stands on its way out from where its rays left, which is within a way or two of its way out from where it is */\n  for (var o: u32 = 0u; o < 5u; o = o + 1u) {{\n    let b: u32 = (b0 + MGATHER + o - 2u) % MGATHER;\n    if (!mhas(c, b)) {{ continue; }}\n    /* told by the names alone first: mostly it is not there, and nothing more is read */\n    var had: bool = false;\n    for (var s: u32 = 0u; s < mslots(); s = s + 1u) {{\n      let k: u32 = mslot(c, b, s);\n      if (hn[k] > 0.0 && hn[k + 6u] == who) {{ had = true; }}\n    }}\n    if (!had) {{ continue; }}\n    var l: array<array<f32, 8>, MLIST>;\n    var n: u32 = 0u;\n    for (var s: u32 = 0u; s < mslots(); s = s + 1u) {{\n      let m: array<f32, 8> = mheld(mslot(c, b, s));\n      if (m[0] > 0.0 && m[6] != who && n < MLIST) {{ l[n] = m; n = n + 1u; }}\n    }}\n    mlay(c, b, l, n);\n  }}\n}}",
      /* one bundle more laid onto a way of a point, with what it holds (Medium.held_on, then Medium.lay) */
      "fn madd(c: u32, b: u32, e: array<f32, 8>) {{\n  var l: array<array<f32, 8>, MLIST>;\n  var n: u32 = 0u;\n  for (var s: u32 = 0u; s < select(0u, mslots(), mhas(c, b)); s = s + 1u) {{\n    let m: array<f32, 8> = mheld(mslot(c, b, s));\n    if (m[0] > 0.0 && n < MLIST) {{ l[n] = m; n = n + 1u; }}\n  }}\n  if (n < MLIST) {{ l[n] = e; n = n + 1u; }}\n  mlay(c, b, l, n);\n}}",
      /* what a body puts on its rays, as moments, where it stands now (Medium.emitted) - and as laid d cells off, from where the rays that far out left (Medium.left_for) */
      "fn memit(h: u32) -> array<f32, 8> {{\n  let o: vec4<f32> = bodat(h);\n  let g: vec4<f32> = bodgo(h);\n  let beta: f32 = min(1.0, sqrt(g.x * g.x + g.y * g.y) / o.z);\n  let face: f32 = max({near}, bodface(h));\n  let q: f32 = mper_way(o.z, beta) * bodskin(h) * mdrift(h) * pow(face, xc(6u) - 1.0);\n  let vx: f32 = g.x / o.z * f32(P.K);\n  let vy: f32 = g.y / o.z * f32(P.K);\n  var m: array<f32, 8>;\n  m[0] = q;\n  m[1] = q * o.x;\n  m[2] = q * o.y;\n  m[3] = q * vx;\n  m[4] = q * vy;\n  m[5] = q * face;\n  m[6] = f32(h);\n  return m;\n}}",
      "fn mleft(e: array<f32, 8>, d: f32) -> array<f32, 8> {{\n  var m: array<f32, 8> = e;\n  let back: f32 = d / f32(P.K);\n  m[7] = 0.0;\n  m[1] = e[1] - e[3] * back;\n  m[2] = e[2] - e[4] * back;\n  return m;\n}}",
      /* what all the bodies have put at a cell (Medium.held_at) */
      "fn mheldat(c: u32) -> f32 {{\n  let x: f32 = f32(c % P.N);\n  let y: f32 = f32(c / P.N);\n  var got: f32 = hn[mmid(c)];\n  for (var b: u32 = 0u; b < MGATHER; b = b + 1u) {{\n    if (!mhas(c, b)) {{ continue; }}\n    for (var s: u32 = 0u; s < mslots(); s = s + 1u) {{\n      let k: u32 = mslot(c, b, s);\n      if (hn[k] > 0.0) {{ got = got + mreads(mheld(k), x, y).x; }}\n    }}\n  }}\n  return got;\n}}",
      /* what arrives at (px, py): the bundles of the cell it stands in, each read at the point itself from where its body stands, the body at plane zown's own left out (Medium.arriving_at): what, and times the way out */
      /* FAR BODIES READ OFF A CELL'S MIDDLE (Medium.far_of, Medium.expanded): past MNEARF cells, and not a whole ray a way, a bundle's field is read off its value, slope and bend there, summed once a tick a cell (MHFIELD, nine numbers); the near ones listed, by way and slot, to be read at each point */
      "const MNEARF: f32 = {near_cells}.0;",
      "const MNEAR: u32 = 96u;",
      "fn mtay(c: u32) -> u32 {{ return P.cells * MGATHER * mslots() * 8u + P.cells + P.cells * MGATHER + P.cells * 8u + P.cells * 2u + P.cells * 8u + c * 9u; }}",
      "fn mnear(c: u32) -> u32 {{ return P.cells * MGATHER * mslots() * 8u + P.cells + P.cells * MGATHER + P.cells * 8u + P.cells * 2u + P.cells * 8u + P.cells * 9u + c * (MNEAR + 1u); }}",
      "fn mfar(m: array<f32, 8>, ux: f32, uy: f32) -> bool {{\n  let s: vec2<f32> = mnow(m, ux, uy);\n  let d: f32 = sqrt((ux - s.x) * (ux - s.x) + (uy - s.y) * (uy - s.y));\n  let r: f32 = d / f32(P.K);\n  return d > MNEARF && r > m[5] / m[0] && m[0] / pow(r, xc(6u) - 1.0) < 1.0;\n}}",
      "fn mtaylor(m: array<f32, 8>, ux: f32, uy: f32) -> array<f32, 9> {{\n  let s: vec2<f32> = mnow(m, ux, uy);\n  let ex: f32 = ux - s.x;\n  let ey: f32 = uy - s.y;\n  let r2: f32 = ex * ex + ey * ey;\n  let Dd: f32 = xc(6u);\n  let C: f32 = m[0] * pow(f32(P.K), Dd - 1.0) * mspread_of(m, sqrt(r2));\n  let rD: f32 = pow(r2, Dd / 2.0);\n  let a: f32 = C / rD;\n  let b: f32 = Dd * C / (rD * r2);\n  let c3: f32 = Dd * (Dd + 2.0) * C / (rD * r2 * r2);\n  var t: array<f32, 9>;\n  t[0] = a * ex;\n  t[1] = a * ey;\n  t[2] = a - b * ex * ex;\n  t[3] = 0.0 - b * ex * ey;\n  t[4] = a - b * ey * ey;\n  t[5] = 0.0 - 3.0 * b * ex + c3 * ex * ex * ex;\n  t[6] = 0.0 - b * ey + c3 * ex * ex * ey;\n  t[7] = 0.0 - b * ex + c3 * ex * ey * ey;\n  t[8] = 0.0 - 3.0 * b * ey + c3 * ey * ey * ey;\n  return t;\n}}",
      "fn marrive(px: f32, py: f32, zown: u32) -> vec3<f32> {{\n  let u: i32 = mcell(i32(floor(px + 0.5)), i32(floor(py + 0.5)));\n  if (u < 0) {{ return vec3<f32>(0.0, 0.0, 0.0); }}\n  let uu: u32 = u32(u);\n  let ux: f32 = f32(uu % P.N);\n  let uy: f32 = f32(uu / P.N);\n  /* the far ones, off the cell's nine numbers */\n  let dx: f32 = px - ux;\n  let dy: f32 = py - uy;\n  let T: u32 = mtay(uu);\n  var gx: f32 = hn[T] + hn[T + 2u] * dx + hn[T + 3u] * dy + (hn[T + 5u] * dx * dx + 2.0 * hn[T + 6u] * dx * dy + hn[T + 7u] * dy * dy) / 2.0;\n  var gy: f32 = hn[T + 1u] + hn[T + 3u] * dx + hn[T + 4u] * dy + (hn[T + 6u] * dx * dx + 2.0 * hn[T + 7u] * dx * dy + hn[T + 8u] * dy * dy) / 2.0;\n  var sum: f32 = 0.0;\n  /* the near ones, each read at the point itself, the body at plane zown's own passed over or taken out of the gathering nearest it */\n  var own: i32 = -1;\n  if (zown >= 1u && zown <= P.holes) {{ own = i32(zown) - 1; }}\n  var mine: array<f32, 8>;\n  var owns: u32 = 0u;\n  var alone: bool = false;\n  var nearest: i32 = -1;\n  /* the name its own cell's gathering goes by (Medium.cell_sources) */\n  var srcid: f32 = 0.5;\n  let L: u32 = mnear(uu);\n  let n: u32 = u32(hn[L]);\n  if (own >= 0) {{\n    mine = memit(u32(own));\n    let o: vec4<f32> = bodat(u32(own));\n    owns = mbin(ux - o.x, uy - o.y);\n    srcid = -2.0 - f32(mcell(i32(floor(o.x + 0.5)), i32(floor(o.y + 0.5))));\n    var far: f32 = 0.0;\n    for (var e: u32 = 0u; e < n; e = e + 1u) {{\n      let rel: u32 = u32(hn[L + 1u + e]);\n      if (rel / mslots() != owns) {{ continue; }}\n      let m: array<f32, 8> = mheld(mslot(uu, owns, rel % mslots()));\n      if (m[6] == f32(own)) {{ alone = true; }} else if (m[6] == -1.0) {{\n        let d: f32 = sqrt((m[1] / m[0] - o.x) * (m[1] / m[0] - o.x) + (m[2] / m[0] - o.y) * (m[2] / m[0] - o.y));\n        if (nearest < 0 || d < far) {{ nearest = i32(rel); far = d; }}\n      }}\n    }}\n  }}\n  for (var e: u32 = 0u; e < n; e = e + 1u) {{\n    let rel: u32 = u32(hn[L + 1u + e]);\n    var m: array<f32, 8> = mheld(mslot(uu, rel / mslots(), rel % mslots()));\n    if (own >= 0 && m[6] == f32(own)) {{ continue; }}\n    if (own >= 0 && rel / mslots() == owns && !alone && m[6] == -1.0 && i32(rel) == nearest && m[0] - mine[0] > 0.0) {{\n      let all: array<f32, 8> = m;\n      for (var q: u32 = 0u; q < 6u; q = q + 1u) {{ m[q] = m[q] - mine[q]; }}\n      m[6] = -1.0;\n      /* and how far apart the rest stand: the gathering's, less what its own stood off the rest's middle */\n      let ex: f32 = ux - all[1] / all[0];\n      let ey: f32 = uy - all[2] / all[0];\n      let e: f32 = sqrt(ex * ex + ey * ey);\n      var along: f32 = 0.0;\n      if (e > 0.0) {{ along = ((m[1] / m[0] - mine[1] / mine[0]) * ex + (m[2] / m[0] - mine[2] / mine[0]) * ey) / e; }}\n      m[7] = max(0.0, all[7] - m[0] * mine[0] / all[0] * along * along);\n    }}\n    /* sent out within its own cell's gathering: its share taken out of that, laid as that was (Medium.left_for) */\n    if (own >= 0 && m[6] == srcid) {{\n      let lf: array<f32, 8> = mleft(mine, sqrt((ux - m[1] / m[0]) * (ux - m[1] / m[0]) + (uy - m[2] / m[0]) * (uy - m[2] / m[0])));\n      for (var q: u32 = 0u; q < 6u; q = q + 1u) {{ m[q] = m[q] - lf[q]; }}\n    }}\n    let got: vec3<f32> = mreads(m, px, py);\n    sum = sum + got.x;\n    gx = gx + got.x * got.y;\n    gy = gy + got.x * got.z;\n  }}\n  /* what stands at the cell's very middle is on no way: its source as the shine laid it, read at the point (Medium.arriving_at) */\n  var e: array<f32, 8> = msourcewas(uu);\n  e[7] = 0.0;\n  if (e[0] > 0.0 && sqrt((ux - e[1] / e[0]) * (ux - e[1] / e[0]) + (uy - e[2] / e[0]) * (uy - e[2] / e[0])) <= 0.001 && !(own >= 0 && e[6] == f32(own))) {{\n    if (own >= 0 && e[6] == srcid) {{\n      for (var q: u32 = 0u; q < 6u; q = q + 1u) {{ e[q] = e[q] - mine[q]; }}\n    }}\n    if (e[0] > 0.0) {{\n      let got: vec3<f32> = mreads(e, px, py);\n      sum = sum + got.x;\n      gx = gx + got.x * got.y;\n      gy = gy + got.x * got.z;\n    }}\n  }}\n  return vec3<f32>(sum, gx, gy);\n}}",
      "const CN: u32 = {CN}u;",
      "fn xc(k: u32) -> f32 {{ return dir[P.A + 2u * MAXH + k / 4u][k % 4u]; }}",
      fns,
      "fn mcell(x: i32, y: i32) -> i32 {{ if (x < 0 || y < 0 || x >= i32(P.N) || y >= i32(P.N)) {{ return -1; }} return y * i32(P.N) + x; }}",
      /* the planes of st: the record, and what still stands of it. What a body has sent is not of a cell at all - it is one number a c-bar out from that body (Medium.beam) */
      "fn mplanes() -> u32 {{ return P.tags - 1u; }}",
      /* the per-cell ledgers of what arrived: a plane each, or with every body apart the vacuum's and all the bodies' together */
      "fn mledger() -> u32 {{ return select(mplanes(), 2u, xc(22u) > 0.5); }}",
      "fn at_plane(p: u32, c: u32) -> u32 {{ return p * P.cells + c; }}",
      "fn FOLD() -> u32 {{ return 0u; }}",
      "fn STAND() -> u32 {{ return 1u; }}",
      /* THE VACUUM'S OWN POPULATION, WHICH IS NOT GIVEN: a field the medium settles at every cell, where the rays line nets nought beside what the bodies put there (Medium.vac, Medium.settle_rho); nought means it has not been settled yet and stands at the closure's root */
      "fn VAC() -> u32 {{ return 2u; }}",
      "fn mvac(c: u32) -> f32 {{ let v: f32 = st[at_plane(VAC(), c)]; return select(v, xc(1u), v <= 0.0); }}",
      /* what a body has sent, at a distance from it in c-bar, read between the rungs it is kept on (Medium.sent_at) */
      "fn RUNGS() -> u32 {{ return P.rungs; }}",
      /* a body's own numbers, on the device: where it is, its mass and its plane; what it carries, and whether it moves */
      "fn BODS() -> u32 {{ return P.bod; }}",
      "fn bodat(h: u32) -> vec4<f32> {{ let b: u32 = BODS() + 12u * h; return vec4<f32>(cel[b], cel[b + 1u], cel[b + 2u], cel[b + 3u]); }}",
      "fn bodgo(h: u32) -> vec4<f32> {{ let b: u32 = BODS() + 12u * h; return vec4<f32>(cel[b + 4u], cel[b + 5u], cel[b + 6u], cel[b + 7u]); }}",
      /* how big it is, in c-bar - its rays leave its face and not its middle - and what that size lets out of it (Medium.face_of, Medium.skin_of) */
      "fn bodface(h: u32) -> f32 {{ return cel[BODS() + 12u * h + 8u]; }}",
      "fn bodskin(h: u32) -> f32 {{ return cel[BODS() + 12u * h + 9u]; }}",
      /* AND THE SAME READ WHERE THE FIELD IS: the mismatch is measured against a_0 over the acceleration THERE, which
       * is the lean the medium left at that place last tick - weak field, large factor; strong field, none (Medium.recur_at) */
      "fn mrecur(px: f32, py: f32, gn: f32) -> f32 {{\n  if (xc(19u) < 1.5 || gn <= 0.0) {{ return 1.0; }}\n  var a0: f32 = xc(17u);\n  /* and where a_0 is read off the matter crossed rather than the vacuum's own (Medium.a0_from) */\n  if (xc(21u) > 0.5 && xc(21u) < 1.5 && xc(1u) > 0.0) {{ a0 = a0 * max(0.0, mtapc(0u, px, py, 0.0) - xc(4u) * xc(1u)) / xc(1u); }}\n  /* or the chain's own, at the density crossed on the way in (Medium.a0_at_place, a0_from 2) */\n  if (xc(21u) > 1.5) {{ let inf: f32 = mscale(xc(1u)); if (inf > 0.0) {{ a0 = a0 * mscale(mcrossed(px, py)) / inf; }} }}\n  if (a0 <= 0.0) {{ return 1.0; }}\n  let gx: f32 = mtapc(2u, px, py, 0.0);\n  let gy: f32 = mtapc(3u, px, py, 0.0);\n  let was: f32 = sqrt(gx * gx + gy * gy);\n  /* g = sqrt(g_N(g + a_0)): the same line as g = g_N(1 + a_0/g), written as the mean it is, and the form that settles */\n  return sqrt(gn * (was + a0)) / gn;\n}}",
      /* WHAT A BODY'S OWN GOING DOES TO WHAT IT SENDS: the phase between its pulses and the vacuum's only piles up
       * while the rate of flipping keeps changing, which is what it is accelerating at - and what it accelerates at
       * is what the others' fields leave under it, so the two close on each other (Medium.drifting) */
      "fn mdrift(h: u32) -> f32 {{\n  if (xc(19u) < 0.5 || xc(19u) > 1.5) {{ return 1.0; }}\n  let gx: f32 = cel[P.outs + 4u * h];\n  let gy: f32 = cel[P.outs + 4u * h + 1u];\n  let g: f32 = sqrt(gx * gx + gy * gy);\n  let a0: f32 = xc(17u);\n  if (g <= 0.0 || a0 <= 0.0) {{ return 1.0; }}\n  return 1.0 + a0 / g;\n}}",
      "fn facing_out(z: u32) -> f32 {{ let h: i32 = whom(z); if (h < 0) {{ return {near}; }} return max({near}, bodface(u32(h))); }}",
      /* where each body stood on each of the last ticks, kept on the device: a reading a tick would cost more than the tick */
      "const TRACKED: u32 = 4096u;",
      "fn TRACK(t: u32, h: u32) -> u32 {{ return P.track + (t % TRACKED) * TRACKB * 4u + h * 4u; }}",
      /* whose rays a plane holds, looked up rather than searched for: a step reads this for every plane at every cell */
      "fn whom(z: u32) -> i32 {{ return i32(cel[P.whom + z]); }}",
      /* what a body has sent is kept twice over, and a tick reads the one it wrote: the beat's own two halves */
      "fn BEAMAT(z: u32, r: u32) -> u32 {{ return P.beam + z * RUNGS() + r; }}",
      "fn BEAMWAS(z: u32, r: u32) -> u32 {{ return P.beam + P.span + z * RUNGS() + r; }}",
      "fn msent(z: u32, r: f32) -> f32 {{\n  let n: u32 = RUNGS();\n  let i: f32 = floor(r);\n  if (i < 0.0) {{ return 0.0; }}\n  let k: u32 = u32(i);\n  if (k + 1u >= n) {{ return 0.0; }}\n  let f: f32 = r - i;\n  let over: f32 = xc(6u) - 1.0;\n  let face: f32 = facing_out(z);\n  let here: f32 = pow(max(face, r), over);\n  let was: f32 = cel[BEAMAT(z, k)] * pow(max(face, i), over);\n  let next: f32 = cel[BEAMAT(z, k + 1u)] * pow(max(face, i + 1.0), over);\n  if (here <= 0.0) {{ return 0.0; }}\n  return (was * (1.0 - f) + next * f) / here;\n}}",
      "fn mact(x: f32) -> f32 {{ return clamp(x, 0.0, 1.0); }}",
      /* a plane read by area at a true position in cells, with what stands across the box's edge (Medium.tap) */
      "fn mtap(p: u32, px: f32, py: f32, outside: f32) -> f32 {{\n  let x0: i32 = i32(floor(px));\n  let y0: i32 = i32(floor(py));\n  let fx: f32 = px - floor(px);\n  let fy: f32 = py - floor(py);\n  let base: u32 = p * P.cells;\n  var got: f32 = 0.0;\n  let c00: i32 = mcell(x0, y0);\n  let c10: i32 = mcell(x0 + 1, y0);\n  let c01: i32 = mcell(x0, y0 + 1);\n  let c11: i32 = mcell(x0 + 1, y0 + 1);\n  got = got + (1.0 - fx) * (1.0 - fy) * select(outside, st[base + u32(max(c00, 0))], c00 >= 0);\n  got = got + fx * (1.0 - fy) * select(outside, st[base + u32(max(c10, 0))], c10 >= 0);\n  got = got + (1.0 - fx) * fy * select(outside, st[base + u32(max(c01, 0))], c01 >= 0);\n  got = got + fx * fy * select(outside, st[base + u32(max(c11, 0))], c11 >= 0);\n  return got;\n}}",
      crossed_fn,
      /* a ledger of cel read by area */
      "fn mtapc(slot: u32, px: f32, py: f32, outside: f32) -> f32 {{\n  let x0: i32 = i32(floor(px));\n  let y0: i32 = i32(floor(py));\n  let fx: f32 = px - floor(px);\n  let fy: f32 = py - floor(py);\n  let base: u32 = slot * P.cells;\n  var got: f32 = 0.0;\n  let c00: i32 = mcell(x0, y0);\n  let c10: i32 = mcell(x0 + 1, y0);\n  let c01: i32 = mcell(x0, y0 + 1);\n  let c11: i32 = mcell(x0 + 1, y0 + 1);\n  got = got + (1.0 - fx) * (1.0 - fy) * select(outside, cel[base + u32(max(c00, 0))], c00 >= 0);\n  got = got + fx * (1.0 - fy) * select(outside, cel[base + u32(max(c10, 0))], c10 >= 0);\n  got = got + (1.0 - fx) * fy * select(outside, cel[base + u32(max(c01, 0))], c01 >= 0);\n  got = got + fx * fy * select(outside, cel[base + u32(max(c11, 0))], c11 >= 0);\n  return got;\n}}",
      /* the way out from the body whose rays are on plane z, at a place, and how far the place stands from it (Medium.out_from) */
      "fn mout(z: u32, px: f32, py: f32) -> vec3<f32> {{\n  let h: i32 = whom(z);\n  if (h < 0) {{ return vec3<f32>(0.0, 0.0, 0.0); }}\n  let o: vec4<f32> = bodat(u32(h));\n  let dx: f32 = px - o.x;\n  let dy: f32 = py - o.y;\n  let d: f32 = sqrt(dx * dx + dy * dy);\n  let face: f32 = max({near}, bodface(u32(h)));\n  if (d <= 0.0) {{ return vec3<f32>(0.0, 0.0, face); }}\n  return vec3<f32>(dx / d, dy / d, max(face, d / f32(P.K)));\n}}",
      /* how much two bundles of rays face each other: what their ways have in common, one met head on by the other (Medium.facing_share) */
      "fn mfacing(ax: f32, ay: f32, bx: f32, by: f32) -> f32 {{\n  let wide: f32 = 6.283185307179586 / P.DEG;\n  let ux: f32 = -bx;\n  let uy: f32 = -by;\n  let angle: f32 = abs(atan2(ax * uy - ay * ux, ax * ux + ay * uy));\n  return max(0.0, 1.0 - angle / wide);\n}}",
      "fn munder(h: u32, k: u32) -> i32 {{\n  let o: vec4<f32> = bodat(h);\n  let half: i32 = i32((P.K - 1u) / 2u);\n  let x: i32 = i32(floor(o.x + 0.5)) - half + i32(k % P.K);\n  let y: i32 = i32(floor(o.y + 0.5)) - half + i32(k / P.K);\n  return mcell(x, y);\n}}"
    ].join("\n\n")
  }

  static medium_kernels (d: Language, theory: Theory): String => {
    near := Shaded.literal(Aggregate.of(theory).NEAR)
    meets := Kernels.medium_terms(theory, 2)
    points := Kernels.medium_terms(theory, 0)
    singles := Kernels.medium_terms(theory, 1)
    meet_code := Array.range(meets.length).map(k => "{{\n  let w: f32 = mmeet{k}_share(rho, nf) * mact(mine) * mact(theirs) * over;\n  fold = fold + w * mmeet{k}_folds(rho, nf) / 2.0;\n  grew = grew + w * mmeet{k}_space(rho, nf) / 2.0;\n  gone = gone + w * abs(mmeet{k}_folds(rho, nf)) / 2.0;\n}}").join("\n")
    unfold_code := Array.range(points.length).map(k => "{{\n  let back: f32 = mpoint{k}_folds(rho, nf);\n  if (back != 0.0) {{ h = h + mpoint{k}_share(rho, nf) * back; }}\n}}").join("\n")
    point_code := Array.range(points.length).map(k => "grown = grown + mpoint{k}_share(rho, nf) * mpoint{k}_space(rho, nf);").join("\n")
    single_code := Array.range(singles.length).map(k => "grown = grown + msingle{k}_share(rho, nf) * rho * msingle{k}_space(rho, nf);").join("\n")
    rate_code := Array.range(meets.length).map(k => "rate = rate + mmeet{k}_share(rho, nf) * mmeet{k}_folds(rho, nf) / 2.0;").join("\n")
    gather := Medium.GATHER
    /*
     * ONE BODY'S STEP AND ONE BODY'S PULL (Medium.move, Medium.pull_at), written once: run for every body by one thread
     * where there are a few (MSTEP, MMOVE), and one thread a body where every body is apart and there are many (MSTEPH,
     * MMOVEH) - the same lines either way, so the two cannot differ
     */
    step_one := "let g: vec4<f32> = bodgo(h);\n  let o: vec4<f32> = bodat(h);\n  let b: u32 = BODS() + 12u * h;\n  if (g.z >= 0.5) {{\n    var px: f32 = g.x + cel[out + 4u * h] * o.z;\n    var py: f32 = g.y + cel[out + 4u * h + 1u] * o.z;\n    let m: f32 = sqrt(px * px + py * py);\n    if (m > o.z) {{ px = px * o.z / m; py = py * o.z / m; }}\n    cel[b + 4u] = px;\n    cel[b + 5u] = py;\n    cel[b] = o.x + px / o.z * f32(P.K);\n    cel[b + 1u] = o.y + py / o.z * f32(P.K);\n  }}\n  /* and where that leaves it is kept, this tick's own place on the track - for the bodies an orbit is read off */\n  if (h < TRACKB) {{\n    let tr: u32 = TRACK(P.tick, h);\n    cel[tr] = cel[b];\n    cel[tr + 1u] = cel[b + 1u];\n    cel[tr + 2u] = cel[b + 4u];\n    cel[tr + 3u] = cel[b + 5u];\n  }}"
    /* what one of the K by K points round a body is pulled by, from the planes z0 up to z1: written once, read by the whole pull and by its pieces */
    pull_at_k := "let px: f32 = o.x - half + f32(k % P.K);\n    let py: f32 = o.y - half + f32(k / P.K);\n    let rho: f32 = mtapc(0u, px, py, 0.0);\n    let nf: f32 = mtapc(1u, px, py, 0.0);\n    var rate: f32 = 0.0;\n{rate_code}\n    let stood: f32 = mtap(STAND(), px, py, 0.0);\n    for (var z: u32 = z0; z < z1; z = z + 1u) {{\n      if (z == zown) {{ continue; }}\n      let way: vec3<f32> = mout(z, px, py);\n      if (way.z <= 0.0) {{ continue; }}\n      let tx: f32 = -way.x;\n      let ty: f32 = -way.y;\n      let share: f32 = rate * mact(msent(z, way.z)) / select(1.0, 1.0 + stood, xc(20u) > 0.5);\n      gx = gx + share * tx;\n      gy = gy + share * ty;\n    }}"
    pull_one := "let o: vec4<f32> = bodat(h);\n  let zown: u32 = u32(o.w);\n  var gx: f32 = 0.0;\n  var gy: f32 = 0.0;\n  for (var k: u32 = 0u; k < P.K * P.K; k = k + 1u) {{\n    let z0: u32 = 1u;\n    let z1: u32 = mplanes();\n    {pull_at_k}\n  }}\n  let n: f32 = f32(P.K * P.K);\n  let f: f32 = mrecur(o.x, o.y, sqrt(gx * gx + gy * gy) / n);\n  cel[out + 4u * h] = gx / n * f;\n  cel[out + 4u * h + 1u] = gy / n * f;"
    /*
     * AND WITH EVERY BODY APART, IN PIECES: a body's pull is the sum over its K by K points and over every other body's
     * plane, and one thread a body left the device nearly idle. So one thread works one point of one body against one
     * run of MPCHUNK planes (MPULLH), writing what it found where the parts are kept (P.part), and one thread a body
     * adds its parts in a fixed order and reads the pull off the sum exactly as the whole pull does (MMOVEH)
     */
    /* held where they are (Medium.local_rays), the pull at one of the K by K points: what arrives there, the body's own left out */
    pull_held_k := "let px: f32 = o.x - half + f32(k % P.K);\n    let py: f32 = o.y - half + f32(k / P.K);\n    let rho: f32 = mtapc(0u, px, py, 0.0);\n    let nf: f32 = mtapc(1u, px, py, 0.0);\n    var rate: f32 = 0.0;\n{rate_code}\n    let stood: f32 = mtap(STAND(), px, py, 0.0);\n    let came: vec3<f32> = marrive(px, py, zown);\n    let per: f32 = rate / select(1.0, 1.0 + stood, xc(20u) > 0.5);\n    gx = gx - per * came.y;\n    gy = gy - per * came.z;"
    part_one := "let per: u32 = P.K * P.K * mchunks();\nif (i >= P.holes * per || !mapart()) {{ return; }}\nlet half: f32 = f32(P.K - 1u) / 2.0;\nlet h: u32 = i / per;\nlet k: u32 = (i % per) / mchunks();\nlet ch: u32 = i % mchunks();\nlet o: vec4<f32> = bodat(h);\nlet zown: u32 = u32(o.w);\nvar gx: f32 = 0.0;\nvar gy: f32 = 0.0;\nlet z0: u32 = select(ch * MPCHUNK, 1u, ch == 0u);\nlet z1: u32 = select((ch + 1u) * MPCHUNK, mplanes(), (ch + 1u) * MPCHUNK > mplanes());\nif (mlocal()) {{\n  {pull_held_k}\n}} else {{\n  {pull_at_k}\n}}\ncel[P.part + 2u * i] = gx;\ncel[P.part + 2u * i + 1u] = gy;"
    sum_one := "let o: vec4<f32> = bodat(h);\n  let per: u32 = P.K * P.K * mchunks();\n  var gx: f32 = 0.0;\n  var gy: f32 = 0.0;\n  for (var j: u32 = 0u; j < per; j = j + 1u) {{\n    gx = gx + cel[P.part + 2u * (h * per + j)];\n    gy = gy + cel[P.part + 2u * (h * per + j) + 1u];\n  }}\n  let n: f32 = f32(P.K * P.K);\n  let f: f32 = mrecur(o.x, o.y, sqrt(gx * gx + gy * gy) / n);\n  cel[out + 4u * h] = gx / n * f;\n  cel[out + 4u * h + 1u] = gy / n * f;"
    /*
     * STREAM, HELD (Medium.stream_local): a point takes, on each of its ways, what stood one c-bar back along that way,
     * read by area off the four cells round there, on that way and `mwindow` either side, keeping what truly goes its
     * way and is past its body's own zone; what came of one body is one bundle here, read by area among the cells it
     * came through, and laid on the way out from where it left. More than MGROUPS bundles at one point are gathered
     * into the nearest as seen from there
     */
    hwant := "let c: u32 = i;\nif (c >= P.cells || !mlocal()) {{ return; }}\nlet W: u32 = mwindow();\n/* the ways anything can come on here: within the window of a way some cell within reach holds */\nvar want: array<u32, 4>;\n/* every way any cell within reach holds, gathered first, then widened by the window once */\nvar held: array<u32, 4>;\nlet R: i32 = i32(P.K) + 1;\nfor (var ddy: i32 = -R; ddy <= R; ddy = ddy + 1) {{\n  for (var ddx: i32 = -R; ddx <= R; ddx = ddx + 1) {{\n    let nc: i32 = mcell(i32(c % P.N) + ddx, i32(c / P.N) + ddy);\n    if (nc < 0) {{ continue; }}\n    for (var wd: u32 = 0u; wd < 4u; wd = wd + 1u) {{\n      held[wd] = held[wd] | u32(ho[mbits(u32(nc), wd)]);\n    }}\n  }}\n}}\nfor (var bb: u32 = 0u; bb < MGATHER; bb = bb + 1u) {{\n  if (((held[bb / 24u] >> (bb % 24u)) & 1u) == 0u) {{ continue; }}\n  for (var o: u32 = 0u; o < 2u * W + 1u; o = o + 1u) {{\n    let t: u32 = (bb + MGATHER + o - W) % MGATHER;\n    want[t / 24u] = want[t / 24u] | (1u << (t % 24u));\n  }}\n}}\n/* what this point held two ticks ago is cleared, and only the ways something reaches are laid again */\nfor (var wd: u32 = 0u; wd < 4u; wd = wd + 1u) {{\n  let had: u32 = u32(hn[mbits(c, wd)]);\n  for (var bo: u32 = 0u; bo < 24u; bo = bo + 1u) {{\n    if (((had >> bo) & 1u) == 1u) {{ hn[mocc(c, wd * 24u + bo)] = 0.0; }}\n  }}\n  hn[mbits(c, wd)] = 0.0;\n}}\nfor (var wd: u32 = 0u; wd < 4u; wd = wd + 1u) {{ hn[mwant(c, wd)] = f32(want[wd]); }}"
    hstream := "let c: u32 = i / MGATHER;\nlet t: u32 = i % MGATHER;\nif (c >= P.cells || !mlocal()) {{ return; }}\nif (((u32(hn[mwant(c, t / 24u)]) >> (t % 24u)) & 1u) == 0u) {{ return; }}\nlet x: f32 = f32(c % P.N);\nlet y: f32 = f32(c / P.N);\nlet W: u32 = mwindow();\nvar l: array<array<f32, 8>, MLIST>;\nlet way: vec2<f32> = mway(t);\nlet tw: f32 = tan(3.141592653589793 / f32(MGATHER)) * 1.001;\n/* each bundle that goes way t here, read one c-bar back along its own heading off the cells round that place (Medium.stream_local): those places lie between the ones half a way either side of t */\nlet a0: f32 = 6.283185307179586 * (f32(t) - 0.5) / f32(MGATHER);\nlet a1: f32 = 6.283185307179586 * (f32(t) + 0.5) / f32(MGATHER);\nlet p0x: f32 = x - f32(P.K) * cos(a0);\nlet p0y: f32 = y - f32(P.K) * sin(a0);\nlet p1x: f32 = x - f32(P.K) * cos(a1);\nlet p1y: f32 = y - f32(P.K) * sin(a1);\nlet lx0: i32 = i32(floor(min(p0x, p1x)));\nlet ly0: i32 = i32(floor(min(p0y, p1y)));\nlet nx: i32 = i32(floor(max(p0x, p1x))) + 2 - lx0;\nlet ny: i32 = i32(floor(max(p0y, p1y))) + 2 - ly0;\nvar n: u32 = 0u;\nfor (var j: i32 = 0; j < ny; j = j + 1) {{\n  for (var i2: i32 = 0; i2 < nx; i2 = i2 + 1) {{\n    let u: i32 = mcell(lx0 + i2, ly0 + j);\n    if (u < 0) {{ continue; }}\n    let ux: f32 = f32(lx0 + i2);\n    let uy: f32 = f32(ly0 + j);\n    for (var o: u32 = 0u; o < 2u * W + 1u; o = o + 1u) {{\n      let bb: u32 = (t + MGATHER + o - W) % MGATHER;\n      if (!mhaswas(u32(u), bb)) {{ continue; }}\n      for (var s: u32 = 0u; s < mslots(); s = s + 1u) {{\n        let k: u32 = mslot(u32(u), bb, s);\n        let q: f32 = ho[k];\n        if (!(q > 0.0)) {{ continue; }}\n        let lx: f32 = ho[k + 1u] / q;\n        let ly: f32 = ho[k + 2u] / q;\n        let dx: f32 = x - lx;\n        let dy: f32 = y - ly;\n        if (dx == 0.0 && dy == 0.0) {{ continue; }}\n        /* what heads more than half a way off this one is not on it: told off its place alone, before the rest is read */\n        let along: f32 = dx * way.x + dy * way.y;\n        if (!(along > 0.0) || abs(dx * way.y - dy * way.x) > along * tw) {{ continue; }}\n        if (mbin(dx, dy) != t) {{ continue; }}\n        /* where its ray came through, a c-bar back, and this cell's share of that place */\n        let dd: f32 = sqrt(dx * dx + dy * dy);\n        let cx: f32 = x - f32(P.K) * dx / dd;\n        let cy: f32 = y - f32(P.K) * dy / dd;\n        let ws: f32 = max(0.0, 1.0 - abs(ux - cx)) * max(0.0, 1.0 - abs(uy - cy)) / minside(cx, cy);\n        if (!(ws > 0.0)) {{ continue; }}\n        let m: array<f32, 8> = mwas(k);\n        let now: vec2<f32> = mnow(m, x, y);\n        if (sqrt((x - now.x) * (x - now.x) + (y - now.y) * (y - now.y)) <= mzone()) {{ continue; }}\n        var g: i32 = -1;\n        for (var gi: u32 = 0u; gi < n; gi = gi + 1u) {{\n          let h: array<f32, 8> = l[gi];\n          let same: bool = (m[6] != -1.0 && h[6] == m[6]) || (m[6] == -1.0 && h[6] == -1.0 && sqrt((h[1] / h[0] - lx) * (h[1] / h[0] - lx) + (h[2] / h[0] - ly) * (h[2] / h[0] - ly)) < 0.5 + 0.05 * sqrt(dx * dx + dy * dy));\n          if (g < 0 && same) {{ g = i32(gi); }}\n        }}\n        var part: array<f32, 8>;\n        for (var q2: u32 = 0u; q2 < 6u; q2 = q2 + 1u) {{ part[q2] = ws * m[q2]; }}\n        part[6] = m[6];\n        part[7] = ws * m[7];\n        if (g < 0 && n < MLIST) {{\n          l[n] = part;\n          n = n + 1u;\n        }} else {{\n          if (g < 0) {{\n            var best: f32 = 0.0;\n            for (var gi: u32 = 0u; gi < n; gi = gi + 1u) {{\n              let seen: f32 = mseen(l[gi], m, x, y);\n              if (g < 0 || seen < best) {{ g = i32(gi); best = seen; }}\n            }}\n            l[g][6] = -1.0;\n          }}\n          l[g][7] = mspread_with(l[g], part, x, y);\n          for (var q2: u32 = 0u; q2 < 6u; q2 = q2 + 1u) {{ l[g][q2] = l[g][q2] + part[q2]; }}\n        }}\n      }}\n    }}\n  }}\n}}\nif (n == 0u) {{ return; }}\n/* read by area: the shares of the cells it came through are already in it, and together they are the whole (Medium.stream_local) */\nhn[mocc(c, t)] = select(0.0, 1.0, mfill(c, t, l, n) > 0u);"
    /* and one body's on two neighbouring ways is one bundle here (a body has one ray at a point): gathered by the shares it came with, on the way out from where it left; then which ways hold anything */
    hjoin := "let c: u32 = i;\nif (c >= P.cells || !mlocal()) {{ return; }}\nlet x: f32 = f32(c % P.N);\nlet y: f32 = f32(c / P.N);\n/* which ways the stream laid, as the cell's own bits: the stream's threads each had one way, and only this one has the cell */\nfor (var wd: u32 = 0u; wd < 4u; wd = wd + 1u) {{\n  var bits: u32 = 0u;\n  for (var bo: u32 = 0u; bo < 24u; bo = bo + 1u) {{ if (hn[mocc(c, wd * 24u + bo)] > 0.5) {{ bits = bits | (1u << bo); }} }}\n  hn[mbits(c, wd)] = f32(bits);\n}}"
    /* the bodies near a cell, off each nearby cell's own list (Kernels MHLINK): the cells within R of (cx, cy), each list walked to its end */
    near_open := "let cx: i32 = i32(c % P.N);\nlet cy: i32 = i32(c / P.N);\nfor (var ddy: i32 = -R; ddy <= R; ddy = ddy + 1) {{\n  for (var ddx: i32 = -R; ddx <= R; ddx = ddx + 1) {{\n    let nc: i32 = mcell(cx + ddx, cy + ddy);\n    if (nc < 0) {{ continue; }}\n    var hh: i32 = atomicLoad(&link[u32(nc)]);\n    var guard: u32 = 0u;\n    loop {{\n      if (hh < 0 || guard > P.holes) {{ break; }}\n      guard = guard + 1u;\n      let h: u32 = u32(hh);\n      hh = atomicLoad(&link[P.cells + h]);"
    near_close := "    }}\n  }}\n}}"
    /* SHINE, HELD (Medium.shine_local): each source cell near a point lays its zone there as it stands, replacing what of it the stream brought; at its very middle, on no way */
    src_open := "let cx: i32 = i32(c % P.N);\nlet cy: i32 = i32(c / P.N);\nfor (var ddy: i32 = -R; ddy <= R; ddy = ddy + 1) {{\n  for (var ddx: i32 = -R; ddx <= R; ddx = ddx + 1) {{\n    let nc: i32 = mcell(cx + ddx, cy + ddy);\n    if (nc < 0) {{ continue; }}\n    let e: array<f32, 8> = msource(u32(nc));\n    if (!(e[0] > 0.0)) {{ continue; }}\n    let dx: f32 = x - e[1] / e[0];\n    let dy: f32 = y - e[2] / e[0];\n    let d: f32 = sqrt(dx * dx + dy * dy);\n    if (d > medge()) {{ continue; }}\n    if (d <= 0.001) {{ hn[mmid(c)] = hn[mmid(c)] + min(1.0, e[0] / pow(e[5] / e[0], xc(6u) - 1.0)); continue; }}\n    mdrop(c, e[6], mbin(dx, dy));\n    madd(c, mbin(dx, dy), mleft(e, d));\n  }}\n}}"
    /* a tick lays off the sources gathered as it opened (at the end of the tick before), so it reads them off the box it opened on */
    src_open_was := src_open.replace("msource(", "msourcewas(")
    hshine := "let c: u32 = i;\nif (i >= P.cells || !mlocal()) {{ return; }}\nlet x: f32 = f32(c % P.N);\nlet y: f32 = f32(c / P.N);\nhn[mmid(c)] = 0.0;\n/* what the shine gathered here last tick, and a cell's gathering, within the edge, are its own to lay again (Medium.shine_local) */\nfor (var b: u32 = 0u; b < MGATHER; b = b + 1u) {{\n  if (!mhas(c, b)) {{ continue; }}\n  var had: bool = false;\n  for (var s: u32 = 0u; s < mslots(); s = s + 1u) {{\n    let k: u32 = mslot(c, b, s);\n    if (hn[k] > 0.0 && hn[k + 6u] < 0.0 && mfresh(mheld(k), x, y)) {{ had = true; }}\n  }}\n  if (!had) {{ continue; }}\n  var l: array<array<f32, 8>, MLIST>;\n  var n: u32 = 0u;\n  for (var s: u32 = 0u; s < mslots(); s = s + 1u) {{\n    let m: array<f32, 8> = mheld(mslot(c, b, s));\n    if (m[0] > 0.0 && !(m[6] < 0.0 && mfresh(m, x, y)) && n < MLIST) {{ l[n] = m; n = n + 1u; }}\n  }}\n  mlay(c, b, l, n);\n}}\nlet R: i32 = i32(ceil(medge())) + 1;\n{src_open_was}"
    /* THE FIELD AS IF IT HAD ALWAYS BEEN THERE, HELD (Medium.seed_local): the ways emptied and each source's zone laid - what lies further out the stream carries there as the settling ticks run */
    hseed := "let c: u32 = i;\nif (i >= P.cells || !mlocal()) {{ return; }}\nlet x: f32 = f32(c % P.N);\nlet y: f32 = f32(c / P.N);\nfor (var b: u32 = 0u; b < MGATHER; b = b + 1u) {{ hn[mocc(c, b)] = 0.0; }}\nfor (var w: u32 = 0u; w < 4u; w = w + 1u) {{ hn[mbits(c, w)] = 0.0; }}\nhn[mmid(c)] = 0.0;\nlet R: i32 = i32(ceil(medge())) + 1;\n{src_open}"
    /* THE BODIES ON A CELL, GATHERED (Medium.cell_sources): their moments summed off the cell's own list; a lone body keeps its name, two or more are the cell's gathering (-2 - the cell) */
    hsrc := "let c: u32 = i;\nif (i >= P.cells || !mlocal()) {{ return; }}\nvar s: array<f32, 8>;\nvar n: u32 = 0u;\nvar hh: i32 = atomicLoad(&link[c]);\nloop {{\n  if (hh < 0 || n > P.holes) {{ break; }}\n  let h: u32 = u32(hh);\n  hh = atomicLoad(&link[P.cells + h]);\n  let e: array<f32, 8> = memit(h);\n  for (var j: u32 = 0u; j < 6u; j = j + 1u) {{ s[j] = s[j] + e[j]; }}\n  s[6] = select(-2.0 - f32(c), e[6], n == 0u);\n  /* and the last of them by number, one more than it (nought, none) - the body a cell's c-bar is blocked by (MBLOCK) */\n  s[7] = max(s[7], f32(h + 1u));\n  n = n + 1u;\n}}\nfor (var j: u32 = 0u; j < 8u; j = j + 1u) {{ hn[msrc(c) + j] = s[j]; }}"
    /* EACH CELL'S FAR BODIES, SUMMED ONCE A TICK (Medium.far_of, Medium.expanded): their fields' value, slope and bend at the cell's middle, nine numbers; the near ones listed by way and slot, for a point to read itself (marrive) */
    hfield := "let c: u32 = i;\nif (c >= P.cells || !mlocal()) {{ return; }}\nlet ux: f32 = f32(c % P.N);\nlet uy: f32 = f32(c / P.N);\nvar t: array<f32, 9>;\nvar n: u32 = 0u;\nlet L: u32 = mnear(c);\nfor (var wd: u32 = 0u; wd < 4u; wd = wd + 1u) {{\n  let bits: u32 = u32(hn[mbits(c, wd)]);\n  if (bits == 0u) {{ continue; }}\n  for (var bo: u32 = 0u; bo < 24u; bo = bo + 1u) {{\n    if (((bits >> bo) & 1u) == 0u) {{ continue; }}\n    let b: u32 = wd * 24u + bo;\n    for (var s: u32 = 0u; s < mslots(); s = s + 1u) {{\n      let k: u32 = mslot(c, b, s);\n      if (!(hn[k] > 0.0)) {{ continue; }}\n      let m: array<f32, 8> = mheld(k);\n      if (!mfar(m, ux, uy) && n < MNEAR) {{\n        hn[L + 1u + n] = f32(b * mslots() + s);\n        n = n + 1u;\n        continue;\n      }}\n      let e: array<f32, 9> = mtaylor(m, ux, uy);\n      for (var q: u32 = 0u; q < 9u; q = q + 1u) {{ t[q] = t[q] + e[q]; }}\n    }}\n  }}\n}}\nfor (var q: u32 = 0u; q < 9u; q = q + 1u) {{ hn[mtay(c) + q] = t[q]; }}\nhn[L] = f32(n);"
    /* EVERY BODY ON ITS CELL'S LIST, a tick at a time: the lists emptied, and each body put at the head of its own (MHCLEAR, MHLINK) - what makes every other step read only the bodies near it */
    hclear := "if (i >= P.cells || !mlocal()) {{ return; }}\natomicStore(&link[i], -1);"
    hlink := "if (i >= P.holes || !mlocal()) {{ return; }}\nlet o: vec4<f32> = bodat(i);\nlet c: i32 = mcell(i32(floor(o.x + 0.5)), i32(floor(o.y + 0.5)));\nif (c < 0) {{ atomicStore(&link[P.cells + i], -1); return; }}\nlet was: i32 = atomicExchange(&link[u32(c)], i32(i));\natomicStore(&link[P.cells + i], was);"
    [
      Kernels.kernel(d, "MHWANT", "cells", hwant),
      Kernels.kernel(d, "MHSTREAM", "cells*G", hstream),
      Kernels.kernel(d, "MHJOIN", "cells", hjoin),
      Kernels.kernel(d, "MHSHINE", "cells", hshine),
      Kernels.kernel(d, "MHSEED", "cells", hseed),
      Kernels.kernel(d, "MHCLEAR", "cells", hclear),
      Kernels.kernel(d, "MHSRC", "cells", hsrc),
      Kernels.kernel(d, "MHFIELD", "cells", hfield),
      Kernels.kernel(d, "MHLINK", "holes", hlink),
      Kernels.kernel(d, "MSTEPH", "holes", "if (i >= P.holes || !mapart()) {{ return; }}\nlet out: u32 = P.outs;\nlet h: u32 = i;\n{step_one}"),
      Kernels.kernel(d, "MPULLH", "pulls", part_one),
      Kernels.kernel(d, "MMOVEH", "holes", "if (i >= P.holes || !mapart()) {{ return; }}\nlet out: u32 = P.outs;\nlet h: u32 = i;\n{sum_one}"),
      /* MOVE, as the tick before it left it: a body turned by the lean it read, and carried there (Medium.move) */
      Kernels.kernel(d, "MSTEP", "one", "if (i >= 1u || mapart()) {{ return; }}\nlet out: u32 = P.outs;\nfor (var h: u32 = 0u; h < P.holes; h = h + 1u) {{\n  {step_one}\n}}"),
      /* where the bodies stand, a cell at a time: what a cell is blocked by, and whose rays are its own (Medium.block) */
      Kernels.kernel(d, "MBLOCK", "cells", "let c: u32 = i;\nif (i >= P.cells) {{ return; }}\nlet x: i32 = i32(c % P.N);\nlet y: i32 = i32(c / P.N);\nlet half: i32 = i32((P.K - 1u) / 2u);\nvar b: f32 = 0.0;\nvar pl: f32 = 0.0;\nif (mlocal()) {{\n  /* held where they are, the last body standing on any cell of the footprint, off each cell's own source (gathered again once they moved): every body apart is on the plane one past its number */\n  for (var ddy: i32 = -half; ddy <= half; ddy = ddy + 1) {{\n    for (var ddx: i32 = -half; ddx <= half; ddx = ddx + 1) {{\n      let nc: i32 = mcell(x + ddx, y + ddy);\n      if (nc >= 0) {{ b = max(b, hn[msrc(u32(nc)) + 7u]); }}\n    }}\n  }}\n  pl = b;\n}} else {{\nfor (var h: u32 = 0u; h < P.holes; h = h + 1u) {{\n  let o: vec4<f32> = bodat(h);\n  if (abs(x - i32(floor(o.x + 0.5))) <= half && abs(y - i32(floor(o.y + 0.5))) <= half) {{ b = f32(h + 1u); pl = o.w; }}\n}}\n}}\ncel[5u * P.cells + c] = b;\ncel[(8u + mledger()) * P.cells + c] = pl;"),
      /* what was sent, kept as it stands while it is carried on */
      Kernels.kernel(d, "MKEEP", "rungs", "if (mlocal()) {{ return; }}\nlet n: u32 = RUNGS();\nif (i >= mplanes() * n) {{ return; }}\nlet z: u32 = i / n;\nlet r: u32 = i % n;\ncel[BEAMWAS(z, r)] = cel[BEAMAT(z, r)];"),
      /* STREAM and SHINE: what was sent goes a c-bar on, thinned over the shell it crosses, and a body announces on the first rung out (Medium.stream, Medium.shine) */
      Kernels.kernel(d, "MCARRY", "rungs", "if (mlocal()) {{ return; }}\nlet n: u32 = RUNGS();\nif (i >= mplanes() * n) {{ return; }}\nlet z: u32 = i / n;\nlet r: u32 = i % n;\nvar v: f32 = 0.0;\nif (z == 0u) {{ v = 0.0; }} else if (r == 0u) {{\n  /* every body apart: the plane is that body's own, looked up rather than searched for among all of them */\n  var h0: u32 = 0u;\n  var h1: u32 = P.holes;\n  if (mapart()) {{\n    let w: i32 = whom(z);\n    h1 = 0u;\n    if (w >= 0) {{ h0 = u32(w); h1 = u32(w) + 1u; }}\n  }}\n  for (var h: u32 = h0; h < h1; h = h + 1u) {{\n    let o: vec4<f32> = bodat(h);\n    if (u32(o.w) != z) {{ continue; }}\n    let g: vec4<f32> = bodgo(h);\n    let beta: f32 = min(1.0, sqrt(g.x * g.x + g.y * g.y) / o.z);\n    v = v + mper_way(o.z, beta) * bodskin(h) * mdrift(h);\n  }}\n}} else {{\n  let D: f32 = xc(6u);\n  let face: f32 = facing_out(z);\n  let here: f32 = max(face, f32(r));\n  let back: f32 = max(face, f32(r) - 1.0);\n  v = cel[BEAMWAS(z, r - 1u)] * pow(back / here, D - 1.0);\n}}\ncel[BEAMAT(z, r)] = min(1.0, v);"),
      /* THE BOX AS THE TICK OPENED: every step reads these (Medium.open) */
      Kernels.kernel(d, "MOPEN", "cells", "let c: u32 = i;\nif (i >= P.cells) {{ return; }}\nlet x: f32 = f32(c % P.N);\nlet y: f32 = f32(c / P.N);\nvar got: f32 = 0.0;\n/* held where they are, what stands at a point is what its ways hold (Medium.held_at) */\nif (mlocal()) {{ got = mheldat(c); }}\nfor (var z: u32 = 1u; z < select(mplanes(), 1u, mlocal()); z = z + 1u) {{\n  let way: vec3<f32> = mout(z, x, y);\n  if (way.z <= 0.0) {{ continue; }}\n  got = got + msent(z, way.z);\n}}\ncel[c] = min(1.0, mact(got) + xc(4u) * mvac(c));\ncel[1u * P.cells + c] = st[at_plane(FOLD(), c)] + xc(4u) * xc(0u);\ncel[6u * P.cells + c] = 0.0;\ncel[(7u + mledger()) * P.cells + c] = 0.0;"),
      /* MEET: one body's rays against another's, as much as their ways overlap (Medium.meet) */
      Kernels.kernel(d, "MMEET", "cells", "let c: u32 = i;\nif (i >= P.cells) {{ return; }}\nlet x: f32 = f32(c % P.N);\nlet y: f32 = f32(c / P.N);\nlet rho: f32 = cel[c];\nlet nf: f32 = cel[1u * P.cells + c];\nvar fold: f32 = 0.0;\nvar grew: f32 = 0.0;\nvar gone: f32 = 0.0;\n/* EVERY BODY APART: what arrives gathered by the way it comes from, bundle meeting facing bundle (Medium.meet_gathered) */\nif (mapart()) {{\n  var sums: array<f32, {gather}>;\n  var wxs: array<f32, {gather}>;\n  var wys: array<f32, {gather}>;\n  for (var b: u32 = 0u; b < MGATHER; b = b + 1u) {{ sums[b] = 0.0; wxs[b] = 0.0; wys[b] = 0.0; }}\n  /* held where they are, the bins are what the point's own ways hold, and what goes no way out on the way whose angle is nought (Medium.meet_local) */\n  if (mlocal()) {{\n    for (var b: u32 = 0u; b < MGATHER; b = b + 1u) {{\n      if (!mhas(c, b)) {{ continue; }}\n      for (var s: u32 = 0u; s < mslots(); s = s + 1u) {{\n        let k: u32 = mslot(c, b, s);\n        if (!(hn[k] > 0.0)) {{ continue; }}\n        let got: vec3<f32> = mreads(mheld(k), x, y);\n        sums[b] = sums[b] + got.x;\n        wxs[b] = wxs[b] + got.x * got.y;\n        wys[b] = wys[b] + got.x * got.z;\n      }}\n    }}\n    sums[0] = sums[0] + hn[mmid(c)];\n  }}\n  for (var z: u32 = 1u; z < select(mplanes(), 1u, mlocal()); z = z + 1u) {{\n    let way: vec3<f32> = mout(z, x, y);\n    if (way.z <= 0.0) {{ continue; }}\n    let got: f32 = msent(z, way.z);\n    if (got <= 0.0) {{ continue; }}\n    let b: u32 = mbin(way.x, way.y);\n    sums[b] = sums[b] + got;\n    wxs[b] = wxs[b] + got * way.x;\n    wys[b] = wys[b] + got * way.y;\n  }}\n  for (var a: u32 = 0u; a < MGATHER; a = a + 1u) {{\n    if (sums[a] <= 0.0) {{ continue; }}\n    let na: f32 = sqrt(wxs[a] * wxs[a] + wys[a] * wys[a]);\n    /* rays with no way out of them (at a body's own middle) face nothing, but still meet the vacuum's own */\n    let ax: f32 = select(0.0, wxs[a] / na, na > 0.0);\n    let ay: f32 = select(0.0, wys[a] / na, na > 0.0);\n    let mine: f32 = sums[a];\n    /* a bundle meets only what comes within a turn of the lattice's own of head on, and each bundle's way lies inside its own bin: so only the bins that near the opposite one are looked at - the rest would each be skipped below */\n    let span: u32 = u32(ceil(f32(MGATHER) / P.DEG)) + 1u;\n    let many: u32 = min(MGATHER, 2u * span + 1u);\n    let first: u32 = (a + MGATHER / 2u + MGATHER - min(span, MGATHER / 2u)) % MGATHER;\n    for (var s: u32 = 0u; s < many; s = s + 1u) {{\n      let b: u32 = (first + s) % MGATHER;\n      if (b == a || sums[b] <= 0.0 || na <= 0.0) {{ continue; }}\n      let nb: f32 = sqrt(wxs[b] * wxs[b] + wys[b] * wys[b]);\n      if (nb <= 0.0) {{ continue; }}\n      let bx: f32 = wxs[b] / nb;\n      let by: f32 = wys[b] / nb;\n      if (-(ax * bx + ay * by) <= cos(6.283185307179586 / P.DEG)) {{ continue; }}\n      let over: f32 = mfacing(ax, ay, bx, by);\n      if (over <= 0.0) {{ continue; }}\n      let theirs: f32 = sums[b];\n{meet_code}\n    }}\n    if (xc(4u) > 0.5) {{\n      let theirs: f32 = xc(1u);\n      let over: f32 = 1.0 / P.DEG;\n{meet_code}\n    }}\n  }}\n}}\nfor (var z: u32 = 1u; z < select(mplanes(), 1u, mapart()); z = z + 1u) {{\n  let way: vec3<f32> = mout(z, x, y);\n  if (way.z <= 0.0) {{ continue; }}\n  let mine: f32 = msent(z, way.z);\n  if (mine <= 0.0) {{ continue; }}\n  for (var yy: u32 = 1u; yy < mplanes(); yy = yy + 1u) {{\n    if (yy == z) {{ continue; }}\n    let their: vec3<f32> = mout(yy, x, y);\n    if (their.z <= 0.0) {{ continue; }}\n    let theirs: f32 = msent(yy, their.z);\n    if (theirs <= 0.0) {{ continue; }}\n    /* the two only meet where their ways have something in common, which is a turn of the lattice's own at most: the rest of the box is skipped before any of it is worked out */\n    if (-(way.x * their.x + way.y * their.y) <= cos(6.283185307179586 / P.DEG)) {{ continue; }}\n    let over: f32 = mfacing(way.x, way.y, their.x, their.y);\n    if (over <= 0.0) {{ continue; }}\n{meet_code}\n  }}\n  /* and against the vacuum's own rays, which stand on every way there is (Medium.meet) */\n  if (xc(4u) > 0.5) {{\n    let theirs: f32 = xc(1u);\n    let over: f32 = 1.0 / P.DEG;\n{meet_code}\n  }}\n}}\nst[at_plane(FOLD(), c)] = max(0.0, st[at_plane(FOLD(), c)] + fold);\ncel[6u * P.cells + c] = gone;\ncel[(7u + mledger()) * P.cells + c] = grew;"),
      /* UNFOLD: in a dark half creation hands back the folds a point holds (Medium.unfold) */
      Kernels.kernel(d, "MUNFOLD", "cells", "let c: u32 = i;\nif (i >= P.cells) {{ return; }}\nlet rho: f32 = cel[c];\n/* the excess above the settled vacuum's own record, which is all the fold plane holds: the vacuum's own is not carried and neither is its clearing (Medium.unfold) */\nlet nf: f32 = cel[1u * P.cells + c] - xc(4u) * xc(0u);\nvar h: f32 = 0.0;\nif (P.tick % 2u == 1u) {{\n{unfold_code}\n}}\nst[at_plane(FOLD(), c)] = max(0.0, st[at_plane(FOLD(), c)] + h);\nst[at_plane(STAND(), c)] = max(0.0, nf + h);"),
      /* what is to be carried, kept as it stands (Medium.stream) */
      /* STREAM: one c-bar on, the way out from the body it came from, thinned over the shell it crosses (Medium.stream) */
      /* MAKE: what the point terms grow, per local (Medium.make) */
      /* THE VACUUM SETTLED AGAINST WHAT THE BODIES PUT THERE (Medium.settle_rho): where the settled vacuum runs under the bodies, the population at a cell is the root of its own balance, struck beside the bodies' rays - the line falls with the population, so one bisection finds where it nets nought (`mnets`, among the helpers) */
      Kernels.kernel(d, "MSETTLE", "cells", "let c: u32 = i;\nif (i >= P.cells) {{ return; }}\nif (xc(4u) < 0.5) {{ return; }}\nlet nf: f32 = cel[1u * P.cells + c];\nlet theirs: f32 = max(0.0, cel[c] - mvac(c));\nvar lo: f32 = 0.0;\nvar hi: f32 = 1.0;\nfor (var k: i32 = 0; k < 24; k = k + 1) {{\n  let mid: f32 = (lo + hi) / 2.0;\n  if (mnets(min(1.0, mid + theirs), nf) > 0.0) {{ lo = mid; }} else {{ hi = mid; }}\n}}\nst[at_plane(VAC(), c)] = (lo + hi) / 2.0;"),
      Kernels.kernel(d, "MMAKE", "cells", "let c: u32 = i;\nif (i >= P.cells) {{ return; }}\nlet rho: f32 = cel[c];\nlet nf: f32 = cel[1u * P.cells + c];\nvar grown: f32 = cel[(7u + mledger()) * P.cells + c];\n{point_code}\n{single_code}\ncel[(7u + mledger()) * P.cells + c] = grown;"),
      /* SOURCE: what a body announces stands where it truly is (Medium.shine) */
      /* a way holds at most one ray out of the beat's phase (Medium.shine) */
      /* where a point at each cell is going, for what a panel draws (Medium.lean) */
      Kernels.kernel(d, "MLEAN", "cells", "let c: u32 = i;\nif (i >= P.cells) {{ return; }}\nlet x: f32 = f32(c % P.N);\nlet y: f32 = f32(c / P.N);\nlet zown: u32 = u32(cel[(8u + mledger()) * P.cells + c]);\nlet rho: f32 = cel[c];\nlet nf: f32 = cel[1u * P.cells + c];\nvar rate: f32 = 0.0;\n{rate_code}\nlet stood: f32 = st[at_plane(STAND(), c)];\nvar gx: f32 = 0.0;\nvar gy: f32 = 0.0;\nif (mlocal()) {{\n  let came: vec3<f32> = marrive(x, y, zown);\n  let per: f32 = rate / select(1.0, 1.0 + stood, xc(20u) > 0.5);\n  gx = gx - per * came.y;\n  gy = gy - per * came.z;\n}}\nfor (var z: u32 = 1u; z < select(mplanes(), 1u, mlocal()); z = z + 1u) {{\n  if (z == zown) {{ continue; }}\n  let way: vec3<f32> = mout(z, x, y);\n  if (way.z <= 0.0) {{ continue; }}\n  let share: f32 = rate * mact(msent(z, way.z)) / select(1.0, 1.0 + stood, xc(20u) > 0.5);\n  gx = gx - share * way.x;\n  gy = gy - share * way.y;\n}}\nlet f: f32 = mrecur(x, y, sqrt(gx * gx + gy * gy));\ncel[2u * P.cells + c] = gx * f;\ncel[3u * P.cells + c] = gy * f;\ncel[4u * P.cells + c] = st[at_plane(FOLD(), c)];"),
      /* MOVE: where each body's point is going, read where it truly stands (Medium.pull_at) */
      Kernels.kernel(d, "MMOVE", "one", "if (i >= 1u || mapart()) {{ return; }}\nlet out: u32 = P.outs;\nlet half: f32 = f32(P.K - 1u) / 2.0;\nfor (var h: u32 = 0u; h < P.holes; h = h + 1u) {{\n  {pull_one}\n}}"),
      /* the same where the host asks, with the named plane left out (Medium.pull_at) */
      Kernels.kernel(d, "MPROBE", "entries", "if (i >= P.entries) {{ return; }}\nlet ask: vec4<f32> = dir[P.A + 2u * MAXH + CN + i];\nlet zown: u32 = u32(ask.z);\nlet half: f32 = f32(P.K - 1u) / 2.0;\nvar gx: f32 = 0.0;\nvar gy: f32 = 0.0;\nfor (var k: u32 = 0u; k < P.K * P.K; k = k + 1u) {{\n  let px: f32 = ask.x - half + f32(k % P.K);\n  let py: f32 = ask.y - half + f32(k / P.K);\n  let rho: f32 = mtapc(0u, px, py, 0.0);\n  let nf: f32 = mtapc(1u, px, py, 0.0);\n  var rate: f32 = 0.0;\n{rate_code}\n  let stood: f32 = mtap(STAND(), px, py, 0.0);\n  if (mlocal()) {{\n    let came: vec3<f32> = marrive(px, py, zown);\n    let per: f32 = rate / select(1.0, 1.0 + stood, xc(20u) > 0.5);\n    gx = gx - per * came.y;\n    gy = gy - per * came.z;\n  }}\n  for (var z: u32 = 1u; z < select(mplanes(), 1u, mlocal()); z = z + 1u) {{\n    if (z == zown) {{ continue; }}\n    let way: vec3<f32> = mout(z, px, py);\n    if (way.z <= 0.0) {{ continue; }}\n    let share: f32 = rate * mact(msent(z, way.z)) / select(1.0, 1.0 + stood, xc(20u) > 0.5);\n    gx = gx - share * way.x;\n    gy = gy - share * way.y;\n  }}\n}}\nlet n: f32 = f32(P.K * P.K);\nlet f: f32 = mrecur(ask.x, ask.y, sqrt(gx * gx + gy * gy) / n);\nlet out: u32 = P.outs + 4u * MAXM;\ncel[out + 2u * i] = gx / n * f;\ncel[out + 2u * i + 1u] = gy / n * f;"),
      /* what a panel reads: what each body has sent, at each cell */
      Kernels.kernel(d, "MSWEEP", "cells", "let c: u32 = i;\nif (i >= P.cells) {{ return; }}\nlet x: f32 = f32(c % P.N);\nlet y: f32 = f32(c / P.N);\ncel[7u * P.cells + c] = 0.0;\n/* every body apart: all the bodies' rays together on one ledger (Medium.apart) */\nif (mapart()) {{\n  var summed: f32 = select(0.0, mheldat(c), mlocal());\n  for (var z: u32 = 1u; z < select(mplanes(), 1u, mlocal()); z = z + 1u) {{\n    let way: vec3<f32> = mout(z, x, y);\n    summed = summed + select(0.0, msent(z, way.z), way.z > 0.0);\n  }}\n  cel[8u * P.cells + c] = summed;\n  return;\n}}\nfor (var z: u32 = 1u; z < mplanes(); z = z + 1u) {{\n  let way: vec3<f32> = mout(z, x, y);\n  cel[(7u + z) * P.cells + c] = select(0.0, msent(z, way.z), way.z > 0.0);\n}}")
    ].join("\n\n")
  }


  static kernel (d: Language, nm: String, over: String, body: String): String => {
    entry := d.entry(nm, body)
    "//! kernel {nm} over {over}\n{entry}"
  }

  /* a ledger of a cell */
  static slot (k: N, c: String): String => "cel[{k}u * P.cells + {c}]"
  static guard (bound: String): String => "if (i >= {bound}) {{ return; }}"

  /* the helpers: indices into the planes, the steps, the headings, what moves, and whose rays meet */
  static helpers (d: Language): String => {
    cp := d.ctx_params
    ca := d.ctx_args
    a_ := d.arg("a", "u32")
    b_ := d.arg("b", "u32")
    c_ := d.arg("c", "u32")
    z_ := d.arg("z", "u32")
    ac := "{cp}{a_}, {c_}"
    ca_ := "{cp}{c_}, {a_}"
    zac := "{cp}{z_}, {a_}, {c_}"
    index := [
      d.func("nA", ac, "u32", "return a * P.cells + c;"),
      d.func("wA", ac, "u32", "return P.cells * P.A + a * P.cells + c;"),
      d.func("dA", ac, "u32", "return 2u * P.cells * P.A + a * P.cells + c;"),
      d.func("fA", ac, "u32", "return 3u * P.cells * P.A + a * P.cells + c;"),
      d.func("tA", ac, "u32", "return 4u * P.cells * P.A + a * P.cells + c;"),
      d.func("aA", ac, "u32", "return 5u * P.cells * P.A + a * P.cells + c;"),
      d.func("eA", ac, "u32", "return 6u * P.cells * P.A + a * P.cells + c;"),
      d.func("kA", ac, "u32", "return 7u * P.cells * P.A + a * P.cells + c;"),
      d.func("gA", ac, "u32", "return 8u * P.cells * P.A + a * P.cells + c;"),
      d.func("bA", zac, "u32", "return (9u + 2u * z) * P.cells * P.A + a * P.cells + c;"),
      d.func("beA", zac, "u32", "return (10u + 2u * z) * P.cells * P.A + a * P.cells + c;"),
      /* how much of cell c its neighbour across a has swallowed (Field.swallow), and the scratch plane after it */
      d.func("swA", ac, "u32", "return (9u + 2u * (P.tags - 1u)) * P.cells * P.A + a * P.cells + c;"),
      d.func("sA", ac, "u32", "return (10u + 2u * (P.tags - 1u)) * P.cells * P.A + a * P.cells + c;")
    ]
    /* one step, on the grid: a step lands by area on the four cells around its true position - `tap(c, a, sign, k)` is the k-th of them, or -1, and `tapw` its weight; past the window's edge a tap is left out */
    k_ := d.arg("k", "u32")
    sign_ := d.arg("sign", "f32")
    px := d.fix("px", "f32", "f32_of_u(c % P.N) + sign * dir[a].z")
    py := d.fix("py", "f32", "f32_of_u(c / P.N) + sign * dir[a].w")
    x0 := d.fix("x0", "i32", "i32_of_f(floor(px))")
    y0 := d.fix("y0", "i32", "i32_of_f(floor(py))")
    tx := d.fix("tx", "i32", "x0 + i32_of_u(k % 2u)")
    ty := d.fix("ty", "i32", "y0 + i32_of_u(k / 2u)")
    edge := "if (tx < 0 || ty < 0 || tx >= i32_of_u(P.N) || ty >= i32_of_u(P.N)) {{ return -1; }}\nreturn ty * i32_of_u(P.N) + tx;"
    tap := d.func("tap", "{cp}{c_}, {a_}, {sign_}, {k_}", "i32", "{px}\n{py}\n{x0}\n{y0}\n{tx}\n{ty}\n{edge}")
    fx := d.fix("fx", "f32", "px - floor(px)")
    fy := d.fix("fy", "f32", "py - floor(py)")
    wx := d.fix("wx", "f32", "select(1.0 - fx, fx, (k % 2u) == 1u)")
    wy := d.fix("wy", "f32", "select(1.0 - fy, fy, (k / 2u) == 1u)")
    tapw := d.func("tapw", "{cp}{c_}, {a_}, {sign_}, {k_}", "f32", "{px}\n{py}\n{fx}\n{fy}\n{wx}\n{wy}\nreturn wx * wy;")
    opp := d.func("opp", "{cp}{a_}", "u32", "return (a + P.A / 2u) % P.A;")
    /* how far the way across a from c leads into space c has swallowed: its fold there as a share of one point (Field.owns) */
    owns := d.func("owns", "{cp}{c_}, {a_}", "f32", "return clampf(st[gA({ca}a, c)] * (P.DEG / f32_of_u(P.A)), 0.0, 1.0);")
    /* the cell one whole step across a from c, hops rounded away from nought (Field.hop_from), or -1 past the window */
    hx := d.fix("hx", "i32", "i32_of_f(select(-floor(0.5 - dir[a].z), floor(dir[a].z + 0.5), dir[a].z >= 0.0))")
    hy := d.fix("hy", "i32", "i32_of_f(select(-floor(0.5 - dir[a].w), floor(dir[a].w + 0.5), dir[a].w >= 0.0))")
    hxx := d.fix("tx", "i32", "i32_of_u(c % P.N) + hx")
    hyy := d.fix("ty", "i32", "i32_of_u(c / P.N) + hy")
    hopc := d.func("hopc", "{cp}{c_}, {a_}", "i32", "{hx}\n{hy}\n{hxx}\n{hyy}\nif (tx < 0 || ty < 0 || tx >= i32_of_u(P.N) || ty >= i32_of_u(P.N)) {{ return -1; }}\nreturn ty * i32_of_u(P.N) + tx;")
    /* what stands at (a, c) as the rules so far have left it: what opened the tick, less what was taken - by meetings, and by sources */
    m0 := d.mut("m", "f32", "0.0")
    view := d.func("view", ac, "f32", "{m0}\nm = st[wA({ca}a, c)] + st[tA({ca}a, c)] + st[aA({ca}a, c)];\nreturn maxf(0.0, m);")
    moving := d.func("moving", ac, "f32", "return view({ca}a, c);")
    /* one tag's share of that */
    had0 := d.mut("had", "f32", "0.0")
    whole0 := d.mut("whole", "f32", "0.0")
    f0 := d.mut("f", "f32", "0.0")
    of_tag := "{had0}\n{whole0}\nhad = st[bA({ca}z, a, c)];\nwhole = st[wA({ca}a, c)];\nif (had <= 0.0 || whole <= 0.0) {{ return 0.0; }}\n{f0}\nf = (whole + st[tA({ca}a, c)] + st[aA({ca}a, c)]) / whole;\nif (f < 0.0) {{ f = 0.0; }}\nreturn had * f;"
    moving_of := d.func("moving_of", zac, "f32", of_tag)
    /* how much of a meeting between the rays at i and j is the first body against another */
    i_ := d.arg("i", "u32")
    j_ := d.arg("j", "u32")
    wi := d.fix("wi", "f32", "st[P.cells * P.A + i]")
    wj := d.fix("wj", "f32", "st[P.cells * P.A + j]")
    alli0 := d.mut("alli", "f32", "0.0")
    allj0 := d.mut("allj", "f32", "0.0")
    each_z := d.loop("z", "P.tags - 1u", "alli = alli + st[(9u + 2u * z) * P.cells * P.A + i];\nallj = allj + st[(9u + 2u * z) * P.cells * P.A + j];")
    f1i := d.fix("f1i", "f32", "st[9u * P.cells * P.A + i] / wi")
    f1j := d.fix("f1j", "f32", "st[9u * P.cells * P.A + j] / wj")
    crossing_body := "if (P.tags < 3u) {{ return 0.0; }}\n{wi}\n{wj}\nif (wi <= 0.0 || wj <= 0.0) {{ return 0.0; }}\n{f1i}\n{f1j}\n{alli0}\n{allj0}\n{each_z}\nalli = alli / wi;\nallj = allj / wj;\nreturn f1i * (allj - f1j) + (alli - f1i) * f1j;"
    crossing := d.func("crossing", "{cp}{i_}, {j_}", "f32", crossing_body)
    /* how much of what stood at i as the tick opened a source put there: the bodies' share of the way (Field.bodily) */
    bw := d.fix("w", "f32", "st[P.cells * P.A + i]")
    bsum0 := d.mut("b", "f32", "0.0")
    bsum := d.loop("z", "P.tags - 1u", "b = b + st[(9u + 2u * z) * P.cells * P.A + i];")
    bodily := d.func("bodily", "{cp}{i_}", "f32", "{bw}\nif (w <= 0.0) {{ return 0.0; }}\n{bsum0}\n{bsum}\nreturn clampf(b / w, 0.0, 1.0);")
    index.concat([tap, tapw, opp, owns, hopc, view, moving, moving_of, crossing, bodily]).join("\n\n")
  }

  /* the symbols a term is read against, at a cell whose density and folds are given */
  static symbols (d: Language): String => [d.fix("F", "f32", "1.0"), d.fix("omega", "f32", "1.0"), d.fix("beta", "f32", "0.0"), d.fix("DEG", "f32", "P.DEG")].join("\n")

  /* one meeting term as four functions of (rho, nf): its gate, and what it does to rays, space, folds */
  static meet_fns (d: Language, k: N, t: *): String => {
    cp := d.ctx_params
    rho_ := d.arg("rho", "f32")
    nf_ := d.arg("nf", "f32")
    params := "{cp}{rho_}, {nf_}"
    sym := Kernels.symbols(d)
    gate := t.doing.share.as(d)
    rays := t.doing.rays.as(d)
    space := t.doing.space.as(d)
    folds := t.doing.folds.as(d)
    [
      d.func("meet{k}_gate", params, "f32", "{sym}\nreturn clampf({gate}, 0.0, 1.0);"),
      d.func("meet{k}_rays", params, "f32", "{sym}\nreturn {rays};"),
      d.func("meet{k}_space", params, "f32", "{sym}\nreturn {space};"),
      d.func("meet{k}_folds", params, "f32", "{sym}\nreturn {folds};")
    ].join("\n\n")
  }

  /* a point term's gate as a function of (rho, nf), for reading it at a way */
  static point_fns (d: Language, k: N, t: *): String => {
    cp := d.ctx_params
    rho_ := d.arg("rho", "f32")
    nf_ := d.arg("nf", "f32")
    sym := Kernels.symbols(d)
    gate := t.doing.share.as(d)
    d.func("point{k}_gate", "{cp}{rho_}, {nf_}", "f32", "{sym}\nreturn clampf({gate}, 0.0, 1.0);")
  }

  static snap (d: Language): String => {
    guard := Kernels.guard("P.cells * P.A")
    wipe := d.loop("z", "P.tags - 1u", "st[(10u + 2u * z) * P.cells * P.A + i] = 0.0;")
    "{guard}\nst[P.cells * P.A + i] = st[i];\nst[8u * P.cells * P.A + i] = st[3u * P.cells * P.A + i];\nst[2u * P.cells * P.A + i] = 0.0;\nst[4u * P.cells * P.A + i] = 0.0;\nst[5u * P.cells * P.A + i] = 0.0;\nst[6u * P.cells * P.A + i] = 0.0;\nst[7u * P.cells * P.A + i] = 0.0;\n{wipe}"
  }

  static sweep (d: Language): String => {
    ca := d.ctx_args
    c_ := d.fix("c", "u32", "i")
    guard := Kernels.guard("P.cells")
    s0 := d.mut("s", "f32", "0.0")
    sum := d.loop("a", "P.A", "s = s + clampf(st[wA({ca}a, c)], 0.0, 1.0);")
    rho := Kernels.slot(Kernels.SLOT_RHO, "c")
    "{c_}\n{guard}\n{s0}\n{sum}\n{rho} = s / f32_of_u(P.A);"
  }

  /* what stands on every heading at each body's cell, laid out per body for the host: the source rules run there */
  static gather (d: Language): String => {
    ca := d.ctx_args
    lines := [
      Kernels.guard("P.holes * P.A"),
      d.fix("h", "u32", "i / P.A"),
      d.fix("a", "u32", "i % P.A"),
      d.fix("cx", "i32", "i32_of_f(dir[P.A + h].x)"),
      d.fix("cy", "i32", "i32_of_f(dir[P.A + h].y)"),
      "st[sA({ca}0u, i)] = 0.0;",
      "st[sA({ca}0u, P.holes * P.A + i)] = 0.0;",
      "if (cx < 0 || cy < 0 || cx >= i32_of_u(P.N) || cy >= i32_of_u(P.N)) {{ return; }}",
      d.fix("c", "u32", "u32_of_i(cy) * P.N + u32_of_i(cx)"),
      "st[sA({ca}0u, i)] = view({ca}a, c);",
      /* and the folds there as the tick opened, after what stands: what a body's step leans on */
      "st[sA({ca}0u, P.holes * P.A + i)] = st[gA({ca}a, c)];",
      /* and the folds at the point across each heading, one block of A per (body, heading): the space around a body, as its rules ask it */
      d.fix("nx", "i32", "cx + i32_of_f(select(-floor(0.5 - dir[a].z), floor(dir[a].z + 0.5), dir[a].z >= 0.0))"),
      d.fix("ny", "i32", "cy + i32_of_f(select(-floor(0.5 - dir[a].w), floor(dir[a].w + 0.5), dir[a].w >= 0.0))"),
      d.fix("inside", "u32", "select(0u, 1u, nx >= 0 && ny >= 0 && nx < i32_of_u(P.N) && ny < i32_of_u(P.N))"),
      d.fix("nc", "u32", "select(0u, u32_of_i(ny) * P.N + u32_of_i(nx), inside == 1u)"),
      d.loop("b", "P.A", "st[sA({ca}0u, 2u * P.holes * P.A + i * P.A + b)] = select(0.0, st[gA({ca}b, nc)], inside == 1u);"),
      /* and how much of that neighbour its own neighbours have swallowed, per heading: where a landing there is a landing in (Field.drift_at) */
      d.loop("b", "P.A", "st[sA({ca}0u, (2u + P.A) * P.holes * P.A + i * P.A + b)] = select(0.0, st[swA({ca}b, nc)], inside == 1u);"),
      /* and how much of the body's own cell each of its neighbours has swallowed: where the cell it stands on is going (Field.sinks_at) */
      "st[sA({ca}0u, (2u + 2u * P.A) * P.holes * P.A + i)] = st[swA({ca}a, c)];"
    ]
    lines.join("\n")
  }

  /* what the source rules did, applied - by ONE thread, in order: two entries may land on the same (heading, cell) - a source's light on another's cell it is absorbing at - and threads adding to one place lose updates. An entry is (index into a plane, amount, tag, kind): kind 0 takes (absorbs) rays on a heading at a cell, kind 1 lights them there */
  static apply (d: Language): String => {
    maxh := Kernels.MAXH
    /* the ways, the bodies twice over and the closure's own constants stand before what the rules ask to be applied - the same place the medium keeps them (Kernels.medium_helpers), so both worlds read one layout */
    cn := ((Kernels.MEDIUM_EXTRAS + 3) / 4).floor
    each := [
      d.fix("k", "u32", "u32_of_i(i32_of_f(dir[P.A + 2u * {maxh}u + {cn}u + e].x))"),
      d.fix("amount", "f32", "dir[P.A + 2u * {maxh}u + {cn}u + e].y"),
      d.fix("tag", "i32", "i32_of_f(dir[P.A + 2u * {maxh}u + {cn}u + e].z)"),
      d.fix("kind", "f32", "dir[P.A + 2u * {maxh}u + {cn}u + e].w"),
      "st[2u * P.cells * P.A + k] = st[2u * P.cells * P.A + k] + amount;",
      "if (kind < 0.5) {{",
      "  st[5u * P.cells * P.A + k] = st[5u * P.cells * P.A + k] + amount;",
      "}} else {{",
      "  st[6u * P.cells * P.A + k] = st[6u * P.cells * P.A + k] + amount;",
      "  if (tag > 0 && tag < i32_of_u(P.tags)) {{ st[(10u + 2u * u32_of_i(tag - 1)) * P.cells * P.A + k] = st[(10u + 2u * u32_of_i(tag - 1)) * P.cells * P.A + k] + amount; }}",
      "}}"
    ].join("\n")
    guard := Kernels.guard("1u")
    loop := d.loop("e", "P.entries", each)
    "{guard}\n{loop}"
  }

  /* the point terms: on the cell, against rho^degree; rays over every way, space to the ledger, folds to every way */
  /* the point terms: on the cell, against rho^degree; rays over every way - SET where the term sets, so a way gains what it lacked -, space to the ledger, folds to every way. What is made stands where it is made */
  static create (d: Language, point: Array, which: N[]): String => {
    ca := d.ctx_args
    ind := Kernels.IND
    lines := which.map(k => {
      t := point[k]
      share := t.doing.share.as(d)
      rays := t.doing.rays.as(d)
      space := t.doing.space.as(d)
      folds := t.doing.folds.as(d)
      power := t.degree == 0 ? "1.0" : (t.degree == 1 ? "rho" : "rho * rho")
      fires := d.fix("fires{k}", "f32", "clampf({share}, 0.0, 1.0) * {power}")
      /* a term that sets a way is read AT the way: its share with rho the way's own activity - one factor, the way's room (Field.create) */
      made := t.doing.sets ? "clampf(point{k}_gate({ca}clampf(st[wA({ca}a, c)], 0.0, 1.0), nf), 0.0, 1.0) * {power}" : "fires{k}"
      spread := d.loop("a", "P.A", "st[dA({ca}a, c)] = st[dA({ca}a, c)] + {made} * ({rays}) / DEG;").indent(ind)
      df := d.fix("df{k}", "f32", "fires{k} * ({folds}) / DEG")
      bend := d.loop("a", "P.A", "st[fA({ca}a, c)] = maxf(0.0, st[fA({ca}a, c)] + df{k});").indent(ind)
      "{fires}\nif (fires{k} > 0.0) {{\n{spread}\n  dSpace = dSpace + fires{k} * ({space});\n  {df}\n{bend}\n}}"
    }).join("\n")
    blocks := Kernels.slot(Kernels.SLOT_BLOCKS, "c")
    space := Kernels.slot(Kernels.SLOT_SPACE, "c")
    [
      d.fix("c", "u32", "i"),
      Kernels.guard("P.cells"),
      d.fix("rho", "f32", Kernels.slot(Kernels.SLOT_RHO, "c")),
      d.fix("nf", "f32", Kernels.slot(Kernels.SLOT_FOLDS, "c")),
      Kernels.symbols(d),
      d.mut("dSpace", "f32", "0.0"),
      lines,
      "{space} = {space} + dSpace;"
    ].join("\n")
  }

  /* the folds of a cell: the sum over its ways; and what a heading keeps of itself there */
  static total (d: Language): String => {
    ca := d.ctx_args
    c_ := d.fix("c", "u32", "i")
    guard := Kernels.guard("P.cells")
    nf0 := d.mut("nf", "f32", "0.0")
    sum := d.loop("b", "P.A", "nf = nf + maxf(0.0, st[gA({ca}b, c)]);")
    folds := Kernels.slot(Kernels.SLOT_FOLDS, "c")
    keep := Kernels.slot(Kernels.SLOT_KEEP, "c")
    /* a heading stands for DEG/A edges: a point's folds are DEG times the headings' mean */
    "{c_}\n{guard}\n{nf0}\n{sum}\nnf = nf * (P.DEG / f32_of_u(P.A));\n{folds} = nf;\n{keep} = 1.0 / (1.0 + nf);"
  }

  /*
   * WHERE EACH POINT IS, after the tick's meetings and before anything moves (Field.locate): how much of a cell is
   * inside hubs is what its neighbours' standing folds on the ways back add up to (one point at most); which way
   * it is inside them follows this tick's folding where there is any - a point's hub is whichever folded it last -
   * and the standing record where there is none. The total is kept (slot 7 + tags) for the funnel
   */
  static locate (d: Language): String => {
    ca := d.ctx_args
    c_ := d.fix("c", "u32", "i")
    guard := Kernels.guard("P.cells")
    h_ := d.fix("h", "i32", "hopc({ca}c, b)")
    j_ := d.fix("j", "u32", "opp({ca}b) * P.cells + u32_of_i(h)")
    s_ := d.fix("s", "f32", "select(0.0, clampf(st[8u * P.cells * P.A + j] * (P.DEG / f32_of_u(P.A)), 0.0, 1.0), h >= 0)")
    r_ := d.fix("r", "f32", "select(0.0, maxf(0.0, (st[3u * P.cells * P.A + j] - st[8u * P.cells * P.A + j]) * (P.DEG / f32_of_u(P.A))), h >= 0)")
    tot0 := d.mut("total", "f32", "0.0")
    now0 := d.mut("now", "f32", "0.0")
    count := d.loop("b", "P.A", "{h_}\n{j_}\n{s_}\n{r_}\ntotal = total + s;\nnow = now + r;")
    /* how much of the point is inside hubs this tick is what this tick's folding made it, one point at most (Field.locate) */
    inside := d.fix("inside", "f32", "clampf(now, 0.0, 1.0)")
    put := d.loop("b", "P.A", "{h_}\n{j_}\n{s_}\n{r_}\nst[swA({ca}b, c)] = select(0.0, inside * r / now, now > 0.0);")
    kept := "cel[(7u + P.tags) * P.cells + c] = inside;"
    "{c_}\n{guard}\n{tot0}\n{now0}\n{count}\n{inside}\n{put}\n{kept}"
  }

  /* the meeting terms: the ray at a cell on a heading against the ray facing it - the opposite heading one step on, or its mirror beyond the window's edge; each end takes its own half of what one match does */
  static meet (d: Language, which: N[]): String => {
    ca := d.ctx_args
    ind := Kernels.IND
    blocks_to := Kernels.slot(Kernels.SLOT_BLOCKS, "u32_of_i(to)")
    per := which.map(k => {
      w := d.fix("w", "f32", "clampf(st[wA({ca}a, c)], 0.0, 1.0) * facing * meet{k}_gate({ca}rho, nf)")
      ds := d.fix("ds", "f32", "w * meet{k}_space({ca}rho, nf) / 2.0")
      /* which end swallows: the point whose ray a source lit keeps the space - a property of the ray, not of whose source; two of a kind fold evenly (Field.meet); a point folds once */
      mine := d.fix("mine", "f32", "0.5 + 0.5 * (bodily({ca}a * P.cells + c) - there_b)")
      inner := "{w}\nif (w > 0.0) {{\n  st[kA({ca}a, c)] = st[kA({ca}a, c)] + w * meet{k}_rays({ca}rho, nf) / 2.0;\n  {ds}\n  dSpace = dSpace + ds * (P.DEG / f32_of_u(P.A));\n  {mine}\n  st[fA({ca}a, c)] = maxf(0.0, st[fA({ca}a, c)] + w * meet{k}_folds({ca}rho, nf) * mine);\n  gone = gone + maxf(0.0, w * meet{k}_folds({ca}rho, nf) / 2.0) * (P.DEG / f32_of_u(P.A));\n  cross = cross + maxf(0.0, w * meet{k}_folds({ca}rho, nf) / 2.0) * (P.DEG / f32_of_u(P.A)) * mixed / maxf(facing, 0.000000000001);\n}}".indent(ind)
      o := d.fix("o", "u32", "opp({ca}a)")
      facing0 := d.mut("facing", "f32", "0.0")
      mixed0 := d.mut("mixed", "f32", "0.0")
      inside0 := d.mut("inside", "f32", "0.0")
      to := d.fix("to", "i32", "tap({ca}c, a, 1.0, q)")
      tw := d.fix("tw", "f32", "tapw({ca}c, a, 1.0, q)")
      j := d.fix("j", "u32", "o * P.cells + u32_of_i(to)")
      aj := d.fix("aj", "f32", "clampf(st[P.cells * P.A + j], 0.0, 1.0)")
      blocks_to := Kernels.slot(Kernels.SLOT_BLOCKS, "u32_of_i(to)")
      there0 := d.mut("there_b", "f32", "0.0")
      /* a source is transparent: its cells are met on like any other */
      taps := d.loop("q", "4u", "{to}\n{tw}\nif (to >= 0) {{\n  inside = inside + tw;\n  {j}\n  {aj}\n  facing = facing + tw * aj;\n  mixed = mixed + tw * aj * crossing({ca}a * P.cells + c, j);\n  there_b = there_b + tw * bodily({ca}j);\n}}")
      jm := d.fix("jm", "u32", "o * P.cells + c")
      am := d.fix("am", "f32", "clampf(st[P.cells * P.A + jm], 0.0, 1.0)")
      mirror := "if (inside < 1.0) {{\n  {jm}\n  {am}\n  facing = facing + (1.0 - inside) * am;\n  mixed = mixed + (1.0 - inside) * am * crossing({ca}a * P.cells + c, jm);\n  there_b = there_b + (1.0 - inside) * bodily({ca}jm);\n}}"
      d.loop("a", "P.A", "{o}\n{facing0}\n{mixed0}\n{inside0}\n{there0}\n{taps}\n{mirror}\n{inner}")
    }).join("\n")
    blocks := Kernels.slot(Kernels.SLOT_BLOCKS, "c")
    space := Kernels.slot(Kernels.SLOT_SPACE, "c")
    gone_s := Kernels.slot(Kernels.SLOT_GONE, "c")
    cross_s := Kernels.slot(Kernels.SLOT_CROSS, "c")
    [
      d.fix("c", "u32", "i"),
      Kernels.guard("P.cells"),
      d.fix("rho", "f32", Kernels.slot(Kernels.SLOT_RHO, "c")),
      d.fix("nf", "f32", Kernels.slot(Kernels.SLOT_FOLDS, "c")),
      d.mut("dSpace", "f32", "0.0"),
      d.mut("gone", "f32", "0.0"),
      d.mut("cross", "f32", "0.0"),
      per,
      "{space} = {space} + dSpace;",
      "{gone_s} = {gone_s} + gone;",
      "{cross_s} = {cross_s} + cross;"
    ].join("\n")
  }

  /* what this tick destroys starts at nought, once per tick before any rule */
  static clear (d: Language): String => {
    gone := Kernels.slot(Kernels.SLOT_GONE, "i")
    cross := Kernels.slot(Kernels.SLOT_CROSS, "i")
    guard := Kernels.guard("P.cells")
    "{guard}\n{gone} = 0.0;\n{cross} = 0.0;"
  }

  /* what one rule's meetings took, taken - after the pass, so every meeting of the rule read the world as the rule found it */
  static take (d: Language): String => {
    guard := Kernels.guard("P.cells * P.A")
    "{guard}\nst[4u * P.cells * P.A + i] = st[4u * P.cells * P.A + i] + st[7u * P.cells * P.A + i];\nst[7u * P.cells * P.A + i] = 0.0;"
  }

  /* the transport rule's own draw, gathered: from one step back along the heading what was kept straight on, and from one step back across each way what was turned along it - the heading kept */
  static gathering (d: Language, pop: String, turned: String): String => {
    ca := d.ctx_args
    keep_src := Kernels.slot(Kernels.SLOT_KEEP, "u32_of_i(src)")
    src := d.fix("src", "i32", "tap({ca}c, a, -1.0, q)")
    sw := d.fix("sw", "f32", "tapw({ca}c, a, -1.0, q)")
    from_src := pop.replace("SRC", "u32_of_i(src)").replace("HEAD", "a")
    /* straight on from one step back, for the share of that way that leads to the point across and not through it */
    straight := d.loop("q", "4u", "{src}\nif (src >= 0) {{\n  {sw}\n  got = got + sw * {from_src} * {keep_src} * (1.0 - owns({ca}u32_of_i(src), a));\n}}")
    /* and from two steps back, THROUGH the point that cell swallowed on this heading: straight on, and what was turned onto this way there */
    keep_src2 := Kernels.slot(Kernels.SLOT_KEEP, "u32_of_i(src2)")
    src2 := d.fix("src2", "i32", "tap({ca}c, a, -2.0, q)")
    sw2 := d.fix("sw2", "f32", "tapw({ca}c, a, -2.0, q)")
    from_src2 := pop.replace("SRC", "u32_of_i(src2)").replace("HEAD", "a")
    if turned == "way" {
      fa := d.fix("fa", "f32", "st[gA({ca}a, u32_of_i(src2))]")
      from_b := pop.replace("SRC", "u32_of_i(src2)").replace("HEAD", "b")
      every := d.loop("b", "P.A", "got = got + sw2 * {from_b} * fa * {keep_src2} * (P.DEG / f32_of_u(P.A));")
      through := d.loop("q", "4u", "{src2}\nif (src2 >= 0) {{\n  {sw2}\n  got = got + sw2 * {from_src2} * {keep_src2} * owns({ca}u32_of_i(src2), a);\n  {fa}\n  if (fa > 0.0) {{\n{every.indent(Kernels.IND)}\n  }}\n}}")
      return "{straight}\n{through}"
    }
    through := d.loop("q", "4u", "{src2}\nif (src2 >= 0) {{\n  {sw2}\n  got = got + sw2 * {from_src2} * {keep_src2} * owns({ca}u32_of_i(src2), a);\n}}")
    sd := d.fix("sd", "i32", "tap({ca}c, w, -2.0, q)")
    dw := d.fix("dw", "f32", "tapw({ca}c, w, -2.0, q)")
    fd := d.fix("fd", "f32", "st[gA({ca}w, u32_of_i(sd))]")
    keep_sd := Kernels.slot(Kernels.SLOT_KEEP, "u32_of_i(sd)")
    from_sd := pop.replace("SRC", "u32_of_i(sd)").replace("HEAD", "a")
    across := d.loop("q", "4u", "{sd}\nif (sd >= 0) {{\n  {fd}\n  if (fd > 0.0) {{\n    {dw}\n    got = got + dw * {from_sd} * fd * {keep_sd} * (P.DEG / f32_of_u(P.A));\n  }}\n}}")
    turned_ := d.loop("w", "P.A", across)
    "{straight}\n{through}\n{turned_}"
  }
  static carry (d: Language, turned: String): String => {
    ca := d.ctx_args
    guard := Kernels.guard("P.cells * P.A")
    a_ := d.fix("a", "u32", "i / P.cells")
    c_ := d.fix("c", "u32", "i % P.cells")
    got0 := d.mut("got", "f32", "0.0")
    gather := Kernels.gathering(d, "moving({ca}HEAD, SRC)", turned)
    "{guard}\n{a_}\n{c_}\n{got0}\n{gather}\nst[sA({ca}a, c)] = got;"
  }
  static tagcarry (d: Language, turned: String): String => {
    ca := d.ctx_args
    guard := Kernels.guard("P.cells * P.A")
    a_ := d.fix("a", "u32", "i / P.cells")
    c_ := d.fix("c", "u32", "i % P.cells")
    got0 := d.mut("got", "f32", "0.0")
    gather := Kernels.gathering(d, "moving_of({ca}P.z, HEAD, SRC)", turned)
    "{guard}\n{a_}\n{c_}\n{got0}\n{gather}\nst[sA({ca}a, c)] = got;"
  }
  /* and back into its own plane - after the pass, since the pass reads the plane it is replacing */
  /* what landed on a swallowed cell landed in the hub that swallowed it, keeping its heading - not back to the one it came through (Field.funnelled): from the scratch, where a carry left what landed, to where it stands */
  static funnelling (d: Language, into: String): String => {
    ca := d.ctx_args
    guard := Kernels.guard("P.cells * P.A")
    a_ := d.fix("a", "u32", "i / P.cells")
    c_ := d.fix("c", "u32", "i % P.cells")
    stays0 := d.mut("stays", "f32", "1.0")
    got0 := d.mut("got", "f32", "0.0")
    h_ := d.fix("h", "i32", "hopc({ca}c, b)")
    q_ := d.fix("q", "i32", "hopc({ca}c, opp({ca}b))")
    /* a cell inside several hubs splits one ray among them: its shares, less the one it came through, scaled to one where they add past one (Field.funnelled) */
    own := d.fix("own", "f32", "select(0.0, st[swA({ca}opp({ca}a), c)], hopc({ca}c, opp({ca}a)) >= 0)")
    mine_t := d.fix("mine_t", "f32", "cel[(7u + P.tags) * P.cells + c] - own")
    mine_s := d.fix("mine_s", "f32", "select(1.0, 1.0 / mine_t, mine_t > 1.0)")
    q_own := d.fix("q_own", "f32", "select(0.0, st[swA({ca}opp({ca}a), u32_of_i(q))], hopc({ca}u32_of_i(q), opp({ca}a)) >= 0)")
    q_t := d.fix("q_t", "f32", "cel[(7u + P.tags) * P.cells + u32_of_i(q)] - q_own")
    q_s := d.fix("q_s", "f32", "select(1.0, 1.0 / q_t, q_t > 1.0)")
    each := d.loop("b", "P.A", "if (b != opp({ca}a)) {{\n  {h_}\n  if (h >= 0) {{ stays = stays - st[swA({ca}b, c)] * mine_s; }}\n  {q_}\n  if (q >= 0) {{\n    {q_own}\n    {q_t}\n    {q_s}\n    got = got + st[sA({ca}a, u32_of_i(q))] * st[swA({ca}b, u32_of_i(q))] * q_s;\n  }}\n}}")
    "{guard}\n{a_}\n{c_}\n{stays0}\n{got0}\n{own}\n{mine_t}\n{mine_s}\n{each}\n{into} = got + st[sA({ca}a, c)] * maxf(0.0, stays);"
  }
  static funnel (d: Language): String => Kernels.funnelling(d, "st[nA({d.ctx_args}a, c)]")
  static tagfunnel (d: Language): String => Kernels.funnelling(d, "st[bA({d.ctx_args}P.z, a, c)]")

  /* what the tick made stands where it was made, beside what arrived: rays are counted, a way holds many */
  static settle (d: Language): String => {
    guard := Kernels.guard("P.cells * P.A")
    tags := d.loop("z", "P.tags - 1u", "st[(9u + 2u * z) * P.cells * P.A + i] = st[(9u + 2u * z) * P.cells * P.A + i] + st[(10u + 2u * z) * P.cells * P.A + i];")
    "{guard}\nst[i] = st[i] + st[2u * P.cells * P.A + i];\n{tags}"
  }

  /* what stands at a cell that came from each tag: the vacuum's own is what is not any body's */
  static arrived (d: Language): String => {
    ca := d.ctx_args
    c_ := d.fix("c", "u32", "i")
    guard := Kernels.guard("P.cells")
    total0 := d.mut("total", "f32", "0.0")
    others0 := d.mut("others", "f32", "0.0")
    got0 := d.mut("got", "f32", "0.0")
    whole := d.loop("a", "P.A", "total = total + st[nA({ca}a, c)];")
    per := d.loop("a", "P.A", "got = got + st[bA({ca}z, a, c)];")
    tags := d.loop("z", "P.tags - 1u", "got = 0.0;\n{per}\nothers = others + got;\ncel[(8u + z) * P.cells + c] = got * (P.DEG / f32_of_u(P.A));")
    "{c_}\n{guard}\n{total0}\n{others0}\n{got0}\n{whole}\n{tags}\ncel[7u * P.cells + c] = maxf(0.0, total - others) * (P.DEG / f32_of_u(P.A));"
  }
}
