/*
 * THE GENERATOR. `npx ray gen` runs `Gen.run`, which, for every Language and every Backend that
 * supports it, emits the physics core and the theories in that language (`X.as(language)`), fills
 * the backend's runtime template, and writes the package. Everything written is derived from the
 * .ray definitions: change a rule and rerun.
 *
 * The classes of a package, parents before children. Recognised classes (N, String, Array,
 * boolean, Iterable) are the host's own and are not emitted; Ray/Boundary/Edge/Vertex are, with the
 * physics extensions merged in.
 */

Definition := class < name: String, definition: Program { }

Gen := class {
  static core (): Array => [Ray, Boundary, Edge, Vertex, Vector, Geometry, Random, Rule, Theory, World, Source, Visual, Theorem, Around, Cell, Beam, Port, Bodies, Hole, Field, Rates, Grid, Solve, Piece, Braced, Args, Reference, Setter, Notation, Keyed, Expr, ExprReader, Fact, Step, Store, Inference, Asked, Line, Standing, Part, TermRecord, Proved, Proof, TermInfo, Prover, Inferences, Aggregate, Medium, Surface, Measured, Recording, Played, Cached, Live, Painter, Still, Pane, Picture, Fmt, Probe, Trial, Orbit, Setup, Body, FieldRecording, FieldPainter, Panel, Ink, Side, Lane, Strip, Unrolling, Scripted, RarPoint, Btfr, HighZ, Sparc, Law, Galaxies, Sweeping, Orbiting, Forming, HeldDisc, Resolution, Budget, Batching, Output, Plan, Annulus, Simulation, Formed, Model, Axis, Shaded, Sweep, Measure, Sighted, Video, Shot, Sky, Band, Banded, Growing, Planets, EndCard]
  static theories (): Array => [G]
  static languages (): Array => [TypeScript, Python, Ruby, Java, CSharp, Go, Cpp, Rust, Lean, Swift, Julia, Rlang, Wolfram]
  static backends (): Array => [CPU, WebGPU, Vulkan, OpenGL, OpenCL, CUDA, Metal, DirectX]
  /* whether a package carries a class of this name: the core, or a theory */
  static emits (kind: String): boolean => Gen.core.some(c => c.name == kind) | Gen.theories.some(t => t.name == kind)

  /* every class of the core and every nested class of it, in one language */
  static emit_core (language: Language): String => {
    out := []
    Gen.core.for(c => {
      out.push(c.as(language))
      c.nested.for(inner => { out.push(language.nested(c.name, inner.name, inner.as(language))) })
    })
    out.join("\n\n")
  }

  /* a theory as a class, and its equation as data: every term with its share as a function of the symbols */
  static emit_theories (language: Language): String => Gen.theories.map(t => "{t.as(language)}\n\n{Gen.emit_equation(t, language)}").join("\n\n")

  static emit_equation (t: Theory, language: Language): String => {
    eq := t.equation
    terms := eq.terms.map(term => language.term_literal(
      term.rule == None ? "" : term.rule.id,
      term.rate == None ? "" : term.rate,
      term.degree, term.outside, term.settles, term.transport,
      term.doing.share.as(language), term.doing.rays.as(language), term.doing.space.as(language), term.doing.folds.as(language),
      term.doing.share.source, term.doing.rays.source, term.doing.space.source, term.doing.folds.source,
      term.rule == None ? "" : term.rule.name, term.rule == None ? "World" : term.rule.over,
      (term.rule == None | term.rule.where == None) ? "" : term.rule.where.source, term.rule == None ? "" : term.rule.source,
      term.leans == None ? "" : term.leans, term.doing.carries, term.doing.sets, term.turned,
      term.doing.asked.as(language), term.doing.asked.source, term.doing.around.as(language), term.doing.around.source, term.doing.grown, term.doing.grew.as(language), term.doing.grew.source, term.doing.trades, term.doing.grew_apart.as(language), term.doing.grew_apart.source))
    language.equation_literal(t.name, eq.latex, terms)
  }

  /* the top-level definitions of the physics project - the named lattices - read off it by the bootstrap */
  static constants (): Definition[]
  static emit_constants (language: Language): String => Gen.constants.map(d => language.constant(d.name, d.definition.as(language))).join("\n")

  /* the kernels of a GPU backend, as a file of their own: languages/kernels/<theory>.<backend>.<ext> */
  static write_kernels (tn: String, bn: String, text: String) => {
    @./languages/kernels/{tn}.{bn} := text
  }

  /*
   * THE REPOSITORY'S INSTALLATION, written between `<!-- gen:installation -->` and `<!-- /gen:installation -->` in the
   * README: Python's package - the one the README's own explanations are in - and a link to every language's own README,
   * which says how that one is installed. Everything else in the README is written by hand
   */
  static installation (): String => {
    /* a language not yet written has nothing to install */
    ready := Gen.languages.filter(l => l.install != "")
    ordered := ready.filter(l => l.name == "Python").concat(ready.filter(l => l.name != "Python"))
    links := ordered.map(l => "[{l.name}](./languages/{l.package_dir}/README.md)").join(", ")
    /* only Python's install here: every other language's is in its own README, linked above */
    blocks := ordered.filter(l => l.name == "Python").map(l => l.install).join("\n\n")
    "While all the explanations here are for Python, packages exist for every language in the [languages/](./languages/) folder, each with its own README ({links}).\n\n{blocks}"
  }
  static write_installation () => {
    start := "<!-- gen:installation -->"
    stop := "<!-- /gen:installation -->"
    text := @./README.md
    return if !(text.contains(start) & text.contains(stop))
    before := text.split(start).first
    after := text.split(stop).last
    @./README.md = "{before}{start}\n{Gen.installation}\n{stop}{after}"
  }

  /* `npx ray gen Ruby Python`: those languages' packages alone; `npx ray gen` (all): every package, the theorems, the kernels and the README */
  /*
   * THE RELEASE WORKFLOW: a job that says the version and whether to publish, every language's own job
   * (`release_job`), and the GitHub release when they have all built
   */
  static release_workflow (): String => {
    jobs := Gen.languages.map(l => l.release_job).filter(j => j != "")
    ids := jobs.map(j => j.trim.split(":").first)
    needs := ids.join(", ")
    body := jobs.join("")
    head := "# GENERATED by `npx ray gen` from implementation/gen/Release.ray and each language's `release_job` - do not edit\n# A push to main that changes languages/VERSION builds every package, keeps what it built as artifacts, publishes to\n# every registry whose credentials are set, and makes the GitHub release. Run it by hand to build only (or to publish).\nname: release\non:\n  push:\n    branches: [main]\n    paths: [languages/VERSION]\n  workflow_dispatch:\n    inputs:\n      publish:\n        description: publish to the registries, not only build and keep the artifacts\n        type: boolean\n        default: false\npermissions:\n  contents: write\n  id-token: write\nconcurrency:\n  group: release\n  cancel-in-progress: false\njobs:\n  version:\n    runs-on: ubuntu-latest\n    outputs:\n      version: ${{{{ steps.v.outputs.version }}}}\n      publish: ${{{{ steps.v.outputs.publish }}}}\n      testing: ${{{{ steps.v.outputs.testing }}}}\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          fetch-depth: 2\n      - id: v\n        run: |\n          v=\"$(cat languages/VERSION)\"\n          echo \"version=$v\" >> \"$GITHUB_OUTPUT\"\n          if [ \"${{{{ github.event_name }}}}\" = \"workflow_dispatch\" ]; then publish=\"${{{{ inputs.publish }}}}\"\n          elif git diff --quiet HEAD^ HEAD -- languages/VERSION; then publish=false\n          else publish=true; fi\n          echo \"publish=$publish\" >> \"$GITHUB_OUTPUT\"\n          case \"$v\" in *-*) echo \"testing=true\" ;; *) echo \"testing=false\" ;; esac >> \"$GITHUB_OUTPUT\"\n          echo \"version $v, publishing: $publish\"\n"
    tail := "  release:\n    needs: [version, {needs}]\n    if: needs.version.outputs.publish == 'true'\n    runs-on: ubuntu-latest\n    permissions:\n      contents: write\n    steps:\n      - uses: actions/checkout@v7\n      - uses: actions/download-artifact@v8\n        with:\n          path: artifacts\n      - name: the GitHub release, every package attached (and the tag Swift and Lean read)\n        run: |\n          v=\"v${{{{ needs.version.outputs.version }}}}\"\n          if gh release view \"$v\" >/dev/null 2>&1; then gh release upload \"$v\" artifacts/*/* --clobber\n          else gh release create \"$v\" artifacts/*/* --target \"${{{{ github.sha }}}}\" --title \"$v\" --generate-notes ${{{{ needs.version.outputs.testing == 'true' && '--prerelease' || '' }}}}; fi\n        env:\n          GH_TOKEN: ${{{{ github.token }}}}\n"
    "{head}{body}{tail}"
  }

  static run (targets: String[]) => {
    everything := targets.some(t => t == "all")
    wanted := everything ? Gen.languages : Gen.languages.filter(l => targets.some(t => t == l.name))
    wanted.for(language => {
      Gen.backends.for(backend => {
        if backend.supports(language) {
          runtime := backend.runtime_for(language)
          if backend.kernel == None {
            /* the CPU: the emitted classes are the implementation */
            code := runtime.replace("{{core}}", Gen.emit_core(language)).replace("{{theories}}", Gen.emit_theories(language)).replace("{{constants}}", Gen.emit_constants(language))
            language.write_package(code)
            /* a language with a theorem prover: every theorem and its derivation, for the prover to check (before the records, so one closure serves both) */
            Gen.theories.for(t => { language.write_proofs(t) })
            language.write_theorems(Gen.theories.map(t => t.proved.json).join(", "))
            language.write_notation
            Tests.write(language, backend)
            entries := []
            Gen.theories.for(t => { t.visuals.for(v => { entries.push(v.as(language)) }) })
            language.write_visuals(entries.join("\n"))
          } else {
            /* a GPU: the kernels come off the equation, the runtime around them off the template */
            Gen.theories.for(t => {
              code := runtime.replace("{{kernels}}", backend.kernels(t))
              language.write_backend(backend.name.lower, code)
              language.write_backend_tests(backend.name.lower, t)
            })
          }
        }
      })
    })
    return if !everything
    /* the one version (Release.ray), and the workflow that publishes it when it changes */
    @./languages/VERSION := "{Release.semver}\n"
    @./.github/workflows/release.yml := Gen.release_workflow
    /* the repository's README: how every language's package is installed, Python's first (between the markers) */
    Gen.write_installation
    /* what the rules come to: theorems/, off one closure per theory */
    Gen.theories.for(t => { Theorems.write(t) })
    /* every GPU backend's kernels, runtime or not */
    Gen.backends.for(backend => {
      if backend.kernel != None {
        Gen.theories.for(t => {
          file := "{backend.name.lower}{backend.kernel.extension}"
          Gen.write_kernels(t.name, file, backend.kernels(t))
        })
      }
    })
  }
}
