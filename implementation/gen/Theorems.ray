/*
 * WHAT THE PROOF LEAVES BEHIND - a record under `theorems/`, one folder per question, and the same
 * records as one value in every package (`@orbitmines/physics/theorems`, `orbitmines.physics.theorems`)
 * so that a page cites a theorem by name instead of copying its line out.
 *
 * Nothing here was written by hand: the closure is Prove.ray's, off the equation Reading.ray counted
 * off the rules. Three files per theorem - `proof.json` (the record), `README.md` (the answer, then
 * the working), `index.html` (standalone, the equations set by KaTeX) - and an index of them all.
 */

Line += {
  json (): String => {
    working := this.working.map(w => w.quoted).join(", ")
    rule := this.rule == None ? "null" : this.rule.quoted
    "{{\"kind\": {this.kind.quoted}, \"via\": {this.via.quoted}, \"rule\": {rule}, \"line\": {this.line.quoted}, \"working\": [{working}], \"because\": {this.because.quoted}}}"
  }
  markdown (): String => {
    nl := "\n"
    work := this.working.empty ? "" : "\n```\n{this.working.join(nl)}\n```\n"
    "**{this.line}**  \n<sub>{this.kind} · {this.via}</sub>  \n{work}\n{this.because}\n"
  }
  html (): String => {
    nl := "\n"
    work := this.working.empty ? "" : "<pre class=\"work\">{this.working.map(w => Theorems.escaped(w)).join(nl)}</pre>"
    "<details class=\"step\"><summary><span class=\"eq\">\\({Theorems.escaped(this.line)}\\)</span> <span class=\"via\">{this.kind} · {Theorems.escaped(this.via)}</span></summary>{work}<p>{Theorems.escaped(this.because)}</p></details>"
  }
}

Proved += {
  json (): String => {
    lines := this.lines.map(l => l.json).join(", ")
    missing := this.missing.map(m => m.quoted).join(", ")
    concluded := this.concluded == None ? "null" : this.concluded.quoted
    "{{\"theorem\": {this.theorem.quoted}, \"theory\": {this.theory.quoted}, \"asks\": {this.asks.quoted}, \"about\": {this.about.quoted}, \"concluded\": {concluded}, \"standing\": {this.standing}, \"missing\": [{missing}], \"steps\": [{lines}]}}"
  }
  answer (): String => {
    sep := ", "
    this.concluded == None ? "no conclusion: {this.missing.join(sep)}" : this.concluded
  }
  markdown (): String => {
    steps := this.lines.map(l => l.markdown).join("\n")
    "# {this.theorem}\n\n> {this.asks}\n\nProved under `{this.theory}`. Generated by `npx ray gen` from `implementation/physics.ray` - nothing here was written by hand: every premise is read off the rules themselves, and the conclusion is what the inference rules of `Prove.ray` make of them.\n\n| theory | answer |\n|---|---|\n| `{this.theory}` | {this.answer} |\n\n## {this.theory}\n\n### the result\n\n**{this.answer}**\n\n#### the derivation\n\n{steps}\n"
  }
  html (): String => {
    steps := this.lines.map(l => l.html).join("\n")
    answer := Theorems.escaped(this.answer)
    asks := Theorems.escaped(this.asks)
    "<main><h1>{this.theorem}</h1><p class=\"q\">{asks}</p><h2>{this.theory}</h2><div class=\"eq answer\">\\[{answer}\\]</div><h2>the derivation</h2>{steps}</main>"
  }
}

Proof += {
  json (): String => {
    items := this.proved.map(p => p.json).join(", ")
    "{{\"theory\": {this.theory.quoted}, \"theorems\": [{items}]}}"
  }
}

Theorems := class {
  static escaped (s: String): String => s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")

  /* the page around a record: the notation set by KaTeX, `\paren` as brackets that grow */
  static page (title: String, body: String): String => {
    "<!doctype html>\n<meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>{title}</title>\n<link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/KaTeX/0.16.11/katex.min.css\">\n<script defer src=\"https://cdnjs.cloudflare.com/ajax/libs/KaTeX/0.16.11/katex.min.js\"></script>\n<script defer src=\"https://cdnjs.cloudflare.com/ajax/libs/KaTeX/0.16.11/contrib/auto-render.min.js\" onload=\"renderMathInElement(document.body, {{ macros: {{ '\\\\paren': '\\\\left(#1\\\\right)' }}, delimiters: [{{ left: '\\\\[', right: '\\\\]', display: true }}, {{ left: '\\\\(', right: '\\\\)', display: false }}] }})\"></script>\n<style>\n:root{{--bg:#08090d;--ink:#c6c9d4;--dim:#8a8d99;--faint:#6c7080;--rule:#1c1e27}}\nbody{{margin:0;background:var(--bg);color:#e8ecf4;font:13px/1.6 ui-monospace,SFMono-Regular,Menlo,monospace;padding:32px}}\nmain{{max-width:82ch;margin:0 auto}}\nh1{{font-size:17px;letter-spacing:.05em;margin:0 0 .2em}}\nh2{{font-size:12px;letter-spacing:.09em;text-transform:uppercase;color:var(--faint);border-top:1px solid var(--rule);padding-top:1.6em;margin:2.4em 0 .8em;font-weight:400}}\na{{color:inherit}}\n.q{{color:var(--dim);font-style:italic;margin:.4em 0 1.4em}}\n.answer{{font-size:1.18em;text-align:center;padding:.2em 0;overflow-x:auto}}\n.step{{border-top:1px solid var(--rule);padding:.6em 0}}\n.step summary{{cursor:pointer;list-style:none}}\n.via{{color:var(--faint);margin-left:1em}}\n.work{{color:var(--dim);white-space:pre-wrap;padding:.4em 0}}\ntable{{border-collapse:collapse}} td,th{{border-bottom:1px solid var(--rule);padding:.3em .8em;text-align:left}}\n</style>\n{body}\n"
  }

  /* one theory's theorems: a folder each, and the index */
  static write (theory: Theory) => {
    proof := theory.proved
    proof.proved.for(p => {
      id := p.theorem
      @./theorems/{id}/proof.json := p.json
      @./theorems/{id}/README.md := p.markdown
      @./theorems/{id}/index.html := Theorems.page(id, p.html)
    })
    rows := proof.proved.map(p => "| [`{p.theorem}`]({p.theorem}/) | {p.answer} |").join("\n")
    @./theorems/README.md := "# theorems\n\nWhat the rules of `{theory.name}` come to, derived from the rules themselves.\n\n```\nnpx ray gen\n```\n\nNothing here is written by hand, and nothing here was measured. `Reading.ray` counts the continuous equation off what each rule's body does; `Prove.ray` reads its premises off that line and closes them under its inference rules; this folder is what came out, one question per folder, with `proof.json` (the record), `README.md` (the answer, then the working) and `index.html` (the same, set).\n\nThere is no lattice on these pages: no box, no seed, no number of ticks. What is derived is what the rules say, which they say on every lattice at once - `D` and `DEG` stay symbols for exactly that reason.\n\n| theorem | answer |\n|---|---|\n{rows}\n"
    links := proof.proved.map(p => "<tr><td><a href=\"{p.theorem}/\">{p.theorem}</a></td><td>\\({Theorems.escaped(p.answer)}\\)</td></tr>").join("\n")
    @./theorems/index.html := Theorems.page("theorems", "<main><h1>theorems</h1><p class=\"q\">what the rules of {theory.name} come to, derived from the rules themselves</p><table>{links}</table></main>")
  }
}
