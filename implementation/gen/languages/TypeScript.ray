/*
 * TYPESCRIPT, as a mapping from the constructs of Ray to text.
 *
 * Every rule is `{ <Ray with holes> } => "<text>"`. Hole names are chosen so that no class declares
 * a member of that name (`cond`, `lhs`, `rhs`, `nm`, `ty`, `stmts`, ...); a known name in a pattern
 * is literal (`push`, `map`, `N`, `this`). `{x.indent}` / `{x.returned}` / `{x.method}` /
 * `{x.quoted}` are the emitter's helpers on a bound part.
 *
 * TypeScript has `if`, `while` and no `goto`, so programs written with gotos reach it through the
 * lowering of Rewrite.ray: one loop over a `state`, which these rules then map. Parameterless
 * methods become getters, so `x.neutral` reads the same in both languages. Arithmetic goes through
 * the runtime's `add`/`sub`/... helpers because TypeScript cannot overload operators and a Vector
 * has a `+` of its own.
 */

TypeScript: Language = class {
  name = "TypeScript"
  extension = ".ts"

  {indent} => "  "
  {separator} => ", "
  {newline} => "\n"
  {statement_end} => ";"
  {interpolation} => "${{{x}}}"
  {named_arg} => "{nm}: {val}"
  {parameter} => "{nm}: {ty}"
  {parameter_untyped} => "{nm}: any"
  {parameter_default} => "{nm}: {ty} = {val}"
  {dynamic_get} => "{tgt}[{key}]"
  {dynamic_set} => "{tgt}[{key}] = {val}"

  /* control flow */
  {if cond { yesbody } else { nobody }} => "if ({cond}) {{\n{yesbody.indent}\n}} else {{\n{nobody.indent}\n}}"
  {if cond { yesbody }} => "if ({cond}) {{\n{yesbody.indent}\n}}"
  {unless cond { yesbody }} => "if (!({cond})) {{\n{yesbody.indent}\n}}"
  {while cond { loopbody }} => "while ({cond}) {{\n{loopbody.indent}\n}}"
  {return val} => "return {val};"
  {return} => "return;"
  {dynamically assert cond} => "if (!({cond})) throw new Error({cond.quoted});"

  /* definitions and assignment */
  {nm := val} => "let {nm} = {val};"
  {lhs = rhs} => "{lhs} = {rhs};"
  {tgt[k] = rhs} => "{tgt}[{k}] = {rhs};"

  /* expressions */
  {a & b} => "({a} && {b})"
  {a | b} => "({a} || {b})"
  {!a} => "!({a})"
  {-a} => "(-{a})"
  {a == b} => "eq({a}, {b})"
  {a != b} => "!eq({a}, {b})"
  {a < b} => "lt({a}, {b})"
  {a <= b} => "le({a}, {b})"
  {a > b} => "gt({a}, {b})"
  {a >= b} => "ge({a}, {b})"
  {a + b} => "add({a}, {b})"
  {a - b} => "sub({a}, {b})"
  {a * b} => "mul({a}, {b})"
  {a / b} => "div({a}, {b})"
  {a % b} => "mod({a}, {b})"
  {a ^ b} => "Math.pow({a}, {b})"
  {a ?? b} => "({a} ?? {b})"
  {cond ? a : b} => "({cond} ? {a} : {b})"
  {a ==.instance_of Array} => "Array.isArray({a})"
  {a ==.instance_of ty} => "instance_of({a}, {ty})"
  {a as ty} => "{a}"
  {tgt.nm} => "{tgt}.{nm.method}"
  {tgt?.nm} => "{tgt}?.{nm.method}"
  {tgt.nm()} => "{tgt}.{nm.method}"
  {tgt.nm(arglist)} => "{tgt}.{nm.method}({arglist})"
  {tgt.choose("nm")} => "{tgt}[\"choose {nm}\"].bind({tgt})"
  {tgt?.nm(arglist)} => "{tgt}?.{nm.method}({arglist})"
  {tgt[k]} => "elem({tgt}, {k})"
  {fn(arglist)} => "{fn}({arglist})"
  {Class(arglist)} => "new {Class}({{ {arglist} }})"
  {[elems]} => "[{elems}]"
  { {} } => "({{}})"
  {this} => "this"
  {None} => "null"
  {true} => "true"
  {false} => "false"
  {"txt"} => "`{txt}`"
  {(paramlist) => { stmts }} => "(({paramlist}) => {{\n{stmts.returned.indent}\n}})"
  {(paramlist) => e} => "(({paramlist}) => {e})"
  {xs#} => "many({xs})"
  {draw([ws], [os])} => "this.vertex.world.draw([{ws}], [{os}])"

  /* the recognised classes: what their members are here */
  /* a counted loop is a counted loop: no array of its indices is made first */
  {Array.range(cnt).for((x_) => { stmts })} => "for (let {x_.bare} = 0; {x_.bare} < {cnt}; {x_.bare}++) {{\n{stmts.indent}\n}}"
  {xs.for((x_) => { stmts })} => "for (const {x_.bare} of [...{xs}]) {{\n{stmts.indent}\n}}"
  {fail(x_)} => "fail({x_})"
  {Catalogue.number(x_)} => "Number({x_})"
  {xs.push(x_)} => "push({xs}, {x_})"
  {xs.chars} => "Array.from({xs}, (ch: string) => ch.codePointAt(0) as number)"
  {String(chars: xs)} => "String.fromCodePoint(...{xs})"
  {x_.blank} => "[32, 9, 10, 13].includes({x_})"
  {Char} => "number"
  {xs.pop} => "{xs}.pop()"
  {xs.length} => "{xs}.length"
  {xs.map(f)} => "{xs}.map({f})"
  {xs.filter(f)} => "{xs}.filter({f})"
  {xs.for(f)} => "each({xs}, {f})"
  {xs.some(f)} => "{xs}.some({f})"
  {xs.every(f)} => "{xs}.every({f})"
  {xs.reduce(z, f)} => "{xs}.reduce({f}, {z})"
  {xs.starts_with(x_)} => "{xs}.startsWith({x_})"
  {xs.ends_with(x_)} => "{xs}.endsWith({x_})"
  {xs.replace(x_, y_)} => "{xs}.split({x_}).join({y_})"
  {xs.split(x_)} => "{xs}.split({x_})"
  {xs.trim} => "{xs}.trim()"
  {xs.upper} => "{xs}.toUpperCase()"
  {xs.lower} => "{xs}.toLowerCase()"
  {xs.lines} => "{xs}.split(\"\\n\")"
  {xs.quoted} => "JSON.stringify({xs})"
  {xs.contains(x_)} => "contains({xs}, {x_})"
  {xs.index_of(x_)} => "index_of({xs}, {x_})"
  {xs.join(sep)} => "{xs}.join({sep})"
  {xs.first} => "first({xs})"
  {xs.last} => "last({xs})"
  {xs.empty} => "({xs}.length === 0)"
  {xs.take(cnt)} => "{xs}.slice(0, {cnt})"
  {xs.drop(cnt)} => "{xs}.slice({cnt})"
  {xs.rest} => "{xs}.slice(1)"
  {xs.concat(ys)} => "{xs}.concat({ys})"
  {xs.reverse} => "[...{xs}].reverse()"
  {xs.sum} => "sum({xs})"
  {xs.most(f)} => "most({xs}, {f})"
  {xs.sorted_by(f)} => "sorted_by({xs}, {f})"
  {xs.each} => "each_of({xs})"
  {Array.range(cnt)} => "range({cnt})"
  {Array.filled(cnt, x_)} => "filled({cnt}, {x_})"
  {x_.sqrt} => "Math.sqrt({x_})"
  {x_.floor} => "Math.floor({x_})"
  {x_.abs} => "Math.abs({x_})"
  {x_.negated} => "neg({x_})"
  {x_.magnitude} => "Math.abs({x_})"
  {x_.cos} => "Math.cos({x_})"
  {x_.sin} => "Math.sin({x_})"
  {x_.round} => "Math.round({x_})"
  {x_.ln} => "Math.log({x_})"
  {x_.exp} => "Math.exp({x_})"
  {x_.atan2(y_)} => "Math.atan2({x_}, {y_})"
  {x_.pow(y_)} => "Math.pow({x_}, {y_})"
  {Real.of(x_)} => "{x_}"
  {Real.ZERO} => "0"
  {Real.ONE} => "1"
  {Real.TWO} => "2"
  {Real.PI} => "Math.PI"
  {Real.NAN} => "NaN"
  {Real.INFINITY} => "Infinity"
  {Real.TAU} => "(2 * Math.PI)"
  {Random.MODULUS} => "4294967296"
  {Random.MULTIPLIER} => "1664525"
  {Random.INCREMENT} => "1013904223"

  /* types */
  {N} => "number"
  {Natural} => "number"
  {Z} => "number"
  {Integer} => "number"
  {Real} => "number"
  {Decimal} => "number"
  {boolean} => "boolean"
  {String} => "string"
  {Array} => "any[]"
  {*} => "any"
  {{}} => "any"
  {ty[]} => "{ty}[]"
  {ty?} => "({ty} | null)"

  /* classes: fields with a default are lazy - a default may build the object that builds this one */
  {nm := class < sup { membs }} => "export class {nm} extends {sup.first} {{\n{membs.indent}\n}}"
  {nm := class { membs }} => "export class {nm} extends Node {{\n{membs.indent}\n}}"
  {nm: ty = class { membs }} => "export const {nm} = new (class {nm} extends {ty} {{\n{membs.indent}\n  constructor() {{ super(); this.rules = collect_rules(this); this.theorems = collect_theorems(this); }}\n}})()"
  {theorem "nm" () => tbody} => "static \"theorem {nm}\" = new Theorem({{ id: {nm.quoted}, body: () => {{\n{tbody.returned.indent}\n}} }});"
  {x_.body()} => "{x_}.body()"
  {nm: ty = val} => "get {nm}(): {ty} {{ return this.read(\"{nm}\", () => {val}); }}\nset {nm}(v: {ty}) {{ this.write(\"{nm}\", v); }}"
  {nm: ty} => "get {nm}(): {ty} {{ return this.read(\"{nm}\"); }}\nset {nm}(v: {ty}) {{ this.write(\"{nm}\", v); }}"
  {nm = val} => "{nm} = {val};"
  {static nm: ty = val} => "static {nm}: {ty} = {val};"
  {static nm = val} => "static {nm} = {val};"
  {nm (): ret => mbody} => "get {nm.method}(): {ret} {{\n{mbody.returned.indent}\n}}"
  {nm () => mbody} => "get {nm.method}() {{\n{mbody.returned.indent}\n}}"
  {static nm (): ret => mbody} => "static get {nm.method}(): {ret} {{\n{mbody.returned.indent}\n}}"
  {nm (paramlist): ret => mbody} => "{nm.method}({paramlist}): {ret} {{\n{mbody.returned.indent}\n}}"
  {nm (paramlist) => mbody} => "{nm.method}({paramlist}) {{\n{mbody.returned.indent}\n}}"
  {nm (paramlist): ret} => "{nm.method}({paramlist}): {ret} {{ throw new Error(\"{nm} is declared but not defined by anyone\"); }}"
  {nm (paramlist)} => "{nm.method}({paramlist}) {{ throw new Error(\"{nm} is declared but not defined by anyone\"); }}"
  {nm (): ret} => "get {nm.method}(): {ret} {{ throw new Error(\"{nm} is declared but not defined by anyone\"); }}"
  {nm ()} => "get {nm.method}() {{ throw new Error(\"{nm} is declared but not defined by anyone\"); }}"
  {static nm (paramlist): ret} => "static {nm.method}({paramlist}): {ret} {{ throw new Error(\"{nm} is declared but not defined by anyone\"); }}"
  {static nm (paramlist)} => "static {nm.method}({paramlist}) {{ throw new Error(\"{nm} is declared but not defined by anyone\"); }}"
  {static nm (paramlist): ret => mbody} => "static {nm.method}({paramlist}): {ret} {{\n{mbody.returned.indent}\n}}"
  {static nm (paramlist) => mbody} => "static {nm.method}({paramlist}) {{\n{mbody.returned.indent}\n}}"
  {static nm () => mbody} => "static get {nm.method}() {{\n{mbody.returned.indent}\n}}"
  {rule /rid "nm" | rt (paramlist) => rbody} => "static \"rule {rid}\" = new Rule({{ id: \"/{rid}\", name: {nm.quoted}, rate: {rt.quoted}, over: {over.quoted}, single: {single}, where: {where}, source: {source.quoted}, body: (({paramlist}) => {{\n{rbody.returned.indent}\n}}) }});"
  {rule /rid "nm" (paramlist) => rbody} => "static \"rule {rid}\" = new Rule({{ id: \"/{rid}\", name: {nm.quoted}, rate: null, over: {over.quoted}, single: {single}, where: {where}, source: {source.quoted}, body: (({paramlist}) => {{\n{rbody.returned.indent}\n}}) }});"
  {choose "nm" (paramlist): ret} => "\"choose {nm}\"({paramlist}): {ret} {{ throw new Error(\"the choice {nm} is not defined by anyone\"); }}"
  {choose "nm" (paramlist): ret => cbody} => "\"choose {nm}\"({paramlist}): {ret} {{\n{cbody.returned.indent}\n}}"
  {choose "nm" (paramlist) => cbody} => "\"choose {nm}\"({paramlist}) {{\n{cbody.returned.indent}\n}}"
  {as (=== ty) => cbody} => "as_{ty}() {{\n{cbody.returned.indent}\n}}"
  {Program} => "Program"

  /* a nested class lives in a namespace of the outer one's name, which TypeScript merges with the class */
  nested (outer: String, inner_name: String, inner: String): String => {
    indented := inner.indent("  ")
    "export namespace {outer} {{\n{indented}\n}}"
  }

  constant (nm: String, text: String): String => "export const {nm} = {text};"

  /* the equation of a theory, as data on it: what the continuous backends integrate */
  term_literal (id: String, rate: String, degree: N, outside: boolean, settles: boolean, transport: boolean, share: String, rays: String, space: String, folds: String, share_source: String, rays_source: String, space_source: String, folds_source: String, rule_name: String, over: String, where_source: String, rule_source: String, leans: String, carries: boolean): String => {
    rate_ := rate.empty ? "null" : rate.quoted
    where := where_source.empty ? "null" : "{{ source: {where_source.quoted} }}"
    rule := id.empty ? "null" : "{{ id: {id.quoted}, rate: {rate_}, name: {rule_name.quoted}, over: {over.quoted}, where: {where}, source: {rule_source.quoted} }}"
    leans_ := leans.empty ? "null" : leans.quoted
    "  {{ rule: {rule}, rate: {rate_}, degree: {degree}, outside: {outside}, settles: {settles}, transport: {transport}, leans: {leans_}, doing: {{ carries: {carries}, draws: null, needs: {degree}, outside: {outside}, settles: {settles}, share: {{ source: {share_source.quoted}, at: (s: any) => {share} }}, rays: {{ source: {rays_source.quoted}, at: (s: any) => {rays} }}, space: {{ source: {space_source.quoted}, at: (s: any) => {space} }}, folds: {{ source: {folds_source.quoted}, at: (s: any) => {folds} }} }} }}"
  }
  equation_literal (theory: String, latex: String, terms: String[]): String => {
    lines := terms.join(",\n")
    "Object.defineProperty({theory}, \"equation\", {{ value: {{ latex: {latex.quoted}, terms: [\n{lines}\n] }} }});"
  }

  write_package (code: String) => {
    @./languages/physics.ts/src/physics.ts := code
    @./languages/physics.ts/index.ts := "export * from \"./src/physics.ts\";\nexport * as webgpu from \"./src/webgpu.ts\";\n"
    @./languages/physics.ts/package.json := TypeScript.package_json
    @./languages/physics.ts/tsconfig.json := "{{\n  \"compilerOptions\": {{ \"target\": \"ES2022\", \"module\": \"NodeNext\", \"moduleResolution\": \"NodeNext\", \"allowImportingTsExtensions\": true, \"noEmit\": true, \"strict\": false, \"skipLibCheck\": true, \"lib\": [\"ES2022\", \"DOM\"] }},\n  \"include\": [\"index.ts\", \"theorems.ts\", \"notation.ts\", \"src\"]\n}}\n"
  }

  /* one test: the fixture built afresh, ticked until the refinement holds, the requirement checked */
  test_case (r: Requirement, f: Fixture): String => {
    definition := f.definition.as(TypeScript)
    requirement := r.requirement.as(TypeScript)
    filter := r.filter == None ? "true" : r.filter.as(TypeScript)
    label := "{r.location} on {f.name}"
    "test({label.quoted}, (t) => {{\n  const it = {definition};\n  let guard = 0;\n  while (!({filter})) {{ if (++guard > 8 || !(\"tick\" in it)) return t.skip(\"the refinement never held\"); it.tick; }}\n  assert.ok({requirement}, {requirement.quoted});\n}});"
  }

  write_tests (cases: String, fixtures: Fixture[]) => {
    @./tests/ts/G.test.ts := "// GENERATED by `npx ray gen` from implementation/physics.ray - do not edit\nimport {{ test }} from \"node:test\";\nimport assert from \"node:assert/strict\";\nimport * as physics from \"../../languages/physics.ts/index.ts\";\nconst {{ {TypeScript.exports} }} = physics;\n\n{cases}\n"
    @./tests/ts/package.json := "{{ \"private\": true, \"type\": \"module\", \"scripts\": {{ \"test\": \"node --import tsx --test G.test.ts\" }}, \"devDependencies\": {{ \"tsx\": \"^4.21.0\", \"typescript\": \"^6.0.3\", \"@types/node\": \"^25.6.0\" }} }}\n"
  }

  /* what a test file takes from the package: every class and theory and lattice */
  exports (): String => "G, World, Vertex, Ray, Boundary, Edge, Source, Geometry, Vector, Random, Rule, Theory, Field, Hole, Rates, Grid, Solve, Piece, Reference, Setter, Notation, Surface, Measured, Recording, Played, Painter, Still, Picture, Fmt, Setup, Body, Panel, Sparc, Law, Galaxies, Model, Measure, LINE2, SQUARE4, SQUARE8, CUBIC6, FCC12, CUBIC18, CUBIC26, eq, lt, le, gt, ge, add, sub, mul, div, mod, neg, elem, first, last, sum, most, range, filled, many, contains, index_of, instance_of, sorted_by"

  /* every visual, as a function of no arguments returning its Picture, around the runtime that gives `Measured` its host; `npx ray visuals` records and renders them */
  {visual "nm" () => vbody} => "  {nm.quoted}: () => {{\n{vbody.returned.indent}\n  }},"
  write_visuals (entries: String) => {
    template := @./implementation/gen/languages/visuals.runtime.ts
    @./visuals/visuals.ts := template.replace("{{{{exports}}}}", TypeScript.exports).replace("{{{{entries}}}}", entries)
  }

  /* the notation as components: the runtime template around the generated parser and setter */
  write_notation () => {
    @./languages/physics.ts/notation.ts = @./implementation/gen/languages/notation.runtime.ts
  }

  /* every theorem, as one value: `import {{ PROVED }} from "@orbitmines/physics/theorems"` */
  write_theorems (proofs: String) => {
    @./languages/physics.ts/theorems.ts := "// GENERATED by `npx ray gen` from implementation/physics.ray - do not edit\n/*\n * @orbitmines/physics/theorems - what the rules come to, as something to look up: every theorem, keyed by\n * theory and then by question. The line on a page IS the line the prover concluded, looked up rather\n * than transcribed, and a rule edited in G.ray moves it.\n */\nexport type Step = {{ kind: \"rule\" | \"theorem\"; via: string; line: string; working: string[]; because: string }};\nexport type Standing = {{ name: string; is: string; because: string }};\nexport type Part = {{ part: string; is: string; because: string }};\nexport type Proved = {{ theorem: string; theory: string; asks: string; about: string; concluded: string | null; also: string | null; leads: string | null; then: string | null; space: string | null; standing: boolean; missing: string[]; cites: string[]; steps: Step[]; standingFor: Standing[]; parts: Part[] }};\nexport type Registry = Record<string, Record<string, Proved>>;\nexport const PROVED: Registry = {{{proofs}}};\n/** one theorem, or nothing - and never a throw */\nexport const proved = (of: Registry, theory: string, theorem: string): Proved | undefined => of[theory]?.[theorem];\n/** which theories have an answer to a question */\nexport const theories = (of: Registry, theorem: string): string[] => Object.keys(of).filter(t => of[t][theorem]);\n/** every question a theory answers */\nexport const asked = (of: Registry, theory: string): string[] => Object.keys(of[theory] ?? {{}});\n"
  }

  /* the agreement of a GPU backend with the CPU field: the same box, the same ticks, the same numbers - run under Deno, which has WebGPU */
  write_backend_tests (nm: String, theory: Theory) => {
    tn := theory.name
    @./tests/ts/{tn}.{nm}.test.ts := "// GENERATED by `npx ray gen` from implementation/physics.ray - do not edit. Runs under Deno: `npm run test:gpu`\nimport {{ gpu }} from \"../../languages/physics.ts/src/{nm}.ts\";\nimport {{ {tn}, Hole }} from \"../../languages/physics.ts/index.ts\";\n\nconst N = 12, A = 8, K = 1, TICKS = 6, TOL = 0.001;\nconst close = (name: string, xs: ArrayLike<number>, ys: ArrayLike<number>) => {{\n  if (xs.length !== ys.length) throw new Error(`${{name}}: ${{xs.length}} against ${{ys.length}}`);\n  let worst = 0;\n  for (let i = 0; i < xs.length; i++) worst = Math.max(worst, Math.abs(xs[i] - ys[i]));\n  if (!(worst <= TOL)) throw new Error(`${{name}} differ by ${{worst}}`);\n}};\nconst agree = async (body: boolean) => {{\n  const kernels = await gpu(N, A, K);\n  const field = {tn}.field(N, A, K, 1);\n  if (body) {{ kernels.add(new Hole({{ x: 6, y: 6, mx: 0.5, ways: 8 }})); field.add(new Hole({{ x: 6, y: 6, mx: 0.5, ways: 8 }})); }}\n  for (let t = 0; t < TICKS; t++) {{\n    await kernels.tick(); field.tick;\n    close(`n after ${{t + 1}}`, await kernels.state(), field.n);\n    close(`rho after ${{t + 1}}`, await kernels.rho(), field.rho);\n    close(`folds after ${{t + 1}}`, await kernels.folds(), field.folds);\n  }}\n  close(\"mean\", [await kernels.mean()], [field.mean]);\n}};\nconst moving = async () => {{\n  const kernels = await gpu(N, A, K, 2);\n  const field = G.field(N, A, K, 1, 8, 2);\n  for (const w of [kernels, field]) w.add(new Hole({{ x: 4, y: 6, mx: 0.5, ways: 8, tag: 1, moves: true, px: 3, py: 0 }}));\n  for (let t = 0; t < TICKS; t++) {{\n    await kernels.tick(); field.tick;\n    close(`n after ${{t + 1}}`, await kernels.state(), field.n);\n    const arrived = await kernels.arrived(1), mine = new Float32Array(field.cells);\n    for (let c = 0; c < field.cells; c++) mine[c] = field.arrived(1, c);\n    close(`tag 1 after ${{t + 1}}`, arrived, mine);\n    close(`body after ${{t + 1}}`, [kernels.bodies[0].x, kernels.bodies[0].y, kernels.bodies[0].px], [field.holes[0].x, field.holes[0].y, field.holes[0].px]);\n  }}\n}};\n\nDeno.test(\"{tn} on {nm} says what the CPU field says\", () => agree(false));\nDeno.test(\"{tn} on {nm} says what the CPU field says, with a body\", () => agree(true));\nDeno.test(\"{tn} on {nm} moves a tagged body as the CPU field does\", () => moving());\n"
  }

  write_backend (nm: String, code: String) => {
    @./languages/physics.ts/src/{nm}.ts := code
  }

  package_json (): String => "{{\n  \"name\": \"@orbitmines/physics\",\n  \"version\": \"0.0.1\",\n  \"description\": \"The discrete theory G - the rules, and the smallest thing that runs them. Generated from implementation/physics.ray.\",\n  \"license\": \"SEE LICENSE IN LICENSE\",\n  \"repository\": \"https://github.com/orbitmines/physics\",\n  \"type\": \"module\",\n  \"main\": \"./index.ts\",\n  \"exports\": {{ \".\": \"./index.ts\", \"./theorems\": \"./theorems.ts\", \"./notation\": \"./notation.ts\" }},\n  \"files\": [\"index.ts\", \"theorems.ts\", \"notation.ts\", \"src\"],\n  \"scripts\": {{ \"typecheck\": \"tsc --noEmit\" }},\n  \"devDependencies\": {{ \"typescript\": \"^6.0.3\", \"tsx\": \"^4.21.0\", \"@types/node\": \"^25.6.0\" }}\n}}\n"
}
