/*
 * THE WOLFRAM LANGUAGE, as a mapping from the constructs of Ray to text. Every Ray class is a head of its own: an object is
 * `Hole[id, slots]` (a HashTable, so that a change is seen by everyone holding it), made with `Hole[{"x" -> 3., ...}]`;
 * its members are read `x["cells"]`, called `x["add", h]` and written `x["tag" -> v]`, and a class's statics are on its
 * head (`Medium["GATHER"]`, `Expr["mentions", e, "x"]`). Each member is a definition of its own in the class's context
 * (`Hole`perWay[self_] := ...`), found class by class up the chain (implementation/gen/backends/cpu.runtime.wl). A
 * theory's rules become rules: `G["Rules"]` holds each as a RuleDelayed, its pattern what it applies to with its filter
 * a Condition, its right side the step - and the tick applies those same rules. A class is written `⟪Name⟫` here and
 * given its head when the package is written (`heads`): a name the Wolfram Language already has is `Ray<Name>`.
 *
 * A Wolfram symbol cannot hold an underscore, which Ray's names have everywhere, so a local is written
 * `env<k>["name"]` (`{local_name}`, `k` the depth of the scope that binds it) and a `return` a `Throw` with the tag
 * `ret`; when the package loads each program is made a definition (a method, `sym[self_, p_, q_ : Null, ___] := ...`)
 * or a Function (a lambda, `Function[{p, q}, ...]`), its locals symbols of the context OrbitMines`Physics`Local` named
 * after the Ray names, in a Module where a lambda inside may take them and a Block where none can, the Catch only where
 * a `return` is not the last thing it does. Numbers are machine reals (`{whole}` writes `3.`); the operators keep Ray's meaning
 * through the runtime (`add`, `div`, `lt`, `eq`, ...): an absent number reads as nought, `/` by nought is IEEE's, a
 * comparison is exact, and an operator on an object is its own member (`v + w` is `v["plus", w]`).
 */

Wolfram: Language = class {
  name = "Wolfram"
  extension = ".wl"

  {indent} => "  "
  {separator} => ", "
  {newline} => ";\n"
  {statement_end} => ""
  {empty_block} => "Null"
  {interpolation} => "\" <> str[{x}] <> \""
  {named_arg} => "\"{raw}\" -> {val}"
  {parameter} => "{nm} = arg[args{d}, {i}]"
  {parameter_untyped} => "{nm} = arg[args{d}, {i}]"
  {parameter_default} => "{nm} = arg[args{d}, {i}]"
  {parameter_separator} => ", "
  {dynamic_get} => "{tgt}[str[{key}]]"
  {dynamic_set} => "{tgt}[str[{key}] -> {val}]"
  {whole} => "{val}."
  {global_name} => "global[\"{nm}\"]"
  {local_name} => "env{k}[\"{nm}\"]"
  {defaults_in_body} => "yes"
  {class_ref} => "⟪{nm}⟫"
  {field_assign} => "field[klass, \"{nm}\", dfn[{val}]]"

  /* control flow */
  {if cond { yesbody } else { nobody }} => "If[truthy[{cond}],\n{yesbody.indent},\n{nobody.indent}]"
  {if cond { yesbody }} => "If[truthy[{cond}],\n{yesbody.indent}]"
  {unless cond { yesbody }} => "If[!truthy[{cond}],\n{yesbody.indent}]"
  {while cond { loopbody }} => "While[truthy[{cond}],\n{loopbody.indent}]"
  {return val} => "Throw[{val}, ret]"
  {return} => "Throw[Null, ret]"
  {dynamically assert cond} => "If[!truthy[{cond}], fail[{cond.quoted}]]"

  /* definitions and assignment: a member is written as a rule, `x["tag" -> v]` */
  {nm := val} => "{nm} = {val}"
  {tgt.nm = rhs} => "{tgt}[\"{nm.raw}\" -> {rhs}]"
  {lhs = rhs} => "{lhs} = {rhs}"
  {tgt[k] = rhs} => "setAt[{tgt}, {k}, {rhs}]"

  /* expressions: `&` and `|` hand back one of their sides, as TypeScript's do, the second read only when it is needed */
  {a & b} => "andV[{a}, {b}]"
  {a | b} => "orV[{a}, {b}]"
  {!a} => "not[{a}]"
  {-a} => "neg[{a}]"
  {a == b} => "eq[{a}, {b}]"
  {a != b} => "(!eq[{a}, {b}])"
  {a < b} => "lt[{a}, {b}]"
  {a <= b} => "le[{a}, {b}]"
  {a > b} => "gt[{a}, {b}]"
  {a >= b} => "ge[{a}, {b}]"
  {a + b} => "add[{a}, {b}]"
  {a - b} => "sub[{a}, {b}]"
  {a * b} => "mul[{a}, {b}]"
  {a / b} => "div[{a}, {b}]"
  {a % b} => "mod[{a}, {b}]"
  {a ^ b} => "power[{a}, {b}]"
  {a ?? b} => "orElse[{a}, {b}]"
  {cond ? a : b} => "If[truthy[{cond}], {a}, {b}]"
  {a ==.instance_of Array} => "listQ[{a}]"
  {a ==.instance_of ty} => "instanceOf[{a}, ⟪{ty}⟫]"
  {a as ty} => "{a}"
  {tgt.nm} => "{tgt}[\"{nm.raw.method}\"]"
  {tgt?.nm} => "getOpt[{tgt}, \"{nm.raw.method}\"]"
  {tgt.nm()} => "{tgt}[\"{nm.raw.method}\"]"
  {tgt?.nm()} => "getOpt[{tgt}, \"{nm.raw.method}\"]"
  {tgt.nm(arglist)} => "{tgt}[\"{nm.raw.method}\", {arglist}]"
  {tgt?.nm(arglist)} => "callOpt[{tgt}, \"{nm.raw.method}\", {arglist}]"
  {tgt.choose("nm")} => "{tgt}[\"choose {nm}\"]"
  {tgt[k]} => "elem[{tgt}, {k}]"
  {fn()} => "{fn}[]"
  {fn(arglist)} => "{fn}[{arglist}]"
  {Class()} => "⟪{Class}⟫[{{}}]"
  {Class(arglist)} => "⟪{Class}⟫[{{ {arglist} }}]"
  {[elems]} => "list[{elems}]"
  { {} } => "⟪Node⟫[{{}}]"
  {this} => "self"
  {None} => "Null"
  {true} => "True"
  {false} => "False"
  {"txt"} => "\"{txt}\""
  {(paramlist) => { stmts }} => "lfn[{d}, {{ {paramlist} }};\n{stmts.returned.indent}]"
  {(paramlist) => e} => "lfn[{d}, {{ {paramlist} }}; Throw[{e}, ret]]"
  {xs#} => "many[{xs}]"
  {draw([ws], [os])} => "self[\"vertex\"][\"world\"][\"draw\", list[{ws}], list[{os}]]"

  /* a block taken apart by `for`: a Do over the items, the block a scope of its own (`loopScope`), a `return` in it the method's */
  {Array.range(cnt).for((x_) => { stmts })} => "Do[loopScope[{d}, {x_.bare} = iter{d};\n{stmts.indent}], {{iter{d}, 0., num[{cnt}] - 1.}}]"
  {xs.for((x_) => { stmts })} => "Do[loopScope[{d}, {x_.bare} = iter{d};\n{stmts.indent}], {{iter{d}, items[{xs}]}}]"

  /* the recognised classes: a list, a text or a number's own member - and any object's own member of that name otherwise */
  {fail(x_)} => "fail[{x_}]"
  {Catalogue.number(x_)} => "number[{x_}]"
  {String(chars: xs)} => "fromCodepoints[{xs}]"
  {x_.blank} => "blank[{x_}]"
  {xs.push(x_)} => "mPush[{xs}, {x_}]"
  {xs.chars} => "mChars[{xs}]"
  {xs.pop} => "mPop[{xs}]"
  {xs.length} => "len[{xs}]"
  {xs.map(f)} => "mMap[{xs}, {f}]"
  {xs.filter(f)} => "filt[{xs}, {f}]"
  {xs.for(f)} => "mFor[{xs}, {f}]"
  {xs.some(f)} => "mSome[{xs}, {f}]"
  {xs.every(f)} => "mEvery[{xs}, {f}]"
  {xs.reduce(z, f)} => "mReduce[{xs}, {z}, {f}]"
  {xs.starts_with(x_)} => "mStartsWith[{xs}, {x_}]"
  {xs.ends_with(x_)} => "mEndsWith[{xs}, {x_}]"
  {xs.replace(x_, y_)} => "mReplace[{xs}, {x_}, {y_}]"
  {xs.split(x_)} => "mSplit[{xs}, {x_}]"
  {xs.trim} => "mTrim[{xs}]"
  {xs.upper} => "mUpper[{xs}]"
  {xs.lower} => "mLower[{xs}]"
  {xs.lines} => "mLines[{xs}]"
  {xs.quoted} => "quoted[{xs}]"
  {xs.contains(x_)} => "mContains[{xs}, {x_}]"
  {xs.index_of(x_)} => "mIndexOf[{xs}, {x_}]"
  {xs.join(sep)} => "mJoin[{xs}, {sep}]"
  {xs.first} => "mFirst[{xs}]"
  {xs.last} => "mLast[{xs}]"
  {xs.empty} => "mEmpty[{xs}]"
  {xs.take(cnt)} => "mTake[{xs}, {cnt}]"
  {xs.drop(cnt)} => "mDrop[{xs}, {cnt}]"
  {xs.rest} => "mRest[{xs}]"
  {xs.concat(ys)} => "mConcat[{xs}, {ys}]"
  {xs.reverse} => "mReverse[{xs}]"
  {xs.sum} => "mSum[{xs}]"
  {xs.most(f)} => "mMost[{xs}, {f}]"
  {xs.sorted_by(f)} => "mSortedBy[{xs}, {f}]"
  {xs.each} => "mEach[{xs}]"
  {Array.range(cnt)} => "rng[{cnt}]"
  {Array.filled(cnt, x_)} => "filled[{cnt}, {x_}]"
  {x_.sqrt} => "mSqrt[{x_}]"
  {x_.floor} => "mFloor[{x_}]"
  {x_.abs} => "mAbs[{x_}]"
  {x_.negated} => "neg[{x_}]"
  {x_.magnitude} => "mMagnitude[{x_}]"
  {x_.cos} => "mCos[{x_}]"
  {x_.sin} => "mSin[{x_}]"
  {x_.round} => "mRound[{x_}]"
  {x_.ln} => "mLn[{x_}]"
  {x_.exp} => "mExp[{x_}]"
  {x_.atan2(y_)} => "mAtan2[{x_}, {y_}]"
  {x_.pow(y_)} => "mPow[{x_}, {y_}]"
  {Real.of(x_)} => "{x_}"
  {Real.ZERO} => "0."
  {Real.ONE} => "1."
  {Real.TWO} => "2."
  {Real.PI} => "3.141592653589793"
  {Real.NAN} => "Indeterminate"
  {Real.INFINITY} => "Infinity"
  {Real.TAU} => "6.283185307179586"
  {Random.MODULUS} => "4294967296."
  {Random.MULTIPLIER} => "1664525."
  {Random.INCREMENT} => "1013904223."

  /* types are not written */
  {N} => "Null"
  {Natural} => "Null"
  {Z} => "Null"
  {Integer} => "Null"
  {Real} => "Null"
  {Decimal} => "Null"
  {boolean} => "Null"
  {String} => "Null"
  {Array} => "Null"
  {*} => "Null"
  {{}} => "Null"
  {ty[]} => "Null"
  {ty?} => "Null"
  {Program} => "Null"

  /* classes: a head each, defined when the package loads - parents first, as the core lists them */
  {nm := class < sup { membs }} => "DefineClass[⟪{nm.raw}⟫, \"{nm.raw}\", ⟪{sup.first}⟫, Function[{{klass}},\n{membs.indent}]];"
  {nm := class { membs }} => "DefineClass[⟪{nm.raw}⟫, \"{nm.raw}\", ⟪Node⟫, Function[{{klass}},\n{membs.indent}]];"
  {nm: ty = class { membs }} => "DefineClass[⟪{nm.raw}⟫, \"{nm.raw}\", ⟪{ty}⟫, Function[{{klass}},\n{membs.indent}]];\nDefineTheory[⟪{nm.raw}⟫];"
  {theorem "nm" () => tbody} => "staticField[klass, \"theorem {nm}\", dfn[⟪Theorem⟫[{{ \"id\" -> {nm.quoted}, \"body\" -> lfn[{d},\n{tbody.returned.indent}] }}]]]"
  {x_.body()} => "{x_}[\"body\"][]"
  {nm: ty = val} => "field[klass, \"{nm.raw}\", dfn[{val}]]"
  {nm: ty} => "field[klass, \"{nm.raw}\"]"
  {nm = val} => "staticField[klass, \"{nm.raw}\", dfn[{val}]]"
  {static nm: ty = val} => "staticField[klass, \"{nm.raw}\", dfn[{val}]]"
  {static nm = val} => "staticField[klass, \"{nm.raw}\", dfn[{val}]]"
  {nm (): ret => mbody} => "getter[klass, \"{nm.raw.method}\", mfn[{d},\n{mbody.returned.indent}]]"
  {nm () => mbody} => "getter[klass, \"{nm.raw.method}\", mfn[{d},\n{mbody.returned.indent}]]"
  {static nm (): ret => mbody} => "statik[klass, \"{nm.raw.method}\", mfn[{d},\n{mbody.returned.indent}]]"
  {static nm () => mbody} => "statik[klass, \"{nm.raw.method}\", mfn[{d},\n{mbody.returned.indent}]]"
  {nm (paramlist): ret => mbody} => "method[klass, \"{nm.raw.method}\", mfn[{d}, {{ {paramlist} }};\n{mbody.returned.indent}]]"
  {nm (paramlist) => mbody} => "method[klass, \"{nm.raw.method}\", mfn[{d}, {{ {paramlist} }};\n{mbody.returned.indent}]]"
  {static nm (paramlist): ret => mbody} => "statik[klass, \"{nm.raw.method}\", mfn[{d}, {{ {paramlist} }};\n{mbody.returned.indent}]]"
  {static nm (paramlist) => mbody} => "statik[klass, \"{nm.raw.method}\", mfn[{d}, {{ {paramlist} }};\n{mbody.returned.indent}]]"
  {nm (paramlist): ret} => "declaredOnly[klass, \"{nm.raw.method}\", \"method\", \"{nm} is declared but not defined by anyone\"]"
  {nm (paramlist)} => "declaredOnly[klass, \"{nm.raw.method}\", \"method\", \"{nm} is declared but not defined by anyone\"]"
  {nm (): ret} => "declaredOnly[klass, \"{nm.raw.method}\", \"getter\", \"{nm} is declared but not defined by anyone\"]"
  {nm ()} => "declaredOnly[klass, \"{nm.raw.method}\", \"getter\", \"{nm} is declared but not defined by anyone\"]"
  {static nm (paramlist): ret} => "declaredOnly[klass, \"{nm.raw.method}\", \"static\", \"{nm} is declared but not defined by anyone\"]"
  {static nm (paramlist)} => "declaredOnly[klass, \"{nm.raw.method}\", \"static\", \"{nm} is declared but not defined by anyone\"]"
  /* a rule of a theory: what it applies to (its class, one or a point's Many), its filter and its step - a RuleDelayed when the package loads */
  {rule /rid "nm" | rt () => rbody} => "theoryRule[klass, \"{rid}\", {nm.quoted}, {rt.quoted}, {over.quoted}, {single}, {source.quoted}, {where}, lfn[{d},\n{rbody.returned.indent}]]"
  {rule /rid "nm" () => rbody} => "theoryRule[klass, \"{rid}\", {nm.quoted}, Null, {over.quoted}, {single}, {source.quoted}, {where}, lfn[{d},\n{rbody.returned.indent}]]"
  {rule /rid "nm" | rt (paramlist) => rbody} => "theoryRule[klass, \"{rid}\", {nm.quoted}, {rt.quoted}, {over.quoted}, {single}, {source.quoted}, {where}, lfn[{d}, {{ {paramlist} }};\n{rbody.returned.indent}]]"
  {rule /rid "nm" (paramlist) => rbody} => "theoryRule[klass, \"{rid}\", {nm.quoted}, Null, {over.quoted}, {single}, {source.quoted}, {where}, lfn[{d}, {{ {paramlist} }};\n{rbody.returned.indent}]]"
  {choose "nm" (paramlist): ret} => "declaredOnly[klass, \"choose {nm}\", \"method\", \"the choice {nm} is not defined by anyone\"]"
  {choose "nm" (paramlist): ret => cbody} => "method[klass, \"choose {nm}\", mfn[{d}, {{ {paramlist} }};\n{cbody.returned.indent}]]"
  {choose "nm" (paramlist) => cbody} => "method[klass, \"choose {nm}\", mfn[{d}, {{ {paramlist} }};\n{cbody.returned.indent}]]"
  {as (=== ty) => cbody} => "getter[klass, \"as_{ty}\", mfn[{d},\n{cbody.returned.indent}]]"

  /* a nested class is a head of its own, then a static of the outer one */
  nested (outer: String, inner_name: String, inner: String): String => "{inner}\n⟪{outer}⟫[\"{inner_name}\" -> ⟪{inner_name}⟫];"

  /* a top-level definition is made on its first read (`{global_name}`) */
  constant (nm: String, text: String): String => "With[{{f = dfn[{text}]}}, global[\"{nm}\"] := global[\"{nm}\"] = f[Null]];"

  term_literal (id: String, rate: String, degree: N, outside: boolean, settles: boolean, transport: boolean, share: String, rays: String, space: String, folds: String, share_source: String, rays_source: String, space_source: String, folds_source: String, rule_name: String, over: String, where_source: String, rule_source: String, leans: String, carries: boolean, sets: boolean, turned: String, asked: String, asked_source: String, around: String, around_source: String, grown: boolean, grew: String, grew_source: String, trades: boolean, grew_apart: String, grew_apart_source: String): String => {
    rate_ := rate.empty ? "Null" : rate.quoted
    where := where_source.empty ? "Null" : "⟪Node⟫[{{ \"source\" -> {where_source.quoted} }}]"
    rule := id.empty ? "Null" : "⟪Node⟫[{{ \"id\" -> {id.quoted}, \"rate\" -> {rate_}, \"name\" -> {rule_name.quoted}, \"over\" -> {over.quoted}, \"where\" -> {where}, \"source\" -> {rule_source.quoted} }}]"
    leans_ := leans.empty ? "Null" : leans.quoted
    node_at := (src: String, f: String): String => "⟪Node⟫[{{ \"source\" -> {src.quoted}, \"at\" -> sfn[{f}] }}]"
    "    ⟪Node⟫[{{ \"rule\" -> {rule}, \"rate\" -> {rate_}, \"degree\" -> {degree}.0, \"outside\" -> {outside}, \"settles\" -> {settles}, \"transport\" -> {transport}, \"leans\" -> {leans_}, \"turned\" -> {turned.quoted}, \"doing\" -> ⟪Node⟫[{{ \"carries\" -> {carries}, \"sets\" -> {sets}, \"grown\" -> {grown}, \"trades\" -> {trades}, \"grew\" -> {node_at(grew_source, grew)}, \"grew_apart\" -> {node_at(grew_apart_source, grew_apart)}, \"draws\" -> Null, \"needs\" -> {degree}.0, \"outside\" -> {outside}, \"settles\" -> {settles}, \"share\" -> {node_at(share_source, share)}, \"asked\" -> {node_at(asked_source, asked)}, \"around\" -> {node_at(around_source, around)}, \"rays\" -> {node_at(rays_source, rays)}, \"space\" -> {node_at(space_source, space)}, \"folds\" -> {node_at(folds_source, folds)} }}] }}]"
  }
  equation_literal (theory: String, latex: String, terms: String[]): String => {
    lines := terms.join(",\n")
    "⟪{theory}⟫[\"equation\" -> ⟪Node⟫[{{ \"latex\" -> {latex.quoted}, \"terms\" -> list[\n{lines}\n] }}]];"
  }

  /* every class written `⟪Name⟫` given its head: its own name, or `Ray<Name>` where the Wolfram Language already has the name */
  heads (code: String): String => {
    parts := code.split("⟪")
    out := [parts[0]]
    parts.drop(1).for(p => {
      nm := p.split("⟫")[0]
      out.push(Wolfram.head(nm))
      out.push(p.drop(nm.length + 1))
    })
    out.join("")
  }
  head (nm: String): String => {
    n := nm.split(".").last
    Wolfram.clashes.contains(n) ? "Ray{n}" : n
  }
  /* the names of the package's classes that are names of the Wolfram Language's own (System`) */
  /* the names of the package's classes the Wolfram Language already has (System`, Wolfram Engine 15.0) */
  clashes (): String[] => ["Random", "Rule", "Around", "Cell", "Grid", "Solve", "Setter", "Line", "Part", "Medium", "Pane", "Panel", "Annulus", "Axis"]

  /*
   * A number the emitter writes as `1e11` or `1.5e-3` is `1.*^11` and `1.5*^-3` here (Wolfram reads `1e11` as 1 times
   * the name e11): outside every string of the code, a run of digits before an `e` and a whole power after it.
   */
  exponents (code: String): String => {
    parts := code.split("\"")
    out := []
    inside := false
    parts.for(p => {
      out.push(inside ? p : Wolfram.exponent(p))
      inside = inside ? Wolfram.escaped(p) : true
    })
    out.join("\"")
  }
  /* whether the quote after a piece of a string is escaped: an odd number of backslashes before it */
  escaped (p: String): boolean => {
    n := 0
    q := p
    while q.ends_with("\\") {
      n = n + 1
      q = q.take(q.length - 1)
    }
    n % 2 == 1
  }
  exponent (p: String): String => {
    return p if !["0e", "1e", "2e", "3e", "4e", "5e", "6e", "7e", "8e", "9e"].some(dg => p.contains(dg))
    segs := p.split("e")
    out := segs[0]
    segs.drop(1).for(nxt => {
      run := Wolfram.mantissa(out)
      if run != "" & Wolfram.power_starts(nxt) {
        head := out.take(out.length - run.length)
        point := run.contains(".") ? run : "{run}."
        out = "{head}{point}*^{nxt}"
      } else {
        out = "{out}e{nxt}"
      }
    })
    out
  }
  /* the digits a text ends with, where they stand as a number of their own (not the end of a name) */
  mantissa (s: String): String => {
    i := s.length
    while i > 0 & "0123456789.".contains(s.drop(i - 1).take(1)) {
      i = i - 1
    }
    run := s.drop(i)
    before := i == 0 ? "" : s.drop(i - 1).take(1)
    return "" if run == "" | run.starts_with(".")
    return "" if before != "" & !" [({{,=+-*/^;\n<>!&|".contains(before)
    run
  }
  power_starts (n: String): boolean => {
    c0 := n.take(1)
    c1 := n.drop(1).take(1)
    return true if c0 != "" & "0123456789".contains(c0)
    (c0 == "-" | c0 == "+") & c1 != "" & "0123456789".contains(c1)
  }

  write_package (code: String) => {
    @./languages/physics.wl-definition.wls := Wolfram.definition_script
    @./languages/physics.wl-submit.wls := Wolfram.submit_script
    @./languages/physics.wl/README.md := this.readme
    @./languages/physics.wl/PacletInfo.wl := Wolfram.paclet
    named := Wolfram.heads(code)
    @./languages/physics.wl/Kernel/Physics.wl := Wolfram.exponents(named.replace("OrbitMinesPhysicsClasses;", "{{{Wolfram.head_names(code)}}};"))
  }
  /* every head the code names, once each: made in the package's own context before the code is read */
  head_names (code: String): String => {
    seen := {}
    out := []
    code.split("⟪").drop(1).for(p => {
      h := Wolfram.head(p.split("⟫")[0])
      if seen[h] == None {
        seen[h] = true
        out.push(h)
      }
    })
    out.join(", ")
  }

  test_case (r: Requirement, f: Fixture): String => {
    definition := f.definition.as(Wolfram)
    requirement := r.requirement.as(Wolfram)
    filter := r.filter == None ? "True" : r.filter.as(Wolfram)
    label := "{r.location} on {f.name}"
    "t[{label.quoted}, Module[{{it, guard = 0}},\n  it = {definition};\n  Catch[\n    While[!truthy[{filter}], If[++guard > {r.until} || !has[it, \"tick\"], Throw[\"skip\", skip]]; it[\"tick\"]];\n    If[truthy[{requirement}], \"pass\", \"failed: \" <> {requirement.quoted}],\n    skip]]];"
  }

  write_tests (cases: String, fixtures: Fixture[]) => {
    @./tests/wl/TestG.wl := Wolfram.exponents(Wolfram.heads("(* GENERATED by `npx ray gen` from implementation/physics.ray - do not edit *)\n(* wolframscript -file tests/wl/TestG.wl [filter] - every requirement on every fixture the package carries; a filter keeps the cases whose name contains it *)\n(* a script is read as Latin-1: the file is read again as UTF-8, and that reading runs it *)\nIf[!TrueQ[OrbitMinesPhysicsTestUTF8], OrbitMinesPhysicsTestUTF8 = True; Get[$InputFileName, CharacterEncoding -> \"UTF-8\"]; Exit[]];\nPacletDirectoryLoad[FileNameJoin[{{DirectoryName[$InputFileName], \"..\", \"..\", \"languages\", \"physics.wl\"}}]];\nNeeds[\"OrbitMines`Physics`\"];\nBegin[\"OrbitMines`Physics`Private`\"];\n\nonly = If[Length[$ScriptCommandLine] > 1, $ScriptCommandLine[[2]], None];\npassed = 0; failed = 0; skipped = 0;\nSetAttributes[t, HoldRest];\nt[name_String, body_] := If[only === None || StringContainsQ[name, only], Module[{{t0 = AbsoluteTime[], got, s}},\n  got = Catch[Check[str[body], \"error: \" <> ToString[$MessageList]], _, Function[{{v, tag}}, \"error: \" <> ToString[v]]];\n  s = AbsoluteTime[] - t0;\n  Which[got === \"pass\", passed++, got === \"skip\", skipped++, True, failed++];\n  Print[Which[got === \"pass\", \"ok  \", got === \"skip\", \"skip\", True, \"FAIL\"], \" \", name, \" (\", ToString[NumberForm[s, {{Infinity, 2}}]], \" s)\", If[got === \"pass\" || got === \"skip\", \"\", \" - \" <> got]]]];\n\n{cases}\n\nPrint[passed, \" passed, \", failed, \" failed, \", skipped, \" skipped\"];\nExit[If[failed > 0, 1, 0]];\n"))
  }

  /* the Wolfram Language renders no films: the .ray/TypeScript pipeline records them */
  {visual "nm" () => vbody} => "Null"
  write_visuals (entries: String) => { }
  write_notation () => { }

  /* every theorem, as one JSON text in the paclet's Data/, read with `Theorems[]` */
  write_theorems (proofs: String) => {
    @./languages/physics.wl/Data/theorems.json := "{{{proofs}}}"
  }

  write_backend_tests (nm: String, theory: Theory) => { }
  write_backend (nm: String, code: String) => { }

  /* the CPU backend's runtime around the emitted classes */
  cpu_runtime (): String => @./implementation/gen/backends/cpu.runtime.wl
  /* the package's folder under languages/ */
  package_dir (): String => "physics.wl"
  install (): String => "```wolfram\n(* Wolfram Language *)\nPacletInstall[\"OrbitMines/Physics\"]\n```"
  paclet (): String => "(* GENERATED by `npx ray gen` from implementation/physics.ray - do not edit *)\nPacletObject[<|\n  \"Name\" -> \"OrbitMines/Physics\",\n  \"Version\" -> \"{Release.numeric}\",\n  \"WolframVersion\" -> \"13.0+\",\n  \"Description\" -> \"{Release.description}\",\n  \"Creator\" -> \"OrbitMines\",\n  \"License\" -> \"MIT\",\n  \"PublisherID\" -> \"OrbitMines\",\n  \"PrimaryContext\" -> \"OrbitMines`Physics`\",\n  \"URL\" -> \"https://github.com/orbitmines/physics\",\n  \"Extensions\" -> {{\n    {{\"Kernel\", \"Root\" -> \"Kernel\", \"Context\" -> {{\"OrbitMines`Physics`\"}}}},\n    {{\"Asset\", \"Assets\" -> {{{{\"theorems\", \"Data/theorems.json\"}}}}}}\n  }}\n|>]\n"
  readme (): String => "# OrbitMines/Physics - Wolfram Language\n\n> Generated by `npx ray gen` from [implementation/physics.ray](../../implementation/physics.ray/) and [implementation/gen](../../implementation/gen/). Do not edit - change the `.ray` and regenerate.\n\nThe physics library in the Wolfram Language: the theories and their rules, the continuous model derived from them (the medium), and the settings a simulation of sources - stars, planets, any bodies a theory has - is planned by. Back to the [project README](../../README.md).\n\n## Installation\n\n{Wolfram.install}\n\nWolfram Language 13 or later (Mathematica, or the free Wolfram Engine with `wolframscript`). From a checkout: `PacletDirectoryLoad[\"languages/physics.wl\"]`, then ``Needs[\"OrbitMines`Physics`\"]``.\n\n## Using it\n\nEvery class is a head of its own: an object is `Hole[id, slots]`, made with `Hole[<|\"x\" -> 15., ...|>]` (or `Hole[{{\"x\" -> 15., ...}}]`, whose values without a name fill the fields in the order they are declared). A member is read `hole[\"mass\"]`, called `medium[\"add\", hole]` and written `hole[\"tag\" -> 1.]`; a method read without its arguments is a Function (`medium[\"add\"][hole]`). A class's statics are on its head (`RayMedium[\"GATHER\"]`, `Expr[\"mentions\", e, \"x\"]`), and a theory is its head (`G`). A class whose name the Wolfram Language already has is written `Ray<Name>` (`RayMedium`, `RayRule`, `RayLine`); `ClassOf[\"Medium\"]` finds it. Every member is a definition of its own in the class's context: `?OrbitMines`Physics`Hole`perWay`. Numbers are machine reals (write `31.`, not `31`), a list is a `DynamicArray` (`items[xs]` is its elements), `Null` is None. Loading the package keeps machine arithmetic machine arithmetic: it turns off the underflow and indeterminate-product messages and raises `$RecursionLimit`.\n\n```wolfram\nNeeds[\"OrbitMines`Physics`\"]\n\n(* a theory, and its continuous model on the CPU: a box of cells, the vacuum settled, one body in it *)\nmedium = G[\"medium\", 31., 96., 3., 8., 1.];\nmedium[\"local_rays\" -> True];\nmedium[\"add\", Hole[<|\"x\" -> 15., \"y\" -> 15., \"mx\" -> 0.3, \"ways\" -> 1.|>]];\nmedium[\"seed\"];\nDo[medium[\"tick\"], 5]\n```\n\n## The rules of a theory, as rules\n\n`G[\"Rules\"]` is every rule of the theory as a rule, by its id: the pattern what it applies to (its class - an `Edge`, a `Vertex`, or a point's rays as a `Many`), its filter a Condition, the right side the step it takes. Every rule of G changes the world where it matches, so each is a RuleDelayed whose right side performs the step; `G[\"RuleInfo\"]` gives each one's id, name, rate and what it is over. The tick applies these same rules, one match at a time, so one can be applied by hand:\n\n```wolfram\nG[\"Rules\"][\"/1\"]      (* x_Edge /; truthy[x[\"active\"]] :> x[\"ANNIHILATE\"] *)\nedge /. G[\"Rules\"][\"/1\"]\n```\n\n## A simulation of sources: the plan\n\nA run is set by a `Plan`: how many sources, how big a box, and four kinds of setting - `Resolution` (how finely the medium reads), `Budget` (how much of the device it may take), `Batching` (how a run larger than the device is carried) and `Output` (what comes back). The plan says what the device must hold before anything runs.\n\n```wolfram\nplan = Plan[<|\"sources\" -> 1.*^9, \"side\" -> 241.|>];\nplan[\"budget\"][\"compact\" -> True];   (* twelve bytes a source *)\nPrint[plan[\"report\", 16. 2^30, 2.^31]]\n```\n\n## Theorems\n\n`Theorems[]` is every theorem, keyed by theory and then by question (an Association read from `Data/theorems.json`).\n\n## On the GPU\n\nThe GPU runtime of the medium is being carried into `.ray`, so that every language runs the same thing on every backend. Until then it runs from the [TypeScript package](../physics.ts/README.md).\n"
  /* its job in .github/workflows/release.yml (Release.ray): build, keep what it built, publish where the registry's credentials are set */
  release_job (): String => "  wolfram:\n    needs: version\n    runs-on: ubuntu-latest\n    env:\n      PUBLISH: ${{{{ needs.version.outputs.publish }}}}\n      TESTING: ${{{{ needs.version.outputs.testing }}}}\n    steps:\n      - uses: actions/checkout@v7\n      - name: pack the paclet\n        run: mkdir -p out && cd languages/physics.wl && zip -r \"../../out/OrbitMines__Physics-{Release.numeric}.paclet\" . -x README.md\n      - uses: actions/upload-artifact@v7\n        with:\n          name: wolfram\n          path: out/\n          if-no-files-found: error\n      - name: the Wolfram Paclet Repository takes a paclet by submission\n        if: env.PUBLISH == 'true'\n        run: echo \"submit out/OrbitMines__Physics-{Release.numeric}.paclet through the Paclet Repository's submission notebook (resources.wolframcloud.com/PacletRepository)\"\n  wolfram-submit:\n    needs: [version, wolfram]\n    if: needs.version.outputs.publish == 'true'\n    runs-on: ubuntu-latest\n    container:\n      image: wolframresearch/wolframengine:latest\n      options: --user root\n    env:\n      WOLFRAMSCRIPT_ENTITLEMENTID: ${{{{ secrets.WOLFRAMSCRIPT_ENTITLEMENTID }}}}\n      RESOURCE_PUBLISHER_TOKEN: ${{{{ secrets.RESOURCE_PUBLISHER_TOKEN }}}}\n      HAS_CREDENTIALS: ${{{{ secrets.WOLFRAMSCRIPT_ENTITLEMENTID != '' && secrets.RESOURCE_PUBLISHER_TOKEN != '' }}}}\n    steps:\n      - uses: actions/checkout@v7\n      - name: the definition notebook, off Wolfram's own template\n        if: env.HAS_CREDENTIALS == 'true'\n        run: wolframscript -file languages/physics.wl-definition.wls languages/physics.wl\n      - name: check the paclet as the Paclet Repository will\n        if: env.HAS_CREDENTIALS == 'true'\n        uses: WolframResearch/check-paclet@v1.11.0\n        with:\n          definition_notebook: ./languages/physics.wl/ResourceDefinition.nb\n      - name: submit to the Wolfram Language Paclet Repository (OrbitMines/Physics) - a test release says so to the reviewers\n        if: env.HAS_CREDENTIALS == 'true'\n        run: wolframscript -file languages/physics.wl-submit.wls languages/physics.wl/ResourceDefinition.nb \"${{{{ needs.version.outputs.testing == 'true' && env.TEST_NOTE || '' }}}}\"\n        env:\n          TEST_NOTE: \"{Release.test_note}\"\n"
  /* the Paclet Repository's definition notebook, made in CI from Wolfram's own template (no front end): the fields filled as the template fills them, and the system settings the runtime raises disclosed */
  definition_script (): String => "(* GENERATED by `npx ray gen` from implementation/gen/languages/Wolfram.ray - do not edit *)\n(* wolframscript -file languages/physics.wl-definition.wls languages/physics.wl *)\n(* the Paclet Repository's definition notebook for this paclet, made from Wolfram's own template - no front end needed *)\nNeeds[\"DefinitionNotebookClient`\"];\ndir = If[Length[$ScriptCommandLine] > 1, AbsoluteFileName[$ScriptCommandLine[[2]]], FileNameJoin[{{Directory[], \"physics.wl\"}}]];\ntext[s_] := Cell[s, \"Text\"]; item[s_] := Cell[s, \"Item\"];\ntemplate = Get[DefinitionNotebookClient`DefinitionTemplateLocation[\"Paclet\"]];\ndefault[slot_] := First@Cases[template, TemplateSlot[slot, ___, DefaultValue -> v_, ___] :> v, Infinity, 1];\n(* the runtime raises $RecursionLimit and $IterationLimit when it loads (deep call chains): disclosed, as the repository asks *)\n(* a slot filled as the template fills it: its own cell, its text replaced and no longer marked as default content *)\nfill[slot_, old_String, new_String] := default[slot] /. Cell[old, style_, opts___] :> Cell[new, style, Sequence @@ ({{opts}} /. (CellTags -> tags_List) :> (CellTags -> DeleteCases[tags, \"DefaultContent\"]))];\ndisclosures = default[\"Disclosures\"] /. CheckboxBox[False, {{False, k : \"WLSystemConfiguration\" | \"WLSystemSymbols\"}}] :> CheckboxBox[k, {{False, k}}];\nslots = <|\n  \"PacletDirectory\" -> dir,\n  \"Name\" -> fill[\"Name\", \"MyPublisherID/MyPaclet\", \"OrbitMines/Physics\"],\n  \"Description\" -> fill[\"Description\", \"One-line description of the paclet\", \"OrbitMines: Physics Project\"],\n  \"CompatibilityWolframLanguageVersionRequired\" -> Replace[default[\"CompatibilityWolframLanguageVersionRequired\"], Cell[_String, style_, opts___] :> Cell[\"13.0+\", style, Sequence @@ ({{opts}} /. (CellTags -> tags_List) :> (CellTags -> DeleteCases[tags, \"DefaultContent\"]))], {{1}}],\n  \"LongDescription\" -> {{text[\"The discrete theory G and the continuous medium derived from its rules - the same library, generated from one set of .ray definitions, in Wolfram Language and twelve other languages.\"]}},\n  \"Details\" -> {{Cell[\"Every class and theory is generated from implementation/physics.ray by npx ray gen; nothing in the paclet is written by hand.\", \"Notes\"]}},\n  \"PrimaryContext\" -> {{text[\"OrbitMines`Physics`\"]}},\n  \"Contributed By\" -> {{text[\"OrbitMines\"]}},\n  \"SourceControlURL\" -> {{text[\"https://github.com/orbitmines/physics\"]}},\n  \"Keywords\" -> {{item[\"physics\"], item[\"gravity\"], item[\"simulation\"], item[\"discrete theory\"]}},\n  \"Disclosures\" -> disclosures\n|>;\n(* THE PAGE: what the paclet does, shown with the visuals the project renders (visuals/<id>/snapshot.png, beside the paclet in the repository) *)\nvisuals = FileNameJoin[{{DirectoryName[dir, 2], \"visuals\"}}];\nsnapshot[id_, w_] := Module[{{f = FileNameJoin[{{visuals, id, \"snapshot.png\"}}]}}, If[FileExistsQ[f], ImageResize[Import[f], w], Missing[]]];\npicture[id_, w_] := With[{{i = snapshot[id, w]}}, If[MissingQ[i], Nothing, Cell[BoxData[ToBoxes[i]], \"Output\"]]];\nhero = default[\"HeroImage\"] /. Cell[BoxData[_], rest___] :> With[{{i = snapshot[\"galaxy.rar\", 640]}}, If[MissingQ[i], Cell[BoxData[\"\"], rest], Cell[BoxData[ToBoxes[i]], rest]]];\ncode[s_String] := Cell[s, \"Input\"];\nexamples = {{Cell[CellGroupData[{{\n    Cell[\"Basic Examples\", \"Subsection\"],\n    Cell[\"Load the paclet:\", \"Text\"],\n    code[\"Needs[\\\"OrbitMines`Physics`\\\"]\"],\n    Cell[\"The theory G, its continuous model on the CPU - a box of cells, the vacuum settled, one body in it - ticked:\", \"Text\"],\n    code[\"medium = G[\\\"medium\\\", 31., 96., 3., 8., 1.];\\nmedium[\\\"local_rays\\\" -> True];\\nmedium[\\\"add\\\", Hole[<|\\\"x\\\" -> 15., \\\"y\\\" -> 15., \\\"mx\\\" -> 0.3, \\\"ways\\\" -> 1.|>]];\\nmedium[\\\"seed\\\"];\\nDo[medium[\\\"tick\\\"], 5]\"],\n    Cell[\"The theory's discrete rules are rules - each a RuleDelayed on what it acts on, applied as any other:\", \"Text\"],\n    code[\"G[\\\"Rules\\\"]\"],\n    code[\"G[\\\"Rules\\\"][\\\"/1\\\"]\"],\n    Cell[\"What a simulation of a billion sources would take of a 16 GiB device:\", \"Text\"],\n    code[\"plan = Plan[<|\\\"sources\\\" -> 1.*^9, \\\"side\\\" -> 241.|>];\\nplan[\\\"budget\\\"][\\\"compact\\\" -> True];\\nplan[\\\"report\\\", 16. 2^30, 2.^31]\"]\n  }}, Open]],\n  Cell[CellGroupData[Join[{{\n    Cell[\"Visuals\", \"Subsection\"],\n    Cell[\"What the project renders from the same definitions (rendered on the GPU by its TypeScript package; the films are in the repository's visuals/):\", \"Text\"]}},\n    Flatten[{{Cell[\"A galaxy's rotation against its visible mass:\", \"Text\"], picture[\"galaxy.rar\", 520],\n      Cell[\"A body's pull, from the medium itself:\", \"Text\"], picture[\"gravity.pull\", 520],\n      Cell[\"A galaxy in the medium, every star its own body:\", \"Text\"], picture[\"galaxy.medium\", 520],\n      Cell[\"The inner solar system in the medium:\", \"Text\"], picture[\"solar.inner\", 520]}}]], Open]]}};\nchosen = {{\"Scientific and Medical Data & Computation\", \"Symbolic & Numeric Computation\", \"Visualization & Graphics\"}};\ncategories = default[\"Categories\"] /. CheckboxBox[False, {{False, k_String}}] /; MemberQ[chosen, k] :> CheckboxBox[k, {{False, k}}];\nslots = Join[slots, <|\n  \"HeroImage\" -> hero,\n  \"ExampleNotebook\" -> examples,\n  \"Categories\" -> categories,\n  \"Links\" -> {{item[\"https://github.com/orbitmines/physics\"], item[\"https://orbitmines.com/physics\"]}},\n  \"Details\" -> {{Cell[\"Everything in the paclet is generated from the project's .ray definitions (implementation/physics.ray) by npx ray gen: the theory G and its discrete rules, the continuous medium derived from them, the prover's theorems, and the plan of a simulation of sources. The same library exists, from the same definitions, in TypeScript, Python, Julia, Lean, Rust, C++ and seven other languages.\", \"Notes\"]}}\n|>];\nnb = DefinitionNotebookClient`GenerateDefinitionNotebook[\"Paclet\", slots];\nExport[FileNameJoin[{{dir, \"ResourceDefinition.nb\"}}], nb, \"NB\"];\nPrint[\"wrote \", FileNameJoin[{{dir, \"ResourceDefinition.nb\"}}]];\n"
  /* the submission itself: Wolfram's SubmitPaclet, with the note for the reviewers its action cannot send */
  submit_script (): String => "(* GENERATED by `npx ray gen` from implementation/gen/languages/Wolfram.ray - do not edit *)\n(* wolframscript -file languages/physics.wl-submit.wls languages/physics.wl/ResourceDefinition.nb [\"a note for the reviewers\"] *)\n(* Submits the paclet to the Wolfram Language Paclet Repository, as Wolfram's submit-paclet action does - and with a note for\n   the reviewers where there is one (a test release says it is one), which that action cannot send *)\nPacletInstall[\"Wolfram/PacletCICD\"];\nNeeds[\"Wolfram`PacletCICD`\"];\nNeeds[\"ResourceSystemClient`\"];\nnb = AbsoluteFileName[$ScriptCommandLine[[2]]];\nnote = If[Length[$ScriptCommandLine] > 2, $ScriptCommandLine[[3]], \"\"];\n(* what the definition notebook's own submit dialog sets: the notes the submission carries to the reviewers *)\nIf[StringLength[note] > 0, ResourceSystemClient`Private`$localSubmissionNotes = note; Print[\"with a note for the reviewers: \", note]];\nresult = Symbol[\"Wolfram`PacletCICD`SubmitPaclet\"][File[nb], Symbol[\"Wolfram`PacletCICD`Private`PublisherToken\"] -> Environment[\"RESOURCE_PUBLISHER_TOKEN\"]];\nPrint[result];\nIf[FailureQ[result], Exit[1]];\n"
}
