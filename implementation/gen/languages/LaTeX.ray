/*
 * LATEX, for the arithmetic of terms: a Language like any other, for what an equation is written in.
 * A term is a Ray program over the symbols `s`; these rules say how each piece is set.
 */
LaTeX: Language = class {
  name = "LaTeX"
  extension = ".tex"

  {separator} => ", "
  {statement_end} => ""

  {(paramlist) => e} => "{e}"
  {a * b} => "{a} {b}"
  {a + b} => "{a} + {b}"
  {a - b} => "{a} - {b}"
  {(a) / (b)} => "\\frac{{{a}}}{{{b}}}"
  {(a) / b} => "\\frac{{{a}}}{{{b}}}"
  {a / (b)} => "\\frac{{{a}}}{{{b}}}"
  {a / b} => "\\frac{{{a}}}{{{b}}}"
  {a ^ (b)} => "{a}^{{{b}}}"
  {a ^ b} => "{a}^{{{b}}}"
  {(a)} => "\\paren{{{a}}}"
  {-a} => "-{a}"
  {s.ρ} => "\\rho"
  {s.β} => "\\beta"
  {s.ω} => "\\omega"
  {s.ν} => "\\nu"
  {s.σ} => "\\sigma"
  {s.Σ} => "\\Sigma"
  {s.n_f} => "n_{{f}}"
  {s.DEG} => "\\bar{{DEG}}"
  {s.F} => "F"
  {s.n} => "n"
  {s["∂t"]} => "\\partial_{{t}} n"
  {s["transport"]} => "\\hat{{d}} \\cdot \\nabla_{{x}} n"
  {s["drift"]} => "\\paren{{\\nabla n_{{f}}}} \\cdot \\nabla_{{\\hat{{d}}}} n"
  {s.δ} => "\\delta"
  {s.λ} => "\\lambda"
  {s.Φ} => "\\Phi"
  {s.r} => "r"
  {s.D} => "D"
  {s.L} => "L"
  {s.S} => "S"
  {s.v} => "v"
  {s.c} => "\\bar{{c}}"
  {s.Rb} => "\\bar{{R}}"
  {s.sigma_tr} => "\\sigma_{{tr}}"
  {s.rho_inf} => "\\rho_{{\\infty}}"
  {s.infty} => "\\infty"
  {x.ln} => "\\ln {x}"
  {Solve.root(s, nm, (paramlist) => e)} => "\\text{{the }} \\rho \\text{{ where }} {e} = 0"
  {s.nm} => "{nm}"
}
