/*
 * LEAN 4, as a mapping from the constructs of Ray to text. A Ray class is Lean data: every class hierarchy is one
 * Lean type (a `structure` over its object), a subclass an `abbrev` of its parent, a field a slot, a getter or a
 * method a function in the class's namespace (`Medium.tick (m : Medium) : IO Value`, `m.tick`) - see
 * implementation/gen/backends/cpu.rt.lean, where the declarations below (`ray_class`, `ray_field`, `ray_method`, ...)
 * are macros. A class's module declares nothing of its own: every member is written twice, as a declaration of its
 * type (a line `--@ ray_method ...`, gathered by `write_package` into OrbitMines/Physics/Types.lean, which every class
 * module imports - so a class calls another without importing it) and as its program (`ray_impl_method ...`, filling
 * the class's table when the package loads, in the class's own module). Lean itself works out what every member
 * access is: `get x "cells"`, `call! x "add" (h)`, `set x "tag" v` are type classes keyed by the member's name, so a
 * typed slot, a typed method, or - where Ray itself is dynamic (`*`, a `Program`, a member named by a computed text)
 * - a `Value` asked by name when it runs. Numbers are `Float`; lists `RList` (an `IO.Ref (Array _)`, since Ray shares
 * every list); `None` is each type's own absent value (`null`, `isNull`).
 *
 * Everything runs in `IO`: an expression is a term whose effects are written `(← ...)` (Lean lifts them in order to the
 * statement they stand in), a statement a line of a `do` block, a local an `IO.Ref` (`(← x_1.get)`, spelled by the depth
 * of the scope that binds it, `{local_name}`), so that a lambda can take it and write it. What must not run unless it
 * is reached (`a & b`, `a ?? b`, `c ? a : b`) is handed over as an action of its own (`(do pure ...)`). A statement
 * written as an expression is ended ` |> sink`, and a loop ends on a line `Value.null` of its own so that it can be.
 * A `return` is `if true then return x`, which Lean reads as a return from the enclosing method or lambda, loops
 * included, and never as dead code.
 */

Lean: Language = class {
  name = "Lean"
  extension = ".lean"

  {indent} => "  "
  {separator} => ", "
  {newline} => "\n"
  {statement_end} => " |> ωsink"
  {empty_block} => ""
  {interpolation} => "\" ++ (← ωtoStr {x}) ++ \""
  {named_arg} => "«{raw}» := {val}"
  {parameter} => "({nm} : {ty})"
  {parameter_untyped} => "{nm}"
  {parameter_default} => "({nm} : {ty} := {val})"
  {parameter_separator} => " "
  {dynamic_get} => "(← ωelem {tgt} {key})"
  {dynamic_set} => "(← (ωatSetter {tgt} {key}) {val})"
  {whole} => "({val} : Float)"
  {reserved_names} => "at by do else end fun if in let match then with from have show for return where open namespace section def theorem structure class instance import mut unless try catch finally break continue repeat while macro syntax deriving extends variable universe example abbrev axiom opaque private protected partial unsafe noncomputable inductive mutual export attribute local scoped set_option calc suffices obtain nomatch termination_by decreasing_by Type Prop Sort forall exists fun this self ωsink"
  {escaped_name} => "{nm}_"
  {global_name} => "(← ωglobal_{nm})"
  {local_name} => "{nm}_{k}"
  {local_read} => "(← {nm}.get)"
  {local_write} => "(← ωwr {nm} {val})"
  {defaults_in_body} => "yes"
  {class_ref} => "(← cls% {nm})"
  {field_assign} => "ray_default \"{nm}\" := do\n  return {val}"

  /* control flow: a body is closed by `pure ()`, so that one ending on a definition is still a block */
  {if cond { yesbody } else { nobody }} => "if ωtruthy {cond} then\n{yesbody.indent}\n  pure ()\nelse\n{nobody.indent}\n  pure ()"
  {if cond { yesbody }} => "if ωtruthy {cond} then\n{yesbody.indent}\n  pure ()"
  {unless cond { yesbody }} => "if !ωtruthy {cond} then\n{yesbody.indent}\n  pure ()"
  {while cond { loopbody }} => "while ωtruthy {cond} do\n{loopbody.indent}\n  pure ()"
  /* `if true`: a body always ends `return null`, which Lean would otherwise call dead code */
  {return val} => "if true then return {val}"
  {return} => "if true then return ωnull"
  {dynamically assert cond} => "if !ωtruthy {cond} then throw (IO.userError {cond.quoted})"

  /* definitions and assignment: a local takes the type of what it is made of - and a lambda is made before it is set, so that it may call itself by it */
  {nm := val} => "let {nm} ← IO.mkRef {val}"
  {nm := (paramlist) => { stmts }} => "let {nm} ← IO.mkRef ωnull\n{nm}.set (fn! [{paramlist}] do\n{stmts.returned.indent.indent}\n    return ωnull)"
  {nm := (paramlist) => e} => "let {nm} ← IO.mkRef ωnull\n{nm}.set (fn! [{paramlist}] do\n    return {e})"
  {tgt.nm = rhs} => "(ωsetter {tgt} \"{nm.raw}\") {rhs}"
  {lhs = rhs} => "(← ωwr {lhs} {rhs}) |> ωsink"
  {tgt[k] = rhs} => "(ωatSetter {tgt} {k}) {rhs}"

  /* expressions: every one is a term, parenthesised or a single word */
  {a & b} => "(← ωandV {a} (do pure {b}))"
  {a | b} => "(← ωorV {a} (do pure {b}))"
  {!a} => "(ωnotV {a})"
  {-a} => "(← ωneg {a})"
  {a == None} => "(ωisNull {a})"
  {a != None} => "(!ωisNull {a})"
  {a == b} => "(← ωeqv {a} {b})"
  {a != b} => "(← ωnev {a} {b})"
  {a < b} => "(← ωlt {a} {b})"
  {a <= b} => "(← ωle {a} {b})"
  {a > b} => "(← ωgt {a} {b})"
  {a >= b} => "(← ωge {a} {b})"
  {a + b} => "(← ωadd {a} {b})"
  {a - b} => "(← ωsub {a} {b})"
  {a * b} => "(← ωmul {a} {b})"
  {a / b} => "(← ωdiv {a} {b})"
  {a % b} => "(← ωmodv {a} {b})"
  {a ^ b} => "(← ωpow {a} {b})"
  {a ?? b} => "(← ωorElse {a} (do pure {b}))"
  {cond ? a : b} => "(← ωtern (ωtruthy {cond}) (do pure {a}) (do pure {b}))"
  {a ==.instance_of Array} => "(← ωinstOf (ωtoValue {a}) \"Array\")"
  {a ==.instance_of ty} => "(← ωinstOf (ωtoValue {a}) \"{ty}\")"
  {a as ty} => "({a} : {ty})"
  {tgt.nm} => "(← ωget {tgt} \"{nm.raw.method}\")"
  {tgt?.nm} => "(← ωgetOpt {tgt} \"{nm.raw.method}\")"
  {tgt.nm()} => "(← ωget {tgt} \"{nm.raw.method}\")"
  {tgt.nm(arglist)} => "(← call! {tgt} \"{nm.raw.method}\" ({arglist}))"
  {tgt?.nm(arglist)} => "(← callOpt! {tgt} \"{nm.raw.method}\" ({arglist}))"
  {tgt.choose("nm")} => "(← ωget {tgt} \"choose {nm}\")"
  {tgt[k]} => "(← ωelem {tgt} {k})"
  {fn(arglist)} => "(← app! {fn} ({arglist}))"
  {Class(arglist)} => "(← new! {Class} ({arglist}))"
  {[elems]} => "(← ωlst #[{elems}])"
  { {} } => "(← RMap.new)"
  {this} => "self"
  {None} => "ωnull"
  {true} => "true"
  {false} => "false"
  {"txt"} => "(\"{txt}\" : String)"
  {(paramlist) => { stmts }} => "(fn! [{paramlist}] do\n{stmts.returned.indent}\n  return ωnull)"
  {(paramlist) => e} => "(fn! [{paramlist}] do\n  return {e})"
  {xs#} => "(← ωmany {xs})"
  {draw([ws], [os])} => "(← call! (← ωget (← ωget self \"vertex\") \"world\") \"draw\" ((← ωlst #[{ws}]), (← ωlst #[{os}])))"

  /* the recognised classes: a list, a text or a number's own member (`rmap`) - and a class's own member of that name, which its declaration also names so */
  {Array.range(cnt).for((x_) => { stmts })} => "for i{d} in [0:ωrangeN {cnt}] do\n  let {x_.bare} ← IO.mkRef (ωnatF i{d})\n{stmts.indent}\n  pure ()\nValue.null"
  {xs.for((x_) => { stmts })} => "for e{d} in (← ωitems {xs}) do\n  let {x_.bare} ← IO.mkRef e{d}\n{stmts.indent}\n  pure ()\nValue.null"
  {fail(x_)} => "(← ωfailV {x_})"
  {Catalogue.number(x_)} => "(ωparseNumber (← ωtoStr {x_}))"
  {String(chars: xs)} => "(← ωfromCodepoints {xs})"
  {x_.blank} => "(← dot! {x_} rblank ())"
  {xs.push(x_)} => "(← dot! {xs} rpush ({x_}))"
  {xs.chars} => "(← dot! {xs} rchars ())"
  {xs.pop} => "(← dot! {xs} rpop ())"
  {xs.length} => "(← dot! {xs} rlength ())"
  {xs.map(f)} => "(← dot! {xs} rmap ({f}))"
  {xs.filter(f)} => "(← dot! {xs} rfilter ({f}))"
  {xs.for(f)} => "(← dot! {xs} rfor ({f}))"
  {xs.some(f)} => "(← dot! {xs} rsome ({f}))"
  {xs.every(f)} => "(← dot! {xs} revery ({f}))"
  {xs.reduce(z, f)} => "(← dot! {xs} rreduce ({z}, {f}))"
  {xs.starts_with(x_)} => "(← dot! {xs} rstarts_with ({x_}))"
  {xs.ends_with(x_)} => "(← dot! {xs} rends_with ({x_}))"
  {xs.replace(x_, y_)} => "(← dot! {xs} rreplace ({x_}, {y_}))"
  {xs.split(x_)} => "(← dot! {xs} rsplit ({x_}))"
  {xs.trim} => "(← dot! {xs} rtrim ())"
  {xs.upper} => "(← dot! {xs} rupper ())"
  {xs.lower} => "(← dot! {xs} rlower ())"
  {xs.lines} => "(← dot! {xs} rlines ())"
  {xs.quoted} => "(← dot! {xs} rquoted ())"
  {xs.contains(x_)} => "(← dot! {xs} rcontains ({x_}))"
  {xs.index_of(x_)} => "(← dot! {xs} rindex_of ({x_}))"
  {xs.join(sep)} => "(← dot! {xs} rjoin ({sep}))"
  {xs.first} => "(← dot! {xs} rfirst ())"
  {xs.last} => "(← dot! {xs} rlast ())"
  {xs.empty} => "(← dot! {xs} rempty ())"
  {xs.take(cnt)} => "(← dot! {xs} rtake ({cnt}))"
  {xs.drop(cnt)} => "(← dot! {xs} rdrop ({cnt}))"
  {xs.rest} => "(← dot! {xs} rrest ())"
  {xs.concat(ys)} => "(← dot! {xs} rconcat ({ys}))"
  {xs.reverse} => "(← dot! {xs} rreverse ())"
  {xs.sum} => "(← dot! {xs} rsum ())"
  {xs.most(f)} => "(← dot! {xs} rmost ({f}))"
  {xs.sorted_by(f)} => "(← dot! {xs} rsorted_by ({f}))"
  {xs.each} => "(← dot! {xs} reach ())"
  {Array.range(cnt)} => "(← ωrrange {cnt})"
  {Array.filled(cnt, x_)} => "(← ωrfilled {cnt} {x_})"
  {x_.sqrt} => "(← dot! {x_} rsqrt ())"
  {x_.floor} => "(← dot! {x_} rfloor ())"
  {x_.abs} => "(← dot! {x_} rabs ())"
  {x_.negated} => "(← ωneg {x_})"
  {x_.magnitude} => "(← dot! {x_} rmagnitude ())"
  {x_.cos} => "(← dot! {x_} rcos ())"
  {x_.sin} => "(← dot! {x_} rsin ())"
  {x_.round} => "(← dot! {x_} rround ())"
  {x_.ln} => "(← dot! {x_} rln ())"
  {x_.exp} => "(← dot! {x_} rexp ())"
  {x_.atan2(y_)} => "(← dot! {x_} ratan2 ({y_}))"
  {x_.pow(y_)} => "(← dot! {x_} rpow ({y_}))"
  {Real.of(x_)} => "{x_}"
  {Real.ZERO} => "(0 : Float)"
  {Real.ONE} => "(1 : Float)"
  {Real.TWO} => "(2 : Float)"
  {Real.PI} => "(3.141592653589793 : Float)"
  {Real.NAN} => "(0.0 / 0.0 : Float)"
  {Real.INFINITY} => "(1.0 / 0.0 : Float)"
  {Real.TAU} => "(6.283185307179586 : Float)"
  {Random.MODULUS} => "(4294967296 : Float)"
  {Random.MULTIPLIER} => "(1664525 : Float)"
  {Random.INCREMENT} => "(1013904223 : Float)"

  /* types: a number is a Float; a list an RList; `*`, a program and a list of anything a Value; a map an RMap */
  {N} => "Float"
  {Natural} => "Float"
  {Z} => "Float"
  {Integer} => "Float"
  {Real} => "Float"
  {Decimal} => "Float"
  {boolean} => "Bool"
  {String} => "String"
  {Array} => "(RList Value)"
  {*} => "Value"
  {{}} => "RMap"
  {Program} => "Value"
  {ty[]} => "(RList {ty})"
  {ty[]?} => "(RList {ty})"
  {ty?} => "{ty}"

  /*
   * classes: `ray_class` (a line of Types.lean) and a namespace of the class's own programs. Every member is a line
   * `--@ ...` of Types.lean - its declaration - and its program; `write_package` parts the two
   */
  {nm := class < sup { membs }} => "/-@@PIECE@@-/\n--@ ray_class {nm.raw} < {sup.first}\n--@ namespace {nm.raw}\nnamespace {nm.raw}\n{membs}\nend {nm.raw}\n--@ end {nm.raw}"
  {nm := class { membs }} => "/-@@PIECE@@-/\n--@ ray_class {nm.raw} < Node\n--@ namespace {nm.raw}\nnamespace {nm.raw}\n{membs}\nend {nm.raw}\n--@ end {nm.raw}"
  {nm: ty = class { membs }} => "/-@@PIECE@@-/\n--@ ray_class {nm.raw} < {ty}\n--@ namespace {nm.raw}\nnamespace {nm.raw}\n{membs}\nend {nm.raw}\n--@ end {nm.raw}\n--@ ray_theory {nm.raw}"
  {theorem "nm" () => tbody} => "--@ ray_sfield \"theorem {nm}\" : Theorem\nray_impl_sfield \"theorem {nm}\" : Theorem := do\n  return (← new! Theorem (id := {nm.quoted}, body := (fn! [] do\n{tbody.returned.indent.indent}\n    return ωnull)))"
  {x_.body()} => "(← app! (← ωget {x_} \"body\") ())"
  {nm: ty = val} => "--@ ray_field \"{nm.raw}\" : {ty}\nray_impl_field \"{nm.raw}\" : {ty} := do\n  return {val}"
  {nm: ty} => "--@ ray_field \"{nm.raw}\" : {ty}\nray_impl_field \"{nm.raw}\" : {ty} := do\n  return ωnull"
  {nm = val} => "--@ ray_sfield \"{nm.raw}\" : Value\nray_impl_sfield \"{nm.raw}\" : Value := do\n  return {val}"
  {static nm: ty = val} => "--@ ray_sfield \"{nm.raw}\" : {ty}\nray_impl_sfield \"{nm.raw}\" : {ty} := do\n  return {val}"
  {static nm = val} => "--@ ray_sfield \"{nm.raw}\" : Value\nray_impl_sfield \"{nm.raw}\" : Value := do\n  return {val}"
  {nm (): ret => mbody} => "--@ ray_getter \"{nm.raw.method}\" : {ret}\nray_impl_getter \"{nm.raw.method}\" : {ret} := do\n{mbody.returned.indent}\n  return ωnull"
  {nm () => mbody} => "--@ ray_getter \"{nm.raw.method}\" : Value\nray_impl_getter \"{nm.raw.method}\" : Value := do\n{mbody.returned.indent}\n  return ωnull"
  {static nm (): ret => mbody} => "--@ ray_static \"{nm.raw.method}\" : {ret}\nray_impl_static \"{nm.raw.method}\" : {ret} := do\n{mbody.returned.indent}\n  return ωnull"
  {static nm () => mbody} => "--@ ray_static \"{nm.raw.method}\" : Value\nray_impl_static \"{nm.raw.method}\" : Value := do\n{mbody.returned.indent}\n  return ωnull"
  {nm (paramlist): ret => mbody} => "--@ ray_method \"{nm.raw.method}\" {paramlist} : {ret}\nray_impl_method \"{nm.raw.method}\" {paramlist} : {ret} := do\n{mbody.returned.indent}\n  return ωnull"
  {nm (paramlist) => mbody} => "--@ ray_method \"{nm.raw.method}\" {paramlist} : Value\nray_impl_method \"{nm.raw.method}\" {paramlist} : Value := do\n{mbody.returned.indent}\n  return ωnull"
  {static nm (paramlist): ret => mbody} => "--@ ray_static \"{nm.raw.method}\" {paramlist} : {ret}\nray_impl_static \"{nm.raw.method}\" {paramlist} : {ret} := do\n{mbody.returned.indent}\n  return ωnull"
  {static nm (paramlist) => mbody} => "--@ ray_static \"{nm.raw.method}\" {paramlist} : Value\nray_impl_static \"{nm.raw.method}\" {paramlist} : Value := do\n{mbody.returned.indent}\n  return ωnull"
  {nm (paramlist): ret} => "--@ ray_method \"{nm.raw.method}\" {paramlist} : {ret}"
  {nm (paramlist)} => "--@ ray_method \"{nm.raw.method}\" {paramlist} : Value"
  {nm (): ret} => "--@ ray_getter \"{nm.raw.method}\" : {ret}"
  {nm ()} => "--@ ray_getter \"{nm.raw.method}\" : Value"
  {static nm (paramlist): ret} => "--@ ray_static \"{nm.raw.method}\" {paramlist} : {ret}"
  {static nm (paramlist)} => "--@ ray_static \"{nm.raw.method}\" {paramlist} : Value"
  /* a rule of a theory: a `Rule` - its id, name and rate, what it is over, and its body, a program of what it matches - kept, in order, as the theory's `rules` */
  {rule /rid "nm" | rt () => rbody} => "--@ ray_sfield \"rule {rid}\" : Rule\nray_impl_sfield \"rule {rid}\" : Rule := do\n  return (← new! Rule (id := \"/{rid}\", name := {nm.quoted}, rate := {rt.quoted}, over := {over.quoted}, single := {single}, «where» := {where}, source := {source}, body := (fn! [] do\n{rbody.returned.indent.indent}\n    return ωnull)))"
  {rule /rid "nm" () => rbody} => "--@ ray_sfield \"rule {rid}\" : Rule\nray_impl_sfield \"rule {rid}\" : Rule := do\n  return (← new! Rule (id := \"/{rid}\", name := {nm.quoted}, rate := ωnull, over := {over.quoted}, single := {single}, «where» := {where}, source := {source}, body := (fn! [] do\n{rbody.returned.indent.indent}\n    return ωnull)))"
  {rule /rid "nm" | rt (paramlist) => rbody} => "--@ ray_sfield \"rule {rid}\" : Rule\nray_impl_sfield \"rule {rid}\" : Rule := do\n  return (← new! Rule (id := \"/{rid}\", name := {nm.quoted}, rate := {rt.quoted}, over := {over.quoted}, single := {single}, «where» := {where}, source := {source}, body := (fn! [{paramlist}] do\n{rbody.returned.indent.indent}\n    return ωnull)))"
  {rule /rid "nm" (paramlist) => rbody} => "--@ ray_sfield \"rule {rid}\" : Rule\nray_impl_sfield \"rule {rid}\" : Rule := do\n  return (← new! Rule (id := \"/{rid}\", name := {nm.quoted}, rate := ωnull, over := {over.quoted}, single := {single}, «where» := {where}, source := {source}, body := (fn! [{paramlist}] do\n{rbody.returned.indent.indent}\n    return ωnull)))"
  {choose "nm" (paramlist): ret} => "--@ ray_method \"choose {nm}\" {paramlist} : {ret}"
  {choose "nm" (paramlist): ret => cbody} => "--@ ray_method \"choose {nm}\" {paramlist} : {ret}\nray_impl_method \"choose {nm}\" {paramlist} : {ret} := do\n{cbody.returned.indent}\n  return ωnull"
  {choose "nm" (paramlist) => cbody} => "--@ ray_method \"choose {nm}\" {paramlist} : Value\nray_impl_method \"choose {nm}\" {paramlist} : Value := do\n{cbody.returned.indent}\n  return ωnull"
  {as (=== ty) => cbody} => "--@ ray_getter \"as_{ty}\" : Value\nray_impl_getter \"as_{ty}\" : Value := do\n{cbody.returned.indent}\n  return ωnull"

  /* a nested class is a class of its own (`Boundary.Initial(...)` makes an `Initial`) */
  nested (outer: String, inner_name: String, inner: String): String => inner

  /* a top-level definition: made on first read, its type Lean's own reading of it */
  constant (nm: String, text: String): String => "ray_global {nm} := do\n  return {text}"

  /* the equation of a theory, as data: every term a map of its parts, each share a program of the symbols */
  term_literal (id: String, rate: String, degree: N, outside: boolean, settles: boolean, transport: boolean, share: String, rays: String, space: String, folds: String, share_source: String, rays_source: String, space_source: String, folds_source: String, rule_name: String, over: String, where_source: String, rule_source: String, leans: String, carries: boolean, sets: boolean, turned: String, asked: String, asked_source: String, around: String, around_source: String, grown: boolean, grew: String, grew_source: String, trades: boolean, grew_apart: String, grew_apart_source: String): String => {
    rate_ := rate.empty ? "Value.null" : "(Value.str {rate.quoted})"
    where := where_source.empty ? "Value.null" : "(← ωnode #[(\"source\", Value.str {where_source.quoted})])"
    rule := id.empty ? "Value.null" : "(← ωnode #[(\"id\", Value.str {id.quoted}), (\"rate\", {rate_}), (\"name\", Value.str {rule_name.quoted}), (\"over\", Value.str {over.quoted}), (\"where\", {where}), (\"source\", Value.str {rule_source.quoted})])"
    leans_ := leans.empty ? "Value.null" : "(Value.str {leans.quoted})"
    "    (← ωnode #[(\"rule\", {rule}), (\"rate\", {rate_}), (\"degree\", Value.num {degree}), (\"outside\", Value.bool {outside}), (\"settles\", Value.bool {settles}), (\"transport\", Value.bool {transport}), (\"leans\", {leans_}), (\"turned\", Value.str {turned.quoted}), (\"doing\", (← ωnode #[(\"carries\", Value.bool {carries}), (\"sets\", Value.bool {sets}), (\"grown\", Value.bool {grown}), (\"trades\", Value.bool {trades}), (\"grew\", (← ωshare {grew_source.quoted} (fun (s : Value) => do return toValue {grew}))), (\"grew_apart\", (← ωshare {grew_apart_source.quoted} (fun (s : Value) => do return toValue {grew_apart}))), (\"draws\", Value.null), (\"needs\", Value.num {degree}), (\"outside\", Value.bool {outside}), (\"settles\", Value.bool {settles}), (\"share\", (← ωshare {share_source.quoted} (fun (s : Value) => do return toValue {share}))), (\"asked\", (← ωshare {asked_source.quoted} (fun (s : Value) => do return toValue {asked}))), (\"around\", (← ωshare {around_source.quoted} (fun (s : Value) => do return toValue {around}))), (\"rays\", (← ωshare {rays_source.quoted} (fun (s : Value) => do return toValue {rays}))), (\"space\", (← ωshare {space_source.quoted} (fun (s : Value) => do return toValue {space}))), (\"folds\", (← ωshare {folds_source.quoted} (fun (s : Value) => do return toValue {folds})))]))])"
  }
  equation_literal (theory: String, latex: String, terms: String[]): String => {
    lines := terms.join(",\n")
    "namespace {theory}\ninitialize ωtheoryFill ωname (fun o => do\n  ωwriteSlot o (← ωmemberIndex o.cls \"equation\") \"equation\" (← ωnode #[(\"latex\", Value.str {latex.quoted}), (\"terms\", toValue (← lst #[\n{lines}\n  ]))]))\nend {theory}"
  }

  /* what every class module opens with */
  prologue (): String => "-- GENERATED by `npx ray gen` from implementation/physics.ray - do not edit\nimport OrbitMines.Physics.Globals\nset_option linter.unusedVariables false\nset_option autoImplicit false\nset_option maxHeartbeats 0\nset_option maxRecDepth 100000\nnamespace OrbitMines.Physics\n"

  /* a class this package does not carry but a type or a program names (`Equation`): the types and makings of the class modules */
  missing (types: String, parts: String, known: String[]): String[] => {
    words := []
    types.split("\n").for(l => {
      /* past the member's name: what its parameters and its result are */
      pieces := l.split("\"")
      if pieces.length >= 3 { words = words.concat(pieces.drop(2).join(" ").replace("(", " ").replace(")", " ").replace(":", " ").replace("=", " ").split(" ")) }
    })
    parts.split("new! ").drop(1).for(p => { words.push(p.split(" ").first) })
    parts.split("cls% ").drop(1).for(p => { words.push(p.split(")").first.split(" ").first) })
    builtin := ["Node", "Float", "Bool", "String", "Value", "RList", "RMap", "IO", "Unit", "Many", "Obj", "Nat", "Cls", "Array"]
    out := []
    words.for(w => {
      c := w.chars
      upper := c.length > 0 & c[0] >= 65 & c[0] <= 90
      plain := c.every(k => (k >= 48 & k <= 57) | (k >= 65 & k <= 90) | (k >= 97 & k <= 122) | k == 95)
      /* a parameter is a local, spelled with the depth of its scope (`D_0`): not a type */
      local := w.contains("_") & c.length > 0 & c[c.length - 1] >= 48 & c[c.length - 1] <= 57
      out.push(w) if upper & plain & !local & !known.contains(w) & !builtin.contains(w) & !out.contains(w)
    })
    out
  }

  /*
   * THE PACKAGE: the runtime; Types.lean, every class's declarations (the lines `--@ ` of the emitted text, in order) -
   * what every module stands on, so that a class calls another without importing it; Globals.lean, the top-level
   * definitions; one module a class (the text is split where a class begins) holding the class's programs; and the
   * module that imports them all
   */
  write_package (code: String) => {
    pieces := code.split("/-@@PIECE@@-/").filter(p => p.trim != "")
    globals := pieces.last
    classes := pieces.take(pieces.length - 1)
    heads := []
    types := []
    parts := []
    known := ["Iterable", "Ordered"]
    classes.for(p => {
      lines := p.split("\n")
      /* a program's type is a Value where Ray writes one no rule names (`(played: Played?) => Unrolling`) */
      decl := lines.filter(l => l.starts_with("--@ ")).map(l => l.drop(4).replace("((...args: any[]) => any)", "Value"))
      /* every class first, so that a member may name a class declared after its own */
      heads.push(decl.filter(l => l.starts_with("ray_class ")).join("\n"))
      decl.filter(l => l.starts_with("ray_class ")).for(l => { known.push(l.split(" ")[1]) })
      body := decl.filter(l => !l.starts_with("ray_class "))
      /* a member written twice (a part and a field of the same name): the later one stands */
      keys := body.map(l => l.split(" : ").first)
      kept := Array.range(body.length).filter(i => !keys.drop(i + 1).contains(keys[i])).map(i => body[i])
      types.push(kept.join("\n"))
      parts.push(lines.filter(l => !l.starts_with("--@ ")).join("\n").replace("((...args: any[]) => any)", "Value"))
    })
    missing := Lean.missing(types.join("\n"), parts.join("\n"), known)
    stubs := missing.map(m => "ray_missing {m}").join("\n")
    classes_ := heads.join("\n")
    declared := types.join("\n\n")
    @./languages/physics.lean/OrbitMines/Physics/Types.lean := "-- GENERATED by `npx ray gen` from implementation/physics.ray - do not edit\n-- Every class of the package and every member of it, as Lean types: what every class module stands on.\nimport OrbitMines.Physics.Runtime\nset_option linter.unusedVariables false\nset_option autoImplicit false\nset_option maxHeartbeats 0\nset_option maxRecDepth 100000\nnamespace OrbitMines.Physics\n\nray_missing Node\n{stubs}\nray_class Iterable < Node\nray_class Ordered < Node\n{classes_}\n\n{declared}\n\nend OrbitMines.Physics\n"
    @./languages/physics.lean/OrbitMines/Physics/Globals.lean := "-- GENERATED by `npx ray gen` from implementation/physics.ray - do not edit\n-- The top-level definitions (the named lattices, ...): each made on first read.\nimport OrbitMines.Physics.Types\nset_option linter.unusedVariables false\nset_option autoImplicit false\nset_option maxHeartbeats 0\nset_option maxRecDepth 100000\nnamespace OrbitMines.Physics\n\n{globals}\n\nend OrbitMines.Physics\n"
    Array.range(parts.length).for(i => {
      @./languages/physics.lean/OrbitMines/Physics/Part{i}.lean := "{Lean.prologue}\n{parts[i]}\n\nend OrbitMines.Physics\n"
    })
    imports := Array.range(parts.length).map(i => "import OrbitMines.Physics.Part{i}").join("\n")
    @./languages/physics.lean/OrbitMines/Physics/Runtime.lean := @./implementation/gen/backends/cpu.rt.lean
    @./languages/physics.lean/OrbitMines/Physics.lean := "-- GENERATED by `npx ray gen` from implementation/physics.ray - do not edit\n/-\n  OrbitMines.Physics - the physics core and the theories, emitted from implementation/physics.ray. Every Ray class is\n  a Lean type (`Medium`, `Hole`, ...) and every member a function of it (`m.tick`, `h.mass`); a theory is its one\n  object (`← cls% G`). See Runtime.lean for how, and Types.lean for every class and member.\n-/\nimport OrbitMines.Physics.Runtime\nimport OrbitMines.Physics.Types\nimport OrbitMines.Physics.Globals\n{imports}\nimport OrbitMines.Physics.Theorems\n"
    @./languages/physics.lean/README.md := this.readme
    @./languages/physics.lean/lakefile.toml := "# GENERATED by `npx ray gen` from implementation/physics.ray - do not edit\nname = \"orbitmines-physics\"\nversion = \"{Release.semver}\"\ndefaultTargets = [\"OrbitMines\"]\n\n# the theorems (OrbitMines.Physics.Proofs) are checked with Mathlib; the runtime (OrbitMines.Physics) imports none of it\n[[require]]\nname = \"mathlib\"\ngit = \"https://github.com/leanprover-community/mathlib4\"\nrev = \"v4.34.1\"\n\n[[lean_lib]]\nname = \"OrbitMines\"\nroots = [\"OrbitMines.Physics\", \"OrbitMines.Physics.Proofs\"]\n"
    @./languages/physics.lean/lean-toolchain := "leanprover/lean4:v4.34.1\n"
    @./languages/physics.lean/.gitignore := "/.lake\n"
  }

  /* a case: the fixture, ticked until its refinement holds (by name, as a fixture of a kind with no `tick` is not ticked), then the requirement */
  test_case (r: Requirement, f: Fixture): String => {
    definition := f.definition.as(Lean)
    requirement := r.requirement.as(Lean)
    filter := r.filter == None ? "true" : r.filter.as(Lean)
    label := "{r.location} on {f.name}"
    "initialize addTest {label.quoted} (do\n  let it := {definition}\n  let mut guard := 0\n  while !truthy {filter} do\n    guard := guard + 1\n    if guard > {r.until} || !(← ωhas (toValue it) \"tick\") then return \"skip\"\n    sink (← (toValue it).dynGet \"tick\")\n  return (if truthy {requirement} then \"pass\" else \"failed: \" ++ {requirement.quoted}))"
  }

  write_tests (cases: String, fixtures: Fixture[]) => {
    @./tests/lean/TestG.lean := "-- GENERATED by `npx ray gen` from implementation/physics.ray - do not edit\n-- lake build && .lake/build/bin/testg [filter]\nimport OrbitMines.Physics\nset_option linter.unusedVariables false\nset_option autoImplicit false\nset_option maxHeartbeats 0\nset_option maxRecDepth 100000\nopen OrbitMines.Physics\n\ninitialize testsRef : IO.Ref (Array (String × IO String)) ← IO.mkRef #[]\ndef addTest (name : String) (body : IO String) : IO Unit := testsRef.modify (·.push (name, body))\n\n{cases}\n\ndef main (args : List String) : IO UInt32 := do\n  let only := args.head?\n  let mut passed := 0\n  let mut failed := 0\n  let mut skipped := 0\n  for (name, body) in (← testsRef.get) do\n    if let some o := only then\n      if (strFind name o).isNone then continue\n    let t0 ← IO.monoNanosNow\n    let got ← try body catch e => pure (\"error: \" ++ toString e)\n    let t1 ← IO.monoNanosNow\n    let secs := fixed2 ((t1 - t0).toFloat / 1e9)\n    if got == \"pass\" then\n      passed := passed + 1\n      IO.println (\"ok   \" ++ name ++ \" (\" ++ secs ++ \" s)\")\n    else if got == \"skip\" then\n      skipped := skipped + 1\n      IO.println (\"skip \" ++ name ++ \" (\" ++ secs ++ \" s)\")\n    else\n      failed := failed + 1\n      IO.println (\"FAIL \" ++ name ++ \" (\" ++ secs ++ \" s) - \" ++ got)\n    (← IO.getStdout).flush\n  IO.println (toString passed ++ \" passed, \" ++ toString failed ++ \" failed, \" ++ toString skipped ++ \" skipped\")\n  return (if failed > 0 then 1 else 0)\n"
    @./tests/lean/lakefile.toml := "# GENERATED by `npx ray gen` from implementation/physics.ray - do not edit\nname = \"orbitmines-physics-tests\"\ndefaultTargets = [\"testg\"]\n\n[[require]]\nname = \"orbitmines-physics\"\npath = \"../../languages/physics.lean\"\n\n[[lean_exe]]\nname = \"testg\"\nroot = \"TestG\"\n"
    @./tests/lean/lean-toolchain := "leanprover/lean4:v4.34.1\n"
    @./tests/lean/.gitignore := "/.lake\n"
  }

  /* Lean renders no films: the .ray/TypeScript pipeline records them */
  {visual "nm" () => vbody} => ""
  write_visuals (entries: String) => { }
  write_notation () => { }

  /* every theorem, as one JSON text: `OrbitMines.Physics.Theorems.json` */
  write_theorems (proofs: String) => {
    @./languages/physics.lean/OrbitMines/Physics/theorems.json := "{{{proofs}}}"
    @./languages/physics.lean/OrbitMines/Physics/Theorems.lean := "-- GENERATED by `npx ray gen` from implementation/physics.ray - do not edit\nnamespace OrbitMines.Physics.Theorems\n\n/-- what the rules come to, as something to look up: every theorem, keyed by theory and then by question, as JSON -/\ndef json : String := include_str \"theorems.json\"\n\nend OrbitMines.Physics.Theorems\n"
  }

  /*
   * THE THEOREMS, CHECKED BY LEAN (gen/Derivation.ray is the language-neutral half). Every theorem is a module of its own in
   * the physics package itself (OrbitMines.Physics.Proofs.<theory>.<id>), so whoever requires the package can import and build
   * on them; they stand on Mathlib, which the runtime (OrbitMines.Physics) never imports. In a
   * module, every name of the derivation is a real number the theorem holds for ALL values of; what the prover takes from
   * the rules is a field of `Premises`, every step Lean does not check a field of `Unchecked` (named
   * `unchecked_<theorem>_<k>`, with the reason), and every step Lean does check a `theorem check_<k>` proved from them by
   * Mathlib's algebra. `answer` is the theorem: the premises and the unchecked steps give the concluded line. Nothing is an
   * axiom and nothing is a `sorry`: a step taken without proof is a hypothesis, stated, and never presented as proven (an
   * axiom stating a step for every value of its names would contradict itself the moment one value fails it).
   */
  write_proofs (theory: Theory) => {
    ds := Derivations.of(theory)
    files := ds.map(d => Theorems.id_of(d.theorem_id))
    Array.range(ds.length).for(i => {
      @./languages/physics.lean/OrbitMines/Physics/Proofs/{theory.name}/{files[i]}.lean := Lean.proof_module(ds[i])
    })
    imports := files.map(f => "import OrbitMines.Physics.Proofs.{theory.name}.{f}").join("\n")
    @./languages/physics.lean/OrbitMines/Physics/Proofs/Basic.lean := Lean.proof_basic
    @./languages/physics.lean/OrbitMines/Physics/Proofs.lean := "-- GENERATED by `npx ray gen` from implementation/physics.ray and implementation/gen - do not edit\nimport OrbitMines.Physics.Proofs.Basic\n{imports}\n\n/-! Every theorem of {theory.name}, stated for Lean and checked where it is algebra: see THEOREMS.md. -/\n"
    @./languages/physics.lean/THEOREMS.md := Lean.proof_readme(theory, ds)
  }

  /* what every module stands on: Mathlib's reals and algebra, and the few names a derivation uses that the algebra cannot see into */
  proof_basic (): String => "-- GENERATED by `npx ray gen` from implementation/gen/languages/Lean.ray - do not edit\nimport Mathlib.Analysis.SpecialFunctions.Pow.Real\nimport Mathlib.Analysis.SpecialFunctions.Sqrt\nimport Mathlib.Tactic.Ring\nimport Mathlib.Tactic.FieldSimp\nimport Mathlib.Tactic.Linarith\n\n/-!\n# The vocabulary the derivations are stated in\n\nA derivation's names are real numbers. What the prover writes that is not arithmetic is a function or a predicate\nLean knows nothing about (`opaque`): a proof may use that it IS a function - equal arguments, equal values - and\nnothing else, so a check that goes through goes through for every meaning these could have.\n-/\n\nnamespace OrbitMines.Physics.Proofs\n\n/-- a call the prover carries by name (`l.choose`, `\\sum_{{x}}`, `l.reach`): a function of its argument, and nothing more -/\nopaque Fn : String → ℝ → ℝ\n/-- the gradient of a quantity -/\nopaque Grad : ℝ → ℝ\n/-- a count of choices, carried as it is -/\nopaque Choose : ℝ → ℝ → ℝ\n/-- the upper incomplete gamma function, carried as it is -/\nopaque GammaInc : ℝ → ℝ → ℝ\n/-- `the x where f x = 0`, as the prover writes a balance with no closed form (it finds one by bisection when it needs a number) -/\nopaque RootOf : (ℝ → ℝ) → ℝ\n/-- the limit of `f x` as `x` goes to infinity -/\nopaque LimitAtInfinity : (ℝ → ℝ) → ℝ\n/-- `x is conserved on its way out` -/\nopaque Conserved : String → Prop\n/-- `x goes every way alike` -/\nopaque Isotropic : String → Prop\n/-- `x grows as f` -/\nopaque GrowsAs : String → ℝ → Prop\n/-- `x is pushed back at a` -/\nopaque RestoredAt : String → ℝ → Prop\n/-- `x > 0`, as the prover's vocabulary has it -/\nopaque Positive : String → Prop\n/-- a line carried as its text, where the prover's record has no expression for it -/\nopaque Stated : String → Prop\n\nend OrbitMines.Physics.Proofs\n\n/-- what a check is left with once the claims it stands on are put in: the settled numbers and the earlier line\nsubstituted, then the algebra of a field (`ring`, `field_simp`), under binders too (`ring_nf`) -/\nmacro \"check_algebra\" : tactic => `(tactic| (first | done | (subst_vars; (try simp only [Real.one_rpow, Real.rpow_one, Real.rpow_zero] at *); first | done | rfl | ring1 | (ring_nf; done) | (field_simp; done) | (field_simp; ring1) | ((try ring_nf at *); field_simp; done) | ((try ring_nf at *); field_simp; ring1) | (congr 1; funext; ring1))))\n"

  /* a name of a derivation as a Lean identifier: written as the page writes it, between « » */
  proof_name (s: String): String => {
    t := s.replace("«", "<").replace("»", ">").replace("\n", " ")
    "«{t}»"
  }
  /* a Lean string literal */
  proof_string (s: String): String => {
    t := s.replace("\\", "\\\\").replace("\"", "\\\"")
    "\"{t}\""
  }
  /* text inside a Lean comment: nothing that opens or closes one */
  proof_comment (s: String): String => s.replace("/-", "/ -").replace("-/", "- /")
  /* a number exactly as the record has it: a whole number, or its decimal digits over a power of ten */
  proof_number (v: Real): String => {
    return "(Fn \"not a number\" 0)" if !Expr.finite(v)
    t := "{v}"
    return "({t} : ℝ)" if Expr.is_integer(v) & !t.contains("e")
    has_e := t.contains("e")
    mant := has_e ? t.split("e").first : t
    ex := has_e ? Catalogue.number(t.split("e").last) : 0
    neg := mant.starts_with("-")
    m := neg ? mant.drop(1) : mant
    parts := m.split(".")
    frac := parts.length > 1 ? parts[1] : ""
    digits := "{parts[0]}{frac}"
    while digits.length > 1 & digits.starts_with("0") { digits = digits.drop(1) }
    scale := frac.length - ex
    sign := neg ? "-" : ""
    zeros := "0".repeat(scale < 0 ? 0 - scale : scale)
    return "({sign}{digits}{zeros} : ℝ)" if scale <= 0
    "(({sign}{digits} : ℝ) / 1{zeros})"
  }
  /* an expression of the prover as a Lean term over the reals */
  proof_term (e: Expr): String => {
    k := e.kind
    return Lean.proof_number(e.value) if k == "num"
    return Lean.proof_name(e.label) if k == "sym" | k == "field"
    if k == "add" {
      joined := e.of.map(x => Lean.proof_term(x)).join(" + ")
      return "({joined})"
    }
    if k == "mul" {
      joined := e.of.map(x => Lean.proof_term(x)).join(" * ")
      return "({joined})"
    }
    if k == "pow" {
      b := Lean.proof_term(e.base)
      kk := e.by_num
      if kk == None {
        p := Lean.proof_term(e.power)
        return "({b} ^ {p})"
      }
      return "(Real.sqrt {b})" if kk == 0.5
      return "(Real.sqrt {b})⁻¹" if kk == -0.5
      if Expr.is_integer(kk) {
        return "({b})⁻¹" if kk == -1
        n := kk.abs
        return kk < 0 ? "({b} ^ {n})⁻¹" : "({b} ^ {n})"
      }
      q := Lean.proof_number(kk)
      return "({b} ^ {q})"
    }
    return "(Real.log {Lean.proof_term(e.base)})" if k == "log"
    return "(Real.exp {Lean.proof_term(e.base)})" if k == "exp"
    return "(Grad {Lean.proof_term(e.base)})" if k == "grad"
    return "(Choose {Lean.proof_term(e.first_)} {Lean.proof_term(e.second_)})" if k == "choose"
    return "(GammaInc {Lean.proof_term(e.first_)} {Lean.proof_term(e.second_)})" if k == "gammaInc"
    if k == "root" | k == "limit" {
      bound := Lean.proof_name(e.bound)
      body := Lean.proof_term(e.base)
      head := k == "root" ? "RootOf" : "LimitAtInfinity"
      return "({head} (fun ({bound} : ℝ) => {body}))"
    }
    if k == "call" {
      lab := Lean.proof_string(e.label)
      return "(Fn {lab} {Lean.proof_term(e.base)})"
    }
    lab := Lean.proof_string(Expr.show(e))
    "(Fn {lab} 0)"
  }
  /* a claim as a proposition */
  proof_prop (c: Claim): String => {
    k := c.fact_kind
    what := Lean.proof_string(c.subject)
    if c.value != None {
      v := Lean.proof_term(c.value)
      return "{Lean.proof_name(c.subject)} = {v}" if k == "is"
      return "GrowsAs {what} {v}" if k == "grows"
      return "RestoredAt {what} {v}" if k == "restored"
    }
    return "Conserved {what}" if k == "conserved"
    return "Isotropic {what}" if k == "isotropic"
    return "Positive {what}" if k == "positive"
    "Stated {Lean.proof_string(c.markup)}"
  }
  /* the field a premise or an unchecked claim is in: a premise named after the rule or fact it is read off, an unchecked step `unchecked_<theorem>_<k>` */
  proof_field (d: Derivation, c: Claim): String => {
    return "unchecked_{Theorems.id_of(d.theorem_id)}_{c.place}" if c.status == "unchecked"
    base := "{c.via}: {c.subject}"
    twice := d.claims.filter(x => x.status == "premise" & x.place < c.place & "{x.via}: {x.subject}" == base).length > 0
    Lean.proof_name(twice ? "{base} #{c.place}" : base)
  }
  /* how a check has claim j in hand */
  proof_source (d: Derivation, j: N, args: String): String => {
    c := d.claim_at(j)
    return "p.{Lean.proof_field(d, c)}" if c.status == "premise"
    return "u.{Lean.proof_field(d, c)}" if c.status == "unchecked"
    "check_{j} {args} p u w"
  }
  proof_title (c: Claim): String => {
    what := c.role == "concluded" ? "the answer" : (c.role == "standing" ? "a settled number" : (c.role == "relation" ? "the relation its inference applies" : (c.role == "read" ? "a line an inference read without the step citing it" : "step {c.place}")))
    Lean.proof_comment("{what} ({c.via}): {c.markup}")
  }
  proof_module (d: Derivation): String => {
    names := d.names
    params := names.map(n => Lean.proof_name(n)).join(" ")
    binders := "({params} : ℝ)"
    ns := "OrbitMines.Physics.Proofs.{d.theory_name}.{Lean.proof_name(d.theorem_id)}"
    premises := d.claims.filter(c => c.status == "premise")
    unchecked := d.claims.filter(c => c.status == "unchecked")
    checked := d.claims.filter(c => c.status == "checked")
    pfields := premises.map(c => "  /-- {Lean.proof_title(c)} - {Lean.proof_comment(c.reason)} -/\n  {Lean.proof_field(d, c)} : {Lean.proof_prop(c)}").join("\n")
    ufields := unchecked.map(c => "  /-- {Lean.proof_title(c)} - NOT CHECKED: {Lean.proof_comment(c.reason)} -/\n  {Lean.proof_field(d, c)} : {Lean.proof_prop(c)}").join("\n")
    pwhere := premises.empty ? "" : " where\n{pfields}"
    uwhere := unchecked.empty ? "" : " where\n{ufields}"
    head := "(p : Premises {params}) (u : Unchecked {params}) (w : Defined {params})"
    divisors := d.divisors
    wfields := Array.range(divisors.length).map(i => "  /-- {Lean.proof_comment(Expr.show(divisors[i]))} is not nought -/\n  ne_{i} : {Lean.proof_term(divisors[i])} ≠ 0").join("\n")
    powered := d.powered
    pfields2 := Array.range(powered.length).map(i => "  /-- {Lean.proof_comment(Expr.show(powered[i]))} is positive: it is raised to a real power -/\n  pos_{i} : 0 < {Lean.proof_term(powered[i])}").join("\n")
    wall := [wfields, pfields2].filter(x => !x.empty).join("\n")
    wwhere := wall.empty ? "" : " where\n{wall}"
    rewrites := Array.range(powered.length).map(i => "r{i}").join(", ")
    nonzero := Array.range(divisors.length).map(i => "  have w{i} := w.ne_{i}").concat(Array.range(powered.length).map(i => "  have p{i} := w.pos_{i}\n  have r{i} := fun (y : ℝ) => Real.rpow_neg (le_of_lt w.pos_{i}) y\n  have q{i} := fun (y : ℝ) => (Real.rpow_pos_of_pos w.pos_{i} y).ne'")).concat(powered.empty ? [] : ["  subst_vars\n  try simp only [neg_one_mul, {rewrites}] at *"]).join("\n")
    checks := checked.map(c => {
      haves := c.uses.map(j => "  have h{j} := {Lean.proof_source(d, j, params)}").concat(nonzero.empty ? [] : [nonzero]).join("\n")
      nm := c.role == "concluded" ? "answer" : "check_{c.place}"
      "/-- {Lean.proof_title(c)} - CHECKED: {Lean.proof_comment(c.reason)} -/\ntheorem {nm} {binders}\n    {head} :\n    {Lean.proof_prop(c)} := by\n{haves}\n  check_algebra"
    }).join("\n\n")
    con := d.concluded
    answer := (con == None | con.status == "checked") ? "" : "/-- {Lean.proof_title(con)} - NOT CHECKED: {Lean.proof_comment(con.reason)} -/\ntheorem answer {binders}\n    {head} :\n    {Lean.proof_prop(con)} :=\n  u.{Lean.proof_field(d, con)}"
    "-- GENERATED by `npx ray gen` from implementation/physics.ray and implementation/gen - do not edit\nimport OrbitMines.Physics.Proofs.Basic\nset_option linter.unusedVariables false\nset_option linter.unusedSimpArgs false\nset_option linter.unusedTactic false\nset_option maxHeartbeats 4000000\nopen OrbitMines.Physics.Proofs\n\n/-!\n{Lean.proof_comment(Lean.proof_summary(d))}\n-/\n\nnamespace {ns}\n\n/-- What the prover takes from the rules: the premises, read off the program BY DESIGN - a rule's own body, the\ncontinuous model the rules were read into, the lattice, a count. None is believed or measured; each is already in the\ntheory's .ray. -/\nstructure Premises {binders} : Prop{pwhere}\n\n/-- The steps Lean does not check, each with the reason. They are hypotheses of every theorem below - stated, never proven. -/\nstructure Unchecked {binders} : Prop{uwhere}\n\n/-- Where the lines are defined: what the prover divides by. Its algebra cancels across these, so they are taken to be nonzero. -/\nstructure Defined {binders} : Prop{wwhere}\n\n{checks}\n\n{answer}\n\nend {ns}\n"
  }
  /* one theorem's coverage, in words: for the module's head and the README */
  proof_summary (d: Derivation): String => {
    n := d.steps_count
    con := d.concluded
    answer := con == None ? "no answer was concluded" : (con.status == "checked" ? "the answer is CHECKED ({con.reason})" : "the answer is NOT checked: {con.reason}")
    rows := d.claims.filter(c => c.status != "premise").map(c => {
      what := c.role == "concluded" ? "answer" : (c.role == "standing" ? "settled number {c.place}" : (c.role == "read" ? "line {c.place}, read without being cited" : "step {c.place}"))
      mark := c.status == "checked" ? "checked" : "NOT checked"
      "- {what} ({c.via}), {mark}: {c.reason}"
    }).join("\n")
    cc := d.counted("checked")
    pc := d.counted("premise")
    uc := d.counted("unchecked")
    "# {d.theorem_id} ({d.theory_name})\n\n{d.asks}\n\nLean checked {cc} of its {n} steps; {pc} are premises read off the program and {uc} are not checked. And {answer}.\n\n{rows}"
  }
  proof_readme (theory: Theory, ds: Derivation[]): String => {
    steps := 0
    premises := 0
    checked := 0
    unchecked := 0
    answered := 0
    concluded := 0
    ds.for(d => {
      steps = steps + d.steps_count
      premises = premises + d.counted("premise")
      checked = checked + d.counted("checked")
      unchecked = unchecked + d.counted("unchecked")
      concluded = concluded + (d.concluded == None ? 0 : 1)
      answered = answered + ((d.concluded != None & d.concluded.status == "checked") ? 1 : 0)
    })
    table := ds.map(d => {
      con := d.concluded
      a := con == None ? "none" : (con.status == "checked" ? "checked" : "not checked")
      cc := d.counted("checked")
      pc := d.counted("premise")
      uc := d.counted("unchecked")
      "| [{d.theorem_id}](OrbitMines/Physics/Proofs/{d.theory_name}/{Theorems.id_of(d.theorem_id)}.lean) | {d.steps_count} | {pc} | {cc} | {uc} | {a} |"
    }).join("\n")
    details := ds.map(d => Lean.proof_summary(d).replace("# ", "### ")).join("\n\n")
    "# theorems, checked by Lean\n\n> Generated by `npx ray gen Lean` from [implementation/gen/Derivation.ray](../../implementation/gen/Derivation.ray) and [implementation/gen/languages/Lean.ray](../../implementation/gen/languages/Lean.ray). Do not edit.\n\nEvery theorem of `{theory.name}` (the [theorems](../../theorems/README.md)) and its derivation, stated in Lean 4 and checked by Lean's prover where the derivation is algebra. One module a theorem: its names are real numbers and every statement holds for ALL values of them; `Premises` holds what the prover takes from the rules (read off the program by design), `Unchecked` every step Lean does not check (`unchecked_<theorem>_<k>`, with the reason), `Defined` where the lines are defined (what they divide by is not nought, what they raise to a real power is positive), `check_<k>` every step Lean proves from those with Mathlib's algebra, and `answer` is the theorem. Nothing is an axiom and nothing is a `sorry`.\n\n```\ncd languages/physics.lean\nlake exe cache get     # Mathlib's compiled files\nlake build             # the runtime and the theorems\n```\n\n```lean\nimport OrbitMines.Physics.Proofs            -- every theorem\nimport OrbitMines.Physics.Proofs.G.force_range   -- or one: OrbitMines.Physics.Proofs.G.«force.range».answer\n```\n\n## What is checked, and what is not\n\nA step of the prover is a READING (a rule's own body, the continuous model, the lattice, a count: a premise, by design) or an INFERENCE (Inferences.ray, and the methods of Prove.ray that build the equation's chain). An inference records the line it concluded, not what it did to the lines it stands on - so that is read off its own code: it is run again on the store as it stood when the step arrived, with the lines it stands on standing as their NAMES, and what it concludes then is the relation it applies (`λ = ρ / what is taken` where the step says `λ = 1/(σFρ)`). The relation is a premise, named after the inference; the step is CHECKED when Lean proves that the relation, with those lines put in, is the step's line. Also checked: a step that names again what an earlier one named, and the answer (the last step with the settled numbers - a rate is one per match per tick, the facing factor a half - put in). Gen samples both sides first and offers only what agrees; Lean then has to prove it symbolically. `Defined` says where the lines are: what the prover divides by is not nought, and what it raises to a real power is positive - its algebra cancels across them.\n\nWhat stays NOT CHECKED, each with its reason in the module: an inference that concludes nothing when its lines stand as names (it looks inside a value, or a guard goes the other way); a relation holding a root in the density that the lines it stands on are written in (the prover puts them in under the root by name; a prover's substitution does not); a relation that, with the lines put back, is not the line (the inference did something else to them than it does to names); a cancellation of a sum carrying a real power (1 - q^R), which the algebra of a field cannot show is not nought; and the equation chain's readings - the line solved along a heading, the past taken as infinite, the sum over bodies - which are not algebra at all.\n\nIn all: {steps} steps in {ds.length} theorems - {premises} premises, {checked} checked, {unchecked} not checked; {answered} of the {concluded} answers checked.\n\n| theorem | steps | premises | checked | not checked | answer |\n|---|---|---|---|---|---|\n{table}\n\n## Theorem by theorem\n\n{details}\n"
  }

  write_backend_tests (nm: String, theory: Theory) => { }
  write_backend (nm: String, code: String) => { }

  /* the CPU backend's runtime around the emitted classes */
  cpu_runtime (): String => @./implementation/gen/backends/cpu.runtime.lean
  /* the package's folder under languages/ */
  package_dir (): String => "physics.lean"
  install (): String => "```lean\n-- Lean 4 (lakefile.toml)\n[[require]]\nname = \"orbitmines-physics\"\ngit = \"https://github.com/orbitmines/physics\"\nsubDir = \"languages/physics.lean\"\n```"
  readme (): String => "# orbitmines-physics - Lean 4\n\n> Generated by `npx ray gen` from [implementation/physics.ray](../../implementation/physics.ray/) and [implementation/gen](../../implementation/gen/). Do not edit - change the `.ray` and regenerate.\n\nThe physics library in Lean 4: the theories and their rules, the continuous model derived from them (the medium), and the settings a simulation of sources - stars, planets, any bodies a theory has - is planned by. Back to the [project README](../../README.md).\n\n## Installation\n\n{Lean.install}\n\nLean 4.34 or later (`lake build`), library `OrbitMines`, module `OrbitMines.Physics`.\n\n## Using it\n\nLean has no dynamic members, so a Ray object is reached by name, in `IO`: `gm x \"name\"`, `cm x \"method\" #[args]`, `sm x \"name\" value`, `mk \"Class\" #[kw \"field\" value, ...]`, `K \"G\"` for a class or a theory. A value is an `Rt.Value`: numbers are `Float`, lists shared and mutable (`Value.toList`), `strv` writes any value as text.\n\n```lean\nimport OrbitMines.Physics\nopen Rt\n\n-- a theory, and its continuous model on the CPU: a box of cells, the vacuum settled, one body in it\ndef main : IO Unit := do\n  let medium ← cm (← K \"G\") \"medium\" #[31, 96, 3, 8, 1]\n  sm medium \"local_rays\" (.bool true)\n  discard <| cm medium \"add\" #[← mk \"Hole\" #[kw \"x\" 15, kw \"y\" 15, kw \"mx\" 0.3, kw \"ways\" 1]]\n  discard <| gm medium \"seed\"\n  for _ in [0:5] do\n    discard <| gm medium \"tick\"\n```\n\n## A simulation of sources: the plan\n\nA run is set by a `Plan`: how many sources, how big a box, and four kinds of setting - `Resolution` (how finely the medium reads), `Budget` (how much of the device it may take), `Batching` (how a run larger than the device is carried) and `Output` (what comes back). The plan says what the device must hold before anything runs.\n\n```lean\nlet plan ← mk \"Plan\" #[kw \"sources\" 1e9, kw \"side\" 241]\nsm (← gm plan \"budget\") \"compact\" (.bool true)   -- twelve bytes a source\nIO.println (← strv (← cm plan \"report\" #[17179869184, 2147483648]))\n```\n\n## The theorems, checked by Lean\n\nEvery theorem of the theories and its derivation is in the package too, as Lean statements Lean checks (with Mathlib; the runtime imports none of it): `import OrbitMines.Physics.Proofs`, or one theorem, `import OrbitMines.Physics.Proofs.G.force_range` - its answer is `OrbitMines.Physics.Proofs.G.«force.range».answer`. What the prover takes from the rules is a `Premises` field, every step Lean does not check an `Unchecked` field with its reason, and every step it does a `check_<k>`. `lake exe cache get` first fetches Mathlib's compiled files; `lake build` builds the runtime and checks the theorems. Which steps are checked, theorem by theorem: [THEOREMS.md](THEOREMS.md).\n\n## On the GPU\n\nThe GPU runtime of the medium is being carried into `.ray`, so that every language runs the same thing on every backend. Until then it runs from the [TypeScript package](../physics.ts/README.md).\n"
  /* its job in .github/workflows/release.yml (Release.ray): build, check the theorems, keep what it built; a tag is the release */
  release_job (): String => "  lean:\n    needs: version\n    runs-on: ubuntu-latest\n    env:\n      PUBLISH: ${{{{ needs.version.outputs.publish }}}}\n      TESTING: ${{{{ needs.version.outputs.testing }}}}\n    steps:\n      - uses: actions/checkout@v7\n      - name: install elan\n        run: |\n          curl -sSfL https://raw.githubusercontent.com/leanprover/elan/master/elan-init.sh | sh -s -- -y --default-toolchain none\n          echo \"$HOME/.elan/bin\" >> \"$GITHUB_PATH\"\n      - name: build the package and check the theorems\n        run: cd languages/physics.lean && lake exe cache get && lake build\n      - name: package\n        run: mkdir -p out && tar czf out/orbitmines-physics-lean-{Release.semver}.tar.gz --exclude .lake -C languages physics.lean\n      - uses: actions/upload-artifact@v7\n        with:\n          name: lean\n          path: out/\n          if-no-files-found: error\n      - name: Reservoir reads the release's tag\n        if: env.PUBLISH == 'true'\n        run: echo \"Lean is released by the repository tag v{Release.semver}, which the release job creates and Reservoir indexes\"\n"
}
