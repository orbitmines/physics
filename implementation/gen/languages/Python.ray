/*
 * PYTHON, as a mapping from the constructs of Ray to text - the same rules as TypeScript.ray, with
 * Python's own spelling. Indentation is the block structure, so every block hole is `{x.indent}`
 * after a colon. A `.for` over a block becomes a `for` statement (a `return` inside it leaves the
 * method, as Ray's caller-scoped block does); `.map`/`.filter` with an expression become
 * comprehensions. Parameterless methods are properties, so `x.neutral` reads the same everywhere.
 */

Python: Language = class {
  name = "Python"
  extension = ".py"

  {indent} => "    "
  {separator} => ", "
  {newline} => "\n"
  {statement_end} => ""
  {empty_block} => "pass"
  {interpolation} => "{{{x}}}"
  {named_arg} => "{nm}={val}"
  {parameter} => "{nm}"
  {parameter_untyped} => "{nm}"
  {parameter_default} => "{nm}={val}"
  {dynamic_get} => "getattr({tgt}, {key})"
  {lambda_hoist} => "def {nm}({paramlist}):\n{body}"
  {dynamic_set} => "setattr({tgt}, {key}, {val})"

  /* control flow */
  {if cond { yesbody } else { nobody }} => "if {cond}:\n{yesbody.indent}\nelse:\n{nobody.indent}"
  {if cond { yesbody }} => "if {cond}:\n{yesbody.indent}"
  {unless cond { yesbody }} => "if not ({cond}):\n{yesbody.indent}"
  {while cond { loopbody }} => "while {cond}:\n{loopbody.indent}"
  {return val} => "return {val}"
  {return} => "return"
  {dynamically assert cond} => "assert {cond}, {cond.quoted}"

  /* definitions and assignment */
  {nm := val} => "{nm} = {val}"
  {lhs = rhs} => "{lhs} = {rhs}"
  {tgt[k] = rhs} => "set_at({tgt}, {k}, {rhs})"

  /* expressions */
  {a & b} => "({a} and {b})"
  {a | b} => "({a} or {b})"
  {!a} => "(not {a})"
  {-a} => "(-{a})"
  {a == b} => "eq({a}, {b})"
  {a != b} => "(not eq({a}, {b}))"
  {a < b} => "lt({a}, {b})"
  {a <= b} => "le({a}, {b})"
  {a > b} => "gt({a}, {b})"
  {a >= b} => "ge({a}, {b})"
  {a + b} => "add({a}, {b})"
  {a - b} => "sub({a}, {b})"
  {a * b} => "mul({a}, {b})"
  {a / b} => "div({a}, {b})"
  {a % b} => "mod({a}, {b})"
  {a ^ b} => "({a} ** {b})"
  {a ?? b} => "({a} if {a} is not None else {b})"
  {cond ? a : b} => "({a} if {cond} else {b})"
  {a ==.instance_of Array} => "isinstance({a}, list)"
  {a ==.instance_of ty} => "instance_of({a}, {ty})"
  {a as ty} => "{a}"
  {tgt.nm} => "{tgt}.{nm.method}"
  {tgt?.nm} => "elem({tgt}, {nm.quoted})"
  {tgt.nm()} => "{tgt}.{nm.method}"
  {tgt.nm(arglist)} => "{tgt}.{nm.method}({arglist})"
  {tgt.choose("nm")} => "{tgt}.choose({nm.quoted})"
  {tgt[k]} => "elem({tgt}, {k})"
  {fn(arglist)} => "{fn}({arglist})"
  {Class(arglist)} => "{Class}({arglist})"
  {[elems]} => "[{elems}]"
  { {} } => "Node()"
  {this} => "self"
  {None} => "None"
  {true} => "True"
  {false} => "False"
  {"txt"} => "f\"{txt}\""
  /* `{captures}` binds the enclosing lambdas' parameters now, since Python binds late */
  {(paramlist) => e} => "(lambda {paramlist}{captures}: {e})"
  {xs#} => "many({xs})"
  {draw([ws], [os])} => "self.vertex.world.draw([{ws}], [{os}])"

  /* the recognised classes: what their members are here */
  {xs.for((x_) => { stmts })} => "for {x_.bare} in list({xs}):\n{stmts.indent}"
  {fail(x_)} => "fail({x_})"
  {Catalogue.number(x_)} => "float({x_})"
  {xs.push(x_)} => "push({xs}, {x_})"
  {xs.chars} => "[ord(ch) for ch in {xs}]"
  {String(chars: xs)} => "\"\".join(chr(ch) for ch in {xs})"
  {x_.blank} => "({x_} in (32, 9, 10, 13))"
  {xs.pop} => "{xs}.pop()"
  {xs.length} => "len({xs})"
  {xs.map((x_) => e)} => "[{e} for {x_} in {xs}]"
  {xs.filter((x_) => e)} => "filt({xs}, lambda {x_}{captures}: {e})"
  {xs.map(f)} => "list(map({f}, {xs}))"
  {xs.filter(f)} => "filt({xs}, {f})"
  {xs.some((x_) => e)} => "any({e} for {x_} in {xs})"
  {xs.every((x_) => e)} => "all({e} for {x_} in {xs})"
  {xs.starts_with(x_)} => "{xs}.startswith({x_})"
  {xs.ends_with(x_)} => "{xs}.endswith({x_})"
  {xs.replace(x_, y_)} => "{xs}.replace({x_}, {y_})"
  {xs.split(x_)} => "{xs}.split({x_})"
  {xs.trim} => "{xs}.strip()"
  {xs.upper} => "{xs}.upper()"
  {xs.lower} => "{xs}.lower()"
  {xs.lines} => "{xs}.split(\"\\n\")"
  {xs.quoted} => "json.dumps({xs})"
  {xs.contains(x_)} => "contains({xs}, {x_})"
  {xs.index_of(x_)} => "index_of({xs}, {x_})"
  {xs.join(sep)} => "{sep}.join(str(x_) for x_ in {xs})"
  {xs.first} => "first({xs})"
  {xs.last} => "last({xs})"
  {xs.empty} => "(len({xs}) == 0)"
  {xs.take(cnt)} => "{xs}[:{cnt}]"
  {xs.drop(cnt)} => "{xs}[{cnt}:]"
  {xs.rest} => "{xs}[1:]"
  {xs.concat(ys)} => "({xs} + {ys})"
  {xs.reverse} => "list(reversed({xs}))"
  {xs.sum} => "summed({xs})"
  {xs.most(f)} => "most({xs}, {f})"
  {xs.sorted_by(f)} => "sorted_by({xs}, {f})"
  {xs.each} => "each_of({xs})"
  {Array.range(cnt)} => "rng({cnt})"
  {Array.filled(cnt, x_)} => "filled({cnt}, {x_})"
  {x_.sqrt} => "math.sqrt({x_})"
  {x_.floor} => "math.floor({x_})"
  {x_.abs} => "abs({x_})"
  {x_.negated} => "neg({x_})"
  {x_.magnitude} => "abs({x_})"
  {x_.cos} => "math.cos({x_})"
  {x_.sin} => "math.sin({x_})"
  {x_.round} => "round({x_})"
  {x_.ln} => "math.log({x_})"
  {x_.exp} => "math.exp({x_})"
  {x_.atan2(y_)} => "math.atan2({x_}, {y_})"
  {x_.pow(y_)} => "({x_} ** {y_})"
  {Real.of(x_)} => "{x_}"
  {Real.ZERO} => "0"
  {Real.ONE} => "1"
  {Real.TWO} => "2"
  {Real.PI} => "math.pi"
  {Real.NAN} => "float(\"nan\")"
  {Real.INFINITY} => "float(\"inf\")"
  {Real.TAU} => "(2 * math.pi)"
  {Random.MODULUS} => "4294967296"
  {Random.MULTIPLIER} => "1664525"
  {Random.INCREMENT} => "1013904223"

  /* types are not written */
  {N} => "int"
  {Natural} => "int"
  {Z} => "int"
  {Integer} => "int"
  {Real} => "float"
  {Decimal} => "float"
  {boolean} => "bool"
  {String} => "str"
  {Array} => "list"
  {*} => "object"
  {ty[]} => "list"
  {ty?} => "{ty}"

  /* classes: fields with a default are lazy properties */
  {nm := class < sup { membs }} => "class {nm}({sup.first}):\n{membs.indent}\n    pass"
  {nm := class { membs }} => "class {nm}(Node):\n{membs.indent}\n    pass"
  {nm: ty = class { membs }} => "class _{nm}({ty}):\n{membs.indent}\n    def __init__(self, **kw):\n        super().__init__(**kw)\n        self.rules = collect_rules(self)\n        self.theorems = collect_theorems(self)\n\n{nm} = _{nm}()"
  {theorem "nm" () => tbody} => "def _theorem_{nm.identifier}():\n{tbody.returned.indent}\ntheorem_{nm.identifier} = Theorem(id={nm.quoted}, body=_theorem_{nm.identifier})"
  {x_.body()} => "{x_}.body()"
  {nm: ty = val} => "@property\ndef {nm}(self):\n    if not hasattr(self, \"_{nm}\"):\n        self._{nm} = {val}\n    return self._{nm}\n@{nm}.setter\ndef {nm}(self, v):\n    self._{nm} = v"
  {nm: ty} => "{nm}: {ty}"
  {nm = val} => "{nm} = {val}"
  {static nm: ty = val} => "{nm} = {val}"
  {static nm = val} => "{nm} = {val}"
  {nm (): ret => mbody} => "@property\ndef {nm.method}(self):\n{mbody.returned.indent}"
  {nm () => mbody} => "@property\ndef {nm.method}(self):\n{mbody.returned.indent}"
  {static nm (): ret => mbody} => "@classproperty\ndef {nm.method}(cls):\n{mbody.returned.indent}"
  {nm (paramlist): ret => mbody} => "def {nm.method}(self, {paramlist}):\n{mbody.returned.indent}"
  {nm (paramlist) => mbody} => "def {nm.method}(self, {paramlist}):\n{mbody.returned.indent}"
  {nm (paramlist): ret} => "def {nm.method}(self, {paramlist}):\n    raise NotImplementedError({nm.quoted} + \" is declared but not defined by anyone\")"
  {nm (paramlist)} => "def {nm.method}(self, {paramlist}):\n    raise NotImplementedError({nm.quoted} + \" is declared but not defined by anyone\")"
  {nm (): ret} => "@property\ndef {nm.method}(self):\n    raise NotImplementedError({nm.quoted} + \" is declared but not defined by anyone\")"
  {nm ()} => "@property\ndef {nm.method}(self):\n    raise NotImplementedError({nm.quoted} + \" is declared but not defined by anyone\")"
  {static nm (paramlist): ret} => "@staticmethod\ndef {nm.method}({paramlist}):\n    raise NotImplementedError({nm.quoted} + \" is declared but not defined by anyone\")"
  {static nm (paramlist)} => "@staticmethod\ndef {nm.method}({paramlist}):\n    raise NotImplementedError({nm.quoted} + \" is declared but not defined by anyone\")"
  {static nm (paramlist): ret => mbody} => "@staticmethod\ndef {nm.method}({paramlist}):\n{mbody.returned.indent}"
  {static nm (paramlist) => mbody} => "@staticmethod\ndef {nm.method}({paramlist}):\n{mbody.returned.indent}"
  {static nm () => mbody} => "@classproperty\ndef {nm.method}(cls):\n{mbody.returned.indent}"
  {rule /rid "nm" | rt () => rbody} => "def _rule_{rid.identifier}(_=None):\n{rbody.returned.indent}\nrule_{rid.identifier} = Rule(id=\"/{rid}\", name={nm.quoted}, rate={rt.quoted}, over={over.quoted}, single={single.capitalised}, where={where}, source={source.quoted}, body=_rule_{rid.identifier})"
  {rule /rid "nm" () => rbody} => "def _rule_{rid.identifier}(_=None):\n{rbody.returned.indent}\nrule_{rid.identifier} = Rule(id=\"/{rid}\", name={nm.quoted}, rate=None, over={over.quoted}, single={single.capitalised}, where={where}, source={source.quoted}, body=_rule_{rid.identifier})"
  {rule /rid "nm" | rt (paramlist) => rbody} => "def _rule_{rid.identifier}({paramlist}):\n{rbody.returned.indent}\nrule_{rid.identifier} = Rule(id=\"/{rid}\", name={nm.quoted}, rate={rt.quoted}, over={over.quoted}, single={single.capitalised}, where={where}, source={source.quoted}, body=_rule_{rid.identifier})"
  {rule /rid "nm" (paramlist) => rbody} => "def _rule_{rid.identifier}({paramlist}):\n{rbody.returned.indent}\nrule_{rid.identifier} = Rule(id=\"/{rid}\", name={nm.quoted}, rate=None, over={over.quoted}, single={single.capitalised}, where={where}, source={source.quoted}, body=_rule_{rid.identifier})"
  {choose "nm" (paramlist): ret} => "def choose_{nm.identifier}(self, {paramlist}):\n    raise NotImplementedError(\"the choice {nm} is not defined by anyone\")"
  {choose "nm" (paramlist): ret => cbody} => "def choose_{nm.identifier}(self, {paramlist}):\n{cbody.returned.indent}"
  {choose "nm" (paramlist) => cbody} => "def choose_{nm.identifier}(self, {paramlist}):\n{cbody.returned.indent}"
  {as (=== ty) => cbody} => "def as_{ty}(self):\n{cbody.returned.indent}"

  /* a nested class is a class of its own, then hung on the outer one */
  nested (outer: String, inner_name: String, inner: String): String => "{inner}\n\n{outer}.{inner_name} = {inner_name}"

  constant (nm: String, text: String): String => "{nm} = {text}"

  term_literal (id: String, rate: String, degree: N, outside: boolean, settles: boolean, transport: boolean, share: String, rays: String, space: String, folds: String, share_source: String, rays_source: String, space_source: String, folds_source: String, rule_name: String, over: String, where_source: String, rule_source: String, leans: String, carries: boolean, sets: boolean, turned: String): String => {
    rate_ := rate.empty ? "None" : rate.quoted
    where := where_source.empty ? "None" : "Node(source={where_source.quoted})"
    rule := id.empty ? "None" : "Node(id={id.quoted}, rate={rate_}, name={rule_name.quoted}, over={over.quoted}, where={where}, source={rule_source.quoted})"
    leans_ := leans.empty ? "None" : leans.quoted
    "    Node(rule={rule}, rate={rate_}, degree={degree}, outside={Python.bool(outside)}, settles={Python.bool(settles)}, transport={Python.bool(transport)}, leans={leans_}, turned={turned.quoted}, doing=Node(carries={Python.bool(carries)}, sets={Python.bool(sets)}, draws=None, needs={degree}, outside={Python.bool(outside)}, settles={Python.bool(settles)}, share=Node(source={share_source.quoted}, at=(lambda s: {share})), rays=Node(source={rays_source.quoted}, at=(lambda s: {rays})), space=Node(source={space_source.quoted}, at=(lambda s: {space})), folds=Node(source={folds_source.quoted}, at=(lambda s: {folds}))))"
  }
  bool (b: boolean): String => b ? "True" : "False"
  equation_literal (theory: String, latex: String, terms: String[]): String => {
    lines := terms.join(",\n")
    "type({theory}).equation = Node(latex={latex.quoted}, terms=[\n{lines}\n])"
  }

  write_package (code: String) => {
    @./languages/physics.py/orbitmines/physics/__init__.py := code
    @./languages/physics.py/orbitmines/__init__.py := ""
    @./languages/physics.py/pyproject.toml := Python.pyproject
  }

  test_case (r: Requirement, f: Fixture): String => {
    definition := f.definition.as(Python)
    requirement := r.requirement.as(Python)
    filter := r.filter == None ? "True" : r.filter.as(Python)
    label := "{r.location} on {f.name}"
    name := label.snake.replace("/", "_").replace(":", "_").replace(" ", "_")
    "    def test_{name}(self):\n        it = {definition}\n        guard = 0\n        while not ({filter}):\n            guard += 1\n            if guard > 8 or not hasattr(type(it), \"tick\"): self.skipTest(\"the refinement never held\")\n            it.tick\n        self.assertTrue({requirement}, {requirement.quoted})"
  }

  write_tests (cases: String, fixtures: Fixture[]) => {
    @./tests/py/test_G.py := "# GENERATED by `npx ray gen` from implementation/physics.ray - do not edit\nimport sys, os, unittest\nsys.path.insert(0, os.path.join(os.path.dirname(__file__), \"..\", \"..\", \"languages\", \"physics.py\"))\nfrom orbitmines.physics import *\n\n\nclass TestG(unittest.TestCase):\n{cases}\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n"
  }

  /* Python renders no films yet: the .ray/TypeScript pipeline records them */
  {visual "nm" () => vbody} => ""
  write_visuals (entries: String) => { }

  /* the notation: the parser and the HTML setter, as the package carries them */
  write_notation () => {
    @./languages/physics.py/orbitmines/physics/notation.py = "\"\"\"\norbitmines.physics.notation - the markup a proof is set in: `Notation.parse(src)` reads it into pieces,\n`Notation.html(src)` sets it for a page, `Notation.set(pieces, setter)` walks it through a Setter of your own.\nGENERATED by `npx ray gen` from implementation/physics.ray. Do not edit.\n\"\"\"\nfrom orbitmines.physics import Piece, Reference, Setter, Notation\n\n__all__ = [\"Piece\", \"Reference\", \"Setter\", \"Notation\"]\n"
  }

  /* every theorem, as one value: `from orbitmines.physics.theorems import PROVED` */
  write_theorems (proofs: String) => {
    @./languages/physics.py/orbitmines/physics/theorems.py := "\"\"\"\norbitmines.physics.theorems - what the rules come to, as something to look up: every theorem, keyed by\ntheory and then by question. GENERATED by `npx ray gen` from implementation/physics.ray. Do not edit.\n\"\"\"\nimport json\n\nPROVED = json.loads(r\"\"\"{{{proofs}}}\"\"\")\n\n\ndef proved(of, theory, theorem):\n    \"\"\"one theorem, or None - and never a raise\"\"\"\n    return of.get(theory, {{}}).get(theorem)\n\n\ndef theories(of, theorem):\n    \"\"\"which theories have an answer to a question\"\"\"\n    return [t for t in of if theorem in of[t]]\n\n\ndef asked(of, theory):\n    \"\"\"every question a theory answers\"\"\"\n    return list(of.get(theory, {{}}).keys())\n"
  }

  /* the agreement of a GPU backend with the CPU field, skipped where wgpu is not importable */
  write_backend_tests (nm: String, theory: Theory) => {
    tn := theory.name
    @./tests/py/test_{tn}_{nm}.py := "# GENERATED by `npx ray gen` from implementation/physics.ray - do not edit\nimport sys, os, unittest\nsys.path.insert(0, os.path.join(os.path.dirname(__file__), \"..\", \"..\", \"languages\", \"physics.py\"))\nfrom orbitmines.physics import {tn}, Hole\ntry:\n    from orbitmines.physics.{nm} import gpu, ready\n    HAVE = ready()\nexcept Exception:\n    HAVE = False\n\nN, A, K, TICKS, TOL = 12, 8, 1, 6, 0.001\n\n\n@unittest.skipUnless(HAVE, \"the {nm} binding is not here\")\nclass Test{tn}{nm.capitalised}(unittest.TestCase):\n    def close(self, name, xs, ys):\n        self.assertEqual(len(xs), len(ys), name)\n        worst = max((abs(float(x) - float(y)) for x, y in zip(xs, ys)), default=0.0)\n        self.assertLessEqual(worst, TOL, name + \" differ by \" + str(worst))\n\n    def agree(self, body):\n        kernels = gpu(N, A, K)\n        field = {tn}.field(N, A, K, 1)\n        if body:\n            kernels.add(Hole(x=6, y=6, mx=0.5, ways=8))\n            field.add(Hole(x=6, y=6, mx=0.5, ways=8))\n        for t in range(TICKS):\n            kernels.tick()\n            field.tick\n            self.close(\"n after \" + str(t + 1), kernels.state(), field.n)\n            self.close(\"rho after \" + str(t + 1), kernels.rho(), field.rho)\n            self.close(\"folds after \" + str(t + 1), kernels.folds(), field.folds)\n        self.close(\"mean\", [kernels.mean()], [field.mean])\n\n    def test_agrees(self):\n        self.agree(False)\n\n    def test_agrees_with_a_body(self):\n        self.agree(True)\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n"
  }

  write_backend (nm: String, code: String) => {
    @./languages/physics.py/orbitmines/physics/{nm}.py := code
  }

  pyproject (): String => "[project]\nname = \"orbitmines-physics\"\nversion = \"0.0.1\"\ndescription = \"The discrete theory G - the rules, and the smallest thing that runs them. Generated from implementation/physics.ray.\"\nrequires-python = \">=3.10\"\n\n[build-system]\nrequires = [\"setuptools>=61\"]\nbuild-backend = \"setuptools.build_meta\"\n\n[tool.setuptools.packages.find]\ninclude = [\"orbitmines*\"]\n"
}
