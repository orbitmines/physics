/*
 * JULIA, as a mapping from the constructs of Ray to text - in Julia's own terms. A Ray class is a type: `@class Hole <:
 * Source begin ... end` (implementation/gen/backends/cpu.rt.jl) lays out an abstract type under the parent's
 * (`AbstractHole <: AbstractSource`) and a mutable struct with the fields of the class and its parents, each read
 * through a function of its name (its default made on first read). Every member is a function dispatched on the
 * abstract type - `function add(self::AbstractMedium, h = nothing, _...)` - so `m.add(h)` is `add(m, h)`, `m.seed` is
 * `seed(m)`, and multiple dispatch finds the nearest class, as Ray's chain does; a static takes the type
 * (`nearest(Geometry, 3.0, 12.0)`). A theory is its one object (`G`), its rules Rule values whose body is dispatched
 * on what the rule is over. Only what Ray names at run time (`x[name]`) is found by name.
 *
 * A local is spelled with the depth of the scope that binds it (`{local_name}`): a Julia closure takes a local by
 * reference, and assigning a name the enclosing function has would write that one; and a local named like a member
 * (`cells := this.cells`) would hide the member's function. Every parameter defaults to `nothing` (Ray passes None for
 * what is not given) and a program takes what more it is given (`_...`). Every text is `j"..."`, read raw by the
 * runtime's string macro, so a `$` in it is only a `$`. Numbers are Float64, lists `Vector{Any}`, indexed from 0 by
 * `getat`/`setat!`.
 */

Julia: Language = class {
  name = "Julia"
  extension = ".jl"

  {indent} => "  "
  {separator} => ", "
  {newline} => "\n"
  {statement_end} => ""
  {empty_block} => "nothing"
  {interpolation} => "\", str({x}), j\""
  {named_arg} => "{nm} = {val}"
  {parameter} => "{nm} = nothing, "
  {parameter_untyped} => "{nm} = nothing, "
  {parameter_default} => "{nm} = {val}, "
  {parameter_separator} => ""
  {dynamic_get} => "getat({tgt}, {key})"
  {dynamic_set} => "setat!({tgt}, {key}, {val})"
  {whole} => "{val}.0"
  {reserved_names} => "baremodule begin break catch const continue do else elseif end export false finally for function global if import let local macro module quote return struct true try using while abstract mutable primitive type where in isa outer public var nothing missing self"
  {escaped_name} => "{nm}_"
  {global_name} => "g_{nm}()"
  {local_name} => "{nm}_{k}"
  {field_assign} => "@field {nm}::Any = {val}"

  /* control flow */
  {if cond { yesbody } else { nobody }} => "if truthy({cond})\n{yesbody.indent}\nelse\n{nobody.indent}\nend"
  {if cond { yesbody }} => "if truthy({cond})\n{yesbody.indent}\nend"
  {unless cond { yesbody }} => "if !truthy({cond})\n{yesbody.indent}\nend"
  {while cond { loopbody }} => "while truthy({cond})\n{loopbody.indent}\nend"
  {return val} => "return {val}"
  {return} => "return nothing"
  {dynamically assert cond} => "truthy({cond}) || throw(AssertionError(j{cond.quoted}))"

  /* definitions and assignment */
  {nm := val} => "{nm} = {val}"
  {tgt.nm = rhs} => "{tgt}.{nm} = {rhs}"
  {lhs = rhs} => "{lhs} = {rhs}"
  {tgt[k] = rhs} => "setat!({tgt}, {k}, {rhs})"

  /* expressions: the operators are Ray's (Rt.Ops), on Float64 Julia's own */
  {a & b} => "(truthy({a}) && truthy({b}))"
  {a | b} => "(truthy({a}) || truthy({b}))"
  {!a} => "!({a})"
  {-a} => "(-{a})"
  {a == b} => "({a} == {b})"
  {a != b} => "({a} != {b})"
  {a < b} => "({a} < {b})"
  {a <= b} => "({a} <= {b})"
  {a > b} => "({a} > {b})"
  {a >= b} => "({a} >= {b})"
  {a + b} => "({a} + {b})"
  {a - b} => "({a} - {b})"
  {a * b} => "({a} * {b})"
  {a / b} => "({a} / {b})"
  {a % b} => "({a} % {b})"
  {a ^ b} => "({a} ^ {b})"
  {a ?? b} => "(let q_ = {a}; q_ === nothing ? ({b}) : q_ end)"
  {cond ? a : b} => "(truthy({cond}) ? ({a}) : ({b}))"
  {a ==.instance_of ty} => "isray({a}, {ty})"
  {a as ty} => "{a}"
  {tgt.nm} => "{nm.method}({tgt})"
  {tgt?.nm} => "(let q_ = {tgt}; q_ === nothing ? nothing : {nm.method}(q_) end)"
  {tgt.nm()} => "{nm.method}({tgt})"
  {tgt.nm(arglist)} => "{nm.method}({tgt}, {arglist})"
  {tgt?.nm(arglist)} => "(let q_ = {tgt}; q_ === nothing ? nothing : {nm.method}(q_, {arglist}) end)"
  {tgt.choose("nm")} => "((a_...) -> choose_{nm.identifier}({tgt}, a_...))"
  {tgt[k]} => "getat({tgt}, {k})"
  {fn(arglist)} => "{fn}({arglist})"
  {Class(arglist)} => "{Class.identifier}({arglist})"
  {[elems]} => "Any[{elems}]"
  { {} } => "Node()"
  {this} => "self"
  {None} => "nothing"
  {true} => "true"
  {false} => "false"
  {"txt"} => "Base.string(j\"{txt}\")"
  {(paramlist) => { stmts }} => "(function ({paramlist}_...)\n{stmts.returned.indent}\nend)"
  {(paramlist) => e} => "(function ({paramlist}_...)\n  {e}\nend)"
  {xs#} => "Many(items({xs}))"
  {draw([ws], [os])} => "draw(world(vertex(self)), Any[{ws}], Any[{os}])"

  /* the recognised classes where Julia writes them otherwise; every other member of a list, a text or a number is a function of Rt.Ops (`split(s, ",")`) */
  {Array.range(cnt).for((x_) => { stmts })} => "for i{d} in 0:(ceil(Int, Rt.num({cnt})) - 1)\n  {x_.bare} = Float64(i{d})\n{stmts.indent}\nend"
  {xs.for((x_) => { stmts })} => "for {x_.bare} in items({xs})\n{stmts.indent}\nend"
  {fail(x_)} => "fail({x_})"
  {Catalogue.number(x_)} => "tonumber({x_})"
  {String(chars: xs)} => "from_codepoints({xs})"
  {Array.range(cnt)} => "rng({cnt})"
  {Array.filled(cnt, x_)} => "filled({cnt}, {x_})"
  {Real.of(x_)} => "{x_}"
  {Real.ZERO} => "0.0"
  {Real.ONE} => "1.0"
  {Real.TWO} => "2.0"
  {Real.PI} => "3.141592653589793"
  {Real.NAN} => "NaN"
  {Real.INFINITY} => "Inf"
  {Real.TAU} => "6.283185307179586"
  {Random.MODULUS} => "4294967296.0"
  {Random.MULTIPLIER} => "1664525.0"
  {Random.INCREMENT} => "1013904223.0"

  /* types: what a field holds (a number, a truth, a text, a list - anything else is Any) and what `instance_of` asks */
  {N} => "Float64"
  {Natural} => "Float64"
  {Z} => "Float64"
  {Integer} => "Float64"
  {Real} => "Float64"
  {Decimal} => "Float64"
  {boolean} => "Bool"
  {String} => "String"
  {Array} => "List"
  {*} => "Any"
  {{}} => "Node"
  {ty[]} => "List"
  {ty[]?} => "List"
  {ty?} => "{ty}"
  {Program} => "Function"

  /* classes: a type each (`@class`), every member a function dispatched on it (`__class__` is the class's abstract type) */
  {nm := class < sup { membs }} => "@class {nm.raw} <: {sup.first} begin\n{membs.indent}\nend"
  {nm := class { membs }} => "@class {nm.raw} <: Node begin\n{membs.indent}\nend"
  {nm: ty = class { membs }} => "@theory {nm.raw} <: {ty} begin\n{membs.indent}\nend"
  {theorem "nm" () => tbody} => "@theorem Theorem(id = j{nm.quoted}, body = (function (_...)\n{tbody.returned.indent}\nend))"
  {x_.body()} => "body({x_})()"
  {nm: ty = val} => "@field {nm}::{ty} = {val}"
  {nm: ty} => "@field {nm}::{ty}"
  {nm = val} => "@field {nm}::Any = {val}"
  {static nm: ty = val} => "@static_field {nm} = {val}"
  {static nm = val} => "@static_field {nm} = {val}"
  {nm (): ret => mbody} => "function {nm.method}(self::__class__)\n{mbody.returned.indent}\nend"
  {nm () => mbody} => "function {nm.method}(self::__class__)\n{mbody.returned.indent}\nend"
  {static nm (): ret => mbody} => "function {nm.method}(self::Type{{<:__class__}})\n{mbody.returned.indent}\nend"
  {static nm () => mbody} => "function {nm.method}(self::Type{{<:__class__}})\n{mbody.returned.indent}\nend"
  {nm (paramlist): ret => mbody} => "function {nm.method}(self::__class__, {paramlist}_...)\n{mbody.returned.indent}\nend"
  {nm (paramlist) => mbody} => "function {nm.method}(self::__class__, {paramlist}_...)\n{mbody.returned.indent}\nend"
  {static nm (paramlist): ret => mbody} => "function {nm.method}(self::Type{{<:__class__}}, {paramlist}_...)\n{mbody.returned.indent}\nend"
  {static nm (paramlist) => mbody} => "function {nm.method}(self::Type{{<:__class__}}, {paramlist}_...)\n{mbody.returned.indent}\nend"
  {nm (paramlist): ret} => "function {nm.method}(self::__class__, _...)\n  fail(j\"{nm} is declared but not defined by anyone\")\nend"
  {nm (paramlist)} => "function {nm.method}(self::__class__, _...)\n  fail(j\"{nm} is declared but not defined by anyone\")\nend"
  {nm (): ret} => "function {nm.method}(self::__class__)\n  fail(j\"{nm} is declared but not defined by anyone\")\nend"
  {nm ()} => "function {nm.method}(self::__class__)\n  fail(j\"{nm} is declared but not defined by anyone\")\nend"
  {static nm (paramlist): ret} => "function {nm.method}(self::Type{{<:__class__}}, _...)\n  fail(j\"{nm} is declared but not defined by anyone\")\nend"
  {static nm (paramlist)} => "function {nm.method}(self::Type{{<:__class__}}, _...)\n  fail(j\"{nm} is declared but not defined by anyone\")\nend"
  {rule /rid "nm" | rt () => rbody} => "@rule {over} {single} Rule(id = \"/{rid}\", name = j{nm.quoted}, rate = j{rt.quoted}, over = j{over.quoted}, single = {single}, where_ = {where}, source = {source}, body = (function (_...)\n{rbody.returned.indent}\nend))"
  {rule /rid "nm" () => rbody} => "@rule {over} {single} Rule(id = \"/{rid}\", name = j{nm.quoted}, rate = nothing, over = j{over.quoted}, single = {single}, where_ = {where}, source = {source}, body = (function (_...)\n{rbody.returned.indent}\nend))"
  {rule /rid "nm" | rt (paramlist) => rbody} => "@rule {over} {single} Rule(id = \"/{rid}\", name = j{nm.quoted}, rate = j{rt.quoted}, over = j{over.quoted}, single = {single}, where_ = {where}, source = {source}, body = (function ({paramlist}_...)\n{rbody.returned.indent}\nend))"
  {rule /rid "nm" (paramlist) => rbody} => "@rule {over} {single} Rule(id = \"/{rid}\", name = j{nm.quoted}, rate = nothing, over = j{over.quoted}, single = {single}, where_ = {where}, source = {source}, body = (function ({paramlist}_...)\n{rbody.returned.indent}\nend))"
  {choose "nm" (paramlist): ret} => "function choose_{nm.identifier}(self::__class__, _...)\n  fail(j\"the choice {nm} is not defined by anyone\")\nend"
  {choose "nm" (paramlist): ret => cbody} => "function choose_{nm.identifier}(self::__class__, {paramlist}_...)\n{cbody.returned.indent}\nend"
  {choose "nm" (paramlist) => cbody} => "function choose_{nm.identifier}(self::__class__, {paramlist}_...)\n{cbody.returned.indent}\nend"
  {as (=== ty) => cbody} => "function as_{ty}(self::__class__)\n{cbody.returned.indent}\nend"

  /* a nested class is a type of its own, reached as `Boundary_Initial` */
  nested (outer: String, inner_name: String, inner: String): String => "{inner}\nconst {outer}_{inner_name} = {inner_name}"

  /* a top-level definition is a function of the module, made on first read (`{global_name}`) */
  constant (nm: String, text: String): String => "const _{nm}_cell = Ref{{Any}}(nothing)\nconst _{nm}_made = Ref(false)\nfunction g_{nm}()\n  if !_{nm}_made[]\n    _{nm}_made[] = true\n    _{nm}_cell[] = {text}\n  end\n  _{nm}_cell[]\nend"

  term_literal (id: String, rate: String, degree: N, outside: boolean, settles: boolean, transport: boolean, share: String, rays: String, space: String, folds: String, share_source: String, rays_source: String, space_source: String, folds_source: String, rule_name: String, over: String, where_source: String, rule_source: String, leans: String, carries: boolean, sets: boolean, turned: String, asked: String, asked_source: String, around: String, around_source: String, grown: boolean, grew: String, grew_source: String, trades: boolean, grew_apart: String, grew_apart_source: String): String => {
    rate_ := rate.empty ? "nothing" : "j{rate.quoted}"
    where := where_source.empty ? "nothing" : "Node(source = j{where_source.quoted})"
    rule := id.empty ? "nothing" : "Node(id = j{id.quoted}, rate = {rate_}, name = j{rule_name.quoted}, over = j{over.quoted}, where_ = {where}, source = j{rule_source.quoted})"
    leans_ := leans.empty ? "nothing" : "j{leans.quoted}"
    "    Node(rule = {rule}, rate = {rate_}, degree = {degree}.0, outside = {outside}, settles = {settles}, transport = {transport}, leans = {leans_}, turned = j{turned.quoted}, doing = Node(carries = {carries}, sets = {sets}, grown = {grown}, trades = {trades}, grew = Node(source = j{grew_source.quoted}, at = s -> {grew}), grew_apart = Node(source = j{grew_apart_source.quoted}, at = s -> {grew_apart}), draws = nothing, needs = {degree}.0, outside = {outside}, settles = {settles}, share = Node(source = j{share_source.quoted}, at = s -> {share}), asked = Node(source = j{asked_source.quoted}, at = s -> {asked}), around = Node(source = j{around_source.quoted}, at = s -> {around}), rays = Node(source = j{rays_source.quoted}, at = s -> {rays}), space = Node(source = j{space_source.quoted}, at = s -> {space}), folds = Node(source = j{folds_source.quoted}, at = s -> {folds})))"
  }
  /* the theory's equation, read off it once: a method of `equation` for that theory */
  equation_literal (theory: String, latex: String, terms: String[]): String => {
    lines := terms.join(",\n")
    "@dynamic_names const {theory}_EQUATION = Node(latex = j{latex.quoted}, terms = Any[\n{lines}\n])\nequation(self::typeof({theory})) = {theory}_EQUATION"
  }

  write_package (code: String) => {
    @./languages/physics.jl/README.md := this.readme
    @./languages/physics.jl/src/OrbitMinesPhysics.jl := code
    @./languages/physics.jl/src/Rt.jl = @./implementation/gen/backends/cpu.rt.jl
    @./languages/physics.jl/Project.toml := Julia.project
  }

  test_case (r: Requirement, f: Fixture): String => {
    definition := f.definition.as(Julia)
    requirement := r.requirement.as(Julia)
    filter := r.filter == None ? "true" : r.filter.as(Julia)
    label := "{r.location} on {f.name}"
    "run_case(j{label.quoted}, @dynamic_names(() -> begin\n  it = {definition}\n  guard = 0\n  while !truthy({filter})\n    guard = Base.:+(guard, 1)\n    (Base.:>(guard, {r.until}) || !hasmember(it, :tick)) && return TEST_SKIP\n    tick(it)\n  end\n  truthy({requirement}) ? TEST_PASS : Base.:*(\"failed: \", j{requirement.quoted})\nend))\n"
  }

  /* the cases run in a module that reads every name of the package, as its own code does; the runner's own words are Base's */
  write_tests (cases: String, fixtures: Fixture[]) => {
    @./tests/jl/test_G.jl := "# GENERATED by `npx ray gen` from implementation/physics.ray - do not edit\n# julia tests/jl/test_G.jl [filter]\npush!(LOAD_PATH, joinpath(@__DIR__, \"..\", \"..\", \"languages\", \"physics.jl\"))\nusing OrbitMinesPhysics\n\nmodule TestG\nimport OrbitMinesPhysics\nconst M = OrbitMinesPhysics\nfor n in Base.names(M; all = true, imported = true)\n  s = Base.String(n)\n  (Base.startswith(s, \"#\") || n in (:eval, :include, :OrbitMinesPhysics)) && continue\n  Core.eval(TestG, Base.Expr(:import, Base.Expr(:(:), Base.Expr(:., :OrbitMinesPhysics), Base.Expr(:., n))))\nend\nusing OrbitMinesPhysics.Rt\n\nconst TEST_PASS = \"pass\"\nconst TEST_SKIP = \"skip\"\nconst TEST_COUNTS = Base.Vector{{Int}}([0, 0, 0])\nconst TEST_ONLY = Base.isempty(Base.ARGS) ? nothing : Base.ARGS[1]\nfunction run_case(name::Base.String, body::Base.Function)\n  (TEST_ONLY !== nothing && !Base.occursin(TEST_ONLY, name)) && return\n  t0 = Base.time()\n  got = try\n    Base.string(body())\n  catch e\n    Base.:*(\"error: \", Base.first(Base.sprint(Base.showerror, e), 300))\n  end\n  s = Base.round(Base.:-(Base.time(), t0); digits = 2)\n  mark = Base.:(==)(got, TEST_PASS) ? \"ok  \" : Base.:(==)(got, TEST_SKIP) ? \"skip\" : \"FAIL\"\n  i = Base.:(==)(got, TEST_PASS) ? 1 : Base.:(==)(got, TEST_SKIP) ? 3 : 2\n  TEST_COUNTS[i] = Base.:+(TEST_COUNTS[i], 1)\n  Base.println(mark, \" \", name, \" (\", s, \" s)\", Base.:(==)(i, 2) ? Base.:*(\" - \", Base.replace(got, r\"\\s*\\n\\s*\" => \" \")) : \"\")\n  Base.flush(Base.stdout)\nend\n\n{cases}\nBase.println(TEST_COUNTS[1], \" passed, \", TEST_COUNTS[2], \" failed, \", TEST_COUNTS[3], \" skipped\")\nBase.exit(Base.:>(TEST_COUNTS[2], 0) ? 1 : 0)\nend\n"
  }

  /* Julia renders no films: the .ray/TypeScript pipeline records them */
  {visual "nm" () => vbody} => ""
  write_visuals (entries: String) => { }
  write_notation () => { }

  /* every theorem, as one JSON text: `OrbitMinesPhysics.theorems_json()` */
  write_theorems (proofs: String) => {
    @./languages/physics.jl/src/theorems.json := "{{{proofs}}}"
  }

  write_backend_tests (nm: String, theory: Theory) => { }
  write_backend (nm: String, code: String) => { }


  /* the CPU backend's runtime around the emitted classes */
  cpu_runtime (): String => @./implementation/gen/backends/cpu.runtime.jl
  /* the package's folder under languages/ */
  package_dir (): String => "physics.jl"
  install (): String => "```julia\n# Julia\nusing Pkg; Pkg.add(\"OrbitMinesPhysics\")\n```"
  readme (): String => "# OrbitMinesPhysics - Julia\n\n> Generated by `npx ray gen` from [implementation/physics.ray](../../implementation/physics.ray/) and [implementation/gen](../../implementation/gen/). Do not edit - change the `.ray` and regenerate.\n\nThe physics library in Julia: the theories and their rules, the continuous model derived from them (the medium), and the settings a simulation of sources - stars, planets, any bodies a theory has - is planned by. Back to the [project README](../../README.md).\n\n## Installation\n\n{Julia.install}\n\nJulia 1.9 or later, no dependencies. From a checkout: `julia --project=languages/physics.jl`.\n\n## Using it\n\nEvery class of the library is a Julia type - `Medium <: AbstractMedium <: AbstractNode` - and every member a function dispatched on it: `tick(m)`, `add(m, h)`, `seed(m)`; a static takes the type (`nearest(Geometry, 3, 12)`). An object also reads as a struct does: `m.seed`, `m.local_rays = true`, `m.add(h)`. A theory is its one object (`G`), with its rules (`G.rules`, each a `Rule` with its body) and theorems. Numbers are `Float64`, lists `Vector{{Any}}`, indexed from 0 as Ray indexes them (`getat(xs, 0)`).\n\n```julia\nimport OrbitMinesPhysics as P\n\n# a theory, and its continuous model on the CPU: a box of cells, the vacuum settled, one body in it\nmedium = P.medium(P.G, 31, 96, 3, 8, 1)\nmedium.local_rays = true\nP.add(medium, P.Hole(x = 15, y = 15, mx = 0.3, ways = 1))\nP.seed(medium)\nfor _ in 1:5\n  P.tick(medium)\nend\n```\n\n## A simulation of sources: the plan\n\nA run is set by a `Plan`: how many sources, how big a box, and four kinds of setting - `Resolution` (how finely the medium reads), `Budget` (how much of the device it may take), `Batching` (how a run larger than the device is carried) and `Output` (what comes back). The plan says what the device must hold before anything runs.\n\n```julia\nplan = P.Plan(sources = 1e9, side = 241)\nplan.budget.compact = true   # twelve bytes a source\nprintln(P.report(plan, 16 * 2^30, 2^31))\n```\n\n## Theorems\n\n`OrbitMinesPhysics.theorems_json()` is every theorem, keyed by theory and then by question, as JSON text.\n\n## On the GPU\n\nThe GPU runtime of the medium is being carried into `.ray`, so that every language runs the same thing on every backend. Until then it runs from the [TypeScript package](../physics.ts/README.md).\n"
  project (): String => "# GENERATED by `npx ray gen` from implementation/physics.ray - do not edit\nname = \"OrbitMinesPhysics\"\nuuid = \"49c02cea-eab4-4431-9e6b-273cb9967b25\"\nauthors = [\"OrbitMines\"]\nversion = \"{Release.semver}\"\n\n[compat]\njulia = \"1.9\"\n"
  /* its job in .github/workflows/release.yml (Release.ray): build, keep what it built, publish where the registry's credentials are set */
  release_job (): String => "  julia:\n    needs: version\n    runs-on: ubuntu-latest\n    permissions:\n      contents: write\n    env:\n      PUBLISH: ${{{{ needs.version.outputs.publish }}}}\n      TESTING: ${{{{ needs.version.outputs.testing }}}}\n      REGISTER: ${{{{ vars.JULIA_REGISTRATOR == 'true' }}}}\n    steps:\n      - uses: actions/checkout@v7\n      - uses: julia-actions/setup-julia@v3\n        with:\n          version: \"1\"\n      - name: load\n        run: julia --project=languages/physics.jl -e 'using Pkg; Pkg.instantiate(); using OrbitMinesPhysics' && mkdir -p out && tar czf out/OrbitMinesPhysics.jl-{Release.semver}.tar.gz -C languages physics.jl\n      - uses: actions/upload-artifact@v7\n        with:\n          name: julia\n          path: out/\n          if-no-files-found: error\n      - name: register in Julia's General registry (a test release is not registered - General takes no pre-releases)\n        if: env.PUBLISH == 'true' && env.REGISTER == 'true' && env.TESTING != 'true'\n        run: gh api \"repos/${{{{ github.repository }}}}/commits/${{{{ github.sha }}}}/comments\" -f body='@JuliaRegistrator register subdir=languages/physics.jl'\n        env:\n          GH_TOKEN: ${{{{ github.token }}}}\n"
}
