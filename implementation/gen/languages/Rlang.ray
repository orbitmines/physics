/*
 * R, as a mapping from the constructs of Ray to text (the class is `Rlang`: a class named `R` would be a name the
 * physics code already reads). R's own reference object is the environment, so a Ray object is one: a class is a
 * generator (`Hole$new(x = 9)`, statics `Medium$GATHER`), and every member is a binding of the object, reached with
 * `$` - a field a binding (made on first read where it has a default), a member without parameters an active binding
 * (read, it runs, as a getter does), a method a function bound to the object (`medium$add(h)`); see
 * implementation/gen/backends/cpu.rt.r, which also says why not Reference Classes. A list is an environment around an
 * R vector or list, so that a push is seen by everyone holding it; Ray's indices start at 0 and only `elem`/`set_at`
 * say where R's do.
 *
 * Every function takes `...` last, so a program called with more than it names is not an error (a rule's body, a
 * key given an index). A local written from a lambda inside the scope that bound it goes through `.w`, which finds
 * the frame that holds the name (R's `<-` would make a new local, `<<-` skips the frame it is in). A block lambda
 * taken apart by `for` is a function of its own, so a program made in it keeps its own loop variable; a `return`
 * inside it returns from the method, as it does in every other language: the loop hands it out (`.r`).
 */

Rlang: Language = class {
  name = "R"
  extension = ".R"

  {indent} => "  "
  {separator} => ", "
  {newline} => "\n"
  {statement_end} => ""
  {empty_block} => ""
  {interpolation} => "\" %+% text_of({x}) %+% \""
  {named_arg} => "{nm} = {val}"
  {parameter} => "{nm} = NULL, "
  {parameter_untyped} => "{nm} = NULL, "
  {parameter_default} => "{nm} = {val}, "
  {parameter_separator} => ""
  {dynamic_get} => "mem({tgt}, key_({key}))"
  {dynamic_set} => ".set({tgt}, key_({key}), {val})"
  {reserved_names} => "if else repeat while function for next break TRUE FALSE NULL Inf NaN NA NA_integer_ NA_real_ NA_character_ NA_complex_ in self cl ^_"
  {escaped_name} => "v_{nm}"
  {global_name} => "g_{nm}()"
  {local_write} => ".w(\"{nm}\", {val})"
  {defaults_in_body} => "yes"
  {class_ref} => "{nm}"
  {field_assign} => "field(cl, \"{nm}\", function() {val})"

  /* control flow */
  {if cond { yesbody } else { nobody }} => "if (truthy({cond})) {{\n{yesbody.indent}\n}} else {{\n{nobody.indent}\n}}"
  {if cond { yesbody }} => "if (truthy({cond})) {{\n{yesbody.indent}\n}}"
  {unless cond { yesbody }} => "if (!truthy({cond})) {{\n{yesbody.indent}\n}}"
  {while cond { loopbody }} => "while (truthy({cond})) {{\n{loopbody.indent}\n}}"
  {return val} => "return({val})"
  {return} => "return(NULL)"
  {dynamically assert cond} => "if (!truthy({cond})) stop({cond.quoted})"

  /* definitions and assignment */
  {nm := val} => "{nm} <- {val}"
  {this.nm = rhs} => "self${nm} <- {rhs}"
  {tgt.nm = rhs} => ".set({tgt}, \"{nm}\", {rhs})"
  {lhs = rhs} => "{lhs} <- {rhs}"
  {tgt[k] = rhs} => "set_at({tgt}, {k}, {rhs})"

  /* expressions: `&` and `|` hand back one of their sides, as TypeScript's do, the second read only when it is needed (`.x` holds the first: nothing else is read between its writing and its reading) */
  {a & b} => "(if (truthy(.x <- {a})) {b} else .x)"
  {a | b} => "(if (truthy(.x <- {a})) .x else {b})"
  {!a} => "(!truthy({a}))"
  {-a} => "neg({a})"
  {a == b} => "eq({a}, {b})"
  {a != b} => "(!eq({a}, {b}))"
  {a < b} => "lt({a}, {b})"
  {a <= b} => "le({a}, {b})"
  {a > b} => "gt({a}, {b})"
  {a >= b} => "ge({a}, {b})"
  {a + b} => "r_add({a}, {b})"
  {a - b} => "r_sub({a}, {b})"
  {a * b} => "r_mul({a}, {b})"
  {a / b} => "r_div({a}, {b})"
  {a % b} => "r_mod({a}, {b})"
  {a ^ b} => "r_pow({a}, {b})"
  {a ?? b} => "or_else({a}, {b})"
  {cond ? a : b} => "(if (truthy({cond})) {a} else {b})"
  {a ==.instance_of Array} => "is_list({a})"
  {a ==.instance_of ty} => "instance_of({a}, \"{ty}\")"
  {a as ty} => "{a}"
  {tgt.nm} => "{tgt}${nm.method}"
  {tgt?.nm} => "(if (is.null(.y <- {tgt})) NULL else .y${nm.method})"
  {tgt.nm()} => "{tgt}${nm.method}"
  {tgt?.nm()} => "(if (is.null(.y <- {tgt})) NULL else .y${nm.method})"
  {tgt.nm(arglist)} => "{tgt}${nm.method}({arglist})"
  {tgt?.nm(arglist)} => "(if (is.null(.y <- {tgt})) NULL else .y${nm.method}({arglist}))"
  {tgt.choose("nm")} => "choose_({tgt}, {nm.quoted})"
  {tgt[k]} => "elem({tgt}, {k})"
  {fn()} => "({fn})()"
  {fn(arglist)} => "({fn})({arglist})"
  {Class()} => "{Class}$new()"
  {Class(arglist)} => "{Class}$new({arglist})"
  {[elems]} => "lst({elems})"
  { {} } => "Node$new()"
  {this} => "self"
  {None} => "NULL"
  {true} => "TRUE"
  {false} => "FALSE"
  {"txt"} => "\"{txt}\""
  {(paramlist) => { stmts }} => "function({paramlist}...) {{\n{stmts.returned.indent}\n  NULL\n}}"
  {(paramlist) => e} => "function({paramlist}...) {e}"
  {xs#} => "many({xs})"
  {draw([ws], [os])} => "self$vertex$world$draw(lst({ws}), lst({os}))"

  /* a block taken apart by `for`: a function of its own a turn (so what it makes keeps its own turn), and a `return` in it returns from the method */
  {Array.range(cnt).for((x_) => { stmts })} => ".r <- for_range({cnt}, function({x_.bare}) {{\n{stmts.indent}\n  CONTINUE\n}})\nif (!is.null(.r)) return(.r[[1]])"
  {xs.for((x_) => { stmts })} => ".r <- for_each({xs}, function({x_.bare}) {{\n{stmts.indent}\n  CONTINUE\n}})\nif (!is.null(.r)) return(.r[[1]])"

  /* the recognised classes: a list, a text or a number's own member - and any object's own member of that name otherwise */
  {fail(x_)} => "fail({x_})"
  {Catalogue.number(x_)} => "number({x_})"
  {String(chars: xs)} => "from_codepoints({xs})"
  {x_.blank} => "blank({x_})"
  {xs.push(x_)} => "m_push({xs}, {x_})"
  {xs.chars} => "m_chars({xs})"
  {xs.pop} => "m_pop({xs})"
  {xs.length} => "len({xs})"
  {xs.map(f)} => "m_map({xs}, {f})"
  {xs.filter(f)} => "filt({xs}, {f})"
  {xs.for(f)} => "m_for({xs}, {f})"
  {xs.some(f)} => "m_some({xs}, {f})"
  {xs.every(f)} => "m_every({xs}, {f})"
  {xs.reduce(z, f)} => "m_reduce({xs}, {z}, {f})"
  {xs.starts_with(x_)} => "m_starts_with({xs}, {x_})"
  {xs.ends_with(x_)} => "m_ends_with({xs}, {x_})"
  {xs.replace(x_, y_)} => "m_replace({xs}, {x_}, {y_})"
  {xs.split(x_)} => "m_split({xs}, {x_})"
  {xs.trim} => "m_trim({xs})"
  {xs.upper} => "m_upper({xs})"
  {xs.lower} => "m_lower({xs})"
  {xs.lines} => "m_lines({xs})"
  {xs.quoted} => "quoted({xs})"
  {xs.contains(x_)} => "m_contains({xs}, {x_})"
  {xs.index_of(x_)} => "m_index_of({xs}, {x_})"
  {xs.join(sep)} => "m_join({xs}, {sep})"
  {xs.first} => "m_first({xs})"
  {xs.last} => "m_last({xs})"
  {xs.empty} => "m_empty({xs})"
  {xs.take(cnt)} => "m_take({xs}, {cnt})"
  {xs.drop(cnt)} => "m_drop({xs}, {cnt})"
  {xs.rest} => "m_rest({xs})"
  {xs.concat(ys)} => "m_concat({xs}, {ys})"
  {xs.reverse} => "m_reverse({xs})"
  {xs.sum} => "m_sum({xs})"
  {xs.most(f)} => "m_most({xs}, {f})"
  {xs.sorted_by(f)} => "m_sorted_by({xs}, {f})"
  {xs.each} => "m_each({xs})"
  {Array.range(cnt)} => "rng({cnt})"
  {Array.filled(cnt, x_)} => "filled({cnt}, {x_})"
  {x_.sqrt} => "m_sqrt({x_})"
  {x_.floor} => "m_floor({x_})"
  {x_.abs} => "m_abs({x_})"
  {x_.negated} => "neg({x_})"
  {x_.magnitude} => "m_magnitude({x_})"
  {x_.cos} => "m_cos({x_})"
  {x_.sin} => "m_sin({x_})"
  {x_.round} => "m_round({x_})"
  {x_.ln} => "m_ln({x_})"
  {x_.exp} => "m_exp({x_})"
  {x_.atan2(y_)} => "m_atan2({x_}, {y_})"
  {x_.pow(y_)} => "m_pow({x_}, {y_})"
  {Real.of(x_)} => "{x_}"
  {Real.ZERO} => "0"
  {Real.ONE} => "1"
  {Real.TWO} => "2"
  {Real.PI} => "pi"
  {Real.NAN} => "NaN"
  {Real.INFINITY} => "Inf"
  {Real.TAU} => "(2 * pi)"
  {Random.MODULUS} => "4294967296"
  {Random.MULTIPLIER} => "1664525"
  {Random.INCREMENT} => "1013904223"

  /* classes: a table, filled when the package loads - parents first, as the core lists them */
  {nm := class < sup { membs }} => "{nm.raw} <- ray_class(\"{nm}\", {sup.first}, function(cl) {{\n{membs.indent}\n}})"
  {nm := class { membs }} => "{nm.raw} <- ray_class(\"{nm}\", Node, function(cl) {{\n{membs.indent}\n}})"
  {nm: ty = class { membs }} => "{nm.raw}Theory <- ray_class(\"{nm}\", {ty}, function(cl) {{\n{membs.indent}\n}})\n{nm.raw} <- theory({nm.raw}Theory)"
  {theorem "nm" () => tbody} => "static_field(cl, \"theorem {nm}\", function() Theorem$new(`id` = {nm.quoted}, `body` = function(...) {{\n{tbody.returned.indent}\n  NULL\n}}))"
  {x_.body()} => "{x_}$body()"
  {nm: ty = val} => "field(cl, \"{nm}\", function() {val})"
  {nm: ty} => "field(cl, \"{nm}\", NULL)"
  {nm = val} => "static_field(cl, \"{nm}\", function() {val})"
  {static nm: ty = val} => "static_field(cl, \"{nm}\", function() {val})"
  {static nm = val} => "static_field(cl, \"{nm}\", function() {val})"
  {nm (): ret => mbody} => "getter(cl, \"{nm.method}\", function() {{\n{mbody.returned.indent}\n  NULL\n}})"
  {nm () => mbody} => "getter(cl, \"{nm.method}\", function() {{\n{mbody.returned.indent}\n  NULL\n}})"
  {static nm (): ret => mbody} => "static_getter(cl, \"{nm.method}\", function() {{\n{mbody.returned.indent}\n  NULL\n}})"
  {static nm () => mbody} => "static_getter(cl, \"{nm.method}\", function() {{\n{mbody.returned.indent}\n  NULL\n}})"
  {nm (paramlist): ret => mbody} => "method(cl, \"{nm.method}\", function({paramlist}...) {{\n{mbody.returned.indent}\n  NULL\n}})"
  {nm (paramlist) => mbody} => "method(cl, \"{nm.method}\", function({paramlist}...) {{\n{mbody.returned.indent}\n  NULL\n}})"
  {static nm (paramlist): ret => mbody} => "statik(cl, \"{nm.method}\", function({paramlist}...) {{\n{mbody.returned.indent}\n  NULL\n}})"
  {static nm (paramlist) => mbody} => "statik(cl, \"{nm.method}\", function({paramlist}...) {{\n{mbody.returned.indent}\n  NULL\n}})"
  {nm (paramlist): ret} => "method(cl, \"{nm.method}\", function(...) stop(\"{nm} is declared but not defined by anyone\"))"
  {nm (paramlist)} => "method(cl, \"{nm.method}\", function(...) stop(\"{nm} is declared but not defined by anyone\"))"
  {nm (): ret} => "getter(cl, \"{nm.method}\", function() stop(\"{nm} is declared but not defined by anyone\"))"
  {nm ()} => "getter(cl, \"{nm.method}\", function() stop(\"{nm} is declared but not defined by anyone\"))"
  {static nm (paramlist): ret} => "statik(cl, \"{nm.method}\", function(...) stop(\"{nm} is declared but not defined by anyone\"))"
  {static nm (paramlist)} => "statik(cl, \"{nm.method}\", function(...) stop(\"{nm} is declared but not defined by anyone\"))"
  {rule /rid "nm" | rt () => rbody} => "static_field(cl, \"rule {rid}\", function() Rule$new(`id` = \"/{rid}\", `name` = {nm.quoted}, `rate` = {rt.quoted}, `over` = {over.quoted}, `single` = {single}, `where` = {where}, `source` = {source.quoted}, `body` = function(...) {{\n{rbody.returned.indent}\n  NULL\n}}))"
  {rule /rid "nm" () => rbody} => "static_field(cl, \"rule {rid}\", function() Rule$new(`id` = \"/{rid}\", `name` = {nm.quoted}, `rate` = NULL, `over` = {over.quoted}, `single` = {single}, `where` = {where}, `source` = {source.quoted}, `body` = function(...) {{\n{rbody.returned.indent}\n  NULL\n}}))"
  {rule /rid "nm" | rt (paramlist) => rbody} => "static_field(cl, \"rule {rid}\", function() Rule$new(`id` = \"/{rid}\", `name` = {nm.quoted}, `rate` = {rt.quoted}, `over` = {over.quoted}, `single` = {single}, `where` = {where}, `source` = {source.quoted}, `body` = function({paramlist}...) {{\n{rbody.returned.indent}\n  NULL\n}}))"
  {rule /rid "nm" (paramlist) => rbody} => "static_field(cl, \"rule {rid}\", function() Rule$new(`id` = \"/{rid}\", `name` = {nm.quoted}, `rate` = NULL, `over` = {over.quoted}, `single` = {single}, `where` = {where}, `source` = {source.quoted}, `body` = function({paramlist}...) {{\n{rbody.returned.indent}\n  NULL\n}}))"
  {choose "nm" (paramlist): ret} => "method(cl, \"choose {nm}\", function(...) stop(\"the choice {nm} is not defined by anyone\"))"
  {choose "nm" (paramlist): ret => cbody} => "method(cl, \"choose {nm}\", function({paramlist}...) {{\n{cbody.returned.indent}\n  NULL\n}})"
  {choose "nm" (paramlist) => cbody} => "method(cl, \"choose {nm}\", function({paramlist}...) {{\n{cbody.returned.indent}\n  NULL\n}})"
  {as (=== ty) => cbody} => "getter(cl, \"as_{ty}\", function() {{\n{cbody.returned.indent}\n  NULL\n}})"

  /* a nested class is a table of its own, then a static of the outer one */
  nested (outer: String, inner_name: String, inner: String): String => "{inner}\n{outer}${inner_name} <- {inner_name}\n{outer}.{inner_name} <- {inner_name}"

  /* a top-level definition is a function of the package, made on first call (`{global_name}`) */
  constant (nm: String, text: String): String => "g_{nm} <- lazy_constant(function() {text})"

  term_literal (id: String, rate: String, degree: N, outside: boolean, settles: boolean, transport: boolean, share: String, rays: String, space: String, folds: String, share_source: String, rays_source: String, space_source: String, folds_source: String, rule_name: String, over: String, where_source: String, rule_source: String, leans: String, carries: boolean, sets: boolean, turned: String, asked: String, asked_source: String, around: String, around_source: String, grown: boolean, grew: String, grew_source: String, trades: boolean, grew_apart: String, grew_apart_source: String): String => {
    rate_ := rate.empty ? "NULL" : rate.quoted
    where := where_source.empty ? "NULL" : "Node$new(source = {where_source.quoted})"
    rule := id.empty ? "NULL" : "Node$new(id = {id.quoted}, rate = {rate_}, name = {rule_name.quoted}, over = {over.quoted}, where = {where}, source = {rule_source.quoted})"
    leans_ := leans.empty ? "NULL" : leans.quoted
    "    Node$new(rule = {rule}, rate = {rate_}, degree = {degree}, outside = {outside}, settles = {settles}, transport = {transport}, leans = {leans_}, turned = {turned.quoted}, doing = Node$new(carries = {carries}, sets = {sets}, grown = {grown}, trades = {trades}, grew = at({grew_source.quoted}, function(s) {grew}), grew_apart = at({grew_apart_source.quoted}, function(s) {grew_apart}), draws = NULL, needs = {degree}, outside = {outside}, settles = {settles}, share = at({share_source.quoted}, function(s) {share}), asked = at({asked_source.quoted}, function(s) {asked}), around = at({around_source.quoted}, function(s) {around}), rays = at({rays_source.quoted}, function(s) {rays}), space = at({space_source.quoted}, function(s) {space}), folds = at({folds_source.quoted}, function(s) {folds})))"
  }
  equation_literal (theory: String, latex: String, terms: String[]): String => {
    lines := terms.join(",\n")
     ".set({theory}, \"equation\", Node$new(latex = {latex.quoted}, terms = lst(\n{lines}\n)))"
  }

  write_package (code: String) => {
    @./languages/physics.r/README.md := this.readme
    @./languages/physics.r/DESCRIPTION := Rlang.description
    @./languages/physics.r/NAMESPACE := "# GENERATED by `npx ray gen` from implementation/physics.ray - do not edit\nexportPattern(\"^[^\\\\.]\")\nimportFrom(jsonlite, fromJSON)\nS3method(print, ray_rule)\nS3method(format, ray_rule)\nS3method(print, ray_many)\nS3method(\"$\", ray_many)\nS3method(\"$<-\", ray_many)\n"
    @./languages/physics.r/LICENSE := "YEAR: 2026\nCOPYRIGHT HOLDER: OrbitMines\n"
    @./languages/physics.r/R/rt.R := @./implementation/gen/backends/cpu.rt.r
    @./languages/physics.r/R/physics.R := code
  }

  test_case (r: Requirement, f: Fixture): String => {
    definition := f.definition.as(Rlang)
    requirement := r.requirement.as(Rlang)
    filter := r.filter == None ? "TRUE" : r.filter.as(Rlang)
    label := "{r.location} on {f.name}"
    "t_case({label.quoted}, function() {{\n  it <- {definition}\n  guard <- 0\n  while (!truthy({filter})) {{\n    guard <- guard + 1\n    if (guard > {r.until} || !has(it, \"tick\")) return(\"skip\")\n    it$tick\n  }}\n  if (truthy({requirement})) \"pass\" else paste0(\"failed: \", {requirement.quoted})\n}})"
  }

  write_tests (cases: String, fixtures: Fixture[]) => {
    @./tests/r/test_G.R := "# GENERATED by `npx ray gen` from implementation/physics.ray - do not edit\n# Rscript tests/r/test_G.R [filter] - every requirement on every fixture the package carries; a filter keeps the cases whose name contains it\noptions(expressions = 500000)\n.here <- local({{\n  a <- commandArgs(FALSE)\n  f <- sub(\"^--file=\", \"\", a[grep(\"^--file=\", a)])\n  if (length(f)) dirname(normalizePath(f[1])) else getwd()\n}})\n.lib <- file.path(.here, \"..\", \"..\", \"languages\", \"physics.r\", \"R\")\nfor (.f in c(\"rt.R\", \"physics.R\", \"theorems.R\")) source(file.path(.lib, .f), encoding = \"UTF-8\", keep.source = FALSE)\n\n.only <- commandArgs(TRUE)\n.only <- if (length(.only)) .only[1] else NULL\n.passed <- 0\n.failed <- 0\n.skipped <- 0\nt_case <- function(name, body) {{\n  if (!is.null(.only) && !grepl(.only, name, fixed = TRUE)) return(invisible(NULL))\n  t0 <- proc.time()[[\"elapsed\"]]\n  got <- tryCatch(text_of(body()), error = function(e) paste0(\"error: \", conditionMessage(e)))\n  s <- proc.time()[[\"elapsed\"]] - t0\n  if (identical(got, \"pass\")) .passed <<- .passed + 1 else if (identical(got, \"skip\")) .skipped <<- .skipped + 1 else .failed <<- .failed + 1\n  cat(sprintf(\"%s %s (%.2f s)%s\\n\", if (identical(got, \"pass\")) \"ok  \" else if (identical(got, \"skip\")) \"skip\" else \"FAIL\", name, s, if (got %in% c(\"pass\", \"skip\")) \"\" else paste0(\" - \", got)))\n  invisible(NULL)\n}}\n\n{cases}\n\ncat(sprintf(\"%d passed, %d failed, %d skipped\\n\", .passed, .failed, .skipped))\nquit(status = if (.failed > 0) 1 else 0)\n"
  }

  /* R renders no films: the .ray/TypeScript pipeline records them */
  {visual "nm" () => vbody} => ""
  write_visuals (entries: String) => { }
  write_notation () => { }

  /* every theorem, as one JSON text in inst/, read with `theorems()` */
  write_theorems (proofs: String) => {
    @./languages/physics.r/inst/theorems.json := "{{{proofs}}}"
    @./languages/physics.r/R/theorems.R := "# GENERATED by `npx ray gen` from implementation/physics.ray - do not edit\n# what the rules come to, as something to look up: every theorem, keyed by theory and then by question\n\n# every theorem, as a nested list (read once, from the package's inst/theorems.json)\ntheorems <- local({{\n  proved_ <- NULL\n  function() {{\n    if (is.null(proved_)) {{\n      path <- system.file(\"theorems.json\", package = \"orbitmines\")\n      if (!nzchar(path)) path <- file.path(getOption(\"orbitmines.root\", \"languages/physics.r\"), \"inst\", \"theorems.json\")\n      proved_ <<- jsonlite::fromJSON(path, simplifyVector = FALSE)\n    }}\n    proved_\n  }}\n}})\n# one theorem, or NULL - and never an error\nproved <- function(of, theory, theorem) of[[theory]][[theorem]]\n# which theories have an answer to a question\ntheories <- function(of, theorem) Filter(function(t) !is.null(of[[t]][[theorem]]), names(of))\n# every question a theory answers\nasked <- function(of, theory) names(of[[theory]])\n"
  }

  write_backend_tests (nm: String, theory: Theory) => { }
  write_backend (nm: String, code: String) => { }

  /* the CPU backend's runtime around the emitted classes */
  cpu_runtime (): String => @./implementation/gen/backends/cpu.runtime.r
  /* the package's folder under languages/ */
  package_dir (): String => "physics.r"
  install (): String => "```r\n# R\ninstall.packages(\"orbitmines\")\n```"
  readme (): String => "# orbitmines - R\n\n> Generated by `npx ray gen` from [implementation/physics.ray](../../implementation/physics.ray/) and [implementation/gen](../../implementation/gen/). Do not edit - change the `.ray` and regenerate.\n\nThe physics library in R: the theories and their rules, the continuous model derived from them (the medium), and the settings a simulation of sources - stars, planets, any bodies a theory has - is planned by. Back to the [project README](../../README.md).\n\n## Installation\n\n{Rlang.install}\n\nOr from this repository: `remotes::install_github(\"orbitmines/physics\", subdir = \"languages/physics.r\")`, or from an r-universe that carries it. R 4.1 or later; it imports `jsonlite`.\n\n## Using it\n\nA Ray object is an R reference object - an environment - and its members are reached with `$`: `Hole$new(x = 15, y = 15)` makes one, `medium$add(h)` calls a method, `medium$local_rays <- TRUE` sets a field. A member without parameters reads like a field and runs when it is read (`medium$seed`, `medium$tick`), as a getter does; statics hang off the class (`Medium$GATHER`, `Expr$simplify(e)`). Numbers are doubles, `NULL` is None, and a Ray list is shared by whoever holds it, so it is `lst(...)`, read with `elem(xs, 0)` (Ray counts from 0) and `items(xs)` (its R vector or list).\n\n```r\nlibrary(orbitmines)\n\n# a theory, and its continuous model on the CPU: a box of cells, the vacuum settled, one body in it\nmedium <- G$medium(31, 96, 3, 8, 1)\nmedium$local_rays <- TRUE\nmedium$add(Hole$new(x = 15, y = 15, mx = 0.3, ways = 1))\nmedium$seed\nfor (t in 1:5) medium$tick\n\n# a theory's rules are data\nG$rules\n```\n\n## A simulation of sources: the plan\n\nA run is set by a `Plan`: how many sources, how big a box, and four kinds of setting - `Resolution` (how finely the medium reads), `Budget` (how much of the device it may take), `Batching` (how a run larger than the device is carried) and `Output` (what comes back). The plan says what the device must hold before anything runs.\n\n```r\nplan <- Plan$new(sources = 1e9, side = 241)\nplan$budget$compact <- TRUE   # twelve bytes a source\ncat(plan$report(16 * 2^30, 2^31), \"\\n\")\n```\n\n## Theorems\n\n`theorems()` is every theorem, keyed by theory and then by question; `proved(theorems(), \"G\", question)` is one of them, or `NULL`.\n\n## On the GPU\n\nThe GPU runtime of the medium is being carried into `.ray`, so that every language runs the same thing on every backend. Until then it runs from the [TypeScript package](../physics.ts/README.md).\n"
  description (): String => "Package: orbitmines\nType: Package\nTitle: {Release.description}\nVersion: {Release.numeric}\nAuthor: OrbitMines\nMaintainer: OrbitMines <fadi.shawki@orbitmines.com>\nDescription: {Release.description}.\nLicense: MIT + file LICENSE\nURL: https://github.com/orbitmines/physics\nBugReports: https://github.com/orbitmines/physics/issues\nDepends: R (>= 4.1)\nImports: compiler, jsonlite\nEncoding: UTF-8\nCollate: 'rt.R' 'physics.R' 'theorems.R'\n"
  /* its job in .github/workflows/release.yml (Release.ray): build, keep what it built, publish where the registry's credentials are set */
  release_job (): String => "  r:\n    needs: version\n    runs-on: ubuntu-latest\n    env:\n      PUBLISH: ${{{{ needs.version.outputs.publish }}}}\n      TESTING: ${{{{ needs.version.outputs.testing }}}}\n    steps:\n      - uses: actions/checkout@v7\n      - uses: r-lib/actions/setup-r@v2\n      - name: build\n        run: mkdir -p out && cd out && R CMD build ../languages/physics.r\n      - uses: actions/upload-artifact@v7\n        with:\n          name: r\n          path: out/\n          if-no-files-found: error\n      - name: CRAN takes a package by its web form; r-universe builds it from the repository\n        if: env.PUBLISH == 'true'\n        run: echo \"submit out/orbitmines_{Release.numeric}.tar.gz at https://cran.r-project.org/submit.html (a test release goes to r-universe only)\"\n"
}
