/*
 * THE LINE, INTEGRATED - the continuous reading of a theory run on a box, as an interpreter of its rules.
 *
 * A Field holds a COUNT per direction per cell, n[a, c] - how many rays' worth stand at a cell on a
 * heading; a way may hold many, and a boolean the rules ask of a way (`active`) reads as its activity,
 * min(1, n). Every tick does what the equation's terms say, in the tick's own structure:
 *
 *   ONE THING A TICK. Every rule reads the world the tick opened with (`was`, and the fold record as
 *   it opened): what a rule makes this tick - rays created on a neutral point, rays a source lights,
 *   folds a meeting leaves, folds a creation hands back - is the output of the tick, and no rule of
 *   the same tick sees it. A match belongs to the first rule that takes it, in the theory's order: a
 *   ray a meeting took is not there for a later rule to move or absorb (`view`). So on an empty box
 *   every point splits on one tick and every edge meets on the next - period two - and the folds
 *   the meetings leave stand for the whole of the next tick, when what is out of phase with the
 *   vacuum moves through them.
 *
 *   THE TERMS. The point terms (Creation) fire on every cell against the symbols there; the meeting
 *   terms (Annihilation) fire between a ray at a cell and the ray facing it across the edge - the
 *   opposite heading at the cell one step on - and each end takes its own half of what one match
 *   does to the ledgers; the transport term (Movement) is the rule's own draw, run: straight on to the
 *   same heading one step on with weight one, or across a folded way with the weight it was folded,
 *   the heading kept. A source's rules are run on the line's proxies by `Bodies`.
 *
 * The symbols a term's share is read against come off the theory's own aliases (rho is an end's
 * activity, n_f a point's folds, omega the room ahead, F a facing pair, DEG a point's ways, a rate one
 * per match per tick) evaluated at the cell; nothing here knows what a rule is. Resolutions - A
 * directions, K cells per c-bar - must not move the answer; `aim` keeps the sub-cell remainder of
 * every heading so that the mean displacement per tick is exactly K.
 */

Hole := class < Source, x: Real, y: Real, mx: Real, ways: N {
  tag: N? = None
  /* the momentum it is put in with */
  px: Real = 0
  py: Real = 0
  /* how many ticks it spent stepping, over how many it has seen - beta, measured */
  moved: N = 0
  choose "mass" (): Real => {
    weight := this.mx * Real.of(this.ways)
    weight < 0.000000000001 ? 0.000000000001 : weight
  }
  choose "emit?" (exit: N): boolean => true
  /* what one lit heading carries PER EDGE: the hole's ways over the lattice's DEG ways, each lit at m-bar_x - so many rays' worth; a heading of the line stands for DEG/A edges (`edge`), and holds many */
  per_way (): Real => this.mass / Real.of(this.world.DEG)
  /* the whole of the momentum, for a reading */
  px_now (): Real => this.momentum.components[0]
  py_now (): Real => this.momentum.components[1]
}

/* the world around a hole, as far as the source rules ask: its geometry - the line's A headings, K cells to a step - and the lattice's own degree DEG, which the headings sample */
Around := class < geometry: Geometry, DEG: N { }

/*
 * THE LATTICE ELEMENTS A SOURCE RULE TOUCHES, STOOD IN FOR BY THE LINE. A rule about a Boundary or a
 * Source is a program over points, rays and ends; on the line a point is a cell, a ray is what stands
 * at a cell on one heading - so many rays' worth, `count` - and an end is the cell it leaves by. The
 * rule's own body does the rest: `deactivate` takes what arrived, `activate` lights the neighbour,
 * `momentum` is added to and taken from by the rule's own lines. The backing (`of`) is whatever runs
 * the line - the CPU field, or a device's readback - through `was_at`, `absorb`, `light`, `blocks_at`,
 * `hop_from`, `source_at`, `geometry`.
 */
Cell := class < of: *, index: N {
  source: Source? = this.of.source_at(this.index)
  vacuum (): boolean => this.of.blocks_at(this.index) == 0
  /* does the source standing here light exit d this tick - as a Vertex answers it */
  emits (d: N): boolean => this.source != None & this.source.emits(d)
  /* the folds here as the tick opened, one count per heading - as a Vertex holds them, per way of the lattice */
  folds (): Real[] => this.of.folds_at(this.index)
  /* the cell across exit d, if there is one */
  outward (d: N): Cell? => {
    c := this.of.hop_from(this.index, d)
    c < 0 ? None : Cell(of: this.of, index: c)
  }
}
Beam := class < vertex: Cell, exit: N, count: Real {
  /* what one lit ray of this beam's source carries - the recoil the rule takes per lit exit */
  recoil: Real = 0
  /* whose rays these are, where a source lit them */
  tag: N? = None
  active (): boolean => this.count > 0
  /* is a ray there, continuously: one at most is asked of a way by one match */
  activity (): Real => this.count > 1 ? 1 : this.count
  /* the heading, one ray's worth per edge, over the DEG/A edges this heading stands for: the one the match takes - or, once taken, the one it lit */
  along (): Vector => this.vertex.of.geometry.V(this.exit) * ((this.active ? this.activity : this.recoil) * this.vertex.of.edge)
  /* the same heading one step on: the neighbour's ray this source lights, carrying what one way carries */
  steps (): Beam? => {
    there := this.vertex.outward(this.exit)
    return None if there == None
    lit := Beam(vertex: there, exit: this.exit, count: this.vertex.source == None ? 0 : this.vertex.source.per_way)
    lit.recoil = lit.count
    lit.tag = this.vertex.source == None ? None : this.vertex.source.tag
    lit
  }
  /* one match takes one ray of the way */
  deactivate () => {
    this.vertex.of.absorb(this.exit, this.vertex.index, this.activity) if this.count > 0
    this.count = 0
  }
  activate () => this.vertex.of.light(this.exit, this.vertex.index, this.count, this.tag)
}
Port := class < vertex: Cell, ray: Beam {
  emits (): boolean => this.vertex.emits(this.ray.exit)
}

/* the theory's source rules, run on the holes of a line - the same programs the discrete world runs on a Source */
Bodies := class {
  /* what a tick does to every source before any rule: nothing spent yet (World.tick) */
  static begin (holes: Hole[]) => { holes.for(h => { h.stepped = false; h.moved_along = None }) }
  /* the rules about an end of a ray (Emission): one port per hole per heading, the rule's own match and body */
  static radiate (of: *, rules: Rule[], holes: Hole[]) => {
    about := rules.filter(r => r.over == "Boundary")
    about.for(rule => {
      holes.for(h => {
        h.cells.for(cell => {
          here := Cell(of: of, index: cell.index)
          Array.range(of.geometry.DEG).for(a => {
            beam := Beam(vertex: here, exit: a, count: of.was_at(a, cell.index))
            beam.recoil = h.per_way
            port := Port(vertex: here, ray: beam)
            rule.apply(port) if rule.where == None | rule.where(port)
          })
        })
      })
    })
  }
  /* a hole put into a line at cell c: its world, the momentum it was thrown with, the cell it stands on */
  static enter (of: *, h: Hole, c: Z) => {
    h.world = Around(geometry: of.geometry, DEG: of.DEG)
    h.momentum = Vector(components: [h.px, h.py])
    h.advance = Vector.zero(2)
    h.cells = c < 0 ? [] : [Cell(of: of, index: c)]
  }
  /* the rules about a source (Transport): the hole itself is the match */
  static transport (of: *, rules: Rule[], holes: Hole[]) => {
    about := rules.filter(r => r.over == "Source")
    about.for(rule => {
      holes.for(h => {
        rule.apply(h) if rule.where == None | rule.where(h)
        if h.stepped {
          h.moved = h.moved + 1
          first_ := h.cells[0]
          h.x = Real.of(of.column_of(first_.index))
          h.y = Real.of(of.row_of(first_.index))
        }
      })
    })
  }
}

Field := class < theory: Theory, N: N, A: N, K: N {
  /*
   * TWO RESOLUTIONS AND ONE DEGREE. The lattice the rules are written for has DEG ways at a point; the line
   * integrates it with A headings and K cells to a step, and neither may move the answer. So a way of the
   * line holds a DENSITY - rays per edge on that heading - and a heading stands for DEG/A edges (`edge`):
   * a sum over the headings of a point is DEG times their mean, never a sum of A separate things.
   */
  DEG: N = 8
  edge (): Real => Real.of(this.DEG) / Real.of(this.A)
  seed: N = 0
  cells (): N => this.N * this.N
  ticks: N = 0
  ambient: Real = 0.5
  seen: N = 0

  /* the occupancy per direction and per cell: direction-major, n[a * cells + c] */
  n: Real[] = Array.filled(this.cells * this.A, 0)
  /* the world the tick opened with */
  was: Real[] = Array.filled(this.cells * this.A, 0)
  /* what the tick made, standing where it was made: created, or lit by a source */
  dN: Real[] = Array.filled(this.cells * this.A, 0)
  /* what the tick took, out of what opened it: by meetings, and by sources - so what moves is was + taken + absorbed */
  taken: Real[] = Array.filled(this.cells * this.A, 0)
  absorbed: Real[] = Array.filled(this.cells * this.A, 0)
  /* what the sources put down, of what the tick made */
  emitted: Real[] = Array.filled(this.cells * this.A, 0)
  out: Real[] = Array.filled(this.cells * this.A, 0)
  /* the bodies' own populations, one per tag above the vacuum's: whose rays stand where */
  tags: N = 1
  by: Real[][] = Array.range(this.tags - 1).map(z => Array.filled(this.cells * this.A, 0))
  by_emitted: Real[][] = Array.range(this.tags - 1).map(z => Array.filled(this.cells * this.A, 0))
  /* the fold record per way: how much of each way at a cell is folded - and as the tick opened, which is what its rules read */
  fold: Real[] = Array.filled(this.cells * this.A, 0)
  fold_was: Real[] = Array.filled(this.cells * this.A, 0)
  /* the ledgers per cell */
  space: Real[] = Array.filled(this.cells, 0)
  folds: Real[] = Array.filled(this.cells, 0)
  destroyed: Real[] = Array.filled(this.cells, 0)
  /* and the part of it that is the first body's rays against another body's - what m-bar m-bar' counts */
  cross: Real[] = Array.filled(this.cells, 0)
  blocks: N[] = Array.filled(this.cells, 0)
  rho: Real[] = Array.filled(this.cells, 0)
  keep: Real[] = Array.filled(this.cells, 1)
  /* the headings: cos, sin; a step is K cells along the heading, exactly */
  ux: Real[] = Array.range(this.A).map(a => (Real.TAU * Real.of(a) / Real.of(this.A)).cos)
  uy: Real[] = Array.range(this.A).map(a => (Real.TAU * Real.of(a) / Real.of(this.A)).sin)
  holes: Hole[] = []
  random: Random = Random(seed: this.seed)

  opposite (a: N): N => (a + this.A / 2) % this.A
  /* how much heading b comes toward heading a: one head-on, nought alongside */
  facing_of (a: N, b: N): Real => (1 - (this.ux[a] * this.ux[b] + this.uy[a] * this.uy[b])) / 2
  at (x: Z, y: Z): Z => (x < 0 | y < 0 | x >= this.N | y >= this.N) ? -1 : y * this.N + x
  index (a: N, c: N): N => a * this.cells + c
  /*
   * ONE STEP, ON A GRID. A ray steps one c-bar along its heading - K cells, which is seldom whole
   * cells. Rounded, every ray of a heading would step the same whole cells every tick and visit one
   * sub-lattice of the box, and a picture would show the rounding as spokes. So a step lands where it
   * lands, by area, on the four cells around its true position: `taps` gives them and their weights -
   * cells past the window's edge are left out (what is there is not integrated). The mean displacement
   * is exact and the resolution K does not move the answer.
   */
  taps (px: Real, py: Real): Array => {
    x0 := px.floor
    y0 := py.floor
    fx := px - Real.of(x0)
    fy := py - Real.of(y0)
    out := []
    [[x0, y0, (1 - fx) * (1 - fy)], [x0 + 1, y0, fx * (1 - fy)], [x0, y0 + 1, (1 - fx) * fy], [x0 + 1, y0 + 1, fx * fy]].for(t => {
      c := this.at(t[0], t[1])
      out.push([c, t[2]]) if c >= 0 & t[2] > 0
    })
    out
  }
  /* the cells one step on along a from c, and the cells whose step along a lands on c, by weight */
  hop (c: N, a: N): Array => this.taps(Real.of(c % this.N) + Real.of(this.K) * this.ux[a], Real.of((c - c % this.N) / this.N) + Real.of(this.K) * this.uy[a])
  back (c: N, a: N): Array => this.taps(Real.of(c % this.N) - Real.of(this.K) * this.ux[a], Real.of((c - c % this.N) / this.N) - Real.of(this.K) * this.uy[a])
  /* how much of a step lands in the box at all */
  inside (ts: Array): Real => { total := 0; ts.for(t => { total = total + t[1] }); total }

  /* the terms of the equation, as the field reads them */
  terms (): Array => this.theory.equation.terms
  acting (): Array => this.terms.filter(t => !t.settles & !t.transport)
  facing (): Array => this.acting.filter(t => t.degree == 2)
  point (): Array => this.acting.filter(t => t.degree != 2 & !t.outside)
  sources (): Array => this.acting.filter(t => t.outside)
  transport_term (): * => this.terms.filter(t => t.transport).first

  /*
   * THE SYMBOLS AT A CELL - what a term's share is evaluated against, read off the theory's own
   * aliases at the state there. An end's activity (rho) is the occupancy at the point, mean over its
   * ways; a point's folds (n_f) its record; a facing pair (F) is one, since the pairing itself is the
   * meeting; the room ahead (omega) is whether a step lands in the box; a point's ways (DEG) are the
   * line's headings; a rate is one per match per tick; and the source's symbols read the source
   * standing there - none where there is none. A point a source stands on is busy, so the vacuum's
   * point terms do not fire there (the reading of `neutral`'s `source == None`).
   */
  /* a boolean of a way, read continuously: is a ray there */
  activity (x: Real): Real => x < 0 ? 0 : (x > 1 ? 1 : x)
  symbols (c: N): {} => {
    s := { }
    s["ρ"] = this.rho[c]
    s["n_f"] = this.folds[c]
    s["DEG"] = this.DEG
    s["F"] = 1
    s["ω"] = 1
    src := this.source_at(c)
    s["Σ"] = src == None ? 0 : 1
    s["β"] = src == None ? 0 : (src.stepped ? 1 : 0)
    this.terms.for(t => { s[t.rate] = 1 if t.rate != None & s[t.rate] == None })
    s
  }
  /* the value of a term's share at a cell, clamped to a probability */
  share (t: *, c: N): Real => {
    v := t.doing.share.at(this.symbols(c))
    v < 0 ? 0 : (v > 1 ? 1 : v)
  }
  count (t: *, which: String, c: N): Real => {
    s := this.symbols(c)
    return t.doing.rays.at(s) if which == "rays"
    return t.doing.space.at(s) if which == "space"
    t.doing.folds.at(s)
  }

  /* what stands at (a, c) as the rules so far have left it: what opened the tick, less what was taken */
  view (i: N): Real => {
    m := this.was[i] + this.taken[i] + this.absorbed[i]
    m < 0 ? 0 : m
  }
  /* the density at every cell: the mean activity over the directions, as the tick opened */
  sweep () => {
    Array.range(this.cells).for(c => { this.rho[c] = 0 })
    Array.range(this.A).for(a => {
      base := a * this.cells
      Array.range(this.cells).for(c => { this.rho[c] = this.rho[c] + this.activity(this.was[base + c]) })
    })
    Array.range(this.cells).for(c => { this.rho[c] = this.rho[c] / Real.of(this.A) })
  }

  /* the folds at every cell as the tick opened: the sum over its ways, and what the draw keeps straight on there - one against one and the folds */
  tally () => {
    Array.range(this.cells).for(c => {
      nf := 0
      Array.range(this.A).for(b => { nf = nf + this.fold_was[b * this.cells + c] })
      nf = nf * this.edge
      this.folds[c] = nf
      this.keep[c] = 1 / (1 + nf)
    })
  }

  /* the point terms: on every cell that is not a source's, against the symbols there; what is made stands where it is made */
  create (terms: Array) => {
    terms.for(t => {
      Array.range(this.cells).for(c => {
        fires := this.blocks[c] > 0 ? 0 : this.share(t, c) * (t.degree > 0 ? this.rho[c] ^ Real.of(t.degree) : 1)
        if fires > 0 {
          per := this.count(t, "rays", c) / Real.of(this.DEG)
          /* a way lit is SET, not added to: what it gains is what it lacked */
          Array.range(this.A).for(a => {
            i := a * this.cells + c
            room := t.doing.sets ? 1 - this.activity(this.was[i]) : 1
            this.dN[i] = this.dN[i] + fires * per * room
          })
          this.space[c] = this.space[c] + fires * this.count(t, "space", c)
          df := fires * this.count(t, "folds", c) / Real.of(this.DEG)
          Array.range(this.A).for(a => {
            f := this.fold[a * this.cells + c] + df
            this.fold[a * this.cells + c] = f < 0 ? 0 : f
          })
        }
      })
    })
  }

  /* how much of a meeting between the ray at i and the ray at j is the first body against another: the same meeting, asked a second question */
  crossing (i: N, j: N, found: Real[]): Real => {
    return 0 if this.tags < 3
    wi := found[i]
    wj := found[j]
    return 0 if wi <= 0 | wj <= 0
    f1i := this.by[0][i] / wi
    f1j := this.by[0][j] / wj
    alli := 0
    allj := 0
    Array.range(this.tags - 1).for(z => { alli = alli + this.by[z][i]; allj = allj + this.by[z][j] })
    alli = alli / wi
    allj = allj / wj
    f1i * (allj - f1j) + (alli - f1i) * f1j
  }

  /*
   * THE MEETING TERMS: the ray at a cell on a heading, against the ray facing it - the opposite heading
   * at the cell one step on. The pair is a match with weight what stands at both ends; one match does to
   * the ledgers what the term says, and each end takes its own half of it: its own ray is what it loses,
   * half the space, and the fold along the way toward the other. What a meeting takes does not move.
   */
  meet (terms: Array) => {
    terms.for(t => {
      /* every meeting reads the world the tick opened with */
      found := this.was
      act := Array.range(this.cells * this.A).map(i => this.activity(this.was[i]))
      Array.range(this.A).for(a => {
        o := this.opposite(a)
        Array.range(this.cells).for(c => {
          if this.blocks[c] == 0 {
            i := a * this.cells + c
            /* the ray facing across the edge: what stands on the opposite heading at the true position one step on, by area; past the window's edge, its mirror here */
            ts := this.hop(c, a)
            facing := 0
            mixed := 0
            ts.for(tp => {
              if this.blocks[tp[0]] == 0 {
                j := o * this.cells + tp[0]
                facing = facing + tp[1] * act[j]
                mixed = mixed + tp[1] * act[j] * this.crossing(i, j, found)
              }
            })
            beyond := 1 - this.inside(ts)
            if beyond > 0 {
              j := o * this.cells + c
              facing = facing + beyond * act[j]
              mixed = mixed + beyond * act[j] * this.crossing(i, j, found)
            }
            w := act[i] * facing * this.share(t, c)
            if w > 0 {
              rays := w * this.count(t, "rays", c) / 2
              this.taken[i] = this.taken[i] + rays
              ds := w * this.count(t, "space", c) / 2
              this.space[c] = this.space[c] + ds * this.edge
              f := this.fold[i] + w * this.count(t, "folds", c) / 2
              this.fold[i] = f < 0 ? 0 : f
              this.destroyed[c] = this.destroyed[c] + ds.abs * this.edge
              this.cross[c] = this.cross[c] + ds.abs * this.edge * (facing > 0 ? mixed / facing : 0)
            }
          }
        })
      })
    })
  }

  /* what moves at (a, c): what opened the tick, less what was taken */
  moving (a: N, c: N): Real => this.view(a * this.cells + c)
  /* the same for one tag's population: its share of what opened the tick, less its share of what was taken */
  moving_of (z: N, a: N, c: N): Real => {
    i := a * this.cells + c
    had := this.by[z][i]
    whole := this.was[i]
    return 0 if had <= 0 | whole <= 0
    f := (whole + this.taken[i] + this.absorbed[i]) / whole
    f = 0 if f < 0
    had * f
  }

  /*
   * THE TRANSPORT TERM IS THE RULE'S OWN DRAW, RUN: a ray at a cell goes straight on - the same heading at
   * the cell one step along it - with weight one, or across a folded way with the weight that way was
   * folded, keeping its heading; where there is no room ahead it makes the room and waits. Every cell
   * gathers its own: from the cell one step back along its heading what was kept straight on, and from
   * each cell one step back across a way what was turned along that way toward here.
   */
  /* where a turned ray goes, off the rule's draw: across the way with its heading "kept", or onto the "way"'s own heading */
  turned (): String => { t := this.transport_term; t == None ? "kept" : t.turned }
  carried (pop: Program): Real[] => {
    out := Array.filled(this.cells * this.A, 0)
    onto_way := this.turned == "way"
    Array.range(this.A).for(a => {
      Array.range(this.cells).for(c => {
        got := 0
        this.back(c, a).for(tp => {
          src := tp[0]
          got = got + tp[1] * pop(a, src) * this.keep[src]
          if onto_way {
            /* what was turned across way a at the cell one step back along a arrives here with heading a, whatever heading it had */
            fa := this.fold_was[a * this.cells + src]
            if fa > 0 {
              Array.range(this.A).for(b => { got = got + tp[1] * pop(b, src) * fa * this.keep[src] * this.edge })
            }
          }
        })
        unless onto_way {
          Array.range(this.A).for(d => {
            this.back(c, d).for(tp => {
              sd := tp[0]
              fd := this.fold_was[d * this.cells + sd]
              got = got + tp[1] * pop(a, sd) * fd * this.keep[sd] * this.edge if fd > 0
            })
          })
        }
        out[a * this.cells + c] = got
      })
    })
    out
  }

  /*
   * THE BOX IS A WINDOW. The world the rules are written for has no edge - a ray with no room ahead
   * makes the room and waits (`leaving.grow`); the line integrates a box of it, and what steps past the
   * box is in the world beyond, which is not integrated. So a ray stepping out is gone from here, not
   * held at the edge, and the ray it would have met across the box's edge is taken to be the mirror of
   * the one here (`meet`): held, or unmet, an outbound ray stands out of phase with everything and
   * seeps back in through the folds, and the box's edge would be doing physics of its own.
   */

  /* everything that opened the tick and was not taken steps along its heading: the whole population, and each tag's own */
  carry () => {
    this.out = this.carried((a: N, c: N): Real => this.moving(a, c))
    Array.range(this.tags - 1).for(z => { this.by[z] = this.carried((a: N, c: N): Real => this.moving_of(z, a, c)) })
    this.moved = true
  }
  /* what was arriving is now what is here, beside what the tick made where it was made: rays are counted, a way holds many */
  settle () => {
    this.carry if !this.moved
    Array.range(this.cells * this.A).for(i => {
      this.n[i] = this.out[i] + this.dN[i]
      Array.range(this.tags - 1).for(z => { this.by[z][i] = this.by[z][i] + this.by_emitted[z][i] })
    })
    this.settled = true
  }
  moved: boolean = false
  settled: boolean = false

  /* what stands at a cell that came from a tag: nought is the vacuum's own, a tag above it a body's */
  arrived (z: N, c: N): Real => {
    total := 0
    Array.range(this.A).for(a => { total = total + this.n[a * this.cells + c] })
    if z == 0 {
      Array.range(this.tags - 1).for(k => { Array.range(this.A).for(a => { total = total - this.by[k][a * this.cells + c] }) })
      return total < 0 ? 0 : total * this.edge
    }
    got := 0
    Array.range(this.A).for(a => { got = got + this.by[z - 1][a * this.cells + c] })
    got * this.edge
  }
  /* the space destroyed at a cell this tick by the first body's rays against another body's */
  crossed (c: N): Real => this.cross[c]
  t (): N => this.ticks
  bodies (): Hole[] => this.holes

  /* ── the line as the source rules see it (Cell, Beam, Port stand on these) ───────────────────── */
  /* the line's geometry as a source rule asks it: A headings, each one step - one c-bar - long; how many cells that is (K) is `hop_from`'s business */
  /* its offsets are the hops themselves, in c-bar: what a body's step along a heading is, so that what it pays for a step is what it took */
  geometry: Geometry = Geometry(name: "line-{this.A}", offsets: Array.range(this.A).map(a => Vector(components: [Real.of(this.hop_x(a)) / Real.of(this.K), Real.of(this.hop_y(a)) / Real.of(this.K)])))
  column_of (c: N): N => c % this.N
  row_of (c: N): N => (c - c % this.N) / this.N
  /* a step of one c-bar along heading d, in whole cells: rounded away from nought, so that a heading and its opposite hop alike - after snapping off the last bits, since cos and sin land a hair either side of a half */
  static whole (x: Real): Z => {
    y := (x * 1000000).round / 1000000
    y < 0 ? 0 - ((0 - y) + 0.5).floor : (y + 0.5).floor
  }
  hop_x (d: N): Z => Field.whole(Real.of(this.K) * this.ux[d])
  hop_y (d: N): Z => Field.whole(Real.of(this.K) * this.uy[d])
  hop_from (c: N, d: N): Z => this.at(this.column_of(c) + this.hop_x(d), this.row_of(c) + this.hop_y(d))
  blocks_at (c: N): N => this.blocks[c]
  source_at (c: N): Source? => this.blocks[c] > 0 ? this.holes[this.blocks[c] - 1] : None
  was_at (a: N, c: N): Real => this.view(a * this.cells + c)
  /* the folds at a cell as the tick opened, per heading, as folds of the lattice's ways: a heading stands for DEG/A edges */
  folds_at (c: N): Real[] => Array.range(this.A).map(e => this.fold_was[e * this.cells + c] * this.edge)
  /* what a source takes: the rays that arrived on a heading at its cell are gone */
  absorb (a: N, c: N, count: Real) => {
    i := a * this.cells + c
    this.dN[i] = this.dN[i] - count
    this.absorbed[i] = this.absorbed[i] - count
  }
  /* what a source puts down: so many rays' worth on a heading at a POINT - the c-bar around the cell one step out, K by K cells, each lit alike - standing there this tick */
  light (a: N, c: N, count: Real, tag: N?) => {
    this.point_of(c).for(cell => {
      i := a * this.cells + cell
      this.dN[i] = this.dN[i] + count
      this.emitted[i] = this.emitted[i] + count
      this.by_emitted[tag - 1][i] = this.by_emitted[tag - 1][i] + count if tag != None & tag > 0 & tag < this.tags
    })
  }
  /* the cells of the point at c: the c-bar around it, K by K, inside the box */
  point_of (c: N): N[] => {
    x := this.column_of(c)
    y := this.row_of(c)
    half := ((Real.of(this.K) - 1) / 2).floor
    out := []
    Array.range(this.K).for(dy => {
      Array.range(this.K).for(dx => {
        cell := this.at(x - half + dx, y - half + dy)
        out.push(cell) if cell >= 0
      })
    })
    out
  }
  /* which cells the bodies stand on, off the bodies themselves */
  block () => {
    Array.range(this.cells).for(c => { this.blocks[c] = 0 })
    Array.range(this.holes.length).for(k => { this.holes[k].cells.for(cell => { this.blocks[cell.index] = k + 1 }) })
  }
  mass (h: Hole): Real => h.mass

  /* one tick of the line, in the order the kernels run it: snapshot, sweep, the bodies, the point
   * terms, the tally, the meetings, the tally, the pool, the carry */
  tick () => {
    Array.range(this.cells * this.A).for(i => { this.was[i] = this.n[i]; this.fold_was[i] = this.fold[i]; this.dN[i] = 0; this.taken[i] = 0; this.absorbed[i] = 0; this.emitted[i] = 0 })
    Array.range(this.tags - 1).for(z => { Array.range(this.cells * this.A).for(i => { this.by_emitted[z][i] = 0 }) })
    Array.range(this.cells).for(c => { this.destroyed[c] = 0; this.cross[c] = 0 })
    this.moved = false
    this.settled = false
    Bodies.begin(this.holes)
    /* the world the tick opened with, read once for every rule */
    this.sweep
    this.tally
    /* every rule in the theory's own order: what one takes, a later one does not have */
    this.theory.rules.for(rule => {
      if rule.over == "Boundary" { Bodies.radiate(this, [rule], this.holes) }
      elsif rule.over == "Source" { Bodies.transport(this, [rule], this.holes); this.block }
      else {
        ts := this.terms.filter(t => t.rule != None & t.rule.id == rule.id)
        meetings := ts.filter(t => !t.settles & !t.transport & t.degree == 2)
        points := ts.filter(t => !t.settles & !t.transport & t.degree != 2 & !t.outside)
        this.meet(meetings) if !meetings.empty
        this.create(points) if !points.empty
        this.carry if ts.some(t => t.transport)
      }
    })
    /* what was arriving is now what is here, with everything the tick made - the tick's output, all at once */
    this.settle
    this.sweep_n
    total := 0
    Array.range(this.cells).for(c => { total = total + this.rho[c] })
    this.seen = this.seen + 1
    span := this.seen < 512 ? this.seen : 512
    this.ambient = this.ambient + (total / Real.of(this.cells) - this.ambient) / Real.of(span)
    this.ticks = this.ticks + 1
  }
  /* the density of what stands at the tick's end */
  sweep_n () => {
    Array.range(this.cells).for(c => { this.rho[c] = 0 })
    Array.range(this.A).for(a => {
      base := a * this.cells
      Array.range(this.cells).for(c => { this.rho[c] = this.rho[c] + this.activity(this.n[base + c]) })
    })
    Array.range(this.cells).for(c => { this.rho[c] = this.rho[c] / Real.of(this.A) })
  }

  /* a body put in: its cell, its world, and the momentum it was thrown with */
  add (h: Hole): Hole => {
    this.holes.push(h)
    Bodies.enter(this, h, this.at(h.x.round, h.y.round))
    this.block
    h
  }

  /* the density at a cell, and over the whole box */
  density (c: N): Real => this.rho[c]
  mean (): Real => {
    total := 0
    Array.range(this.cells).for(c => { total = total + this.rho[c] })
    total / Real.of(this.cells)
  }
}

Theory += {
  /* the continuous reading of this theory on an N by N box; `tags` populations above the vacuum's, one per kind of body */
  field (N: N, A: N = 96, K: N = 4, seed: N = 0, DEG: N = 8, tags: N = 1): Field => Field(theory: this, N: N, A: A, K: K, seed: seed, tags: tags, DEG: DEG)
}
