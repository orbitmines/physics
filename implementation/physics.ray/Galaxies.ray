/*
 * EVERY MEASUREMENT THE LAW IS JUDGED ON, ON ONE PAIR OF AXES.
 *
 * Every point is a pair of accelerations - what the ordinary matter would pull with, and what is
 * actually seen - so SPARC's mass models (the cloud, one point per measured radius), its galaxy sample
 * (one green marker each, at the outermost radius), the baryonic Tully-Fisher relation (the deep
 * asymptote, one line per galaxy) and Genzel's high-redshift discs all belong on the same two axes,
 * scaled by a_0 on both so the curve is universal. THE LINE IS THE RULES': `Law.boost`, what the prover
 * closed off G, measured once; Newton is the diagonal beside it.
 *
 * Behind the measurements sits the region the theory ALLOWS - `visuals/galaxy.point` and
 * `visuals/galaxy.many`, the possibility space `Measure.density` integrated over every mass, face,
 * motion and emissivity a source may define - inked by rank, dim, and coloured by which freedom a cell
 * NEEDS.
 */
Galaxies := class {
  /* the borrowed data is scaled by ITS OWN a_0, the model by the rules': what is compared is the shape */
  static A0_DATA = 1.2 / 10 ^ 10
  /* what the starlight may weigh, either side of SPARC's own 0.5 from stellar populations */
  static YLIGHT = 0.3
  static YHEAVY = 0.8
  static BACK = "#08090d"
  static FAINT = "#5a5f6e"
  static GRID = "rgba(120,127,148,0.13)"
  static SEEN = "#eef0f5"
  static MODEL = "#4aa8eb"
  /* the medium run, measured: its own colour, since the measurements are white and the closed law is blue */
  static RUN = "#f2e05a"
  static NEWT = "#eb964a"
  static DISCC = "#c98bd4"
  static BTFRC = "#cd5c5c"
  /* the measurements are white and the model is coloured: the seen thing reads first */
  static POINTS = "rgba(255,255,255,0.70)"
  static POINTS_LABEL = "#ffffff"
  /* and one green for the galaxies - the count of objects behind the white */
  static GALAXY = "#5fd18a"
  static GALAXY_LABEL = "#8ce0a8"
  static XMIN = -4
  static XMAX = 3
  static YMIN = -3
  static YMAX = 3
  /* which freedom a cell needs, coloured; a combination is the colours of what is in it, mixed */
  static SEVERAL = [86, 168, 235]
  /* the freedoms a source has, in the order the space's own bits are in - the measurement names them, and this is only what to fall back on */
  static FREEDOMS = ["mass", "face", "moving", "spread"]
  static freedoms_of (data: Measured): String[] => data.header["freedoms"] ?? Galaxies.FREEDOMS
  static TINTS = [[232, 193, 90], [90, 212, 193], [240, 122, 178], [169, 139, 224]]

  static bit (mask: N, at: N): boolean => ((mask / 2 ^ at).floor % 2) == 1
  static tint_of (mask: N): Real[] => {
    return Galaxies.SEVERAL if mask == 0
    r := 0
    g := 0
    bl := 0
    n := 0
    Array.range(Galaxies.FREEDOMS.length).for(i => {
      if Galaxies.bit(mask, i) {
        r = r + Galaxies.TINTS[i][0]
        g = g + Galaxies.TINTS[i][1]
        bl = bl + Galaxies.TINTS[i][2]
        n = n + 1
      }
    })
    n > 0 ? [r / n, g / n, bl / n] : Galaxies.SEVERAL
  }
  /* the names the space being drawn uses, set as a panel starts (a picture draws one measurement at a time) */
  static NAMES_NOW = Galaxies.FREEDOMS
  static name_of (mask: N): String => {
    /* the fewest freedoms that reach a cell; nought is the source as it starts - one mass, its own cell, at rest - the law's own line */
    return "the source as it starts" if mask == 0
    parts := []
    Array.range(Galaxies.NAMES_NOW.length).for(i => { parts.push(Galaxies.NAMES_NOW[i]) if Galaxies.bit(mask, i) })
    joined := parts.join(" + ")
    "needs {joined}"
  }
  static rgb (c: Real[]): String => {
    r := c[0].round
    g := c[1].round
    bl := c[2].round
    "rgb({r},{g},{bl})"
  }
  /* where the discs lie, so their name can be laid along them: the nearest disc's own reading */
  static discs_at (lx: Real): Real => {
    best := Real.NAN
    far := 0
    Sparc.discs.for(d => {
      x := Fmt.log10(Sparc.disc_arrival(d) / Galaxies.A0_DATA)
      y := Fmt.log10(Sparc.disc_felt(d) / Galaxies.A0_DATA)
      if Fmt.finite(y) & (!Fmt.finite(best) | (x - lx).abs < far) { best = y; far = (x - lx).abs }
    })
    best
  }
  /* the masses whose reach is drawn, in dex of the rate a source starts at */
  static LEVELS = [-4, -2, 0, 1, 2, 3]
  /* and the masses drawn again for a source laid over nine c-bar, to show what spreading costs */
  static WIDTHS = [0, 2]
  static mass_text (level: Real): String => {
    return "×1 mass" if level == 0
    return "×10 mass" if level == 1
    "×10^{Fmt.fixed(level, 0)} mass"
  }
  static law_at (lx: Real): Real => {
    a0 := Law.a0
    Fmt.log10(Law.boost(10 ^ lx * a0, a0) / a0)
  }
  /*
   * THE POSSIBILITY SPACE, SOLVED RATHER THAN SWEPT. Every freedom a source has enters in one place: what it HOLDS
   * over what it SENDS, `l.held_over_sent(face, beta)` (Aggregate) - a factor of the source alone. So a source's
   * point is the law read at what ARRIVES, carried right by that factor, and the WHOLE space is the law's own curve
   * swept rightward: its upper edge is the law itself, at the smallest a source can be and at rest, and its floor is
   * the law shifted by the most a source can hold over what it lets out. Nothing rises above the law, since every
   * freedom either holds more or sends less
   */
  static carries (): Real => Law.carries
  /* the band at a place: the law above, and the law carried by the most a source can, below */
  static band_at (lx: Real): Real[] => [Galaxies.law_at(lx), Galaxies.law_at(lx - Galaxies.carries)]
  /*
   * WHAT THE LAW ASKS OF THE DATA. The model gives one curve and no scatter - a disk lands where a point does,
   * since what is felt is read at what ARRIVES and nothing about the arrangement enters. So the spread in the sky
   * is the measuring, and its largest free part is what the starlight weighs: SPARC reads the disc at a
   * mass-to-light it takes from stellar populations. Here that is SOLVED instead - the weight that puts the
   * cloud's middle ON the curve - and what it comes to can then be held against what the populations say
   */
  static offsets (YD: Real): Real[] => {
    t := Sparc.curves
    C := t.columns
    out := []
    YB := Sparc.YD > 0 ? YD * Sparc.YB / Sparc.YD : YD
    Array.range(t.rows).for(i => {
      g := C["galaxy"][i]
      R := C["R"][i] * Sparc.KPC
      v := C["Vobs"][i] * Sparc.KMS
      if Sparc.usable(g) & R > 0 & v > 0 & C["e_Vobs"][i] <= 0.1 * C["Vobs"][i] {
        gas := C["Vgas"][i] * Sparc.KMS
        disk := C["Vdisk"][i] * Sparc.KMS
        bul := C["Vbul"][i] * Sparc.KMS
        gbar := (gas * gas.abs + YD * disk * disk.abs + YB * bul * bul.abs) / R
        out.push(Fmt.log10(v * v / R / Galaxies.A0_DATA) - Galaxies.law_at(Fmt.log10(gbar / Galaxies.A0_DATA))) if gbar > 0
      }
    })
    out
  }
  static middle (xs: Real[]): Real => {
    return Real.NAN if xs.empty
    sorted := Expr.sorted(xs)
    sorted[(sorted.length / 2).floor]
  }
  /* the weight the curve asks for, found by halving: the middle rises as the disc is read lighter */
  static asks (): Real => {
    lo := 0.05
    hi := 2
    Array.range(30).for(i => {
      mid := (lo + hi) / 2
      if Galaxies.middle(Galaxies.offsets(mid)) > 0 { lo = mid } else { hi = mid }
    })
    (lo + hi) / 2
  }

  /*
   * AND WHAT THE MEDIUM ITSELF PULLS WITH, measured rather than evaluated: one source alone, its mass swept over
   * decades, the pull read at a spread of radii, and what is proportional to the mass taken as what the source and
   * the shell alone give (`record.gpu` RAY_RAR, written to `law.medium`). Nought where it has not been measured
   */
  /*
   * AND A GALAXY LAID AS MANY SOURCES, measured: rings of bodies in the box's own plane, the pull read along a
   * radius against the same arrangement with nothing of the recursion in it (`record.gpu` RAY_DISK). What it is for
   * is the model's sharpest claim - that the arrangement does not matter, since what is felt is read at what
   * ARRIVES - so every disk should land on the same curve one source gives, and the relation carry no scatter of its own
   */
  static DISK_ID = "law.disk"
  static DISKC = "#8be9fd"
  static MEDIUM_ID = "law.medium"
  static medium_at (lx: Real): Real => {
    m := Measured.of(Galaxies.MEDIUM_ID)
    return Real.NAN if m == None
    xs_ := m.columns["gN"]
    ys_ := m.columns["g"]
    a0 := Law.a0
    want := 10 ^ lx * a0
    n := m.rows
    return Real.NAN if n < 2 | want < xs_[0] | want > xs_[n - 1]
    lo := 0
    hi := n - 1
    while hi - lo > 1 {
      mid := ((lo + hi) / 2).floor
      if xs_[mid] <= want { lo = mid } else { hi = mid }
    }
    span := xs_[hi] - xs_[lo]
    f := span > 0 ? (want - xs_[lo]) / span : 0
    got := ys_[lo] * (1 - f) + ys_[hi] * f
    got > 0 ? Fmt.log10(got / a0) : Real.NAN
  }

  /* a label laid along the line it names, at the angle the line has on screen: the position off `at`, the lean off `leans` */
  static along (s: Surface, at: Program, t: Real, text: String, colour: String, lift: Real, leans: Program) => {
    p0 := leans(t - 0.01)
    p1 := leans(t + 0.01)
    c := at(t)
    angle := (p1[1] - p0[1]).atan2(p1[0] - p0[0])
    s.save
    s.translate(c[0], c[1])
    s.rotate(angle)
    s.font("11px ui-monospace, monospace")
    s.text_align("center")
    s.text_baseline("alphabetic")
    w := s.measure(text)
    s.fill_style(Galaxies.BACK)
    s.fill_rect(0 - w / 2 - 4, lift - 9, w + 8, 12)
    s.fill_style(colour)
    s.fill_text(text, 0, lift)
    s.restore
    s.text_baseline("alphabetic")
  }

  /* the top of the region at a given arrival, so a label can sit above it rather than in it */
  static ceiling_of (data: Measured): Program => {
    x := data.columns["x"]
    y := data.columns["y"]
    p := data.columns["p"]
    grid := data.header["grid"]
    XS := grid["arrives"]["n"]
    YS := grid["felt"]["n"]
    from_x := grid["arrives"]["from"]
    dx := (grid["arrives"]["to"] - from_x) / (XS - 1)
    top := Array.filled(XS, Real.NAN)
    Array.range(XS).for(gx => {
      gy := YS - 1
      while gy >= 0 {
        if p[gy * XS + gx] > 0 { top[gx] = y[gy * XS + gx]; gy = -1 } else { gy = gy - 1 }
      }
    })
    (lx: Real, fallback: Real): Real => {
      gx := ((lx - from_x) / dx).round
      return fallback if gx < 0 | gx >= XS | !Fmt.finite(top[gx])
      Fmt.max(top[gx], fallback)
    }
  }

  /*
   * WHAT A GALAXY IS among everything the medium can do: every galaxy there could be, run through the same field and
   * law as the named ones (`galaxy.possible`, Simulation.ray) on this lattice - in the panel's bins of the data's a_0,
   * how many land in each and where what is felt sits. A galaxy is far too thin to thin the vacuum, so this is where
   * the model puts galaxies; the space around it is what denser sources could reach
   */
  static possible_at (deg: Real): Array => {
    got := Measured.of("galaxy.possible")
    fail("galaxy.possible is not on disk - run the galaxies (`{Galaxies.SIMULATED}`) and try again") if got == None
    ds := got.columns["deg"]
    k := 0
    Array.range(got.rows).for(i => { k = i if (ds[i] - deg).abs < (ds[k] - deg).abs })
    got.header["bins"][k]
  }
  static panel (s: Surface, data: Measured, what: String, deg: Real, support: Real[], possible: Array) => {
    s.fill_style(Galaxies.BACK)
    s.fill_rect(0, 0, s.width, s.height)
    s.font("12px ui-monospace, monospace")
    a0 := Law.a0
    /* the bottom margin holds the key, and is sized for it */
    bx0 := 92
    bx1 := s.width - 26
    by0 := 82
    by1 := s.height - 132
    XMIN := Galaxies.XMIN
    XMAX := Galaxies.XMAX
    YMIN := Galaxies.YMIN
    YMAX := Galaxies.YMAX
    X := (l: Real): Real => bx0 + (l - XMIN) / (XMAX - XMIN) * (bx1 - bx0)
    Y := (l: Real): Real => by1 - (l - YMIN) / (YMAX - YMIN) * (by1 - by0)
    /*
     * ONE SCALE FOR BOTH SIDES, IN m/s^2. The axes are in the data's a_0 (1.2e-10). The model's side - the space, run
     * in the vacuum's own a_0 of its lattice, and the law - is laid in that same unit: the chain's a_0/cH at this DEG
     * times c H_0 is the vacuum's a_0 in m/s^2, and `shift` is how many dex that is from the data's. Nothing is fitted
     */
    Galaxies.NAMES_NOW = Galaxies.freedoms_of(data)
    shift := Galaxies.shift_at(data, deg)
    law_drawn := (t: Real): Real => Galaxies.law_at(t - shift) + shift

    /* grid */
    s.stroke_style(Galaxies.GRID)
    s.line_width(1)
    s.fill_style(Galaxies.FAINT)
    s.text_align("center")
    l := XMIN
    while l <= XMAX {
      s.begin_path
      s.move_to(X(l), by0)
      s.line_to(X(l), by1)
      s.stroke
      s.fill_text("10^{l}", X(l), by1 + 17)
      l = l + 1
    }
    s.text_align("right")
    l = YMIN
    while l <= YMAX {
      s.begin_path
      s.move_to(bx0, Y(l))
      s.line_to(bx1, Y(l))
      s.stroke
      s.fill_text("10^{l}", bx0 - 8, Y(l) + 4)
      l = l + 1
    }

    /* Tully-Fisher: each galaxy is a line parallel to the deep asymptote, lifted by half its own scale's offset; fading out where the relation stops applying */
    implied := []
    Sparc.btfr.for(g => {
      M := g.mass
      v := g.vf * 1000
      implied.push(Fmt.log10(v * v * v * v / (Sparc.G_NEWTON * M) / Galaxies.A0_DATA)) if M > 0 & v > 0
    })
    implied = Expr.sorted(implied)
    med := implied.empty ? Real.NAN : implied[(implied.length / 2).floor]
    s.line_width(1)
    implied.for(o => {
      s.gradient_stroke(X(XMIN), X(0.2), ["rgba(205,92,92,0.62)", "rgba(205,92,92,0.40)", "rgba(205,92,92,0)"], [0, 0.62, 1])
      s.begin_path
      s.move_to(X(XMIN), Y(0.5 * (XMIN + o)))
      s.line_to(X(0.2), Y(0.5 * (0.2 + o)))
      s.stroke
    })

    /* where the model says galaxies are: the region, inked by rank, coloured by which freedom a cell needs */
    x := data.columns["x"]
    y := data.columns["y"]
    p := data.columns["p"]
    by := data.columns["by"]
    grid := data.header["grid"]
    most := 0
    p.for(v => { most = v if Fmt.finite(v) & v > most })
    if most > 0 {
      wpx := (bx1 - bx0) / (grid["arrives"]["n"] - 1) * (grid["arrives"]["to"] - grid["arrives"]["from"]) / (XMAX - XMIN)
      hpx := (by1 - by0) / (grid["felt"]["n"] - 1) * (grid["felt"]["to"] - grid["felt"]["from"]) / (YMAX - YMIN)
      live := []
      p.for(v => { live.push(v) if v > 0 })
      live = live.sorted_by(v => v)
      rank := (v: Real): Real => {
        lo := 0
        hi := live.length
        while lo < hi {
          mid := ((lo + hi) / 2).floor
          if live[mid] < v { lo = mid + 1 } else { hi = mid }
        }
        lo / live.length
      }
      Array.range(p.length).for(i => {
        if p[i] > 0 {
          t := rank(p[i])
          px := X(x[i] + shift)
          py := Y(y[i] + shift)
          unless px < bx0 - wpx | px > bx1 | py < by0 | py > by1 + hpx {
            tint := Galaxies.tint_of(by == None ? 0 : by[i].round)
            /* every cell a source can reach is SEEN - the support of the space - and brightens with how much of it lands there */
            k := 0.60 + 0.40 * t
            r := (tint[0] * k).round
            g := (tint[1] * k).round
            bl := (tint[2] * k).round
            al := Fmt.fixed(0.38 + 0.47 * t, 3)
            s.fill_style("rgba({r},{g},{bl},{al})")
            s.fill_rect(px - wpx / 2, py - hpx / 2, wpx + 1, hpx + 1)
          }
        }
      })
    }

    /*
     * WHAT IT TAKES TO GET THERE: the top of what a source of a given mass can reach, one line a decade of mass. Under
     * a line, that much mass is enough; above it, nothing of that mass reaches, however it is arranged or moved. The
     * space's own `needs` says it cell by cell (the least mass that reaches it, in dex of the rate a source starts at)
     */
    XS := grid["arrives"]["n"]
    YS := grid["felt"]["n"]
    /* the top of what a given source can reach: cells it gets to at all, read column by column */
    reach := (what: Real[], holds: Program, ink: String, text_ink: String, text: String) => {
      s.stroke_style(ink)
      s.begin_path
      started := false
      last_x := 0
      last_y := 0
      Array.range(XS).for(gx => {
        top := -1
        gy := YS - 1
        while gy >= 0 {
          if p[gy * XS + gx] > 0 & holds(what[gy * XS + gx]) { top = gy; gy = -1 } else { gy = gy - 1 }
        }
        if top >= 0 {
          px := X(x[top * XS + gx] + shift)
          py := Y(y[top * XS + gx] + shift)
          unless px < bx0 | px > bx1 | py < by0 | py > by1 {
            if started { s.line_to(px, py) } else { s.move_to(px, py) }
            started = true
            last_x = px
            last_y = py
          }
        }
      })
      s.stroke
      if started {
        s.fill_style(text_ink)
        s.fill_text(text, last_x + 4, last_y + 3)
      }
    }
    nds := data.columns["needs"]
    szs := data.columns["size"]
    s.line_width(1)
    s.font("9px ui-monospace, monospace")
    s.text_align("left")
    /* HOW MUCH MASS IT TAKES: under a line, that much is enough; above it, nothing of that mass reaches, however it is laid or moved */
    if nds != None {
      Galaxies.LEVELS.for(level => {
        reach(nds, (v: Real): boolean => v <= level, "rgba(238,240,245,0.30)", "rgba(238,240,245,0.45)", Galaxies.mass_text(level))
      })
    }
    /*
     * AND WHAT SPREADING COSTS: the same masses again, for a source LAID OVER nine c-bar rather than gathered. Being
     * spread is no boundary - a wide source reaches anywhere a gathered one does - but it pays in mass, and the gap
     * between a white line and the cyan one of the same mass is that price
     */
    if szs != None {
      s.dash([4, 3])
      Galaxies.WIDTHS.for(level => {
        reach(szs, (v: Real): boolean => v <= level, "rgba(139,233,253,0.35)", "rgba(139,233,253,0.55)", "{Galaxies.mass_text(level)}, spread")
      })
      s.dash([])
    }
    s.dash([])
    s.font("12px ui-monospace, monospace")

    /* SPARC: every rotation point, which is every rotation curve at once */
    s.fill_style(Galaxies.POINTS)
    shown := 0
    Sparc.rar.for(q => {
      if q.gbar > 0 & q.gobs > 0 {
        px := X(Fmt.log10(q.gbar / Galaxies.A0_DATA))
        py := Y(Fmt.log10(q.gobs / Galaxies.A0_DATA))
        unless px < bx0 | px > bx1 | py < by0 | py > by1 {
          s.fill_rect(px - 0.7, py - 0.7, 1.4, 1.4)
          shown = shown + 1
        }
      }
    })

    /* and the galaxy sample, one marker each, larger and green, ringed in the background colour */
    galaxies := 0
    Sparc.flat.for(q => {
      px := X(Fmt.log10(q.gbar / Galaxies.A0_DATA))
      py := Y(Fmt.log10(q.gobs / Galaxies.A0_DATA))
      unless px < bx0 | px > bx1 | py < by0 | py > by1 {
        s.begin_path
        s.arc(px, py, 2.6, 0, 7)
        s.fill_style(Galaxies.GALAXY)
        s.fill
        s.stroke_style("rgba(8,9,13,0.85)")
        s.line_width(0.9)
        s.stroke
        galaxies = galaxies + 1
      }
    })

    /* Newton, if nothing ever waited for room - cut where the frame is */
    s.stroke_style(Galaxies.NEWT)
    s.line_width(1.5)
    s.dash([6, 5])
    n0 := Fmt.max(XMIN, YMIN)
    n1 := Fmt.min(XMAX, YMAX)
    s.begin_path
    s.move_to(X(n0), Y(n0))
    s.line_to(X(n1), Y(n1))
    s.stroke
    s.dash([])

    /* the deep asymptote, which IS the Tully-Fisher relation: g = sqrt(g_N a_0), half the slope */
    s.stroke_style(Galaxies.BTFRC)
    s.line_width(1.5)
    s.dash([2, 4])
    s.begin_path
    l = XMIN
    while l <= XMAX + 0.000001 {
      if l == XMIN { s.move_to(X(l), Y(0.5 * l)) } else { s.line_to(X(l), Y(0.5 * l)) }
      l = l + 0.05
    }
    s.stroke
    s.dash([])

    /*
     * THE LAW IS THE FLOOR, NOT THE MODEL'S CURVE: it is what a source too small to disturb the vacuum is felt at, and
     * no galaxy is that. It is drawn faint, under the space it bounds
     */
    s.stroke_style(Galaxies.MODEL)
    s.line_width(1.2)
    s.alpha(0.4)
    s.dash([5, 4])
    s.begin_path
    l = XMIN
    while l <= XMAX + 0.000001 {
      if l == XMIN { s.move_to(X(l), Y(law_drawn(l))) } else { s.line_to(X(l), Y(law_drawn(l))) }
      l = l + 0.02
    }
    s.stroke
    s.dash([])
    s.alpha(1)

    /*
     * AND WHAT THE MODEL SAYS A GALAXY IS: every galaxy there could be, run - where they land, from the lowest to the
     * highest felt in each bin (the band, if it opens at all) and their middle, bold. Already in the data's a_0
     */
    landed := possible[0]
    mid := possible[1]
    step := Simulation.BIN
    s.fill_style("rgba(74,168,235,0.35)")
    Array.range(mid.length).for(i => {
      if landed[i] > 0 {
        px := X(Galaxies.XMIN + i * step)
        top_ := Y(possible[3][i])
        low_ := Y(possible[2][i])
        s.fill_rect(px - 1.5, top_ - 1.5, 3, low_ - top_ + 3)
      }
    })
    s.stroke_style(Galaxies.MODEL)
    s.line_width(3)
    s.begin_path
    started := false
    Array.range(mid.length).for(i => {
      v := mid[i]
      if landed[i] > 0 & Fmt.finite(v) {
        px := X(Galaxies.XMIN + i * step)
        py := Y(v)
        if started { s.line_to(px, py) } else { s.move_to(px, py) }
        started = true
      }
    })
    s.stroke

    /* the six high-redshift discs, where they were measured: the disc's own arrival against what its own dark share says is felt there - both the authors', neither the model's */
    Sparc.discs.for(d => {
      lx := Fmt.log10(Sparc.disc_arrival(d) / Galaxies.A0_DATA)
      ly := Fmt.log10(Sparc.disc_felt(d) / Galaxies.A0_DATA)
      s.fill_style(Galaxies.DISCC)
      s.begin_path
      s.arc(X(lx), Y(ly), 4, 0, 7)
      s.fill
      s.stroke_style(Galaxies.BACK)
      s.line_width(1.2)
      s.stroke
    })

    /* frame and legend */
    s.stroke_style("#1b2130")
    s.line_width(1)
    s.stroke_rect(bx0, by0, bx1 - bx0, by1 - by0)
    s.text_align("left")
    s.fill_style(Galaxies.SEEN)
    s.font("13px ui-monospace, monospace")
    s.fill_text(what, bx0, 26)
    s.font("11px ui-monospace, monospace")
    s.fill_style(Galaxies.FAINT)
    a0_text := Fmt.exponential(Galaxies.A0_DATA * 10 ^ shift, 3)
    ratio_text := Fmt.fixed(Galaxies.ratio_at(data, deg), 4)
    deg_text := Fmt.fixed(deg, 1)
    inside_text := Fmt.fixed(100 * Galaxies.inside(data, support, shift), 1)
    h0_text := Fmt.fixed(Galaxies.H0, 1)
    s.fill_text("DEG {deg_text}: a₀ = {ratio_text} cH₀ = {a0_text} m/s² (H₀ {h0_text}), data in 1.2e-10 — {inside_text}% of SPARC inside the space", bx0, 41)
    /* whether general relativity is a second line is measured, not asserted: the largest v²/c² in the frame bounds how far a GR curve could sit from the diagonal */
    vv := 0
    c2 := Sparc.C_LIGHT * Sparc.C_LIGHT
    Sparc.rar.for(q => { vv = Fmt.max(vv, q.gobs * q.R / c2) })
    Sparc.discs.for(d => { vv = Fmt.max(vv, Sparc.disc_arrival(d) * d.Re * Sparc.KPC / c2) })
    dex := Fmt.log10(1 + vv)
    pxs := dex / (XMAX - XMIN) * (bx1 - bx0)
    vv_text := Fmt.exponential(vv, 1)
    dex_text := Fmt.exponential(dex, 1)
    px_text := Fmt.exponential(pxs, 1)
    s.fill_text("GR is the same line: largest v²/c² here {vv_text}, so at most {dex_text} dex off the diagonal — {px_text} px of a 1.5 px line", bx0, 55)

    /* named where they are */
    diagonal := (t: Real): Real[] => [X(t), Y(t)]
    Galaxies.along(s, diagonal, -2.2, "Newton + GR", Galaxies.NEWT, -9, diagonal)
    ceiling := Galaxies.ceiling_of(data)
    /* the model's own line, where it runs: every galaxy there could be, run, on the same axes */
    possible_line := (t: Real): Real => {
      i := ((t - Galaxies.XMIN) / step).round
      i >= 0 & i < mid.length & landed[i] > 0 & Fmt.finite(mid[i]) ? mid[i] : law_drawn(t)
    }
    on_law := (t: Real): Real[] => [X(t), Y(possible_line(t))]
    /* the space's ceiling is read where the space was measured, in the vacuum's a_0, and drawn where the space is drawn */
    on_top := (t: Real): Real[] => [X(t), Y(ceiling(t - shift, law_drawn(t) - shift) + shift)]
    Galaxies.along(s, on_top, -1.15, "SPARC mass models", Galaxies.POINTS_LABEL, -14, on_law)
    gs := Expr.sorted(Sparc.flat.map(q => Fmt.log10(q.gbar / Galaxies.A0_DATA)))
    Galaxies.along(s, on_law, gs[(gs.length * 0.25).floor], "SPARC galaxy sample", Galaxies.GALAXY_LABEL, 34, on_law)
    offset := Fmt.finite(med) ? med : 0
    tully := (t: Real): Real[] => [X(t), Y(0.5 * (t + offset))]
    Galaxies.along(s, tully, -3.05, "Tully–Fisher", Galaxies.BTFRC, -9, tully)
    ds := Expr.sorted(Sparc.discs.map(d => Fmt.log10(Sparc.disc_arrival(d) / Galaxies.A0_DATA)))
    on_discs := (t: Real): Real[] => [X(t), Y(Galaxies.discs_at(t))]
    Galaxies.along(s, on_discs, ds[(ds.length / 2).floor], "Genzel high-z discs", Galaxies.DISCC, -14, on_discs)
    Galaxies.along(s, on_law, -3.3, "{Law.theory}: every galaxy, run", Galaxies.MODEL, -12, on_law)
    deep := (t: Real): Real[] => [X(t), Y(0.5 * t)]
    Galaxies.along(s, deep, 2.0, "deep limit  g = √(g_N a₀)", Galaxies.BTFRC, 11, deep)

    /* what each colour means, read off the data: the sets present are counted; every single freedom first, then the largest combinations that fit */
    tally := { }
    masks := []
    if by != None {
      Array.range(p.length).for(i => {
        if p[i] > 0 {
          m := by[i].round
          if tally[m] == None { tally[m] = 0; masks.push(m) }
          tally[m] = tally[m] + 1
        }
      })
    }
    total := 0
    masks.for(m => { total = total + tally[m] })
    total = 1 if total == 0
    counts := Expr.sorted(masks.map(m => 0 - tally[m]))
    ranked := []
    counts.for(cn => { masks.for(m => { ranked.push(m) if tally[m] == 0 - cn & !ranked.contains(m) }) })
    singles := ranked.filter(m => m == 0 | Galaxies.single(m))
    rest := ranked.filter(m => m != 0 & !Galaxies.single(m))
    shown_sets := singles.concat(rest)
    s.font("10px ui-monospace, monospace")
    s.text_align("left")
    lx := bx0
    s.fill_style(Galaxies.FAINT)
    intro := "coloured by the fewest freedoms that reach a cell:  "
    s.fill_text(intro, lx, by0 - 8)
    lx = lx + s.measure(intro)
    stop := false
    shown_sets.for(mask => {
      unless stop {
        share := (100 * tally[mask] / total).round
        named := Galaxies.name_of(mask).replace("needs ", "")
        label := "{named} {share}%"
        if lx + s.measure(label) + 14 > bx1 { stop = true } else {
          s.fill_style(Galaxies.rgb(Galaxies.tint_of(mask)))
          s.fill_rect(lx, by0 - 16, 8, 8)
          lx = lx + 11
          s.fill_text(label, lx, by0 - 8)
          lx = lx + s.measure(label) + 10
        }
      }
    })

    rar_n := Sparc.rar.length
    names_n := Sparc.names.length
    cut := names_n - Sparc.flat.length
    btfr_n := implied.length
    med_sign := med >= 0 ? "+" : ""
    med_fixed := Fmt.fixed(med, 2)
    med_text := Fmt.finite(med) ? "{med_sign}{med_fixed}" : "—"
    key := [
      [Galaxies.POINTS, "SPARC mass models (Table2.mrt) — {shown} of {rar_n} in frame, one point per measured radius (borrowed)"],
      [Galaxies.GALAXY, "SPARC galaxy sample (Table1.mrt) — {galaxies} of {names_n}, each at its outermost radius ({cut} cut, borrowed)"],
      [Galaxies.BTFRC, "Tully–Fisher (Lelli+2019): {btfr_n} galaxies, one line each (a₀ = v_f⁴/GM), median {med_text} dex from the theory's"],
      [Galaxies.DISCC, "Genzel high-z discs (borrowed)"]
    ]
    ky := by1 + 52
    s.font("11px ui-monospace, monospace")
    key.for(row => {
      if ky <= s.height - 8 {
        s.fill_style(row[0])
        s.fill_rect(bx0, ky - 7, 9, 9)
        s.fill_style(Galaxies.FAINT)
        s.fill_text(row[1], bx0 + 15, ky + 1)
        ky = ky + 15
      }
    })

    s.fill_style(Galaxies.FAINT)
    s.text_align("center")
    s.fill_text("g_baryons / a₀", (bx0 + bx1) / 2, by1 + 34)
    s.save
    s.translate(16, (by0 + by1) / 2)
    s.rotate(0 - Real.PI / 2)
    s.fill_text("g_observed / a₀", 0, 0)
    s.restore
    s.text_align("left")
  }
  /* one bit set: a single freedom */
  static single (m: N): boolean => {
    n := 0
    Array.range(Galaxies.FREEDOMS.length).for(i => { n = n + 1 if Galaxies.bit(m, i) })
    n == 1
  }

  /* H_0, borrowed: the middle of Planck's 67.4 and SH0ES' 73.0 km/s/Mpc - the one number from outside that puts the model's a_0 in m/s^2 */
  static H0 = 70
  /* the chain's a_0/cH at a lattice, off the table the space's run wrote (Inferences.coincidence, evaluated per DEG) */
  static ratio_at (data: Measured, deg: Real): Real => {
    table := data.header["coincidence"]
    fail("the space carries no a_0/cH table - rerun it (record.gpu RAY_SPACE)") if table == None
    ds := table["deg"]
    rs := table["ratio"]
    return rs[0] if deg <= ds[0]
    return rs[ds.length - 1] if deg >= ds[ds.length - 1]
    k := 0
    while ds[k + 1] < deg { k = k + 1 }
    f := (deg - ds[k]) / (ds[k + 1] - ds[k])
    rs[k] * (1 - f) + rs[k + 1] * f
  }
  /* how many dex the vacuum's a_0 at a lattice stands from the data's, in m/s^2 */
  static shift_at (data: Measured, deg: Real): Real => {
    H := Galaxies.H0 * 1000 / (Sparc.KPC * 1000)
    Fmt.log10(Galaxies.ratio_at(data, deg) * Sparc.C_LIGHT * H / Galaxies.A0_DATA)
  }
  /*
   * THE SPACE ON EVERY LATTICE, SOLVED (`<id>.solved`, record.gpu RAY_SOLVE): one row a reached cell a DEG, `starts[k]`
   * the first row of the k-th DEG. A frame is that lattice's space as a measurement of its own, laid on the full grid
   */
  static frame_of (solved: Measured, k: N): Measured => {
    grid := solved.header["grid"]
    XS := grid["arrives"]["n"]
    YS := grid["felt"]["n"]
    fx := grid["arrives"]["from"]
    fy := grid["felt"]["from"]
    dx := (grid["arrives"]["to"] - fx) / (XS - 1)
    dy := (grid["felt"]["to"] - fy) / (YS - 1)
    x := Array.filled(XS * YS, 0)
    y := Array.filled(XS * YS, 0)
    p := Array.filled(XS * YS, 0)
    by := Array.filled(XS * YS, 0)
    /* and HOW MUCH it takes to reach a cell: the least mass that does, in dex of the rate a source starts at */
    needs := Array.filled(XS * YS, Real.NAN)
    /* and how spread out a source may be and still reach it, in c-bar across */
    across := Array.filled(XS * YS, Real.NAN)
    Array.range(YS).for(gy => {
      Array.range(XS).for(gx => {
        x[gy * XS + gx] = fx + gx * dx
        y[gy * XS + gx] = fy + gy * dy
      })
    })
    cells := solved.columns["cell"]
    ps := solved.columns["p"]
    bys := solved.columns["by"]
    nds := solved.columns["needs"]
    szs := solved.columns["size"]
    starts := solved.header["starts"]
    stop := k + 1 < starts.length ? starts[k + 1] : solved.rows
    i := starts[k]
    while i < stop {
      c := cells[i].round
      p[c] = ps[i]
      by[c] = bys[i]
      needs[c] = nds[i] if nds != None
      across[c] = szs[i] if szs != None
      i = i + 1
    }
    header := { }
    header["grid"] = grid
    header["coincidence"] = solved.header["coincidence"]
    header["rows"] = XS * YS
    columns := { }
    columns["x"] = x
    columns["y"] = y
    columns["p"] = p
    columns["by"] = by
    columns["needs"] = needs
    columns["size"] = across
    Measured(header: header, columns: columns)
  }
  /* the cells the k-th lattice's space reaches, widened by two cells either way so its own sampling leaves no holes */
  static support_at (solved: Measured, k: N): Real[] => {
    grid := solved.header["grid"]
    XS := grid["arrives"]["n"]
    YS := grid["felt"]["n"]
    out := Array.filled(XS * YS, 0)
    cells := solved.columns["cell"]
    starts := solved.header["starts"]
    stop := k + 1 < starts.length ? starts[k + 1] : solved.rows
    i := starts[k]
    while i < stop {
      c := cells[i].round
      gx := c % XS
      gy := (c - gx) / XS
      Array.range(5).for(j => {
        Array.range(5).for(m => {
          xx := gx + m - 2
          yy := gy + j - 2
          out[yy * XS + xx] = 1 if xx >= 0 & yy >= 0 & xx < XS & yy < YS
        })
      })
      i = i + 1
    }
    out
  }
  /* the share of SPARC's readings that land inside the space, with the model's side laid `shift` dex from the data's */
  static inside (data: Measured, support: Real[], shift: Real): Real => {
    grid := data.header["grid"]
    XS := grid["arrives"]["n"]
    YS := grid["felt"]["n"]
    fx := grid["arrives"]["from"]
    fy := grid["felt"]["from"]
    dx := (grid["arrives"]["to"] - fx) / (XS - 1)
    dy := (grid["felt"]["to"] - fy) / (YS - 1)
    n := 0
    hit := 0
    Sparc.rar.for(q => {
      if q.gbar > 0 & q.gobs > 0 {
        gx := ((Fmt.log10(q.gbar / Galaxies.A0_DATA) - shift - fx) / dx).round
        gy := ((Fmt.log10(q.gobs / Galaxies.A0_DATA) - shift - fy) / dy).round
        n = n + 1
        hit = hit + 1 if gx >= 0 & gy >= 0 & gx < XS & gy < YS & support[gy * XS + gx] > 0
      }
    })
    n > 0 ? hit / n : 0
  }
  /*
   * THE FILM: every lattice once, from the most ways to the fewest, then settling on the theory's own lattice - so the
   * still, the last frame, is that lattice. Not on the lattice that holds the most of SPARC: the space is the law and
   * what lies above it, so that share only grows as the lattice's a_0 falls, and it never picks one out
   */
  static SETTLE = 24
  static sweep_of (solved: Measured): N[] => {
    ds := solved.header["degs"]
    n := ds.length
    home := solved.header["theory_deg"] ?? 18
    rest := 0
    Array.range(n).for(k => { rest = k if (ds[k] - home).abs < (ds[rest] - home).abs })
    out := []
    Array.range(n).for(k => { out.push(n - 1 - k) })
    Array.range(Galaxies.SETTLE).for(k => {
      f := (k + 1) / Galaxies.SETTLE
      out.push((rest * f * f * (3 - 2 * f)).round)
    })
    out
  }
  static of (id: String, what: String, title: String): Picture => {
    solved := Measured.of("{id}.solved")
    fail("{id}.solved is not on disk - solve the space (record.gpu RAY_SOLVE) and try again") if solved == None
    ks := Galaxies.sweep_of(solved)
    Picture(id: id, what: what, width: 960, height: 720, frames: ks.length, paint: (played: Played?) => Sweeping(solved: solved, title: title, ks: ks))
  }
  /*
   * THE ROTATION CURVES, ONE GALAXY A PANEL. The model's whole say about a galaxy is the law read at what its own
   * baryons deliver: g = F_g(g_bar, a_0) at every measured radius, and the speed a circle there needs is the root of
   * R g. Nothing is fitted - the gas, the disc and the bulge are SPARC's own (at their mass-to-light, 0.5 and 0.7),
   * a_0 is the chain's at the theory's lattice in m/s^2 (a_0/cH x c H_0), and what is drawn against the measurement is
   * what comes out. A galaxy is far too small to disturb the vacuum it is felt against (ten kiloparsecs is 1.6e-4 of
   * one c-bar), so the law is read at the vacuum's own a_0 and the model has no freedom left to spend here
   */
  static CURVE_ROWS = 3
  static CURVE_COLS = 4
  static a0_at (deg: Real): Real => {
    space := Measured.of("galaxy.many.solved")
    fail("galaxy.many.solved is not on disk - solve the space (record.gpu RAY_SOLVE) and try again") if space == None
    H := Galaxies.H0 * 1000 / (Sparc.KPC * 1000)
    Galaxies.ratio_at(space, deg) * Sparc.C_LIGHT * H
  }
  /* the galaxies drawn: the usable ones with the most measured radii, so a curve is a curve */
  static curve_pick (): N[] => Galaxies.pick(Galaxies.CURVE_ROWS * Galaxies.CURVE_COLS)
  static pick (want: N): N[] => {
    t := Sparc.curves
    C := t.columns
    counts := { }
    Array.range(t.rows).for(i => {
      g := C["galaxy"][i]
      counts["{g}"] = (counts["{g}"] ?? 0) + 1 if Sparc.usable(g) & C["R"][i] > 0 & C["Vobs"][i] > 0
    })
    ids := []
    Array.range(Sparc.names.length).for(g => { ids.push(g) if (counts["{g}"] ?? 0) >= 12 })
    /* the widest span of speeds the sample has, taken evenly: the slowest to the fastest */
    tops := { }
    Array.range(t.rows).for(i => {
      g := C["galaxy"][i]
      tops["{g}"] = Fmt.max(tops["{g}"] ?? 0, C["Vobs"][i])
    })
    sorted := ids.sorted_by(g => tops["{g}"])
    out := []
    Array.range(want).for(k => { out.push(sorted[((sorted.length - 1) * k / (want - 1)).round]) })
    out
  }
  /*
   * WHAT THE SIMULATION SAID (Simulation.ray, `npx ray measure galaxy.simulated`), read back: every measured radius of
   * every galaxy run, the field on each one's table, the tracers of the filmed ones, and every galaxy there could be
   */
  static SIMULATED = "npx ray measure galaxy.simulated"
  static simulated (): Measured => {
    got := Measured.of("galaxy.simulated")
    fail("galaxy.simulated is not on disk - run the galaxies (`{Galaxies.SIMULATED}`) and try again") if got == None
    got
  }
  static fields (): Measured => {
    got := Measured.of("galaxy.fields")
    fail("galaxy.fields is not on disk - run the galaxies (`{Galaxies.SIMULATED}`) and try again") if got == None
    got
  }
  /* the rows of one galaxy in a measurement whose first column names the galaxy */
  static rows_in (m: Measured, g: N): N[] => {
    col := m.columns["galaxy"]
    out := []
    Array.range(m.rows).for(i => { out.push(i) if col[i] == g })
    out
  }
  /* how far a galaxy's run is off what was measured, as an rms in dex - at SPARC's own freedoms, or at the fitted */
  static off_of (g: N, fitted: boolean): Real => {
    sim := Galaxies.simulated
    j := sim.header["ids"].index_of(g)
    return Real.NAN if j == None
    fitted ? sim.header["rms1"][j] : sim.header["rms0"][j]
  }
  static percent (dex: Real): String => Fmt.finite(dex) ? "{Fmt.fixed(100 * (10 ^ dex - 1), 0)}%" : "—"
  /*
   * ONE GALAXY'S CURVE IN A BOX, off the run: the baryons alone (Newton, dashed), the speed a circle needs on the laid
   * galaxy's field at SPARC's own freedoms (blue) and at the fitted ones as the data would see them (thin, pale), what
   * the tracers moved at (open rings) and what was measured with its error
   */
  static FITTED = "#9fd3f5"
  static curve_box (s: Surface, g: N, bx0: Real, by0: Real, bx1: Real, by1: Real) => {
    sim := Galaxies.simulated
    fld := Galaxies.fields
    S := sim.columns
    F := fld.columns
    rows := Galaxies.rows_in(sim, g)
    tab := Galaxies.rows_in(fld, g)
    top := 0
    reach := 0
    rows.for(i => {
      top = Fmt.max(top, S["Vobs"][i] + S["e_Vobs"][i])
      reach = Fmt.max(reach, S["R"][i])
    })
    top = top * 1.15
    reach = reach * 1.05
    X := (r: Real): Real => bx0 + r / reach * (bx1 - bx0)
    Y := (v: Real): Real => by1 - v / top * (by1 - by0)
    s.stroke_style(Galaxies.GRID)
    s.line_width(1)
    s.stroke_rect(bx0, by0, bx1 - bx0, by1 - by0)
    line := (column: String) => {
      s.begin_path
      started := false
      tab.for(i => {
        r := F["r"][i]
        v := F[column][i]
        if r <= reach & Fmt.finite(v) {
          if started { s.line_to(X(r), Y(Fmt.min(v, top))) } else { s.move_to(X(r), Y(Fmt.min(v, top))) }
          started = true
        }
      })
      s.stroke
    }
    s.stroke_style(Galaxies.NEWT)
    s.line_width(1)
    s.dash([5, 4])
    line("vN")
    s.dash([3, 3])
    s.stroke_style(Galaxies.FITTED)
    line("v1")
    s.dash([])
    s.stroke_style(Galaxies.MODEL)
    s.line_width(2)
    line("v0")
    /* the tracers, where the second half of the run found them */
    s.stroke_style(Galaxies.MODEL)
    s.line_width(1)
    rows.for(i => {
      v := S["vs"][i]
      if Fmt.finite(v) {
        s.begin_path
        s.arc(X(S["R"][i]), Y(Fmt.min(v, top)), 2.4, 0, 7)
        s.stroke
      }
    })
    s.stroke_style(Galaxies.POINTS)
    s.fill_style(Galaxies.POINTS)
    rows.for(i => {
      px := X(S["R"][i])
      s.begin_path
      s.move_to(px, Y(S["Vobs"][i] - S["e_Vobs"][i]))
      s.line_to(px, Y(Fmt.min(S["Vobs"][i] + S["e_Vobs"][i], top)))
      s.stroke
      s.fill_rect(px - 1.4, Y(S["Vobs"][i]) - 1.4, 2.8, 2.8)
    })
    s.font("10px ui-monospace, monospace")
    s.text_align("left")
    s.fill_style(Galaxies.SEEN)
    s.fill_text("{Sparc.names[g]}", bx0 + 4, by0 + 12)
    off0 := Galaxies.percent(Galaxies.off_of(g, false))
    off1 := Galaxies.percent(Galaxies.off_of(g, true))
    s.fill_style(Galaxies.MODEL)
    s.fill_text("{off0} off", bx0 + 4, by0 + 24)
    s.fill_style(Galaxies.FITTED)
    s.fill_text("{off1} fitted", bx0 + 4 + s.measure("{off0} off  "), by0 + 24)
    s.fill_style(Galaxies.FAINT)
    s.fill_text("{Fmt.fixed(top, 0)}", bx0 - 32, by0 + 8)
    s.fill_text("0", bx0 - 32, by1)
    s.text_align("right")
    s.fill_text("{Fmt.fixed(reach, 0)} kpc", bx1, by1 + 14)
    s.text_align("left")
  }
  /* the key under a picture of curves */
  static curve_key (s: Surface, y: Real) => {
    s.font("11px ui-monospace, monospace")
    s.text_align("left")
    s.fill_style(Galaxies.POINTS)
    s.fill_text("■ measured (SPARC, borrowed)", 22, y)
    s.fill_style(Galaxies.MODEL)
    s.fill_text("— run, SPARC's own Υ, D, i   ○ its tracers", 232, y)
    s.fill_style(Galaxies.FITTED)
    s.fill_text("-- run, the data's freedoms fitted", 560, y)
    s.fill_style(Galaxies.NEWT)
    s.fill_text("-- Newton", 820, y)
  }
  /* the whole sample's score: the rms in dex over every kept radius, at SPARC's freedoms and fitted */
  static sample_off (fitted: boolean): Real => {
    S := Galaxies.simulated.columns
    n := Galaxies.simulated.rows
    s := 0
    m := 0
    Array.range(n).for(i => {
      v := fitted ? S["v1"][i] : S["v0"][i]
      if S["kept"][i] > 0 & v > 0 {
        d := Fmt.log10(v / S["Vobs"][i])
        s = s + d * d
        m = m + 1
      }
    })
    m > 0 ? (s / Real.of(m)).sqrt : Real.NAN
  }
  static curves_panel (s: Surface) => {
    s.fill_style(Galaxies.BACK)
    s.fill_rect(0, 0, s.width, s.height)
    sim := Galaxies.simulated
    picked := Galaxies.curve_pick
    s.font("13px ui-monospace, monospace")
    s.fill_style(Galaxies.SEEN)
    s.text_align("left")
    s.fill_text("ROTATION CURVES, EACH GALAXY RUN", 22, 26)
    s.font("11px ui-monospace, monospace")
    s.fill_style(Galaxies.FAINT)
    a0_text := Fmt.exponential(sim.header["a0"], 3)
    deg_text := Fmt.fixed(sim.header["deg"], 1)
    whole0 := Galaxies.percent(Galaxies.sample_off(false))
    whole1 := Galaxies.percent(Galaxies.sample_off(true))
    s.fill_text("each laid from its own gas, disc and bulge and run; a₀ {a0_text} m/s² (DEG {deg_text}); all {whole0} off, {whole1} with Υ, D, i fitted", 22, 44)
    /* each galaxy on its OWN axes: a dwarf and a giant differ by a hundredfold in reach, and on one scale the dwarf is a dot */
    W := (s.width - 44) / Galaxies.CURVE_COLS
    H := (s.height - 96) / Galaxies.CURVE_ROWS
    Array.range(picked.length).for(k => {
      col := k % Galaxies.CURVE_COLS
      row := ((k - col) / Galaxies.CURVE_COLS).round
      ox := 22 + col * W
      oy := 62 + row * H
      Galaxies.curve_box(s, picked[k], ox + 34, oy + 16, ox + W - 10, oy + H - 26)
    })
    Galaxies.curve_key(s, s.height - 16)
  }
  static curves (): Picture =>
    Picture.still("galaxy.curves", "the rotation curves themselves: twelve galaxies across the sample, each laid from its own gas, disc and bulge and run - the speed a circle needs on its field, what its tracers moved at, and the same with the data's own freedoms fitted, against what was measured", 960, 720, (s: Surface) => { Galaxies.curves_panel(s) })

  /*
   * THE SIMULATION, FILMED: the filmed galaxies face on, their tracers going round over the last turn of the outermost
   * radius, each beside its curve. The galaxies are the ones the run was asked for (`RAY_GALAXIES` names them)
   */
  static simulation (): Picture => {
    stars := Measured.of("galaxy.stars")
    fail("galaxy.stars is not on disk - run the galaxies (`{Galaxies.SIMULATED}`) and try again") if stars == None
    Picture(id: "galaxy.simulation", what: "galaxies run: each laid from its own gas, disc and bulge, its tracers followed on the field the model gives it, and beside it the curve they trace against what was measured", width: 960, height: 720, frames: stars.header["frames"], paint: (played: Played?) => Orbiting(stars: stars))
  }
  static orbit_panel (s: Surface, stars: Measured, frame_at: N) => {
    s.fill_style(Galaxies.BACK)
    s.fill_rect(0, 0, s.width, s.height)
    film := stars.header["film"]
    NS := stars.header["stars"]
    FR := stars.header["frames"]
    X_ := stars.columns["x"]
    Y_ := stars.columns["y"]
    sim := Galaxies.simulated
    s.font("13px ui-monospace, monospace")
    s.fill_style(Galaxies.SEEN)
    s.text_align("left")
    s.fill_text("GALAXIES, RUN", 22, 26)
    s.font("11px ui-monospace, monospace")
    s.fill_style(Galaxies.FAINT)
    a0_text := Fmt.exponential(sim.header["a0"], 3)
    deg_text := Fmt.fixed(sim.header["deg"], 1)
    s.fill_text("laid from the gas, disc and bulge SPARC measured; every tracer pulled at what is felt where it is (a₀ {a0_text} m/s², DEG {deg_text})", 22, 44)
    rows := (film.length / 2).floor + film.length % 2
    H := (s.height - 96) / Fmt.max(rows, 1)
    W := (s.width - 44) / 2
    Array.range(film.length).for(k => {
      g := film[k]
      col := k % 2
      row := ((k - col) / 2).round
      ox := 22 + col * W
      oy := 58 + row * H
      side := Fmt.min(H - 20, W * 0.48)
      cx := ox + side / 2 + 4
      cy := oy + side / 2 + 6
      reach := stars.header["reach"][k]
      scale := side / 2 / reach
      s.stroke_style(Galaxies.GRID)
      s.line_width(1)
      s.stroke_rect(cx - side / 2, cy - side / 2, side, side)
      /* the tracers, tinted by how far out they are */
      Array.range(NS).for(q => {
        at := (k * NS + q) * FR + Fmt.min(frame_at, FR - 1)
        x := X_[at]
        y := Y_[at]
        r := Fmt.hypot(x, y) / reach
        if Fmt.finite(x) & r < 1.4 {
          warm := Fmt.min(1, r)
          red := (120 + 120 * (1 - warm)).round
          green := (170 + 50 * (1 - warm)).round
          s.fill_style("rgba({red},{green},245,0.55)")
          px := cx + x * scale
          py := cy - y * scale
          s.fill_rect(px - 0.6, py - 0.6, 1.2, 1.2) if px > cx - side / 2 & px < cx + side / 2 & py > cy - side / 2 & py < cy + side / 2
        }
      })
      s.fill_style(Galaxies.FAINT)
      s.font("10px ui-monospace, monospace")
      across := Fmt.fixed(2 * reach, 0)
      s.fill_text("{across} kpc across", cx - side / 2 + 4, cy + side / 2 - 6)
      /* where its stars were laid from, and how long it has turned since the picture */
      span := stars.header["span"]
      source := stars.header["source"]
      if span != None {
        myr := Fmt.fixed(span[k] * Fmt.min(frame_at, FR - 1) / Real.of(FR - 1), 0)
        s.fill_text("{source[k]}, +{myr} Myr", cx - side / 2 + 4, cy - side / 2 + 12)
      }
      Galaxies.curve_box(s, g, cx + side / 2 + 40, oy + 12, ox + W - 12, oy + side)
    })
    Galaxies.curve_key(s, s.height - 16)
  }

  /*
   * A GALAXY LEFT TO ITSELF, FILMED (Formed.ray): discs of stars that pull each other through the law, smooth at the
   * start, and whatever forms - star counts face on, the darkest cells empty, the brightest the densest of the frame
   */
  static formed (): Picture => {
    got := Measured.of("galaxy.formed")
    fail("galaxy.formed is not on disk - run the galaxies (`{Galaxies.SIMULATED}`) and try again") if got == None
    Picture(id: "galaxy.formed", what: "discs of stars left to themselves: every star pulled by every other through the law, nothing else holding them - smooth at the start, then whatever forms", width: 960, height: 720, frames: got.header["frames"], paint: (played: Played?) => Forming(formed: got))
  }
  /*
   * A GALAXY IN THE MEDIUM ITSELF, FILMED: every star its own body, held where the rays are (Medium.local_rays) - each
   * star's rays laid, streamed and met point by point, each star moved by what arrives where it stands, and nothing
   * else: no law, no halo. Launched from the medium's own pull (the circling speed of what each star feels, once the
   * field stood), and left to it. Star counts face on, the darkest cells empty, the brightest the densest of the frame;
   * under it how much arm there is, frame by frame. Run by galaxy.gpu.ts (RAY_ONLY=medium-galaxy)
   */
  static medium (): Picture => {
    got := Measured.of("galaxy.medium")
    fail("galaxy.medium is not on disk - run it (deno run --unstable-webgpu --allow-all implementation/ray/bootstrap/galaxy.gpu.ts . with RAY_ONLY=medium-galaxy) and try again") if got == None
    Picture(id: "galaxy.medium", what: "a disc of stars in the medium itself, every star its own body and every step local: launched circling at what the medium pulls it with, then left to the medium - whatever forms", width: 960, height: 900, frames: got.header["frames"], paint: (played: Played?) => HeldDisc(formed: got))
  }
  static medium_panel (s: Surface, formed: Measured, frame_at: N) => {
    s.fill_style(Galaxies.BACK)
    s.fill_rect(0, 0, s.width, s.height)
    H := formed.header
    G := H["grid"]
    FR := H["frames"]
    f := Fmt.min(frame_at, FR - 1)
    D := formed.columns["density"]
    s.font("13px ui-monospace, monospace")
    s.fill_style(Galaxies.SEEN)
    s.text_align("left")
    s.fill_text("A GALAXY IN THE MEDIUM, EVERY STAR ITS OWN", 22, 26)
    s.font("11px ui-monospace, monospace")
    s.fill_style(Galaxies.FAINT)
    stars_n := H["stars"]
    tick := H["ticks"][f]
    deg := H["deg"]
    side_n := H["side"]
    s.fill_text("{stars_n} stars, each its own body, held where the rays are - every step local, nothing but the medium (DEG {deg}, a {side_n}-cell box) - tick {tick}", 22, 44)
    side := Fmt.min(s.width - 44, s.height - 230)
    ox := (s.width - side) / 2
    oy := 60
    base := f * G * G
    top := 0
    Array.range(G * G).for(c => { top = Fmt.max(top, D[base + c]) })
    cell := side / G
    Array.range(G).for(cy => {
      Array.range(G).for(cx => {
        v := D[base + cy * G + cx]
        if v > 0 {
          t := Fmt.min(1, (1 + v).ln / (1 + top).ln)
          r := (40 + 215 * t * t).round
          gr := (60 + 190 * t).round
          b := (110 + 145 * Fmt.min(1, 1.6 * t)).round
          s.fill_style("rgb({r},{gr},{b})")
          s.fill_rect(ox + cx * cell, oy + (G - 1 - cy) * cell, cell + 0.5, cell + 0.5)
        }
      })
    })
    s.stroke_style(Galaxies.GRID)
    s.stroke_rect(ox, oy, side, side)
    rd := Fmt.fixed(H["scale"][0], 1)
    across := Fmt.fixed(2 * H["span"][0], 0)
    speed := Fmt.fixed(H["speed"], 4)
    s.fill_style(Galaxies.SEEN)
    s.fill_text("R_d {rd} c-bar, {across} c-bar across; circling at R_d {speed} c-bar a tick", ox, oy + side + 18)
    series := Galaxies.arms_of(formed, 0)
    sx0 := ox
    sx1 := ox + side
    sy0 := oy + side + 46
    sy1 := oy + side + 136
    topA := 0.6
    s.stroke_style(Galaxies.GRID)
    s.stroke_rect(sx0, sy0, sx1 - sx0, sy1 - sy0)
    inks := ["#4aa8eb", "#f2e05a", "#eb964a"]
    Array.range(3).for(k => {
      s.stroke_style(inks[k])
      s.line_width(1.5)
      s.begin_path
      Array.range(f + 1).for(j => {
        px := sx0 + (sx1 - sx0) * j / Real.of(FR - 1)
        py := sy1 - (sy1 - sy0) * Fmt.min(series[j][k + 2] / topA, 1)
        if j == 0 { s.move_to(px, py) } else { s.line_to(px, py) }
      })
      s.stroke
    })
    s.line_width(1)
    s.font("10px ui-monospace, monospace")
    now := series[f]
    a2 := Fmt.fixed(now[2], 3)
    a3 := Fmt.fixed(now[3], 3)
    a4 := Fmt.fixed(now[4], 3)
    s.fill_style(inks[0])
    s.fill_text("m=2 {a2}", sx0, sy0 - 4)
    s.fill_style(inks[1])
    s.fill_text("m=3 {a3}", sx0 + 90, sy0 - 4)
    s.fill_style(inks[2])
    s.fill_text("m=4 {a4}", sx0 + 176, sy0 - 4)
    s.fill_style(Galaxies.FAINT)
    s.fill_text("arm strength, 1-3 R_d, 0 to 0.6 (smooth ≈ 1/sqrt of the stars)", sx0, sy1 + 14)
    s.font("11px ui-monospace, monospace")
  }
  static formed_panel (s: Surface, formed: Measured, frame_at: N) => {
    s.fill_style(Galaxies.BACK)
    s.fill_rect(0, 0, s.width, s.height)
    H := formed.header
    G := H["grid"]
    FR := H["frames"]
    f := Fmt.min(frame_at, FR - 1)
    D := formed.columns["density"]
    names := H["names"]
    s.font("13px ui-monospace, monospace")
    s.fill_style(Galaxies.SEEN)
    s.text_align("left")
    s.fill_text("GALAXIES LEFT TO THEMSELVES", 22, 26)
    s.font("11px ui-monospace, monospace")
    s.fill_style(Galaxies.FAINT)
    gyr := Fmt.fixed(H["gyr"] * f / Real.of(FR - 1), 2)
    stars_n := H["stars"]
    q_text := Fmt.fixed(H["Q"], 1)
    a0_text := Fmt.exponential(H["a0"], 3)
    s.fill_text("{stars_n} stars each, every one pulled by every other through the law (a₀ {a0_text} m/s²), no halo; launched smooth at Q {q_text} — t = {gyr} Gyr", 22, 44)
    side := Fmt.min((s.width - 66) / 2, s.height - 110)
    Array.range(names.length).for(g => {
      ox := 22 + g * (side + 22)
      oy := 60
      base := (g * FR + f) * G * G
      top := 0
      Array.range(G * G).for(c => { top = Fmt.max(top, D[base + c]) })
      cell := side / G
      Array.range(G).for(cy => {
        Array.range(G).for(cx => {
          v := D[base + cy * G + cx]
          if v > 0 {
            t := Fmt.min(1, (1 + v).ln / (1 + top).ln)
            r := (40 + 215 * t * t).round
            gr := (60 + 190 * t).round
            b := (110 + 145 * Fmt.min(1, 1.6 * t)).round
            s.fill_style("rgb({r},{gr},{b})")
            s.fill_rect(ox + cx * cell, oy + (G - 1 - cy) * cell, cell + 0.5, cell + 0.5)
          }
        })
      })
      s.stroke_style(Galaxies.GRID)
      s.stroke_rect(ox, oy, side, side)
      mass := Fmt.exponential(H["mass"][g], 1)
      rd := Fmt.fixed(H["scale"][g], 1)
      across := Fmt.fixed(2 * H["span"][g], 0)
      s.fill_style(Galaxies.SEEN)
      s.fill_text("{names[g]}: {mass} suns, R_d {rd} kpc", ox, oy + side + 18)
      s.fill_style(Galaxies.FAINT)
      /* the picture follows the disc: how far its middle has gone and how fast, since the law read at each star moves it */
      mids := H["middles"]
      moved := ""
      if mids != None {
        m := mids[f][g]
        gone := Fmt.fixed(Fmt.hypot(m[0], m[1]), 1)
        speed := Fmt.fixed(Fmt.hypot(m[2], m[3]), 1)
        moved = "; followed - moved {gone} kpc, going {speed} km/s"
      }
      s.fill_text("{across} kpc across{moved}", ox, oy + side + 34)
      /* HOW MUCH ARM THERE IS, frame by frame up to this one: the m = 2, 3, 4 strengths between one and three scales */
      series := Galaxies.arms_of(formed, g)
      sx0 := ox
      sx1 := ox + side
      sy0 := oy + side + 58
      sy1 := oy + side + 148
      topA := 0.6
      s.stroke_style(Galaxies.GRID)
      s.stroke_rect(sx0, sy0, sx1 - sx0, sy1 - sy0)
      inks := ["#4aa8eb", "#f2e05a", "#eb964a"]
      Array.range(3).for(k => {
        s.stroke_style(inks[k])
        s.line_width(1.5)
        s.begin_path
        Array.range(f + 1).for(j => {
          px := sx0 + (sx1 - sx0) * j / Real.of(FR - 1)
          py := sy1 - (sy1 - sy0) * Fmt.min(series[j][k + 2] / topA, 1)
          if j == 0 { s.move_to(px, py) } else { s.line_to(px, py) }
        })
        s.stroke
      })
      s.line_width(1)
      s.font("10px ui-monospace, monospace")
      now := series[f]
      a2 := Fmt.fixed(now[2], 3)
      a3 := Fmt.fixed(now[3], 3)
      a4 := Fmt.fixed(now[4], 3)
      s.fill_style(inks[0])
      s.fill_text("m=2 {a2}", sx0, sy0 - 4)
      s.fill_style(inks[1])
      s.fill_text("m=3 {a3}", sx0 + 90, sy0 - 4)
      s.fill_style(inks[2])
      s.fill_text("m=4 {a4}", sx0 + 176, sy0 - 4)
      s.fill_style(Galaxies.FAINT)
      s.text_align("left")
      s.fill_text("arm strength, 1-3 R_d, 0 to 0.6 (smooth ≈ 0.01)", sx0, sy1 + 14)
      s.text_align("left")
      s.font("11px ui-monospace, monospace")
    })
  }
  /*
   * WHAT ARMS THERE ARE, measured on the picture itself: about the disc's densest middle (the counts weighted by
   * themselves, so a few stars far out do not move it), between one and three scale lengths, how strongly the stars
   * gather at m angles around - |sum of counts e^{i m theta}| over the sum. A smooth disc reads the noise of its stars
   * (about 1/sqrt of how many), a bar or a two-armed spiral lifts m = 2, a flocculent disc the higher ones
   */
  static ARMS = { }
  static arms_of (formed: Measured, g: N): Real[][] => {
    H := formed.header
    /* kept by the picture's own words and the disc, so two pictures' discs are never read as one */
    about := H["about"]
    key := "{g}:{about}"
    return Galaxies.ARMS[key] if Galaxies.ARMS[key] != None
    G := H["grid"]
    FR := H["frames"]
    D := formed.columns["density"]
    per_scale := G / (2 * H["span"][g] / H["scale"][g])
    out := Array.range(FR).map(f => {
      base := (g * FR + f) * G * G
      w := 0
      mx := 0
      my := 0
      Array.range(G).for(cy => {
        Array.range(G).for(cx => {
          v := D[base + cy * G + cx]
          w = w + v * v
          mx = mx + v * v * cx
          my = my + v * v * cy
        })
      })
      mx = w > 0 ? mx / w : G / 2
      my = w > 0 ? my / w : G / 2
      re := [0, 0, 0, 0, 0]
      im := [0, 0, 0, 0, 0]
      total := 0
      Array.range(G).for(cy => {
        Array.range(G).for(cx => {
          v := D[base + cy * G + cx]
          dx := cx + 0.5 - mx
          dy := cy + 0.5 - my
          r := Fmt.hypot(dx, dy) / per_scale
          if v > 0 & r >= 1 & r <= 3 {
            th := dy.atan2(dx)
            total = total + v
            Array.range(5).for(m => {
              re[m] = re[m] + v * (m * th).cos
              im[m] = im[m] + v * (m * th).sin
            })
          }
        })
      })
      Array.range(5).map(m => total > 0 ? Fmt.hypot(re[m], im[m]) / total : 0).drop(0)
    })
    Galaxies.ARMS[key] = out
    out
  }

  /*
   * THE SIMULATED RAR, asked for by name (`npx ray visuals galaxy.rar`): every galaxy run, every measured radius - the
   * data at SPARC's freedoms and at the fitted ones, and where the run puts each radius. Arrival is the laid galaxy's
   * own, so the run sits ON the law by construction; what spreads about it is the measuring
   */
  static rar (): Picture => {
    pic := Picture.still("galaxy.rar", "the radial acceleration relation, simulated: every galaxy run at every measured radius, against the data at SPARC's own freedoms and with them fitted", 960, 720, (s: Surface) => { Galaxies.rar_panel(s) })
    pic.on_request = true
    pic
  }
  static rar_panel (s: Surface) => {
    s.fill_style(Galaxies.BACK)
    s.fill_rect(0, 0, s.width, s.height)
    sim := Galaxies.simulated
    S := sim.columns
    unit := sim.header["unit"]
    ids := sim.header["ids"]
    bx0 := 92
    bx1 := s.width - 26
    by0 := 70
    by1 := s.height - 80
    XMIN := -4
    XMAX := 2
    YMIN := -3
    YMAX := 2
    X := (l: Real): Real => bx0 + (l - XMIN) / (XMAX - XMIN) * (bx1 - bx0)
    Y := (l: Real): Real => by1 - (l - YMIN) / (YMAX - YMIN) * (by1 - by0)
    s.stroke_style(Galaxies.GRID)
    s.line_width(1)
    s.fill_style(Galaxies.FAINT)
    s.font("11px ui-monospace, monospace")
    s.text_align("center")
    l := XMIN
    while l <= XMAX {
      s.begin_path
      s.move_to(X(l), by0)
      s.line_to(X(l), by1)
      s.stroke
      s.fill_text("10^{l}", X(l), by1 + 16)
      l = l + 1
    }
    s.text_align("right")
    l = YMIN
    while l <= YMAX {
      s.begin_path
      s.move_to(bx0, Y(l))
      s.line_to(bx1, Y(l))
      s.stroke
      s.fill_text("10^{l}", bx0 - 8, Y(l) + 4)
      l = l + 1
    }
    lg := (v: Real): Real => Fmt.log10(v / Galaxies.A0_DATA)
    spread0 := []
    spread1 := []
    Array.range(sim.rows).for(i => {
      if S["kept"][i] > 0 {
        g := S["galaxy"][i]
        j := ids.index_of(g)
        R := S["R"][i]
        V := S["Vobs"][i]
        gbar0 := (Sparc.YD * S["gd"][i] + Sparc.YB * S["gb"][i] + S["gg"][i]) * unit
        gbar1 := (sim.header["Y_disk"][j] * S["gd"][i] + sim.header["Y_bulge"][j] * S["gb"][i] + S["gg"][i]) * unit
        f := sim.header["D"][j] / Sparc.sample.columns["D"][g]
        sn := (Sparc.sample.columns["Inc"][g] * Real.PI / 180).sin / (sim.header["Inc"][j] * Real.PI / 180).sin
        gobs0 := V * V / R * unit
        gobs1 := (V * sn) * (V * sn) / (R * f) * unit
        if gbar0 > 0 & gbar1 > 0 {
          s.fill_style("rgba(238,240,245,0.35)")
          s.fill_rect(X(lg(gbar0)) - 0.7, Y(lg(gobs0)) - 0.7, 1.4, 1.4)
          s.fill_style("rgba(159,211,245,0.8)")
          s.fill_rect(X(lg(gbar1)) - 0.8, Y(lg(gobs1)) - 0.8, 1.6, 1.6)
          m0 := S["v0"][i]
          m1 := S["v1"][i]
          spread0.push(Fmt.log10(m0 / V)) if m0 > 0
          spread1.push(Fmt.log10(m1 / V)) if m1 > 0
        }
      }
    })
    /* the law the run reads, at its a_0, and Newton */
    a0 := sim.header["a0"]
    s.stroke_style(Galaxies.MODEL)
    s.line_width(2)
    s.begin_path
    l = XMIN
    while l <= XMAX + 0.000001 {
      gN := 10 ^ l * Galaxies.A0_DATA
      y := lg(Law.boost(gN, a0))
      if l == XMIN { s.move_to(X(l), Y(y)) } else { s.line_to(X(l), Y(y)) }
      l = l + 0.02
    }
    s.stroke
    s.stroke_style(Galaxies.NEWT)
    s.dash([6, 5])
    s.begin_path
    s.move_to(X(Fmt.max(XMIN, YMIN)), Y(Fmt.max(XMIN, YMIN)))
    s.line_to(X(Fmt.min(XMAX, YMAX)), Y(Fmt.min(XMAX, YMAX)))
    s.stroke
    s.dash([])
    s.stroke_style("#1b2130")
    s.stroke_rect(bx0, by0, bx1 - bx0, by1 - by0)
    s.text_align("left")
    s.font("13px ui-monospace, monospace")
    s.fill_style(Galaxies.SEEN)
    s.fill_text("THE RADIAL ACCELERATION RELATION, EVERY GALAXY RUN", bx0, 26)
    s.font("11px ui-monospace, monospace")
    s.fill_style(Galaxies.FAINT)
    off0 := Galaxies.percent(Simulation.rms(spread0))
    off1 := Galaxies.percent(Simulation.rms(spread1))
    a0_text := Fmt.exponential(a0, 3)
    deg_text := Fmt.fixed(sim.header["deg"], 1)
    radii_n := spread0.length
    seen := { }
    Array.range(sim.rows).for(i => {
      which := S["galaxy"][i]
      seen["{which}"] = true if S["kept"][i] > 0
    })
    ids_n := ids.filter(g => seen["{g}"] != None).length
    s.fill_text("{radii_n} radii, {ids_n} galaxies: {off0} off in speed at the published Υ, D, i, {off1} fitted (a₀ {a0_text} m/s², DEG {deg_text})", bx0, 44)
    s.fill_style("rgba(238,240,245,0.7)")
    s.fill_text("■ SPARC at its own freedoms", bx0, s.height - 22)
    s.fill_style(Galaxies.FITTED)
    s.fill_text("■ the same radii with Υ, D, i fitted", bx0 + 240, s.height - 22)
    s.fill_style(Galaxies.MODEL)
    s.fill_text("— where the run puts them: the law, at the run's a₀", bx0 + 520, s.height - 22)
    s.fill_style(Galaxies.FAINT)
    s.text_align("center")
    s.fill_text("g_baryons / 1.2e-10 m/s²", (bx0 + bx1) / 2, by1 + 34)
  }

  static point (): Picture => Galaxies.of("galaxy.point", "a galaxy as ONE source - the whole of its mass behind one face, so what it sends saturates at the face. Where the model puts galaxies, against every measurement", "A GALAXY AS ONE SOURCE")
  static many (): Picture => Galaxies.of("galaxy.many", "and as its stars - each thin enough to send all of itself, so what is sent is the total mass. The same axes, the same law, the other limit of the skin", "A GALAXY AS MANY SOURCES, ONE PER STAR")
}

/* the galaxy panel, frame by frame: one lattice a frame, in the order the sweep gives */
Sweeping := class < Painter, solved: Measured, title: String, ks: N[] {
  shown_frames: N = 0
  frame (s: Surface, dt: Real) => {
    k := this.ks[this.shown_frames < this.ks.length ? this.shown_frames : this.ks.length - 1]
    deg := this.solved.header["degs"][k]
    Galaxies.panel(s, Galaxies.frame_of(this.solved, k), this.title, deg, Galaxies.support_at(this.solved, k), Galaxies.possible_at(deg))
    this.shown_frames = this.shown_frames + 1
  }
}

/* a disc in the medium itself, frame by frame */
HeldDisc := class < Painter, formed: Measured {
  shown_frames: N = 0
  frame (s: Surface, dt: Real) => {
    Galaxies.medium_panel(s, this.formed, this.shown_frames)
    this.shown_frames = this.shown_frames + 1
  }
}

/* the discs left to themselves, frame by frame */
Forming := class < Painter, formed: Measured {
  shown_frames: N = 0
  frame (s: Surface, dt: Real) => {
    Galaxies.formed_panel(s, this.formed, this.shown_frames)
    this.shown_frames = this.shown_frames + 1
  }
}

/* the galaxies run, frame by frame: the tracers where the run left them at each frame */
Orbiting := class < Painter, stars: Measured {
  shown_frames: N = 0
  frame (s: Surface, dt: Real) => {
    Galaxies.orbit_panel(s, this.stars, this.shown_frames)
    this.shown_frames = this.shown_frames + 1
  }
}
