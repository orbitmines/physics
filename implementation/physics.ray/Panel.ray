/*
 * THE FIELD PANEL - two bodies (or a sun and its planets) in the medium integrated on a box (Medium.ray),
 * filmed: on the left what each body sends, coloured by whose it is; on the right where space is destroyed
 * by one body's rays against another's - the pair term, off the equation's meeting term - averaged over the
 * film so far. The world is run `TICKS` ticks per frame and what it found goes into the channels `one`
 * (the first body's arrivals), `two` (the other bodies'), `gone` (space destroyed, one body's rays against another's), `by0`, `by1`, ...
 * (each other body's own rays, where several are coloured) and `marks` (where the bodies are and what they weigh).
 */

/* what a film reads off its own theory before it runs: a held body (mx, ways) alone on an N-cell line of A headings, K cells to a c-bar, for `ticks`; then the lean toward it at each radius, in c-bar */
Probe := class < N: N, A: N, K: N, ticks: N, mx: Real, ways: N, radii: Real[] { }
/* what a film tries on its own theory before it runs: two bodies (mx, ways) R apart, thrown across each other at v0 (c-bar a tick), for `ticks`, at each R of `radii`, on an N-cell line of A headings, K cells to a c-bar */
Trial := class < N: N, A: N, K: N, ticks: N, mx: Real, ways: N, v0: Real, radii: Real[] { }
/*
 * what a film solves for on its own theory before it runs: a body (mx, ways) R from another, thrown across it for `ticks`
 * on an N-cell line of A headings, K cells to a c-bar - the speed between `lo` and `hi` (c-bar a tick) at which it holds,
 * by `steps` bisections. The other is held where it is with `held_ways` ways at `held_mx` (a sun); with no held ways it is
 * the body's twin, thrown the opposite way, and R is what parts them
 */
Orbit := class < N: N, A: N, K: N, ticks: N, mx: Real, ways: N, R: Real, lo: Real, hi: Real, steps: N, held_mx: Real, held_ways: N {
  /*
   * how the speed is found: "root", bisection on the drift over a turn between lo and hi; or "fall", the closed form
   * on one measurement - the bodies put at rest R apart, released after `burn` ticks of the medium settling round
   * them, and the acceleration a the space hands each one over `ticks` read off its momentum (Transport), then the
   * speed at which that bends a tangent into the circle: a circle of radius rho needs v squared over rho, so
   * v = sqrt(a rho) - each twin at rho = R/2, a planet at rho = R
   */
  mode: String = "fall"
  /* how long the medium settles, the bodies held, before anything is read */
  burn: N = 0
  /* one body on its own instead of the pair - a check that it goes nowhere */
  alone: boolean = false
}

Setup := class < id: String, what: String, width: N, height: N, theory: Theory {
  /* the world the film is a plane through: the theory's own lattice */
  DEG: N = this.theory.lattice.DEG
  D: N = this.theory.lattice.D
  VIEW: N = 20
  MARGIN: N = 8
  A: N = 96
  K: N = 3
  PIX: N = 3
  GAP: N = 20
  bodies: N = 2
  TICKS: N = 2
  RUN: N = 150
  BURN: N = 0
  /* how the film opens: instant, every body's field already standing at any range (Medium.settle), or grow, the field growing from the bodies for BURN ticks */
  RANGE: String = "instant"
  tags: N = 2
  stamp: String = ""
  colours: String[] = []
  /*
   * A PROBE, RUN BEFORE THE FILM ON THE DEVICE: one held body of this theory on a small line, for `ticks`
   * ticks, and the share of a step by which the space around it leans toward it, read at each of `radii`
   * (`Field.lean_toward`). What it read is `leans`, one per radius, by the time `place` is asked - so a
   * film can put its bodies where the theory's own space says, and edits to the rules move them
   */
  probe: Probe? = None
  leans: Real[] = []
  /*
   * A TRIAL, RUN BEFORE THE FILM ON THE DEVICE: two bodies of this theory (mx, ways) put R apart and thrown
   * across each other at v0, for `ticks` ticks, once per R in `radii`, on an N-cell line of A headings, K cells
   * to a c-bar. What comes back is `orbits`: for each R the closest and farthest they got. A film can then put its
   * bodies at the R whose separation held steadiest - the orbit this theory has, if it has one
   */
  trial: Trial? = None
  orbits: Real[][] = []
  /*
   * AN ORBIT, SOLVED FOR BEFORE THE FILM ON THE DEVICE: at the separation R, the speed at which two bodies of this
   * theory, thrown across each other, neither fall in nor drift out - the root of the pair's radial drift over
   * its first quarter turn, found by bisection on the theory's own simulation, as `Solve.root` finds the
   * vacuum's density on the algebra. `found` is [R, v, drift at v, whether the root was bracketed]; a film
   * launches with it, so the launch follows the rules, whatever they are edited to
   */
  orbits: Orbit[] = []
  found: Real[][] = []
  /* the bodies, where they start */
  place: Program
  /* whether the film's world is spent and should be laid again */
  spent: Program? = None
  /* how much of the box is shown at frame t */
  view: Program
  /* the colour of a body's ring */
  ring: Program? = None
  /* cells to a side, the middle, the picture's reach in pixels, and the recorded box's side */
  side (): N => 2 * (this.VIEW + this.MARGIN) * this.K + 1
  centre (): N => (this.side - 1) / 2
  reach (): N => this.VIEW * this.PIX
  box_side (): N => 2 * this.reach + 1
  box (x: Z, y: Z): N => (y + this.reach) * this.box_side + (x + this.reach)
  /* the coarse box the bodies' shares are recorded in: one sample a c-bar, since a share is smooth and the recording must stay small */
  coarse_side (): N => 2 * this.VIEW + 1
  coarse (x: Z, y: Z): N => {
    cx := (Real.of(x) / Real.of(this.PIX)).round + this.VIEW
    cy := (Real.of(y) / Real.of(this.PIX)).round + this.VIEW
    cx = 0 if cx < 0
    cy = 0 if cy < 0
    cx = this.coarse_side - 1 if cx > this.coarse_side - 1
    cy = this.coarse_side - 1 if cy > this.coarse_side - 1
    cy * this.coarse_side + cx
  }
  /* the bodies' middle, by their masses, in cells */
  static middle (holes: Hole[]): Real[] => {
    m := 0
    x := 0
    y := 0
    holes.for(h => { m = m + h.mass; x = x + h.x * h.mass; y = y + h.y * h.mass })
    m > 0 ? [x / m, y / m] : [0, 0]
  }
  /* what the rest of the bodies come to: their mass, and where their middle is */
  /*
   * WHAT A BODY IS THROWN ABOUT: the rest of them, where they all go their own way - and where any of them is held,
   * those alone. A body thrown about one that is held is thrown about that one; the ones going their own way about it
   * are somewhere else by the time it comes round, and what they put on the middle is not where it is thrown about
   */
  static rest_of (holes: Hole[], k: N): Real[] => {
    held := false
    Array.range(holes.length).for(i => { held = true if i != k & !holes[i].moves })
    m := 0
    x := 0
    y := 0
    Array.range(holes.length).for(i => {
      if i != k & (!held | !holes[i].moves) {
        m = m + holes[i].mass
        x = x + holes[i].x * holes[i].mass
        y = y + holes[i].y * holes[i].mass
      }
    })
    m > 0 ? [m, x / m, y / m] : [0, 0, 0]
  }
  /*
   * AN ORBIT OFF THE MEDIUM, WITH NO LAW ASSUMED OF IT. A body is put down at its farthest from the rest of the
   * bodies, d_far c-bar between them, and is to come no nearer than d_far(1-e)/(1+e). Between those two the medium's
   * own pull is read, step by step, on a point standing there with this body's own rays left out (`pull_toward`) -
   * and what the two ends draw each other closer by is that pull, told for both: each pulls the other, so the pull
   * between them is what one feels times the two masses over the rest's. The work over the way is the sum of it, what
   * they carry round (d v) is the same at both ends, so the speed BETWEEN them at the farthest is the root of twice
   * that work over (d_far/d_near)^2 - 1, and this body's own share of it is the rest's mass over all of it. Nothing
   * here is an inverse square: change the pull and the launch moves with it
   */
  static work (pulls: Real[][]): Real => {
    got := 0
    Array.range(pulls.length - 1).for(i => {
      dr := pulls[i + 1][0] - pulls[i][0]
      got = got + (pulls[i][1] + pulls[i + 1][1]) / 2 * dr
    })
    got
  }
  /* where the medium's pull is read for this body: from its nearest to its farthest, along the way to the rest of them */
  static where_between (h: Hole, rest: Real[], e: Real, K: N, steps: N): Real[][] => {
    dx := rest[1] - h.x
    dy := rest[2] - h.y
    far := Fmt.hypot(dx, dy) / Real.of(K)
    return [] if far <= 0
    near := far * (1 - e) / (1 + e)
    ux := 0 - dx / (far * Real.of(K))
    uy := 0 - dy / (far * Real.of(K))
    Array.range(steps + 1).map(i => {
      d := near + (far - near) * Real.of(i) / Real.of(steps)
      [d, rest[1] + ux * d * Real.of(K), rest[2] + uy * d * Real.of(K)]
    })
  }
  static pulls_between (w: *, h: Hole, rest: Real[], e: Real, K: N, steps: N): Real[][] => {
    zown := w.plane_of(h)
    Setup.where_between(h, rest, e, K, steps).map(at => [at[0], w.pull_toward(at[1], at[2], rest[1], rest[2], zown)])
  }
  /* the pull the medium gave, at a distance between the places it was read at */
  static pull_at_r (pulls: Real[][], r: Real): Real => {
    n := pulls.length
    return 0 if n == 0
    return pulls[0][1] if r <= pulls[0][0]
    return pulls[n - 1][1] if r >= pulls[n - 1][0]
    got := pulls[n - 1][1]
    found := false
    Array.range(n - 1).for(i => {
      unless found {
        if pulls[i][0] <= r & r <= pulls[i + 1][0] {
          span := pulls[i + 1][0] - pulls[i][0]
          f := span > 0 ? (r - pulls[i][0]) / span : 0
          got = pulls[i][1] * (1 - f) + pulls[i + 1][1] * f
          found = true
        }
      }
    })
    got
  }

  /*
   * HOW NEAR IT COMES, RUN ON THIS THEORY'S OWN STEP. The work between the two ends is the continuum's answer, and a
   * body here is not carried continuously: it is turned by the pull where it stands and then carried a tick's worth,
   * which is an orbit of its own and a nearest of its own. So the throw is read off that step and not off the integral:
   * thrown across at `v` from `far`, carried the way the medium carries a body, until it turns back out
   */
  static nearest (pulls: Real[][], v: Real, far: Real, near: Real, both: Real, kappa: Real, ticks: N): Real => {
    x := far
    y := 0
    vx := 0
    vy := v
    best := far
    done := false
    Array.range(ticks).for(i => {
      unless done {
        r := Fmt.hypot(x, y)
        best = Fmt.min(best, r)
        /* it has turned back out, or it is already deeper than what was wanted, or it never came in at all */
        done = true if best < far & r > best * 1.02
        done = true if r < near / 2
        done = true if r > far * 1.05
        /* and what it is pulled by while it goes is less than what it is pulled by at rest, by what the medium said it was (`Setup.slower`) */
        less := 1 - kappa * Fmt.hypot(vx, vy)
        g := Setup.pull_at_r(pulls, r) * both * (less > 0 ? less : 0)
        if r > 0 {
          vx = vx - g * x / r
          vy = vy - g * y / r
        }
        x = x + vx
        y = y + vy
      }
    })
    best
  }

  /* and the speed at the farthest that brings it exactly as near as was wanted, bisected on runs of that step */
  static thrown (pulls: Real[][], far: Real, near: Real, both: Real, kappa: Real, guess: Real): Real => {
    return guess if !(guess > 0 & far > 0 & near > 0)
    lo := 0
    hi := guess * 2
    Array.range(40).for(i => {
      mid := (lo + hi) / 2
      turn := (8 * Real.PI * far / (mid > 0 ? mid : 1)).round
      ticks := turn > 400000 ? 400000 : (turn < 16 ? 16 : turn)
      /* too slow and it falls deeper than what was wanted; too fast and it stays out */
      if Setup.nearest(pulls, mid, far, near, both, kappa, ticks) < near { lo = mid } else { hi = mid }
    })
    (lo + hi) / 2
  }

  /*
   * HOW MUCH SLOWER THE MEDIUM PULLS A BODY THAT GOES. A body sends less for its own going (the source term's own
   * beta) and its own rays stand in what it reads, so the pull between two bodies going at `v` between them is not
   * the pull between them at rest. This is that difference as a slope in the speed, read off the medium's own two
   * readings - at rest, and again with every body given the throw
   */
  static slower (rest_far: Real, moving_far: Real, v: Real): Real => {
    return 0 if !(rest_far > 0 & v > 0)
    (rest_far - moving_far) / (rest_far * v)
  }

  static orbit (h: Hole, rest: Real[], pulls: Real[][], e: Real, px: Real, py: Real, K: N, kappa: Real): Real[] => {
    dx := rest[1] - h.x
    dy := rest[2] - h.y
    far := Fmt.hypot(dx, dy) / Real.of(K)
    return [px, py] if far <= 0 | pulls.length < 2 | rest[0] <= 0
    near := far * (1 - e) / (1 + e)
    /* the pull between the two ends, from what this body feels: the other end feels the same by its own mass */
    both := (h.mass + rest[0]) / rest[0]
    w := Setup.work(pulls) * both
    ratio := (far / near) * (far / near)
    /* on a circle the two ends are one and the same and the work between them is nothing: what holds it there is the pull where it stands, times how far out it stands */
    circle := pulls[pulls.length - 1][1] * both * far
    between := ratio > 1.000001 ? (w > 0 ? (2 * w / (ratio - 1)).sqrt : 0) : (circle > 0 ? circle.sqrt : 0)
    /* the work over the way says about what it is; what the step itself does says it exactly */
    run := Setup.thrown(pulls, far, near, both, kappa, between)
    speed := run * rest[0] / (h.mass + rest[0])
    tx := 0 - dy / (far * Real.of(K))
    ty := dx / (far * Real.of(K))
    way := tx * px + ty * py < 0 ? 0 - 1 : 1
    [way * tx * speed * h.mass, way * ty * speed * h.mass]
  }


}

Body := class < x: Real, y: Real, mx: Real, ways: N {
  px: Real = 0
  py: Real = 0
  moves: boolean = false
  tag: N = 0
  /* how it is launched: given, with the momentum set here, or on an orbit about the bodies' middle of this eccentricity, put down at its farthest - its speed read off the pull the medium gives it there, the given momentum saying only which way round */
  launch: String = "given"
  ecc: Real = 0
}

/* the world behind a panel, recorded: TICKS ticks per frame into the channels */
FieldRecording := class < Recording, p: Setup {
  W: * = None
  gone: Real[] = Array.filled(this.p.side * this.p.side, 0)
  /* the record's gradient, the pull at every cell: what the right half draws */
  lx: Real[] = Array.filled(this.p.side * this.p.side, 0)
  ly: Real[] = Array.filled(this.p.side * this.p.side, 0)
  beat: Real[] = Array.filled(this.p.side * this.p.side, 0)
  beat2: Real[] = Array.filled(this.p.side * this.p.side, 0)
  /* the bodies are tags 1.. above the vacuum's own (0): `one` is the first body's population, `two` every other body's, each of those on its own here */
  per_tag: Real[][] = Array.range(this.p.tags > 2 ? this.p.tags - 2 : 1).map(z => Array.filled(this.p.side * this.p.side, 0))
  spanned: N = 0

  lay () => {
    p := this.p
    w := p.theory.medium(p.side, p.A, p.K, p.DEG, p.tags, p.D)
    /* the bodies are put down held, the medium is older than the film by BURN ticks, and then they are let go with what they were launched with */
    placed := p.place(p)
    placed.for(b => {
      h := Hole(x: p.centre + b.x * p.K, y: p.centre + b.y * p.K, mx: b.mx, ways: b.ways)
      h.tag = b.tag
      h.moves = false
      w.add(h)
    })
    if p.RANGE == "instant" {
      w.settle
    } else {
      Array.range(p.BURN).for(i => { w.tick })
    }
    /* one held tick more, so the pull each body stands in is read */
    w.tick if placed.some(b => b.launch == "orbit")
    /* which of them will go and which will be held: what a body is thrown about is read off that (Setup.rest_of) */
    Array.range(placed.length).for(k => { w.holes[k].moves = placed[k].moves })
    /* the pull each body stands in, at rest, and the throw that pull gives it */
    reads := Array.range(placed.length).map(k => placed[k].launch == "orbit" ? Setup.pulls_between(w, w.holes[k], Setup.rest_of(w.holes, k), placed[k].ecc, p.K, 64) : [])
    Array.range(placed.length).for(k => {
      h := w.holes[k]
      b := placed[k]
      v := b.launch == "orbit" ? Setup.orbit(h, Setup.rest_of(w.holes, k), reads[k], b.ecc, b.px, b.py, p.K, 0) : [b.px, b.py]
      h.px = v[0]
      h.py = v[1]
      h.momentum = Vector(components: [v[0], v[1]])
    })
    /* and again, with the field as it stands with every body going that fast: what that took off the pull is the slope the throw is read with */
    w.seed
    Array.range(placed.length).for(k => {
      b := placed[k]
      if b.launch == "orbit" {
        h := w.holes[k]
        rest := Setup.rest_of(w.holes, k)
        moving := Setup.pulls_between(w, h, rest, b.ecc, p.K, 64)
        at := reads[k].length - 1
        /* the speed between the two of them, which is what the slope is in */
        vrel := Fmt.hypot(h.px, h.py) / h.mass * (h.mass + rest[0]) / rest[0]
        kappa := Setup.slower(reads[k][at][1], moving[at][1], vrel)
        v := Setup.orbit(h, rest, reads[k], b.ecc, b.px, b.py, p.K, kappa)
        h.px = v[0]
        h.py = v[1]
        h.momentum = Vector(components: [v[0], v[1]])
      }
    })
    this.W = w
  }
  start () => { this.lay }
  /* a frame's accumulators, cleared */
  begin_frame () => {
    cells := this.p.side * this.p.side
    Array.range(cells).for(c => { this.gone[c] = 0; this.lx[c] = 0; this.ly[c] = 0; this.beat[c] = 0; this.beat2[c] = 0 })
    this.per_tag.for(e => { Array.range(cells).for(c => { e[c] = 0 }) })
    this.spanned = 0
  }
  /* one tick's readings, off whatever ran it - the CPU field, or a frame read back from a device */
  take (w: *) => {
    p := this.p
    cells := p.side * p.side
    Array.range(cells).for(c => {
      this.gone[c] = this.gone[c] + w.crossed(c)
      this.lx[c] = this.lx[c] + w.pull_x(c)
      this.ly[c] = this.ly[c] + w.pull_y(c)
      this.beat[c] = this.beat[c] + w.arrived(1, c)
      Array.range(p.tags > 2 ? p.tags - 2 : 1).for(k => {
        v := w.arrived(k + 2, c)
        this.beat2[c] = this.beat2[c] + v
        this.per_tag[k][c] = this.per_tag[k][c] + v
      })
    })
    this.spanned = this.spanned + 1
  }
  /* where the bodies are, in c-bar from the middle - what `spent` asks about */
  positions (w: *): Body[] => w.holes.map(h => Body(x: (h.x - this.p.centre) / this.p.K, y: (h.y - this.p.centre) / this.p.K, mx: h.mx, ways: h.ways))
  /* the frame's channels off the accumulators: the box sampled in pixels, and the marks */
  finish (into: {}, w: *) => {
    p := this.p
    level := 0
    seen := 0
    R := p.reach
    step := Real.of(p.K) / Real.of(p.PIX)
    one := into["one"]
    two := into["two"]
    gone := into["gone"]
    bys := Array.range(this.per_tag.length).map(k => into["by{k}"])
    marks := into["marks"]
    span := this.spanned < 1 ? 1 : this.spanned
    Array.range(2 * R + 1).for(yi => {
      y := yi - R
      Array.range(2 * R + 1).for(xi => {
        x := xi - R
        c := w.at((p.centre + x * step).round, (p.centre + y * step).round)
        i := p.box(x, y)
        if c < 0 {
          one[i] = 0
          two[i] = 0
          gone[i] = 0
          Array.range(bys.length).for(k => { bys[k][p.coarse(x, y)] = 0 if bys[k] != None & (x + R) % p.PIX == 0 & (y + R) % p.PIX == 0 })
        } else {
          blocked := w.blocks[c] > 0
          one[i] = blocked ? -1 : this.beat[c] / Real.of(span)
          two[i] = blocked ? -1 : this.beat2[c] / Real.of(span)
          Array.range(bys.length).for(k => { bys[k][p.coarse(x, y)] = this.per_tag[k][c] / Real.of(span) if bys[k] != None & (x + R) % p.PIX == 0 & (y + R) % p.PIX == 0 })
          gone[i] = this.gone[c]
          unless blocked { level = level + this.gone[c]; seen = seen + 1 }
        }
      })
    })
    marks[6 * p.bodies] = seen > 0 ? level / Real.of(seen) : 0
    Array.range(w.holes.length).for(k => {
      if k < p.bodies {
        b := w.holes[k]
        marks[k * 6] = (b.x - p.centre) / p.K
        marks[k * 6 + 1] = (b.y - p.centre) / p.K
        marks[k * 6 + 2] = b.px_now
        marks[k * 6 + 3] = b.py_now
        marks[k * 6 + 4] = w.t
        marks[k * 6 + 5] = b.mass
      }
    })
  }
  /* a frame on the CPU field: TICKS ticks, the world laid again where the arrangement is spent */
  frame (into: {}) => {
    p := this.p
    this.begin_frame
    Array.range(p.TICKS).for(i => {
      w := this.W
      if p.spent != None & p.spent(this.positions(w)) {
        this.lay
      } else {
        w.tick
        this.take(w)
      }
    })
    this.finish(into, this.W)
  }
}

/* the panel drawn, frame by frame, from the recording's channels */
FieldPainter := class < Painter, p: Setup, played: Played? {
  at_frame: N = 0
  accumulated: Real[] = Array.filled(this.p.box_side * this.p.box_side, 0)
  count: N = 0
  /* where each body has been, frame by frame, in c-bar from the middle: what says an orbit is not a circle */
  trail: Real[][] = Array.range(this.p.bodies).map(k => [])
  frame (s: Surface, dt: Real) => {
    ch := this.played == None ? { } : this.played.at(this.at_frame)
    if ch["one"] != None {
      /* the right half is the pair term, averaged over the film so far */
      gone := ch["gone"]
      Array.range(this.accumulated.length).for(i => { this.accumulated[i] = this.accumulated[i] + gone[i] })
      this.count = this.count + 1
      marks := ch["marks"]
      Array.range(this.p.bodies).for(k => {
        this.trail[k].push(marks[k * 6])
        this.trail[k].push(marks[k * 6 + 1])
      })
      Panel.paint(this.p, s, ch, this.at_frame * this.p.TICKS, this.accumulated, this.count, this.trail)
    }
    this.at_frame = this.at_frame + 1
  }
}

Panel := class {
  static BACK = "#08090d"
  static SEEN = "#eef0f5"
  static ONE = "#4aa8eb"
  static TWO = "#8bd48b"
  static PAIR = "#eef0f5"

  /* a shade against a floor, in the log: nought at nought, one at the peak */
  static lg (v: Real, floor: Real): Real => v <= 0 ? 0 : (1 + v / floor).ln / (1 + 1 / floor).ln
  static hex (c: String, at: N): N => {
    hi := Panel.digit(c.chars[at])
    lo := Panel.digit(c.chars[at + 1])
    hi * 16 + lo
  }
  static digit (c: Char): N => c >= 97 ? c - 87 : (c >= 65 ? c - 55 : c - 48)
  /* two colours mixed: f of the second */
  static mix (a: String, b: String, f: Real): String => {
    r := (Panel.hex(a, 1) * (1 - f) + Panel.hex(b, 1) * f).round
    g := (Panel.hex(a, 3) * (1 - f) + Panel.hex(b, 3) * f).round
    bl := (Panel.hex(a, 5) * (1 - f) + Panel.hex(b, 5) * f).round
    "rgb({r},{g},{bl})"
  }
  
  /* the other bodies' colours mixed at a cell by each one's share of the rays recorded there - so a body's colour fades with its rays, and trails it as they do */
  static blend (p: Setup, bys: Array, i: N): String => {
    r := 0
    g := 0
    b := 0
    total := 0
    Array.range(bys.length).for(k => {
      w := bys[k] == None ? 0 : Fmt.max(0, bys[k][i])
      c := p.colours[k] ?? Panel.TWO
      r = r + w * Panel.hex(c, 1)
      g = g + w * Panel.hex(c, 3)
      b = b + w * Panel.hex(c, 5)
      total = total + w
    })
    return Panel.TWO if !(total > 0)
    "#{Panel.hex2((r / total).round)}{Panel.hex2((g / total).round)}{Panel.hex2((b / total).round)}"
  }
  /* a number 0..255 as two hex digits */
  static hex2 (v: N): String => {
    digits := "0123456789abcdef"
    n := v < 0 ? 0 : (v > 255 ? 255 : v)
    hi := (n / 16).floor
    lo := n - hi * 16
    "{String(chars: [digits.chars[hi]])}{String(chars: [digits.chars[lo]])}"
  }
  static paint (p: Setup, s: Surface, ch: {}, t: N, accumulated: Real[], count: N, trail: Real[][]) => {
    width := s.width
    H := s.height
    s.clear_rect(0, 0, width, H)
    s.fill_style(Panel.BACK)
    s.fill_rect(0, 0, width, H)
    TOP := 14
    BOT := 14
    GAP2 := 10
    cw := (width - GAP2) / 2
    side := Fmt.min(cw, H - TOP - BOT)
    view := p.view(t)
    pz := side / (2 * view * p.PIX + 1)
    top := TOP + Fmt.max(0, (H - TOP - BOT - side) / 2)
    one := ch["one"]
    two := ch["two"]
    bys := Array.range(p.tags > 2 ? p.tags - 2 : 1).map(k => ch["by{k}"])
    marks := ch["marks"]
    peakA := 0.000000000000000000000000000001
    peakB := peakA
    peakG := peakA
    R := (view * p.PIX).round
    Array.range(2 * R + 1).for(yi => {
      y := yi - R
      Array.range(2 * R + 1).for(xi => {
        x := xi - R
        i := p.box(x, y)
        unless one[i] < 0 {
          peakA = Fmt.max(peakA, one[i])
          peakB = Fmt.max(peakB, two[i])
          peakG = Fmt.max(peakG, accumulated[i] / Real.of(count))
        }
      })
    })
    /*
     * the field's shade floor is the frame's own faintest reading against its peak when that is below the fixed floor:
     * whatever rays are there are drawn, however faint beside the peak, and where nothing is fainter than the fixed floor the picture is
     * the old one. The pair panel keeps its fixed floor: destruction is a product of two activities and spans a dozen decades
     */
    floorAB := 0.0015
    Array.range(2 * R + 1).for(yi => {
      y := yi - R
      Array.range(2 * R + 1).for(xi => {
        x := xi - R
        i := p.box(x, y)
        unless one[i] < 0 {
          tot := Fmt.max(0, one[i]) / peakA + Fmt.max(0, two[i]) / peakB
          floorAB = Fmt.min(floorAB, tot) if tot > 0
        }
      })
    })
    /*
     * WHERE EACH BODY HAS BEEN, and how near and how far it came. An orbit of any eccentricity is near enough a circle
     * to look at - at Mercury's it is 97.6% as wide as it is long - so what says it is not one is that the heavy body
     * stands off the middle of it: the path touches the ring at its farthest and falls well inside it at its nearest
     */
    centre := 0
    Array.range(p.bodies).for(k => { centre = k if marks[k * 6 + 5] > marks[centre * 6 + 5] })
    /* the paths are read against the middle they all keep to, which is where the heavy one stands when it is held */
    weight := 0
    Array.range(p.bodies).for(k => { weight = weight + marks[k * 6 + 5] })
    frames := trail[centre].length / 2
    midx := Array.range(frames).map(i => 0)
    midy := Array.range(frames).map(i => 0)
    Array.range(frames).for(i => {
      mx := 0
      my := 0
      Array.range(p.bodies).for(k => {
        mx = mx + marks[k * 6 + 5] * trail[k][2 * i]
        my = my + marks[k * 6 + 5] * trail[k][2 * i + 1]
      })
      midx[i] = weight > 0 ? mx / weight : 0
      midy[i] = weight > 0 ? my / weight : 0
    })
    biggest := 0
    nears := Array.range(p.bodies).map(k => 0)
    fars := Array.range(p.bodies).map(k => 0)
    Array.range(p.bodies).for(k => {
      near := 0
      far := 0
      /* how near and how far it came of it, where the two of them stood at the time */
      Array.range(frames).for(i => {
        d := Fmt.hypot(trail[k][2 * i] - midx[i], trail[k][2 * i + 1] - midy[i])
        near = i == 0 ? d : Fmt.min(near, d)
        far = Fmt.max(far, d)
      })
      nears[k] = near
      fars[k] = far
      biggest = Fmt.max(biggest, far)
    })
    /* a body that keeps to the middle is what the others go round, not one of them */
    goes := Array.range(p.bodies).map(k => fars[k] > biggest / 50 & fars[k] > nears[k] + 0.0001)
    [0, 1].for(col => {
      cx := col == 0 ? cw / 2 : cw + GAP2 + cw / 2
      cy := top + side / 2
      s.fill_style("#0b1119")
      s.fill_rect(cx - side / 2, cy - side / 2, side, side)
      Array.range(2 * R + 1).for(yi => {
        y := yi - R
        Array.range(2 * R + 1).for(xi => {
          x := xi - R
          i := p.box(x, y)
          unless one[i] < 0 {
            if col == 1 {
              /* where space is destroyed by one body's rays against another's, averaged over the film so far, in the log against the peak */
              ink := Panel.lg(Fmt.max(0, accumulated[i] / Real.of(count)) / peakG, 0.004)
              if ink > 0.015 {
                s.alpha(Fmt.min(1, ink))
                s.fill_style(Panel.PAIR)
                s.fill_rect(cx + x * pz - pz / 2, cy + y * pz - pz / 2, pz + 0.6, pz + 0.6)
              }
            } else {
              a := Fmt.max(0, one[i]) / peakA
              b := Fmt.max(0, two[i]) / peakB
              tot := a + b
              if tot > 0 {
                shade := Panel.lg(tot, floorAB)
                if shade > 0.012 {
                  f := b / tot
                  other := (p.colours.empty | bys[0] == None) ? Panel.TWO : Panel.blend(p, bys, p.coarse(x, y))
                  s.alpha(Fmt.min(1, shade))
                  s.fill_style(Panel.mix(Panel.ONE, other, f))
                  s.fill_rect(cx + x * pz - pz / 2, cy + y * pz - pz / 2, pz + 0.6, pz + 0.6)
                }
              }
            }
          }
        })
      })
      /* the ring each body's farthest makes about the heavy one, and the path it took inside it */
      Array.range(p.bodies).for(k => {
        n := trail[k].length / 2
        if n > 1 & goes[k] {
          colour := p.ring == None ? Panel.SEEN : p.ring(k)
          s.stroke_style(colour)
          s.line_width(1)
          /* the two rings its path rides between, about the heavy one: on a circle they would be the same ring */
          s.alpha(0.3)
          s.dash([3, 4])
          s.begin_path
          s.arc(cx + midx[frames - 1] * p.PIX * pz, cy + midy[frames - 1] * p.PIX * pz, fars[k] * p.PIX * pz, 0, 2 * Real.PI)
          s.stroke
          if nears[k] > 0 {
            s.begin_path
            s.arc(cx + midx[frames - 1] * p.PIX * pz, cy + midy[frames - 1] * p.PIX * pz, nears[k] * p.PIX * pz, 0, 2 * Real.PI)
            s.stroke
          }
          s.dash([])
          s.alpha(0.65)
          s.begin_path
          Array.range(n).for(i => {
            px := cx + trail[k][2 * i] * p.PIX * pz
            py := cy + trail[k][2 * i + 1] * p.PIX * pz
            if i == 0 {
              s.move_to(px, py)
            } else {
              s.line_to(px, py)
            }
          })
          s.stroke
        }
      })
      s.alpha(1)
      heaviest := 0.000000000000000000000000000001
      Array.range(p.bodies).for(k => { heaviest = Fmt.max(heaviest, marks[k * 6 + 5]) })
      Array.range(p.bodies).for(k => {
        bx := marks[k * 6] * p.PIX
        by := marks[k * 6 + 1] * p.PIX
        heavy := marks[k * 6 + 5] / heaviest
        r := Fmt.max(1.6, 3.5 * heavy.sqrt) * pz * p.PIX
        s.stroke_style(p.ring == None ? Panel.SEEN : p.ring(k))
        s.line_width(1.1)
        s.begin_path
        s.arc(cx + bx * pz, cy + by * pz, r, 0, 2 * Real.PI)
        s.stroke
      })
    })
    /* and the same in numbers, along the bottom: how near and how far each body came of the heavy one, and what the two of them make of its eccentricity */
    s.font("11px ui-monospace, monospace")
    s.text_align("left")
    s.text_baseline("bottom")
    at := 8
    Array.range(p.bodies).for(k => {
      if trail[k].length > 4 & goes[k] {
        e := (fars[k] - nears[k]) / (fars[k] + nears[k])
        near_text := Fmt.fixed(nears[k], 2)
        far_text := Fmt.fixed(fars[k], 2)
        e_text := Fmt.fixed(e, 3)
        unit := at < 9 ? " c-bar" : ""
        /* how far its nearest point walks each turn is not a thing a frame can see - a turn is placed off the ticks themselves, and the recorder says it (record.gpu `watching`) */
        line := "{near_text}-{far_text}{unit}, e {e_text}"
        s.fill_style(p.ring == None ? Panel.SEEN : p.ring(k))
        s.fill_text(line, at, H - 2)
        at = at + s.measure(line) + 16
      }
    })
  }

  /* a panel as a visual: its recording and its painter */
  static of (p: Setup): Picture => {
    BOX := p.box_side * p.box_side
    names := ["one", "two", "gone"]
    sizes := [BOX, BOX, BOX]
    /* where several bodies are coloured, each one's own rays are a channel of their own (`by0`, `by1`, ...): what the colours are mixed by */
    COARSE := p.coarse_side * p.coarse_side
    unless p.colours.empty { Array.range(p.tags > 2 ? p.tags - 2 : 1).for(k => { names.push("by{k}"); sizes.push(COARSE) }) }
    names.push("marks")
    sizes.push(6 * p.bodies + 1)
    r := FieldRecording(stamp: "{p.stamp}/shares", names: names, sizes: sizes, p: p)
    v := Picture(id: p.id, what: p.what, width: p.width, height: p.height, frames: p.RUN, paint: (played: Played?) => FieldPainter(p: p, played: played))
    v.record = r
    v
  }
}
