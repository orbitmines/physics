/*
 * THE PROVER - what follows from the rules, closed forward, and then a question looked up.
 *
 * FORWARD, NOT BACKWARD. A backward prover is handed the thing to prove and works towards the
 * premises, so if the thing to prove is `F ∝ 1/r²` the square was in the input. This one is handed
 * what the RULES say - the equation Reading.ray counted off their bodies - closes it under the
 * inference rules (Inferences.ray) until nothing new appears, and only then is asked what became
 * of a quantity. The exponent is read off the answer. Nobody types it.
 *
 * THE PREMISES ARE THE PROGRAM. A leaf here is not measured and not believed: it is read off the
 * equation's terms, which are read off the rule bodies - the degree in the density is the
 * quantifier, the share is the gate's own expression, the sign is what the atoms do to the ledgers,
 * the restoring rate is the DERIVATIVE of the line's own terms (Expr.ray). A rule edited in G.ray
 * moves the conclusion. A missing conclusion is a result, and `missing` says which premise was absent.
 *
 * A theorem is `theorem "id" () => Asked(asks: ..., about: ...)` on a theory: the closure is one,
 * and a theorem is the part of it behind one name. `theory.proved` is every theorem answered.
 */

/* what can be known about a quantity: the vocabulary, short on purpose */
Fact := class < kind: String, of: String {
  /* `is`: what it is; `grows`: as what; `restored`: at what rate */
  to: Expr? = None
  key (): String => "{this.kind}({this.of})"
  says (): String => {
    return "{this.of} = {Expr.show(this.to)}" if this.kind == "is"
    return "{this.of} is conserved on its way out" if this.kind == "conserved"
    return "{this.of} goes every way alike" if this.kind == "isotropic"
    return "{this.of} grows as {Expr.show(this.to)}" if this.kind == "grows"
    return "{this.of} is pushed back at {Expr.show(this.to)}" if this.kind == "restored"
    "{this.of} > 0"
  }
  static stands (of: String, to: Expr): Fact => Fact(kind: "is", of: of, to: to)
  static key_of (kind: String, of: String): String => "{kind}({of})"
}

/* one step of a proof: what it concluded, how, from what, and why */
Step := class < fact: Fact, via: String {
  /* the rewrite it is about, where it is about one */
  rule: String? = None
  upon: String[] = []
  because: String = ""
  working: String[] = []
  /* the proof of this step itself, where a leaf has arithmetic behind it - and it must end at the leaf */
  derivation: Step[] = []
  /* pieces a later step reads back - a quotient's numerator and denominator */
  parts_: Expr[] = []
  round_: N = 0
  static of (fact: Fact, via: String, upon: String[], because: String, working: String[]): Step => Step(fact: fact, via: via, upon: upon, because: because, working: working)
}

/* everything known so far, first arrival keeping the slot */
Store := class {
  steps: {} = { }
  keys: String[] = []
  version: N = 0
  round_: N = 0
  has (kind: String, of: String): boolean => this.get(kind, of) != None
  get (kind: String, of: String): Step? => {
    k := "{kind}({of})"
    this.steps[k]
  }
  fact (kind: String, of: String): Fact? => {
    st := this.get(kind, of)
    st == None ? None : st.fact
  }
  /* an `is` fact's value, or None */
  stands (of: String): Expr? => {
    st := this.get("is", of)
    st == None ? None : st.fact.to
  }
  all (kind: String): Fact[] => this.keys.map(k => this.steps[k]).filter(st => st.fact.kind == kind).map(st => st.fact)
  nodes (): Step[] => this.keys.map(k => this.steps[k])
  add (st: Step): boolean => {
    k := st.fact.key
    return false if this.steps[k] != None
    st.round_ = this.round_
    this.steps[k] = st
    this.keys.push(k)
    this.version = this.version + 1
    true
  }
}

/* an inference rule: what it concludes from the store, and why that is allowed */
Inference := class < name: String, because: String, fire: Program { }

/* a question a theory is asked: the name of the fact that answers it, and the second writing of the law where there is one */
Asked := class < asks: String, about: String {
  also: String? = None
  leads: String? = None
  then: String? = None
  chain: String? = None
}

/* one line of an answer as a page shows it */
Line := class < kind: String, via: String, line: String, working: String[], because: String {
  id: String = ""
  upon: String[] = []
  rule: String? = None
  source: String? = None
  gates: String[] = []
  derivation: Line[] = []
}
Standing := class < name: String, stands: String, because: String { }
Part := class < part: String, stands: String, because: String { }
TermRecord := class < symbol: String, sign: Real, degree: N, facing: boolean, rays: String, space: String, rules: String[], says: String { }

/* what one theory concluded about one question, and everything behind it */
Proved := class < theorem: String, theory: String, asks: String, about: String {
  concluded: String? = None
  also: String? = None
  leads: String? = None
  then: String? = None
  space: String? = None
  folds: String? = None
  /* the two ledgers added: where the record and the space part company */
  together: String? = None
  /* the field of the bodies: the line solved along a heading, the past forgotten */
  field: String? = None
  /* the lines under the claim, one below another: what the claim's names are */
  beneath: String[] = []
  parts: Part[] = []
  standing_for: Standing[] = []
  standing: boolean = false
  missing: String[] = []
  cites: Reference[] = []
  terms: TermRecord[] = []
  steps: Line[] = []
}

/* every theorem of a theory, answered */
Proof := class < theory: String, proved: Proved[] {
  theorem (id: String): Proved? => this.proved.filter(p => p.theorem == id).first
  has (id: String): boolean => this.theorem(id) != None
  concluded (id: String): String? => {
    p := this.theorem(id)
    p == None ? None : p.concluded
  }
  standing (id: String): boolean => {
    p := this.theorem(id)
    p == None ? false : p.standing
  }
  ids (): String[] => this.proved.map(p => p.theorem)
}

Theorem += {
  asked (): Asked => this.body()
}

Theory += {
  /* what the rules come to: every theorem, off one closure - run once, however often it is asked for */
  proved (): Proof => {
    Prover.PROOFS[this.name] = Prover(theory: this).proof if Prover.PROOFS[this.name] == None
    Prover.PROOFS[this.name]
  }
}

/* one term of the equation, as the prover reads it: the old continuum's shape, off the Reading's ledgers */
TermInfo := class < term: EquationTerm {
  rules (): String[] => (this.term.rule == None | this.outside) ? [] : [this.term.rule.name.upper]
  rule_id (): String? => this.term.rule == None ? None : this.term.rule.id
  rate (): String? => this.term.rate == None ? None : Expr.name_of(this.term.rate)
  degree (): N => this.term.degree
  facing (): boolean => this.term.degree >= 2
  outside (): boolean => this.term.outside
  settles (): boolean => this.term.settles
  carries (): boolean => this.term.doing.carries
  transport (): boolean => this.term.transport
  side (): String => (this.settles | this.transport) ? "left" : "right"
  share (): Expr? => this.term.doing.share.source == "1" ? None : Expr.of_source(this.term.doing.share.source)
  /* of the share, what the match itself asked, and what the branch found around it - the two multiply to the share */
  asked (): Expr? => this.term.doing.asked.source == "1" ? None : Expr.of_source(this.term.doing.asked.source)
  around (): Expr? => this.term.doing.around.source == "1" ? None : Expr.of_source(this.term.doing.around.source)
  ray_count (): Expr => Expr.of_source(this.term.doing.rays.source)
  space_count (): Expr => Expr.of_source(this.term.doing.space.source)
  fold_count (): Expr => Expr.of_source(this.term.doing.folds.source)
  rays (): String => Expr.show(Expr.simplify(this.ray_count))
  space (): String => Expr.show(Expr.simplify(this.space_count))
  folds (): String => Expr.show(Expr.simplify(this.fold_count))
  net (): Real => Expr.numeric(Expr.evaluate(this.ray_count, TermInfo.COUNTS), TermInfo.COUNTS)
  space_net (): Real => Expr.numeric(Expr.evaluate(this.space_count, TermInfo.COUNTS), TermInfo.COUNTS)
  sign (): Real => this.net < 0 ? -1 : 1
  over (): String => this.term.rule == None ? "World" : (this.term.rule.over == "Vertex" ? "Local" : this.term.rule.over)
  says (): String => this.term.rule == None ? "put in from outside" : this.term.rule.source
  draws (): boolean => this.term.doing.draws != None
  grown (): boolean => this.term.doing.grown
  /* the turn: what a heading keeps of itself, and which way what is left of it leans */
  kernel (): boolean => this.term.leans != None
  keeps (): Expr => Expr.pown(Expr.add([Expr.num(1), Expr.field("n_{{f}}")]), -1)
  drifts (): Expr => Expr.grad(Expr.field("n_{{f}}"))
  static COUNTS (): {} => { s := { }; s["DEG"] = 8; s }
  /* the term as an expression over the line's names: rate, share and the power of the density - or, from outside, the mass at the local and what is around it */
  expr (): Expr => {
    parts := []
    if this.outside {
      parts.push(Expr.field("l.\\bar{{m}}"))
      parts.push(this.around) if this.around != None
    } else {
      parts.push(Expr.field(this.rate)) if this.rate != None
      parts.push(this.share) if this.share != None
      parts.push(Expr.pown(Expr.field("n"), this.degree)) if this.degree > 0
    }
    parts.empty ? Expr.num(1) : Expr.mul(parts)
  }
  gate (): String => {
    s := this.outside ? this.around : this.share
    return "" if s == None
    Expr.simplify(s).kind == "add" ? "\\paren{{{Expr.show(s)}}}" : Expr.show(s)
  }
  operator (): String? => {
    return "\\partial_{{t}}" if this.settles
    if this.transport {
      carry := "\\hat{{d}}·\\nabla_{{l}}"
      return this.kernel ? "{carry} + \\paren{{{Expr.show(this.drifts)}}}·\\nabla_{{\\hat{{d}}}}" : carry
    }
    None
  }
  static powers (n: String, degree: N): String => degree == 0 ? "" : (degree == 1 ? n : (degree == 2 ? "{n}\\tilde{{{n}}}" : "{n}^{{{degree}}}"))
  symbol (): String => {
    population := "n"
    return "{this.gate}l.\\bar{{m}}" if this.outside
    return "\\partial_{{t}}{population}" if this.settles
    return "{this.operator}{population}" if this.transport
    rate := this.rate ?? ""
    room := this.gate
    pw := TermInfo.powers(population, this.degree)
    gap := (!rate.empty & room.empty & !pw.empty) ? " " : ""
    "{rate}{room}{gap}{pw}"
  }
}

Prover := class < theory: Theory {
  static PROOFS = { }
  /* the population's and the record's filled lines, kept for the steps that read them */
  population_line: Step? = None
  record_line: Step? = None
  store: Store = Store()
  equation (): Equation => this.theory.equation
  infos (): TermInfo[] => this.equation.terms.map(t => TermInfo(term: t))
  /* the terms a premise is read off: a rule's, on the right, with a rate */
  acting (): TermInfo[] => this.infos.filter(t => t.side != "left" & !t.rules.empty & t.rate != None)

  static rho (): Expr => Expr.field("\\rho")
  static text (f: Fact): String => f.to == None ? "-" : Expr.show(f.to)
  /* the term as the balance reads it: rate, share, the density to the degree */
  static body_of (t: TermInfo): Expr => {
    parts := [Expr.field(t.rate)]
    parts.push(t.share) if t.share != None
    parts.push(Expr.pown(Prover.rho, t.degree)) if t.degree > 0
    Expr.simplify(Expr.mul(parts))
  }

  /* THE LEAVES, read off the equation. Every one of them is already in the program. */
  premises (): Step[] => {
    out := []
    equation := this.equation
    infos := this.infos
    acting := this.acting
    /* how hard the line pushes a disturbance back - differentiated, not asserted */
    a := Expr.num(0)
    steps := []
    acting.for(t => {
      body := Prover.body_of(t)
      slope := Expr.simplify(Expr.d(body, "\\rho"))
      signed := Expr.simplify(Expr.mul([Expr.num(t.sign == -1 ? 1 : -1), slope]))
      a = Expr.simplify(Expr.add([a, signed]))
      nm := t.rules.join(", ")
      how := t.sign == -1 ? "subtracted" : "added"
      leaf := Step.of(Fact.stands("how {t.symbol} answers a change in the density", signed), "differentiating a term", [Fact.key_of("is", t.symbol)],
        "{nm} contributes {t.symbol}, which is its rate times what its gates let through times the density to the power its quantifier gives. How that answers a small change in the density is the DERIVATIVE - the product rule, on what the rule already said the term was. A term that shrinks as the density rises pushes a shortfall back, so the sign is turned about what the term itself carries",
        ["{t.symbol} = {Expr.show(body)}", "d/d\\rho = {Expr.show(slope)}", "the term is {how}, so it restores by {Expr.show(signed)}"])
      leaf.rule = t.rules[0]
      term := this.from_rule(t)
      leaf.derivation = term.nodes.concat([leaf])
      steps.push(leaf)
    })
    restored := Step.of(Fact(kind: "restored", of: "\\rho", to: a), "and so the rate", steps.map(x => x.fact.key),
      "every term that depends on the density answers a change in it, and they do not consult one another - so what the line does back to A CHANGE IN THE DENSITY is their sum",
      Array.range(acting.length).map(i => "{acting[i].symbol}: {Expr.show(steps[i].fact.to)}").concat(["a = {Expr.show(a)}"]))
    restored.derivation = steps
    out.push(restored)
    /* a discrepancy is conserved because every rule is a function of its own match */
    reaching := infos.filter(t => !t.rules.empty & t.outside)
    if reaching.empty {
      count := infos.filter(t => !t.rules.empty).length
      out.push(Step.of(Fact(kind: "conserved", of: "\\delta"), "every rule is a function of its own match", [],
        "a rule reads the refs its match handed over and nothing else, so two worlds that agree about a match agree after it - a difference between them can be moved and cannot be made or unmade. What a meeting takes from the disturbed world it leaves as a hole in the undisturbed one, and the difference is the same size. So as much of the shortfall crosses a far shell as a near one, which is what the dilution argument wants",
        ["every one of the {count} terms the line carries is a rule acting on the match it was handed", "none of them consults anything outside it, so agreement is carried and disagreement is only moved", "the DENSITY is pushed back at a = {Expr.show(a)}, which is a different quantity"]))
    }
    /* whether the disturbance survives its own transport: a claim about the kernel */
    turning := infos.filter(t => t.kernel).first
    if turning != None {
      g := Expr.simplify(turning.keeps)
      tr := Expr.simplify(Expr.mul([Expr.field("\\sigma"), Expr.sub(Expr.num(1), turning.keeps)]))
      via := turning.rules.join(", ")
      gs := Step.of(Fact.stands("g", g), via.empty ? "the turn" : via, [],
        "the rule's body chooses where a ray goes next, and what is left of a heading after one such choice is its cosine moment - one way straight on against the folded ones",
        ["the choice is 1 way straight on against n_{{f}} folded", "g = {Expr.show(g)}"])
      gs.rule = turning.rules[0]
      st := Step.of(Fact.stands("\\sigma_{{tr}}", tr), "the kernel", [],
        "what removes a DIRECTION is not what removes a ray: a turn that sends it on nearly the way it was going has hardly removed it, so the transport cross section is sigma times what the turn does NOT keep", [])
      st.derivation = [gs, Step.of(Fact.stands("\\sigma_{{tr}}", tr), "and so the transport cross section", [Fact.key_of("is", "g")],
        "what removes a RAY is not what removes a DIRECTION: a turn that sends it on nearly the way it was going has hardly removed it, so what attenuates a shadow is the rate times what the turn does NOT keep",
        ["g = {Expr.show(g)}", "\\sigma_{{tr}} = \\sigma(1-g) = {Expr.show(tr)}"])]
      out.push(st)
      sw := Step.of(Fact.stands("what swings a heading", turning.drifts), "the kernel", [],
        "the line's direction term is the kernel's first moment - which way a turn leans on average", [])
      inner := Step.of(Fact.stands("what swings a heading", turning.drifts), via.empty ? "the turn" : via, [],
        "the same choice, read as a first moment rather than as a cosine: where the cosine says how much of a heading survives, this says which way what is left of it leans - and it leans toward where the folds are, since those are the ways the choice offers besides straight on",
        ["the choice is 1 way straight on against n_{{f}} folded", "<d^> = {Expr.show(Expr.simplify(turning.drifts))}"])
      inner.rule = turning.rules[0]
      sw.derivation = [inner]
      out.push(sw)
    }
    /* every rate is one: a rewrite fires on every match it has, once a tick */
    rates := []
    infos.for(t => { rates.push(t.rate) if t.rate != None & !rates.contains(t.rate) })
    rates.for(name => {
      out.push(Step.of(Fact.stands(name, Expr.num(1)), "the rewrite", [],
        "a rewrite fires on every match it has, once a tick - that is what a rule of this model is. So its rate is ONE per match per tick, and the name on it says which rewrite rather than how often: there is nothing here to choose or to fit",
        ["{name} = 1 per match per tick"]))
    })
    /* what each ledger nets over the whole line */
    ["rays", "space", "folds"].for(ledger => {
      parts := []
      acting.for(t => {
        c := ledger == "rays" ? t.ray_count : (ledger == "space" ? t.space_count : t.fold_count)
        parts.push(Expr.simplify(Expr.mul([Prover.body_of(t), c])))
      })
      unless parts.empty {
        out.push(Step.of(Fact.stands("the {ledger} line nets", Expr.simplify(Expr.add(parts))), "the line", [],
          "every term of the line does something to the {ledger} ledger - its rate, times what its gates let through, times the count one firing puts in - and what the ledger does per point per tick is those added up. Nothing is left out and nothing is counted twice, which is the whole reason for reading it off the line rather than assembling it again wherever it is wanted",
          acting.map(t => {
            c := ledger == "rays" ? t.ray_count : (ledger == "space" ? t.space_count : t.fold_count)
            "{t.rules.join(sep2)}: {t.symbol} into {ledger} {Expr.show(c)}"
          })))
      }
    })
    /* what is made and what is taken, and the counts one firing puts in each ledger */
    acting.for(t => {
      body := Prover.body_of(t)
      which := t.sign < 0 ? "taken" : "made"
      nm := t.rules.join(", ")
      verb := t.sign < 0 ? "takes" : "makes"
      made := Step.of(Fact.stands("what is {which}", body), t.rules[0], [],
        "{nm} {verb} at {Expr.show(body)} - its rate, times what its gates let through, times the density to the power its quantifier gives", [])
      made.rule = t.rules[0]
      out.push(made)
      if t.rays == "0" & t.space_net > 0 {
        w := Step.of(Fact.stands("what the waiting makes", body), t.rules[0], [],
          "{nm} hands the ray to itself and grows the world - no ray made, destroyed or moved, and a point of space where there was none. That is a carrier standing still to make the room it could not step into, and the rate it does so at is {Expr.show(body)}",
          ["no rays, {Expr.show(t.space_count)} of space", "the waiting makes {Expr.show(body)}"])
        w.rule = t.rules[0]
        out.push(w)
      }
      [["rays", t.ray_count], ["space", t.space_count], ["folds", t.fold_count]].for(pair => {
        ledger := pair[0]
        per := pair[1]
        c := Step.of(Fact.stands("the {ledger} count of what is {which}", per), t.rules[0], [],
          "{nm} fires at {Expr.show(body)}, and ONE firing of it puts {Expr.show(per)} into the {ledger} ledger - counted off the body, not written down. The two ledgers get different counts from the same firing, which is why they do not settle at the same density",
          ["fires at {Expr.show(body)}", "{ledger} per firing: {Expr.show(per)}"])
        c.rule = t.rules[0]
        out.push(c)
      })
    })
    /* S: what a body puts into the medium is the making that did not happen where it sits */
    maker := acting.filter(t => t.sign > 0).first
    if maker != None {
      parts := [Expr.field(maker.rate)]
      parts.push(maker.share) if maker.share != None
      s := Step.of(Fact.stands("S", Expr.simplify(Expr.mul(parts))), maker.rules[0], [],
        "{maker.rules.join(sep2)} fires because a point is neutral, and matter is not - so what a body puts into the medium is exactly the making that did not happen where it sits. Its strength is that term, and is not a quantity of its own", [])
      s.rule = maker.rules[0]
      out.push(s)
    }
    lit := acting.filter(t => t.sign > 0 & t.rays != "0").first
    if lit != None {
      w := Step.of(Fact.stands("the ways out of a point", Expr.field(lit.rays)), lit.rules[0], [],
        "{lit.rules.join(sep2)} lights every exit a point has, so the count its body ran over is how many ways out there are - {lit.rays}. A shortfall is ways out that are missing, so that count is also its ceiling",
        ["the body lit {lit.rays} exits", "so a point has {lit.rays} ways out"])
      w.rule = lit.rules[0]
      out.push(w)
    }
    /* the source: the term no rewrite of the medium puts there */
    source := infos.filter(t => t.outside).first
    if source != None {
      /*
       * what a body puts out is a CHOICE over its ways, not a bare product: which of its l.DEG exits it lights, at
       * m-bar_x apiece - and what its own rule asked of it (spare: the ticks not spent moving, 1 - beta) is a
       * statement about which exits, so it goes inside the choice. What the branch found around the body
       * (the room ahead) is the medium's and stays outside. `l.choose` is carried by name and read as its
       * argument where a number is wanted.
       */
      chosen := [Expr.field("\\bar{{m}}_{{x}}"), Expr.field("l.DEG")]
      chosen.push(source.asked) if source.asked != None
      mass := Expr.call("l.choose", Expr.simplify(Expr.mul(chosen)))
      out.push(Step.of(Fact.stands("l.\\bar{{m}}", mass), "put in from outside", [],
        "the line is written at a local, l, and what a source puts in there is its mass - a choice over that local's ways out: which of its l.DEG exits it lights, at \\bar{{m}}_{{x}} apiece, on the ticks its own rule leaves it. The gate the rule asked of the source is inside the choice because it is a statement about which exits, and the line carries nothing of the source but this",
        ["the term is {source.symbol}", "l.\\bar{{m}} = {Expr.show(mass)}"]))
      parts := [mass]
      parts.push(source.around) if source.around != None
      sigma := Expr.simplify(Expr.mul(parts))
      out.push(Step.of(Fact.stands("what a body puts out", sigma), "put in from outside", [],
        "what a body puts out is the term no rewrite puts there, scaled by what its gates let through - and a body going somewhere has spent that share of its ticks moving rather than shining, which is the whole of why a moving source is shifted. AND IT IS NAMED \\bar{{m}}_{{x}} BECAUSE THAT IS ITS NAME - how often per tick a source activates one direction, a fraction of \\bar{{c}} whose period is 1/\\bar{{m}}_{{x}}. Calling the same number \\Sigma_{{0}} here made the medium's ledger and the source's own rate look like two quantities, and every law that touched both then carried the seam between them",
        ["the term is {source.symbol}"]))
      out.push(Step.of(Fact(kind: "conserved", of: "what a body puts out"), "the kernel", [],
        "what a source puts out survives its own transport for the same reason a shortfall does - a turn that keeps the heading loses none of it", []))
      out.push(Step.of(Fact(kind: "isotropic", of: "what a body puts out"), "put in from outside", [],
        "a body lights its exits alike, so what leaves it goes every way alike", []))
      feels := Step.of(Fact.stands("what a body feels", Expr.field("\\sum\\hat{{d}}")), "EMISSION", [],
        "the rule adds the ray's own exit to the body's momentum, once per ray taken - so what a body feels is the vector sum of the directions that arrived at it, and a count of them would be a different quantity that is not what any rule computes",
        ["each absorbed ray adds its exit", "force = \\sum \\hat{{d}} over what arrives"])
      feels.rule = "EMISSION"
      out.push(feels)
    }
    /* the streaming term: its gate is the share of a step that advances, and a step is one cell */
    moving := infos.filter(t => t.transport).first
    if moving != None {
      if moving.share != None {
        st := Step.of(Fact.stands("what share of a step advances", Expr.simplify(moving.share)), moving.rules[0], [],
          "the streaming term is gated: a ray hands over only where the way it drew leads somewhere, and where it does not it makes the room and waits instead. That gate is on the transport, so it is on the speed - and its complement is on the waiting, which is the other arm of the same either and the only other thing in these rules that makes space. One share, both lines", [])
        st.rule = moving.rules[0]
        out.push(st)
      }
      c := Step.of(Fact.stands("\\bar{{c}}", Expr.num(1)), moving.rules[0], [],
        "every active ray goes ONE CELL along its own exit in one tick, which is what the streaming term says - so a step is one cell, and that is the only length the lattice has to measure anything else against", [])
      c.rule = moving.rules[0]
      out.push(c)
    }
    /* the room ahead, read off `outward`: a way leads to the point across it; a folded point is followed through to its hub; None comes back only where there is no point across the way at all - the world's edge. The vacuum here is infinite and has none */
    out.push(Step.of(Fact.stands("\\omega", Expr.num(1)), "a way always leads somewhere", [],
      "`outward` finds the point across the way, and where that point has been folded it follows it through to the hub it was folded into - so a way that led somewhere still does, hub or point. It comes back with nothing only where there is no point across the way at all, which is the edge of a finite world. The vacuum the line is written in is infinite: every way has a point across it, and the share of ways with room ahead is all of them",
      ["outward(d): the point across d; folded, the hub it is in; None only across the world's edge", "an infinite vacuum has no edge", "\\omega = 1"]))
    out.push(Step.of(Fact(kind: "isotropic", of: "\\delta"), "the lattice", [],
      "the tiling has no preferred direction, so what spreads through it goes every way alike", []))
    out
  }

  /* HOW A TERM CAME TO BE: the rule's body counted line by line, ending at the term itself */
  from_rule (t: TermInfo): Store => {
    s := Store()
    name := t.rules[0]
    body := t.says
    pieces := []
    pieces.push("{t.rays} rays") if t.rays != "0"
    pieces.push("{t.space} points of space") if t.space != "0"
    pieces.push("carries the population") if t.carries
    pieces.push("settles the tick") if t.settles
    both := pieces.empty ? "nothing to either ledger" : pieces.join(", ")
    top := "what the body does"
    b := Step.of(Fact.stands(top, t.ray_count), "the body", [], "{body} - {both}. The reading follows the body down through the methods it calls, and the ledgers it moves are counted off the assignments it makes", ["rays: {t.rays}", "space: {t.space}", "folds: {t.folds}"])
    b.rule = name
    s.add(b)
    degree_of := t.degree == 0 ? "no power of the density" : (t.degree == 1 ? "the density once" : "the density to the power {t.degree}")
    facing := t.facing ? " - and the two are across an edge, so the rate goes against the oncoming current, which is the facing factor F" : ""
    q := Step.of(Fact.stands("what {name} is about", Expr.num(t.degree)), "the quantifier", [],
      "the rule is quantified over {t.degree} population-bearing refs, so its term carries {degree_of}{facing}", [])
    q.rule = name
    s.add(q)
    gates := this.gates_of(t)
    gates.for(g => {
      gs := Step.of(Fact.stands("what {g[0]} lets through", g[1]), "a gate", [],
        "the rule fires only where {g[0]}, so whatever it does it does on that share of its matches and the term carries it", [])
      gs.rule = name
      s.add(gs)
    })
    shares := gates.map(g => g[1])
    rate := t.rate ?? "nothing"
    term := Step.of(Fact.stands(t.symbol, Expr.simplify(Expr.mul(shares.empty ? [Expr.num(1)] : shares))), "and so the term",
      [Fact.key_of("is", top), Fact.key_of("is", "what {name} is about")].concat(gates.map(g => Fact.key_of("is", "what {g[0]} lets through"))),
      "the rate it fires at is called {rate}, and it fires on the share its gates let through, once per thing it is quantified over. Multiplied out, that is the term",
      [t.rate == None ? "no rate - it neither makes nor takes" : "rate: {t.rate}"].concat(shares.map(x => "share: {Expr.show(x)}")).concat(["degree: {degree_of}", "term: {t.symbol}"]))
    term.rule = name
    s.add(term)
    s
  }
  /* the gates of a rule: what its match must satisfy, and the share that lets through */
  gates_of (t: TermInfo): Array => {
    return [] if t.share == None
    where := t.term.rule == None | t.term.rule.where == None ? "the match holds" : t.term.rule.where.source
    [[where, t.share]]
  }
  /* everything that follows, and then nothing new: each rule re-run only where the store has grown since it last came up empty */
  static saturate (s: Store, rules: Inference[], cap: N = 40) => {
    idle := { }
    round := 1
    while round <= cap {
      s.round_ = round
      grew := 0
      Array.range(rules.length).for(i => {
        rule := rules[i]
        if idle[i] != s.version {
          before := s.version
          any := false
          rule.fire(s).for(st => { if s.add(st) { grew = grew + 1; any = true } })
          idle[i] = before if !any
        }
      })
      return None if grew == 0
      round = round + 1
    }
    fail("the rules are still producing facts - something in them feeds itself")
  }

  /*
   * THE CONTINUOUS MODEL, AS THE ROOT. The reading turns the rules into a line; every premise the theorems stand on - what is made, what
   * is taken, the counts, the ways out, the source, the speed, the room ahead, the turn - is a term of that line or a reading of one.
   * So the line is stood first, cited to the rules, and every such premise is read off it: one step of indirection, and every theorem's
   * derivation passes through the model rather than reaching past it to the rules. What is not the line's stays cited to what it is:
   * the body's own rule (what a body feels) and the lattice (what is isotropic on it).
   */
  model_step (): Step => {
    infos := this.infos
    right := infos.filter(t => t.side == "right" & (t.rules.empty | t.rays != "0"))
    right = right.filter(t => !t.rules.empty).concat(right.filter(t => t.rules.empty))
    rhs := Expr.add(right.map(t => Expr.mul([t.ray_count, t.expr])))
    st := Step.of(Fact.stands("the continuous model", rhs), "the reading", [],
      "the rules, read as a line: every rule of the theory is a term, the reading having run each rule's program on a symbolic match and counted what it does to the population - what it makes, what it takes, what it carries, what a body puts in - so the line is what the rules come to as a crowd rather than a description of them. Everything a theorem of this theory stands on is a term of this line or a reading of one, so every premise below is read off it, and every derivation passes through it",
      [this.line_text, this.space_text])
    st.derivation = this.line_steps
    st
  }
  /* premises the line does not carry: the body's own rule, and the lattice's own facts */
  static not_the_lines (st: Step): boolean => st.fact.of == "what a body feels" | st.via == "the lattice"
  closure (): Store => {
    model := this.model_step
    this.store.add(model)
    infos := this.infos
    this.premises.for(st => {
      if st.upon.empty & !Prover.not_the_lines(st) {
        /* read off the model: which term, and what is read from it - its count, its rate, its share, its degree - then the counting that term came from */
        term := st.rule == None ? None : infos.filter(t => !t.rules.empty & t.rules[0] == st.rule).first
        if term != None {
          sign := term.sign < 0 ? "-" : "+"
          share := term.share == None ? "1" : Expr.show(term.share)
          rate := term.rate ?? "1"
          how := "the term {sign} {term.symbol} of the continuous model: {term.rays} rays a firing, at rate {rate}, on the share {share} of the matches, of degree {term.degree} in the density"
          st.working = ["read off {how}"].concat(st.working)
          st.because = "READ OFF THE CONTINUOUS MODEL - {how}; what this fact takes from it is below. {st.because}"
        } else {
          st.working = ["read off the continuous model: {st.fact.of}, which stands on every term of it alike"].concat(st.working)
          st.because = "READ OFF THE CONTINUOUS MODEL - not one term of it but all of them, since this is about how the line is made. {st.because}"
        }
        st.upon = [model.fact.key]
        st.via = "read off the continuous model"
        st.rule = None
        st.derivation = []
      }
      this.store.add(st)
    })
    Prover.saturate(this.store, Inferences.RULES)
    this.store
  }
  /* what the closure wanted and did not have */
  missing (s: Store): String[] => {
    out := []
    out.push("nothing says the shortfall survives its own transport") if s.all("conserved").empty
    out.push("nothing in the line swings a heading, so there is no index") if !s.all("is").some(f => f.of == "N")
    out
  }

  /* the steps behind one name: what it rests on, premises first */
  static behind (s: Store, about: String): Step[] => {
    out := []
    seen := { }
    walk := (k: String) => {
      unless seen[k] == true {
        st := s.steps[k]
        unless st == None {
          seen[k] = true
          st.upon.for(f => walk(f))
          out.push(st)
        }
      }
    }
    return s.nodes if about.empty
    s.keys.for(k => { walk(k) if s.steps[k].fact.of == about })
    out
  }

  /* THE LINE ITSELF, term by term, each with the counting of its rule behind it */
  line_steps (): Step[] => {
    out := []
    infos := this.infos
    infos.for(t => {
      name := t.rules.empty ? None : t.rules[0]
      rays := t.rays
      does := rays == "0" ? "moves the population without making or taking any" : "comes to {rays} rays and {t.space} points of space"
      power := t.degree == 0 ? "carry no power of the density" : "of degree {t.degree} in the density"
      edge := t.facing ? " across an edge, which is the facing factor" : ""
      edge2 := t.facing ? ", across an edge" : ""
      sign := t.sign < 0 ? "-" : "+"
      why := t.rules.empty ? "no rewrite of the model puts it there - it is what is put into the box from outside, and the only place anything about a particular problem can be written" : "{t.rules.join(sep2)} contributes it: its body {does}, its quantifier makes it {power}{edge}, and its gates let through what they let through"
      st := Step.of(Fact.stands(t.symbol, Expr.simplify(Expr.mul([Expr.num(t.sign), Expr.sym(rays == "0" ? "carried" : rays)]))), name ?? "put in from outside", [], why,
        ["rays: {rays}", "space: {t.space}", "degree: {t.degree}{edge2}", "term: {sign} {t.symbol}"])
      st.rule = name
      st.derivation = name == None ? [] : this.from_rule(t).nodes
      out.push(st)
    })
    rhs := infos.filter(t => t.side == "right")
    lhs := infos.filter(t => t.side == "left").map(t => t.operator ?? t.symbol).join(" + ")
    equation := this.equation
    out.push(Step.of(Fact.stands("{lhs}n", Expr.simplify(Expr.add(rhs.map(t => Expr.mul([Expr.num(t.sign), Expr.sym(t.symbol)]))))), "and the terms add", infos.map(t => Fact.key_of("is", t.symbol)),
      "the rules do not consult one another - each fires on its own matches once a tick - so what they do to the population adds, and the line is what they come to rather than a description of them. A theory with a rule taken out writes one term fewer here without anything else changing",
      infos.map(t => {
        sign := t.sign < 0 ? "-" : "+"
        by := t.rules.empty ? "not a rule" : t.rules.join(sep2)
        "{sign} {t.symbol}   ({by})"
      }).concat([this.line_text, this.space_text])))
    out
  }
  /* the line and the space line, as the old continuum wrote them */
  line_text (): String => {
    infos := this.infos
    left := infos.filter(t => t.side == "left")
    left = left.filter(t => t.operator == "\\partial_{{t}}").concat(left.filter(t => t.operator != "\\partial_{{t}}"))
    right := infos.filter(t => t.side == "right" & (t.rules.empty | t.rays != "0"))
    right = right.filter(t => !t.rules.empty).concat(right.filter(t => t.rules.empty))
    lhs := left.empty ? "n" : "({left.map(t => t.operator ?? t.symbol).join(plus)})n"
    rhs := ""
    Array.range(right.length).for(i => {
      t := right[i]
      piece := i == 0 ? (t.sign == -1 ? "-" : "") : (t.sign == -1 ? " - " : " + ")
      rhs = "{rhs}{piece}{t.symbol}"
    })
    rhs = "0" if right.empty
    "{lhs} = {rhs}"
  }
  /* THE DENSITY IS THE SHARE OF A POINT'S WAYS THAT ARE LIT - rho = <min(1, n_d)> over the ways, as the field computes it. The line's n is the
   * count on one heading, so the two are one name under two conditions, both said here: every heading alike (isotropic), and at most one ray
   * a way (dilute). Above one a way's count keeps growing while its activity saturates, and the two part company. */
  static POPULATION (): Expr => Expr.field("\\rho")
  isotropic_population (): Step => Step.of(Fact.stands("n", Prover.POPULATION), "the density is the share of ways lit", [],
    "\\rho is not a second population: it is the lit ways of a point over all DEG of them, each way's count clamped to one before it is counted and the whole averaged over the headings - which is what the field computes at every cell. The line's n is the count on one heading. So the two are one name on two conditions. ISOTROPIC: the rules light every exit of a point alike and turn a heading by a record that is the same from every side, so nothing picks a heading out and the average over the headings is the count on any one. DILUTE: a way holds at most one ray, so clamping it to one changes nothing. Both hold in the vacuum the line is about; where a way carries more than one ray, \\rho saturates at one while n keeps counting, and the meeting term the reading writes as n^{{2}} is the field's \\rho^{{2}} - one pair per edge per tick. Read per point rather than per heading, n would be the rays over all the ways and the same statement is \\rho = n/DEG, the lattice's count of ways being exactly the factor that stands in l.choose and in front of the creation term",
    ["\\rho = \\langle \\min(1, n_{{d}}) \\rangle_{{d}} - the lit ways over all DEG of them", "isotropic: every heading alike, so \\langle n_{{d}} \\rangle_{{d}} = n", "dilute: at most one ray a way, so \\min(1, n) = n", "so \\rho = n on a heading, and \\rho = n/DEG per point"])
  /* multiplied out, folded, and factored again: what cancels is gone and what is shared is written once */
  static tidy (e: Expr): Expr => Expr.deep_factored(Expr.simplify(Expr.expand(Expr.simplify(e))))
  /* folded and factored, but not multiplied out: a bracket the rules wrote stays a bracket */
  static neat (e: Expr): Expr => Expr.deep_factored(Expr.simplify(e))
  /* a term filled in, and written in the population's one name */
  filled_term (t: TermInfo, fill: {}): Expr => Prover.neat(Expr.replace(Expr.evaluate(t.expr, fill), "n", Prover.POPULATION))
  /* the left of the line: the time derivative first, then transport, applied to a name */
  operators_on (name: String): String => {
    left := this.infos.filter(t => t.side == "left")
    left = left.filter(t => t.operator == "\\partial_{{t}}").concat(left.filter(t => t.operator != "\\partial_{{t}}"))
    left.empty ? name : "({left.map(t => t.operator ?? t.symbol).join(plus)}){name}"
  }
  /* the line with every constant the closure settled filled in, as the headline of any law is: a rate is one per match per tick, the facing factor is what isotropy leaves - each a fact of its own, cited here so a reader sees where it came from */
  line_filled (s: Store): Step => {
    fill := Prover.settled(s)
    infos := this.infos
    right := infos.filter(t => t.side == "right" & (t.rules.empty | t.rays != "0"))
    right = right.filter(t => !t.rules.empty).concat(right.filter(t => t.rules.empty))
    used := Prover.constants_in(s, fill, right)
    /* each term filled on its own, and the sum left as the terms - so the line keeps its shape and only the numbers move */
    /* each term times the rays one firing puts in or takes out - the count the reading wrote on it, as the other ledgers carry theirs */
    rhs := Expr.add(right.map(t => Prover.neat(Expr.mul([t.ray_count, this.filled_term(t, fill)]))))
    lhs := this.operators_on(Expr.show(Prover.POPULATION))
    Step.of(Fact.stands(lhs, rhs), "with every factor written in", used.map(n => Fact.key_of("is", n)).concat([Fact.key_of("is", "n")]),
      "a name that has a law of its own is not a primitive - it is what that law shows it to be, so it stands in for itself. The constants the rules fix - a rate, which is one per match per tick, the facing factor, which is what isotropy leaves - are filled in here and nowhere earlier, so the line above is what the rules say and this is what it comes to",
      used.map(n => "{n} = {Expr.show(Expr.num(fill[n]))}").concat(["{lhs} = {Expr.show(rhs)}"]))
  }
  /* the names of these terms the closure settled to a number, in the order the store has them */
  static constants_in (s: Store, fill: {}, terms: TermInfo[]): String[] => {
    used := []
    s.all("is").for(f => {
      unless fill[f.of] == None | used.contains(f.of) {
        used.push(f.of) if terms.some(t => Expr.mentions(t.expr, f.of))
      }
    })
    used
  }
  /* the other two ledgers the same way: what each term does to space, or to the record, is its count times the term, with the constants filled in */
  ledger_filled (s: Store, ledger: String): Step => {
    fill := Prover.settled(s)
    /* the space AT A LOCAL is the points it holds: a swallow is one more, a hand-back one fewer - the world's count, read from the hub's side - and a point the world grows is a new local, not one held here */
    moving := this.infos.filter(t => (ledger == "space" ? (t.space != "0" & !t.grown) : t.folds != "0"))
    used := Prover.constants_in(s, fill, moving)
    counted := (t: TermInfo): Expr => ledger == "space" ? Expr.neg(t.space_count) : t.fold_count
    rhs := moving.empty ? Expr.num(0) : Expr.add(moving.map(t => Prover.neat(Expr.mul([counted(t), this.filled_term(t, fill)]))))
    lhs := ledger == "space" ? "\\partial_{{t}}s" : "\\partial_{{t}}n_{{f}}"
    what := ledger == "space" ? "a point held at the local - the world's count read from the hub's side, so a swallow is one more here and a hand-back one fewer, and a point the world grows is a new local rather than one held here" : "a fold of the record"
    Step.of(Fact.stands(lhs, rhs), "with every factor written in", used.map(n => Fact.key_of("is", n)).concat([Fact.key_of("is", "n")]),
      "the same rules, read on another ledger: every term that makes or takes {what} does so at its own rate, through its own gates, and the count one firing moves is written on it. The constants are the same facts as on the population's line, filled in here the same way",
      used.map(n => "{n} = {Expr.show(Expr.num(fill[n]))}").concat(["{lhs} = {Expr.show(rhs)}"]))
  }
  /*
   * WHERE THE POPULATION'S LINE STANDS ON THE SPACE - derived off the two ledgers, not assumed.
   * The record and the space are moved by the same firings, so adding the two lines says how far they are one
   * ledger read twice; what they add to is whatever the counts say, and it is printed rather than asserted.
   * The population's line never names s, but it is steered by n_f - its transport leans on \nabla n_f and keeps
   * 1/(1+n_f) of a heading - and gated by \omega, the room ahead; both are the space, read through the record.
   */
  ledgers_are_one (s: Store, folds: Step, space: Step): Step => {
    /* the one line taken from the other and COLLECTED, so a factor both carry is written once: what cancels is seen to cancel */
    together := Expr.collected(Expr.gather(Expr.expand(Expr.sub(space.fact.to, folds.fact.to))))
    lhs := "\\partial_{{t}}s - \\partial_{{t}}n_{{f}}"
    Step.of(Fact.stands(lhs, together), "the record is the space held", [folds.fact.key, space.fact.key],
      "the same firings move both ledgers, and nothing is handed back by decree. ANNIHILATION folds a point into the hub and writes one fold on the way it came by: one held, one written. CREATION lights every exit and unfolds - and unfolding is gated twice on the same record: a fold comes off a way only `if folds[d] > 0`, and a point comes back only `if held.last != None`, and a hub holds one point per fold it wrote. Read as the shares they are, the ways that lose a fold number n_{{f}} in expectation and so do the points that come back: the hand-back is what the gates come to on aggregate, not a line in the rule. So the space a local holds and the record it keeps move together, tick for tick, and their difference does not move at all. Integrated, s - n_{{f}} is a constant, and it is one: a local holds itself and one point per fold. THAT IS WHERE THE POPULATION'S LINE STANDS ON THE SPACE: it never names s, but its transport leans on \\nabla n_{{f}} and keeps 1/(1 + n_{{f}}) of a heading, and its room ahead \\omega is the share of ways whose far point is still there - both are the space, read through the record",
      ["\\partial_{{t}}n_{{f}} = {Expr.show(folds.fact.to)}", "\\partial_{{t}}s = {Expr.show(space.fact.to)}", "{lhs} = {Expr.show(together)}", "a meeting: one point held, one fold written", "a creation: `if folds[d] > 0` on each of DEG ways is n_{{f}} folds off; `if held.last != None` is n_{{f}} points back - the same record, twice", "so s - n_{{f}} does not move: s = 1 + n_{{f}}, a local holds itself and one point per fold", "the population's transport, \\paren{{\\nabla n_{{f}}}}·\\nabla_{{\\hat{{d}}}} with 1/(1+n_{{f}}) kept, is steered by that record"])
  }
  /*
   * THE LINE, REDUCED. The vacuum's own making and taking stand on the population's line and on the space's alike, because they are
   * the same firings counted on two ledgers - so the space line taken from the population's cancels them term for term, and what is
   * left is what the rules do to the population that they do not do to the space: carry it, grow room for it, and put a body's mass in.
   */
  /*
   * THE LINES ADDED: rays and record together. A meeting turns a ray into a fold and a creation turns a fold back into rays, so the vacuum's
   * own taking cancels between the two lines and what is left moves rho + n_f only by transport, a body's mass, and creation at a point
   * that held no record - the splitting that outran the recombining. Nothing is assumed conserved: the growth term is carried as it is.
   */
  /* what a meeting turns rays into folds at: its rays count against its folds count - the weight the record carries against the population */
  fold_weight (): Expr => {
    meet := this.infos.filter(t => t.degree == 2 & !t.rules.empty & t.folds != "0").first
    return Expr.num(1) if meet == None
    Expr.simplify(Expr.neg(Expr.div(meet.ray_count, meet.fold_count)))
  }
  general (filled: Step, folds: Step): Step => {
    k := this.fold_weight
    /* the record's line weighed term by term, so each keeps the bracket the rules wrote and the sum can be collected on it */
    weighed_terms := (folds.fact.to.kind == "add" ? folds.fact.to.of : [folds.fact.to]).map(t => Prover.neat(Expr.mul([k, t])))
    rhs := Expr.collected(Expr.add([filled.fact.to, Expr.add(weighed_terms)]))
    rho := Expr.show(Prover.POPULATION)
    ops := this.infos.filter(t => t.side == "left" & t.operator != "\\partial_{{t}}").map(t => t.operator ?? t.symbol).join(plus)
    weighed := (k.kind == "num" & k.value == 1) ? "n_{{f}}" : "{Expr.show(k)}·n_{{f}}"
    lhs := ops.empty ? "\\partial_{{t}}\\paren{{{rho} + {weighed}}}" : "\\partial_{{t}}\\paren{{{rho} + {weighed}}} + \\paren{{{ops}}}{rho}"
    Step.of(Fact.stands(lhs, rhs), "the population's line and the record's added", [filled.fact.key, folds.fact.key],
      "ANNIHILATION takes rays and writes a fold - {Expr.show(k)} rays a fold, which is the weight the record carries against the population; CREATION takes a fold off and lights every exit. So the vacuum's taking stands on the population's line and, weighed so, on the record's with the opposite sign, and adding the two cancels it exactly - the same count written twice. What is left moves rays-plus-record: the transport carries the rays, a body puts its mass in, and CREATION at a point that held fewer folds than it lights exits makes rays with nothing consumed - which on an expanding world is where the space grows. That last term is kept as it is: at a small scale the record differs from place to place and the sum is not conserved. It is the one term a settled aggregate loses",
      ["{filled.fact.of} = {Expr.show(filled.fact.to)}", "{folds.fact.of} = {Expr.show(folds.fact.to)}", "a meeting: {Expr.show(k)} rays in, one fold out - so the record counts {Expr.show(k)} to one", "added: the taking cancels, the making does not - a creation lights every exit whether or not it held a fold", "{lhs} = {Expr.show(rhs)}"])
  }
  /* THE AGGREGATE: the vacuum's own making against its taking is nought where the vacuum has settled - which is what vacuum.occupancy says rho_infty is - and on the continuous aggregate that is the vacuum the line is written in. What the growth left behind goes, and what remains is conserved up to transport and the masses. The record's gradient is kept: it is what steers a heading, and its departure from the settled record is the small-scale dynamics the general line keeps */
  aggregate (general_: Step, one: Step, s: Store): Step? => {
    inf := s.fact("is", "\\rho_{{\\infty}}")
    return None if inf == None
    rho := Prover.POPULATION
    /* the part of the single line that does not carry a body's mass: the vacuum's balance, V(rho) */
    terms := one.fact.to.kind == "add" ? one.fact.to.of : [one.fact.to]
    balance := Expr.gather(Expr.add(terms.filter(t => !Expr.mentions(t, "l.\\bar{{m}}"))))
    kept := Expr.collected(Expr.add(terms.filter(t => Expr.mentions(t, "l.\\bar{{m}}"))))
    /* the balance IS the one rho_infty is the root of - the same polynomial, multiplied out - or this step does not stand; failing that it is checked at the lattice's own count of ways */
    fill := Prover.settled(s)
    flat := (x: Expr): String => Expr.show(Expr.gather(Expr.expand(Expr.evaluate(x, fill))))
    same := inf.to.kind == "root" & (flat(balance) == flat(inf.to.base) | flat(balance) == flat(Expr.neg(inf.to.base)))
    unless same {
      env := Model.copy(fill)
      env["DEG"] = 8
      at := Expr.numeric(Expr.evaluate(inf.to, env), env)
      env["\\rho"] = at
      v := Expr.numeric(Expr.evaluate(balance, env), env)
      return None if !Expr.finite(at) | !Expr.finite(v) | v.abs > 0.000001
    }
    Step.of(Fact.stands(general_.fact.of, kept), "the vacuum settled", [general_.fact.key, one.fact.key, inf.key],
      "with the record written as the density, everything on the right that is not a body's mass is the vacuum's own making against its own taking - the balance that fixes \\rho_{{\\infty}}, and nought exactly there. The continuous aggregate is the settled vacuum: at that density the growth the general line kept has gone, the record is the settled one, and what is left is CONSERVED up to what carries it and what the bodies put in. The record's gradient stays on the left because that is what bends a heading; every place the record departs from the settled one is the small-scale dynamics the general line keeps",
      ["the vacuum's balance: {Expr.show(balance)}", "\\rho_{{\\infty}} = {Expr.show(inf.to)}: the same balance, at nought", "{general_.fact.of} = {Expr.show(kept)}"])
  }
  /* THE RECORD SETTLED: on the aggregate a local's record no longer moves against its density - the folds line at nought, solved for n_f. Not assumed: it is what the record's own line says when it has stopped */
  settled_record (folds: Step): Step? => {
    parts := Expr.split(folds.fact.to, "n_{{f}}")
    return None if parts == None
    /* n_f = -rest / coef, kept as a quotient so its slope can be taken over one denominator; the denominator written with the density's sign first */
    top := Prover.tidy(Expr.neg(parts[1]))
    bottom := Prover.tidy(parts[0])
    if Expr.show(top).starts_with("-") { top = Prover.tidy(Expr.neg(top)); bottom = Expr.flip(bottom) }
    nf := Expr.div(top, bottom)
    st := Step.of(Fact.stands("n_{{f}}", nf), "the record settled against the density", [folds.fact.key],
      "the record's line is linear in the record: folds are written at the meeting rate and taken off at the creation rate times how many there are to take. On the continuous aggregate the record has stopped moving against the density - what a meeting writes a creation takes off - so its line is at nought and the record is a function of the density alone. That is the aggregate: not that the record is conserved, but that it has settled, and every place where it has not is the small-scale dynamics the line above keeps",
      ["{folds.fact.of} = {Expr.show(folds.fact.to)} = 0", "n_{{f}} = {Expr.show(nf)}"])
    st.parts_ = [top, bottom]
    st
  }
  /* AND THE ONE EQUATION: the record written as the density everywhere it stands - its time derivative gone, its gradient the density's - so the line is in rho alone */
  single (general_: Step, settled: Step, folds: Step, s: Store): Step => {
    rho := Prover.POPULATION
    nf := settled.fact.to
    slope := Expr.quotient_d(settled.parts_[0], settled.parts_[1], Expr.show(rho))
    /* the settled record put in for n_f everywhere on the right, multiplied out: the bracket it stands over is the one the growth term carries, so the two cancel */
    rhs := Expr.collected(Expr.reduced(Prover.tidy(Expr.replace(general_.fact.to, "n_{{f}}", nf))))
    carry := "\\hat{{d}}·\\nabla_{{l}}"
    drift := "\\paren{{{Expr.show(slope)}}}·\\paren{{\\nabla {Expr.show(rho)}}}·\\nabla_{{\\hat{{d}}}}"
    lhs := "\\partial_{{t}}{Expr.show(rho)} + \\paren{{{carry} + {drift}}}{Expr.show(rho)}"
    inf := s.fact("is", "\\rho_{{\\infty}}")
    upon := [general_.fact.key, settled.fact.key]
    upon.push(inf.key) if inf != None
    Step.of(Fact.stands(lhs, rhs), "the record written as the density", upon,
      "with the record settled it is a function of the density, so \\partial_{{t}}n_{{f}} is nought and \\nabla n_{{f}} is the record's slope times \\nabla\\rho - the chain rule, on the line above. Every n_{{f}} on the right is the same function. What is left is one equation in the density alone, and the term the growth left behind is the vacuum's own restoring term: the making against the taking, which is nought exactly where the vacuum has settled, \\rho = \\rho_{{\\infty}}, and pushes back everywhere else. Near a body the record is steep and that slope is what bends a heading; far from everything it is flat and the line is a ray carried at \\bar{{c}}, sourced by the masses",
      ["n_{{f}} = {Expr.show(nf)}", "\\nabla n_{{f}} = {Expr.show(slope)}·\\nabla\\rho", "{lhs} = {Expr.show(rhs)}"].concat(inf == None ? [] : ["the making against the taking is nought at \\rho_{{\\infty}} = {Expr.show(inf.to)}"]))
  }
  /*
   * THE LINE, SOLVED ALONG A HEADING. Its left side is a streaming operator, and a streaming operator is solved by following the heading
   * back along its own path: what stands at l on d-hat at tick t is what was put in R steps back along that path, R ticks ago, thinned by
   * every meeting on the way and by what the turns took off. Every piece is one of the line's own terms - the transport is the path, the
   * meeting term and the turn's keep are the survival, the source term is what is read at the path's end.
   */
  /* what reaches R steps out, by name: the near field's own count, the one the mass law sums over a body's depth */
  static reach (r: String): Expr => Expr.field("l.reach\\paren{{{r}}}")
  remembered (s: Store, agg: Step): Step => {
    each := Expr.mul([Prover.reach("R"), Expr.field("\\bar{{m}}_{{l_{{R}}}}\\paren{{t - R}}")])
    rhs := Expr.add([Expr.field("\\rho_{{\\infty}}"), Expr.call("\\sum_{{R \\ge 0}}", each)])
    Step.of(Fact.stands("\\rho_{{l}}\\paren{{t}}", rhs), "what a heading carries in from behind it", [agg.fact.key],
      "the left of the line is a streaming operator: a ray goes one local a tick along its heading, and a heading is turned by the record it crosses. So the line is solved by following a heading BACK along its own path - the walk the lattice gives it, through folded points into their hubs, bent by the turns - and what stands at l on that heading at tick t is what was put in R steps back along the path, R ticks ago, for every R: thinned at each step by the meeting it may have had there, \\sigma F \\rho of the time, and by the share of the heading the turn there did not keep. A step is a tick, so R steps is R ticks. Nothing was added to the line to say this; it is the line read from the ray's side rather than the local's",
      ["l_{{R}}: the local R steps back along -\\hat{{d}}, as the lattice walks it - through a folded point into its hub", "l.reach\\paren{{R}}: what is still on the heading R steps later - the rays alone, the near field", "\\bar{{m}}_{{l_{{R}}}}\\paren{{t - R}}: the mass at the path's end, when the ray left it - nought where no body stands", "\\rho_{{l}}\\paren{{t}} = {Expr.show(rhs)}"])
  }
  /* THE SUM OVER R COLLAPSES TO THE BODIES: the mass is nought but where a body stands, so a term survives only where the path reaches one - at that body's own distance, and at the tick it was there */
  from_each (s: Store, back: Step): Step => {
    each := Expr.mul([Prover.reach("x.\\bar{{R}}"), Expr.field("x.\\bar{{m}}")])
    rhs := Expr.add([Expr.field("\\rho_{{\\infty}}"), Expr.call("\\sum_{{x = x_{{@t}}}}", each)])
    Step.of(Fact.stands("\\rho_{{l}}\\paren{{t}}", rhs), "each body from its own distance", [back.fact.key],
      "the mass at a local is nought unless a body stands there, so of the sum over every R only those terms stand whose path ends on a body - one term per body the heading looks back at, at that body's own distance x.\\bar{{R}}: the length of the walk from l to where the body WAS, x.\\bar{{R}} ticks ago, since that is when the ray left it. The distance is implicit in itself, as a retarded one is, and the body's rate and its \\beta are read at that tick too. THIS SUM IS RIGHT WHERE A SUM OF SOURCES WAS WRONG: two bodies cannot share a local, but their rays can, and what arrives adds",
      ["x = x_{{@t}}: every body at its own time, bound once in the sum - when the rays that reach the local left it, t less x.\\bar{{R}}; x.\\bar{{R}} = l.distance\\paren{{x.l}}, from the local now to the body then", "only the R that land on a body survive the sum: one term each", "x.\\bar{{m}}: body x's mass - what it is is its own line, and it is never put in here; l.\\bar{{m}} is kept for the mass AT this local", "\\rho_{{l}}\\paren{{t}} = {Expr.show(rhs)}"])
  }
  /* IGNORANT OF WHAT CAME BEFORE: the past is taken as infinite and unknown - every field has propagated as far as it goes, the vacuum along every path is the settled one, and the bodies are read where they are */
  forgotten (s: Store, each: Step, settled: Step): Step => {
    rho_inf := Expr.field("\\rho_{{\\infty}}")
    /* the settled record at the settled density: DEG(1 - rho) stands in for rho squared there */
    nf := Expr.swap(settled.fact.to, Expr.to_power(Prover.POPULATION, Expr.num(2)), Expr.mul([Expr.field("DEG"), Expr.sub(Expr.num(1), Prover.POPULATION)]))
    nf = Prover.tidy(nf)
    reach := s.fact("is", "l.reach\\paren{{\\bar{{R}}}}")
    at := reach == None ? Prover.reach("\\bar{{R}}") : Prover.neat(Expr.evaluate(reach.to, Prover.settled(s)))
    term := Expr.mul([Prover.reach("x.\\bar{{R}}"), Expr.field("x.\\bar{{m}}")])
    rhs := Expr.add([rho_inf, Expr.call("\\sum_{{x = x_{{@t}}}}", term)])
    Step.of(Fact.stands("\\rho_{{l}}\\paren{{t}}", rhs), "ignorant of what came before", [each.fact.key, settled.fact.key],
      "nothing is known of the dynamics before the tick the line is read at, and an infinite past is assumed: every body's field has propagated as far as it ever will, so no transient is left in the sum and along every path the vacuum is the settled one - what survives a step is the same at every step: the settled density, and the settled record, which at that density is DEG/2, one fold for every two ways, the record at which a creation takes off exactly what the meetings write. WHAT IS NOT FORGOTTEN IS THE LIGHT'S OWN TRAVEL: a step is a tick, so what reaches the local from body x left it x.\\bar{{R}} ticks ago, and the body xs read where it WAS then and at the mass it HAD then - its \\beta inside its choice included. The distance is to that place, and is implicit in itself, as a retarded distance is. That is the field of any number of bodies at a local, each from its own distance through whatever space lies between - the distance is the lattice's own walk",
      ["the past is infinite and unknown: every field has arrived, no transient - but t stays, in the retardation", "x = x_{{@t}}: every body at its own time, bound once in the sum - when the rays left it, t less x.\\bar{{R}}; x.\\bar{{R}} = l.distance\\paren{{x.l}}, from the local now to the body then", "along the path the vacuum is settled: \\rho = \\rho_{{\\infty}}, n_{{f}} = {Expr.show(nf)}", "so l.reach\\paren{{\\bar{{R}}}} = {Expr.show(at)} along every path", "x.\\bar{{m}}: each body's mass as it was when the rays left - its own line, never put in here", "\\rho_{{l}}\\paren{{t}} = {Expr.show(rhs)}"])
  }
  /*
   * THE FORCE FELT AT A LOCAL FROM EVERY BODY - the far field, on rays PLUS record. The vacuum's making and taking move rho + 2 n_f not at
   * all, so what a body puts out is never lost to the vacuum: a ray a meeting takes is a fold written, and creation reads it back out. From a
   * steady body that quantity only SPREADS - what crosses a shell in a tick is what the body put out - so at a local it is the body's mass
   * over the shell at that distance, and from every body xt is the sum. No reach in it: l.reach is the rays alone, and is the near field's.
   */
  felt (s: Store, known: Step, settled: Step): Step => {
    nf := Expr.swap(settled.fact.to, Expr.to_power(Prover.POPULATION, Expr.num(2)), Expr.mul([Expr.field("DEG"), Expr.sub(Expr.num(1), Prover.POPULATION)]))
    nf = Prover.tidy(nf)
    k := this.fold_weight
    base := Prover.neat(Expr.add([Expr.field("\\rho_{{\\infty}}"), Expr.mul([k, nf])]))
    fill := Prover.settled(s)
    c := fill["\\bar{{c}}"] == None ? Expr.field("\\bar{{c}}") : Expr.num(fill["\\bar{{c}}"])
    term := Prover.neat(Expr.mul([Expr.field("x.\\bar{{m}}"), Expr.pown(Expr.mul([Expr.field("l.shell\\paren{{x.\\bar{{R}}}}"), c]), -1)]))
    rhs := Expr.add([base, Expr.call("\\sum_{{x = x_{{@t}}}}", term)])
    weighed := (k.kind == "num" & k.value == 1) ? "n_{{f}}" : "{Expr.show(k)}·n_{{f}}"
    Step.of(Fact.stands("\\paren{{\\rho + {weighed}}}_{{l}}\\paren{{t}}", rhs), "what a local feels from every body", [known.fact.key, settled.fact.key],
      "the near field is the rays alone, and they are gone in a free path - into the record. But rays and record together the vacuum never loses: a meeting turns {Expr.show(k)} rays into a fold, a creation turns a fold back into rays, and the conserved line says so. So what a body puts out is all still there, spread over the space it went into - and from a steady body xt only spreads: what crosses the shell at any distance in a tick is what the body put out, so per site it is the body's mass over that shell, and it dwells one over \\bar{{c}} there. From every body xt is the sum, each from its own distance - its own walk, on whatever lattice, folded as it may be. That is the force felt at a local: the record it holds above the settled one is what bends every heading through it, and this is where that record came from",
      ["rays plus record is conserved: what a body puts out is never lost to the vacuum, only spread", "what crosses the shell at x.\\bar{{R}} in a tick is what the body put out x.\\bar{{R}} ticks ago: per site, that over l.shell\\paren{{x.\\bar{{R}}}}, dwelling 1/\\bar{{c}}", "the settled vacuum underneath it: {Expr.show(base)}", "no l.reach here - that is the rays alone, and is the mass law's own near field", "\\paren{{\\rho + {weighed}}}_{{l}}\\paren{{t}} = {Expr.show(rhs)}"])
  }
  /* AND THE MASS LAW IS THE ONE-BODY CASE OF IT */
  one_body (s: Store, field_: Step): Step? => {
    m := s.fact("is", "\\bar{{m}}\\paren{{\\bar{{R}}}}")
    return None if m == None
    /* the law with the settled constants in, as its own page prints it - the mass itself untouched */
    law := Expr.deep_factored(Expr.evaluate(m.to, Prover.settled(s)))
    Step.of(Fact.stands("\\bar{{m}}\\paren{{\\bar{{R}}}}", law), "the mass law is the near field of a body's own cells", [field_.fact.key, m.key],
      "TWO RADII, NOT ONE. In the mass law \\bar{{R}} is the body's own DEPTH - how many cells thick it is behind its face - and l.reach summed over that depth is the skin: a cell deeper in sends its rays out through the cells in front of it and loses a share at each, so what leaves the face is the near-field sum run over the body's own cells. In the field, x.\\bar{{R}} is the DISTANCE from the body's face to the local, the walk outside it. Same count per step, since inside a body and outside it the vacuum is the same; a different stretch of it. Putting l.reach in with the depth and again with the distance for the same R would count once what happens twice - so the mass law carries the depth and the near field the distance, and x.\\bar{{m}} in the sums is what leaves body x's face",
      ["\\bar{{R}} in the mass law: the body's depth; x.\\bar{{R}} in the field: the distance to it", "the skin: l.reach summed over the depth, a geometric series", "so x.\\bar{{m}} in the field is this, what leaves the face - and the walk outside it is the near field's own l.reach, or, on rays plus record, none", "\\bar{{m}}\\paren{{\\bar{{R}}}} = {Expr.show(law)}"])
  }
  /* THE RECORD EVERY BODY LEAVES AT A LOCAL: the far field is rays plus record and the near field the rays alone, so their difference is the record - explicit in the bodies, each as it was when its rays left it */
  record_of_all (known: Step, pull: Step, settled: Step): Step => {
    k := this.fold_weight
    nf := Expr.swap(settled.fact.to, Expr.to_power(Prover.POPULATION, Expr.num(2)), Expr.mul([Expr.field("DEG"), Expr.sub(Expr.num(1), Prover.POPULATION)]))
    nf = Prover.tidy(nf)
    per := Expr.mul([Expr.field("x.\\bar{{m}}"), Expr.sub(Expr.pown(Expr.field("l.shell\\paren{{x.\\bar{{R}}}}"), -1), Prover.reach("x.\\bar{{R}}"))])
    rhs := Expr.add([nf, Expr.mul([Expr.pown(k, -1), Expr.call("\\sum_{{x = x_{{@t}}}}", per)])])
    Step.of(Fact.stands("n_{{f,l}}\\paren{{t}}", rhs), "the record every body leaves at a local", [known.fact.key, pull.fact.key],
      "the far field is rays plus record, the near field the rays alone; what is left when the one is taken from the other is the record - the folds every body's rays wrote on their way through this local, over the settled record the vacuum keeps of its own. It is explicit in the bodies: each as it was when its rays left it, at its own distance then, the shell's spreading less what still arrives as rays. Within a free path of a body the two nearly cancel, which is the shadowing; beyond it only the spreading is left. This record is what bends every heading through the local, and its gradient is the pull",
      ["far less near: \\paren{{\\rho + {Expr.show(k)}·n_{{f}}}}_{{l}} - \\rho_{{l}}, over {Expr.show(k)}", "x = x_{{@t}}: every body at its own time, bound once in the sum - when its rays left, t less x.\\bar{{R}}; x.\\bar{{R}} = l.distance\\paren{{x.l}}, from the local now to the body then", "n_{{f,l}}\\paren{{t}} = {Expr.show(rhs)}"])
  }
  /* THE RECORD AS A SUM OVER THE LOCALS. A body is the locals it stands on and the mass at a local is nought where none does - so the sum
   * over the bodies is the sum over every local of the lattice, each read at its own time, the tick its rays left. No body index, no list:
   * the local is the thing summed over, and a body that moves is a trail of locals each at a different time */
  every_local (rec: Step, settled: Step): Step => {
    k := this.fold_weight
    nf := Expr.swap(settled.fact.to, Expr.to_power(Prover.POPULATION, Expr.num(2)), Expr.mul([Expr.field("DEG"), Expr.sub(Expr.num(1), Prover.POPULATION)]))
    nf = Prover.tidy(nf)
    per := Expr.mul([Expr.field("l'_{{@t}}.\\bar{{m}}"), Expr.sub(Expr.pown(Expr.field("l.shell\\paren{{l.distance\\paren{{l'}}}}"), -1), Prover.reach("l.distance\\paren{{l'}}"))])
    rhs := Expr.add([nf, Expr.mul([Expr.pown(k, -1), Expr.call("\\sum_{{l'}}", per)])])
    Step.of(Fact.stands("n_{{f,l}}", rhs), "summed over the locals", [rec.fact.key, settled.fact.key],
      "a body is the locals it stands on, and the mass at a local is nought where no body does - so the sum over the bodies is a sum over every local of the lattice, and it is the same sum: only the locals that carry mass contribute. Each local is read at its own time, the tick the rays that reach here left it, l.distance\\paren{{l'}} ticks ago - a local does not move, so that tick is fixed and nothing is solved for. A body that moves is then a trail of locals each read at a different tick, its mass at each what its choice was then, \\beta inside it: any variation of mass or speed from tick to tick is carried exactly. The bracket is what a unit of mass at that local leaves here - spread over the shell at this local's walk to it, less what still arrives as rays",
      ["l'_{{@t}}.\\bar{{m}}: the mass at local l' when the rays that reach l left it - l.distance\\paren{{l'}} ticks ago; nought where no body stood", "n_{{f,l}} = {Expr.show(rhs)}"])
  }
  /* FOLLOWING: the difference taken along something, which on the lattice is one step - the value one local along v a tick later, less the value here now. Three differences stand on the line and they are kept apart: Δ_v follows v through the lattice; ∇ along a way at one tick; ∂_d̂ across the headings at one local */
  following (rec: Step): Step => {
    Step.of(Fact.stands("\\Delta_{{v}}f", Expr.field("f_{{l + v}}\\paren{{t + 1}} - f_{{l}}\\paren{{t}}")), "following", [rec.fact.key],
      "the difference taken following something: the change per tick seen by whatever moves along v. On the lattice it is exact and it is one step - the value one local along v, a tick later, less the value here now. It is the material derivative, D/Dt, with the velocity marked, since two different velocities stand on the line. Three differences are on the line and they are not the same move: \\Delta_{{v}} follows v through the lattice, a step and a tick; \\nabla is the difference along a way at one tick, the neighbour less here; \\partial_{{\\hat{{d}}}} is the difference across the headings at one local, the next way's density less this one's - no move through space at all",
      ["\\Delta_{{v}}f = f_{{l + v}}\\paren{{t + 1}} - f_{{l}}\\paren{{t}}: one step along v, one tick", "\\nabla f: along a way, at one tick", "\\partial_{{\\hat{{d}}}}\\rho: across the headings, at one local"])
  }
  /* THE LEAN: how the heading is being turned - half the density's difference across the headings, since a fold turns a heading by the weight it was folded. It is the velocity the record is followed along: the force term's velocity, as the streaming term's is the heading */
  lean (rec: Step): Step => {
    Step.of(Fact.stands("a", Expr.field("\\frac{{1}}{{2}}\\partial_{{\\hat{{d}}}}\\rho_{{l}}")), "the lean", [rec.fact.key],
      "the rate a heading is being turned at the local: half the density's difference across the headings, since the turn draws a folded way against straight on and a fold turns a heading by the weight it was folded, two rays to one. It is a velocity in heading space, and it is the velocity the record is followed along - so the line has two: the heading, which the density streams along, and the lean, which the record is bent along. In the Boltzmann equation these are the streaming term and the force term; here the force is the record's slope, so the second is the bend",
      ["a = \\frac{{1}}{{2}}\\partial_{{\\hat{{d}}}}\\rho_{{l}}: how the heading is being turned", "streaming: \\Delta_{{\\hat{{d}}}}\\rho_{{l}} - the density along its heading", "bending: \\Delta_{{a}}S_{{l}} - the record along the lean"])
  }
  /* AT A PARTICULAR TIME: a local source read at one tick, marked @t. The mark says WHEN the source is read, not where the tick comes from - for the sum over the locals it is the tick the rays that reach here left, but that is a use of the mark, not its meaning */
  at_time (rec: Step): Step => {
    Step.of(Fact.stands("l'_{{@t}}", Expr.field("l' \\aside{{at}} @t")), "at a particular time", [rec.fact.key],
      "the local source l', read at a particular point in time, @t: its mass then - what it lit then, its \\beta then - and nothing about it now. The mark is on the source, not on the equation: a source is a thing with a history, and @t picks one tick of it. What is read at that tick is the source's own line - the choice it makes over its ways. In the record every mass leaves at a local, each source is read at the tick the rays that reach the local left it, which is l.distance\\paren{{l'}} ticks before now; that is where the sum uses the mark, and it is the only place a tick is picked for it",
      ["l'_{{@t}}: the source at l', as it was at the tick @t", "l'_{{@t}}.\\bar{{m}}: its mass then - its choice at that tick, \\beta inside it", "in the sum over the locals, @t is the tick the rays that reach l left l'"])
  }
  /* THE VACUUM'S BALANCE AT A LOCAL, named: the making less the taking, DEG(1 - rho) - rho^2 - and since rho_infty is its root (vacuum.occupancy), it factors: how far the density is from settled, times the rate the vacuum pulls it back at. It stands in the population's line and, with the opposite sign, in the record's: one quantity, and its cancelling between them is the conservation of rays plus record */
  balance (rec: Step, s: Store): Step? => {
    inf := s.fact("is", "\\rho_{{\\infty}}")
    return None if inf == None
    rho := Expr.field("\\rho_{{l}}")
    inf_ := Expr.field("\\rho_{{\\infty}}")
    got := Expr.mul([Expr.sub(inf_, rho), Expr.add([rho, inf_, Expr.field("DEG")])])
    /* checked: multiplied out and rho_infty squared put as DEG(1 - rho_infty), it is the balance */
    raw := Expr.sub(Expr.mul([Expr.field("DEG"), Expr.sub(Expr.num(1), rho)]), Expr.to_power(rho, Expr.num(2)))
    diff := Expr.simplify(Expr.expand(Expr.sub(got, raw)))
    diff = Expr.gather(Expr.expand(Expr.swap(diff, Expr.to_power(inf_, Expr.num(2)), Expr.mul([Expr.field("DEG"), Expr.sub(Expr.num(1), inf_)]))))
    exact := diff.kind == "num" & diff.value == 0
    check := exact ? " - checked exact" : ""
    Step.of(Fact.stands("l.balance", got), "where the making pays for the taking", [rec.fact.key, inf.key],
      "the vacuum's balance at the local: the making, creation lighting every dark exit of a point, less the taking, the meetings. It is a quadratic in the density, and the settled density is its root - that is what vacuum.occupancy says rho_infty is - so it factors: how far the density here is from settled, times the rate the vacuum pulls it back at, which is the density plus the settled one plus the ways a point has to relight. Positive below the settled density, negative above it: a restoring term. It stands on the population's line as what the vacuum does to the rays, and on the record's with the opposite sign, as what the meetings write above what creation clears - one quantity in both, and its cancelling between them is the conservation of rays plus record",
      ["DEG\\paren{{1 - \\rho_{{l}}}} - \\rho_{{l}}^{{2}} = {Expr.show(got)}, since \\rho_{{\\infty}}^{{2}} = DEG\\paren{{1 - \\rho_{{\\infty}}}}{check}", "l.balance = {Expr.show(got)}", "nought where the vacuum has settled; a pull back toward \\rho_{{\\infty}} elsewhere"])
  }
  /* THE RECORD'S OWN LINE, in rays' worth: twice the folds ledger, S = 2 n_f. What the meetings write above what creation clears is the imbalance, with the opposite sign to the population's; and creation clears the record above the settled one, DEG, at its own rate */
  record_S (rec: Step, folded: Step? = None): Step => {
    rho := Expr.field("\\rho_{{l}}")
    rhs := Expr.add([Expr.mul([Expr.sub(Expr.field("DEG"), Expr.field("S_{{l}}")), Expr.sub(Expr.num(1), rho)]), Expr.neg(Expr.field("l.balance"))])
    Step.of(Fact.stands("\\Delta_{{t}}S_{{l}}", rhs), "the record, in rays' worth", [rec.fact.key],
      "S is twice the record - two, because a meeting turns two rays into one fold, so rays and folds are counted in one unit, rays' worth. Its line is the folds ledger's, doubled: the meetings write it, at the rate rays meet, and creation clears it, at the creation rate times how much there is to clear. Written through the balance: what the meetings write above what creation would clear at the settled record is the vacuum's imbalance, with the opposite sign to the population's line - the same quantity, one line writing what the other takes - and what is left is creation clearing the record above the settled one, DEG, one fold for every two ways, at its own rate. Where the vacuum has settled the first term is gone and the record relaxes to DEG; far from every body it is the sum over the locals of what every mass sent here, each read at its own time - the line under this",
      ["S_{{l}} = 2n_{{f,l}}: the folds ledger doubled - \\rho_{{l}}^{{2}} - S_{{l}}\\paren{{1 - \\rho_{{l}}}}", "\\Delta_{{t}}S_{{l}} = {Expr.show(rhs)}: the imbalance with the opposite sign, and the record above DEG cleared", "settled: \\Delta_{{t}}S_{{l}} = \\paren{{DEG - S_{{l}}}}\\paren{{1 - \\rho_{{\\infty}}}}; far from every body: the sum over the locals"])
  }
  /* WHAT IT SETTLES TO FAR FROM EVERY BODY: the sum over the locals, each read at its own time */
  record_sum (rec: Step): Step => {
    per := Expr.mul([Expr.field("l'_{{@t}}.\\bar{{m}}"), Expr.sub(Expr.pown(Expr.field("l.shell\\paren{{l.distance\\paren{{l'}}}}"), -1), Prover.reach("l.distance\\paren{{l'}}"))])
    total := Expr.add([Expr.field("DEG"), Expr.call("\\sum_{{l'}}", per)])
    Step.of(Fact.stands("S_{{l}}", total), "summed over the locals, settled", [rec.fact.key],
      "the record's line, run out from every mass on the settled vacuum: the settled record, DEG, and over it what every local's mass sent here, each read at the tick its rays left, spread over the shell at this local's walk to it, less the part still in flight as rays. A body is the locals it stands on and the mass at a local is nought where none does, so this is the sum of the masses; a local does not move, so each one's tick is fixed; a body that moves is a trail of locals read at different ticks, so mass and speed may vary per tick exactly. It holds where the vacuum along every path is the settled one - beyond a free path of any body; inside that the record's own line has to be run",
      ["l'_{{@t}}.\\bar{{m}}: the mass at local l' when the rays that reach l left it - nought where no body stood", "S_{{l}} = {Expr.show(total)}"])
  }
  /* AND ONE LINE FOR EVERY MASS: streaming plus bending equals the vacuum's balance plus the mass standing here. Every theorem stands on the making, the taking, the source and the transport with its turn - all on this line, one step of indirection from the rules */
  one_line (rec: Step, given: Step? = None): Step => {
    lhs := "\\Delta_{{\\hat{{d}}}}\\rho_{{l}} + a·\\nabla S_{{l}}"
    rhs := Expr.add([Expr.field("l.balance"), Expr.field("l.\\bar{{m}}")])
    Step.of(Fact.stands(lhs, rhs), "one line for every mass", [rec.fact.key],
      "the population's own line, with its names: STREAMING, the density followed along its heading - what the ray finds one step on; plus BENDING, the record's slope along the lean - how the record every mass left here turns the heading; equals the vacuum's BALANCE, the making less the taking, which pulls the density back toward the settled one; plus the mass standing here. The balance is kept on the line and not cancelled against the record, because every theorem of this theory stands on it: the settled density is its root, the free path is one over its taking, the mass law is the source through the taking over a body's depth, the screening is the taking along the way - and the transport's turn is the lean. So this is the line the theorems follow from, one step of indirection from the rules: the rules' own terms, with the constants filled in and the record given its name. Adding the record's own line to it cancels the balance and gives the conserved line, rays plus record, which is a consequence and is kept as one. TO FILL IT IN: l.\\bar{{m}} as a field over the locals and the ticks - where each body stands at each tick and what it lights then - and S from the record's line, or, far from every body, from the sum over the locals",
      ["{lhs} = {Expr.show(rhs)}", "streaming + bending = the balance + the mass here", "the theorems' roots: the making and the taking (the balance), the source (emission), the transport and its turn (movement, the kernel) - all on this line", "the conserved line, rays plus record, is this plus the record's own line - a consequence"])
  }
  /* AT THE SETTLED DENSITY: the vacuum's balance is nought, and the two lines lose their near-field terms - what is left is the far field, the masses alone */
  settled_line (line: Step, bal: Step): Step => {
    lhs := "\\Delta_{{\\hat{{d}}}}\\rho_{{l}} + a·\\nabla S_{{l}} \\aside{{at}} \\rho_{{\\infty}}"
    Step.of(Fact.stands(lhs, Expr.field("l.\\bar{{m}}")), "the vacuum settled", [line.fact.key, bal.fact.key],
      "where the vacuum has settled, the density is the settled one and the balance is nought: the making pays for the taking exactly, and what the vacuum does to the rays on its own is gone from the line. That is the far field - beyond a free path of every body, where the density along every path is \\rho_{{\\infty}} - and it is the assumption that the near-field terms do not matter, made once and named. What is left is streaming plus bending equals the mass standing here: the rays are carried, the record every mass left here turns them, and only a body adds anything. The record's line loses its imbalance the same way and relaxes to the settled record at the creation rate",
      ["l.balance = 0 at \\rho_{{l}} = \\rho_{{\\infty}}", "{lhs} = l.\\bar{{m}}", "and the record: \\Delta_{{t}}S_{{l}} \\aside{{at}} \\rho_{{\\infty}} = \\paren{{DEG - S_{{l}}}}\\paren{{1 - \\rho_{{\\infty}}}}"])
  }
  settled_S (line: Step, bal: Step): Step => {
    rhs := Expr.mul([Expr.sub(Expr.field("DEG"), Expr.field("S_{{l}}")), Expr.sub(Expr.num(1), Expr.field("\\rho_{{\\infty}}"))])
    Step.of(Fact.stands("\\Delta_{{t}}S_{{l}} \\aside{{at}} \\rho_{{\\infty}}", rhs), "the vacuum settled", [line.fact.key, bal.fact.key],
      "the record's line at the settled density: the imbalance is nought, and creation clears whatever record stands above the settled one, DEG, at its own rate - so the record relaxes to DEG where nothing is sent, and far from every body what stands above DEG is the sum over the locals of what the masses sent",
      ["\\Delta_{{t}}S_{{l}} \\aside{{at}} \\rho_{{\\infty}} = {Expr.show(rhs)}"])
  }
  /*
   * THE RECURSION, READ OFF THE FAR FIELD - two readings, kept apart, neither assumed. The force law's `closing` puts g on both
   * sides by a phase argument; here each place the line lets g stand on its own right-hand side is followed as a step of its own.
   * FIRST READING, the bending: the vacuum's own rays are turned along the lean, and the lean's slope IS the pull.
   */
  bent_line (quiet: Step, lean_: Step, s: Store): Step => {
    bend := Expr.mul([Expr.field("\\partial_{{\\hat{{d}}}}\\rho_{{l}}"), Expr.field("g")])
    Step.of(Fact.stands("a·\\nabla S_{{l}}", bend), "the bending, read as the pull", [quiet.fact.key, lean_.fact.key],
      "the bending term of the settled line is the lean times the record's slope. The lean is half the density's difference across the headings (vacuum.lean), and the record's slope is what a body is carried along: TRANSPORT leans a body on the folds of the points across each way, so what a body feels, g, is the record's gradient - and the record in rays' worth is twice the folds, so g = \\frac{{1}}{{2}}\\nabla S_{{l}}. Put the two in and the bending is the density's difference across the headings times the pull: g stands on the line's own left side, and that is where the recursion is read from",
      ["a = \\frac{{1}}{{2}}\\partial_{{\\hat{{d}}}}\\rho_{{l}} (vacuum.lean)", "S_{{l}} = 2n_{{f,l}}, and TRANSPORT carries a body along \\nabla n_{{f}}: g = \\frac{{1}}{{2}}\\nabla S_{{l}}", "a·\\nabla S_{{l}} = \\frac{{1}}{{2}}\\partial_{{\\hat{{d}}}}\\rho_{{l}}·2g = {Expr.show(bend)}"])
  }
  /* what that bending comes to far from a body: the density's difference across the headings is the rays alone - the vacuum's are alike every way - and those are gone in a free path. So the enhancement is screened, and it stands on g_N, not on a_0 */
  bent_far (bent: Step, known: Step, quiet: Step): Step => {
    screened := Expr.call("\\sum_{{x = x_{{@t}}}}", Expr.mul([Expr.field("x.\\bar{{m}}"), Prover.reach("x.\\bar{{R}}")]))
    got := Expr.div(Expr.field("g_{{N}}"), Expr.sub(Expr.num(1), screened))
    Step.of(Fact.stands("g \\aside{{bent}}", got), "the far field, bent", [bent.fact.key, known.fact.key, quiet.fact.key],
      "what streams into a local along a heading is the mass there less what the record bends off it: \\Delta_{{\\hat{{d}}}}\\rho_{{l}} = l.\\bar{{m}} - \\partial_{{\\hat{{d}}}}\\rho_{{l}}·g. The difference across the headings is the rays alone, since the vacuum's own rays are alike on every heading and the record sits on the point, not on a heading: it is what the bodies' rays put there, \\rho_{{l}} - \\rho_{{\\infty}} = \\sum x.\\bar{{m}}·l.reach\\paren{{x.\\bar{{R}}}} (ignorant of what came before). So what a body feels is what arrives, g_{{N}}, plus that difference times g - and solved for g it is g_{{N}} over one less the rays' own screened sum. THE ENHANCEMENT IS ON g_{{N}} AND IT IS SCREENED: l.reach dies in a free path, so beyond one the bending gives the arrival back unchanged. This reading puts no a_{{0}}/g on the line; whatever the recursion of the force law is, it is not this term far from a body",
      ["\\Delta_{{\\hat{{d}}}}\\rho_{{l}} = l.\\bar{{m}} - a·\\nabla S_{{l}} = l.\\bar{{m}} - \\partial_{{\\hat{{d}}}}\\rho_{{l}}·g", "\\partial_{{\\hat{{d}}}}\\rho_{{l}}: the rays alone - {Expr.show(screened)}", "g = g_{{N}} + \\partial_{{\\hat{{d}}}}\\rho_{{l}}·g", "g \\aside{{bent}} = {Expr.show(got)}", "l.reach\\paren{{\\bar{{R}}}} -> 0 past a free path: g -> g_{{N}}"])
  }
  /*
   * SECOND READING, the clearing: the record above DEG is cleared at the creation rate times the share of dark ways, 1 - rho_l, and
   * where the bodies' rays raise rho_l the clearing slows. The record's own line at a standstill, solved for the record HERE - not at
   * rho_infty - and the pull is its slope.
   */
  record_here (big_s: Step, bal: Step): Step? => {
    parts := Expr.split(big_s.fact.to, "S_{{l}}")
    return None if parts == None
    here := Prover.neat(Expr.div(Expr.neg(parts[1]), parts[0]))
    written := Prover.neat(Expr.replace(here, "l.balance", bal.fact.to))
    st := Step.of(Fact.stands("S_{{l}} \\aside{{standing}}", written), "the record standing against the density here", [big_s.fact.key, bal.fact.key],
      "the record's line at a standstill, \\Delta_{{t}}S_{{l}} = 0, is linear in the record: the meetings write it and creation clears what stands above DEG at the share of dark ways here, 1 - \\rho_{{l}}. Solved for S_{{l}} it is DEG less the balance over that share - and the balance is how far the density here is from settled times the rate the vacuum pulls it back. Where a body's rays raise the density the balance is negative and the clearing is slow, so the record stands ABOVE DEG by that quotient. Nothing in it is at \\rho_{{\\infty}}: this is the record where the density is what it is",
      ["\\Delta_{{t}}S_{{l}} = 0: {Expr.show(big_s.fact.to)} = 0", "S_{{l}} = {Expr.show(here)}", "l.balance = {Expr.show(bal.fact.to)}", "S_{{l}} = {Expr.show(written)}"])
    st.parts_ = [written]
    st
  }
  /* and the pull off that record: its slope, which is its slope in the density times the density's slope - and read at rho_infty that is a number of the lattice alone */
  record_slope (here: Step, s: Store): Step? => {
    inf := s.fact("is", "\\rho_{{\\infty}}")
    return None if inf == None | here.parts_.empty
    rho := "\\rho_{{l}}"
    dS := Prover.neat(Expr.d(here.parts_[0], rho))
    at := Expr.replace(dS, rho, Expr.field("\\rho_{{\\infty}}"))
    /* rho_infty squared is DEG(1 - rho_infty), which is what makes it collapse */
    at = Prover.tidy(Expr.swap(Expr.expand(at), Expr.to_power(Expr.field("\\rho_{{\\infty}}"), Expr.num(2)), Expr.mul([Expr.field("DEG"), Expr.sub(Expr.num(1), Expr.field("\\rho_{{\\infty}}"))])))
    at = Prover.tidy(Expr.reduced(Expr.expand(Expr.reduced(at))))
    Q := Prover.tidy(Expr.reduced(Expr.mul([Expr.num(0.5), at])))
    got := Expr.mul([Q, Expr.field("\\nabla\\rho_{{l}}")])
    Step.of(Fact.stands("g \\aside{{at}} \\rho_{{\\infty}}", got), "the pull off the record standing here", [here.fact.key, inf.key],
      "what a body feels is the record's slope, g = \\frac{{1}}{{2}}\\nabla S_{{l}}, and the record standing here is a function of the density here alone - so its slope is its slope in the density times the density's slope, by the chain rule. Read where the vacuum has settled, the slope in the density is a number of the lattice: the record answers a rise in the density by \\frac{{2\\rho_{{\\infty}} + DEG}}{{1 - \\rho_{{\\infty}}}}, and it is large because the clearing share 1 - \\rho_{{\\infty}} is small. THAT FACTOR IS WHERE DEG STANDS IN THE FAR FIELD: not in the shape of the curve, which the density's slope sets, but in how much record a given density buys. It is not a_{{0}}/g either - the density's slope is what the bodies' rays make at the local, screened, so this reading amplifies the near field rather than the arrival at a distance",
      ["g = \\frac{{1}}{{2}}\\nabla S_{{l}} = \\frac{{1}}{{2}}\\frac{{\\partial S_{{l}}}}{{\\partial \\rho_{{l}}}}·\\nabla\\rho_{{l}}", "\\frac{{\\partial S_{{l}}}}{{\\partial \\rho_{{l}}}} = {Expr.show(dS)}", "at \\rho_{{\\infty}}, with \\rho_{{\\infty}}^{{2}} = DEG\\paren{{1 - \\rho_{{\\infty}}}}: {Expr.show(at)}", "g \\aside{{at}} \\rho_{{\\infty}} = {Expr.show(got)}"])
  }
  space_text (): String => {
    moving := this.infos.filter(t => t.space != "0")
    return "\\partial_{{t}}s = 0" if moving.empty
    out := ""
    Array.range(moving.length).for(i => {
      t := moving[i]
      minus := t.space.starts_with("-")
      mag := minus ? t.space.drop(1) : t.space
      by := mag == "1" ? t.symbol : "{mag}·{t.symbol}"
      head := i == 0 ? (minus ? "-" : "") : (minus ? " - " : " + ")
      out = "{out}{head}{by}"
    })
    "\\partial_{{t}}s = {out}"
  }

  /* the names in a line, opened once each: what the closure settled a piece of the answer to */
  static plain (name: String): String => (name.starts_with("\\text{{") & name.ends_with("}}")) ? name.drop(6).take(name.length - 7) : name
  static names_known (s: Store, at: String): Keyed => {
    known := Keyed()
    s.nodes.for(n => {
      if n.fact.kind == "is" & !Prover.in_r(n.fact.of) {
        [n.fact.to, Expr.replace(n.fact.to, "r", Expr.sym(at))].for(form => {
          k := Expr.show(Expr.simplify(form))
          known.set(k, [n.fact.of, n.because]) if k != "0" & k != "1" & !known.has(k)
        })
      }
    })
    known
  }
  static in_r (of: String): boolean => of.ends_with(" in r") | of.ends_with(" in full")
  static by_name (s: Store): Keyed => {
    out := Keyed()
    s.nodes.for(n => { out.set(n.fact.of, [n.fact.to, n.because]) if n.fact.kind == "is" & !out.has(n.fact.of) })
    out
  }
  static annotate (e: Expr, s: Store, at: String, of: String): Part[] => {
    known := Prover.names_known(s, at)
    out := []
    seen := { }
    whole := Expr.show(Expr.simplify(e))
    look := (x: Expr, depth: N) => {
      k := Expr.show(Expr.simplify(x))
      hit := known.get(k)
      if hit != None & seen[k] == None & k != whole & hit[0] != of & hit[0] != "F_{{g}}" & !hit[0].starts_with("F_{{g}} ") {
        seen[k] = true
        out.push(Part(part: k, stands: hit[0], because: hit[1]))
      } elsif depth <= 5 {
        if x.kind == "mul" | x.kind == "add" { x.of.for(y => { look(y, depth + 1) }) }
        elsif x.kind == "pow" { look(x.base, depth + 1) }
      }
    }
    look(Expr.simplify(e), 0)
    out
  }
  static standing_for (e: Expr, s: Store, of: String): Standing[] => {
    facts := Prover.by_name(s)
    known := Prover.names_known(s, "R")
    cite := (x: Expr, self: String, d: N): Expr => {
      if d > 0 {
        k := Expr.show(Expr.simplify(x))
        hit := known.get(k)
        return Expr.field("\\text{{{hit[0]}}}") if hit != None & hit[0] != self & !Prover.in_r(hit[0]) & k.length > (hit[0].length + 8 > 24 ? hit[0].length + 8 : 24)
      }
      return x if d > 2
      return Expr.add(x.of.map(y => cite(y, self, d + 1))) if x.kind == "add"
      return Expr.mul(x.of.map(y => cite(y, self, d + 1))) if x.kind == "mul"
      x
    }
    out := []
    done := { }
    done[of] = true if !of.empty
    front := [Expr.simplify(e)]
    round := 0
    while round < 6 & !front.empty {
      found := []
      walk := (x: Expr) => {
        k := x.kind
        if k == "sym" | k == "field" { found.push(x.label) }
        elsif k == "add" | k == "mul" { x.of.for(y => { walk(y) }) }
        elsif k == "pow" { walk(x.base); walk(x.power) }
        elsif k == "grad" | k == "log" | k == "exp" | k == "root" { walk(x.base) }
        elsif k == "choose" | k == "gammaInc" { walk(x.first_); walk(x.second_) }
      }
      front.for(x => { walk(x) })
      next := []
      found.for(name => {
        unless done[name] == true {
          done[name] = true
          f := facts.get(Prover.plain(name))
          unless f == None {
            to := Expr.simplify(f[0])
            unless Expr.show(to) == name {
              cited := cite(to, Prover.plain(name), 0)
              out.push(Standing(name: Prover.plain(name), stands: Expr.show(cited), because: f[1]))
              next.push(cited)
            }
          }
        }
      })
      front = next
      round = round + 1
    }
    out
  }

  /* the rates and shares the closure settled to a bare number: filled into a headline */
  static settled (s: Store): {} => {
    out := { }
    s.all("is").for(f => {
      v := Expr.simplify(f.to)
      out[f.of] = v.value if v.kind == "num"
    })
    out
  }
  static headline (f: Fact, fill: {}?): String => {
    return f.says if f.kind != "is"
    of := f.of
    of = of.take(of.length - 16) if of.ends_with(" as one equation")
    of = Prover.aside(of)
    to := fill == None ? f.to : Expr.deep_factored(Expr.evaluate(f.to, fill))
    "{of} = {Expr.show(to)}"
  }
  /* ` at D = 3` and ` in bodies and transport` set back, as filing rather than as the quantity */
  static aside (of: String): String => {
    return "{of.take(of.length - 24)} \\aside{{in bodies and transport}}" if of.ends_with(" in bodies and transport")
    i := of.index_of(" at ")
    if i != None {
      tail := of.drop(i + 4)
      j := tail.index_of(" = ")
      return "{of.take(i)} \\aside{{at}} {tail.take(j)} \\aside{{= {tail.drop(j + 3)}}}" if j != None & tail.drop(j + 3).chars.every(c => c >= 48 & c <= 57)
    }
    of
  }
  line_of (st: Step): Line => {
    kind := Prover.is_rule_name(st.via) ? "rule" : "theorem"
    l := Line(kind: kind, via: st.via, line: Prover.headline(st.fact, None), working: st.working, because: st.because)
    l.id = st.fact.key
    l.upon = st.upon
    named := st.rule ?? st.via
    r := this.rule_named(named.split(",")[0].trim)
    unless r == None {
      l.rule = r.name.upper
      l.source = r.source
      l.gates = r.where == None ? [] : [r.where.source]
    }
    l.derivation = st.derivation.map(x => this.line_of(x))
    l
  }
  /* the rewrite a step is about, by the name it is cited under: the rule as the equation's terms carry it */
  rule_named (name: String): * => {
    t := this.infos.filter(t => t.term.rule != None & (t.term.rule.name.upper == name | t.term.rule.id == name)).first
    t == None ? None : t.term.rule
  }
  /* a rule's name is written in capitals: ANNIHILATION, S.1, ... */
  static is_rule_name (via: String): boolean => !via.empty & via.chars[0] >= 65 & via.chars[0] <= 90 & via.chars.every(c => (c >= 65 & c <= 90) | c == 95 | c == 46 | c == 47 | c == 32 | c == 43)

  /* what the rules come to, one question at a time */
  proof (): Proof => {
    s := this.closure
    fill := Prover.settled(s)
    missing := this.missing(s)
    line := this.line_steps
    /* the equation's chain, once: every step past the line, each answerable as a theorem of its own by the name it stands */
    filled := this.line_filled(s)
    spaced := this.ledger_filled(s, "space")
    folded := this.ledger_filled(s, "folds")
    this.population_line = filled
    this.record_line = folded
    one := this.ledgers_are_one(s, folded, spaced)
    whole := this.general(filled, folded)
    settled := this.settled_record(folded)
    short := settled == None ? None : this.single(whole, settled, folded, s)
    agg := short == None ? None : this.aggregate(whole, short, s)
    back := agg == None ? None : this.remembered(s, agg)
    each := back == None ? None : this.from_each(s, back)
    known := each == None ? None : this.forgotten(s, each, settled)
    pull := known == None ? None : this.felt(s, known, settled)
    one_ := pull == None ? None : this.one_body(s, pull)
    rec := pull == None ? None : this.record_of_all(known, pull, settled)
    locals := rec == None ? None : this.every_local(rec, settled)
    at_ := locals == None ? None : this.at_time(locals)
    follow := locals == None ? None : this.following(locals)
    lean_ := locals == None ? None : this.lean(locals)
    bal := locals == None ? None : this.balance(locals, s)
    big_s := bal == None ? None : this.record_S(locals, folded)
    far := bal == None ? None : this.record_sum(locals)
    whole_line := bal == None ? None : this.one_line(locals, filled)
    quiet := whole_line == None ? None : this.settled_line(whole_line, bal)
    quiet_s := whole_line == None ? None : this.settled_S(whole_line, bal)
    /* the recursion read off the far field, two readings kept apart: the bending, and the record standing against the density here */
    bent := (quiet == None | lean_ == None) ? None : this.bent_line(quiet, lean_, s)
    bent_far := (bent == None | known == None) ? None : this.bent_far(bent, known, quiet)
    here := (big_s == None | bal == None) ? None : this.record_here(big_s, bal)
    slope := here == None ? None : this.record_slope(here, s)
    solved := [back, each, known, pull, one_, rec, locals, at_, follow, lean_, bal, big_s, far, whole_line, quiet, quiet_s, bent, bent_far, here, slope].filter(x => x != None)
    chain := line.concat([this.isotropic_population, filled, spaced, folded, one, whole]).concat(settled == None ? [] : [settled, short]).concat(agg == None ? [] : [agg]).concat(solved)
    named := Keyed()
    [at_, follow, lean_, bal, big_s, far, quiet, quiet_s, bent, bent_far, here, slope].filter(x => x != None).for(st => { named.set(st.fact.of, st) })
    proved := this.theory.theorems.map(t => {
      q := t.asked
      p := Proved(theorem: t.id, theory: this.theory.name, asks: q.asks, about: q.about)
      hit := q.about.empty ? None : named.get(q.about)
      /* a name of the line is answered by its chain step, shown behind the model it is read off */
      root := s.steps[Fact.key_of("is", "the continuous model")]
      steps := q.about.empty ? chain : (hit != None ? (root == None ? [hit] : [root, hit]) : Prover.behind(s, q.about))
      end := q.about.empty ? None : steps.last
      p.steps = steps.map(st => this.line_of(st))
      if q.about.empty {
        /* the line, and nothing under it: its names are theorems of their own */
        p.concluded = Prover.headline((whole_line ?? agg ?? short ?? whole).fact, None)
        p.standing = true
      } else {
        end = None if end != None & end.fact.of != q.about
        if end == None {
          p.missing = missing
        } else {
          chained := ""
          if q.chain != None {
            walk := Prover.behind(s, q.chain)
            at := walk.last
            chained = (at != None & at.fact.kind == "is" & at.fact.of == q.chain) ? " = {Expr.show(at.fact.to)}" : ""
          }
          p.concluded = hit != None ? Prover.headline(end.fact, None) : "{Prover.headline(end.fact, fill)}{chained}"
          p.standing = true
          if end.fact.kind == "is" {
            p.parts = Prover.annotate(end.fact.to, s, "R", q.about)
            p.standing_for = Prover.standing_for(end.fact.to, s, q.about)
          }
        }
      }
      p.leads = q.leads
      p.then = q.then
      if q.also != None {
        hitA := named.get(q.also)
        walk := hitA != None ? [hitA] : Prover.behind(s, q.also)
        at := walk.last
        p.also = (at != None & at.fact.of == q.also) ? (hitA != None ? Prover.headline(at.fact, None) : Prover.headline(at.fact, fill)) : None
      }
      p.terms = this.infos.map(t => TermRecord(symbol: t.symbol, sign: t.sign, degree: t.degree, facing: t.facing, rays: t.rays, space: t.space, rules: t.rules, says: t.says))
      p
    })
    Proof(theory: this.theory.name, proved: proved)
  }
}

sep2 := ", "
plus := " + "
ind2 := "  "
nl0 := "\n"
