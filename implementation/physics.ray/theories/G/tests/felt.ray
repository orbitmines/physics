/*
 * WHAT IS FELT, SOLVED OVER THE WHOLE FIELD (Felt.ray): the space made round ONE body is a shell, so its record is the
 * chain's closing law exactly; round a thin disc it is not round, so a disc deep in the weak field is felt off the law
 * of what arrives at a radius - which is what makes the possibility space an area and not a line.
 */

felt: Felt = Felt()

Felt{cells > 0} += {
  dynamically assert off_law(shape(0.1, 1, 0, 0), 1) < 0.003
  dynamically assert off_law(shape(0.1, 1, 0, 0), 0.01) < 0.003
  dynamically assert off_law(shape(0.02, 0, 0, 0), 0.01) > 0.05
  dynamically assert off_law(shape(0.02, 0, 0, 0), 100) < 0.01
}
