/*
 * THE SCALE AGAINST THE EXPANSION, AS NUMBERS: a_0/cH closed off the rules and read on the settled vacuum of each
 * lattice. Measured it is 0.155 to 0.183 (a_0 1.1-1.3e-10 m/s^2, H_0 67.4-73.0 km/s/Mpc). Nothing measured goes in;
 * this pins what the derivation gives, so a change to the rules that moves or loses it is seen.
 */

coincidence := Model(theory: G)

Model{theory.name == "G"} += {
  /* the ratio exists: the vacuum expands and the scale is finite */
  dynamically assert Fmt.finite(value_of("\\frac{{a_{{0}}}}{{cH}}", settled(18)))
  dynamically assert value_of("\\frac{{a_{{0}}}}{{cH}}", settled(18)) > 0
  /* it falls with the lattice's ways */
  dynamically assert value_of("\\frac{{a_{{0}}}}{{cH}}", settled(12)) > value_of("\\frac{{a_{{0}}}}{{cH}}", settled(18))
  dynamically assert value_of("\\frac{{a_{{0}}}}{{cH}}", settled(18)) > value_of("\\frac{{a_{{0}}}}{{cH}}", settled(26))
  /* and eighteen ways put it inside what is measured */
  dynamically assert value_of("\\frac{{a_{{0}}}}{{cH}}", settled(18)) > 0.15
  dynamically assert value_of("\\frac{{a_{{0}}}}{{cH}}", settled(18)) < 0.19
}
