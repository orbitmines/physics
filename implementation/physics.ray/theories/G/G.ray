/*
 * G - the discrete theory. Five rules of the vacuum and three of what was put into it, in the
 * order they fire. A match belongs to the first rule that takes it; c̄ is one step a tick, by
 * definition, and nothing here says otherwise.
 */

Edge += {
  /* two rays that meet on the edge between two points annihilate, leaving one neutral point */
  ANNIHILATE () => {
    this.initial.ray.deactivate
    this.terminal.ray.deactivate
    here := this.initial.vertex
    there := this.terminal.vertex
    here.world.annihilations = here.world.annihilations + 1
    /* credited half to each end of the edge the event happened on: the deficit belongs to the edge */
    here.destroyed = here.destroyed + 0.5
    there.destroyed = there.destroyed + 0.5
    /*
     * each ray still leaves the point behind it, as a step would have (MOVE) - but only where the way behind it is dark:
     * behind a vacuum ray stands the vacuum's own ray, so nothing is left there; at the edge of a field, where a ray has
     * nothing behind it, the point is left. Then the two points fold into one
     */
    g := here.world.geometry
    a := this.initial.ray
    b := this.terminal.ray
    unless here.rays[g.opposite(a.exit)].active { here.world.grow(here.at - g.offsets[a.exit]) }
    unless there.rays[g.opposite(b.exit)].active { there.world.grow(there.at - g.offsets[b.exit]) }
    here.fold(there)
  }
}

Vertex += {
  /* a neutral point is handed back a point of space, and every exit it has is lit */
  CREATE () => {
    this.unfold
    this.rays.each.activate
    this.world.created = this.world.created + 1
  }
}

Ray += {
  /*
   * every active ray moves one step along its own exit, turned by what is folded here - AS RELATIVE MOVEMENT: the
   * ray's own point takes the place of the point ahead, carrying its record with it, and that point is put where it
   * stood - folded ahead, unfolded behind. Nothing is made or taken by a step; that happens only when a ray cannot
   * go on, at a meeting (ANNIHILATE). A body's cell is not moved: a source is transparent, and a ray steps through
   * it as it always did
   */
  MOVE () => {
    to := this.turns
    if to == None {
      /* nowhere to step: on an expanding world it makes the room and waits a tick */
      this.leaving.grow
      this.hand(this)
      return
    }
    here := this.vertex
    there := to.vertex
    if !there.vacuum | !here.vacuum {
      this.hand(to)
      return
    }
    here.swap(there)
    this.hand(here.rays[to.exit])
  }

  /* what was arriving is now what is here */
  SETTLE () => this.settle
}

G: Theory = class {
  name = "G"
  /*
   * three dimensions on the cube's corners, eight ways (BCC8): with a_0 the empty vacuum's own growth, v H_Lambda, the
   * measured a_0/cH_0 is v sqrt(Omega_Lambda), and v = 2/(DEG+2) puts it in the measured band at eight ways and nowhere
   * else a lattice of Z^3 offers (gravity.coincidence). It was the faces and edges, eighteen, while a_0 was read as vH
   */
  lattice (): Geometry => BCC8

  rule /1 "Annihilation" | σ (x: 1 Edge{active}) => x.ANNIHILATE
  /* a POINT that nothing stands on unfolds: a point any ray stands on stays folded, and the space around matter warps */
  rule /2 "Creation" | ν (x: Vertex{neutral}) => x.CREATE
  rule /c "Movement" | σ (x: Ray{active}) => x.MOVE
  rule /4 "Arrival" (x: Ray) => x.SETTLE

  /*
   * a source absorbs what arrived and writes its own charge onto the space around it. What it
   * lights is the NEIGHBOUR's ray on the same heading, so a body cannot catch its own light.
   */
  rule /S.1 "Emission" (x: 1 Boundary{emits & vertex.source.spare}) => {
    s := x.vertex.source

    /* a source is transparent: what arrives passes through it, and moves nothing - a body is moved by where the space around it leads (`Transport`) */
    out := x.ray.steps
    if out != None {
      out.activate
      s.momentum = s.momentum - x.ray.along
    }
  }

  /*
   * THE GRAVITY PANEL, THREE TIMES - gravity.rain, gravity.pull and solar.inner are ONE panel (Panel.ray)
   * and three sets of numbers: where the bodies start, how big the box is, how long the film runs and
   * how the view opens. Everything about how it LOOKS is one copy. Every length is in c-bar - the distance
   * light goes in a tick - and `K` cells make one; `A` directions and `K` cells to a c-bar are the two
   * resolutions the line is integrated at, and neither may move the answer.
   *
   * VIEW 20 is the furthest the panel shows and MARGIN 8 what a body needs to get out of sight; the pair
   * sit GAP 20 apart, where the two fields overlap where they are strongest. A body is one place, joined
   * on by WAYS 2000 connections, announcing itself at the ceiling MX 1 so the effect is the plainest the
   * rules allow. TICKS 2 a frame spans the medium's own period (every point splits, then every one of
   * them annihilates) so the parity divides out, and the film is RUN 150 frames of it.
   */
  visual "gravity.rain" () => G.pair("gravity.rain", "held", "two bodies held where they are: what each sends out, streamed one c-bar a tick and bent by the record the other leaves, and on the right where space is destroyed by one body's rays against the other's - the equation's meeting term on the two, the pair term the force law is a product for")
  /* the probe behind the pair: the same two bodies put down at rest, twelve c-bar apart, and left - do they close, and how fast; short and small, so it answers in a minute */
  visual "gravity.rest" () => G.pair("gravity.rest", "rest", "the probe behind the pair: two bodies put down at rest twelve c-bar apart and let go - each pulled at the rate the other's record rises toward it, which the recorder prints against the derivation's own number")
  /* the same two bodies thrown past each other and bent by `turns` - at V0 0.3 c-bar, missing by IMPACT 6 apiece */
  /* the same two bodies flying past each other at HALF OF C-BAR, opposite ways, missing by PASS_GAP: the record each leaves trails behind it, and the pull the other feels points at where it WAS when the rays left - the lag of the field, seen */
  visual "gravity.pass" () => G.pair("gravity.pass", "passing", "two bodies flying past each other at half of c-bar, opposite ways: the record each leaves trails behind where it was, since its rays left it one light-time ago, and what the other is pulled toward is that trail - the field lags the body by its own speed")
  visual "gravity.pull" () => G.pair("gravity.pull", "thrown", "two bodies circling their middle at the speed the derivation gives them - the record each leaves at the other, its slope there, and a circle of half their separation - launched with it and left to the medium, so the orbit moves when the derivation does")

  /*
   * THE INNER SOLAR SYSTEM, MEASURED AND MODELLED SIDE BY SIDE - the control panel. The numbers are JPL's
   * (`data/solar-inner`: GM, the mean radius, the J2000 semi-major axis, eccentricity and period of the
   * four terrestrial planets). The system is laid over the band where the Sun's folds fall off - the only
   * place this theory holds a body in orbit (`solar`, below) - Mars' aphelion at VIEW c-bar, ten cells to
   * a c-bar. The planets keep Kepler's speed ratio from the data (the speed only sets the clock here) and
   * the masses are a caricature the panel says so about: the Sun heavy, the planets alike, light and no
   * bigger than a point.
   */
  visual "solar.inner" () => G.solar

  /* where the model puts galaxies, against every measurement - Galaxies.ray, drawn from `npx ray measure` */
  visual "galaxy.point" () => Galaxies.point
  visual "galaxy.many" () => Galaxies.many
  visual "galaxy.curves" () => Galaxies.curves
  /* the galaxies themselves, run (Simulation.ray): tracers on each one's field, beside its curve; and, asked for by name, the relation every run galaxy makes */
  visual "galaxy.simulation" () => Galaxies.simulation
  visual "galaxy.formed" () => Galaxies.formed
  /* a disc of stars in the medium itself, every star its own body, every step local (galaxy.gpu.ts RAY_ONLY=medium-galaxy) */
  visual "galaxy.medium" () => Galaxies.medium
  visual "galaxy.rar" () => Galaxies.rar

  /*
   * THE RULES OF THE VACUUM ON A LINE (Strip.ray): each on the smallest world it acts on, before and
   * after, with the rule's own `matches` and `apply` deciding what the after lane shows. Gravity has no
   * polarity, so every ray is drawn neutral: the ink is a choice a later theory makes differently.
   */
  visual "rule.annihilation" () => G.strip("rule.annihilation")
  visual "rule.creation" () => G.strip("rule.creation")
  visual "rule.movement" () => G.strip("rule.movement")

  /* THE VACUUM ON ITS OWN, FROM ONE POINT (Strip.ray): a single point on a line and nothing else, and every rule run on it a tick at a time - what space does when nothing is in it */
  visual "space.expansion" () => G.expansion

  /* THE SHADOW, general relativity against this model across one seam, each half off its own critical impact parameter (`gravity.shadow`) */
  visual "gravity.shadow" () => G.shadow

  /* one rule, run on its seeds: /1 on a meeting, /2 on what /1 left of it, /c (settled by /4) on a lone ray in the middle of three points, either way */
  strip (id: String): Picture => {
    ink := Ink()
    return Strip.of(id, "two rays meet on the edge between two points and annihilate, leaving one neutral point - the other folded into it, and which way it was kept (G/1)", this, ["/1"], [Strip.meeting], ink) if id == "rule.annihilation"
    return Strip.of(id, "a point nothing stands on is handed back a point of space - the one it held - and every exit it has is lit (G/2): annihilation, run backwards", this, ["/2"], [(t: Theory): World => Strip.left(t, Strip.meeting, ["/1"])], ink) if id == "rule.creation"
    Strip.of(id, "every active ray goes one step along its own exit, c-bar, into its neighbour (G/c, settled by G/4)", this, ["/c", "/4"], [(t: Theory): World => Strip.heading(t, 1), (t: Theory): World => Strip.heading(t, 0 - 1)], ink)
  }

  /*
   * ONE POINT, AND EVERY RULE RUN ON IT: it splits (/2), its rays go out a step a tick (/c), and where two meet they fold
   * back into one (/1). The ends have nothing to meet, so what they leave is never given back - it is new space, and the
   * line grows by a point each way every tick. Every point is drawn, because the picture is about the points
   */
  expansion (): Picture => {
    ink := Ink()
    ink.every = true
    Strip.film("space.expansion", "one point on a line and nothing else, and every rule of the vacuum run on it a tick at a time: it splits (G/2), its rays go out a step a tick (G/c), and where two meet they fold back into one (G/1) - the ends have nothing to meet and are new space, so the line grows by a point each way every tick", this, Strip.point, 8, ink)
  }

  /*
   * THE SHADOW, CUT DOWN THE MIDDLE (the article's SHADOW.tsx, kept 1-1): the same mass, the same camera, the same
   * brightness law, general relativity left of the seam and this model right - the only thing that changes across it is
   * the metric. Two panels would ask the eye to carry a radius between them; one seam puts the two edges against each
   * other. Each half is read off its critical impact parameter: this model's is `gravity.shadow`'s own number, off the
   * prover, so a derivation that moves it moves the picture; general relativity's is 3 sqrt 3. Every length is in m-bar.
   * WHAT IS DRAWN IS WHERE THE RAYS PILE UP - the photon ring - and a smooth glow outside it, not a disc: that is what is
   * defensible without a radiative transfer
   */
  shadow (): Picture => {
    env := { }
    env["\\bar{{m}}"] = 1
    MODEL := Model(theory: this).value_of("b_{{c}}", env)
    GR := 3 * Real.of(3).sqrt
    CRIT := [GR, MODEL]
    W := 900
    H := 420
    SPAN := 12
    BACK := "#08090d"
    what := "the same mass, the same camera - general relativity left of the seam, this model right. The bright ring is where rays pile up; the dashed arcs are the two critical impact parameters, {Fmt.fixed(GR, 3)} and {Fmt.fixed(MODEL, 3)} m-bar, and the step at the seam is the {Fmt.fixed(100 * (MODEL / GR - 1), 2)} per cent the metric gives"
    Picture.still("gravity.shadow", what, W, H, (s: Surface) => {
      s.clear_rect(0, 0, W, H)
      s.fill_style(BACK)
      s.fill_rect(0, 0, W, H)
      cx := W / 2
      cy := H / 2
      k := Fmt.min(W, H) / (2 * SPAN)
      /* each half as rings a pixel apart, from the corner in: a ray at impact parameter b is kept below its half's critical value and lit by how near it passes it above */
      s.line_width(1.6)
      Array.range(2).for(side => {
        crit := CRIT[side]
        from_ := side == 0 ? Real.PI / 2 : 0 - Real.PI / 2
        px := Fmt.hypot(cx, cy).floor + 1
        while px >= 0 {
          b_ := px / k
          colour := "rgb(0,0,0)"
          if b_ >= crit {
            ring := Fmt.max(0, 1 - (b_ - crit).abs / 0.45)
            glow := 0.30 * Fmt.min(1, 3.2 / (b_ - crit + 1.6))
            v := Fmt.min(1, ring * 0.95 + glow)
            colour = "rgb({Fmt.min(255, 8 + v * 250).round},{Fmt.min(255, 9 + v * 175).round},{Fmt.min(255, 13 + v * 105).round})"
          }
          s.stroke_style(colour)
          s.begin_path
          s.arc(cx, cy, px, from_, from_ + Real.PI)
          s.stroke
          px = px - 1
        }
      })
      /* the seam, and each half's critical radius marked, because the number is the point of the figure */
      s.stroke_style("rgba(140,147,168,0.35)")
      s.line_width(1)
      s.begin_path
      s.move_to(cx, 0)
      s.line_to(cx, H)
      s.stroke
      s.dash([3, 4])
      s.stroke_style("rgba(140,147,168,0.65)")
      Array.range(2).for(side => {
        from_ := side == 0 ? Real.PI / 2 : 0 - Real.PI / 2
        s.begin_path
        s.arc(cx, cy, CRIT[side] * k, from_, from_ + Real.PI)
        s.stroke
      })
      s.dash([])
      s.font("11px system-ui, sans-serif")
      s.fill_style("rgba(140,147,168,0.9)")
      s.text_align("right")
      s.fill_text("general relativity · {Fmt.fixed(GR, 3)} m̄", cx - 10, H - 12)
      s.text_align("left")
      s.fill_text("this model · {Fmt.fixed(MODEL, 3)} m̄", cx + 10, H - 12)
    })
  }

  /* the two-body panel: `held` apart or `thrown` past each other, and nothing else differs */
  pair (id: String, how: String, what: String): Picture => {
    VIEW := 20
    MARGIN := 20
    GAP := 20
    /*
     * A REALISTIC SOURCE ANNOUNCES RARELY. What a body lights per edge each tick is m-bar_x times its ways over
     * DEG (`per_way`): at m-bar_x 1 and 2000 ways that is 250 rays on every edge next to it, the space around it
     * saturated, its folds never handed back, and its own rays scattered back onto it by that fog - the wake
     * that dragged every moving body. At m-bar_x 0.01 and 100 ways it is an eighth of a ray per edge: the record around
     * it stays thin, creation hands space back, and the pull thins with the flux as a field does
     */
    /*
     * and it announces so rarely that the pair goes round at about a hundredth of c-bar: each body is pulled toward the
     * other as it WAS one light-time ago, so the pull lags the motion by the speed, and a pair that circles fast is
     * driven apart by its own lag; slow, the lag is a small part of the pull and the orbit holds for the film
     */
    /* realistic bodies, as in `solar`: the Sun's ways and the rate it announces at - so much vacuum between its pulses that what one lit is carried off and met before the next */
    WAYS := 4096
    MX := 0.00006
    /* the passing pair: half of c-bar each, opposite ways, and how far apart their lines lie */
    V_PASS := 0.5
    PASS_GAP := 8
    /* a frame spans the medium's period for the held pair; for the orbit, enough that the film's frames span about one turn at the solved speed */
    /* a frame spans the medium's own period, two ticks, so the parity divides out; the passing pair crosses the view in about seventy ticks at half of c-bar, so the film is the crossing and what trails it */
    TICKS := how == "thrown" ? 64 : 2
    V0 := 0.3
    /* the rest probe is the solve alone: a couple of frames of film, so it answers in about a minute */
    RUN := how == "rest" ? 2 : (how == "passing" ? 70 : 150)
    K := 3
    N := 2 * (VIEW + MARGIN) * K + 1
    coarse := 2 * (VIEW + MARGIN) + 1
    /*
     * THE ORBIT IS DERIVED FROM THE THEORY, EACH TIME, BY TRYING IT. A body is moved by where the space around
     * it leads (`Transport`), and nothing simpler than running the pair says where that closes. So before the
     * film, on the device, two of these bodies are thrown across each other at each R of RADII for a few
     * hundred ticks (`Trial`), and the R at which their separation held steadiest - farthest over closest the
     * least - is the one they are put at. Edit a rule and R moves with it; where no R holds, the console says
     * how far each one wandered. V0 sets the clock.
     */
    /*
     * THE ORBIT IS SOLVED FOR ON THE SIMULATION, EACH TIME. Nothing simpler than running the pair says where a
     * body's path closes under these rules, so before the film, on the device, the circling speed at the
     * separation ORBIT_R is found as a root: the pair thrown across each other at a speed falls in below it and
     * drifts out above it, and bisection on the theory's own run finds the speed where it does neither
     * (`Orbit`). The film launches with it. Edit a rule and the speed moves with it; where no speed below c-bar
     * holds, the console says which way the pair goes at every speed. Solved at the film's own headings and
     * cells, since the answer must not move with them
     */
    ORBIT_R := how == "rest" ? 12 : 36
    /* the pair arrives: its farthest separation is the view's edge, its nearest a third of that */
    NEAR_R := ORBIT_R / 3
    /* the film starts as the bodies are put down: their rays expand from them, meet in the middle, and where they meet is the right half */
    /* every film opens on fields that have already propagated: the bodies are held while their rays and the beat cross the whole box, an even number of ticks so the beat is where it started */
    BURN := 2 * (VIEW + MARGIN)
    /*
     * THE ORBIT IS SOLVED ON THE DERIVATION, EACH TIME: the record the other body leaves pulls at the rate it rises
     * (Aggregate.pull); integrated out it is the well, and the orbit between ORBIT_R and NEAR_R has one speed at
     * ORBIT_R by the well and the turning (Aggregate.arriving) - so the pair is put down at its farthest, moving
     * across, and falls in to its nearest and round. Edit the derivation and the launch moves with it; where the
     * pull gives no such orbit, the pair is let go at rest
     */
    LAW := Aggregate.of(this)
    /*
     * THE FILM IS AS LONG AS THE ORBIT: under a pull that falls as the square an orbit between ORBIT_R and NEAR_R takes as
     * long as a circle at their mean, so a frame spans TURNS of that circle over the RUN frames - read off the law's own
     * circling speed, and even, so the medium's parity divides out
     */
    TURNS := 3
    MEAN_R := (ORBIT_R + NEAR_R) / 2
    V_MEAN := LAW.circling(MX * Real.of(WAYS), MEAN_R, MEAN_R / 2)
    PERIOD := Fmt.finite(V_MEAN) ? Real.TAU * (MEAN_R / 2) / V_MEAN : Real.of(64 * RUN)
    TICKS = how == "thrown" ? 2 * ((Real.of(TURNS) * PERIOD / Real.of(2 * RUN)).floor + 1) : TICKS
    /* with both bodies moving and each read where it was when its ray left (Aggregate.launches): the speed at which the second comes no nearer the first than NEAR_R; the first is launched opposite, as its twin */
    V_ORBIT := LAW.launches([MX * Real.of(WAYS), MX * Real.of(WAYS)], [0, ORBIT_R], [0, NEAR_R], false, 3)[1]
    world := "{this.lattice.name}/D{this.lattice.D}/slice"
    stamp := "{world}/{coarse}/{WAYS}/{GAP}/{MX}/{TICKS}/{V0}/{VIEW}"
    stamp = how == "held" ? "{stamp}/held/{N}/{TICKS}/{RUN}" : (how == "passing" ? "{stamp}/passing/{V_PASS}/{PASS_GAP}/{N}/{TICKS}/{RUN}" : "{stamp}/orbit-derived")
    p := Setup(id: id, what: what, width: 900, height: 460, theory: this,
      /* the view is the front's own radius plus a margin, and the front goes at c-bar */
      /* the passing pair starts at the view's edge, so the view is the whole of it from the first frame */
      view: (t: N): Real => how == "passing" ? VIEW : Fmt.max(GAP / 2 + 6, Fmt.min(VIEW, GAP / 2 + 6 + t)),
      place: (setup: Setup): Body[] => {
        /* the separation, and the speed at which the pair circles there - off the derivation; at rest where it gives no circle */
        R := ORBIT_R
        V := Fmt.finite(V_ORBIT) ? V_ORBIT : 0
        [-1, 1].map(sign => {
          b_ := Body(x: sign * GAP / 2, y: 0, mx: MX, ways: WAYS)
          b_.tag = (sign + 1) / 2 + 1
          if how == "thrown" | how == "rest" {
            /* the pair at the found R, each moving across the line between them at the found speed, opposite ways; at rest, free to be carried and not thrown */
            b_.x = sign * R / 2
            b_.y = 0
            b_.moves = true
            b_.py = how == "rest" ? 0 : 0 - sign * V * MX * WAYS
            /* thrown: on the orbit from ORBIT_R in to NEAR_R about their middle, at the speed the medium's pull gives there */
            if how == "thrown" {
              b_.launch = "orbit"
              b_.ecc = Real.of(ORBIT_R - NEAR_R) / Real.of(ORBIT_R + NEAR_R)
              b_.py = 0 - sign
            }
          }
          if how == "passing" {
            /* each starts at the view's edge on its own line, PASS_GAP apart, and flies along x at half of c-bar toward and past the other - momentum is in c-bar a tick, times the mass */
            b_.x = 0 - sign * (VIEW - 2)
            b_.y = sign * PASS_GAP / 2
            b_.moves = true
            b_.px = sign * V_PASS * MX * WAYS
            b_.py = 0
          }
          b_
        })
      })
    /* what the derivation says of this launch, for the console: R, v, the pull at R, whether a circle holds */
    p.found = [[ORBIT_R, V_ORBIT, LAW.pull(MX * Real.of(WAYS), ORBIT_R), Fmt.finite(V_ORBIT) ? 1 : 0, NEAR_R]]
    p.VIEW = VIEW
    p.MARGIN = MARGIN
    p.GAP = GAP
    /* a body's rays go out from it, so which way they go is not stored and the line needs no headings of its own */
    p.A = 8
    p.K = K
    p.PIX = K
    p.TICKS = TICKS
    p.RUN = RUN
    p.BURN = BURN
    p.tags = 3
    p.bodies = 2
    p.stamp = stamp
    /* an encounter is over when neither of them is in frame any more */
    p.spent = (at: Body[]): boolean => at.every(b_ => Fmt.hypot(b_.x, b_.y) > VIEW) if how == "thrown" | how == "passing"
    Panel.of(p)
  }

  solar (): Picture => {
    SOLAR := Measured.of("solar-inner")
    fail("solar-inner is not on disk - run `npx ray data` and try again") if SOLAR == None
    NAMES := SOLAR.header["names"]
    GM := SOLAR.columns["GM"]
    AX := SOLAR.columns["a"]
    EC := SOLAR.columns["e"]
    PER := SOLAR.columns["period"]
    RAD := SOLAR.columns["radius"]
    COLOUR := { }
    COLOUR["Mercury"] = "#9a9a9a"
    COLOUR["Venus"] = "#e8d3a0"
    COLOUR["Earth"] = "#4a90e2"
    COLOUR["Mars"] = "#c1440e"
    /* the planets are every row with an orbit; the Sun is the one without */
    PLANETS := Array.range(NAMES.length).filter(i => PER[i] > 0)
    AU := 149597870.7
    CKM := 299792.458
    /*
     * THE SCALE IS THE DERIVATION'S OWN. The record a body leaves falls as one over the shell beyond its reach -
     * a few c-bar, where what still arrives as rays has died into the record - and inside it the reach's own
     * slope stands against the shell's (Aggregate.pull, printed by the recorder). So the system is laid where the
     * pull is the shell's alone: Mercury's semi-major axis at twelve c-bar, which puts Mars' aphelion at VIEW.
     * Two cells to a c-bar keep the box small enough to film at that reach
     */
    REACH := 0
    PLANETS.for(i => { REACH = Fmt.max(REACH, AX[i] * (1 + EC[i])) })
    INNER := 1000000
    PLANETS.for(i => { INNER = Fmt.min(INNER, AX[i]) })
    VIEW := (12 * REACH / INNER).round
    /* and the box stands off by a third of the view again, so what the outermost body sends still has room to spread and to be met, rather than crossing the edge and being gone */
    MARGIN := (VIEW / 3).round
    ANGLES := 8
    PER_C := 3
    N := 2 * (VIEW + MARGIN) * PER_C + 1
    CELL_AU := REACH / VIEW
    cells := (au: Real): Real => au / CELL_AU
    /* four hundred frames are a Mars year: how long that is, in ticks, is the law's own (below) */
    TICKS := 16
    RUN := 400
    /*
     * EACH PLANET'S SPEED IS SOLVED FOR ON THE SIMULATION (`Orbit`): the Sun held, the planet at its own
     * semi-major axis, thrown across it - the speed at which it neither falls in nor drifts out over one turn,
     * by bisection on this theory's own run. Nothing is taken from Kepler; whether the speeds come out as
     * Kepler's ratio is what the picture is for
     */
    /*
     * THE MASSES ARE JPL'S OWN RATIOS. The Sun is ways 4096 announcing at SUN_PULSE, and a planet announces at
     * whatever makes its mass the Sun's times GM over the Sun's GM - Mercury at a six-millionth of it, as it is.
     * What a body sends is its mass over the lattice's ways (Medium.per_way), so the ratio is the whole of it
     */
    /* rare announcers, as a realistic source is (see `pair`): the Sun at half a ray per edge a tick */
    /* the Sun's mass sets the clock: at these numbers Mercury circles at about a hundredth of c-bar */
    SUN_PULSE := 0.00006
    WAYS_SUN := 4096
    WAYS_PLANET := 8
    ways := (i: N): N => i == 0 ? WAYS_SUN : WAYS_PLANET
    pulse := (i: N): Real => i == 0 ? SUN_PULSE : SUN_PULSE * Real.of(WAYS_SUN) / Real.of(WAYS_PLANET) * GM[i] / GM[0]
    per_planet := PLANETS.map(i => {
      a_text := Fmt.fixed(AX[i], 4)
      "{NAMES[i]}:{a_text}:{ways(i)}:{Fmt.fixed(GM[i] / GM[0], 12)}"
    }).join(",")
    world := "{this.lattice.name}/D{this.lattice.D}/slice"
    stamp := "{world}/{N}/{VIEW}/{RUN}/{TICKS}/{WAYS_SUN}/{SUN_PULSE}/{WAYS_PLANET}/{per_planet}/solved"
    p := Setup(id: "solar.inner", what: "JPL's inner solar system laid on the derivation's own scale: the Sun held, each planet at its semi-major axis and launched at the circling speed the record's slope there gives (the recorder prints v times the root of R for each, one number under an inverse-square pull) - and left to the medium, so where the planets go is what the derivation says, against Kepler", width: 900, height: 460, theory: this,
      /* the view does not open: the arrangement is given, and the range is the system's own from the first tick */
      view: (t: N): Real => VIEW,
      place: (setup: Setup): Body[] => {
        /* the Sun is held, because the panel is about whether a planet goes round it */
        sun := Body(x: 0, y: 0, mx: pulse(0), ways: ways(0))
        sun.tag = 1
        out := [sun]
        Array.range(PLANETS.length).for(k => {
          i := PLANETS[k]
          /* at its aphelion, moving across at the speed the derivation gives for its orbit (a speed is a momentum of v m-bar) */
          b_ := Body(x: cells(AX[i] * (1 + EC[i])), y: 0, mx: pulse(i), ways: ways(i))
          b_.tag = 2 + k
          b_.moves = true
          v := setup.found.length > k & Fmt.finite(setup.found[k][1]) ? setup.found[k][1] : 0
          b_.py = 0 - v * pulse(i) * ways(i)
          /* on JPL's orbit, put down at its aphelion: the speed there is the medium's to give */
          b_.launch = "orbit"
          b_.ecc = EC[i]
          b_.py = 0 - 1
          out.push(b_)
        })
        out
      })
    /* the fields have already propagated: the bodies held while their rays and the beat cross the whole box, an even number of ticks */
    BURN := 2 * (VIEW + MARGIN)
    /*
     * EACH PLANET'S ORBIT IS SOLVED ON THE DERIVATION'S OWN DYNAMICS WITH EVERY BODY (Aggregate.launches): put down at
     * its aphelion, moving across at the speed at which - the Sun held and every planet pulling every other - it comes
     * no nearer the Sun than its perihelion, JPL's own laid on the derivation's scale; found by bisection on that run
     */
    LAW := Aggregate.of(this)
    SUN := pulse(0) * Real.of(ways(0))
    /* the outermost planet's year, off the law's own circling speed round the held Sun at its semi-major axis: the film spans it */
    OUTER := PLANETS.last
    A_OUT := cells(AX[OUTER])
    V_OUT := LAW.circling(SUN, A_OUT, A_OUT)
    YEAR := Fmt.finite(V_OUT) ? Real.TAU * A_OUT / V_OUT : Real.of(16 * RUN)
    TICKS = (YEAR / Real.of(RUN)).floor + 1
    /* with every body: the Sun held and every planet pulling every other, each speed found on that run (Aggregate.launches) */
    MASSES := [SUN].concat(PLANETS.map(i => pulse(i) * Real.of(ways(i))))
    FARS := [0].concat(PLANETS.map(i => cells(AX[i] * (1 + EC[i]))))
    NEARS := [0].concat(PLANETS.map(i => cells(AX[i] * (1 - EC[i]))))
    SPEEDS := LAW.launches(MASSES, FARS, NEARS, true, 3)
    p.found = PLANETS.map(i => {
      k := PLANETS.index_of(i) + 1
      [FARS[k], SPEEDS[k], LAW.pull(SUN, FARS[k]), SPEEDS[k] > 0 ? 1 : 0, NEARS[k]]
    })
    p.VIEW = VIEW
    p.MARGIN = MARGIN
    p.A = ANGLES
    p.K = PER_C
    p.PIX = PER_C
    p.TICKS = TICKS
    p.RUN = RUN
    p.BURN = BURN
    p.tags = 2 + PLANETS.length
    p.bodies = 1 + PLANETS.length
    p.GAP = 2 * VIEW
    p.stamp = "{stamp}/{TICKS}"
    /* each planet in the colour it is seen in - its ring and its field both */
    p.colours = PLANETS.map(i => COLOUR[NAMES[i]] ?? "#eef0f5")
    p.ring = (k: N): String => k == 0 ? "#f0b429" : (COLOUR[NAMES[PLANETS[k - 1]]] ?? "#eef0f5")
    Panel.of(p)
  }

  theorem "vacuum.equation" () => Asked(asks: "every rule of the theory is a term, and every rule touches two things - the population and the space. What ARE the continuous equations, counted off the rules?", about: "")
  theorem "vacuum.at" () => Asked(asks: "a source is a thing with a history. What does it mean to read one at a particular time?", about: "l'_{{@t}}")
  theorem "vacuum.following" () => Asked(asks: "a difference taken following something - what does one step of the lattice come to, and what is followed?", about: "\\Delta_{{v}}f")
  theorem "vacuum.lean" () => Asked(asks: "the record bends a heading. Along what, and how fast?", about: "a")
  theorem "vacuum.balance" () => Asked(asks: "the vacuum makes and takes at once. What does the difference come to at a local, and which way does it push?", about: "l.balance")
  theorem "vacuum.settled" () => Asked(asks: "and where the vacuum has settled, so that the near-field terms do not matter - what is left of the line?", about: "\\Delta_{{\\hat{{d}}}}\\rho_{{l}} + a·\\nabla S_{{l}} \\aside{{at}} \\rho_{{\\infty}}", also: "\\Delta_{{t}}S_{{l}} \\aside{{at}} \\rho_{{\\infty}}", leads: "THE FAR FIELD: streaming plus bending equals the mass standing here. The vacuum's own balance is gone from the line, because at the settled density the making pays for the taking exactly.", then: "AND THE RECORD THERE: creation clears whatever stands above the settled record at its own rate, so far from every body what stands above it is what the masses sent.")
  theorem "vacuum.worth" () => Asked(asks: "the equation is written against a record S. What IS that, at a local - and where does it come from?", about: "S_{{l}} \\aside{{rays' worth}}")
  theorem "vacuum.record" () => Asked(asks: "the record every mass leaves at a local, in rays' worth - what writes it, what clears it, and what does it come to far from every body?", about: "\\Delta_{{t}}S_{{l}}", also: "S_{{l}}", leads: "THE RECORD'S OWN LINE - written by the meetings, cleared by creation at its own rate times how much there is to clear. This is what the record does at any local, near a body or far, and it is exact.", then: "AND WHAT IT SETTLES TO FAR FROM EVERY BODY, where the vacuum along every path is the settled one: the sum over the locals of what every mass sent here, each read at its own time. Inside a free path of a body the line above has to be run instead.")
  theorem "gravity.bent" () => Asked(asks: "the record's slope turns the vacuum's own rays toward a mass. Read off the settled line, what does that bending add to what a body feels - and does it reach far?", about: "g \\aside{{bent}}", also: "a·\\nabla S_{{l}}")
  theorem "gravity.standing" () => Asked(asks: "the record above DEG is cleared at the share of dark ways, and a body's rays take that share away. What record stands against the density here, and what pull is its slope - where does the lattice stand in it?", about: "g \\aside{{at}} \\rho_{{\\infty}}", also: "S_{{l}} \\aside{{standing}}")
  theorem "gravity.coincidence" () => Asked(asks: "the scale a rotation curve turns over at and the rate the world expands at are both rates of the one vacuum. What is their ratio - and which lattice puts it where it is measured?", about: "\\frac{{a_{{0}}}}{{cH}}")
  theorem "vacuum.occupancy" () => Asked(asks: "the vacuum makes and takes at once. Left alone, where does it settle - and is that a number the rules fix, or one somebody chose?", about: "\\rho_{{\\infty}}")
  theorem "force.range" () => Asked(asks: "a carrier is destroyed when it meets something. How far does ONE of them get before that happens?", about: "\\lambda")
  theorem "transport.speed" () => Asked(asks: "MOVEMENT says a ray goes one cell a tick, and then says what happens when there is no cell. How fast does a carrier actually go?", about: "v")
  theorem "transport.thinning" () => Asked(asks: "a medium carries something outward from a source, and its carriers may have to make the room they cross. How thick is it at r steps?", about: "n")
  theorem "gravity.falloff" () => Asked(asks: "a shortfall spreads out from a body. How does what reaches a distance depend on that distance, and on what else?", about: "\\delta screened")
  theorem "gravity.reach" () => Asked(asks: "every body in the world is casting a shortfall everywhere. Adding up what all of them put on you, is there a total?", about: "the ambient field")
  theorem "gravity.horizon" () => Asked(asks: "the shortfall grows without limit as a body is approached, and a point has only so many exits to be missing. What happens where the two meet?", about: "S at the horizon")
  theorem "gravity.index" () => Asked(asks: "one term of the line swings a heading. What refractive index is that, and what does it come to at a distance from a body?", about: "N in r")
  theorem "gravity.bending" () => Asked(asks: "light crossing a body's field is turned by it. How far, and is that the Newtonian answer or twice it?", about: "\\alpha")
  theorem "vacuum.facing" () => Asked(asks: "a meeting is with what is coming the OTHER way. What does that come to in a vacuum with no bias in it?", about: "F")
  theorem "gravity.motion" () => Asked(asks: "a body gets one action a tick and can move or shine, not both. What does that do to the pull between two of them?", about: "how motion moves it")
  theorem "gravity.suppression" () => Asked(asks: "every cell of a body prevents an expansion. Does the pull go as its bulk or as its surface - and does anything in these rules decide?", about: "what a body puts into the medium")
  theorem "gravity.absorbing" () => Asked(asks: "a body sitting in a field is a region rather than a point. How much of what is there does it actually receive?", about: "what a body is open to")
  theorem "vacuum.crowding" () => Asked(asks: "the settled density solves the making against the taking WITH NOTHING IN IT. What does the same balance give where a body's own carriers are also being met?", about: "\\rho at R")
  theorem "gravity.arrivals" () => Asked(asks: "what does a body actually have DELIVERED to it - rays absorbed and meetings had?", about: "g_{{N}} in bodies and transport")
  theorem "gravity.full" () => Asked(asks: "put the pieces together. What is the gravitational force between two bodies R apart, with every factor written in?", about: "F_{{g}} as one equation in full", also: "F_{{g}} in full", leads: "\"RECURSIVE — g stands on both sides, because the mismatch is measured against \" + \"the acceleration it produces. This is the form the rules give and it is exact.\"", then: "\"NOT RECURSIVE — the same law solved for g, with nothing on the right that is \" + \"not already known. Every name in it is written once. It loses precision where the field \" + \"is strong, so it is what a reader gets and never what a number is evaluated from.\"")
  theorem "space.recession" () => Asked(asks: "the vacuum makes space wherever it is idle. What does that do to two things sitting some distance apart?", about: "recession")
  theorem "gravity.expansion" () => Asked(asks: "a body makes less space where it sits. What does that do to how fast two of them are carried apart - and is THAT the attraction?", about: "the deficit in recession")
  theorem "gravity.sign" () => Asked(asks: "two channels could in principle oppose. Can anything a body does make this law push rather than pull - a second body moving away, for instance?", about: "the sign of the force")
  theorem "rotation.curve" () => Asked(asks: "a body goes round at a radius. What speed does the circle need - and what decides whether that speed falls off or does not?", about: "v^{{2}} as one equation in full", also: "v^{{2}} in full", leads: "\"RECURSIVE — g stands on both sides, because the mismatch is measured against \" + \"the acceleration it produces. This is the form the rules give and it is exact.\"", then: "\"NOT RECURSIVE — the same law solved for g, with nothing on the right that is \" + \"not already known. Every name in it is written once. It loses precision where the field \" + \"is strong, so it is what a reader gets and never what a number is evaluated from.\"")
  theorem "galaxy.point" () => Asked(asks: "a galaxy taken as ONE source, the whole of its mass presenting one face. What does it send, and what curve does that give?", about: "v^{{2}} with the mass gathered as one equation in bodies and transport", also: "v^{{2}} with the mass gathered in bodies and transport", leads: "\"RECURSIVE — g stands on both sides, because the mismatch is measured against \" + \"the acceleration it produces. This is the form the rules give and it is exact.\"", then: "\"NOT RECURSIVE — the same law solved for g, with nothing on the right that is \" + \"not already known. Every name in it is written once. It loses precision where the field \" + \"is strong, so it is what a reader gets and never what a number is evaluated from.\"")
  theorem "galaxy.many" () => Asked(asks: "and the same galaxy taken as its stars, each thin enough to send all of itself. Why is that not the same answer?", about: "v^{{2}} with the mass scattered as one equation in bodies and transport", also: "v^{{2}} with the mass scattered in bodies and transport", leads: "\"RECURSIVE — g stands on both sides, because the mismatch is measured against \" + \"the acceleration it produces. This is the form the rules give and it is exact.\"", then: "\"NOT RECURSIVE — the same law solved for g, with nothing on the right that is \" + \"not already known. Every name in it is written once. It loses precision where the field \" + \"is strong, so it is what a reader gets and never what a number is evaluated from.\"")
  theorem "rotation.keplerian" () => Asked(asks: "where what arrives is far above the scale, what does the curve do?", about: "v^{{2}} where the arrival dominates in full")
  theorem "rotation.flat" () => Asked(asks: "and where the scale is far above what arrives - why does the radius drop out?", about: "v^{{2}} where the scale dominates in full")
  theorem "gravity.newton" () => Asked(asks: "the law is written with the dimension as a symbol. Put three in - what is the force between two bodies in the world we live in?", about: "F_{{g}} at D = 3 as one equation", also: "F_{{g}} at D = 3", leads: "TWO MASSES OVER THE SQUARE OF WHAT SEPARATES THEM, which is Newton's, and is not put in anywhere - the front is a count of the places three-dimensional space has at a distance. Everything the model says is in the bracket: two transports, one for each route between the bodies, and the recursion, which is the mismatch measured against the acceleration it produces. This is the form the rules give and it is exact.", then: "\"NOT RECURSIVE — the same law solved for g, with nothing on the right that is \" + \"not already known. Every name in it is written once. It loses precision where the field \" + \"is strong, so it is what a reader gets and never what a number is evaluated from.\"")
  theorem "lattice.counting" () => Asked(asks: "a body has a size, so the same counting that says how far away something is has to say how big it is. What are the two counts?", about: "l.ball\\paren{{\\bar{{R}}}}.count")
  theorem "gravity.mass" () => Asked(asks: "a source says how often it announces itself and how big it is, and nothing else. What is it worth, per unit of the face it announces through, to everything around it?", about: "\\bar{{m}}\\paren{{\\bar{{R}}}}")
  theorem "gravity.saturation" () => Asked(asks: "and for a body far bigger than the distance one of its rays gets - what is left of that once its own depth has stopped mattering, as R goes to infinity?", about: "\\bar{{m}}", chain: "\\bar{{m}} solved")
  theorem "gravity.doppler" () => Asked(asks: "a body that is going somewhere shines on fewer of its ticks, and what it does send arrives closer together ahead of it than behind. What is that worth?", about: "\\mathcal{{D}}")
  theorem "transport.screened" () => Asked(asks: "a shortfall spreads out from a body and is damped as it goes. With the two bodies and the shell they share divided out, what is left of the journey?", about: "T_{{vac}} at D = 3")
  theorem "transport.exchange" () => Asked(asks: "and the other route, which needs both bodies to be shining rather than one to be open - what does that carry, once the same two things are divided out?", about: "T_{{met}} at D = 3")
  theorem "gravity.schwarzschild" () => Asked(asks: "the metric this model derives has Schwarzschild's shape. Written in Schwarzschild's own names, what is it - and where do the two theories actually part?", about: "A in r as GR writes it", also: "A in r", leads: "AS GENERAL RELATIVITY WRITES IT — and it is the whole function rather than an expansion of one, so light bends by twice the Newtonian amount, a clock runs slow by what a ruler is stretched by, and the perihelion advances by 3πr_s/a. Every classical test reads the metric, and every one of them comes out as Einstein gives it.", then: "AND THE SAME THING AS THIS MODEL DERIVES IT — the record a body adds to what a ray crosses. Reading the two against each other says the blocking mass IS the Schwarzschild radius, in cells. THE DEVIATION IS NOT HERE: it is that general relativity has the metric and the force as ONE object, and this has them as two derivations sourced by two different masses - and that the force carries a recursion the metric knows nothing of.")
  theorem "gravity.gauss" () => Asked(asks: "general relativity has a flux law behind it. Do these rules give one, and is it the same one?", about: "the flux through any shell")
  theorem "gravity.potential" () => Asked(asks: "and the potential that flux implies - is it the one general relativity uses?", about: "\\Phi")
  theorem "gravity.poisson" () => Asked(asks: "Poisson's equation is the weak field limit of Einstein's. Do these rules give it?", about: "\\nabla^{{2}}\\Phi")
  theorem "gravity.geodesic" () => Asked(asks: "general relativity moves a body along a geodesic of the metric. These rules hand it the momentum of what arrives. Do the two come to the same equation of motion?", about: "the equation of motion")
  theorem "gravity.field" () => Asked(asks: "Einstein's equation relates the curvature to the source. Do these rules give that relation, and with what coupling?", about: "the field equation")
  theorem "gravity.coupling" () => Asked(asks: "Einstein's field equation has one number in front of the source. What does this model put there instead?", about: "\\kappa")
  theorem "gravity.einstein" () => Asked(asks: "and the metric in terms of that potential - does it come out as general relativity writes it?", about: "A, off the record a ray crosses")
  theorem "gravity.deflection" () => Asked(asks: "the metric bends light. Written in the mass the force law fixes, by how much - and does it agree with what was measured?", about: "the deflection this model gives", also: "the deflection, as general relativity gives it", leads: "WHAT THIS MODEL GIVES — light follows the index and the index is the metric, so a metric short by two bends light by half as much. This is Newton's value.", then: "AND WHAT GENERAL RELATIVITY GIVES, which is what was measured in 1919 and since. This is the one place the difference is observable rather than absorbed into what a unit of mass means.")
  theorem "gravity.metric" () => Asked(asks: "light goes at one over the index. What metric is the medium, then?", about: "A in r")
  theorem "gravity.shadow" () => Asked(asks: "the metric decides which rays a body keeps. How wide is the shadow it casts - and is that general relativity's?", about: "b_{{c}}")

  rule /S.2 "Attenuation" () => {
    // TODO Define possible configurations for the theory to absorb, or to let through the rays as if the point is just a spherical area.
  }

  /* a body carries the momentum the vacuum gives it, and crosses a cell when it has earned one */
  rule /S.v "Transport" (x: Source{moves}) => {
    /*
     * where the point it stands on is going, it goes - and KEEPS going: a point folded into a hub is in that hub, and
     * what stands on it with it, every tick, stepping or not; and as a ray carried onto a folded way is headed where
     * it was carried (`turns`), so is a body: the carry is kept, as motion. That is the acceleration - what the
     * folding of its own point hands it a tick - and it can never pass c-bar, since a step is one decision a tick
     */
    x.momentum = x.momentum + x.cells.first.sinks * x.mass
    x.momentum = x.momentum.unit * x.mass if x.momentum.norm > x.mass
    x.advance = x.advance + x.momentum * (Real.ONE / x.mass)

    g := x.world.geometry
    d := Array.range(g.DEG).most(e => x.advance.along(g.V(e)))[1]
    if x.advance.along(g.V(d)) >= g.steps(d) {
      /* the step lands where the way leads: on the point across, or in the hub that point was folded into (`outward`) */
      there := x.ahead(d)

      /* room ahead: no other body's space - its own is its own */
      if there.every(v => v != None) & there.every(v => v.vacuum | v.source == x) {
        x.cells.for(c => { c.source = None })
        x.cells = there
        x.cells.for(c => { c.source = x })
        x.advance = x.advance - g.V(d) * g.steps(d)
        /*
         * and where the point it stands on has gone, the body has gone: across space it swallowed itself it goes THROUGH,
         * a step further on; onto space another hub swallowed it goes into that hub. As a ray is: not given anything,
         * carried where the folds lead, and HEADED where it was carried - a ray turned onto a folded way takes that
         * way's heading. So a body keeps what it carries in size, gets further through its own space, and what it
         * carries turns toward where its landing went
         */
        lean := x.cells.first.drift(d)
        x.advance = x.advance + lean
        x.momentum = (x.momentum.unit + lean).unit * x.momentum.norm
        x.stepped = true
        x.moved_along = d
      }
    }
  }
}
