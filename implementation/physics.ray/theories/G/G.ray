/*
 * G - the discrete theory. Five rules of the vacuum and three of what was put into it, in the
 * order they fire. A match belongs to the first rule that takes it; c̄ is one step a tick, by
 * definition, and nothing here says otherwise.
 */

Edge += {
  /* two rays that meet on the edge between two points annihilate, leaving one neutral point */
  ANNIHILATE () => {
    this.initial.ray.deactivate
    this.terminal.ray.deactivate
    here := this.initial.vertex
    there := this.terminal.vertex
    here.world.annihilations = here.world.annihilations + 1
    /* credited half to each end of the edge the event happened on: the deficit belongs to the edge */
    here.destroyed = here.destroyed + 0.5
    there.destroyed = there.destroyed + 0.5
    here.fold(there)
  }
}

Vertex += {
  /* a neutral point is handed back a point of space, and every exit it has is lit */
  CREATE () => {
    this.unfold
    this.rays.each.activate
    this.world.created = this.world.created + 1
  }
}

Ray += {
  /* every active ray moves one step along its own exit, turned by what is folded here */
  MOVE () => {
    to := this.turns
    if to == None {
      /* nowhere to step: on an expanding world it makes the room and waits a tick */
      this.leaving.grow
      this.hand(this)
      return
    }
    this.hand(to)
  }

  /* what was arriving is now what is here */
  SETTLE () => this.settle
}

G: Theory = class {
  name = "G"

  rule /1 "Annihilation" (x: 1 Edge{active}) => x.ANNIHILATE
  rule /2 "Creation" (x: Ray{neutral}) => x.vertex.CREATE
  rule /c "Movement" (x: Ray{active}) => x.MOVE
  rule /4 "Arrival" (x: Ray) => x.SETTLE

  /*
   * a source absorbs what arrived and writes its own charge onto the space around it. What it
   * lights is the NEIGHBOUR's ray on the same heading, so a body cannot catch its own light.
   */
  rule /S.1 "Emission" (x: 1 Boundary{emits & vertex.source.spare}) => {
    s := x.vertex.source

    if x.ray.active {
      s.momentum = s.momentum + x.ray.along
      x.ray.deactivate
    }

    out := x.ray.steps
    if out != None {
      out.activate
      s.momentum = s.momentum - x.ray.along
    }
  }

  /*
   * the vacuum alone in a square-8 box that does not grow: every point painted by what has been
   * destroyed at it, and how many rays stand on it - the deficit that gravity is read off, as it
   * appears. (A box that grows triples every tick: every lit ray at the frontier makes a point.)
   */
  visual "vacuum.square-8" () => {
    w := G.seed(SQUARE8, 24, 1)
    w.expands = false
    film(w, 120, 512, 512,
      w => w.vertices.filter(v => v.alive).map(v => [v.at.components[0], v.at.components[1], Real.of(v.rays.filter(r => r.active).length) / Real.of(8), v.destroyed]))
  }

  rule /S.2 "Attenuation" () => {
    // TODO Define possible configurations for the theory to absorb, or to let through the rays as if the point is just a spherical area.
  }

  /* a body carries the momentum the vacuum gives it, and crosses a cell when it has earned one */
  rule /S.v "Transport" (x: Source{moves}) => {
    x.advance = x.advance + x.momentum * (Real.ONE / x.mass)

    g := x.world.geometry
    d := Array.range(g.DEG).most(e => x.advance.along(g.V(e)))[1]
    if x.advance.along(g.V(d)) >= g.steps(d) {
      there := x.ahead(d)

      if there.every(v => v != None) & there.every(v => v.vacuum) {
        x.cells.for(c => { c.source = None })
        x.cells = there
        x.cells.for(c => { c.source = x })
        x.advance = x.advance - g.V(d) * g.steps(d)
        x.stepped = true
        x.moved_along = d
      }
    }
  }
}
