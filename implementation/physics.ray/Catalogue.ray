/*
 * THE BORROWED CATALOGUES - fetched from the people who measured them, and written as columns.
 *
 * A borrowed number should carry its provenance the way a derived one carries its rule. So nothing
 * here is typed: each catalogue is downloaded from the address its authors publish it at, parsed by
 * the format description the file itself carries, and written to `data/<id>/field.f32` (columns of
 * Float32) with `meta.json` beside it (what it holds, where it came from, its units, its names).
 * `npx ray data` runs every `data "id" () => Catalogue(...)` of `Borrowed`.
 *
 * The host does only what needs the network, a PDF reader, a binary file or a number parser
 * (`fetch`, `pdf_text`, `save_f32`, `number`, `numbers` - bodyless here, fulfilled by the CLI).
 * What a column MEANS is decided in this file.
 */

/* a `data "id" () => ...` declaration: the catalogue, when asked for */
Dataset := class < id: String, body: Program { }

Column := class < name: String, values: Real[] { }

Catalogue := class < id: String, what: String, source: String, paper: String {
  units: String[] = []
  names: String[] = []
  columns: Column[] = []

  static fetch (url: String, as: String): String
  static pdf_text (as: String): String
  /* a paper's own LaTeX off arXiv (its source unpacked under data/.raw/<as>/, every .tex joined) */
  static arxiv_tex (id: String, as: String): String
  static fits (url: String, as: String): Real[]
  static save_f32 (path: String, values: Real[])
  static number (text: String): Real?
  static numbers (text: String): Real[]

  column (name: String, values: Real[]) => { this.columns.push(Column(name: name, values: values)) }
  rows (): N => this.columns.empty ? 0 : this.columns.first.values.length

  /* the record: columns as one run of floats, and the header as JSON */
  write () => {
    rows := this.rows
    this.columns.for(c => { fail("{this.id}: column {c.name} has {c.values.length} rows, not {rows}") if c.values.length != rows })
    all := []
    this.columns.for(c => { c.values.for(v => { all.push(v) }) })
    Catalogue.save_f32("data/{this.id}/field.f32", all)
    sep := ", "
    units := this.units.map(u => u.quoted).join(sep)
    names := this.names.map(n => n.quoted).join(sep)
    columns := this.columns.map(c => c.name.quoted).join(sep)
    @./data/{this.id}/meta.json := "{{\n  \"what\": {this.what.quoted},\n  \"source\": {this.source.quoted},\n  \"paper\": {this.paper.quoted},\n  \"units\": [{units}],\n  \"names\": [{names}],\n  \"columns\": [{columns}],\n  \"rows\": {rows}\n}}\n"
  }
}

/* one field of a machine-readable table's byte-by-byte description */
MrtField := class < kind: String, label: String { }

/* the machine-readable table format (CDS/AAS), read out of the description the file carries */
Mrt := class < text: String {
  parsed: MrtField[]? = None
  lines (): String[] => {
    cr := String(chars: [13])
    this.text.replace(cr, "").lines
  }
  static is_rule (l: String): boolean => {
    t := l.trim
    t.length >= 20 & t.chars.every(c => c == 45)
  }
  static is_range (t: String): boolean => !t.empty & t.chars.every(c => (c >= 48 & c <= 57) | c == 45)
  static is_kind (t: String): boolean => !t.empty & Notation.is_letter(t.chars[0]) & t.chars[0] < 97 & t.chars.rest.every(c => (c >= 48 & c <= 57) | c == 46)
  static words (l: String): String[] => l.split(" ").filter(w => !w.empty).map(w => w.trim).filter(w => !w.empty)

  /* the fields, in order: `  1- 11 A11  ---  Galaxy  ...`, and a single-byte column writes just `  99 I3 ...` */
  fields (): MrtField[] => {
    this.parsed = this.read_fields if this.parsed == None
    this.parsed
  }
  read_fields (): MrtField[] => {
    lines := this.lines
    rules := []
    Array.range(lines.length).for(i => { rules.push(i) if Mrt.is_rule(lines[i]) })
    heading := None
    Array.range(lines.length).for(i => {
      l := lines[i]
      heading = i if heading == None & l.contains("Bytes") & l.contains("Format") & l.contains("Units") & l.contains("Label")
    })
    fail("no byte-by-byte description in this file") if heading == None | rules.length < 2
    ends := rules.filter(r => r > heading + 1).first ?? lines.length
    out := []
    i := heading + 1
    while i < ends {
      ws := Mrt.words(lines[i])
      k := 0
      while k < ws.length & Mrt.is_range(ws[k]) { k = k + 1 }
      out.push(MrtField(kind: ws[k], label: ws[k + 2])) if k > 0 & k + 2 < ws.length & Mrt.is_kind(ws[k])
      i = i + 1
    }
    out
  }

  /* the rows, after the last rule: whitespace-separated cells, one per field */
  rows (): String[][] => {
    lines := this.lines
    last := 0
    Array.range(lines.length).for(i => { last = i if Mrt.is_rule(lines[i]) })
    count := this.fields.length
    out := []
    lines.drop(last + 1).filter(l => !l.trim.empty).for(l => {
      cells := Mrt.words(l)
      fail("row has {cells.length} values, the description declares {count} columns - this file needs reading by its byte offsets") if cells.length != count
      out.push(cells)
    })
    out
  }
  of (label: String): N => {
    fs := this.fields
    i := None
    Array.range(fs.length).for(k => { i = k if i == None & fs[k].label == label })
    fail("no column called {label} - the format has moved") if i == None
    i
  }
  at (row: String[], label: String): String => row[this.of(label)]
  num (row: String[], label: String): Real => Catalogue.number(row[this.of(label)]) ?? 0
}

/* a number off a Horizons physical page, whatever punctuation the label carries */
Horizons := class {
  static quoted (text: String, label: String): Real => {
    l := label.lower
    found := None
    text.lines.for(line => {
      t := line.trim.lower
      if found == None & t.starts_with(l) & t.contains("=") {
        next := t.chars[l.length]
        found = Catalogue.numbers(t.split("=")[1]).first if next == 44 | next == 40 | next == 32
      }
    })
    fail("Horizons page has no {label}") if found == None
    found
  }
  /* `A = 1.0E+00`-style element out of the $$SOE .. $$EOE block */
  static element (block: String, key: String): Real => {
    words := block.replace("=", " = ").split(" ").filter(w => !w.empty)
    i := 0
    while i + 2 < words.length {
      return Catalogue.numbers(words[i + 2]).first if words[i] == key & words[i + 1] == "="
      i = i + 1
    }
    fail("no {key} in the elements block")
  }
}

Borrowed := class {
  static SPARC = "https://astroweb.cwru.edu/SPARC"
  static HORIZONS = "https://ssd.jpl.nasa.gov/api/horizons.api"
  static GENZEL = "https://arxiv.org/pdf/1703.04310"

  /* SPARC table 1 - the sample, one row per galaxy */
  static galaxies (): Mrt => Mrt(text: Catalogue.fetch("{Borrowed.SPARC}/SPARC_Lelli2016c.mrt", "SPARC_Lelli2016c.mrt"))
  static galaxy_names (): String[] => { t := Borrowed.galaxies; t.rows.map(r => t.at(r, "Galaxy")) }

  data "sparc-galaxies" () => {
    t := Borrowed.galaxies
    rows := t.rows
    c := Catalogue(id: "sparc-galaxies", what: "SPARC table 1 - the sample, one row per galaxy", source: "{Borrowed.SPARC}/SPARC_Lelli2016c.mrt", paper: "Lelli, McGaugh & Schombert 2016, AJ 152:157")
    c.units = ["T: Hubble type", "D: Mpc", "Inc: deg", "L[3.6]: 1e9 Lsun", "Reff: kpc", "SBeff: Lsun/pc2", "Rdisk: kpc", "SBdisk: Lsun/pc2", "MHI: 1e9 Msun", "RHI: kpc", "Vflat: km/s, 0 where the curve never flattens", "Q: quality flag, 1 high .. 3 low"]
    c.names = rows.map(r => t.at(r, "Galaxy"))
    ["T", "D", "e_D", "f_D", "Inc", "e_Inc", "L[3.6]", "e_L[3.6]", "Reff", "SBeff", "Rdisk", "SBdisk", "MHI", "RHI", "Vflat", "e_Vflat", "Q"].for(w => { c.column(w, rows.map(r => t.num(r, w))) })
    c
  }

  /* SPARC table 2 - the mass models, one row per measured radius */
  data "sparc-curves" () => {
    names := Borrowed.galaxy_names
    t := Mrt(text: Catalogue.fetch("{Borrowed.SPARC}/MassModels_Lelli2016c.mrt", "MassModels_Lelli2016c.mrt"))
    rows := t.rows
    c := Catalogue(id: "sparc-curves", what: "SPARC table 2 - the mass models, one row per measured radius", source: "{Borrowed.SPARC}/MassModels_Lelli2016c.mrt", paper: "Lelli, McGaugh & Schombert 2016, AJ 152:157")
    c.units = ["galaxy: row in sparc-galaxies", "D: Mpc", "R: kpc", "Vobs: km/s", "Vgas: km/s, already carrying the 1.33 for helium", "Vdisk: km/s at M/L = 1", "Vbul: km/s at M/L = 1", "SBdisk: Lsun/pc2", "SBbul: Lsun/pc2"]
    c.column("galaxy", rows.map(r => {
      id := t.at(r, "ID")
      g := names.index_of(id)
      fail("mass models mention {id}, table 1 does not") if g == None
      g
    }))
    ["D", "R", "Vobs", "e_Vobs", "Vgas", "Vdisk", "Vbul", "SBdisk", "SBbul"].for(w => { c.column(w, rows.map(r => t.num(r, w))) })
    c
  }

  /*
   * WHAT EACH GALAXY LOOKS LIKE: its light at 3.6 microns - the old stars SPARC's own disc masses are read off -
   * cut out around it by the CDS's hips2fits (the name resolved by Sesame), from S4G where S4G has it, else Spitzer's
   * IRAC 1, else unWISE W1 at 3.4 microns. IMAGE pixels a side, wide enough to hold REACH times its outermost measured
   * radius. And which way it lies on the sky: SIMBAD's position angle, where SIMBAD has one
   */
  static HIPS = "https://alasky.cds.unistra.fr/hips-image-services/hips2fits"
  static SIMBAD_TAP = "https://simbad.cds.unistra.fr/simbad/sim-tap/sync"
  static SURVEYS = ["ov-gso/P/S4G/irac1", "CDS/P/SPITZER/IRAC1", "CDS/P/unWISE/W1"]
  static SURVEY_NAMES = ["S4G 3.6um", "Spitzer IRAC1 3.6um", "unWISE W1 3.4um"]
  static IMAGE = 128
  static REACH = 1.3
  static CACHE = { }
  /* a name as SIMBAD writes it: the catalogue's letters, a space, and the number without its leading noughts */
  static simbad_name (name: String): String => {
    cs := name.chars
    k := 0
    while k < cs.length & ((cs[k] >= 65 & cs[k] <= 90) | (cs[k] >= 97 & cs[k] <= 122)) { k = k + 1 }
    return name if k == 0 | k >= cs.length
    m := k
    while m < cs.length - 1 & cs[m] == 48 & cs[m + 1] >= 48 & cs[m + 1] <= 57 { m = m + 1 }
    "{String(chars: cs.take(k))} {String(chars: cs.drop(m))}"
  }
  static squeezed (s: String): String => s.replace(" ", "").replace("\"", "").upper
  static url_encoded (s: String): String => s.replace("%", "%25").replace(" ", "%20").replace("'", "%27").replace(",", "%2C").replace("(", "%28").replace(")", "%29").replace("=", "%3D").replace("/", "%2F").replace("+", "%2B").replace("[", "%5B").replace("]", "%5D")
  /* SIMBAD's position angles for every galaxy it knows by the name SPARC gives, degrees east of north; NaN where it has none */
  static angles (): Real[] => {
    return Borrowed.CACHE["angles"] if Borrowed.CACHE["angles"] != None
    names := Borrowed.galaxy_names
    quote := "'"
    listed := names.map(n => "{quote}{Borrowed.simbad_name(n)}{quote}").join(",")
    query := "SELECT ident.id, basic.galdim_angle FROM basic JOIN ident ON oid = oidref WHERE ident.id IN ({listed})"
    text := Catalogue.fetch("{Borrowed.SIMBAD_TAP}?request=doQuery&lang=adql&format=csv&query={Borrowed.url_encoded(query)}", "simbad-angles.csv")
    found := { }
    text.lines.drop(1).for(l => {
      parts := l.split(",")
      if parts.length >= 2 {
        v := Catalogue.number(parts[1])
        found[Borrowed.squeezed(parts[0])] = v if v != None
      }
    })
    out := names.map(n => found[Borrowed.squeezed(Borrowed.simbad_name(n))] ?? Real.NAN)
    Borrowed.CACHE["angles"] = out
    out
  }
  /* each galaxy's outermost measured radius, kpc */
  static reaches (): Real[] => {
    return Borrowed.CACHE["reaches"] if Borrowed.CACHE["reaches"] != None
    names := Borrowed.galaxy_names
    t := Mrt(text: Catalogue.fetch("{Borrowed.SPARC}/MassModels_Lelli2016c.mrt", "MassModels_Lelli2016c.mrt"))
    most := { }
    t.rows.for(r => {
      id := t.at(r, "ID")
      most[id] = Fmt.max(most[id] ?? 0, t.num(r, "R"))
    })
    out := names.map(n => most[n] ?? 0)
    Borrowed.CACHE["reaches"] = out
    out
  }
  /* the cut-outs: [survey index or -1, the field of view in degrees, then the pixels], one a galaxy */
  static images (): Array => {
    return Borrowed.CACHE["images"] if Borrowed.CACHE["images"] != None
    t := Borrowed.galaxies
    names := Borrowed.galaxy_names
    reaches := Borrowed.reaches
    P := Borrowed.IMAGE
    out := []
    Array.range(names.length).for(g => {
      D := t.num(t.rows[g], "D")
      fov := 2 * Borrowed.REACH * reaches[g] / (D * 1000) * 180 / Real.PI
      got := None
      which := -1
      Array.range(Borrowed.SURVEYS.length).for(k => {
        if got == None & D > 0 & reaches[g] > 0 {
          url := "{Borrowed.HIPS}?hips={Borrowed.url_encoded(Borrowed.SURVEYS[k])}&width={P}&height={P}&fov={fov}&object={Borrowed.url_encoded(names[g])}&format=fits"
          px := Catalogue.fits(url, "image-{names[g]}-{k}.fits")
          if px.length == P * P + 2 {
            lit := 0
            px.drop(2).for(v => { lit = lit + 1 if Fmt.finite(v) & v != 0 })
            if lit > 0.6 * P * P {
              got = px.drop(2).map(v => Fmt.finite(v) ? v : 0)
              which = k
            }
          }
        }
      })
      out.push([which, fov, got ?? Array.filled(P * P, 0)])
    })
    Borrowed.CACHE["images"] = out
    out
  }
  data "sparc-orientation" () => {
    names := Borrowed.galaxy_names
    c := Catalogue(id: "sparc-orientation", what: "how each SPARC galaxy lies on the sky and which image of it there is", source: "{Borrowed.SIMBAD_TAP} (galdim_angle); {Borrowed.HIPS}", paper: "SIMBAD (Wenger et al. 2000); hips2fits (CDS); S4G (Sheth et al. 2010), SEIP (Spitzer), unWISE (Lang 2014)")
    c.units = ["galaxy: row in sparc-galaxies", "pa: deg east of north, NaN where SIMBAD has none", "fov: deg across the cut-out", "survey: 0 S4G 3.6um, 1 Spitzer IRAC1, 2 unWISE W1, -1 none", "reach: kpc, the outermost measured radius"]
    c.names = names
    images := Borrowed.images
    c.column("galaxy", Array.range(names.length).map(g => g))
    c.column("pa", Borrowed.angles)
    c.column("fov", images.map(im => im[1]))
    c.column("survey", images.map(im => im[0]))
    c.column("reach", Borrowed.reaches)
    c
  }
  data "sparc-images" () => {
    c := Catalogue(id: "sparc-images", what: "each SPARC galaxy's light, north up and east left, IMAGE pixels a side, galaxy after galaxy, rows from the bottom", source: Borrowed.HIPS, paper: "S4G (Sheth et al. 2010), SEIP (Spitzer), unWISE (Lang 2014), cut out by hips2fits (CDS)")
    c.units = ["light: the survey's own units, 0 where there is no image (sparc-orientation says which)"]
    all := []
    Borrowed.images.for(im => { im[2].for(v => { all.push(v) }) })
    c.column("light", all)
    c
  }

  /*
   * WHAT ANDROMEDA LOOKS LIKE, band by band (the film lays its young stars and its dust off these; Video.ray): cut out
   * round M31 by hips2fits, Video.ANDROMEDA_IMAGE pixels a side over Video.ANDROMEDA_FOV degrees, north up and east left, rows from
   * the bottom - its old stars at 3.4 microns (unWISE W1), its young at 1528 Angstrom (GALEX far ultraviolet), its dust
   * at 250 microns (Herschel SPIRE). Seen as we see it, 77 degrees from face on; the film turns it face on
   */
  static ANDROMEDA_BANDS = ["old", "young", "dust"]
  static ANDROMEDA_SURVEYS = ["CDS/P/unWISE/W1", "CDS/P/GALEXGR6_7/FUV", "ESAVO/P/HERSCHEL/SPIRE-250"]
  data "andromeda-images" () => {
    c := Catalogue(id: "andromeda-images", what: "Andromeda (M31) band by band, north up and east left, ANDROMEDA_IMAGE pixels a side over ANDROMEDA_FOV degrees, rows from the bottom", source: Borrowed.HIPS, paper: "unWISE (Lang 2014), GALEX GR6/7 (Bianchi et al. 2017), Herschel SPIRE (Fritz et al. 2012, HELGA), cut out by hips2fits (CDS)")
    P := Video.ANDROMEDA_IMAGE
    c.units = Borrowed.ANDROMEDA_BANDS.map(b => "{b}: the survey's own units, 0 where it does not reach")
    Array.range(Borrowed.ANDROMEDA_SURVEYS.length).for(k => {
      url := "{Borrowed.HIPS}?hips={Borrowed.url_encoded(Borrowed.ANDROMEDA_SURVEYS[k])}&width={P}&height={P}&fov={Video.ANDROMEDA_FOV}&object=M31&format=fits"
      px := Catalogue.fits(url, "image-M31-{Borrowed.ANDROMEDA_BANDS[k]}.fits")
      c.column(Borrowed.ANDROMEDA_BANDS[k], px.length == P * P + 2 ? px.drop(2).map(v => Fmt.finite(v) ? v : 0) : Array.filled(P * P, 0))
    })
    c
  }

  /*
   * THE MILKY WAY AS MEASURED (the film lays it off these; Video.ray `MW_*`), each read out of its paper - the LaTeX
   * source off arXiv where its tables are, the PDF's text otherwise. `Borrowed.after`: the numbers that follow a phrase,
   * failing (naming the paper) when the phrase is not there
   */
  static after (text: String, key: String, paper: String): Real[] => {
    at := text.index_of(key)
    fail("{paper}: no {key.quoted} in it") if at == None
    Catalogue.numbers(text.drop(at + key.length))
  }
  /* the one line holding every phrase */
  static line_with (text: String, keys: String[], paper: String): String => {
    l := text.lines.filter(l => keys.filter(k => !l.contains(k)).empty).first
    fail("{paper}: no line with {keys.map(k => k.quoted).join(", ")}") if l == None
    l
  }
  /* a LaTeX cell's name, its markup gone: $R_{2,\rm out}$ -> R_2,out */
  static bare (cell: String): String => String(chars: cell.chars.filter(c => c != 92 & c != 36 & c != 123 & c != 125 & c != 32)).replace("rm", "")
  static HOU_HAN = "1407.7331"
  static SORMANI = "2204.13114"
  static BLAND_HAWTHORN = "1602.07702"
  static REID = "1910.03357"
  static DRIMMEL = "https://arxiv.org/pdf/astro-ph/0101259"
  static VALLEE = "https://arxiv.org/pdf/1409.4801"

  /* Hou & Han 2014 table 3: the four-arm logarithmic spirals fitted to all three kinds of tracer at R_0 8.3 kpc - its last four-arm row */
  data "milkyway-arms" () => {
    paper := "Hou & Han 2014 (arXiv {Borrowed.HOU_HAN})"
    lines := Catalogue.arxiv_tex(Borrowed.HOU_HAN, "houhan2014").lines
    rows := Array.range(lines.length).filter(i => lines[i].contains("4-arm model&"))
    fail("{paper}: {rows.length} four-arm rows in table 3, four wanted") if rows.length != 4
    head := Array.range(rows[3]).filter(i => lines[i].contains("R_0=8.3") & lines[i].contains("Fitting of models to HII regions")).length
    fail("{paper}: the last four-arm row is not under R_0 8.3") if head != 1
    row := lines[rows[3]]
    rest := row.drop(row.index_of("&"))
    more := lines[rows[3] + 1]
    xs := Catalogue.numbers("{rest} {more}")
    fail("{paper}: the row gave {xs.length} numbers, sixteen wanted") if xs.length < 16
    c := Catalogue(id: "milkyway-arms", what: "the Milky Way's arms as logarithmic spirals, ln(r / R) = (theta - theta_0) tan(psi), theta from the x axis anticlockwise, the Sun on the y axis", source: "https://arxiv.org/abs/{Borrowed.HOU_HAN} (table 3: all three kinds of tracer, R_0 8.3 kpc, four-arm model)", paper: "Hou & Han 2014, A&A 569, A125")
    c.units = ["R: kpc, the arm's initial radius", "theta: degrees, its start azimuth", "psi: degrees, its pitch angle"]
    c.names = ["Norma", "Scutum-Centaurus", "Sagittarius-Carina", "Perseus", "Local"]
    c.column("R", Array.range(5).map(k => xs[3 * k]))
    c.column("theta", Array.range(5).map(k => xs[3 * k + 1]))
    c.column("psi", Array.range(5).map(k => xs[3 * k + 2]))
    c
  }

  /* Sormani et al. 2022 table 1: the analytic bar fitted to Portail et al. 2017's made-to-measure model, and its parts' masses */
  data "milkyway-bar" () => {
    paper := "Sormani et al. 2022 (arXiv {Borrowed.SORMANI})"
    tex := Catalogue.arxiv_tex(Borrowed.SORMANI, "sormani2022")
    body := tex.drop(tex.index_of("Barred component 1") ?? 0)
    body = body.take(body.index_of("end{{tabular}}") ?? body.length)
    names := []
    values := []
    body.lines.filter(l => l.contains("&")).for(l => {
      cells := l.split("&")
      [0, 3].for(k => {
        if cells.length > k + 1 {
          v := Catalogue.numbers(cells[k + 1])
          /* the parts' headings (Barred component 1, ...) are no parameters */
          if !v.empty & !Borrowed.bare(cells[k]).empty & !Borrowed.bare(cells[k]).contains("component") {
            names.push(Borrowed.bare(cells[k]))
            values.push(v.first)
          }
        }
      })
    })
    ["1", "2", "3"].for(i => {
      names.push("M_bar{i}")
      values.push(Borrowed.after(tex, "bar,{i}}}}}=", paper).first)
    })
    /* and how fast the bar turns, in the model it is fitted to (P17's, km/s a kpc) */
    names.push("pattern_speed")
    values.push(Borrowed.after(tex, "P17 model with", paper).first)
    listed := names.join(" ")
    fail("{paper}: {names.length} parameters read, 43 wanted (39 of table 1, 3 masses, the pattern speed): {listed}") if names.length != 43
    c := Catalogue(id: "milkyway-bar", what: "the Milky Way's bar: the parameters of Sormani et al.'s analytic fit (their equations 2-9; its disc's too), by name, M_bar1..3 its three barred parts' masses, and pattern_speed how fast it turns (km/s a kpc)", source: "https://arxiv.org/abs/{Borrowed.SORMANI} (table 1)", paper: "Sormani, Gerhard, Portail, Vasiliev & Clarke 2022, MNRAS 514, L1")
    c.units = ["value: 1e10 suns a kpc^3 for rho_i, kpc for lengths, 1e10 suns for M_bar, else bare"]
    c.names = names
    c.column("value", values)
    c
  }

  /* Bland-Hawthorn & Gerhard 2016, the review's margin values: the discs, the bulge region, how the stars move, the Sun */
  data "milkyway-discs" () => {
    paper := "Bland-Hawthorn & Gerhard 2016 (arXiv {Borrowed.BLAND_HAWTHORN})"
    tex := Catalogue.arxiv_tex(Borrowed.BLAND_HAWTHORN, "blandhawthorn2016")
    /* a margin entry's value, in 1e10 suns where it is a mass (`x 10^{n}`) */
    entry := (says: String): Real => {
      l := Borrowed.line_with(tex, ["entry{{", says], paper)
      v := Borrowed.after(l, "}}{{", paper).first
      l.contains("10^{{") ? v * (10.0).pow(Borrowed.after(l, "10^{{", paper).first - 10) : v
    }
    bulge := Borrowed.after(Borrowed.line_with(tex, ["entry{{", "stellar mass in"], paper), "}}{{", paper)
    spread := Borrowed.after(Borrowed.line_with(tex, ["estimates of", "RsigthinR"], paper), "estimates of", paper)
    c := Catalogue(id: "milkyway-discs", what: "the Milky Way's discs, bulge region and how they move, as the review gives them", source: "https://arxiv.org/abs/{Borrowed.BLAND_HAWTHORN} (margin notes)", paper: "Bland-Hawthorn & Gerhard 2016, ARA&A 54, 529")
    c.units = ["value: 1e10 suns for masses, kpc for lengths, km/s for speeds, degrees for the bar's angle"]
    c.names = ["thin_mass", "thin_scale", "thick_mass", "thick_scale", "bulge_region_mass", "bar_angle", "thin_sigma_R", "thin_sigma_scale", "thick_sigma_R", "thick_sigma_scale", "circling", "sun_tangential", "sun_distance"]
    c.column("value", [entry("thin disk stellar mass"), entry("thin disk radial scalelength"), entry("thick disk stellar mass"), entry("thick disk radial scalelength"), (bulge[0] + bulge[1]) / 2 * (10.0).pow(bulge[2] - 10), entry("b/p bulge bar angle"), entry("old thin disk radial velocity dispersion"), spread[0], entry("thick disk radial velocity dispersion"), spread[1], entry("circular rotation velocity at the Sun"), entry("total tangential velocity"), entry("distance from Galactic Center")])
    c
  }

  /* Reid et al. 2019: how wide the arms are, the Sun's motion towards the middle, and how far the young massive stars stray from circling */
  data "milkyway-arm-widths" () => {
    paper := "Reid et al. 2019 (arXiv {Borrowed.REID})"
    tex := Catalogue.arxiv_tex(Borrowed.REID, "reid2019")
    w := Borrowed.after(tex, "widen with Galactocentric radius as", paper)
    sun := Catalogue.numbers(Borrowed.line_with(tex, ["W = ", "and for the average"], paper))
    stray := Catalogue.numbers(Borrowed.line_with(tex, ["for the masing stars of"], paper))
    c := Catalogue(id: "milkyway-arm-widths", what: "the arms' width w(R) = w0 + slope (R - R0) (Gaussian 1 sigma across), the Sun's motion towards the Galactic middle U, and the young massive stars' spread about circling", source: "https://arxiv.org/abs/{Borrowed.REID}", paper: "Reid et al. 2019, ApJ 885, 131")
    c.units = ["value: pc for w0, pc a kpc for slope, kpc for R0, km/s for U_sun and young_spread"]
    c.names = ["w0", "slope", "R0", "U_sun", "young_spread"]
    c.column("value", [w[0], w[1], w[2], sun[0], stray[1]])
    c
  }

  /* Drimmel & Spergel 2001: the arm over between-arm ratio of the old stars' near-infrared light, K band */
  data "milkyway-arm-contrast" () => {
    paper := "Drimmel & Spergel 2001"
    Catalogue.fetch(Borrowed.DRIMMEL, "drimmel2001.pdf")
    l := Borrowed.line_with(Catalogue.pdf_text("drimmel2001.pdf"), ["for J and K respectively"], paper)
    xs := Catalogue.numbers(l.take(l.index_of("for J and K respectively")))
    c := Catalogue(id: "milkyway-arm-contrast", what: "the old stars' arm over between-arm ratio in near-infrared surface brightness, J and K", source: Borrowed.DRIMMEL, paper: "Drimmel & Spergel 2001, ApJ 556, 181")
    c.units = ["value: ratio"]
    c.names = ["J", "K"]
    c.column("value", xs.drop(xs.length - 2))
    c
  }

  /* Vallee 2014: across an arm, how far inside its middle (the CO) the hot dust lane lies */
  data "milkyway-dust-lane" () => {
    paper := "Vallee 2014"
    Catalogue.fetch(Borrowed.VALLEE, "vallee2014.pdf")
    hot := Borrowed.after(Catalogue.pdf_text("vallee2014.pdf"), "the hot dust at", paper).first
    cold := Borrowed.after(Catalogue.pdf_text("vallee2014.pdf"), "the cold dust at", paper).first
    c := Catalogue(id: "milkyway-dust-lane", what: "an arm's dust lanes, inside its middle (the CO): the hot dust (the inner edge) and the cold", source: Borrowed.VALLEE, paper: "Vallee 2014, ApJS 215, 1")
    c.units = ["value: pc inside the arm's middle"]
    c.names = ["hot", "cold"]
    c.column("value", [hot, cold])
    c
  }

  /* the baryonic Tully-Fisher sample, with the authors' own baryonic masses */
  data "sparc-btfr" () => {
    names := Borrowed.galaxy_names
    t := Mrt(text: Catalogue.fetch("{Borrowed.SPARC}/BTFR_Lelli2019.mrt", "BTFR_Lelli2019.mrt"))
    rows := t.rows
    c := Catalogue(id: "sparc-btfr", what: "the baryonic Tully-Fisher sample, with the authors' own baryonic masses", source: "{Borrowed.SPARC}/BTFR_Lelli2019.mrt", paper: "Lelli, McGaugh, Schombert, Desmond & Katz 2019, MNRAS 484:3267")
    c.units = ["galaxy: row in sparc-galaxies, or -1 if absent", "log(Mb): log10 Msun, at M/L = 0.5 at 3.6um", "Vf: km/s", "Vmax: km/s", "Inc: deg"]
    c.names = rows.map(r => t.at(r, "Name"))
    c.column("galaxy", rows.map(r => names.index_of(t.at(r, "Name")) ?? -1))
    ["log(Mb)", "e_log(Mb)", "Inc", "e_Inc", "Vf", "e_Vf", "Vmax", "e_Vmax"].for(w => { c.column(w, rows.map(r => t.num(r, w))) })
    c
  }

  /* Genzel et al. 2017 table 1 - six high-redshift discs, read out of the preprint's text layer */
  data "genzel-discs" () => {
    Catalogue.fetch(Borrowed.GENZEL, "genzel2017.pdf")
    all := Catalogue.pdf_text("genzel2017.pdf").lines
    head := None
    Array.range(all.length).for(i => { head = i if head == None & all[i].contains("COS4") & all[i].contains("D3a") & all[i].contains("15504") })
    fail("Genzel table 1: no header row naming the six galaxies") if head == None
    lines := all.drop(head).take(24)
    row := (opens: String): String => {
      l := lines.filter(l => l.trim.starts_with(opens)).first
      fail("Genzel table 1: no row opening {opens.quoted}") if l == None
      l
    }
    /* six plain numbers, taken off the end of the line */
    plain := (opens: String): Real[] => {
      xs := Catalogue.numbers(row(opens))
      fail("Genzel table 1: {opens.quoted} gave {xs.length} numbers") if xs.length < 6
      xs.drop(xs.length - 6)
    }
    /* six `value±error` pairs: the last twelve numbers, in pairs */
    pm := (opens: String): Real[][] => {
      xs := Catalogue.numbers(row(opens))
      fail("Genzel table 1: {opens.quoted} gave {xs.length} numbers, twelve wanted") if xs.length < 12
      xs = xs.drop(xs.length - 12)
      [Array.range(6).map(i => xs[2 * i]), Array.range(6).map(i => xs[2 * i + 1])]
    }
    /* the dark matter fractions: `0.21 (±0.1)` is a measurement, `0.0 (<0.08)` is a bound */
    bounded := (opens: String): Real[][] => {
      l := row(opens)
      xs := Catalogue.numbers(l)
      xs = xs.drop(xs.length - 12)
      limits := []
      rest := l
      while rest.contains("(") {
        rest = rest.drop(rest.index_of("(") + 1)
        limits.push(rest.starts_with("<") ? 1 : 0) if rest.starts_with("<") | rest.starts_with("±")
      }
      fail("Genzel table 1: {opens.quoted} gave {limits.length} fractions") if limits.length != 6
      [Array.range(6).map(i => xs[2 * i]), Array.range(6).map(i => xs[2 * i + 1]), limits]
    }
    who := ["COS4 01351", "D3a 6397", "GS4 43501", "zC 406690", "zC 400569", "D3a 15504"]
    c := Catalogue(id: "genzel-discs", what: "Genzel et al. 2017 table 1 - six high-redshift discs, as published", source: "{Borrowed.GENZEL}   (Nature 543:397, table 1)", paper: "Genzel et al. 2017, Nature 543:397")
    c.units = ["z: redshift", "Mstar: 1e11 Msun", "Mbaryon: 1e11 Msun, gas + stars, prior, no bulge", "Rhalf_H: kpc, H-band half-light radius, prior", "Mb: 1e11 Msun, gas + stars INCLUDING bulge, fitted", "Re: kpc, R1/2 of an n=1 disk, fitted", "vc: km/s at R1/2", "sigma0: km/s", "fDM: dark matter fraction inside R1/2", "e_fDM: +-2 rms, or an upper limit", "limit: 1 where e_fDM is a bound rather than an error"]
    c.names = who
    mstar := pm("M* (10")
    mbar := pm("Mbaryon(gas+stars) (10")
    rh := pm("H-band R1/2")
    inc := pm("inclination")
    f := bounded("fDM(R1/2)")
    c.column("z", plain("redshift"))
    c.column("kpc_per_arcsec", plain("kpc/arcsec"))
    c.column("Mstar", mstar[0])
    c.column("e_Mstar", mstar[1])
    c.column("Mbaryon", mbar[0])
    c.column("e_Mbaryon", mbar[1])
    c.column("Rhalf_H", rh[0])
    c.column("e_Rhalf_H", rh[1])
    c.column("inc", inc[0])
    c.column("e_inc", inc[1])
    c.column("c", plain("dark matter concentration"))
    c.column("vc", plain("vc(R1/2)"))
    c.column("Re", plain("R1/2(n=1)"))
    c.column("Mb", plain("Mbaryon(gas+stars, including bulge)"))
    c.column("bulgeFraction", plain("Mbulge/Mbaryon"))
    c.column("fDM", f[0])
    c.column("e_fDM", f[1])
    c.column("limit", f[2])
    c
  }

  /* the Sun and the four terrestrial planets, off JPL Horizons */
  data "solar-inner" () => {
    names := ["Sun", "Mercury", "Venus", "Earth", "Mars"]
    ids := ["10", "199", "299", "399", "499"]
    c := Catalogue(id: "solar-inner", what: "the Sun and the four terrestrial planets - the near field, where gravity is known to eleven figures and a theory of it has nothing to argue with", source: "{Borrowed.HORIZONS} (COMMAND=10,199,299,399,499)", paper: "JPL Horizons on-line ephemeris system, Giorgini et al. 1996, DPS 28:25.04")
    c.units = ["GM: km^3/s^2, the body's own gravitational parameter", "radius: km, volumetric mean", "a: au, semi-major axis at J2000, heliocentric; 0 for the Sun", "e: eccentricity at J2000; 0 for the Sun", "period: days, sidereal orbital period; 0 for the Sun"]
    c.names = names
    gm := []
    radius := []
    a := []
    e := []
    period := []
    ids.for(id => {
      phys := Catalogue.fetch("{Borrowed.HORIZONS}?format=text&COMMAND='{id}'&OBJ_DATA='YES'&MAKE_EPHEM='NO'", "horizons-{id}-physical.txt")
      gm.push(Horizons.quoted(phys, "GM"))
      radius.push(Horizons.quoted(phys, "Vol. mean radius"))
      if id == "10" {
        a.push(0)
        e.push(0)
        period.push(0)
      } else {
        orb := Catalogue.fetch("{Borrowed.HORIZONS}?format=text&COMMAND='{id}'&EPHEM_TYPE='ELEMENTS'&CENTER='@sun'&START_TIME='2000-01-01'&STOP_TIME='2000-01-02'&STEP_SIZE='1d'&OUT_UNITS='AU-D'", "horizons-{id}-elements.txt")
        block := orb.drop(orb.index_of("$$SOE")).take(orb.index_of("$$EOE") - orb.index_of("$$SOE"))
        a.push(Horizons.element(block, "A"))
        e.push(Horizons.element(block, "EC"))
        period.push(Horizons.element(block, "PR"))
      }
    })
    c.column("GM", gm)
    c.column("radius", radius)
    c.column("a", a)
    c.column("e", e)
    c.column("period", period)
    c
  }
}
