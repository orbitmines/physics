/*
 * THE MEDIUM - the continuous model, integrated on a box.
 *
 * THE VACUUM BEATS AND IS NOT STORED: where nothing else is going on every point splits in one half of the beat and
 * every edge meets in the other, and a hole in that beat heals within a beat, so the medium only knows which half it
 * is in (the tick's parity) and integrates what differs from it.
 *
 * AND A BODY'S RAYS GO OUT FROM IT: nothing turns them where the record is nothing, so which way they go at a place
 * is the way from that body to the place, and all the medium carries is HOW MUCH of them stands there - one number a
 * cell, not one a heading. A way of a point is one of the lattice's DEG, so a body's rays at a place stand on the
 * ways within that much of the way from it, and two bodies' rays face each other as much as those ways overlap.
 * At every cell, one thing a tick, every step reading the box as the tick opened:
 *
 *   MEET     rays out of the beat's phase face rays out of it too - one body's against another's, where two fields
 *            meet - as much as their ways overlap, at the term's own share; each end loses a ray, and the fold it
 *            writes stands (the beat's creation hands back only what the beat's own meeting folded);
 *   UNFOLD   in a dark half creation hands back the folds a point holds, on its own share;
 *   STREAM   what was not taken goes one c-bar on, out from the body it came from, thinned over the shell it crosses:
 *            what a body sends crosses R^(D-1) of it (`transport.thinning`, the model's own 1/l.shell);
 *   MAKE     the points the terms grow, per local;
 *   SOURCE   a body announces at its rate, m-bar_x of a ray times its ways over the lattice's, where it truly stands;
 *   MOVE     a body goes where its point is going - into the point that folds it - kept as momentum, never past c-bar.
 */

Medium := class < theory: Theory, N: N, A: N, K: N {
  DEG: N = this.theory.lattice.DEG
  /* the dimension of the world the box is a plane through: the line is read in it, the box is always two */
  D: N = this.theory.lattice.D
  tags: N = 1
  aggregate: Aggregate = Aggregate.of(this.theory, this.DEG, this.D)
  cells (): N => this.N * this.N
  /*
   * EVERY BODY APART (`apart`): each body keeps its own rays - its own beam, as a lone body does - however many there
   * are, rather than one beam per tagged kind. What changes is only how a point meets them (`meet_gathered`)
   */
  apart: boolean = false
  /* the front's plane and one per tagged kind of body - or one per body, where every body is apart */
  planes (): N => this.apart | this.local_rays ? this.holes.length + 1 : (this.tags < 1 ? 1 : this.tags)
  /* how many ticks have run; `t` is the name a panel's marks read it by */
  ticks: N = 0
  t (): N => this.ticks
  /* the beat's half as the tick opens: lit, every edge about to meet, or dark, every point about to split */
  lit (): boolean => this.ticks % 2 == 0
  /* the settled vacuum, as the aggregate reads it: where the box starts */
  rho_inf: Real = this.aggregate.rho_inf
  nf_inf: Real = this.aggregate.nf_inf
  /*
   * HOW MUCH EACH BODY HAS SENT, BY HOW FAR OUT IT STANDS: a body's rays go out from it and nothing turns them where
   * the record is nothing, so what it sent is the same all the way round at a given distance - one number a c-bar,
   * not one a cell. It goes with the body, as its rays do
   */
  rungs (): N => (Real.of(this.N) / Real.of(this.K)).floor + 3
  beam: Real[][] = Array.range(this.planes).map(z => Array.filled(this.rungs, 0))
  /* what a body has sent, at a distance from it in c-bar, read between the rungs it is kept on */
  /*
   * what stands between two rungs is read off what CROSSES THE SHELL there, not off what is spread over it: what a
   * body sends is the same across every shell it has reached (`transport.thinning` only spreads it), so that is what
   * stands between the rungs evenly, and a free field reads exactly right between them rather than a little heavy
   */
  sent_at (z: N, r: Real): Real => {
    rr := r < 0 ? 0 : r
    i := rr.floor
    return 0 if i + 1 >= this.rungs
    near := this.face_of(this.body_of(z))
    f := rr - Real.of(i)
    over := Real.of(this.D - 1)
    here := Fmt.max(near, rr) ^ over
    was := this.beam[z][i] * (Fmt.max(near, Real.of(i)) ^ over)
    next := this.beam[z][i + 1] * (Fmt.max(near, Real.of(i + 1)) ^ over)
    here > 0 ? (was * (1 - f) + next * f) / here : 0
  }
  /*
   * WHEN AND WHERE SOMETHING LEFT, which is what the vacuum's phase settles. A ray r c-bar out left r ticks ago from
   * where the body stood then, and it keeps the vacuum's own number (the tick and the place's colour) its whole life,
   * since it crosses K cells a tick and K is odd. What left while the vacuum there was lit is doused by the meeting
   * rule; the rest stands. Nothing of the phase is the ray's - it is the vacuum's, and this is only where it acts
   */
  lit_when (h: Hole, r: Real): boolean => {
    k := this.holes.index_of(h)
    hx := k < 0 | this.tracks.length <= k ? None : this.tracks[k]
    n := hx == None ? 0 : hx.length / 2
    back := r.round
    at := n - 1 - back
    return this.lit_at(h.x, h.y) if n < 1 | at < 0
    (this.ticks - back + hx[2 * at].round + hx[2 * at + 1].round) % 2 == 0
  }
  /* and what it has sent where a place stands, with the way out from it */
  sent_to (z: N, x: Real, y: Real): Real[] => {
    h := this.body_of(z)
    return [0, 0, 0] if h == None
    way := this.out_from(h, x, y)
    return [0, way[0], way[1]] if this.phase & this.lit_when(h, way[2])
    [this.sent_at(z, way[2]), way[0], way[1]]
  }
  /* the record a point holds: the folds written where two bodies' rays met */
  fold: Real[] = Array.filled(this.cells, 0)
  /* where a point at each cell is going, in c-bar a tick a tick: what the panels draw as the pull */
  lean_x: Real[] = Array.filled(this.cells, 0)
  lean_y: Real[] = Array.filled(this.cells, 0)
  /* the points the world grew at each cell this tick */
  growth: Real[] = Array.filled(this.cells, 0)
  /* the space destroyed at each cell this tick by one body's rays against another's */
  gone: Real[] = Array.filled(this.cells, 0)
  blocks: N[] = Array.filled(this.cells, 0)
  holes: Hole[] = []
  /*
   * HOW BIG A BODY IS, in c-bar: its own face where it says one, and the nearest a reading can be taken otherwise.
   * Its rays leave from there rather than from its middle, so this is where its profile starts (Field.Hole.face)
   */
  face_of (h: Hole): Real => h == None ? this.aggregate.NEAR : (h.face > this.aggregate.NEAR ? h.face : this.aggregate.NEAR)
  /*
   * and what it sends per unit of that face is its rate through the skin law of its size: an inner cell's output is
   * annihilated crossing its neighbours, so what gets out saturates (`\bar{m}\paren{\bar{R}}`, the store's own).
   * At the smallest a source can be nothing is shadowed and this is one
   */
  skin_of (h: Hole): Real => {
    near := this.aggregate.NEAR
    face := this.face_of(h)
    at_one := 1 - this.aggregate.reach_at(near)
    got := 1 - this.aggregate.reach_at(face)
    at_one > 0 ? got / at_one : 1
  }
  /* a way of a point is one of the lattice's DEG: this much of the ways out, in angle */
  ways_wide (): Real => Real.TAU / Real.of(this.DEG)
  /*
   * WHERE A BODY IS READ FROM: where it stood when the ray left it, which is a light-time back - the same lookup the
   * chain makes (`Aggregate.read_at`). A ray at r c-bar out left r ticks ago, so the distance and the place it left
   * from are each other's answer, and a few rounds settle them. Where nothing is kept of a body it is read where it is
   */
  ROUNDS: N = 4
  was_at (h: Hole, x: Real, y: Real): Real[] => {
    hx := this.tracks[this.holes.index_of(h)]
    n := hx == None ? 0 : hx.length / 2
    return [h.x, h.y] if !this.retard | n < 2
    px := h.x
    py := h.y
    R := Fmt.hypot(px - x, py - y) / Real.of(this.K)
    Array.range(this.ROUNDS).for(i => {
      back := R.round
      back = n - 1 if back > n - 1
      at := n - 1 - back
      vx := at > 0 ? hx[2 * at] - hx[2 * at - 2] : 0
      vy := at > 0 ? hx[2 * at + 1] - hx[2 * at - 1] : 0
      px = hx[2 * at] + vx * Real.of(back)
      py = hx[2 * at + 1] + vy * Real.of(back)
      R = Fmt.hypot(px - x, py - y) / Real.of(this.K)
    })
    [px, py]
  }
  /* where each body has stood, tick by tick, so its field can be read from where it was */
  retard: boolean = false
  tracks: Real[][] = []
  keep_track () => {
    return if !this.retard
    Array.range(this.holes.length).for(k => {
      this.tracks.push([]) if this.tracks.length <= k
      this.tracks[k].push(this.holes[k].x)
      this.tracks[k].push(this.holes[k].y)
    })
  }
  /* the way out from a body at a place, and how far the place stands from it in c-bar */
  out_from (h: Hole, x: Real, y: Real): Real[] => {
    seen := this.was_at(h, x, y)
    dx := x - seen[0]
    dy := y - seen[1]
    d := Fmt.hypot(dx, dy)
    /* nothing of it is read nearer than its own face: inside a body there are no rays of it, they left its surface */
    near := this.face_of(h)
    /* and at the very place it stands there is no way out of it at all, so nothing of it points anywhere */
    return [0, 0, near] if d <= 0
    [dx / d, dy / d, Fmt.max(near, d / Real.of(this.K))]
  }
  /* how much two bundles of rays face each other: what their ways have in common, one being met head on by the other */
  facing_share (ax: Real, ay: Real, bx: Real, by: Real): Real => {
    /* the way the other comes from, against the way this one goes */
    ux := 0 - bx
    uy := 0 - by
    /* and where they have nothing in common - further apart than a turn of the lattice's own - there is nothing to work out */
    return 0 if ax * ux + ay * uy <= this.ways_wide.cos
    angle := (ax * uy - ay * ux).atan2(ax * ux + ay * uy).abs
    got := 1 - angle / this.ways_wide
    got < 0 ? 0 : got
  }

  /* the body whose rays are on a plane */
  body_of (z: N): Hole? => this.apart ? (z >= 1 & z <= this.holes.length ? this.holes[z - 1] : None) : this.holes.filter(h => this.plane_of(h) == z).first

  /* THE LINE'S TERMS, as the reading wrote them */
  terms (): Array => this.theory.equation.terms
  meets: Array = this.terms.filter(t => !t.settles & !t.transport & !t.outside & !t.doing.trades & t.degree == 2)
  points: Array = this.terms.filter(t => !t.settles & !t.transport & !t.outside & !t.doing.trades & t.degree == 0)
  singles: Array = this.terms.filter(t => !t.settles & !t.transport & !t.outside & !t.doing.trades & t.degree == 1)
  /* the transport term: where a turned ray goes */
  carrying: * = this.terms.filter(t => t.transport & t.leans != None).first
  turned: String = this.carrying == None ? "kept" : this.carrying.turned
  /* the step that takes a point on with its ray (Vertex.swap), and its record with it */
  trading: Array = this.terms.filter(t => t.doing.trades)
  /*
   * the symbols a term's share is read against at a local: its activity and record as the tick opened, the ways, the
   * room ahead as the closure has it; and the facing pair is the meeting itself here, since the facing way is read,
   * not averaged over
   */
  /* a body's own share of the ticks it spends stepping rather than lighting - beta, as the source term reads it: a step is one decision a tick, so it is what it moves at, in c-bar a tick */
  beta (h: Hole): Real => {
    v := h.momentum.norm / h.mass
    v < 0 ? 0 : (v > 1 ? 1 : v)
  }
  /* what a source puts on every edge beside it a tick: its ways over the lattice's, on the source term's own share (Emission) */
  /*
   * WHAT A BODY'S OWN GOING DOES TO WHAT IT SENDS. A source moves or pulses and never both, which is the (1 - beta)
   * the line already carries. But the phase between its pulses and the vacuum's only accumulates while the rate of
   * flipping KEEPS CHANGING - which is the body's own acceleration, and what a body accelerates at is what it feels
   * (`closing`). So what it sends carries its own acceleration, measured against the only rate the vacuum has; and
   * since what it feels is what the others send, the two close on each other rather than either being solved for
   */
  own: N = 0
  /* what it last felt of the others, which is what it is accelerating at */
  felt_by (k: N): Real => {
    return 0 if this.pulled.length <= k
    g := this.pulled[k]
    Fmt.hypot(g[0], g[1])
  }
  drifting (h: Hole): Real => {
    return 1 if this.own != 1
    k := this.holes.index_of(h)
    g := this.felt_by(k)
    a0 := this.a0_vacuum()
    /* nothing has accumulated where nothing is accelerating it, and the rest is the mismatch against the vacuum's own rate */
    return 1 if !(g > 0) | !(a0 > 0)
    1 + a0 / g
  }
  per_way (h: Hole): Real => {
    c := this.at(h.x.round, h.y.round)
    s := this.symbols(c >= 0 & !this.rho_was.empty ? this.rho_was[c] : 0, 0)
    s["β"] = this.beta(h)
    got := h.mass / Real.of(this.DEG) * this.skin_of(h)
    this.terms.filter(t => t.outside).for(t => { got = got * this.share(t, s) * t.doing.rays.at(s) })
    got * this.drifting(h)
  }
  /*
   * WHAT THE MEDIUM RUNS ON. A lattice with nothing on it is not what the chain derives anything at: the settled
   * vacuum stands at rho_inf with DEG/2 folds a point, and every rate in the chain is read there. `vacuum` puts
   * that under what the bodies add, and `facing` reads F off the closure rather than taking it for one
   */
  vacuum: boolean = false
  facing: boolean = false
  /*
   * and what the scale is taken to be against what the chain says it is. The chain reads a_0 a POINT while the
   * medium reads what arrives a WAY, and the two differ by the lattice's ways - which is the one factor between
   * the chain's a_0/cH and what is measured of it. `a0_share` is that, tried rather than asserted
   */
  a0_share: Real = 1
  /*
   * THE VACUUM'S OWN RATE, and the CHAIN'S OWN: `closing` ends in a_0 = v/\lambda and `Model.a0_lattice` evaluates
   * it at the settled vacuum, which is what the law carries. Assembling it here out of \omega, n_f, \sigma and
   * \rho is a backend's own reading of a derived number, and it came out twice the chain's
   */
  /* the chain itself, so the number is read off the steps and not off a file the package may not have */
  model: Model = Model(theory: this.theory)
  model_a0 (): Real => {
    f := this.model.fact("a_{{0}}")
    f == None ? 0 : this.model.at(f.to, this.model.settled(this.DEG))
  }
  /* read once: a tick asks for it at every cell */
  a0_chain: Real = this.model_a0()
  a0_vacuum (): Real => this.a0_chain * this.a0_share
  /*
   * WHOSE DENSITY ENDS A CARRIER (`scale_crossed`: "the length that matters is set by all the medium it crossed").
   * Read on the settled vacuum it is the same everywhere and a_0 is a constant of the lattice, which is what runs
   * today. Read on the MATTER instead - what the bodies have put there, over and above the vacuum - it is a_0
   * scaled by that excess, since a_0 = v/\lambda and \lambda = 1/(\sigma F\rho) put the density on top
   */
  a0_from: N = 0
  /*
   * OR AS THE CHAIN READS IT (`a0_from` 2): `a_{0} along the path` (`scale_crossed`) is a_0 = vH with the density a
   * carrier CROSSED on its way in, the vacuum's own share averaged from the source to the place. Where the settled
   * vacuum runs under the bodies it is thinner near a body (`settle_rho`), so a heavy source is felt against a larger
   * scale - which is what carries the chain's own sweep above the law. The chain's expression, evaluated, and scaled
   * so the undisturbed vacuum gives the medium's own a_0 back
   */
  scale_fact: * = this.model.fact("a_{{0}} along the path")
  scale_env: {} = this.model.settled(this.DEG)
  scale_at (avg: Real): Real => {
    return 1 if this.scale_fact == None
    e := Model.copy(this.scale_env)
    e["\\langle\\rho\\rangle"] = avg
    this.model.at(this.scale_fact.to, e)
  }
  scale_inf: Real = this.scale_at(this.rho_inf)
  /* the vacuum's own share, averaged along the straight way in from the nearest body to the place */
  CROSSING: N = 16
  crossed_at (x: Real, y: Real): Real => {
    h := this.nearest(x, y)
    return this.rho_inf if h == None
    got := 0
    Array.range(this.CROSSING).for(i => {
      f := (Real.of(i) + 0.5) / Real.of(this.CROSSING)
      got = got + this.tap(this.vac, 0, h.x + (x - h.x) * f, h.y + (y - h.y) * f, this.rho_inf)
    })
    got / Real.of(this.CROSSING)
  }
  a0_at_place (x: Real, y: Real): Real => {
    if this.a0_from == 2 {
      return this.scale_inf > 0 ? this.a0_vacuum() * this.scale_at(this.crossed_at(x, y)) / this.scale_inf : this.a0_vacuum()
    }
    return this.a0_vacuum() if this.a0_from != 1 | !(this.rho_inf > 0)
    got := this.tap(this.rho_was, 0, x, y, 0)
    this.a0_vacuum() * got / this.rho_inf
  }
  symbols (rho: Real, nf: Real): {} => {
    s := { }
    /* the settled vacuum stands under whatever the bodies put on it, where the medium runs on it */
    s["ρ"] = rho
    s["n_f"] = this.vacuum ? nf + this.nf_inf : nf
    s["DEG"] = this.DEG
    fac := this.aggregate.base["F"]
    s["F"] = this.facing & fac != None ? fac : 1
    om := this.aggregate.base["\\omega"]
    s["ω"] = om == None ? 1 : om
    s["β"] = 0
    s["m_l"] = 0
    this.terms.for(t => { s[t.rate] = 1 if t.rate != None & s[t.rate] == None })
    s
  }
  share (t: *, s: {}): Real => {
    v := t.doing.share.at(s)
    v < 0 ? 0 : (v > 1 ? 1 : v)
  }
  activity (x: Real): Real => x < 0 ? 0 : (x > 1 ? 1 : x)

  at (x: Z, y: Z): Z => (x < 0 | y < 0 | x >= this.N | y >= this.N) ? -1 : y * this.N + x
  column_of (c: N): N => c % this.N
  row_of (c: N): N => (c - c % this.N) / this.N
  /* which plane a body's rays are on: its tag, or the vacuum's where nothing is tagged */
  plane_of (h: Hole): N => this.apart | this.local_rays ? this.holes.index_of(h) + 1 : ((h.tag == None | h.tag < 1) ? 0 : (h.tag < this.planes ? h.tag : this.planes - 1))

  /* a body put in: where it stands, in cells, and the momentum it was thrown with */
  add (h: Hole): Hole => {
    h.momentum = Vector(components: [h.px, h.py])
    h.advance = Vector.zero(2)
    this.holes.push(h)
    /* a body apart brings its own beam, and its own row of what a panel reads of it */
    if this.apart {
      this.beam.push(Array.filled(this.rungs, 0))
      this.swept.push(Array.filled(this.cells, 0))
    }
    /* held where they are, every body's rays together on one row of what a panel reads */
    this.swept.push(Array.filled(this.cells, 0)) if this.local_rays & this.swept.length < 2
    this.block
    h
  }
  /* the c-bar a body stands on: the K by K cells round its cell */
  under (h: Hole): N[] => {
    half := ((this.K - 1) / 2).floor
    out := []
    Array.range(this.K).for(dy => {
      Array.range(this.K).for(dx => {
        c := this.at(h.x.round - half + dx, h.y.round - half + dy)
        out.push(c) if c >= 0
      })
    })
    out
  }
  /*
   * THE CELLS A BODY'S POINT COVERS, BY AREA: its c-bar is K by K cells about where it truly stands, and each of those
   * lands on the four cells around its own true place, as every other step of the medium does - so nothing a body does
   * jumps when it crosses from one cell to the next
   */
  spread (h: Hole): Real[][] => {
    half := Real.of(this.K - 1) / 2
    out := []
    Array.range(this.K).for(dy => {
      Array.range(this.K).for(dx => {
        px := h.x - half + Real.of(dx)
        py := h.y - half + Real.of(dy)
        x0 := px.floor
        y0 := py.floor
        ax := px - Real.of(x0)
        ay := py - Real.of(y0)
        Array.range(2).for(j => {
          Array.range(2).for(i => {
            c := this.at(x0 + i, y0 + j)
            w := (i == 0 ? 1 - ax : ax) * (j == 0 ? 1 - ay : ay)
            out.push([Real.of(c), w]) if c >= 0 & w > 0
          })
        })
      })
    })
    out
  }
  block () => {
    Array.range(this.cells).for(c => { this.blocks[c] = 0 })
    Array.range(this.holes.length).for(k => { this.under(this.holes[k]).for(c => { this.blocks[c] = k + 1 }) })
  }
  masses (): Real[] => this.holes.map(h => h.mass)

  /* a field read by area at a true position (x, y) in cells, with what stands across the box's edge */
  tap (f: Real[], base: N, x: Real, y: Real, outside: Real): Real => {
    x0 := x.floor
    y0 := y.floor
    ax := x - Real.of(x0)
    ay := y - Real.of(y0)
    cell_value := (i: Z, j: Z): Real => {
      k := this.at(i, j)
      k >= 0 ? f[base + k] : outside
    }
    got := (1 - ax) * (1 - ay) * cell_value(x0, y0)
    got = got + ax * (1 - ay) * cell_value(x0 + 1, y0)
    got = got + (1 - ax) * ay * cell_value(x0, y0 + 1)
    got + ax * ay * cell_value(x0 + 1, y0 + 1)
  }

  /*
   * A PLANE THROUGH A WORLD OF D DIMENSIONS. What a body sends crosses a shell round it, so what arrives on a way is
   * what it sent over that shell - R^(D-1) of it (`transport.thinning`, the model's own 1/l.shell). Streamed in the
   * plane it spreads over R of that by the headings' own fanning out, so what a heading carries from one c-bar back
   * is thinned by the ratio of the two distances from that body, to the power D - 2. That fanning out is the line's
   * resolution: one heading's carry only spreads where the next heading's has come to meet it, so a line wants
   * headings enough that they meet inside the view - else a body on a heading's own way reads too much
   */
  slice (h: Hole?, x: Real, y: Real, bx: Real, by: Real): Real => {
    return 1 if this.D <= 2 | h == None
    near := this.face_of(h)
    here := Fmt.max(near, Fmt.hypot(x - h.x, y - h.y) / Real.of(this.K))
    back := Fmt.max(near, Fmt.hypot(bx - h.x, by - h.y) / Real.of(this.K))
    (back / here) ^ Real.of(this.D - 2)
  }
  nearest (x: Real, y: Real): Hole? => {
    best := None
    far := 0
    this.holes.for(h => {
      d := Fmt.hypot(x - h.x, y - h.y)
      if best == None | d < far { best = h; far = d }
    })
    best
  }

  /* THE BOX AS THE TICK OPENED: every step reads these */
  was: Real[][] = []
  rho_was: Real[] = []
  nf_was: Real[] = []
  /* the record still standing once this tick's creation has handed back what it hands back */
  stand: Real[] = []
  open () => {
    cells := this.cells
    this.was = this.beam.map(rung => Array.range(this.rungs).map(i => rung[i]))
    this.rho_was = Array.range(cells).map(c => {
      x := Real.of(this.column_of(c))
      y := Real.of(this.row_of(c))
      got := 0
      Array.range(this.planes - 1).for(i => { got = got + this.sent_to(i + 1, x, y)[0] }) if !this.local_rays
      got = this.held_at(c) if this.local_rays
      /* what stands at a point is the vacuum's own population and what the bodies have sent there */
      this.activity(this.vacuum ? got + this.vac[c] : got)
    })
    this.nf_was = Array.range(cells).map(c => this.fold[c])
    Array.range(cells).for(c => { this.growth[c] = 0; this.gone[c] = 0 })
  }


  /*
   * MEET: one body's rays against another's, where two fields meet. At a cell each body's rays go the way out from it,
   * and a way of a point is one of the lattice's DEG, so the two meet on as much of the point's ways as those two ways
   * have in common, one head on to the other. What that folds stands at the cell; what it takes of the rays themselves
   * is what the model's own `reach` counts, and at these rates it is a millionth of them a tick
   */
  /*
   * MEET, WITH EVERY BODY APART: the same meeting, but what arrives at a point is gathered first by the way it comes
   * from - GATHER bins round the point, each holding what arrived on it and, weighed by what came, the way it came.
   * A way holds at most one ray out of the beat's phase, so what arrives on one way is one bundle there however many
   * bodies sent it; then bundle meets facing bundle as body met body. Where no two bodies' rays share a bin this is
   * the pairwise meeting exactly - same activities, same ways, same overlap - and it costs the bins, not the pairs
   */
  static GATHER = 96
  gather (): N => Medium.GATHER
  bin_of (dx: Real, dy: Real): N => {
    angle := dy.atan2(dx)
    turned := angle < 0 ? angle + Real.TAU : angle
    (turned / Real.TAU * Real.of(this.gather)).round % this.gather
  }
  /* a cell's share of a place by area, along one axis: how much of a cell-wide square at the place overlaps the cell's */
  tent (v: Real): Real => Fmt.max(0, 1 - v.abs)
  /* how much of a place's area the cells round it that are in the box hold: at the edge what came is read by those */
  inside_at (x: Real, y: Real): Real => {
    x0 := x.floor
    y0 := y.floor
    got := Real.of(0)
    Array.range(2).for(j => {
      Array.range(2).for(i => {
        got = got + this.tent(x - Real.of(x0 + i)) * this.tent(y - Real.of(y0 + j)) if this.at(x0 + i, y0 + j) >= 0
      })
    })
    got
  }

  /*
   * EVERY BODY'S RAYS HELD WHERE THEY ARE (`local_rays`). The model is local: a ray goes one c-bar a tick, and what
   * happens at a point is read at that point. So what arrives is kept at the place it arrived, one bundle for each of
   * the GATHER ways round a point, and every tick it goes one c-bar on. Nothing is read off a body from afar.
   * A bundle carries what crosses the shell there - the one thing a ray keeps however far it goes, since
   * `transport.thinning` only spreads it - with the place it left from, how fast its body was going then, and how big
   * its body is. Where one body alone has sent a bundle it is that body's beam exactly: the same 1/R^(D-1), the same
   * way out, the same one ray a way at most. Where several have, it is the medium's own gathering (`meet_gathered`:
   * a way holds at most one ray, so what arrives on one way is one bundle however many bodies sent it)
   */
  local_rays: boolean = false
  /*
   * how many bodies' bundles one way of a point keeps apart. The beams keep every body's rays apart however many there
   * are; held where they are, a way keeps SLOTS of them, and only where more than that arrive on one way is the pair
   * whose places are nearest as seen from the point gathered into one - which is what a crowd of bodies far off along
   * one way is, seen from there
   */
  static SLOTS = 4
  keeps (): N => Medium.SLOTS
  /*
   * AND HOW NEAR A BODY ITS OWN RAYS ARE ITS OWN TO LAY. A c-bar back along a way, the rays that reach a point came
   * through cells whose own way out from that body can differ from the point's by as much as a cell subtends from
   * the body - many ways, close in. So each body lays its first `zone` cells itself, as the tick finds it (its first
   * two rungs and a little more), and past that a point looks `window` ways either side of its own, which covers what
   * a cell subtends from zone - K out. Laying costs the zone's area a source; reading costs the window a point and way:
   * two rungs keeps the window to 6 ways (one rung, 14 - three quarters of a tick went on reading them)
   */
  zone (): N => 2 * this.K + 2
  /*
   * where the zone ends: a source lays what is at most this far, and the stream keeps only what is past it. It sits a
   * little past the half-cell (no two cell centres, nor a cell and a body at a half cell, are that far apart), so the
   * rounding of a place read back off a bundle never puts one cell on both sides or on neither
   */
  edge (): Real => Real.of(this.zone) + 0.5005
  /*
   * how many ways either side a bundle can be held on at a cell a way back: the point a way back is at least the zone less
   * a way from where it left (the stream reads past the zone), and the four cells round it are within a diagonal of it,
   * so the way it was held on can turn by as much as a diagonal is seen from there (asin), and a way more for rounding at
   * both ends
   */
  window (): N => {
    s := Real.of(2).sqrt / Real.of(this.zone - this.K)
    (Real.of(this.gather) * s.atan2((1 - s * s).sqrt) / Real.TAU).floor + 2
  }
  /* a bundle, as moments: what crosses the shell, and that times where it left from, how fast its body went then, and its body's face */
  bq: Real[] = []
  bsx: Real[] = []
  bsy: Real[] = []
  bvx: Real[] = []
  bvy: Real[] = []
  bface: Real[] = []
  /* whose rays a bundle is while they are one body's alone, and -1 once two bodies' have been gathered into it */
  bwho: Real[] = []
  /*
   * and how far apart the bodies gathered into it stand: q times the square of each one's distance from their middle,
   * summed (nought for one body's). Read from their middle alone a gathering along a way comes short - nearer ones send
   * more than farther ones take back - by as much as this says (`spread_of`)
   */
  bspread: Real[] = []
  /*
   * and at the very place a body stands its rays go no way out of it (`out_from`), so they are on no way: what stands
   * there is kept beside the ways, a cell at a time, with whose it is
   */
  middle: Real[] = []
  middle_who: Real[] = []
  /* each cell's source as the shine laid it (`cell_sources`), for what stands at a middle - on no way - to be read at a point near it */
  shone: Array = []
  bundles (): N => this.cells * this.gather * this.keeps
  /* the first slot of way b of cell c */
  first_slot (c: N, b: N): N => (c * this.gather + b) * this.keeps
  bundles_ready () => {
    n := this.bundles
    this.middle = Array.filled(this.cells, 0) if this.middle.length != this.cells
    this.middle_who = Array.filled(this.cells, -1) if this.middle_who.length != this.cells
    return if this.bq.length == n
    this.bq = Array.filled(n, 0)
    this.bsx = Array.filled(n, 0)
    this.bsy = Array.filled(n, 0)
    this.bvx = Array.filled(n, 0)
    this.bvy = Array.filled(n, 0)
    this.bface = Array.filled(n, 0)
    this.bwho = Array.filled(n, -1)
    this.bspread = Array.filled(n, 0)
  }
  /* the way a bundle on way b of a point is going, as the way stands round the point */
  way_x (b: N): Real => (Real.TAU * Real.of(b) / Real.of(this.gather)).cos
  way_y (b: N): Real => (Real.TAU * Real.of(b) / Real.of(this.gather)).sin
  /*
   * where the body a bundle came from stands now: where it was when the rays left, gone on at the pace it went then
   * for as long as they have been out - a c-bar a tick, so as many ticks as c-bar they have come
   */
  now_from (m: Real[], x: Real, y: Real): Real[] => {
    sx := m[1] / m[0]
    sy := m[2] / m[0]
    age := Fmt.hypot(x - sx, y - sy) / Real.of(this.K)
    [sx + m[3] / m[0] * age, sy + m[4] / m[0] * age]
  }
  /* what a bundle, as moments, has put at a place (x, y) in cells, and the way out from its body there - `sent_to`, read where the rays are */
  reads (m: Real[], x: Real, y: Real): Real[] => {
    return [0, 0, 0] if !(m[0] > 0)
    s := this.now_from(m, x, y)
    dx := x - s[0]
    dy := y - s[1]
    d := Fmt.hypot(dx, dy)
    r := Fmt.max(m[5] / m[0], d / Real.of(this.K))
    got := Fmt.min(1, m[0] / (r ^ Real.of(this.D - 1)) * (r > m[5] / m[0] ? this.spread_of(m, d) : 1))
    /* at the very place its body stands its rays are all there, going no way out (`out_from`) */
    return [got, 0, 0] if d <= 0
    [got, dx / d, dy / d]
  }
  /* slot k's bundle, as moments */
  moments (k: N): Real[] => [this.bq[k], this.bsx[k], this.bsy[k], this.bvx[k], this.bvy[k], this.bface[k], this.bwho[k], this.bspread[k]]
  held_to (k: N, x: Real, y: Real): Real[] => this.reads(this.moments(k), x, y)
  /* two bundles gathered into one: every moment sums, and two bodies' become no one's */
  gathered (a: Real[], b: Real[], x: Real, y: Real): Real[] => [a[0] + b[0], a[1] + b[1], a[2] + b[2], a[3] + b[3], a[4] + b[4], a[5] + b[5], a[6] == b[6] ? a[6] : -1, this.spread_with(a, b, x, y)]
  /*
   * how far apart what two bundles gathered stand along the way they go, seen from (x, y): each one's own, and theirs
   * from each other's middle along the line to (x, y). Across it they stand within the way's width, and there being
   * apart takes a little off what they send rather than adding (so it is not counted: counted as along, a disc of
   * 300 stars read 2% high)
   */
  spread_with (a: Real[], b: Real[], x: Real, y: Real): Real => {
    return a[7] + b[7] if !(a[0] > 0 & b[0] > 0)
    q := a[0] + b[0]
    ex := x - (a[1] + b[1]) / q
    ey := y - (a[2] + b[2]) / q
    e := Fmt.hypot(ex, ey)
    along := e > 0 ? ((a[1] / a[0] - b[1] / b[0]) * ex + (a[2] / a[0] - b[2] / b[0]) * ey) / e : 0
    a[7] + b[7] + a[0] * b[0] / q * along * along
  }
  /*
   * what a gathering sends d cells off, against what it would from its middle alone: its bodies stand apart along the
   * way it goes (across a way they are within its width), and q over the distance to the D - 1 bends up, so the nearer
   * send more than the farther take back - by half its bend times how far apart they stand
   */
  spread_of (m: Real[], d: Real): Real => {
    n := Real.of(this.D - 1)
    return 1 if !(d > 0 & m[0] > 0)
    1 + n * (n + 1) / 2 * m[7] / (m[0] * d * d)
  }
  /* how far apart two bundles' places are, against the nearer of them, as seen from (x, y): the pair a way gathers first is the least */
  apart_seen (a: Real[], b: Real[], x: Real, y: Real): Real => {
    ax := a[1] / a[0]
    ay := a[2] / a[0]
    bx := b[1] / b[0]
    by := b[2] / b[0]
    near := Fmt.min(Fmt.hypot(x - ax, y - ay), Fmt.hypot(x - bx, y - by))
    Fmt.hypot(ax - bx, ay - by) / Fmt.max(near, 1)
  }
  /*
   * whether a bundle is its body's own to lay at (x, y) - its body stands within the edge, so the shine lays it anew
   * each tick - rather than one the stream brought from further off
   */
  fresh (m: Real[], x: Real, y: Real): boolean => {
    s := this.now_from(m, x, y)
    Fmt.hypot(x - s[0], y - s[1]) <= this.edge
  }
  /*
   * WHAT ONE WAY OF A POINT HOLDS, laid into its slots: each bundle its own, and while there are more than the slots,
   * the pair nearest each other as seen from the point gathered into one - two the shine lays anew each tick, or two
   * the stream brought, never one of each: gathered with what streams past, a body's own would come back into its zone
   * nameless, the shine would lay it again, and it would be counted twice (a body between two others on a line, one
   * slot a way, read 11% high)
   */
  lay (c: N, b: N, got: Real[][]) => {
    x := Real.of(this.column_of(c))
    y := Real.of(this.row_of(c))
    list := got.filter(m => m[0] > 0)
    while list.length > this.keeps {
      fr := list.map(m => this.fresh(m, x, y))
      best := 0
      bi := -1
      bj := -1
      /* of one kind first; only where no two are of one kind (a slot or two a way) any pair */
      Array.range(2).for(pass => {
        if bi < 0 {
          Array.range(list.length).for(i => {
            Array.range(list.length).for(j => {
              if j > i & (pass == 1 | fr[i] == fr[j]) {
                seen := this.apart_seen(list[i], list[j], x, y)
                if bi < 0 | seen < best {
                  best = seen
                  bi = i
                  bj = j
                }
              }
            })
          })
        }
      })
      merged := this.gathered(list[bi], list[bj], x, y)
      list = Array.range(list.length).filter(i => i != bi & i != bj).map(i => list[i]).concat([merged])
    }
    base := this.first_slot(c, b)
    Array.range(this.keeps).for(j => {
      m := j < list.length ? list[j] : [0, 0, 0, 0, 0, 0, -1, 0]
      this.bq[base + j] = m[0]
      this.bsx[base + j] = m[1]
      this.bsy[base + j] = m[2]
      this.bvx[base + j] = m[3]
      this.bvy[base + j] = m[4]
      this.bface[base + j] = m[5]
      this.bwho[base + j] = m[6]
      this.bspread[base + j] = m[7]
    })
  }
  /* a body's own bundle taken off every way of a point */
  drop_whose (c: N, who: Real) => {
    Array.range(this.gather).for(b => {
      held := this.held_on(c, b)
      this.lay(c, b, held.filter(m => m[6] != who)) if held.some(m => m[6] == who)
    })
  }
  /* what one way of a point holds now, as moments */
  held_on (c: N, b: N): Real[][] => {
    base := this.first_slot(c, b)
    Array.range(this.keeps).map(j => this.moments(base + j)).filter(m => m[0] > 0)
  }
  /* what a body puts on its rays, as moments: what crosses its own face, and that times where it is, how fast it goes (cells a tick) and its face */
  emitted (h: Hole): Real[] => {
    near := this.face_of(h)
    q := this.per_way(h) * (near ^ Real.of(this.D - 1))
    [q, q * h.x, q * h.y, q * h.momentum.components[0] / h.mass * Real.of(this.K), q * h.momentum.components[1] / h.mass * Real.of(this.K), q * near, Real.of(this.holes.index_of(h)), 0]
  }
  /*
   * what a body lays at a place d cells off, as it stands now: rays that far out left d/K ticks ago, from where it was
   * then at the pace it goes - so that where a bundle says its body is now (`now_from`) is where it truly is
   */
  left_for (e: Real[], d: Real): Real[] => {
    back := d / Real.of(this.K)
    [e[0], e[1] - e[3] * back, e[2] - e[4] * back, e[3], e[4], e[5], e[6], e[7]]
  }
  /* what a body has at the very place it stands, all of its rays going no way out */
  put_middle (c: N, e: Real[]) => {
    got := Fmt.min(1, e[0] / ((e[5] / e[0]) ^ Real.of(this.D - 1)))
    this.middle_who[c] = this.middle[c] > 0 & this.middle_who[c] != e[6] ? -1 : e[6]
    this.middle[c] = this.middle[c] + got
  }
  /*
   * SHINE, HELD: what a body announces stands on the c-bar round it - its first rung - on the way out from it at each
   * cell, as its own now; at the very place it stands it goes no way out, and is kept beside the ways
   */
  shine_local () => {
    this.bundles_ready
    Array.range(this.cells).for(c => {
      this.middle[c] = 0
      this.middle_who[c] = -1
    })
    src := this.cell_sources
    this.shone = src
    /*
     * what the shine gathered at a point last tick is its own to lay again: a gathering within the edge - of bodies laid
     * together, or a cell's (-2 - cell), whose bodies may since have come or gone - goes. A body's own it finds by name
     */
    Array.range(this.cells).for(c => {
      x := Real.of(this.column_of(c))
      y := Real.of(this.row_of(c))
      Array.range(this.gather).for(b => {
        held := this.held_on(c, b)
        this.lay(c, b, held.filter(m => !(m[6] < 0 & this.fresh(m, x, y)))) if held.some(m => m[6] < 0 & this.fresh(m, x, y))
      })
    })
    Array.range(this.cells).for(sc => {
      e := src[sc]
      if e != None & e[0] > 0 {
        sx := e[1] / e[0]
        sy := e[2] / e[0]
        reach := this.zone + 1
        Array.range(2 * reach + 1).for(j => {
          Array.range(2 * reach + 1).for(i => {
            c := this.at(sx.round - reach + i, sy.round - reach + j)
            if c >= 0 {
              dx := Real.of(this.column_of(c)) - sx
              dy := Real.of(this.row_of(c)) - sy
              d := Fmt.hypot(dx, dy)
              /* at the very place it stands - a place read back off its moments is that place to a thousandth of a cell */
              this.put_middle(c, e) if d <= 0.001
              if d > 0.001 & d <= this.edge {
                /* a source has one bundle at a point: what it lays now replaces what of it the stream brought, on whatever way */
                this.drop_whose(c, e[6])
                b := this.bin_of(dx, dy)
                this.lay(c, b, this.held_on(c, b).concat([this.left_for(e, d)]))
              }
            }
          })
        })
      }
    })
  }
  /*
   * THE BODIES STANDING ON ONE CELL, GATHERED, as the medium gathers what arrives on one way however many sent it: their
   * moments summed. A lone body keeps its own name; two or more are the cell's own gathering (-2 - the cell), so that a
   * point lays one zone a source cell, however many stars stand on it
   */
  cell_sources (): Array => {
    src := Array.filled(this.cells, None)
    this.holes.for(h => {
      c := this.at(h.x.round, h.y.round)
      if c >= 0 {
        e := this.emitted(h)
        had := src[c]
        src[c] = had == None ? e : [had[0] + e[0], had[1] + e[1], had[2] + e[2], had[3] + e[3], had[4] + e[4], had[5] + e[5], Real.of(-2 - c), 0]
      }
    })
    src
  }
  /*
   * STREAM, HELD: every point takes, on each of its ways, what stood one c-bar back along that way - read by area off
   * the four cells round that place, as every other step of the medium reads - on that way and the two beside it, and
   * keeps what truly goes its way: whose way out from where it left falls on this way. What came from one body (or one
   * gathering) through several of the four cells is one bundle, read by area among them. A body's own first c-bar is
   * its own to shine (`shine`), so nothing streams into it; and the box is a window, so nothing comes in across its edge
   */
  stream_local () => {
    this.bundles_ready
    B := this.gather
    S := this.keeps
    n := this.bundles
    was := [this.bq, this.bsx, this.bsy, this.bvx, this.bvy, this.bface, this.bwho, this.bspread]
    this.bq = Array.filled(n, 0)
    this.bsx = Array.filled(n, 0)
    this.bsy = Array.filled(n, 0)
    this.bvx = Array.filled(n, 0)
    this.bvy = Array.filled(n, 0)
    this.bface = Array.filled(n, 0)
    this.bwho = Array.filled(n, -1)
    this.bspread = Array.filled(n, 0)
    Array.range(this.cells).for(c => {
      x := Real.of(this.column_of(c))
      y := Real.of(this.row_of(c))
      /*
       * each bundle that reaches this point on a way, with the share of the cells it came through. A body has one ray at
       * a point - the one that left it a light-time back - so what came of one body on a way is one bundle
       */
      Array.range(B).for(t => {
        groups := []
        /*
         * what goes way t here, each bundle read one c-bar back along its own heading - where its ray came through -
         * off the cells round that place, by area. Those places lie between the ones half a way either side of t, so
         * the cells round both hold all of it. So a body's arrivals are one bundle on one way, however its rays'
         * leaving places sit against the ways
         */
        a0 := Real.TAU * (Real.of(t) - 0.5) / Real.of(B)
        a1 := Real.TAU * (Real.of(t) + 0.5) / Real.of(B)
        p0x := x - Real.of(this.K) * a0.cos
        p0y := y - Real.of(this.K) * a0.sin
        p1x := x - Real.of(this.K) * a1.cos
        p1y := y - Real.of(this.K) * a1.sin
        lx := Fmt.min(p0x, p1x).floor
        ly := Fmt.min(p0y, p1y).floor
        nx := Fmt.max(p0x, p1x).floor + 2 - lx
        ny := Fmt.max(p0y, p1y).floor + 2 - ly
        Array.range(ny).for(j => {
          Array.range(nx).for(i => {
            u := this.at(lx + i, ly + j)
            if u >= 0 {
              ux := Real.of(lx + i)
              uy := Real.of(ly + j)
              Array.range(2 * this.window + 1).for(o => {
                base := (u * B + (t + B + o - this.window) % B) * S
                Array.range(S).for(sl => {
                  k := base + sl
                  q := was[0][k]
                  if q > 0 {
                    m := [q, was[1][k], was[2][k], was[3][k], was[4][k], was[5][k], was[6][k], was[7][k]]
                    dx := x - m[1] / q
                    dy := y - m[2] / q
                    d := Fmt.hypot(dx, dy)
                    now := this.now_from(m, x, y)
                    /*
                     * past the zone, not the edge: where its body now is is read off each cell's own moments, a little
                     * apart, so at the edge some of one bundle's cells would pass and some not. Between the zone and
                     * the edge the source lays it again, and what it lays replaces this (drop_whose)
                     */
                    if d > 0 & this.bin_of(dx, dy) == t & Fmt.hypot(x - now[0], y - now[1]) > Real.of(this.zone) {
                      /* where its ray came through, a c-bar back, and this cell's share of that place */
                      cx := x - Real.of(this.K) * dx / d
                      cy := y - Real.of(this.K) * dy / d
                      w := this.tent(ux - cx) * this.tent(uy - cy) / this.inside_at(cx, cy)
                      if w > 0 {
                        /* the same body's (or the same gathering's) through another of the cells is the same bundle */
                        g := -1
                        Array.range(groups.length).for(gi => {
                          h := groups[gi]
                          /* one body's, or one cell's gathering of bodies, by its name; a gathering made on the way (-1) by where it left from, as near as half a cell and a twentieth of how far it is seen from here */
                          same := (m[6] != -1 & h[6] == m[6]) | (m[6] == -1 & h[6] == -1 & Fmt.hypot(h[1] / h[0] - m[1] / q, h[2] / h[0] - m[2] / q) < 0.5 + 0.05 * d)
                          g = gi if g < 0 & same
                        })
                        part := [w * m[0], w * m[1], w * m[2], w * m[3], w * m[4], w * m[5], m[6], w * m[7]]
                        if g < 0 {
                          groups.push(part)
                        } else {
                          h := groups[g]
                          groups[g] = [h[0] + part[0], h[1] + part[1], h[2] + part[2], h[3] + part[3], h[4] + part[4], h[5] + part[5], h[6], this.spread_with(h, part, x, y)]
                        }
                      }
                    }
                  }
                })
              })
            }
          })
        })
        /*
         * each read by area - the shares of the cells it came through, which together are the whole - and laid on the
         * way. Not each by its own shares: where a body came through some cells alone and through others gathered with
         * its neighbours, that counted it twice, and more with every c-bar out
         */
        this.lay(c, t, groups) if !groups.empty
      })
    })
  }
  /* THE FIELD AS IF IT HAD ALWAYS BEEN THERE, HELD: every point holds what every body sends it, on the way it comes (`seed`) */
  seed_local () => {
    n := this.bundles
    this.bq = Array.filled(n, 0)
    this.bsx = Array.filled(n, 0)
    this.bsy = Array.filled(n, 0)
    this.bvx = Array.filled(n, 0)
    this.bvy = Array.filled(n, 0)
    this.bface = Array.filled(n, 0)
    this.bwho = Array.filled(n, -1)
    this.bspread = Array.filled(n, 0)
    this.middle = Array.filled(this.cells, 0)
    this.middle_who = Array.filled(this.cells, -1)
    /*
     * each body's own zone laid, and no more: what lies further out the stream carries there a c-bar a tick, as a
     * setup's settling ticks run - so nothing reads every body at every cell, and the field is the medium's own
     */
    this.shine_local
  }
  /* what all the bodies have put at a cell (`meet_gathered`'s bins, held) */
  held_at (c: N): Real => {
    x := Real.of(this.column_of(c))
    y := Real.of(this.row_of(c))
    got := this.middle.length == this.cells ? this.middle[c] : 0
    Array.range(this.gather * this.keeps).for(j => { got = got + this.held_to(c * this.gather * this.keeps + j, x, y)[0] })
    got
  }
  /*
   * WHERE A POINT AT (x, y) IS GOING, HELD (`pull_at`): what faces it is what the ways of the cell it stands in hold,
   * each bundle read at the point itself, from where its body stands - a bundle carries its body's place, so it says
   * what that body sends anywhere near, and the cell a point is in holds every body's that reaches it. The rays of the
   * body at `zown` face it never: its own bundle is passed over, and where it was gathered with others it is taken out
   */
  arriving_at (x: Real, y: Real, zown: N): Real[] => {
    B := this.gather
    S := this.keeps
    u := this.at(x.round, y.round)
    return [0, 0, 0] if u < 0
    own := this.local_rays & zown >= 1 & zown <= this.holes.length ? this.holes[zown - 1] : None
    mine := own == None ? [0, 0, 0, 0, 0, 0, -1, 0] : this.emitted(own)
    me := Real.of(zown - 1)
    /* the name its own cell's gathering goes by, where it stands with others (`cell_sources`) */
    srcid := own == None ? 0.5 : Real.of(-2 - this.at(own.x.round, own.y.round))
    sum := 0
    gx := 0
    gy := 0
    ux := Real.of(this.column_of(u))
    uy := Real.of(this.row_of(u))
    /* the way of this cell the body at zown's own rays stand on, and whether a bundle there is its own alone */
    owns := own == None ? -1 : this.bin_of(ux - own.x, uy - own.y)
    alone := own != None & Array.range(S).some(sl => this.bwho[(u * B + owns) * S + sl] == me)
    Array.range(B).for(b => {
      Array.range(S).for(sl => {
        k := (u * B + b) * S + sl
        if this.bq[k] > 0 & !(own != None & this.bwho[k] == me) {
          m := this.moments(k)
          if this.far_of(m, ux, uy) {
            /* from afar, what it sends read off its field about the cell's middle (`expanded`) */
            f := this.expanded(m, ux, uy, x - ux, y - uy)
            gx = gx + f[0]
            gy = gy + f[1]
          } else {
            /* gathered with others where it was not kept apart: taken out of the gathering nearest it */
            if b == owns & !alone & m[6] == -1 & this.nearest_gathering(u * B + b, own) == sl & m[0] - mine[0] > 0 {
              rest := [m[0] - mine[0], m[1] - mine[1], m[2] - mine[2], m[3] - mine[3], m[4] - mine[4], m[5] - mine[5], -1, 0]
              /* and how far apart the rest stand: the gathering's, less what its own stood off the rest's middle */
              rx := ux - m[1] / m[0]
              ry := uy - m[2] / m[0]
              rd := Fmt.hypot(rx, ry)
              along := rd > 0 ? ((rest[1] / rest[0] - mine[1] / mine[0]) * rx + (rest[2] / rest[0] - mine[2] / mine[0]) * ry) / rd : 0
              rest[7] = Fmt.max(0, m[7] - rest[0] * mine[0] / m[0] * along * along)
              m = rest
            }
            /* sent out within its own cell's gathering: its share taken out of that, laid as that was (`left_for`) */
            if own != None & m[6] == srcid {
              lf := this.left_for(mine, Fmt.hypot(ux - m[1] / m[0], uy - m[2] / m[0]))
              m = [m[0] - lf[0], m[1] - lf[1], m[2] - lf[2], m[3] - lf[3], m[4] - lf[4], m[5] - lf[5], m[6], m[7]]
            }
            got := this.reads(m, x, y)
            sum = sum + got[0]
            gx = gx + got[0] * got[1]
            gy = gy + got[0] * got[2]
          }
        }
      })
    })
    /*
     * what stands at the cell's very middle is on no way: its source, read at the point as any bundle is - a point
     * off the middle stands that far from it. The body at zown's own passed over, or taken out where it stands with others
     */
    e := this.shone.length == this.cells ? this.shone[u] : None
    if e != None & e[0] > 0 & Fmt.hypot(ux - e[1] / e[0], uy - e[2] / e[0]) <= 0.001 & !(own != None & e[6] == me) {
      m := e
      if own != None & e[6] == srcid {
        m = [e[0] - mine[0], e[1] - mine[1], e[2] - mine[2], e[3] - mine[3], e[4] - mine[4], e[5] - mine[5], e[6], e[7]]
      }
      if m[0] > 0 {
        got := this.reads(m, x, y)
        sum = sum + got[0]
        gx = gx + got[0] * got[1]
        gy = gy + got[0] * got[2]
      }
    }
    [sum, gx, gy]
  }
  /*
   * WHAT A BODY FAR OFF SENDS, READ NEAR A CELL'S MIDDLE. Past NEAR cells, and where its rays are not a whole ray a way,
   * a bundle's field - q times the way out over the distance to the D - 1 - is smooth across a cell, so it is read off
   * its value, slope and bend at the cell's middle: off by the cube of how far the point stands from the middle over
   * how far the body is (a millionth, for a planet forty cells from the sun). So a cell's far bodies are summed once a
   * tick into nine numbers, whoever reads them (Kernels MHFIELD), and only the near ones are read at each point
   */
  static NEAR_CELLS = 5
  far_of (m: Real[], ux: Real, uy: Real): boolean => {
    s := this.now_from(m, ux, uy)
    d := Fmt.hypot(ux - s[0], uy - s[1])
    r := d / Real.of(this.K)
    d > Real.of(Medium.NEAR_CELLS) & r > m[5] / m[0] & m[0] / (r ^ Real.of(this.D - 1)) < 1
  }
  /* its field at (ux + dx, uy + dy), off its value, slope and bend at (ux, uy): the way out times q K^(D-1) / distance^D, in cells */
  expanded (m: Real[], ux: Real, uy: Real, dx: Real, dy: Real): Real[] => {
    s := this.now_from(m, ux, uy)
    ex := ux - s[0]
    ey := uy - s[1]
    r2 := ex * ex + ey * ey
    Dd := Real.of(this.D)
    C := m[0] * (Real.of(this.K) ^ (Dd - 1)) * this.spread_of(m, r2.sqrt)
    rD := r2 ^ (Dd / 2)
    a := C / rD
    b := Dd * C / (rD * r2)
    c := Dd * (Dd + 2) * C / (rD * r2 * r2)
    jxx := a - b * ex * ex
    jxy := 0 - b * ex * ey
    jyy := a - b * ey * ey
    hxxx := 0 - 3 * b * ex + c * ex * ex * ex
    hxxy := 0 - b * ey + c * ex * ex * ey
    hxyy := 0 - b * ex + c * ex * ey * ey
    hyyy := 0 - 3 * b * ey + c * ey * ey * ey
    fx := a * ex + jxx * dx + jxy * dy + (hxxx * dx * dx + 2 * hxxy * dx * dy + hxyy * dy * dy) / 2
    fy := a * ey + jxy * dx + jyy * dy + (hxxy * dx * dx + 2 * hxyy * dx * dy + hyyy * dy * dy) / 2
    [fx, fy]
  }
  /* of the gatherings on one way (slots of `way`), the one whose place is nearest a body's */
  nearest_gathering (way: N, h: Hole): N => {
    S := this.keeps
    best := -1
    far := 0
    Array.range(S).for(sl => {
      k := way * S + sl
      if this.bq[k] > 0 & this.bwho[k] == -1 {
        d := Fmt.hypot(this.bsx[k] / this.bq[k] - h.x, this.bsy[k] / this.bq[k] - h.y)
        if best < 0 | d < far {
          best = sl
          far = d
        }
      }
    })
    best
  }
  meet_gathered () => {
    B := this.gather
    Array.range(this.cells).for(c => {
      x := Real.of(this.column_of(c))
      y := Real.of(this.row_of(c))
      s := this.symbols(this.rho_was[c], this.nf_was[c])
      sums := Array.filled(B, 0)
      wx := Array.filled(B, 0)
      wy := Array.filled(B, 0)
      Array.range(this.planes - 1).for(i => {
        got := this.sent_to(i + 1, x, y)
        if got[0] > 0 {
          b := this.bin_of(got[1], got[2])
          sums[b] = sums[b] + got[0]
          wx[b] = wx[b] + got[0] * got[1]
          wy[b] = wy[b] + got[0] * got[2]
        }
      })
      this.meet_bins(c, s, sums, wx, wy)
    })
  }
  /*
   * MEET, HELD (`local_rays`): the same meeting, on what the point's own ways hold - each bundle read at the point,
   * from where its body stands - which is what `meet_gathered` gathers from the bodies' beams
   */
  meet_local () => {
    B := this.gather
    Array.range(this.cells).for(c => {
      x := Real.of(this.column_of(c))
      y := Real.of(this.row_of(c))
      s := this.symbols(this.rho_was[c], this.nf_was[c])
      sums := Array.filled(B, 0)
      wx := Array.filled(B, 0)
      wy := Array.filled(B, 0)
      Array.range(B).for(b => {
        Array.range(this.keeps).for(sl => {
          got := this.held_to((c * B + b) * this.keeps + sl, x, y)
          sums[b] = sums[b] + got[0]
          wx[b] = wx[b] + got[0] * got[1]
          wy[b] = wy[b] + got[0] * got[2]
        })
      })
      /* what goes no way out is gathered where the medium gathers it, on the way whose angle is nought, facing nothing */
      sums[0] = sums[0] + this.middle[c]
      this.meet_bins(c, s, sums, wx, wy)
    })
  }
  /* bundle meeting facing bundle at cell c, and each against the vacuum's own (`meet_gathered`) */
  meet_bins (c: N, s: {}, sums: Real[], wx: Real[], wy: Real[]) => {
    B := this.gather
    Array.range(B).for(a => {
      if sums[a] > 0 {
        na := Fmt.hypot(wx[a], wy[a])
        ax := na > 0 ? wx[a] / na : 0
        ay := na > 0 ? wy[a] / na : 0
        Array.range(B).for(b => {
          if b != a & sums[b] > 0 {
            nb := Fmt.hypot(wx[b], wy[b])
            over := nb > 0 ? this.facing_share(ax, ay, wx[b] / nb, wy[b] / nb) : 0
            if over > 0 {
              this.meets.for(t => {
                w := this.share(t, s) * this.activity(sums[a]) * this.activity(sums[b]) * over
                this.fold[c] = Fmt.max(0, this.fold[c] + w * t.doing.folds.at(s) / 2)
                this.growth[c] = this.growth[c] + w * t.doing.space.at(s) / 2
                this.gone[c] = this.gone[c] + w * t.doing.folds.at(s).abs / 2
              })
            }
          }
        })
        /* and against the vacuum's own, one way of the lattice's facing the bundle head on */
        if this.vacuum {
          this.meets.for(t => {
            w := this.share(t, s) * this.activity(sums[a]) * this.activity(this.rho_inf) / Real.of(this.DEG)
            this.fold[c] = Fmt.max(0, this.fold[c] + w * t.doing.folds.at(s) / 2)
            this.growth[c] = this.growth[c] + w * t.doing.space.at(s) / 2
            this.gone[c] = this.gone[c] + w * t.doing.folds.at(s).abs / 2
          })
        }
      }
    })
  }
  meet () => {
    return this.meet_local if this.local_rays
    return this.meet_gathered if this.apart
    cells := this.cells
    P := this.planes
    Array.range(cells).for(c => {
      x := Real.of(this.column_of(c))
      y := Real.of(this.row_of(c))
      s := this.symbols(this.rho_was[c], this.nf_was[c])
      Array.range(P - 1).for(i => {
        z := i + 1
        ours := this.sent_to(z, x, y)
        if ours[0] > 0 {
          Array.range(P - 1).for(j => {
            yy := j + 1
            if yy != z {
              theirs := this.sent_to(yy, x, y)
              if theirs[0] > 0 {
                over := this.facing_share(ours[1], ours[2], theirs[1], theirs[2])
                if over > 0 {
                  this.meets.for(t => {
                    w := this.share(t, s) * this.activity(ours[0]) * this.activity(theirs[0]) * over
                    this.fold[c] = Fmt.max(0, this.fold[c] + w * t.doing.folds.at(s) / 2)
                    this.growth[c] = this.growth[c] + w * t.doing.space.at(s) / 2
                    this.gone[c] = this.gone[c] + w * t.doing.folds.at(s).abs / 2
                  })
                }
              }
            }
          })
        }
        /*
         * AND AGAINST THE VACUUM'S OWN, where the medium runs on the settled vacuum. Its rays stand on every way
         * there is, so what faces a body's ray head on is one way of the lattice's - and what that folds is written
         * where it happened, the same as any other meeting
         */
        if this.vacuum {
          theirs := this.rho_inf
          this.meets.for(t => {
            w := this.share(t, s) * this.activity(ours[0]) * this.activity(theirs) / Real.of(this.DEG)
            this.fold[c] = Fmt.max(0, this.fold[c] + w * t.doing.folds.at(s) / 2)
            this.growth[c] = this.growth[c] + w * t.doing.space.at(s) / 2
            this.gone[c] = this.gone[c] + w * t.doing.folds.at(s).abs / 2
          })
        }
      })
    })
  }



  /*
   * UNFOLD: in a dark half every point splits that nothing out of the beat's phase stands on, and creation hands back
   * the folds it holds, on the term's own share. A lit half hands nothing back: no point is neutral then
   */
  unfold () => {
    cells := this.cells
    this.stand = Array.range(cells).map(c => this.nf_was[c])
    unless this.lit {
      Array.range(cells).for(c => {
        s := this.symbols(this.rho_was[c], this.nf_was[c])
        /*
         * THE SETTLED VACUUM'S OWN RECORD IS NOT CARRIED, SO NEITHER IS ITS CLEARING. The vacuum writes its DEG/2 a beat
         * and clears them a beat, which is what settled means, and the medium runs neither half of that: `fold` holds only
         * what stands ABOVE it. Creation hands back the share of what stands - n_f/DEG of the ways, one fold each - and
         * read at the vacuum's own n_f that share cleared the whole excess every dark tick, so nothing a body wrote ever
         * stood to an even tick. Read at the excess alone it clears the excess at its own share, (1 - rho) a dark tick
         */
        s["n_f"] = this.nf_was[c]
        this.points.for(t => {
          back := t.doing.folds.at(s)
          if back != 0 {
            h := this.share(t, s) * back
            this.fold[c] = Fmt.max(0, this.fold[c] + h)
            this.stand[c] = Fmt.max(0, this.stand[c] + h)
          }
        })
      })
    }
  }

  /*
   * STREAM: what was not taken goes one c-bar on, the way it was going - out from the body it came from - and what a
   * body sends crosses a shell as it goes, so it is thinned by the ratio of the two distances to the power D - 1
   * (`transport.thinning`, the model's own 1/l.shell). The box is a window: nothing comes in across its edge
   */
  stream () => {
    /* one c-bar on, out from the body it came from, thinned over the shell it crosses (`transport.thinning`) */
    Array.range(this.planes - 1).for(i => {
      z := i + 1
      near := this.face_of(this.body_of(z))
      was := Array.range(this.rungs).map(r => this.beam[z][r])
      Array.range(this.rungs).for(r => {
        here := Fmt.max(near, Real.of(r))
        back := Fmt.max(near, Real.of(r) - 1)
        this.beam[z][r] = r == 0 ? 0 : was[r - 1] * ((back / here) ^ Real.of(this.D - 1))
      })
    })
  }


  /* MAKE: what the point terms grow, read at every point as the tick opened */
  /*
   * THE VACUUM'S OWN POPULATION, WHICH IS NOT GIVEN. A mass is a place where the vacuum's own balance is disturbed -
   * that is what a mass IS - so rho is a field the medium runs rather than a number it is handed: at each point the
   * rays line of the continuous model, made against taken, with what the bodies put there standing in the reading.
   * Where there is no body it settles where the line nets nought, which is rho_infinity, and near one it does not
   */
  vac: Real[] = Array.filled(this.cells, this.aggregate.rho_inf)
  /* what the rays line nets at a point, off the same terms every other reading is made of (Continuum.right) */
  nets (rho: Real, nf: Real): Real => {
    s := this.symbols(rho, nf)
    got := 0
    /* what a point makes counts the lattice's ways already, since CREATION lights every one of them */
    this.points.for(t => { got = got + this.share(t, s) * t.doing.rays.at(s) })
    this.singles.for(t => { got = got + this.share(t, s) * s["ρ"] * t.doing.rays.at(s) })
    /* a meeting needs two, and takes one from each end */
    this.meets.for(t => { got = got + this.share(t, s) * s["ρ"] * s["ρ"] * t.doing.rays.at(s) })
    got
  }
  /*
   * and the population stands where that line nets nought, which is what the chain does with it: the rates are the
   * lattice's ways a tick, far faster than a tick, so what a point holds is the ROOT of its own balance and not a
   * thing that crawls toward it. Where a body has put rays of its own, the balance is struck against those too -
   * so the vacuum is thinner where a body is, which is the whole of what a mass does to it (`\rho at R`)
   */
  settle_rho () => {
    return if !this.vacuum
    Array.range(this.cells).for(c => {
      /* what the bodies have put at this point, which the vacuum's own has to make room beside */
      mine := this.rho_was[c] - this.vac[c]
      theirs := mine < 0 ? 0 : mine
      nf := this.nf_was[c]
      lo := 0
      hi := 1
      /* the line falls with the population, so one bisection finds where it nets nought */
      Array.range(24).for(i => {
        mid := (lo + hi) / 2
        both := mid + theirs
        if this.nets(both > 1 ? 1 : both, nf) > 0 { lo = mid } else { hi = mid }
      })
      this.vac[c] = (lo + hi) / 2
    })
  }

  make () => {
    cells := this.cells
    Array.range(cells).for(c => {
      s := this.symbols(this.rho_was[c], this.nf_was[c])
      this.points.for(t => {
        this.growth[c] = this.growth[c] + this.share(t, s) * t.doing.space.at(s)
      })
      this.singles.for(t => {
        this.growth[c] = this.growth[c] + this.share(t, s) * this.rho_was[c] * t.doing.space.at(s)
      })
    })
  }

  /* SOURCE: what a body announces stands where it truly is, spread over the c-bar it covers and by area */
  /*
   * WHETHER THE VACUUM IS LIT WHERE AND WHEN SOMETHING LEAVES. CREATION fires at a point with nothing going on and
   * lights every way of it, so a point that has just fired leaves its neighbours occupied and they cannot: the ways
   * of a lattice that is two-coloured alternate, and what stands is one number, (the tick and the place's own colour).
   * A ray crosses K cells a tick and K is odd, so that number is the SAME for it its whole life - it carries no phase
   * of its own, and yet what becomes of it was settled by where and when it left (`closing`: the two pulses)
   */
  phase: boolean = false
  lit_at (x: Real, y: Real): boolean => (this.ticks + x.round + y.round) % 2 == 0
  shine () => {
    /* what a body announces stands on it, at the first rung out: its ways over the lattice's, on the source term's own share */
    this.holes.for(h => {
      z := this.plane_of(h)
      this.beam[z][0] = this.beam[z][0] + this.per_way(h)
    })
    /* a way holds at most one ray out of the beat's phase */
    Array.range(this.planes).for(z => {
      Array.range(this.rungs).for(r => { this.beam[z][r] = Fmt.min(1, this.beam[z][r]) })
    })
  }


  /*
   * WHERE A POINT AT (x, y) IS GOING (Transport: `sinks`): into the point that folds it. A ray of it is met, and the
   * point folded that way, at the meeting term's share times what faces it from that way - a body's rays, come from
   * that body - against the draw's own straight on. Rays of plane `zown` are its own and face it never. A point that
   * is going somewhere meets what faces it the sooner for going at it, the later for going away
   */
  /*
   * WHAT IS FELT IS WHAT ARRIVES, ENHANCED BY THE MISMATCH THAT ACCUMULATED OVER ONE FREE PATH (`closing`), and what
   * that mismatch is measured against is the only rate the vacuum has: a_0 over the acceleration THERE. The medium
   * already carries that acceleration at every cell - it is the lean it left last tick - so the recursion is read
   * where the field is, not at the body: weak field, large factor; strong field, none. Nothing is solved here, the
   * tick is what closes it, and where nothing has been felt yet what arrives stands as it is
   */
  recur_at (x: Real, y: Real, gn: Real): Real => {
    return 1 if this.own != 2 | !(gn > 0)
    a0 := this.a0_at_place(x, y)
    return 1 if !(a0 > 0)
    gx := this.tap(this.lean_x, 0, x, y, 0)
    gy := this.tap(this.lean_y, 0, x, y, 0)
    was := Fmt.hypot(gx, gy)
    /* g = sqrt(g_N(g + a_0)) is g = g_N(1 + a_0/g) written as the mean it is, and it is the form that settles: where
     * nothing has been felt yet the first reading is the deep limit itself, and a strong field gives the arrival back */
    (gn * (was + a0)) ^ 0.5 / gn
  }
  /*
   * WHETHER WHAT ALREADY STANDS AT A PLACE TAKES FROM WHAT AN ARRIVAL DOES THERE. The medium has divided by it since
   * it was written, and no step of the chain says to: `record_slope` reads the other way, a rise in the density
   * buying MORE record by (2\rho_{\infty} + DEG)/(1 - \rho_{\infty}), since the clearing share shrinks. The two
   * differ in sign exactly where the record is deepest, which is where a field is strong, so it is a knob and measured
   */
  crowd: boolean = true
  pull_at (x: Real, y: Real, zown: N, vx: Real, vy: Real): Real[] => {
    half := Real.of(this.K - 1) / 2
    gx := 0
    gy := 0
    Array.range(this.K).for(dy => {
      Array.range(this.K).for(dx => {
        px := x - half + Real.of(dx)
        py := y - half + Real.of(dy)
        s := this.symbols(this.tap(this.rho_was, 0, px, py, 0), this.tap(this.nf_was, 0, px, py, 0))
        rate := 0
        this.meets.for(t => { rate = rate + this.share(t, s) * t.doing.folds.at(s) / 2 })
        stood := this.tap(this.stand, 0, px, py, 0)
        /* held where they are, what faces this point is what its ways hold (`arriving_at`) */
        if this.local_rays {
          came := this.arriving_at(px, py, zown)
          per := rate / (this.crowd ? 1 + stood : 1)
          gx = gx - per * came[1]
          gy = gy - per * came[2]
        }
        Array.range(this.planes - 1).for(i => {
          z := i + 1
          unless z == zown | this.local_rays {
            came := this.sent_to(z, px, py)
            /* what comes at this point comes the way out from that body, so the point is folded toward it */
            share := rate * this.activity(came[0]) / (this.crowd ? 1 + stood : 1)
            gx = gx - share * came[1]
            gy = gy - share * came[2]
          }
        })
      })
    })
    n := Real.of(this.K * this.K)
    f := this.recur_at(x, y, Fmt.hypot(gx / n, gy / n))
    [gx / n * f, gy / n * f]
  }


  /* the same at every cell, for what a panel draws: nothing of the body standing there is what faces it */
  lean () => {
    Array.range(this.cells).for(c => {
      own := this.blocks[c] > 0 ? this.plane_of(this.holes[this.blocks[c] - 1]) : 0
      g := this.pull_at(Real.of(this.column_of(c)), Real.of(this.row_of(c)), own, 0, 0)
      this.lean_x[c] = g[0]
      this.lean_y[c] = g[1]
    })
  }

  /*
   * SWEEP: what each body's rays stand at, a cell at a time, as the tick leaves them - what a panel draws and what a
   * reading reads. A body's rays are its own profile, so this is that profile read at each cell's distance from it
   */
  swept: Real[][] = Array.range(this.planes).map(z => Array.filled(this.cells, 0))
  sweep () => {
    Array.range(this.cells).for(c => { this.swept[1][c] = this.held_at(c) }) if this.local_rays
    return if this.local_rays
    Array.range(this.planes - 1).for(i => {
      z := i + 1
      Array.range(this.cells).for(c => {
        this.swept[z][c] = this.sent_to(z, Real.of(this.column_of(c)), Real.of(this.row_of(c)))[0]
      })
    })
  }

  tick () => {
    /* what was sent goes on and the bodies announce first, so the whole tick reads one and the same field */
    if this.local_rays {
      this.stream_local
      this.shine_local
    } else {
      this.stream
      this.shine
    }
    this.open
    this.meet
    this.unfold
    this.make
    this.settle_rho
    this.keep_track
    /* the bodies go where they were folded, and what a panel draws is read of where that leaves them */
    this.move
    this.lean
    this.sweep
    this.ticks = this.ticks + 1
  }

  lean_under (h: Hole): Real[] => this.pull_at(h.x, h.y, this.plane_of(h), h.momentum.components[0] / h.mass, h.momentum.components[1] / h.mass)

  /*
   * MOVE, locally (Transport): a body is turned by the lean at the c-bar it stands on, keeps it as momentum, and goes
   * as its momentum says. What the world grew is not a push from elsewhere: a grown point is held where it was made,
   * and the folds and unfolds it comes to are already in the record the lean is read off
   */
  /* where each body is going, as the tick left it: read for every body, kept, and given to the ones that move */
  pulled: Real[][] = []
  move () => {
    this.pulled = this.holes.map(h => this.lean_under(h))
    Array.range(this.holes.length).for(i => {
      h := this.holes[i]
      if h.moves {
        g := this.pulled[i]
        h.momentum = h.momentum + Vector(components: [g[0] * h.mass, g[1] * h.mass])
        h.momentum = h.momentum.unit * h.mass if h.momentum.norm > h.mass
        h.x = h.x + h.momentum.components[0] / h.mass * Real.of(this.K)
        h.y = h.y + h.momentum.components[1] / h.mass * Real.of(this.K)
        h.moved = h.moved + 1
      }
    })
    this.block
  }

  /* WHAT A PANEL READS: what arrived at a cell on plane z (0 the vacuum's, 1.. a body's), in rays' worth over the point's ways */
  arrived (z: N, c: N): Real => this.local_rays ? this.swept[z >= 1 ? 1 : 0][c] : this.swept[z < this.planes ? z : this.planes - 1][c]
  record_at (c: N): Real => this.fold[c]

  record (): Real[] => Array.range(this.cells).map(c => this.record_at(c))
  /*
   * THE FIELD AS IF IT HAD ALWAYS BEEN THERE (a setup's instant range): the bodies, held, announce until what they
   * send STANDS - until what a body's point is going by stops moving from one beat to the next, by less than a
   * thousandth of it - and no longer than it takes a ray to cross the box a few times over
   */
  /*
   * THE FIELD AS IF IT HAD ALWAYS BEEN THERE: what a body sends stands at every distance at once, on the shell's own
   * falloff - which is where streaming leaves it, a rung a tick, once it has run for ever (`transport.thinning`)
   */
  seed () => {
    return this.seed_local if this.local_rays
    /* what stands is what the bodies send as they are now: a body that has been given its throw sends less for it */
    Array.range(this.planes).for(z => {
      Array.range(this.rungs).for(r => { this.beam[z][r] = 0 })
    })
    this.holes.for(h => {
      z := this.plane_of(h)
      per := this.per_way(h)
      near := this.face_of(h)
      Array.range(this.rungs).for(r => {
        here := Fmt.max(near, Real.of(r))
        this.beam[z][r] = Fmt.min(1, this.beam[z][r] + per * ((near / here) ^ Real.of(this.D - 1)))
      })
    })
  }

  settle () => {
    this.seed
    before := 0
    done := false
    Array.range(4 * this.crossing).for(i => {
      unless done {
        this.tick
        if this.ticks % 2 == 0 {
          now := 0
          this.holes.for(h => {
            g := this.lean_under(h)
            now = now + Fmt.hypot(g[0], g[1])
          })
          done = true if i > 2 & now > 0 & (now - before).abs < now / 1000
          before = now
        }
      }
    })
  }

  /* a c-bar a tick across the box, corner to corner, and even so the beat is where it was */
  crossing (): N => 2 * ((Real.of(this.N) / Real.of(this.K)).floor + 1)

  /*
   * THE RECORD ABOVE THE VACUUM'S OWN IS WHAT `fold` HOLDS: the settled vacuum's DEG/2 is not carried (it is written
   * and cleared by the vacuum's own beat, which the medium does not run), so what stands above it is the carried record
   * itself. Subtracting the vacuum's own from it again read every cell as nine folds below nothing
   */
  record_above (c: N): Real => this.record_at(c)
  /* the medium's own pull at a place, toward another: read by area, in c-bar a tick a tick */
  pull_toward (x: Real, y: Real, mx: Real, my: Real, zown: N): Real => {
    dx := mx - x
    dy := my - y
    d := Fmt.hypot(dx, dy)
    return 0 if d <= 0
    g := this.pull_at(x, y, zown, 0, 0)
    (g[0] * dx + g[1] * dy) / d
  }
  pull_x (c: N): Real => this.lean_x[c]
  pull_y (c: N): Real => this.lean_y[c]
  grown (c: N): Real => this.record_at(c)
  crossed (c: N): Real => this.gone[c]
  rho_at (c: N): Real => {
    got := 0
    Array.range(this.planes).for(z => { got = got + this.swept[z][c] })
    this.activity(got)
  }

  rho (): Real[] => Array.range(this.cells).map(c => this.rho_at(c))
  mean (): Real => this.rho.sum / Real.of(this.cells)
  state (): Real[] => Array.range(this.cells).map(c => this.rho_at(c))
  bodies (): Hole[] => this.holes
  mass (h: Hole): Real => h.mass

  /* the settled vacuum under the bodies, for a fixture: what a body's rays meet is the vacuum's own, and the record it leaves stands on the vacuum's */
  under_vacuum (): Medium => {
    this.vacuum = true
    this
  }
  /* a body put down at a cell with a momentum, for a fixture */
  thrown (x: Real, y: Real, mx: Real, ways: N, px: Real, py: Real, tag: N): Medium => {
    h := Hole(x: x, y: y, mx: mx, ways: ways)
    h.px = px
    h.py = py
    h.tag = tag
    h.moves = true
    this.add(h)
    this
  }
}

Theory += {
  /* the continuous model of this theory on an N by N box; `tags` planes, the vacuum's and one per kind of body */
  /* the theory's own lattice unless another is named: DEG ways, a world of D dimensions the box is a plane through */
  medium (N: N, A: N = 96, K: N = 3, DEG: N? = None, tags: N = 1, D: N? = None): Medium => Medium(theory: this, N: N, A: A, K: K, DEG: DEG ?? this.lattice.DEG, tags: tags, D: D ?? this.lattice.D)
}
