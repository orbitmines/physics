/*
 * THE MEDIUM - the continuous model, integrated on a box.
 *
 * THE VACUUM BEATS AND IS NOT STORED: where nothing else is going on every point splits in one half of the beat and
 * every edge meets in the other, and a hole in that beat heals within a beat, so the medium only knows which half it
 * is in (the tick's parity) and integrates what differs from it.
 *
 * AND A BODY'S RAYS GO OUT FROM IT: nothing turns them where the record is nothing, so which way they go at a place
 * is the way from that body to the place, and all the medium carries is HOW MUCH of them stands there - one number a
 * cell, not one a heading. A way of a point is one of the lattice's DEG, so a body's rays at a place stand on the
 * ways within that much of the way from it, and two bodies' rays face each other as much as those ways overlap.
 * At every cell, one thing a tick, every step reading the box as the tick opened:
 *
 *   MEET     rays out of the beat's phase face rays out of it too - one body's against another's, where two fields
 *            meet - as much as their ways overlap, at the term's own share; each end loses a ray, and the fold it
 *            writes stands (the beat's creation hands back only what the beat's own meeting folded);
 *   UNFOLD   in a dark half creation hands back the folds a point holds, on its own share;
 *   STREAM   what was not taken goes one c-bar on, out from the body it came from, thinned over the shell it crosses:
 *            what a body sends crosses R^(D-1) of it (`transport.thinning`, the model's own 1/l.shell);
 *   MAKE     the points the terms grow, per local;
 *   SOURCE   a body announces at its rate, m-bar_x of a ray times its ways over the lattice's, where it truly stands;
 *   MOVE     a body goes where its point is going - into the point that folds it - kept as momentum, never past c-bar.
 */

Medium := class < theory: Theory, N: N, A: N, K: N {
  DEG: N = this.theory.lattice.DEG
  /* the dimension of the world the box is a plane through: the line is read in it, the box is always two */
  D: N = this.theory.lattice.D
  tags: N = 1
  aggregate: Aggregate = Aggregate.of(this.theory, this.DEG, this.D)
  cells (): N => this.N * this.N
  /* the front's plane and one per tagged kind of body */
  planes (): N => this.tags < 1 ? 1 : this.tags
  /* how many ticks have run; `t` is the name a panel's marks read it by */
  ticks: N = 0
  t (): N => this.ticks
  /* the beat's half as the tick opens: lit, every edge about to meet, or dark, every point about to split */
  lit (): boolean => this.ticks % 2 == 0
  /* the settled vacuum, as the aggregate reads it: where the box starts */
  rho_inf: Real = this.aggregate.rho_inf
  nf_inf: Real = this.aggregate.nf_inf
  /*
   * HOW MUCH EACH BODY HAS SENT, BY HOW FAR OUT IT STANDS: a body's rays go out from it and nothing turns them where
   * the record is nothing, so what it sent is the same all the way round at a given distance - one number a c-bar,
   * not one a cell. It goes with the body, as its rays do
   */
  rungs (): N => (Real.of(this.N) / Real.of(this.K)).floor + 3
  beam: Real[][] = Array.range(this.planes).map(z => Array.filled(this.rungs, 0))
  /* what a body has sent, at a distance from it in c-bar, read between the rungs it is kept on */
  /*
   * what stands between two rungs is read off what CROSSES THE SHELL there, not off what is spread over it: what a
   * body sends is the same across every shell it has reached (`transport.thinning` only spreads it), so that is what
   * stands between the rungs evenly, and a free field reads exactly right between them rather than a little heavy
   */
  sent_at (z: N, r: Real): Real => {
    rr := r < 0 ? 0 : r
    i := rr.floor
    return 0 if i + 1 >= this.rungs
    near := this.face_of(this.body_of(z))
    f := rr - Real.of(i)
    over := Real.of(this.D - 1)
    here := Fmt.max(near, rr) ^ over
    was := this.beam[z][i] * (Fmt.max(near, Real.of(i)) ^ over)
    next := this.beam[z][i + 1] * (Fmt.max(near, Real.of(i + 1)) ^ over)
    here > 0 ? (was * (1 - f) + next * f) / here : 0
  }
  /*
   * WHEN AND WHERE SOMETHING LEFT, which is what the vacuum's phase settles. A ray r c-bar out left r ticks ago from
   * where the body stood then, and it keeps the vacuum's own number (the tick and the place's colour) its whole life,
   * since it crosses K cells a tick and K is odd. What left while the vacuum there was lit is doused by the meeting
   * rule; the rest stands. Nothing of the phase is the ray's - it is the vacuum's, and this is only where it acts
   */
  lit_when (h: Hole, r: Real): boolean => {
    k := this.holes.index_of(h)
    hx := k < 0 | this.tracks.length <= k ? None : this.tracks[k]
    n := hx == None ? 0 : hx.length / 2
    back := r.round
    at := n - 1 - back
    return this.lit_at(h.x, h.y) if n < 1 | at < 0
    (this.ticks - back + hx[2 * at].round + hx[2 * at + 1].round) % 2 == 0
  }
  /* and what it has sent where a place stands, with the way out from it */
  sent_to (z: N, x: Real, y: Real): Real[] => {
    h := this.body_of(z)
    return [0, 0, 0] if h == None
    way := this.out_from(h, x, y)
    return [0, way[0], way[1]] if this.phase & this.lit_when(h, way[2])
    [this.sent_at(z, way[2]), way[0], way[1]]
  }
  /* the record a point holds: the folds written where two bodies' rays met */
  fold: Real[] = Array.filled(this.cells, 0)
  /* where a point at each cell is going, in c-bar a tick a tick: what the panels draw as the pull */
  lean_x: Real[] = Array.filled(this.cells, 0)
  lean_y: Real[] = Array.filled(this.cells, 0)
  /* the points the world grew at each cell this tick */
  growth: Real[] = Array.filled(this.cells, 0)
  /* the space destroyed at each cell this tick by one body's rays against another's */
  gone: Real[] = Array.filled(this.cells, 0)
  blocks: N[] = Array.filled(this.cells, 0)
  holes: Hole[] = []
  /*
   * HOW BIG A BODY IS, in c-bar: its own face where it says one, and the nearest a reading can be taken otherwise.
   * Its rays leave from there rather than from its middle, so this is where its profile starts (Field.Hole.face)
   */
  face_of (h: Hole): Real => h == None ? this.aggregate.NEAR : (h.face > this.aggregate.NEAR ? h.face : this.aggregate.NEAR)
  /*
   * and what it sends per unit of that face is its rate through the skin law of its size: an inner cell's output is
   * annihilated crossing its neighbours, so what gets out saturates (`\bar{m}\paren{\bar{R}}`, the store's own).
   * At the smallest a source can be nothing is shadowed and this is one
   */
  skin_of (h: Hole): Real => {
    near := this.aggregate.NEAR
    face := this.face_of(h)
    at_one := 1 - this.aggregate.reach_at(near)
    got := 1 - this.aggregate.reach_at(face)
    at_one > 0 ? got / at_one : 1
  }
  /* a way of a point is one of the lattice's DEG: this much of the ways out, in angle */
  ways_wide (): Real => Real.TAU / Real.of(this.DEG)
  /*
   * WHERE A BODY IS READ FROM: where it stood when the ray left it, which is a light-time back - the same lookup the
   * chain makes (`Aggregate.read_at`). A ray at r c-bar out left r ticks ago, so the distance and the place it left
   * from are each other's answer, and a few rounds settle them. Where nothing is kept of a body it is read where it is
   */
  ROUNDS: N = 4
  was_at (h: Hole, x: Real, y: Real): Real[] => {
    hx := this.tracks[this.holes.index_of(h)]
    n := hx == None ? 0 : hx.length / 2
    return [h.x, h.y] if !this.retard | n < 2
    px := h.x
    py := h.y
    R := Fmt.hypot(px - x, py - y) / Real.of(this.K)
    Array.range(this.ROUNDS).for(i => {
      back := R.round
      back = n - 1 if back > n - 1
      at := n - 1 - back
      vx := at > 0 ? hx[2 * at] - hx[2 * at - 2] : 0
      vy := at > 0 ? hx[2 * at + 1] - hx[2 * at - 1] : 0
      px = hx[2 * at] + vx * Real.of(back)
      py = hx[2 * at + 1] + vy * Real.of(back)
      R = Fmt.hypot(px - x, py - y) / Real.of(this.K)
    })
    [px, py]
  }
  /* where each body has stood, tick by tick, so its field can be read from where it was */
  retard: boolean = false
  tracks: Real[][] = []
  keep_track () => {
    return if !this.retard
    Array.range(this.holes.length).for(k => {
      this.tracks.push([]) if this.tracks.length <= k
      this.tracks[k].push(this.holes[k].x)
      this.tracks[k].push(this.holes[k].y)
    })
  }
  /* the way out from a body at a place, and how far the place stands from it in c-bar */
  out_from (h: Hole, x: Real, y: Real): Real[] => {
    seen := this.was_at(h, x, y)
    dx := x - seen[0]
    dy := y - seen[1]
    d := Fmt.hypot(dx, dy)
    /* nothing of it is read nearer than its own face: inside a body there are no rays of it, they left its surface */
    near := this.face_of(h)
    /* and at the very place it stands there is no way out of it at all, so nothing of it points anywhere */
    return [0, 0, near] if d <= 0
    [dx / d, dy / d, Fmt.max(near, d / Real.of(this.K))]
  }
  /* how much two bundles of rays face each other: what their ways have in common, one being met head on by the other */
  facing_share (ax: Real, ay: Real, bx: Real, by: Real): Real => {
    /* the way the other comes from, against the way this one goes */
    ux := 0 - bx
    uy := 0 - by
    /* and where they have nothing in common - further apart than a turn of the lattice's own - there is nothing to work out */
    return 0 if ax * ux + ay * uy <= this.ways_wide.cos
    angle := (ax * uy - ay * ux).atan2(ax * ux + ay * uy).abs
    got := 1 - angle / this.ways_wide
    got < 0 ? 0 : got
  }

  /* the body whose rays are on a plane */
  body_of (z: N): Hole? => this.holes.filter(h => this.plane_of(h) == z).first

  /* THE LINE'S TERMS, as the reading wrote them */
  terms (): Array => this.theory.equation.terms
  meets: Array = this.terms.filter(t => !t.settles & !t.transport & !t.outside & !t.doing.trades & t.degree == 2)
  points: Array = this.terms.filter(t => !t.settles & !t.transport & !t.outside & !t.doing.trades & t.degree == 0)
  singles: Array = this.terms.filter(t => !t.settles & !t.transport & !t.outside & !t.doing.trades & t.degree == 1)
  /* the transport term: where a turned ray goes */
  carrying: * = this.terms.filter(t => t.transport & t.leans != None).first
  turned: String = this.carrying == None ? "kept" : this.carrying.turned
  /* the step that takes a point on with its ray (Vertex.swap), and its record with it */
  trading: Array = this.terms.filter(t => t.doing.trades)
  /*
   * the symbols a term's share is read against at a local: its activity and record as the tick opened, the ways, the
   * room ahead as the closure has it; and the facing pair is the meeting itself here, since the facing way is read,
   * not averaged over
   */
  /* a body's own share of the ticks it spends stepping rather than lighting - beta, as the source term reads it: a step is one decision a tick, so it is what it moves at, in c-bar a tick */
  beta (h: Hole): Real => {
    v := h.momentum.norm / h.mass
    v < 0 ? 0 : (v > 1 ? 1 : v)
  }
  /* what a source puts on every edge beside it a tick: its ways over the lattice's, on the source term's own share (Emission) */
  /*
   * WHAT A BODY'S OWN GOING DOES TO WHAT IT SENDS. A source moves or pulses and never both, which is the (1 - beta)
   * the line already carries. But the phase between its pulses and the vacuum's only accumulates while the rate of
   * flipping KEEPS CHANGING - which is the body's own acceleration, and what a body accelerates at is what it feels
   * (`closing`). So what it sends carries its own acceleration, measured against the only rate the vacuum has; and
   * since what it feels is what the others send, the two close on each other rather than either being solved for
   */
  own: N = 0
  /* what it last felt of the others, which is what it is accelerating at */
  felt_by (k: N): Real => {
    return 0 if this.pulled.length <= k
    g := this.pulled[k]
    Fmt.hypot(g[0], g[1])
  }
  drifting (h: Hole): Real => {
    return 1 if this.own != 1
    k := this.holes.index_of(h)
    g := this.felt_by(k)
    a0 := this.a0_at(this.rho_inf, this.nf_inf)
    /* nothing has accumulated where nothing is accelerating it, and the rest is the mismatch against the vacuum's own rate */
    return 1 if !(g > 0) | !(a0 > 0)
    1 + a0 / g
  }
  per_way (h: Hole): Real => {
    c := this.at(h.x.round, h.y.round)
    s := this.symbols(c >= 0 & !this.rho_was.empty ? this.rho_was[c] : 0, 0)
    s["β"] = this.beta(h)
    got := h.mass / Real.of(this.DEG) * this.skin_of(h)
    this.terms.filter(t => t.outside).for(t => { got = got * this.share(t, s) * t.doing.rays.at(s) })
    got * this.drifting(h)
  }
  /*
   * WHAT THE MEDIUM RUNS ON. A lattice with nothing on it is not what the chain derives anything at: the settled
   * vacuum stands at rho_inf with DEG/2 folds a point, and every rate in the chain is read there. `vacuum` puts
   * that under what the bodies add, and `facing` reads F off the closure rather than taking it for one
   */
  vacuum: boolean = false
  facing: boolean = false
  /*
   * and what the scale is taken to be against what the chain says it is. The chain reads a_0 a POINT while the
   * medium reads what arrives a WAY, and the two differ by the lattice's ways - which is the one factor between
   * the chain's a_0/cH and what is measured of it. `a0_share` is that, tried rather than asserted
   */
  a0_share: Real = 1
  /*
   * THE VACUUM'S OWN RATE, a_0 = v/\lambda, read where it is asked: the chain's v = \omega/(1 + n_f) over its
   * \lambda = 1/(\sigma F\rho) (`closing`, `scale_crossed`) - the same number the runtime writes for the device
   */
  a0_at (rho: Real, nf: Real): Real => {
    s := this.symbols(rho, nf)
    sig := this.aggregate.base["\\sigma"]
    s["ω"] / (1 + s["n_f"]) * (sig == None ? 1 : sig) * s["F"] * rho
  }
  a0_vacuum (): Real => this.a0_at(this.rho_inf, this.nf_inf) * this.a0_share
  symbols (rho: Real, nf: Real): {} => {
    s := { }
    /* the settled vacuum stands under whatever the bodies put on it, where the medium runs on it */
    s["ρ"] = rho
    s["n_f"] = this.vacuum ? nf + this.nf_inf : nf
    s["DEG"] = this.DEG
    fac := this.aggregate.base["F"]
    s["F"] = this.facing & fac != None ? fac : 1
    om := this.aggregate.base["\\omega"]
    s["ω"] = om == None ? 1 : om
    s["β"] = 0
    s["m_l"] = 0
    this.terms.for(t => { s[t.rate] = 1 if t.rate != None & s[t.rate] == None })
    s
  }
  share (t: *, s: {}): Real => {
    v := t.doing.share.at(s)
    v < 0 ? 0 : (v > 1 ? 1 : v)
  }
  activity (x: Real): Real => x < 0 ? 0 : (x > 1 ? 1 : x)

  at (x: Z, y: Z): Z => (x < 0 | y < 0 | x >= this.N | y >= this.N) ? -1 : y * this.N + x
  column_of (c: N): N => c % this.N
  row_of (c: N): N => (c - c % this.N) / this.N
  /* which plane a body's rays are on: its tag, or the vacuum's where nothing is tagged */
  plane_of (h: Hole): N => (h.tag == None | h.tag < 1) ? 0 : (h.tag < this.planes ? h.tag : this.planes - 1)

  /* a body put in: where it stands, in cells, and the momentum it was thrown with */
  add (h: Hole): Hole => {
    h.momentum = Vector(components: [h.px, h.py])
    h.advance = Vector.zero(2)
    this.holes.push(h)
    this.block
    h
  }
  /* the c-bar a body stands on: the K by K cells round its cell */
  under (h: Hole): N[] => {
    half := ((this.K - 1) / 2).floor
    out := []
    Array.range(this.K).for(dy => {
      Array.range(this.K).for(dx => {
        c := this.at(h.x.round - half + dx, h.y.round - half + dy)
        out.push(c) if c >= 0
      })
    })
    out
  }
  /*
   * THE CELLS A BODY'S POINT COVERS, BY AREA: its c-bar is K by K cells about where it truly stands, and each of those
   * lands on the four cells around its own true place, as every other step of the medium does - so nothing a body does
   * jumps when it crosses from one cell to the next
   */
  spread (h: Hole): Real[][] => {
    half := Real.of(this.K - 1) / 2
    out := []
    Array.range(this.K).for(dy => {
      Array.range(this.K).for(dx => {
        px := h.x - half + Real.of(dx)
        py := h.y - half + Real.of(dy)
        x0 := px.floor
        y0 := py.floor
        ax := px - Real.of(x0)
        ay := py - Real.of(y0)
        Array.range(2).for(j => {
          Array.range(2).for(i => {
            c := this.at(x0 + i, y0 + j)
            w := (i == 0 ? 1 - ax : ax) * (j == 0 ? 1 - ay : ay)
            out.push([Real.of(c), w]) if c >= 0 & w > 0
          })
        })
      })
    })
    out
  }
  block () => {
    Array.range(this.cells).for(c => { this.blocks[c] = 0 })
    Array.range(this.holes.length).for(k => { this.under(this.holes[k]).for(c => { this.blocks[c] = k + 1 }) })
  }
  masses (): Real[] => this.holes.map(h => h.mass)

  /* a field read by area at a true position (x, y) in cells, with what stands across the box's edge */
  tap (f: Real[], base: N, x: Real, y: Real, outside: Real): Real => {
    x0 := x.floor
    y0 := y.floor
    ax := x - Real.of(x0)
    ay := y - Real.of(y0)
    cell_value := (i: Z, j: Z): Real => {
      k := this.at(i, j)
      k >= 0 ? f[base + k] : outside
    }
    got := (1 - ax) * (1 - ay) * cell_value(x0, y0)
    got = got + ax * (1 - ay) * cell_value(x0 + 1, y0)
    got = got + (1 - ax) * ay * cell_value(x0, y0 + 1)
    got + ax * ay * cell_value(x0 + 1, y0 + 1)
  }

  /*
   * A PLANE THROUGH A WORLD OF D DIMENSIONS. What a body sends crosses a shell round it, so what arrives on a way is
   * what it sent over that shell - R^(D-1) of it (`transport.thinning`, the model's own 1/l.shell). Streamed in the
   * plane it spreads over R of that by the headings' own fanning out, so what a heading carries from one c-bar back
   * is thinned by the ratio of the two distances from that body, to the power D - 2. That fanning out is the line's
   * resolution: one heading's carry only spreads where the next heading's has come to meet it, so a line wants
   * headings enough that they meet inside the view - else a body on a heading's own way reads too much
   */
  slice (h: Hole?, x: Real, y: Real, bx: Real, by: Real): Real => {
    return 1 if this.D <= 2 | h == None
    near := this.face_of(h)
    here := Fmt.max(near, Fmt.hypot(x - h.x, y - h.y) / Real.of(this.K))
    back := Fmt.max(near, Fmt.hypot(bx - h.x, by - h.y) / Real.of(this.K))
    (back / here) ^ Real.of(this.D - 2)
  }
  nearest (x: Real, y: Real): Hole? => {
    best := None
    far := 0
    this.holes.for(h => {
      d := Fmt.hypot(x - h.x, y - h.y)
      if best == None | d < far { best = h; far = d }
    })
    best
  }

  /* THE BOX AS THE TICK OPENED: every step reads these */
  was: Real[][] = []
  rho_was: Real[] = []
  nf_was: Real[] = []
  /* the record still standing once this tick's creation has handed back what it hands back */
  stand: Real[] = []
  open () => {
    cells := this.cells
    this.was = this.beam.map(rung => Array.range(this.rungs).map(i => rung[i]))
    this.rho_was = Array.range(cells).map(c => {
      x := Real.of(this.column_of(c))
      y := Real.of(this.row_of(c))
      got := 0
      Array.range(this.planes - 1).for(i => { got = got + this.sent_to(i + 1, x, y)[0] })
      /* what stands at a point is the vacuum's own population and what the bodies have sent there */
      this.activity(this.vacuum ? got + this.vac[c] : got)
    })
    this.nf_was = Array.range(cells).map(c => this.fold[c])
    Array.range(cells).for(c => { this.growth[c] = 0; this.gone[c] = 0 })
  }


  /*
   * MEET: one body's rays against another's, where two fields meet. At a cell each body's rays go the way out from it,
   * and a way of a point is one of the lattice's DEG, so the two meet on as much of the point's ways as those two ways
   * have in common, one head on to the other. What that folds stands at the cell; what it takes of the rays themselves
   * is what the model's own `reach` counts, and at these rates it is a millionth of them a tick
   */
  meet () => {
    cells := this.cells
    P := this.planes
    Array.range(cells).for(c => {
      x := Real.of(this.column_of(c))
      y := Real.of(this.row_of(c))
      s := this.symbols(this.rho_was[c], this.nf_was[c])
      Array.range(P - 1).for(i => {
        z := i + 1
        ours := this.sent_to(z, x, y)
        if ours[0] > 0 {
          Array.range(P - 1).for(j => {
            yy := j + 1
            if yy != z {
              theirs := this.sent_to(yy, x, y)
              if theirs[0] > 0 {
                over := this.facing_share(ours[1], ours[2], theirs[1], theirs[2])
                if over > 0 {
                  this.meets.for(t => {
                    w := this.share(t, s) * this.activity(ours[0]) * this.activity(theirs[0]) * over
                    this.fold[c] = Fmt.max(0, this.fold[c] + w * t.doing.folds.at(s) / 2)
                    this.growth[c] = this.growth[c] + w * t.doing.space.at(s) / 2
                    this.gone[c] = this.gone[c] + w * t.doing.folds.at(s).abs / 2
                  })
                }
              }
            }
          })
        }
        /*
         * AND AGAINST THE VACUUM'S OWN, where the medium runs on the settled vacuum. Its rays stand on every way
         * there is, so what faces a body's ray head on is one way of the lattice's - and what that folds is written
         * where it happened, the same as any other meeting
         */
        if this.vacuum {
          theirs := this.rho_inf
          this.meets.for(t => {
            w := this.share(t, s) * this.activity(ours[0]) * this.activity(theirs) / Real.of(this.DEG)
            this.fold[c] = Fmt.max(0, this.fold[c] + w * t.doing.folds.at(s) / 2)
            this.growth[c] = this.growth[c] + w * t.doing.space.at(s) / 2
            this.gone[c] = this.gone[c] + w * t.doing.folds.at(s).abs / 2
          })
        }
      })
    })
  }



  /*
   * UNFOLD: in a dark half every point splits that nothing out of the beat's phase stands on, and creation hands back
   * the folds it holds, on the term's own share. A lit half hands nothing back: no point is neutral then
   */
  unfold () => {
    cells := this.cells
    this.stand = Array.range(cells).map(c => this.nf_was[c])
    unless this.lit {
      Array.range(cells).for(c => {
        s := this.symbols(this.rho_was[c], this.nf_was[c])
        this.points.for(t => {
          back := t.doing.folds.at(s)
          if back != 0 {
            h := this.share(t, s) * back
            this.fold[c] = Fmt.max(0, this.fold[c] + h)
            this.stand[c] = Fmt.max(0, this.stand[c] + h)
          }
        })
      })
    }
  }

  /*
   * STREAM: what was not taken goes one c-bar on, the way it was going - out from the body it came from - and what a
   * body sends crosses a shell as it goes, so it is thinned by the ratio of the two distances to the power D - 1
   * (`transport.thinning`, the model's own 1/l.shell). The box is a window: nothing comes in across its edge
   */
  stream () => {
    /* one c-bar on, out from the body it came from, thinned over the shell it crosses (`transport.thinning`) */
    Array.range(this.planes - 1).for(i => {
      z := i + 1
      near := this.face_of(this.body_of(z))
      was := Array.range(this.rungs).map(r => this.beam[z][r])
      Array.range(this.rungs).for(r => {
        here := Fmt.max(near, Real.of(r))
        back := Fmt.max(near, Real.of(r) - 1)
        this.beam[z][r] = r == 0 ? 0 : was[r - 1] * ((back / here) ^ Real.of(this.D - 1))
      })
    })
  }


  /* MAKE: what the point terms grow, read at every point as the tick opened */
  /*
   * THE VACUUM'S OWN POPULATION, WHICH IS NOT GIVEN. A mass is a place where the vacuum's own balance is disturbed -
   * that is what a mass IS - so rho is a field the medium runs rather than a number it is handed: at each point the
   * rays line of the continuous model, made against taken, with what the bodies put there standing in the reading.
   * Where there is no body it settles where the line nets nought, which is rho_infinity, and near one it does not
   */
  vac: Real[] = Array.filled(this.cells, this.aggregate.rho_inf)
  /* what the rays line nets at a point, off the same terms every other reading is made of (Continuum.right) */
  nets (rho: Real, nf: Real): Real => {
    s := this.symbols(rho, nf)
    got := 0
    /* what a point makes counts the lattice's ways already, since CREATION lights every one of them */
    this.points.for(t => { got = got + this.share(t, s) * t.doing.rays.at(s) })
    this.singles.for(t => { got = got + this.share(t, s) * s["ρ"] * t.doing.rays.at(s) })
    /* a meeting needs two, and takes one from each end */
    this.meets.for(t => { got = got + this.share(t, s) * s["ρ"] * s["ρ"] * t.doing.rays.at(s) })
    got
  }
  /*
   * and the population stands where that line nets nought, which is what the chain does with it: the rates are the
   * lattice's ways a tick, far faster than a tick, so what a point holds is the ROOT of its own balance and not a
   * thing that crawls toward it. Where a body has put rays of its own, the balance is struck against those too -
   * so the vacuum is thinner where a body is, which is the whole of what a mass does to it (`\rho at R`)
   */
  settle_rho () => {
    return if !this.vacuum
    Array.range(this.cells).for(c => {
      /* what the bodies have put at this point, which the vacuum's own has to make room beside */
      mine := this.rho_was[c] - this.vac[c]
      theirs := mine < 0 ? 0 : mine
      nf := this.nf_was[c]
      lo := 0
      hi := 1
      /* the line falls with the population, so one bisection finds where it nets nought */
      Array.range(24).for(i => {
        mid := (lo + hi) / 2
        both := mid + theirs
        if this.nets(both > 1 ? 1 : both, nf) > 0 { lo = mid } else { hi = mid }
      })
      this.vac[c] = (lo + hi) / 2
    })
  }

  make () => {
    cells := this.cells
    Array.range(cells).for(c => {
      s := this.symbols(this.rho_was[c], this.nf_was[c])
      this.points.for(t => {
        this.growth[c] = this.growth[c] + this.share(t, s) * t.doing.space.at(s)
      })
      this.singles.for(t => {
        this.growth[c] = this.growth[c] + this.share(t, s) * this.rho_was[c] * t.doing.space.at(s)
      })
    })
  }

  /* SOURCE: what a body announces stands where it truly is, spread over the c-bar it covers and by area */
  /*
   * WHETHER THE VACUUM IS LIT WHERE AND WHEN SOMETHING LEAVES. CREATION fires at a point with nothing going on and
   * lights every way of it, so a point that has just fired leaves its neighbours occupied and they cannot: the ways
   * of a lattice that is two-coloured alternate, and what stands is one number, (the tick and the place's own colour).
   * A ray crosses K cells a tick and K is odd, so that number is the SAME for it its whole life - it carries no phase
   * of its own, and yet what becomes of it was settled by where and when it left (`closing`: the two pulses)
   */
  phase: boolean = false
  lit_at (x: Real, y: Real): boolean => (this.ticks + x.round + y.round) % 2 == 0
  shine () => {
    /* what a body announces stands on it, at the first rung out: its ways over the lattice's, on the source term's own share */
    this.holes.for(h => {
      z := this.plane_of(h)
      this.beam[z][0] = this.beam[z][0] + this.per_way(h)
    })
    /* a way holds at most one ray out of the beat's phase */
    Array.range(this.planes).for(z => {
      Array.range(this.rungs).for(r => { this.beam[z][r] = Fmt.min(1, this.beam[z][r]) })
    })
  }


  /*
   * WHERE A POINT AT (x, y) IS GOING (Transport: `sinks`): into the point that folds it. A ray of it is met, and the
   * point folded that way, at the meeting term's share times what faces it from that way - a body's rays, come from
   * that body - against the draw's own straight on. Rays of plane `zown` are its own and face it never. A point that
   * is going somewhere meets what faces it the sooner for going at it, the later for going away
   */
  /*
   * WHAT IS FELT IS WHAT ARRIVES, ENHANCED BY THE MISMATCH THAT ACCUMULATED OVER ONE FREE PATH (`closing`), and what
   * that mismatch is measured against is the only rate the vacuum has: a_0 over the acceleration THERE. The medium
   * already carries that acceleration at every cell - it is the lean it left last tick - so the recursion is read
   * where the field is, not at the body: weak field, large factor; strong field, none. Nothing is solved here, the
   * tick is what closes it, and where nothing has been felt yet what arrives stands as it is
   */
  recur_at (x: Real, y: Real, gn: Real): Real => {
    return 1 if this.own != 2 | !(gn > 0)
    a0 := this.a0_vacuum()
    return 1 if !(a0 > 0)
    gx := this.tap(this.lean_x, 0, x, y, 0)
    gy := this.tap(this.lean_y, 0, x, y, 0)
    was := Fmt.hypot(gx, gy)
    /* g = sqrt(g_N(g + a_0)) is g = g_N(1 + a_0/g) written as the mean it is, and it is the form that settles: where
     * nothing has been felt yet the first reading is the deep limit itself, and a strong field gives the arrival back */
    (gn * (was + a0)) ^ 0.5 / gn
  }
  pull_at (x: Real, y: Real, zown: N, vx: Real, vy: Real): Real[] => {
    half := Real.of(this.K - 1) / 2
    gx := 0
    gy := 0
    Array.range(this.K).for(dy => {
      Array.range(this.K).for(dx => {
        px := x - half + Real.of(dx)
        py := y - half + Real.of(dy)
        s := this.symbols(this.tap(this.rho_was, 0, px, py, 0), this.tap(this.nf_was, 0, px, py, 0))
        rate := 0
        this.meets.for(t => { rate = rate + this.share(t, s) * t.doing.folds.at(s) / 2 })
        stood := this.tap(this.stand, 0, px, py, 0)
        Array.range(this.planes - 1).for(i => {
          z := i + 1
          unless z == zown {
            came := this.sent_to(z, px, py)
            /* what comes at this point comes the way out from that body, so the point is folded toward it */
            share := rate * this.activity(came[0]) / (1 + stood)
            gx = gx - share * came[1]
            gy = gy - share * came[2]
          }
        })
      })
    })
    n := Real.of(this.K * this.K)
    f := this.recur_at(x, y, Fmt.hypot(gx / n, gy / n))
    [gx / n * f, gy / n * f]
  }


  /* the same at every cell, for what a panel draws: nothing of the body standing there is what faces it */
  lean () => {
    Array.range(this.cells).for(c => {
      own := this.blocks[c] > 0 ? this.plane_of(this.holes[this.blocks[c] - 1]) : 0
      g := this.pull_at(Real.of(this.column_of(c)), Real.of(this.row_of(c)), own, 0, 0)
      this.lean_x[c] = g[0]
      this.lean_y[c] = g[1]
    })
  }

  /*
   * SWEEP: what each body's rays stand at, a cell at a time, as the tick leaves them - what a panel draws and what a
   * reading reads. A body's rays are its own profile, so this is that profile read at each cell's distance from it
   */
  swept: Real[][] = Array.range(this.planes).map(z => Array.filled(this.cells, 0))
  sweep () => {
    Array.range(this.planes - 1).for(i => {
      z := i + 1
      Array.range(this.cells).for(c => {
        this.swept[z][c] = this.sent_to(z, Real.of(this.column_of(c)), Real.of(this.row_of(c)))[0]
      })
    })
  }

  tick () => {
    /* what was sent goes on and the bodies announce first, so the whole tick reads one and the same field */
    this.stream
    this.shine
    this.open
    this.meet
    this.unfold
    this.make
    this.settle_rho
    this.keep_track
    /* the bodies go where they were folded, and what a panel draws is read of where that leaves them */
    this.move
    this.lean
    this.sweep
    this.ticks = this.ticks + 1
  }

  lean_under (h: Hole): Real[] => this.pull_at(h.x, h.y, this.plane_of(h), h.momentum.components[0] / h.mass, h.momentum.components[1] / h.mass)

  /*
   * MOVE, locally (Transport): a body is turned by the lean at the c-bar it stands on, keeps it as momentum, and goes
   * as its momentum says. What the world grew is not a push from elsewhere: a grown point is held where it was made,
   * and the folds and unfolds it comes to are already in the record the lean is read off
   */
  /* where each body is going, as the tick left it: read for every body, kept, and given to the ones that move */
  pulled: Real[][] = []
  move () => {
    this.pulled = this.holes.map(h => this.lean_under(h))
    Array.range(this.holes.length).for(i => {
      h := this.holes[i]
      if h.moves {
        g := this.pulled[i]
        h.momentum = h.momentum + Vector(components: [g[0] * h.mass, g[1] * h.mass])
        h.momentum = h.momentum.unit * h.mass if h.momentum.norm > h.mass
        h.x = h.x + h.momentum.components[0] / h.mass * Real.of(this.K)
        h.y = h.y + h.momentum.components[1] / h.mass * Real.of(this.K)
        h.moved = h.moved + 1
      }
    })
    this.block
  }

  /* WHAT A PANEL READS: what arrived at a cell on plane z (0 the vacuum's, 1.. a body's), in rays' worth over the point's ways */
  arrived (z: N, c: N): Real => this.swept[z < this.planes ? z : this.planes - 1][c]
  record_at (c: N): Real => this.fold[c]

  record (): Real[] => Array.range(this.cells).map(c => this.record_at(c))
  /*
   * THE FIELD AS IF IT HAD ALWAYS BEEN THERE (a setup's instant range): the bodies, held, announce until what they
   * send STANDS - until what a body's point is going by stops moving from one beat to the next, by less than a
   * thousandth of it - and no longer than it takes a ray to cross the box a few times over
   */
  /*
   * THE FIELD AS IF IT HAD ALWAYS BEEN THERE: what a body sends stands at every distance at once, on the shell's own
   * falloff - which is where streaming leaves it, a rung a tick, once it has run for ever (`transport.thinning`)
   */
  seed () => {
    /* what stands is what the bodies send as they are now: a body that has been given its throw sends less for it */
    Array.range(this.planes).for(z => {
      Array.range(this.rungs).for(r => { this.beam[z][r] = 0 })
    })
    this.holes.for(h => {
      z := this.plane_of(h)
      per := this.per_way(h)
      near := this.face_of(h)
      Array.range(this.rungs).for(r => {
        here := Fmt.max(near, Real.of(r))
        this.beam[z][r] = Fmt.min(1, this.beam[z][r] + per * ((near / here) ^ Real.of(this.D - 1)))
      })
    })
  }

  settle () => {
    this.seed
    before := 0
    done := false
    Array.range(4 * this.crossing).for(i => {
      unless done {
        this.tick
        if this.ticks % 2 == 0 {
          now := 0
          this.holes.for(h => {
            g := this.lean_under(h)
            now = now + Fmt.hypot(g[0], g[1])
          })
          done = true if i > 2 & now > 0 & (now - before).abs < now / 1000
          before = now
        }
      }
    })
  }

  /* a c-bar a tick across the box, corner to corner, and even so the beat is where it was */
  crossing (): N => 2 * ((Real.of(this.N) / Real.of(this.K)).floor + 1)

  record_above (c: N): Real => this.record_at(c) - this.nf_inf
  /* the medium's own pull at a place, toward another: read by area, in c-bar a tick a tick */
  pull_toward (x: Real, y: Real, mx: Real, my: Real, zown: N): Real => {
    dx := mx - x
    dy := my - y
    d := Fmt.hypot(dx, dy)
    return 0 if d <= 0
    g := this.pull_at(x, y, zown, 0, 0)
    (g[0] * dx + g[1] * dy) / d
  }
  pull_x (c: N): Real => this.lean_x[c]
  pull_y (c: N): Real => this.lean_y[c]
  grown (c: N): Real => this.record_at(c) - this.nf_inf
  crossed (c: N): Real => this.gone[c]
  rho_at (c: N): Real => {
    got := 0
    Array.range(this.planes).for(z => { got = got + this.swept[z][c] })
    this.activity(got)
  }

  rho (): Real[] => Array.range(this.cells).map(c => this.rho_at(c))
  mean (): Real => this.rho.sum / Real.of(this.cells)
  state (): Real[] => Array.range(this.cells).map(c => this.rho_at(c))
  bodies (): Hole[] => this.holes
  mass (h: Hole): Real => h.mass

  /* a body put down at a cell with a momentum, for a fixture */
  thrown (x: Real, y: Real, mx: Real, ways: N, px: Real, py: Real, tag: N): Medium => {
    h := Hole(x: x, y: y, mx: mx, ways: ways)
    h.px = px
    h.py = py
    h.tag = tag
    h.moves = true
    this.add(h)
    this
  }
}

Theory += {
  /* the continuous model of this theory on an N by N box; `tags` planes, the vacuum's and one per kind of body */
  /* the theory's own lattice unless another is named: DEG ways, a world of D dimensions the box is a plane through */
  medium (N: N, A: N = 96, K: N = 3, DEG: N? = None, tags: N = 1, D: N? = None): Medium => Medium(theory: this, N: N, A: A, K: K, DEG: DEG ?? this.lattice.DEG, tags: tags, D: D ?? this.lattice.D)
}
