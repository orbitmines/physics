/*
 * A RULE ON A LINE, DRAWN. One rule of a theory, on the smallest world it can act on - a 1-D lattice
 * (LINE2) of two points - before on the left and after on the right. Nothing in the picture is told
 * what the rule does: the world is seeded, the rule's own `matches` are taken and its own `apply` is
 * run on each, and what the lanes show is whatever the rule left. Change the rule, and the strip
 * changes with it.
 *
 * WHAT A RAY LOOKS LIKE HERE (the old LINES.tsx, kept 1-1): a ray is a cell it came from, a node it
 * is on, and a cell it is going into. A faint bar behind the head, the head sitting ON the node, and
 * a solid bar of the same colour in front of it - so the head marks where the ray is and the bars
 * say which way it came and which way it is about to go. Half a cell either side, because the edge
 * runs to the midpoint between its node and the next. Points are dots, the same whether the rule
 * made them or not: a point the rule makes simply appears, a point it folded away simply is not there.
 *
 * THE INK IS A CHOICE. Gravity has no polarity, so every ray is neutral; a theory that gives a ray
 * a charge colours it by that (`Ink.RED` and `Ink.BLUE` are the two the article uses) by handing the
 * strip an `Ink` whose `ray_ink` reads the ray. Everything about how a strip LOOKS is on the Ink.
 */

/* how a strip is inked: colours as rgb triplets, since each part of a ray is drawn at its own alpha */
Ink := class {
  static BACK = "#08090d"
  static NEUTRAL = "140,147,168"
  /* the two polarities, where a theory has them: indianred, and the model's blue (Panel.ONE) */
  static RED = "205,92,92"
  static BLUE = "74,168,235"
  /* the colour of a ray, as a program of the ray; None is neutral */
  ray_ink: Program? = None
  ink_of (r: Ray): String => this.ray_ink == None ? Ink.NEUTRAL : this.ray_ink(r)
  /* the bar behind is spent, the bar in front is the claim being made, the head is the ray itself */
  behind: Real = 0.32
  front: Real = 1
  head: Real = 0.97
  dot: Real = 0.60
  line: Real = 0.16
  /* every point of a lane drawn, not only the ones a ray is on or heading into - for a world that is ABOUT its points, as an expanding one is */
  every: boolean = false
  /* room above the lanes, for what a source is said to be doing */
  top: Real = 0
  /* where a film looks, the whole film long: None centres every lane of a strip on what it shows */
  centre: Real? = None
  /* a source's cell: the panels' body colour (Panel.ONE), a square round the node it owns, and what it is doing written over it in the same */
  static SOURCE = "74,168,235"
}

/* a ray as drawn: the node it is on, which way it points (+1 / -1 along the line), and its ink */
Side := class < at: Real, sign: Real, ink: String { }

/* one lane of a strip: the live points and the active rays of a world, read off it - and the nodes its sources own, and what they are doing */
Lane := class < points: Real[], sides: Side[] {
  sources: Real[] = []
  says: String = ""
}

/*
 * A SOURCE THAT FOLLOWS A SCRIPT: the choices G leaves to a source, made tick by tick so a film can show each of them.
 * `plan[t]` is what it emits on tick t + 1: "+" the way up the line, "-" the way down, both, or "" for nothing;
 * `weight` is its mass. Nothing else about it is chosen here - what it DOES with the choice is G's own rules
 */
Scripted := class < Source, plan: String[], weight: Real {
  choose "emit?" (exit: N): boolean => {
    ways := this.plan[this.world.ticks - 1] ?? ""
    this.world.geometry.V(exit).components[0] > 0 ? ways.contains("+") : ways.contains("-")
  }
  choose "mass" (): Real => this.weight
}

Strip := class {
  /* a line of N points with room to grow either side - a rule that makes space needs the margin */
  static line (theory: Theory, N: N): World => theory.seed(LINE2, N, 0, 250000, 2)
  /* the exit of a point on the line that leads the given way */
  static exit_toward (w: World, sign: Real): N => Array.range(w.geometry.DEG).filter(d => w.geometry.V(d).components[0] * sign > 0).first
  /* the point at position `at` on the line */
  static point_at (w: World, at: N): Vertex => w.at(Vector(components: [Real.of(at)]))
  /* light the ray of the point at `at` that heads the given way */
  static light (w: World, at: N, sign: Real) => { Strip.point_at(w, at).rays[Strip.exit_toward(w, sign)].activate }

  /* THE SEEDS - the smallest arrangements a rule of the vacuum acts on, each a program of the theory */
  /* two rays facing each other across the one edge: a meeting */
  static meeting (theory: Theory): World => {
    w := Strip.line(theory, 2)
    Strip.light(w, 0, 1)
    Strip.light(w, 1, 0 - 1)
    w
  }
  /* what the named rules leave of a seed: the world after them, as a seed for the next rule */
  static left (theory: Theory, laying: Program, ids: String[]): World => {
    w := laying(theory)
    Strip.run(w, ids)
    w
  }
  /* one point on the line and nothing else: no ray, no neighbour - the whole of what the vacuum is handed. The margin is only room: the world stops growing at it, so it is wider than any film runs */
  static point (theory: Theory): World => theory.seed(LINE2, 1, 0, 250000, 16)
  /* one ray on the middle point of three, heading the given way into its neighbour */
  static heading (theory: Theory, sign: Real): World => {
    w := Strip.line(theory, 3)
    Strip.light(w, 1, sign)
    w
  }

  /* the rules named, each run on its own matches in the world - the reference semantics of one pass */
  static run (w: World, ids: String[]) => {
    ids.for(rid => {
      rule := w.theory.rules.filter(r => r.id == rid).first
      fail("{w.theory.name} has no rule {rid}") if rule == None
      rule.matches(w).for(x => { rule.apply(x) })
    })
  }

  /* what `World.tick` does before its rules: the tick counted, every source's one action a tick handed back - so a film can run some of the rules as a tick would */
  static begin (w: World) => {
    w.ticks = w.ticks + 1
    w.sources.for(s => { s.stepped = false; s.moved_along = None })
  }

  /* the rays one lane has on a node and heading that the other did not: what a rule lit between the two readings */
  static lit (was: Lane, now: Lane): Side[] => now.sides.filter(sd => was.sides.every(o => o.at != sd.at | o.sign != sd.sign))

  /* what a source did between two readings, in words: the ways its rule lit - nothing said where it lit none */
  static emitting (was: Lane, now: Lane): String => {
    new_rays := Strip.lit(was, now)
    left := new_rays.some(sd => sd.sign < 0)
    right := new_rays.some(sd => sd.sign > 0)
    return "emits both ways" if left & right
    return "emits left" if left
    return "emits right" if right
    ""
  }

  /* the world as a lane: every live point, every active ray, every node a source owns */
  static lane (w: World, ink: Ink): Lane => {
    pts := w.live.map(v => v.at.components[0])
    sides := []
    w.live.for(v => {
      v.rays.for(r => {
        sides.push(Side(at: v.at.components[0], sign: r.along.components[0], ink: ink.ink_of(r))) if r.active
      })
    })
    l := Lane(points: pts, sides: sides)
    w.sources.for(s => { s.cells.for(c => { l.sources.push(c.at.components[0]) }) })
    l
  }

  /* a strip: each seed laid, read, run through the rules, and read again - then drawn as a still */
  static of (id: String, what: String, theory: Theory, ids: String[], seeds: Program[], ink: Ink): Picture => {
    rows := seeds.map(laying => {
      w := laying(theory)
      before := Strip.lane(w, ink)
      Strip.run(w, ids)
      [before, Strip.lane(w, ink)]
    })
    H := 70 * rows.length
    pic := Picture.still(id, what, 900, H, (s: Surface) => { Strip.paint(s, rows, ink, [0, 1]) })
    /* and in parts: each lane a pane of its own, so a page can stack them and give each the whole width */
    pic.panes = [
      Pane(name: "before", width: Strip.PANE, height: H, paints: (s: Surface) => { Strip.paint(s, rows, ink, [0]) }),
      Pane(name: "after", width: Strip.PANE, height: H, paints: (s: Surface) => { Strip.paint(s, rows, ink, [1]) })
    ]
    pic
  }

  /* a seed and every tick the theory's own rules make of it, as lanes: the seed first, then the world after each tick */
  static history (theory: Theory, laying: Program, ticks: N, ink: Ink): Lane[] => {
    w := laying(theory)
    lanes := [Strip.lane(w, ink)]
    Array.range(ticks).for(t => {
      w.tick
      lanes.push(Strip.lane(w, ink))
    })
    lanes
  }

  /*
   * A SEED, RUN - a film of one lane, a tick at a time: every rule of the theory in its own order (`World.tick`), so
   * nothing here says what the vacuum does to what it was given. The window is the last tick's, from the first frame,
   * so the line does not rescale under the reader as it grows; the still is the last tick
   */
  static film (id: String, what: String, theory: Theory, laying: Program, ticks: N, ink: Ink): Picture => {
    lanes := Strip.history(theory, laying, ticks, ink)
    ink.centre = Strip.centre_of(lanes)
    PER := 14
    HOLD := 3
    Picture(id: id, what: what, width: 900, height: 90, frames: (ticks + 1 + HOLD) * PER, paint: (played: Played?) => Unrolling(lanes: lanes, ink: ink, per: PER))
  }

  /* A FILM OF WHAT A SOURCE DOES, A TICK AT A TIME: lanes that each say it (`Lane.says`), each held long enough to read */
  static tell (id: String, what: String, lanes: Lane[], ink: Ink): Picture => {
    ink.centre = Strip.centre_of(lanes)
    PER := 40
    HOLD := 1
    Picture(id: id, what: what, width: 900, height: 110, frames: (lanes.length + HOLD) * PER, paint: (played: Played?) => Unrolling(lanes: lanes, ink: ink, per: PER))
  }

  /* the points a row is about: the node each ray is on, the node it is going into, each source's, and what one lane has that the other has not */
  static relevant (pair: Lane[]): {} => {
    rel := { }
    pair.for(l => { l.sides.for(sd => { rel["{sd.at}"] = true; rel["{sd.at + sd.sign}"] = true }) })
    pair.for(l => { l.sources.for(p => { rel["{p}"] = true }) })
    has0 := { }
    has1 := { }
    pair[0].points.for(p => { has0["{p}"] = true })
    pair[1].points.for(p => { has1["{p}"] = true })
    pair[0].points.for(p => { rel["{p}"] = true if has1["{p}"] == None })
    pair[1].points.for(p => { rel["{p}"] = true if has0["{p}"] == None })
    rel
  }

  /* where a film is centred: the middle of where its sources go, or of the seed's points where it has none - so the line does not move under the reader */
  static centre_of (lanes: Lane[]): Real => {
    xs := []
    lanes.for(l => { l.sources.for(p => { xs.push(p) }) })
    xs = lanes.first.points if xs.empty
    return 0 if xs.empty
    (xs.reduce(xs.first, (a_, b_) => Fmt.min(a_, b_)) + xs.reduce(xs.first, (a_, b_) => Fmt.max(a_, b_))) / 2
  }

  /* the layout: the margin at the sides, the gap between lanes, and the width of one lane drawn alone */
  static PAD = 12
  static MID = 30
  static PANE = (900 - 2 * 12 - 30) / 2 + 2 * 12

  /*
   * BEFORE ON THE LEFT, AFTER ON THE RIGHT, ON AS FEW POINTS AS THE RULE NEEDS - or either lane alone,
   * as a pane (`lanes` says which, in what order). One scale for the strip, so a cell is the same size
   * on every row; one window per row - the node each ray is on, the
   * node it is going into, and any point one lane has that the other does not, which is precisely what
   * a fold and an unfold do.
   */
  static paint (s: Surface, rows: Lane[][], ink: Ink, lanes: N[]) => {
    width := s.width
    H := s.height
    s.clear_rect(0, 0, width, H)
    s.fill_style(Ink.BACK)
    s.fill_rect(0, 0, width, H)
    return if rows.empty

    /* the window: every cell a ray sits on or is heading into, over both lanes of every row */
    seen := false
    lo := 0
    hi := 0
    rows.for(pair => {
      pair.for(l => {
        l.sides.for(sd => {
          to := sd.at + sd.sign
          unless seen { lo = sd.at; hi = sd.at; seen = true }
          lo = Fmt.min(lo, Fmt.min(sd.at, to))
          hi = Fmt.max(hi, Fmt.max(sd.at, to))
        })
      })
    })
    /* and every node a source owns, with a node either side of it: what it might light */
    rows.for(pair => {
      pair.for(l => {
        l.sources.for(p => {
          unless seen { lo = p; hi = p; seen = true }
          lo = Fmt.min(lo, p - 1)
          hi = Fmt.max(hi, p + 1)
        })
      })
    })
    /* and, on a strip, every point it draws - a fold or an unfold can leave one past the rays */
    unless ink.every {
      rows.for(pair => {
        rel := Strip.relevant(pair)
        pair.for(l => {
          l.points.for(p => {
            if rel["{p}"] != None {
              unless seen { lo = p; hi = p; seen = true }
              lo = Fmt.min(lo, p)
              hi = Fmt.max(hi, p)
            }
          })
        })
      })
    }
    unless seen { lo = 0 - 1; hi = 0 }
    /* a film looks where it is told to, with room for everything either side; a strip is as wide as its widest row, and each lane is centred below */
    EXT := (hi - lo) / 2 + 0.4
    EXT = Fmt.max(ink.centre - lo, hi - ink.centre) + 0.4 if ink.centre != None
    HEAD := ink.top
    PAD := Strip.PAD
    MID := Strip.MID
    lanew := (width - 2 * PAD - MID * (lanes.length - 1)) / lanes.length
    origin := (k_: N): Real => PAD + k_ * (lanew + MID)
    rowH := (H - HEAD) / rows.length
    CELL := lanew / (2 * EXT + 1)
    MID_AT := 0
    X := (k_: N, x: Real): Real => origin(k_) + lanew / 2 + (x - MID_AT) * CELL

    Array.range(rows.length).for(r => {
      pair := rows[r]
      y := HEAD + rowH * (r + 0.5)
      rel := Strip.relevant(pair)

      Array.range(lanes.length).for(k_ => {
        fi := lanes[k_]
        l := pair[fi]
        ox := origin(k_)
        /* CENTRED ON WHAT IT SHOWS: the middle of what is drawn in this lane - each ray a quarter of a cell either side of its node, each source's square, each point drawn - so before and after both sit in the middle of their own lane */
        if ink.centre != None { MID_AT = ink.centre } else {
          xs := []
          l.sides.for(sd => { xs.push(sd.at - 0.25); xs.push(sd.at + 0.25) })
          l.sources.for(p => { xs.push(p - 0.3); xs.push(p + 0.3) })
          l.points.for(p => { xs.push(p) if ink.every | rel["{p}"] != None })
          MID_AT = xs.empty ? (lo + hi) / 2 : (xs.reduce(xs.first, (a_, b_) => Fmt.min(a_, b_)) + xs.reduce(xs.first, (a_, b_) => Fmt.max(a_, b_))) / 2
        }
        s.stroke_style("rgba({Ink.NEUTRAL},{ink.line})")
        s.line_width(1)
        s.begin_path
        s.move_to(ox, y)
        s.line_to(ox + lanew, y)
        s.stroke

        /* points first, then the rays over them, then the heads: a point is a point, made this tick or not */
        l.points.for(p => {
          if ink.every | rel["{p}"] != None {
            s.fill_style("rgba({Ink.NEUTRAL},{ink.dot})")
            s.begin_path
            s.arc(X(k_, p), y, 2.6, 0, 2 * Real.PI)
            s.fill
          }
        })

        /* a source: a square round the node it owns, under the rays - a ray it lights stands on the node beside it */
        l.sources.for(p => {
          half := Fmt.max(9, Fmt.min(18, CELL * 0.3))
          sx := X(k_, p)
          s.fill_style("rgba({Ink.SOURCE},0.14)")
          s.fill_rect(sx - half, y - half, 2 * half, 2 * half)
          s.stroke_style("rgba({Ink.SOURCE},0.9)")
          s.line_width(1.5)
          s.stroke_rect(sx - half, y - half, 2 * half, 2 * half)
          /* and what it is doing, on a line up from it */
          unless l.says.empty {
            s.stroke_style("rgba({Ink.SOURCE},0.9)")
            s.line_width(1)
            s.begin_path
            s.move_to(sx, y - half)
            s.line_to(sx, y - half - 16)
            s.stroke
            s.fill_style("rgba({Ink.SOURCE},1)")
            s.font("13px ui-monospace, monospace")
            s.text_align("center")
            s.text_baseline("bottom")
            s.fill_text(l.says, sx, y - half - 20)
          }
        })

        HEADW := Fmt.max(7, Fmt.min(12, CELL * 0.20))
        REACH := CELL * 0.25
        BAR := Fmt.max(2.5, Fmt.min(4.5, CELL * 0.075))
        /*
         * the two bars show the same length. The one behind meets the head's full-height base, so it shows
         * exactly its length; the one in front runs under the head and shows from where the head has narrowed
         * to thinner than the bar - about BAR / 0.84 short of the tip, the head's flank falling at 0.42 a
         * unit - so it is measured from there, not from the tip, or it reads longer than its counterpart
         */
        BASE := HEADW * 0.45
        TIP := HEADW * 0.55
        LEN := REACH - BASE
        SEEN := TIP - BAR / 0.84
        l.sides.for(sd => {
          px := X(k_, sd.at)
          /* behind: where it came from - faint, because it is already spent */
          s.stroke_style("rgba({sd.ink},{ink.behind})")
          s.line_width(BAR)
          s.begin_path
          s.move_to(px - sd.sign * (BASE + LEN), y)
          s.line_to(px - sd.sign * BASE, y)
          s.stroke
          /* in front: where it is going - solid, in the ray's own colour, because that is the claim being made; it starts under the head, which is drawn over it, so nothing shows between tip and bar */
          s.stroke_style("rgba({sd.ink},{ink.front})")
          s.begin_path
          s.move_to(px, y)
          s.line_to(px + sd.sign * (SEEN + LEN), y)
          s.stroke
        })
        l.sides.for(sd => {
          px := X(k_, sd.at)
          s.fill_style("rgba({sd.ink},{ink.head})")
          s.begin_path
          s.move_to(px + sd.sign * TIP, y)
          s.line_to(px - sd.sign * BASE, y - HEADW * 0.42)
          s.line_to(px - sd.sign * BASE, y + HEADW * 0.42)
          s.fill
        })
      })
    })
  }
}

/* a film of lanes, one per tick, each held for `per` frames and drawn in the window of the last - which is where it is going */
Unrolling := class < Painter, lanes: Lane[], ink: Ink, per: N {
  at: N = 0
  frame (s: Surface, dt: Real) => {
    k := Fmt.min(this.lanes.length - 1, (this.at / this.per).floor)
    Strip.paint(s, [[this.lanes[k], this.lanes.last]], this.ink, [0])
    this.at = this.at + 1
  }
}
