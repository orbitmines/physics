/*
 * ITERATION, FROM `next`.
 *
 * Ported from the ray repository's Iterable / Structure / Path / Array (.ray3/Ray.ray). An Iterable
 * is anything with an `entry` that has a `next`. `for` is the ONE loop - a `while` over `next`,
 * which is a goto (Program.ray) - and every other method is a fold over it.
 *
 * `gen` and the bootstrap recognise `Array` by name and encode it as the host's list, as they do `N`
 * and `String`; these definitions are what that list is claimed to mean.
 */

Ordered := class {
  < (b: static): boolean
  <= (b: static): boolean => this == b | this < b
  > (b: static): boolean => !(this <= b)
  >= (b: static): boolean => !(this < b)
}

Iterable := class {
  entry: static?

  /* walk every element, in order; the block may `break` (the caller's return) */
  for (yield: (x: *): *) => {
    current := this.entry
    while current != None {
      yield<local: &caller, break: return>(current)
      current = current.next
    }
  }

  reduce (initial: *, combine: (acc: *, x: *): *): * => {
    acc := initial
    this.for(x => { acc = combine(acc, x) })
    acc
  }

  some (predicate: (x: *): boolean): boolean => {
    this.for(x => { return true if predicate(x) })
    false
  }
  every (predicate: (x: *): boolean): boolean => !this.some(x => !predicate(x))
  contains (x: *): boolean => this.some(y => y == x)

  empty (): boolean => this.entry == None
  nonempty (): boolean => !this.empty
  first (): static? => this.entry
  last (): static? => this.reduce(None, (_, x) => x)
  count | length (): N => this.reduce(0, (n, _) => n + 1)

  map (f: (x: *): *): Array => this.reduce([], (out, x) => out.push(f(x)))
  filter | ~ (predicate: (x: *): boolean): Array => this.reduce([], (out, x) => predicate(x) ? out.push(x) : out)
  join (separator: String): String => this.reduce(None, (out, x) => out == None ? "{x}" : "{out}{separator}{x}") ?? ""

  /* `list.each.method(args)` - the call, made on every element */
  each (): Broadcast => Broadcast(over: this)
}

/* what `.each` hands back: anything asked of it is asked of every element */
Broadcast := class (over: Iterable) {
  {method: *}(args: *) => this.over.map(x => x[method](args))
  {property: *} => this.over.map(x => x[property])
}

Structure := class < Iterable {
  acyclic (): boolean
  connected (): boolean
}

Path := class < Structure {
  [at: N] (): static? => {
    current := this.entry
    i := 0
    while current != None & i < at {
      current = current.next
      i = i + 1
    }
    current
  }
}

Array := class < Path{acyclic} {

  push (x: *): Array => {
    tail := this.last
    if tail == None { this.entry = x } else { tail.next = x; x.previous = tail }
    this
  }

  /* the last element, taken off */
  pop (): * => {
    tail := this.last
    return None if tail == None
    if tail.previous == None { this.entry = None } else { tail.previous.next = None }
    tail
  }

  /* the elements whose index passes - what take, drop and rest are */
  indexed (keep: (i: N): boolean): Array => Array.range(this.length).filter(keep).map(i => this[i])
  take (n: N): Array => this.indexed(i => i < n)
  drop (n: N): Array => this.indexed(i => i >= n)
  rest (): Array => this.drop(1)

  concat (b: Array): Array => b.reduce(this.drop(0), (out, x) => out.push(x))
  reverse (): Array => this.reduce([], (out, x) => [x].concat(out))

  == (b: Array): boolean => this.length == b.length & Array.range(this.length).every(i => this[i] == b[i])

  /* index of the first element equal to x, or None */
  index_of (x: *): N? => Array.range(this.length).filter(i => this[i] == x).first

  /* the largest element by a key, and its index (the first, on a tie) */
  most (key: (x: *): Number): [*, N]? => Array.range(this.length).reduce(None, (best, i) => best == None | key(this[i]) > key(best[0]) ? [this[i], i] : best)

  sum (): Number => this.reduce(0, (acc, x) => acc + x)

  /* 0, 1, ..., n - 1 */
  static range (n: N): Array => {
    out := []
    while out.length < n { out.push(out.length) }
    out
  }
  /* one slot per element, all the same value - what `N[] = exits.map(_ => 0)` builds */
  static filled (n: N, value: *): Array => Array.range(n).map(_ => value)
}

/* an absent value; comparing anything to `None` asks whether it is there (ray repo: `enum Option<T> < T | None`) */
Option := enum None | static { }

* += {
  /* `x ?? default`: this if there is one, the default otherwise */
  ?? (default: *): * => this == None ? default : this
}
