/*
 * STRINGS are arrays of characters, and a character is its code point - a Natural. Recognised by
 * name and encoded as the host's string, like N and Array.
 *
 * A string literal "text {expression} more" interpolates: `{x}` is the written form of x, and a
 * literal brace is written `{{` or `}}`. That applies to every string literal in the language.
 */

Char := class < N {
  /* the written form of a character is itself */
  as (=== String) => String(chars: [this])

  blank (): boolean => this == 32 | this == 9 | this == 10 | this == 13
  upper (): Char => (this >= 97 & this <= 122) ? this - 32 : this
  lower (): Char => (this >= 65 & this <= 90) ? this + 32 : this
}

String := class < Array, chars: Char[] {

  == (b: String): boolean => this.chars == b.chars
  != (b: String): boolean => !(this == b)
  /* by the first character that differs; a prefix comes first */
  < (b: String): boolean => {
    i := Array.range(this.length).filter(i => i >= b.length | this.chars[i] != b.chars[i]).first
    i == None ? this.length < b.length : i < b.length & this.chars[i] < b.chars[i]
  }

  length (): N => this.chars.length
  empty (): boolean => this.length == 0
  take (n: N): String => String(chars: this.chars.take(n))
  drop (n: N): String => String(chars: this.chars.drop(n))

  /* whether `needle` is written at position i - what every search below is */
  at (i: N, needle: String): boolean => this.drop(i).starts_with(needle)

  starts_with (prefix: String): boolean => this.take(prefix.length) == prefix
  ends_with (suffix: String): boolean => this.drop(this.length - suffix.length) == suffix
  index_of (needle: String): N? => Array.range(this.length + 1).filter(i => this.at(i, needle)).first
  contains (needle: String): boolean => this.index_of(needle) != None

  /* the pieces between each `separator`; an empty separator does not split */
  split (separator: String): String[] => {
    i := separator.empty ? None : this.index_of(separator)
    i == None ? [this] : [this.take(i)].concat(this.drop(i + separator.length).split(separator))
  }
  replace (needle: String, by: String): String => this.split(needle).join(by)
  lines (): String[] => this.split("\n")

  /* every line moved right by a prefix - what generated code is made of */
  indent (prefix: String): String => this.lines.map(l => l.empty ? l : "{prefix}{l}").join("\n")

  trim (): String => {
    kept := Array.range(this.length).filter(i => !this.chars[i].blank)
    kept.empty ? "" : this.drop(kept.first).take(kept.last - kept.first + 1)
  }

  upper (): String => String(chars: this.chars.map(c => c.upper))
  lower (): String => String(chars: this.chars.map(c => c.lower))

  /* "snake_case" and "kebab-case" and "CamelCase" of the same name, for the languages that want them */
  snake (): String => this.replace("-", "_").replace(".", "_")
  kebab (): String => this.replace("_", "-").replace(".", "-")
  camel (): String => this.snake.split("_").filter(w => !w.empty).map(w => w.capitalised).join("")
  capitalised (): String => this.empty ? this : "{this.take(1).upper}{this.drop(1)}"

  /* the string as a literal of itself: quoted, with backslashes, quotes and newlines escaped */
  quoted (): String => {
    backslash := "\\"
    quote := "\""
    escaped := this.replace(backslash, "{backslash}{backslash}").replace(quote, "{backslash}{quote}").replace("\n", "{backslash}n")
    "{quote}{escaped}{quote}"
  }

  repeat (n: N): String => Array.filled(n, this).join("")
}
